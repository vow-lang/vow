module AllocLoopHashmapGrowth

fn main() -> i32 [io] {
    let m: HashMap<i64, i64> = HashMap::new();
    let mut i: i64 = 0;
    while i < 1000000 {
        m.insert(i * 7, i);
        i = i + 1;
    }
    let mut j: i64 = 0;
    let mut hits: u64 = 0;
    while j < 1000000 {
        if m.contains_key(j * 7) { hits = hits + 1; }
        j = j + 1;
    }
    print_u64(hits);
    print_str("\n");
    0
}
