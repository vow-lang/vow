module AllocLoopMap

fn fill_map() -> i64 {
    let m: HashMap<i64, i64> = HashMap::new();
    let mut i: i64 = 0;
    while i < 16 {
        m.insert(i, i * 100);
        i = i + 1;
    }
    let first: i64 = match m.get(0) {
        Option::Some(v) => v,
        Option::None => 0,
    };
    let last: i64 = match m.get(15) {
        Option::Some(v) => v,
        Option::None => 0,
    };
    m.len() as i64 + first + last
}

fn main() -> i32 [io] {
    let mut i: i64 = 0;
    let mut total: i64 = 0;
    while i < 70000 {
        total = total + fill_map();
        i = i + 1;
    }
    print_i64(total);
    print_str("\n");
    0
}
