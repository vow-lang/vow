// BENCH: max-rss-kb 7500
module AllocEscapeStructField

struct Sink {
    items: Vec<Option<i64>>,
    n: i64,
}

fn push_result(s: Sink, m: HashMap<i64, i64>, k: i64) {
    s.items.push(m.get(k));
}

fn round(m: HashMap<i64, i64>) -> u64 {
    let s: Sink = Sink { items: Vec::new(), n: 0 };
    let mut i: i64 = 0;
    while i < 32 {
        push_result(s, m, i % 4);
        i = i + 1;
    }
    s.items.len()
}

fn main() -> i32 [io] {
    let m: HashMap<i64, i64> = HashMap::new();
    m.insert(1, 10);
    let mut i: i64 = 0;
    let mut t: u64 = 0;
    while i < 200000 {
        t = t + round(m);
        i = i + 1;
    }
    print_u64(t);
    print_str("\n");
    0
}
