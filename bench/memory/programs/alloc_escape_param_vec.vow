// BENCH: max-rss-kb 7500
module AllocEscapeParamVec

fn push_result(results: Vec<Option<i64>>, m: BTreeMap<i64, i64>, k: i64) {
    results.push(m.get(k));
}

fn round(m: BTreeMap<i64, i64>) -> u64 {
    let results: Vec<Option<i64>> = Vec::new();
    let mut i: i64 = 0;
    while i < 32 {
        push_result(results, m, i % 4);
        i = i + 1;
    }
    results.len()
}

fn main() -> i32 [io] {
    let m: BTreeMap<i64, i64> = BTreeMap::new();
    m.insert(1, 10);
    let mut i: i64 = 0;
    let mut t: u64 = 0;
    while i < 200000 {
        t = t + round(m);
        i = i + 1;
    }
    print_u64(t);
    print_str("\n");
    0
}
