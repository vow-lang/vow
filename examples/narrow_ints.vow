module NarrowInts

fn main() -> i32 [io] {
    let signed_byte: i8 = -8;
    let signed_word: i16 = 1024;
    let unsigned_word: u16 = 65535;
    let unsigned_dword: u32 = 4294967295;

    print_i64((signed_byte >> 1) as i64);
    print_str(String::from("\n"));
    print_i64(signed_word as i64);
    print_str(String::from("\n"));
    print_i64(unsigned_word as i64);
    print_str(String::from("\n"));
    print_i64(unsigned_dword as i64);
    print_str(String::from("\n"));
    0
}
