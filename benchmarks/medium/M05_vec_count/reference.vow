module VecCount

fn vec_count_pos(v: Vec<i64>) -> u64 vow {
  ensures: result <= v.len()
} {
  let mut count: u64 = 0;
  let mut i: u64 = 0;
  while i < v.len() vow {
    invariant: count <= i,
    invariant: i <= v.len()
  } {
    if v[i] > 0 {
      count = count + 1;
    } else {
      0;
    }
    i = i + 1;
  }
  count
}

fn main() -> i32 [io] {
  let v: Vec<i64> = Vec::new();
  v.push(1);
  v.push(0 - 2);
  v.push(3);
  print_u64(vec_count_pos(v));
  0
}
