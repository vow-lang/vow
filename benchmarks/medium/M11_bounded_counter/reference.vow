module BoundedCounter

fn counter_inc(count: u64, max: u64) -> u64 vow {
  requires: count < max,
  ensures: result == count + 1,
  ensures: result <= max
} {
  count + 1
}

fn counter_is_zero(count: u64) -> i64 vow {
  ensures: result >= 0,
  ensures: result <= 1
} {
  if count == 0 {
    1
  } else {
    0
  }
}

fn main() -> i32 [io] {
  let c0: u64 = 0;
  let c1: u64 = counter_inc(c0, 3);
  let c2: u64 = counter_inc(c1, 3);
  print_u64(c2);
  print_i64(counter_is_zero(c0));
  0
}
