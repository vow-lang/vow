module VecSum

fn make_vec(n: i64) -> Vec<i64> vow {
  requires: n >= 0
} {
  let v: Vec<i64> = Vec::new();
  let mut i: u64 = 0;
  while i < n as u64 vow {
    invariant: i <= n as u64
  } {
    v.push(i as i64);
    i = i + 1;
  }
  v
}

fn vec_sum(v: Vec<i64>) -> i64 {
  0
}

fn main() -> i32 [io] {
  let v: Vec<i64> = make_vec(5);
  print_i64(vec_sum(v));
  0
}
