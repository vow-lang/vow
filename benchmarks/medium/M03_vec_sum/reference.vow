module VecSum

fn make_vec(n: u64) -> Vec<i64> {
  let v: Vec<i64> = Vec::new();
  let mut i: u64 = 0;
  while i < n vow {
    invariant: i <= n
  } {
    v.push(i as i64);
    i = i + 1;
  }
  v
}

fn vec_sum(v: Vec<i64>) -> i64 {
  let mut sum: i64 = 0;
  let mut i: u64 = 0;
  while i < v.len() vow {
    invariant: i <= v.len()
  } {
    sum = sum + v[i];
    i = i + 1;
  }
  sum
}

fn main() -> i32 [io] {
  let v: Vec<i64> = make_vec(5);
  print_i64(vec_sum(v));
  0
}
