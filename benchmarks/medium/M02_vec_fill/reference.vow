module VecFill

fn fill_vec(n: i64) -> Vec<i64> vow {
  requires: n >= 0,
  ensures: result.len() as i64 == n
} {
  let v: Vec<i64> = Vec::new();
  let mut i: u64 = 0;
  while i < n as u64 vow {
    invariant: i <= n as u64
  } {
    v.push(i as i64);
    i = i + 1;
  }
  v
}

fn main() -> i32 [io] {
  let v: Vec<i64> = fill_vec(5);
  print_u64(v.len() as u64);
  0
}
