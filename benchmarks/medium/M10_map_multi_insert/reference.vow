module MapMultiInsert

fn map_fill(n: i64) -> HashMap<i64, i64> vow {
  requires: n >= 0,
  ensures: result.len() as i64 == n
} {
  let m: HashMap<i64, i64> = HashMap::new();
  let mut i: u64 = 0;
  while i < n as u64 vow {
    invariant: i <= n as u64
  } {
    let k: i64 = i as i64;
    m.insert(k, k * 10);
    i = i + 1;
  }
  m
}

fn main() -> i32 [io] {
  let m: HashMap<i64, i64> = map_fill(3);
  print_u64(m.len() as u64);
  0
}
