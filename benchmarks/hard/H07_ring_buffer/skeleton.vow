module RingBuffer

struct RingBuf {
  data: Vec<i64>,
  write_pos: u64,
  count: u64,
  capacity: u64,
}

fn ring_new(capacity: u64) -> RingBuf vow {
  requires: capacity > 0,
  ensures: result.count == 0,
  ensures: result.capacity == capacity,
  ensures: result.data.len() == capacity
} {
  let v: Vec<i64> = Vec::new();
  RingBuf { data: v, write_pos: 0, count: 0, capacity: 0 }
}

fn ring_write(rb: RingBuf, val: i64) -> RingBuf vow {
  requires: rb.count < rb.capacity,
  requires: rb.write_pos < rb.capacity,
  requires: rb.data.len() == rb.capacity,
  ensures: result.count == rb.count + 1,
  ensures: result.capacity == rb.capacity,
  ensures: result.data.len() == rb.data.len()
} {
  RingBuf { data: rb.data, write_pos: 0, count: 0, capacity: rb.capacity }
}

fn ring_count(rb: RingBuf) -> u64 vow {
  ensures: result == rb.count
} {
  0
}

fn main() -> i32 [io] {
  let r0: RingBuf = ring_new(3);
  let r1: RingBuf = ring_write(r0, 10);
  let r2: RingBuf = ring_write(r1, 20);
  print_u64(ring_count(r2));
  0
}
