module MatrixOps

fn mat_trace(a: i64, d: i64) -> i64 vow {
  requires: a >= 0,
  requires: d >= 0,
  requires: a <= 9223372036854775807 - d,
  ensures: result == a + d
} {
  0
}

fn mat_add_element(x: i64, y: i64) -> i64 vow {
  requires: x >= 0,
  requires: y >= 0,
  requires: x <= 9223372036854775807 - y,
  ensures: result == x + y
} {
  0
}

fn mat_scale(x: i64, k: i64) -> i64 vow {
  requires: x >= 0,
  requires: k >= 0,
  requires: k == 0 || x <= 9223372036854775807 / k,
  ensures: result == x * k
} {
  0
}

fn mat_determinant_2x2(a: i64, b: i64, c: i64, d: i64) -> i64 vow {
  requires: a >= 0,
  requires: b >= 0,
  requires: c >= 0,
  requires: d >= 0,
  requires: d == 0 || a <= 9223372036854775807 / d,
  requires: c == 0 || b <= 9223372036854775807 / c,
  ensures: result == a * d - b * c
} {
  0
}

fn main() -> i32 [io] {
  print_i64(mat_trace(1, 4));
  print_i64(mat_add_element(3, 5));
  print_i64(mat_scale(3, 4));
  print_i64(mat_determinant_2x2(1, 2, 3, 4));
  0
}
