module CheckedMultiply

fn checked_mul(a: i64, b: i64) -> i64 vow {
  requires: a >= 0,
  requires: b >= 0,
  requires: b == 0 || a <= 9223372036854775807 / b,
  ensures: result == a * b
} {
  a * b
}

fn main() -> i32 [io] {
  print_i64(checked_mul(3, 7));
  print_i64(checked_mul(100, 100));
  0
}
