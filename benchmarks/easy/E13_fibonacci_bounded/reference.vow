module FibonacciBounded

fn fib(n: i64) -> i64 vow {
  requires: n >= 0,
  requires: n <= 92,
  ensures: result >= 0
} {
  if n == 0 {
    0
  } else {
    let mut prev: i64 = 0;
    let mut curr: i64 = 1;
    let mut i: i64 = 1;
    while i < n vow {
      invariant: prev >= 0,
      invariant: curr >= 1,
      invariant: i >= 1,
      invariant: i <= n
    } {
      let next: i64 = prev + curr;
      prev = curr;
      curr = next;
      i = i + 1;
    }
    curr
  }
}

fn main() -> i32 [io] {
  print_i64(fib(0));
  print_i64(fib(5));
  print_i64(fib(8));
  0
}
