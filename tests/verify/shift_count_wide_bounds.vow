// TEST: category callee-blame
module ShiftCountWideBounds

// The dynamic-shift-count regression for i128/u128 is covered on the fail side
// by tests/verify-fail/shift_count_unattributed_{i128,u128}.vow.

fn shift_i64(value: i64, count: i64) -> i64 vow {
    requires: count >= 0,
    requires: count < 64
    ensures: result == value >> count
} {
    value >> count
}

fn shift_u64(value: u64, count: u64) -> u64 vow {
    requires: count < 64
    ensures: result == value >> count
} {
    value >> count
}

fn main() -> i32 {
    shift_i64(0, 0);
    shift_u64(0, 0);
    0
}
