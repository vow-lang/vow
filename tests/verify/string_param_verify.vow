// TEST: category model-drift
// Each function reads `.len()` of a container parameter. The model must keep
// a parameter's length non-negative (`result >= 0`) and treat it as one stable
// value rather than a fresh nondeterministic read (`result == p.len()`).
// The `HashMap` parameter lives in `map_param_verify.vow`, so this file holds
// the containers every verifier models.
module StringParamVerify

fn str_len_stable(s: String) -> i64 vow {
  ensures: result >= 0,
  ensures: result == s.len() as i64
} {
  s.len() as i64
}

fn vec_len_stable(v: Vec<i64>) -> i64 vow {
  ensures: result >= 0,
  ensures: result == v.len() as i64
} {
  v.len() as i64
}

fn main() -> i32 [io] {
  let s: String = String::from("hello");
  print_i64(str_len_stable(s));
  0
}
