// TEST: category model-drift
// Each function reads `.len()` of a container parameter and states that the
// result is that same length: the verifier model must treat a parameter's
// length as one stable value, not a fresh nondeterministic read per call.
module StringParamVerify

fn str_len_stable(s: String) -> i64 vow {
  ensures: result == s.len()
} {
  s.len()
}

fn vec_len_stable(v: Vec<i64>) -> i64 vow {
  ensures: result == v.len()
} {
  v.len()
}

fn map_len_stable(m: HashMap<i64, i64>) -> i64 vow {
  ensures: result == m.len()
} {
  m.len()
}

fn main() -> i32 [io] {
  let s: String = String::from("hello");
  print_i64(str_len_stable(s));
  0
}
