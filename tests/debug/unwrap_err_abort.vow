// TEST: exit 134
// TEST: stderr "UnwrapOnNone"
//
// Issue #1108, tag-polarity half: Result's empty variant is `Err` (tag 1), not
// `None`'s tag 0. Reading the discriminant with Option's polarity makes
// `Err(..).unwrap()` silently return the Err payload instead of aborting. The
// receiver here is a parameter, which carries a declared AST type but no
// struct tag — the case that first exposed the wrong polarity.
module UnwrapErrAbort

fn payload(r: Result<i64, i32>) -> i64 [panic] {
    r.unwrap()
}

fn main() -> () [io, panic] {
    let failed: Result<i64, i32> = Result::Err(9);
    print_i64(payload(failed));
}
