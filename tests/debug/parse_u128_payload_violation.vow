// TEST: exit 134
// TEST: stderr "VowViolation"
// TEST: stderr ""x":3154393236604333326336"
module ParseU128PayloadViolation

// 3154393236604333326336 is 171 * 2^64, so its low 64 bits are exactly zero.
// The value reaches the contract through a parsed Option<u128> payload; a read
// that kept only the low limb would report "x":0 and satisfy `x < 1`.
fn requires_small(x: u128) -> u128 vow {
    requires: x < 1
} {
    x
}

fn main() -> i32 [io] {
    match parse_u128(String::from("3154393236604333326336")) {
        Option::Some(v) => { requires_small(v); },
        Option::None => { print_str(String::from("none\n")); },
    }
    0
}
