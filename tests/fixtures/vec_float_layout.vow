module VecFloatLayout

fn push_f64(v: Vec<f64>, x: f64) -> () {
    v.push(x);
}

fn read_f64(v: Vec<f64>, i: u64) -> f64 {
    v[i]
}

fn write_f64(v: Vec<f64>, i: u64, x: f64) -> () {
    v[i] = x;
}

fn sum_f64(v: Vec<f64>) -> f64 {
    let mut acc: f64 = 0.0;
    for x in v {
        acc = acc + x;
    }
    acc
}

fn push_f32(v: Vec<f32>, x: f32) -> () {
    v.push(x);
}

fn read_f32(v: Vec<f32>, i: u64) -> f32 {
    v[i]
}

fn write_f32(v: Vec<f32>, i: u64, x: f32) -> () {
    v[i] = x;
}

fn sum_f32(v: Vec<f32>, zero: f32) -> f32 {
    let mut acc: f32 = zero;
    for x in v {
        acc = acc + x;
    }
    acc
}

fn make_f64(x: f64) -> Vec<f64> {
    let v: Vec<f64> = Vec::new();
    v.push(x);
    v
}

fn read_unannotated(x: f64) -> f64 {
    let w = make_f64(x);
    w[0]
}

fn sum_call(x: f64) -> f64 {
    let mut acc: f64 = 0.0;
    for e in make_f64(x) {
        acc = acc + e;
    }
    acc
}

fn read_i64(v: Vec<i64>, i: u64) -> i64 {
    v[i]
}

fn push_i64(v: Vec<i64>, x: i64) -> () {
    v.push(x);
}

fn main() -> i32 {
    0
}
