module WideVecLayout

fn push_one(v: Vec<u128>, x: u128) {
    v.push(x);
}

fn read_one(v: Vec<u128>) -> u128 {
    v[1]
}

fn write_one(v: Vec<u128>, x: u128) {
    v[1] = x;
}

fn sum(v: Vec<u128>) -> u128 {
    let mut total: u128 = 0;
    for x in v {
        total = total + x;
    }
    total
}

fn narrow(v: Vec<u64>) -> u64 {
    v[0]
}

fn main() -> i32 {
    0
}
