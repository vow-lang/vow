module WideLiteralOperands

fn u64_pair() -> u64 {
    let a: u64 = 18446744073709551615;
    let b: u64 = 9223372036854775808;
    a - b
}

fn wide_triple() -> u128 {
    let a: u128 = 340282366920938463463374607431768211455;
    let b: u128 = 18446744073709551615;
    let c: u128 = 18446744073709551616;
