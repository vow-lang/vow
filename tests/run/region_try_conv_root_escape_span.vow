// TEST: stdout ""
// The `_try` narrowing conversions build a fresh Option cell like the parse_*
// family, so they are heap-producing for region inference: publishing the
// result through a parameter container must surface a RegionRootEscape note.
// Without that, the arena-routed variant would free an escaping cell with its
// block.
module RegionTryConvRootEscapeSpan

fn push_narrowed(results: Vec<Option<u8>>, x: i64) {
    results.push(i64_to_u8_try(x));
}

fn main() -> i32 {
    let results: Vec<Option<u8>> = Vec::new();
    push_narrowed(results, 7);
    0
}
