// TEST: stdout "11\n0\n0\n12\n0\n9\n0\n15\n0\n40\n0\n11\n0\n11\n0\n306\n3\n294\n33\n33\n"
// Regression test for #655: a mutation buried in an operand (call argument,
// binary/unary operand, method argument, assignment RHS, if/while condition)
// must be collected as assigned, so it merges after a branch and carries
// around a loop back edge.
module AssignInOperandPosition

fn id(x: i64) -> i64 {
    x
}

fn call_arg(outer: bool, found: bool) -> i64 {
    let mut count: i64 = 0;
    let mut total: i64 = 0;
    if outer {
        total = id(if found { count = count + 1; count } else { 0 });
    }
    count * 10 + total
}

fn binop_operand(outer: bool) -> i64 {
    let mut count: i64 = 0;
    let mut total: i64 = 0;
    if outer {
        total = 1 + { count = count + 1; count };
    }
    count * 10 + total
}

fn unop_operand(outer: bool) -> i64 {
    let mut count: i64 = 0;
    let mut total: i64 = 0;
    if outer {
        total = -{ count = count + 1; count };
    }
    count * 10 + total
}

fn if_condition(outer: bool) -> i64 {
    let mut count: i64 = 0;
    let mut total: i64 = 0;
    if outer {
        if { count = count + 1; true } {
            total = 5;
        }
    }
    count * 10 + total
}

fn while_condition(outer: bool) -> i64 {
    let mut count: i64 = 0;
    if outer {
        let mut i: i64 = 0;
        while i < 3 + { count = count + 1; 0 } {
            i = i + 1;
        }
    }
    count * 10
}

fn method_argument(outer: bool) -> i64 {
    let mut count: i64 = 0;
    let v: Vec<i64> = Vec::new();
    if outer {
        v.push({ count = count + 1; count });
    }
    count * 10 + v.len() as i64
}

fn assign_rhs(outer: bool) -> i64 {
    let mut count: i64 = 0;
    let mut total: i64 = 0;
    if outer {
        total = { count = count + 1; count };
    }
    count * 10 + total
}

fn loop_call_arg(n: i64) -> i64 {
    let mut count: i64 = 0;
    let mut total: i64 = 0;
    let mut i: i64 = 0;
    while i < n {
        total = total + id({ count = count + 1; count });
        i = i + 1;
    }
    count * 100 + total
}

fn loop_binop(n: i64) -> i64 {
    let mut count: i64 = 0;
    let mut i: i64 = 0;
    while i < n {
        i = i + 1 + { count = count + 1; 0 };
    }
    count
}

fn loop_unop(n: i64) -> i64 {
    let mut count: i64 = 0;
    let mut total: i64 = 0;
    let mut i: i64 = 0;
    while i < n {
        total = total + -{ count = count + 1; count };
        i = i + 1;
    }
    count * 100 + total
}

fn loop_method_argument(n: i64) -> i64 {
    let mut count: i64 = 0;
    let mut i: i64 = 0;
    let v: Vec<i64> = Vec::new();
    while i < n {
        v.push({ count = count + 1; count });
        i = i + 1;
    }
    count * 10 + v.len() as i64
}

fn loop_if_condition(n: i64) -> i64 {
    let mut count: i64 = 0;
    let mut total: i64 = 0;
    let mut i: i64 = 0;
    while i < n {
        if { count = count + 1; true } {
            total = total + 1;
        }
        i = i + 1;
    }
    count * 10 + total
}

fn show(n: i64) [io] {
    print_i64(n);
    print_str(String::from("\n"));
}

fn main() -> i32 [io] {
    // An assignment buried in an operand of a branch body must be merged into
    // the code after the branch, whichever way the branch went.
    show(call_arg(true, true));
    show(call_arg(true, false));
    show(call_arg(false, true));
    show(binop_operand(true));
    show(binop_operand(false));
    show(unop_operand(true));
    show(unop_operand(false));
    show(if_condition(true));
    show(if_condition(false));
    show(while_condition(true));
    show(while_condition(false));
    show(method_argument(true));
    show(method_argument(false));
    show(assign_rhs(true));
    show(assign_rhs(false));
    // The same assignments inside a loop body must be carried around the
    // back edge, so every iteration sees the value of the previous one.
    show(loop_call_arg(3));
    show(loop_binop(3));
    show(loop_unop(3));
    show(loop_method_argument(3));
    show(loop_if_condition(3));
    0
}
