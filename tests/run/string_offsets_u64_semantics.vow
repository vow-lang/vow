// TEST: stdout "byte_at:104,111,-1,-1,-1\nsubstring:el|llo|||\nsubstr:ell|o||hello\nmatch:1,0,0,0,1,1,0\npush:4|65,66,255,0\nwrap:44,65,255\n"
// String offsets are u64, so the runtime has no negative-offset behaviour: an
// offset at or past len() (including u64::MAX) is simply out of range. byte_at
// returns -1, the substring helpers clamp, matches_literal_at returns 0.
module string_offsets_u64_semantics

fn main() -> i32 [io] {
    let s: String = String::from("hello");
    let max: u64 = 18446744073709551615;
    let neg: i64 = -1;

    print_str("byte_at:");
    print_i64(s.byte_at(0));
    print_str(",");
    print_i64(s.byte_at(4));
    print_str(",");
    print_i64(s.byte_at(5));
    print_str(",");
    print_i64(s.byte_at(max));
    print_str(",");
    print_i64(s.byte_at(neg as u64));
    print_str("\n");

    print_str("substring:");
    print_str(s.substring(1, 3));
    print_str("|");
    print_str(s.substring(2, max));
    print_str("|");
    print_str(s.substring(max, 3));
    print_str("|");
    print_str(s.substring(3, 1));
    print_str("|");
    print_str(s.substring(neg as u64, 2));
    print_str("\n");

    print_str("substr:");
    print_str(string_substr(s, 1, 3));
    print_str("|");
    print_str(string_substr(s, 4, max));
    print_str("|");
    print_str(string_substr(s, max, 3));
    print_str("|");
    print_str(string_substr(s, 0, max));
    print_str("\n");

    print_str("match:");
    print_i64(string_matches_literal_at(s, 1, "ell"));
    print_str(",");
    print_i64(string_matches_literal_at(s, 2, "ell"));
    print_str(",");
    print_i64(string_matches_literal_at(s, 3, "llo"));
    print_str(",");
    print_i64(string_matches_literal_at(s, max, "h"));
    print_str(",");
    print_i64(string_matches_literal_at(s, 5, ""));
    print_str(",");
    print_i64(string_matches_literal_at(s, 0, "hello"));
    print_str(",");
    print_i64(string_matches_literal_at(s, 6, ""));
    print_str("\n");

    let b: String = String::from("");
    let hi: u8 = 255;
    b.push_byte(65);
    b.push_byte(66);
    b.push_byte(hi);
    b.push_byte(0);
    print_str("push:");
    print_u64(b.len());
    print_str("|");
    print_i64(b.byte_at(0));
    print_str(",");
    print_i64(b.byte_at(1));
    print_str(",");
    print_i64(b.byte_at(2));
    print_str(",");
    print_i64(b.byte_at(3));
    print_str("\n");

    print_str("wrap:");
    print_i64(i64_to_u8_wrap(300) as i64);
    print_str(",");
    print_i64(i64_to_u8_sat(65) as i64);
    print_str(",");
    print_i64(i64_to_u8_sat(1000) as i64);
    print_str("\n");
    0
}
