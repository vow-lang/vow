// TEST: stdout "abc,A:97:98:99:44:65"
// push_byte takes a u8 byte value. A wider value reaches it only through an
// explicit narrowing intrinsic, so the truncation is spelled out at the call
// site (wrapping 300 gives 44).
module push_byte_value_range

fn main() -> i32 [io] {
    let s: String = String::from("");
    let wide: u64 = 97;
    let wider: i64 = 300;
    let narrow: u8 = 98;
    s.push_byte(u64_to_u8_wrap(wide));
    s.push_byte(narrow);
    s.push_byte(99);
    s.push_byte(i64_to_u8_wrap(wider));
    s.push_byte(i64_to_u8_wrap(65 + 256));
    print_str(s);
    print_str(":");
    print_i64(s.byte_at(0));
    print_str(":");
    print_i64(s.byte_at(1));
    print_str(":");
    print_i64(s.byte_at(2));
    print_str(":");
    print_i64(s.byte_at(3));
    print_str(":");
    print_i64(s.byte_at(4));
    0
}
