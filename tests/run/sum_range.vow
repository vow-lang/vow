// TEST: stdout "50"
module SumRange

fn count_steps(n: i64) -> i64 vow {
  requires: n >= 0,
  ensures: result == n
} {
  let mut i: u64 = 0;
  while i < n as u64 vow {
    invariant: i <= n as u64
  } {
    i = i + 1;
  }
  i as i64
}

fn main() -> i32 [io] {
  print_i64(count_steps(5));
  print_i64(count_steps(0));
  0
}
