// TEST: exit 0
module NestedOptionPayloadWidth

fn unwrap_nested(value: Option<Option<u8>>) -> u8 {
    match value {
        Option::Some(inner) => {
            match inner {
                Option::Some(byte) => { byte },
                Option::None => { 0 },
            }
        },
        Option::None => { 0 },
    }
}

fn propagate_nested(value: Option<Option<u8>>) -> Option<u8> {
    let inner: Option<u8> = value?;
    match inner {
        Option::Some(byte) => { Option::Some(byte) },
        Option::None => { Option::None },
    }
}

fn unwrap_vec_nested(value: Option<Vec<Option<u8>>>) -> u8 {
    match value {
        Option::Some(items) => {
            match items[0] {
                Option::Some(byte) => { byte },
                Option::None => { 0 },
            }
        },
        Option::None => { 0 },
    }
}

fn propagate_vec_nested(value: Option<Vec<Option<u8>>>) -> Option<u8> {
    let items: Vec<Option<u8>> = value?;
    match items[0] {
        Option::Some(byte) => { Option::Some(byte) },
        Option::None => { Option::None },
    }
}

fn unwrap_nested_result_ok(value: Option<Result<u8, ()>>) -> u8 {
    match value {
        Option::Some(result) => {
            match result {
                Result::Ok(byte) => { byte },
                Result::Err(_) => { 0 },
            }
        },
        Option::None => { 0 },
    }
}

fn unwrap_nested_result_err(value: Option<Result<(), i32>>) -> i32 {
    match value {
        Option::Some(result) => {
            match result {
                Result::Ok(_) => { 0 },
                Result::Err(code) => { code },
            }
        },
        Option::None => { 0 },
    }
}

fn unwrap_vec_result(value: Option<Vec<Result<u8, ()>>>) -> u8 {
    match value {
        Option::Some(items) => {
            match items[0] {
                Result::Ok(byte) => { byte },
                Result::Err(_) => { 0 },
            }
        },
        Option::None => { 0 },
    }
}

fn main() -> i32 {
    let value: u8 = unwrap_nested(Option::Some(Option::Some(7)));
    let propagated: Option<u8> = propagate_nested(Option::Some(Option::Some(9)));
    let propagated_value: u8 = match propagated {
        Option::Some(byte) => { byte },
        Option::None => { 0 },
    };
    if value != 7 { return 1; }
    if propagated_value != 9 { return 2; }
    let items: Vec<Option<u8>> = Vec::new();
    items.push(Option::Some(11));
    if unwrap_vec_nested(Option::Some(items)) != 11 { return 3; }
    let question_items: Vec<Option<u8>> = Vec::new();
    question_items.push(Option::Some(13));
    let question_value: Option<u8> = propagate_vec_nested(Option::Some(question_items));
    let question_byte: u8 = match question_value {
        Option::Some(byte) => { byte },
        Option::None => { 0 },
    };
    if question_byte != 13 { return 4; }
    let ok: Result<u8, ()> = Result::Ok(17u8);
    if unwrap_nested_result_ok(Option::Some(ok)) != 17 { return 5; }
    let err: Result<(), i32> = Result::Err(19);
    if unwrap_nested_result_err(Option::Some(err)) != 19 { return 6; }
    let results: Vec<Result<u8, ()>> = Vec::new();
    let nested_ok: Result<u8, ()> = Result::Ok(23u8);
    results.push(nested_ok);
    if unwrap_vec_result(Option::Some(results)) != 23 { return 7; }
    0
}
