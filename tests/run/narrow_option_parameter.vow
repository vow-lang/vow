// TEST: stdout "-128\n"
module NarrowOptionParameter

fn print_incremented(value: Option<i8>) [io] {
    match value {
        Option::Some(inner) => print_i64((inner + 1) as i64),
        Option::None => print_i64(0),
    }
    print_str(String::from("\n"));
}

fn main() -> i32 [io] {
    print_incremented(parse_i8(String::from("127")));
    0
}
