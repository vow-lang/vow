// TEST: stdout "u64:2lit:1i64cast:1u32cast:3u8cast:2expr:3write:9byte_i64:104byte_u32:108byte_u64:101sub:el"
// Guard for the exact-u64 Vec index rule (#1122 D1): a u64 value or an
// unsuffixed literal indexes directly, and every other integer width needs an
// explicit `as u64`. String offsets (`byte_at`, `substring`) are unchanged and
// still accept any integer type.
module index_integer_types

fn main() -> i32 [io] {
    let v: Vec<i64> = Vec::new();
    v.push(1);
    v.push(2);
    v.push(3);
    let s: String = String::from("hello");

    let u: u64 = 1;
    let i: i64 = 0;
    let w: u32 = 2;
    let b: u8 = 1;

    print_str("u64:");
    print_i64(v[u]);
    print_str("lit:");
    print_i64(v[0]);
    print_str("i64cast:");
    print_i64(v[i as u64]);
    print_str("u32cast:");
    print_i64(v[w as u64]);
    print_str("u8cast:");
    print_i64(v[b as u64]);
    print_str("expr:");
    print_i64(v[u + 1]);

    v[u] = 9;
    print_str("write:");
    print_i64(v[1]);

    print_str("byte_i64:");
    print_i64(s.byte_at(i));
    print_str("byte_u32:");
    print_i64(s.byte_at(w));
    print_str("byte_u64:");
    print_i64(s.byte_at(u));
    print_str("sub:");
    print_str(s.substring(u, 3));
    0
}
