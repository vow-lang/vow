// TEST: stdout "5\n9\n9\n5\n11\n30\n3\n"
module ShortCircuitAssign

struct Pair {
    a: i64,
    b: i64,
}

fn and_assign(a: bool) -> i64 {
    let mut x: i64 = 5;
    let ok: bool = a && { x = 9; true };
    if ok { x = x + 0; }
    x
}

fn or_assign(a: bool) -> i64 {
    let mut x: i64 = 5;
    let ok: bool = a || { x = 9; false };
    if ok { x = x + 0; }
    x
}

fn while_cond_assign(n: i64) -> i64 {
    let mut i: i64 = 0;
    let mut seen: i64 = 0;
    while i < n && { seen = seen + 1; true } {
        i = i + 1;
    }
    i + seen
}

fn struct_and_assign(a: bool) -> i64 {
    let mut p: Pair = Pair { a: 1, b: 2 };
    let ok: bool = a && { p = Pair { a: 10, b: 20 }; true };
    if ok { p.a = p.a + 0; }
    p.a + p.b
}

fn main() -> i32 [io] {
    // A variable assigned in the right-hand side of `&&` / `||` keeps its old
    // value on the path that short-circuits and the new one on the path that
    // evaluates the right-hand side.
    print_i64(and_assign(false));
    print_str(String::from("\n"));
    print_i64(and_assign(true));
    print_str(String::from("\n"));
    print_i64(or_assign(false));
    print_str(String::from("\n"));
    print_i64(or_assign(true));
    print_str(String::from("\n"));
    print_i64(while_cond_assign(4) + 3);
    print_str(String::from("\n"));
    print_i64(struct_and_assign(true));
    print_str(String::from("\n"));
    print_i64(struct_and_assign(false));
    print_str(String::from("\n"));
    0
}
