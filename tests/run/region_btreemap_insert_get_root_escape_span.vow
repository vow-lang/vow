// TEST: stdout ""
// Issue #1265 regression: __vow_btreemap_insert/__vow_btreemap_get both
// return a fresh Option<i64> (alloc_option_i64), the same allocation shape
// as the already-tracked __vow_string_parse_i64_opt. Publishing either
// result through a parameter container must surface a RegionRootEscape note.
module RegionBTreeMapInsertGetRootEscapeSpan

fn push_results(results: Vec<Option<i64>>, m: BTreeMap<i64, i64>) {
    results.push(m.insert(1, 2));
    results.push(m.get(1));
}

fn main() -> i32 {
    let results: Vec<Option<i64>> = Vec::new();
    let m: BTreeMap<i64, i64> = BTreeMap::new();
    push_results(results, m);
    0
}
