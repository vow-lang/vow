// TEST: stdout ""
// Issue #1265 regression: __vow_string_parse_u64_opt (and the narrow-integer
// parse_*_opt family) build their Option<N> via the same __vow_vec_new(8, 8)
// shape as the already-tracked __vow_string_parse_i64_opt. parse_u64 is the
// representative case; publishing its result through a parameter container
// must surface a RegionRootEscape note.
module RegionParseOptRootEscapeSpan

fn push_parsed(results: Vec<Option<u64>>, s: String) {
    results.push(s.parse_u64());
}

fn main() -> i32 {
    let results: Vec<Option<u64>> = Vec::new();
    push_parsed(results, String::from("42"));
    0
}
