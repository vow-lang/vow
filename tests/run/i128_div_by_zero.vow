// TEST: exit 134
// TEST: stderr "{\"error\":\"ArithmeticOverflow\"}"
module I128DivByZero

// 128-bit `/` routes through a vow-runtime helper, so the divisor-zero trap is
// reported by the backend before the helper call. It must abort with the same
// machine-readable diagnostic as every other arithmetic runtime abort.
fn zero() -> i128 {
    0
}

fn divide() -> i128 {
    10 / zero()
}

fn main() -> i32 {
    divide();
    0
}
