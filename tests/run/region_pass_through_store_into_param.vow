// TEST: stdout "x\n"
// Issue #1933 reproducer. `report` stores the result of an alias-returning
// internal call (`pass`) into a parameter container, and the argument of that
// call embeds a field of another parameter. The heap value `fill` allocates
// must live as long as `main`'s `ces`, not as long as `fill`'s region.
module RegionPassThroughStoreIntoParam

struct Res {
    names: Vec<String>,
}

struct Ce {
    names: Vec<String>,
}

fn pass(ce: Ce) -> Ce {
    ce
}

fn report(r: Res, ces: Vec<Ce>) {
    ces.push(pass(Ce { names: r.names }));
}

fn fill(ces: Vec<Ce>) {
    let n: Vec<String> = Vec::new();
    n.push(String::from("x"));
    let r: Res = Res { names: n };
    report(r, ces);
}

fn main() -> i32 [io] {
    let ces: Vec<Ce> = Vec::new();
    fill(ces);
    let junk: Vec<String> = Vec::new();
    let mut i: i64 = 0;
    while i < 100 {
        junk.push(String::from("overwrite-overwrite-overwrite"));
        i = i + 1;
    }
    print_str(ces[0].names[0]);
    print_str("\n");
    0
}
