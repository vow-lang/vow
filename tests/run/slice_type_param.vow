// TEST: stdout "slice ok\n"
// A `[T]` slice type is not the unit type: it is accepted as a parameter type
// and as a `let` annotation by both compilers (the self-hosted checker once
// resolved it to `()` and rejected the parameter as a unit parameter).
module SliceTypeParam

fn probe(sl: [i64], n: i64) -> i64 vow {
  requires: { let q: [i64] = sl; n >= 0 }
} {
  n
}

fn main() -> i32 [io] {
  print_str("slice ok\n");
  0
}
