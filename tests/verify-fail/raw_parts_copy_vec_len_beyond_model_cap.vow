// TEST: category overflow
// TEST: counterexample-vow-id 4294967293
// TEST: counterexample-fn "big"
// TEST: counterexample-blame none
// A constant length outside the verifier's model capacity must fail closed;
// assuming it away would make the (true) postcondition below vacuous. The source
// pointer is a parameter because a null source is modelled as empty, as at runtime.
// The constant 300 must stay above VEC_MODEL_CAP (128) in vow-verify/src/c_emitter.rs.
module RawPartsCopyVecLenBeyondModelCap

fn big(p: i64) -> i64 vow {
    ensures: result == 1
} {
    let v: Vec<i64> = Vec::from_raw_parts_copy(p, 300);
    1
}
