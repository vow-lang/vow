// TEST: category callee-blame
// TEST: counterexample-vow-id 0
// TEST: counterexample-fn "unwrap_fd"
// TEST: counterexample-blame Callee
// A consume only discharges an ownership obligation, so a function that consumes
// a linear value through an Option payload is modeled like any other and its
// contract is decided by the data flow alone.
// A false postcondition on such a function is still refuted.
module LinearConsumeEnumPayloadFails

linear struct Handle {
    fd: i64,
}

fn unwrap_fd(o: Option<Handle>) -> i64 vow {
    ensures: result > 0
} {
    match o {
        Option::Some(h) => {
            let fd: i64 = h.fd;
            drop(h);
            if fd < 0 { 0 } else { fd }
        },
        Option::None => 0,
    }
}

fn main() -> i32 {
    0
}
