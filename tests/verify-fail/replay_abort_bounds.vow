// TEST: category bounds
// TEST: counterexample-fn "past_end"
// TEST: counterexample-blame none
// TEST: counterexample-vow-id 0
// TEST: replay aborted
//
// Counterexample-replay abort fixture (#1090). `past_end`'s `requires: n == 1`
// pins a scalar input that both replay implementations can reconstruct. The
// one-element Vec is indexed at one, so the runtime's IndexOutOfBounds abort
// preempts the postcondition and replay reports "aborted", not "diverged".
// No `fn main` is present, allowing the self-hosted replay path to run.
module ReplayAbortBounds

fn past_end(n: i64) -> i64 vow {
  requires: n == 1,
  ensures: result >= 0
} {
  let v: Vec<i64> = Vec::new();
  v.push(7);
  v[n]
}
