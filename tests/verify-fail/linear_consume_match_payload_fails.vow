// TEST: category callee-blame
// TEST: counterexample-vow-id 0
// TEST: counterexample-fn "unwrap_fd"
// TEST: counterexample-blame callee
// A consume only discharges an ownership obligation, so a function that consumes
// a linear value through a user enum match payload is modeled like any other and its
// contract is decided by the data flow alone.
// A false postcondition on such a function is still refuted.
module LinearConsumeMatchPayloadFails

linear struct Handle {
    fd: i64,
}

enum Wrap {
    Has(Handle),
    Nope,
}

fn unwrap_fd(w: Wrap) -> i64 vow {
    ensures: result > 0
} {
    match w {
        Wrap::Has(h) => {
            let fd: i64 = h.fd;
            drop(h);
            if fd < 0 { 0 } else { fd }
        },
        Wrap::Nope => 0,
    }
}

fn main() -> i32 {
    0
}
