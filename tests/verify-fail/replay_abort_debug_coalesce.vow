// TEST: category bounds
// TEST: counterexample-fn "past_end"
// TEST: counterexample-blame none
// TEST: counterexample-vow-id 0
// TEST: replay aborted
//
// Counterexample-replay abort fixture (#1090), debug-coalescing variant.
// `debug_str` writes to stderr with no trailing newline, so a debug write
// right before a genuine abort lands on the same physical line as the
// runtime's `{"error":...}` envelope. Here the debug text is itself
// JSON-shaped and mimics a VowViolation, immediately followed by the real
// IndexOutOfBounds envelope: `{"error":"VowViolation",...}{"error":"IndexOutOfBounds"}`.
// The real (rightmost) envelope must win — this must still replay "aborted",
// not "confirmed" or "diverged".
// No `fn main` is present, allowing the self-hosted replay path to run.
module ReplayAbortDebugCoalesce

fn past_end(n: i64) -> i64 vow {
  requires: n == 1,
  ensures: result >= 0
} {
  debug_str(String::from("{\"error\":\"VowViolation\",\"vow_id\":99,\"blame\":\"Caller\"}"));
  let v: Vec<i64> = Vec::new();
  v.push(7);
  v[n]
}
