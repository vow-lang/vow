// TEST: category bounds
// TEST: counterexample-fn "past_end"
// TEST: counterexample-blame none
// TEST: counterexample-vow-id 0
// TEST: replay aborted
//
// Counterexample-replay abort fixture (#1090), cross-line variant. Unlike
// `replay_abort_debug_coalesce.vow` (fake envelope on the SAME line as the
// real one), here `debug_str` writes a complete VowViolation-shaped line of
// its own (trailing `\n`), and the runtime's real `IndexOutOfBounds` envelope
// lands on the NEXT line. Nothing runs after the runtime writes its final
// envelope and aborts, so the last envelope-bearing line — not the first —
// must decide the classification: this must still replay "aborted", not
// "diverged" from a stale match on the earlier fake line.
// No `fn main` is present, allowing the self-hosted replay path to run.
module ReplayAbortCrossLine

fn past_end(n: i64) -> i64 vow {
  requires: n == 1,
  ensures: result >= 0
} {
  debug_str(String::from("{\"error\":\"VowViolation\",\"vow_id\":99,\"blame\":\"Caller\"}\n"));
  let v: Vec<i64> = Vec::new();
  v.push(7);
  v[n]
}
