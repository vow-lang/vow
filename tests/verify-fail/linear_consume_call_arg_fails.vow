// TEST: category callee-blame
// TEST: counterexample-vow-id 0
// TEST: counterexample-fn "forward"
// TEST: counterexample-blame Callee
// A consume only discharges an ownership obligation, so a function that consumes
// a linear value through a call argument is modeled like any other and its
// contract is decided by the data flow alone.
// A false postcondition on such a function is still refuted.
module LinearConsumeCallArgFails

linear struct Handle {
    fd: i64,
}

fn finish(h: Handle) -> i64 vow {
    ensures: result >= 0
} {
    let fd: i64 = h.fd;
    drop(h);
    if fd < 0 { 0 } else { fd }
}

fn forward(h: Handle) -> i64 vow {
    ensures: result > 0
} {
    finish(h)
}

fn main() -> i32 {
    0
}
