// TEST: category overflow
// TEST: counterexample-vow-id 4294967293
// TEST: counterexample-fn "big"
// TEST: counterexample-blame none
// A constant length outside the verifier's model capacity must fail closed;
// assuming it away would make the (true) postcondition below vacuous.
module RawPartsCopyVecLenBeyondU64I64Max

fn big() -> i64 vow {
    ensures: result == 1
} {
    let v: Vec<i64> = Vec::from_raw_parts_copy(0, 10000000000000000000);
    1
}
