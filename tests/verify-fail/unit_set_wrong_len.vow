// TEST: category callee-blame
// TEST: counterexample-vow-id 0
// TEST: counterexample-fn "wrong_len"
// TEST: counterexample-blame callee
module UnitSetWrongLen

fn wrong_len(k: i64) -> HashMap<i64, ()> vow {
  ensures: result.len() == 2
} {
  let m: HashMap<i64, ()> = HashMap::new();
  m.insert(k, ());
  m
}

fn main() -> i32 [io] {
  let m: HashMap<i64, ()> = wrong_len(1);
  print_u64(m.len());
  0
}
