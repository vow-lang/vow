// TEST: category overflow
// TEST: counterexample-vow-id 4294967293
// TEST: counterexample-fn "big"
// TEST: counterexample-blame None
// A length that is the result of calling a constant-returning function is
// provably 500, above the model capacity of both String (256) and Vec (128), so
// it must fail closed like a literal rather than be assumed away (which would
// make the true postcondition below vacuous). The source pointer is a
// parameter because a null source is modelled as empty, as at runtime.
module RawPartsCopyConstFnLenBeyondModelCap

fn capacity() -> u64 {
    500
}

fn big(p: i64) -> i64 vow {
    ensures: result == 1
} {
    let s: String = String::from_raw_parts_copy(p, capacity());
    1
}

fn big_vec(p: i64) -> i64 vow {
    ensures: result == 1
} {
    let v: Vec<i64> = Vec::from_raw_parts_copy(p, capacity());
    1
}

fn main() -> i32 {
    0
}
