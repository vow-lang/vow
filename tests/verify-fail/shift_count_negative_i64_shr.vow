// TEST: category bounds
// TEST: counterexample-fn "shift"
// TEST: counterexample-blame none
// TEST: counterexample-vow-id 4294967293
// TEST: counterexample-violation "shift amount exceeds the operand's bit width"
module ShiftCountNegativeI64Shr

// The upper bound alone is not enough: a negative count is masked by the
// hardware shift at runtime, so the verifier must reject it too.
fn shift(x: i64, n: i64) -> i64 vow {
  requires: n < 64
  ensures: result == result
} {
  x >> n
}
