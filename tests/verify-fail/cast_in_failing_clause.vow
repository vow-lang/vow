// TEST: category callee-blame
// TEST: counterexample-fn "widen_and_bound"
// TEST: counterexample-blame Callee
// TEST: counterexample-violation "ensures result < 100 as u64"
// The failing ensures clause carries an `as u64` cast, so the counterexample's
// `violation` text must render the real cast target type on both compilers.
// The postcondition is false for x < 0, which widens to a huge u64.
module CastInFailingClause

fn widen_and_bound(x: i64) -> u64 vow {
  ensures: result < 100 as u64
} {
  x as u64
}

fn main() -> i32 [io] {
  print_u64(widen_and_bound(5));
  0
}
