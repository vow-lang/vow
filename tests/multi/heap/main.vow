// TEST: stdout "111111"
module Main
use min_heap
use max_heap

fn flag(ok: bool) -> i32 [io] {
    if ok {
        print_i64(1);
        0
    } else {
        print_i64(0);
        1
    }
}

fn main() -> i32 [io] {
    let empty_min: MinHeap = min_heap_new();
    let empty_max: MaxHeap = max_heap_new();
    let single_min: MinHeap = min_heap_push(min_heap_new(), 7);
    let single_max: MaxHeap = max_heap_push(max_heap_new(), 7);
    let drained_min: MinHeap = min_heap_pop(min_heap_push(min_heap_new(), 7));
    let drained_max: MaxHeap = max_heap_pop(max_heap_push(max_heap_new(), 7));

    let mut bad: i32 = 0;
    bad = bad + flag(is_min_heap(empty_min));
    bad = bad + flag(is_max_heap(empty_max));
    bad = bad + flag(is_min_heap(single_min));
    bad = bad + flag(is_max_heap(single_max));
    bad = bad + flag(is_min_heap(drained_min));
    bad = bad + flag(is_max_heap(drained_max));
    bad
}
