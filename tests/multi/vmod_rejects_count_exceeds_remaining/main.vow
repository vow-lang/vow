// TEST: exit 1
// TEST: stdout "{"error":"ModuleDecodeError","kind":"CountExceedsRemaining","label":"","value":5,"offset":9}\n"
// A count larger than the bytes left in the buffer is CountExceedsRemaining; it can
// never be satisfied, so no section is allocated for it.
module Main

use ir
use module_io

fn push_header(bytes: Vec<i64>) {
    bytes.push(MODULE_MAGIC_0());
    bytes.push(MODULE_MAGIC_1());
    bytes.push(MODULE_MAGIC_2());
    bytes.push(MODULE_MAGIC_3());
    bytes.push(MODULE_VERSION());
    bytes.push(0);
    bytes.push(0);
    bytes.push(0);
}

fn main() -> i32 [io] {
    let bytes: Vec<i64> = Vec::new();
    push_header(bytes);
    bytes.push(0);
    bytes.push(5);
    bytes.push(0);
    bytes.push(0);
    let res: ModuleDecode = module_decode(bytes);
    if module_decode_failed(res) {
        print_str(module_decode_error_json(res));
        print_str(String::from("\n"));
        return 1;
    }
    0
}
