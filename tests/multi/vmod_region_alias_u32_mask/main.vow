// TEST: stdout "0"
// An alias index is written as a u32: an in-range value is unchanged and anything else is
// reduced modulo 2^32, since nothing bounds the elements of a Vec for the verifier.
module Main

use ir
use module_io

fn expect(out: Vec<i64>, at: u64, want: i64) -> i64 {
    if at >= out.len() { return 1; }
    if out[at] != want { return 1; }
    0
}

fn main() -> i32 [io] {
    let out: Vec<i64> = Vec::new();
    let aliases: Vec<i64> = Vec::new();
    aliases.push(5);
    aliases.push(-1);
    aliases.push(4294967303);
    region_constraint_encode(out, RSUM_KIND_ALIAS_OF_ANY(), 0, aliases);

    let mut fail: i64 = 0;
    if out.len() != 14 { fail = fail + 1; }
    fail = fail + expect(out, 0, 2);
    fail = fail + expect(out, 1, 3);
    fail = fail + expect(out, 2, 5);
    fail = fail + expect(out, 3, 0);
    fail = fail + expect(out, 4, 0);
    fail = fail + expect(out, 5, 0);
    fail = fail + expect(out, 6, 255);
    fail = fail + expect(out, 7, 255);
    fail = fail + expect(out, 8, 255);
    fail = fail + expect(out, 9, 255);
    fail = fail + expect(out, 10, 7);
    fail = fail + expect(out, 11, 0);
    fail = fail + expect(out, 12, 0);
    fail = fail + expect(out, 13, 0);
    print_i64(fail);
    0
}
