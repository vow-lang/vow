// TEST: stdout "[]\n[7]\n[2 7 -1 3]\n1 1 0\n1 1 0\n1 1 0\n[]\n[1 3 5 10]\n2\n"
module Main
use vec_math

fn show(v: Vec<i64>) [io] {
    print_str(String::from("["));
    let n: u64 = v.len() as u64;
    let mut i: u64 = 0;
    while i < n {
        if i > 0 {
            print_str(String::from(" "));
        }
        print_i64(v[i]);
        i = i + 1;
    }
    print_str(String::from("]\n"));
}

fn flags(a: bool, b: bool, c: bool) [io] {
    if a { print_i64(1); } else { print_i64(0); }
    print_str(String::from(" "));
    if b { print_i64(1); } else { print_i64(0); }
    print_str(String::from(" "));
    if c { print_i64(1); } else { print_i64(0); }
    print_str(String::from("\n"));
}

fn main() -> i32 [io] {
    let empty: Vec<i64> = Vec::new();
    let one: Vec<i64> = Vec::new();
    one.push(7);
    let many: Vec<i64> = Vec::new();
    many.push(3);
    many.push(-1);
    many.push(7);
    many.push(2);

    show(vec_reverse(empty));
    show(vec_reverse(one));
    show(vec_reverse(many));

    flags(vec_is_sorted(empty), vec_is_sorted(one), vec_is_sorted(many));
    flags(vec_all_in_range(empty, 0, 1), vec_all_in_range(one, 0, 10), vec_all_in_range(many, 0, 5));

    let sorted: Vec<i64> = Vec::new();
    sorted.push(1);
    sorted.push(2);
    sorted.push(2);
    sorted.push(5);
    flags(vec_is_sorted(sorted), vec_all_in_range(sorted, 1, 5), vec_all_in_range(sorted, 2, 5));
    show(vec_prefix_sum(empty));
    show(vec_prefix_sum(sorted));
    print_i64(vec_mean(many));
    print_str(String::from("\n"));
    0
}
