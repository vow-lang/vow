// TEST: exit 134
// A count encoded as [0x80, 0x00] is a non-minimal spelling of 0; two byte
// streams must never decode to the same module, so the decoder rejects it.
module Main

use ir
use module_io

fn main() -> i32 [panic] {
    let bytes: Vec<i64> = Vec::new();
    bytes.push(MODULE_MAGIC_0());
    bytes.push(MODULE_MAGIC_1());
    bytes.push(MODULE_MAGIC_2());
    bytes.push(MODULE_MAGIC_3());
    bytes.push(MODULE_VERSION());
    bytes.push(0);
    bytes.push(0);
    bytes.push(0);
    bytes.push(0);
    bytes.push(128);
    bytes.push(0);
    bytes.push(0);
    bytes.push(0);
    bytes.push(0);
    let _m: IrModule = module_decode(bytes);
    0
}
