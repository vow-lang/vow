// TEST: stdout "0"
// The writers are total on the values the wire format has a width for: a value wider than its
// field is reduced to the field's width (the verifier cannot bound the elements of a `Vec`).
// In-range values keep their bytes (`vmod_region_roundtrip`); a value with no encoding at all
// still aborts (`vmod_rejects_invalid_instdata_encode`).
module Main

use ir
use module_io

fn expect_bytes(out: Vec<i64>, want: Vec<i64>) -> i64 {
    if out.len() != want.len() { return 1; }
    let mut i: u64 = 0;
    let n: u64 = want.len();
    while i < n vow {
        invariant: i <= n
    } {
        if out[i] != want[i] { return 1; }
        i = i + 1;
    }
    0
}

fn push_u32(v: Vec<i64>, a: i64, b: i64, c: i64, d: i64) {
    v.push(a);
    v.push(b);
    v.push(c);
    v.push(d);
}

fn wide_inst_fields() -> i64 {
    let inst: IrInst = ir_inst_new(0 - 1, 65543, 259, Vec::new(), IDATA_NONE(), 0, 0, String::from(""));
    inst.ostart = 4294967296;
    inst.olen = 0 - 1;
    inst.rgn = 1099511627777;
    let out: Vec<i64> = Vec::new();
    write_inst(out, inst);
    let want: Vec<i64> = Vec::new();
    push_u32(want, 255, 255, 255, 255);
    want.push(7);
    want.push(0);
    want.push(3);
    want.push(0);
    want.push(0);
    push_u32(want, 0, 0, 0, 0);
    push_u32(want, 255, 255, 255, 255);
    want.push(1);
    push_u32(want, 0, 0, 0, 0);
    expect_bytes(out, want)
}

fn wide_region() -> i64 {
    let inst: IrInst = ir_inst_new(1, IOP_CONST_I64(), ITY_I64(), Vec::new(), IDATA_NONE(), 0, 0, String::from(""));
    inst.rgn = 0 - 5;
    let out: Vec<i64> = Vec::new();
    write_inst(out, inst);
    let want: Vec<i64> = Vec::new();
    push_u32(want, 1, 0, 0, 0);
    want.push(IOP_CONST_I64());
    want.push(0);
    want.push(ITY_I64());
    want.push(0);
    want.push(0);
    push_u32(want, 0, 0, 0, 0);
    push_u32(want, 0, 0, 0, 0);
    want.push(3);
    push_u32(want, 0, 0, 0, 0);
    expect_bytes(out, want)
}

fn main() -> i32 [io] {
    let fail: i64 = wide_inst_fields() + wide_region();
    print_i64(fail);
    0
}
