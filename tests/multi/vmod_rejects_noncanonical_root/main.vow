// TEST: exit 1
// TEST: stdout "{"error":"ModuleDecodeError","kind":"InvalidKind","label":"RegionId.payload","value":1,"offset":1}\n"
// A Root region with a nonzero payload is InvalidKind labelled RegionId.payload.
module Main

use ir
use module_io

fn main() -> i32 [io] {
    let bytes: Vec<i64> = Vec::new();
    bytes.push(REGION_KIND_ROOT());
    bytes.push(1);
    bytes.push(0);
    bytes.push(0);
    bytes.push(0);
    let r: ModuleReader = reader_new(bytes);
    let _rgn: i64 = region_decode(r);
    if r.err_kind != DEC_OK() {
        print_str(decode_error_json(r.err_kind, r.err_label, r.err_value, r.err_offset));
        print_str(String::from("\n"));
        return 1;
    }
    0
}
