// TEST: exit 134
// A LEB count with more continuation bytes than a u64 can hold is corrupt.
module Main

use ir
use module_io

fn push_header(bytes: Vec<i64>) {
    bytes.push(MODULE_MAGIC_0());
    bytes.push(MODULE_MAGIC_1());
    bytes.push(MODULE_MAGIC_2());
    bytes.push(MODULE_MAGIC_3());
    bytes.push(MODULE_VERSION());
    bytes.push(0);
    bytes.push(0);
    bytes.push(0);
}

fn push_u64_max_leb(bytes: Vec<i64>) {
    let mut i: u64 = 0;
    while i < 9 {
        bytes.push(255);
        i = i + 1;
    }
    bytes.push(1);
}

fn main() -> i32 [panic] {
    let bytes: Vec<i64> = Vec::new();
    push_header(bytes);
    bytes.push(0);
    let mut i: u64 = 0;
    while i < 12 {
        bytes.push(128);
        i = i + 1;
    }
    bytes.push(0);
    bytes.push(0);
    bytes.push(0);
    bytes.push(0);
    let _m: IrModule = module_decode(bytes);
    0
}
