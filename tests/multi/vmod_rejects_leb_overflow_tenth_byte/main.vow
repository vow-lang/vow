// TEST: exit 134
// A 10-byte LEB whose last byte carries bits past 2^63 used to wrap silently
// to a smaller count; the decoder must reject it, as the Rust decoder does.
module Main

use ir
use module_io

fn main() -> i32 [panic] {
    let bytes: Vec<i64> = Vec::new();
    bytes.push(MODULE_MAGIC_0());
    bytes.push(MODULE_MAGIC_1());
    bytes.push(MODULE_MAGIC_2());
    bytes.push(MODULE_MAGIC_3());
    bytes.push(MODULE_VERSION());
    bytes.push(0);
    bytes.push(0);
    bytes.push(0);
    bytes.push(0);
    let mut i: u64 = 0;
    while i < 9 {
        bytes.push(128);
        i = i + 1;
    }
    bytes.push(2);
    bytes.push(0);
    bytes.push(0);
    bytes.push(0);
    let _m: IrModule = module_decode(bytes);
    0
}
