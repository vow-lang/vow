module MatchOptionNonePayloadArity

fn unwrap_or_zero(value: Option<i64>) -> i64 {
    match value {
        Option::Some(inner) => { inner },
        Option::None(extra) => { 0 },
    }
}

fn main() -> i32 {
    0
}
