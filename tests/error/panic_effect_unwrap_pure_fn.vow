// TEST: error-code EffectViolation
//
// Issue #622: `.unwrap()` is the only abort source gated by `[panic]`. A pure
// function that unwraps an Option is rejected; indexing and checked
// arithmetic are not gated (see tests/run/index_checked_arith_no_panic_effect.vow).
module panic_effect_unwrap_pure_fn

fn first(o: Option<i64>) -> i64 {
    o.unwrap()
}

fn main() -> i32 [io] {
    0
}
