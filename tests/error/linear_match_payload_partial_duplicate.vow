// TEST: error-code LinearTypeViolation
// TEST: stderr "already consumed"
module LinearMatchPayloadPartialDuplicate

linear struct Token {
    id: i64,
}

enum Payload {
    Token(Token),
    Empty,
}

fn consume(token: Token) -> () {
    let sink: Vec<Token> = Vec::new();
    sink.push(token);
}

fn duplicate(value: Payload, branch: bool) -> () {
    match value {
        Payload::Token(token) => {
            if branch {
                consume(token);
            } else {
                let skipped: i64 = 0;
            };
            consume(token);
        },
        Payload::Empty => { let skipped: i64 = 0; },
    }
}

fn main() -> i32 {
    duplicate(Payload::Token(Token { id: 1 }), true);
    0
}
