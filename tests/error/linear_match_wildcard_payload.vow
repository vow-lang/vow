// TEST: error-code LinearTypeViolation
// TEST: stderr "wildcard pattern discards a linear value"
module LinearMatchWildcardPayload

linear struct Token {
    id: i64,
}

enum Payload {
    Token(Token),
    Empty,
}

fn discard(value: Payload) -> i64 {
    match value {
        Payload::Token(_) => { 1 },
        Payload::Empty => { 0 },
    }
}

fn main() -> i32 {
    discard(Payload::Token(Token { id: 1 }));
    0
}
