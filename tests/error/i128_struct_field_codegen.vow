module I128StructFieldCodegen

struct Box {
    value: i128,
}

fn main() -> i32 {
    let boxed: Box = Box { value: 18446744073709551616 };
    let value: i128 = boxed.value;
    if value == 0 { 0 } else { 1 }
}
