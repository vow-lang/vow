// TEST: error-code RegionLinear
module LinearIfMutationPhiLeak

linear struct Token {
    id: i64,
}

fn leak(branch: bool) -> () {
    let mut value: Option<Token> = Option::None;
    if branch {
        value = Option::Some(Token { id: 1 });
    } else {};
}

fn main() -> i32 {
    leak(true);
    0
}
