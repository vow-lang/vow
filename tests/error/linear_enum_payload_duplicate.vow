// TEST: error-code LinearTypeViolation
// TEST: stderr "linear value `value` already consumed"
module LinearEnumPayloadDuplicate

linear struct Token {
    id: i64,
}

enum Payload {
    Token(Token),
    Empty,
}

fn take(value: Payload) -> Token {
    match value {
        Payload::Token(token) => { token },
        Payload::Empty => { Token { id: -1 } },
    }
}

fn duplicate(value: Payload) -> Token {
    let first: Token = take(value);
    let second: Token = take(value);
    let sink: Vec<Token> = Vec::new();
    sink.push(first);
    second
}

fn main() -> i32 {
    let token: Token = duplicate(Payload::Token(Token { id: 1 }));
    let sink: Vec<Token> = Vec::new();
    sink.push(token);
    0
}
