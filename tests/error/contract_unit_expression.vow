// TEST: error-code UnsupportedFeature
// TEST: stderr "tuple expressions are not supported in contract predicates"
// The empty tuple `()` has no IR representation either, so it is rejected inside a
// contract clause like any other tuple expression instead of reaching IR lowering.
module ContractUnitExpression

fn unit_value(a: i64) -> i64 vow {
    requires: { let u = (); a != 0 }
} {
    a
}

fn main() -> i32 {
    0
}
