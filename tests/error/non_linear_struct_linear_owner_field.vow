// TEST: error-code LinearTypeViolation
module NonLinearStructLinearOwnerField

linear struct Token {
    id: i64,
}

enum Payload {
    Token(Token),
    Empty,
}

struct Holder {
    payload: Payload,
}

fn consume(token: Token) -> () {
    let sink: Vec<Token> = Vec::new();
    sink.push(token);
}

fn duplicate(holder: Holder) -> () {
    match holder.payload {
        Payload::Token(token) => { consume(token); },
        Payload::Empty => {},
    };
    match holder.payload {
        Payload::Token(token) => { consume(token); },
        Payload::Empty => {},
    };
}

fn main() -> i32 {
    0
}
