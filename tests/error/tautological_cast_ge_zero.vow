// TEST: stderr "comparison with 0 is always true for unsigned type `u64`"
// A cast around the literal bound (`0 as u64`) must not hide the tautology:
// the const fold behind the diagnostic has to see through `as` casts.
module TautologicalCastGeZero

fn f(x: u64) -> bool {
  x >= 0 as u64
}

fn main() -> i32 { 0 }
