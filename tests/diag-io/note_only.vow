module NoteOnly

// Compiles with a RegionRootEscape note and no error: the frontend emits a
// diagnostic on a successful compile, so a dead stderr has something to fail on.
fn try_get(m: BTreeMap<i64, i64>) -> Option<i64> {
    let r: Option<i64> = m.get(99);
    let v: i64 = r?;
    Option::Some(v)
}

fn main() -> i32 {
    let m: BTreeMap<i64, i64> = BTreeMap::new();
    try_get(m);
    0
}
