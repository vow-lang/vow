// TEST: category unverifiable
// TEST: skip-reason unmodeled-builtin
// The float bit hooks carry an `f64` as a `u64`, but their other side is a
// `String`, which the native verifier has no value model for: the call is an
// unmodelled builtin.
module FloatBitsHookSkipped

fn bits_of(s: String) -> u64 vow {
  ensures: result != 7u64
} {
  parse_f64_bits(s)
}

fn main() -> i32 [io] {
  0
}
