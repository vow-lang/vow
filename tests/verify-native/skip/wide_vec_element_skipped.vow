// TEST: skip-reason unsupported-opcode
module WideVecElementSkipped

struct Bag { items: Vec<i128> }

// A `Vec<i128>` held in a field of a parameter is read through a handle (`vc_heap`),
// which models one 8-byte slot per element; the two-slot element stays `Skipped`.
// A `Vec<i128>` of its own (a parameter or a local) is modelled.
fn first(b: Bag) -> i128 vow {
  requires: b.items.len() > 0
} {
  b.items[0]
}

fn main() -> i32 [io] {
  print_i64(0);
  0
}
