// TEST: skip-reason unmodeled-builtin
module WideVecElementSkipped

// A `Vec<i128>` element stays `Skipped` (like every collection) until the Vec
// model of #1423 lands; 128-bit struct fields and enum payloads are modelled.
fn first(v: Vec<i128>) -> i128 vow {
  requires: v.len() > 0
} {
  v[0]
}

fn main() -> i32 [io] {
  print_i64(0);
  0
}
