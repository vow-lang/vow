// TEST: category unverifiable
// TEST: skip-reason non-modelable-callee
module CalleeFloatRem

fn fract_scaled(x: i64) -> i64 {
  let a: f64 = 7.5;
  let b: f64 = 2.0;
  let r: f64 = a % b;
  if r > 1.0 {
    return x + 1;
  }
  x
}

fn outer(x: i64) -> i64 vow {
  ensures: result >= x
} {
  fract_scaled(x)
}

fn main() -> i32 [io] {
  print_i64(outer(3));
  0
}
