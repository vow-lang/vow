// TEST: skip-reason unsupported-opcode
// The `Vec`s merged by the `if`/`else` are parameters: the elements a parameter already holds are
// memory the caller gave, which the address model cannot tell from the pointer the function stored,
// so reading an element back from the merged `Vec` stays `Skipped`, never a free answer.
// (`pass/vec_pointer_elem_phi_receiver.vow` is the same merge of `Vec`s the function built.)
module VecPointerPhiReadBackSkipped

fn pick(c: bool, a: Vec<Vec<i64>>, b: Vec<Vec<i64>>) -> u64 vow {
  ensures: result == 0
} {
  let w: Vec<i64> = Vec::new();
  a.push(w);
  let v: Vec<Vec<i64>> = if c { a } else { b };
  let e: Vec<i64> = v[0];
  e.len()
}

fn main() -> i32 [io] {
  let a: Vec<Vec<i64>> = Vec::new();
  let b: Vec<Vec<i64>> = Vec::new();
  print_u64(pick(true, a, b));
  0
}
