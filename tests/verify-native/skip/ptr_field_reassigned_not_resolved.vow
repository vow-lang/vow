// TEST: skip-reason unsupported-opcode
// The field is stored twice, so the read has no single value the model can name and the
// push stays a write through a handle, which is not modelled.
module PtrFieldReassignedNotResolved

struct Block { id: i64, insts: Vec<i64> }

fn fill() -> u64 vow {
  ensures: result == 1
} {
  let b: Block = Block { id: 7, insts: Vec::new() };
  b.insts = Vec::new();
  b.insts.push(1);
  b.insts.len()
}

fn main() -> i32 [io] {
  print_u64(fill());
  0
}
