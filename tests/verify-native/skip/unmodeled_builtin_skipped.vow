// TEST: category unverifiable
// TEST: skip-reason unmodeled-builtin
module UnmodeledBuiltinSkipped

// Substring search needs an existential over the match position, which the
// String model does not encode (`vc_str_unmodeled_reason`).
fn found(s: String, t: String) -> bool vow {
  ensures: result == result
} {
  s.contains(t)
}

fn main() -> i32 [io] {
  if found(String::from("a"), String::from("a")) { print_u64(1); }
  0
}
