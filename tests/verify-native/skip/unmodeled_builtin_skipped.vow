// TEST: category unverifiable
// TEST: skip-reason unmodeled-builtin
module UnmodeledBuiltinSkipped

// `replace` validates its three strings as UTF-8 and then follows Rust's `str::replace`
// (left-to-right non-overlapping matches whose count sets the result length), a fold over the
// match positions the String model does not encode, and it has no opaque-result route either
// (that needs a congruence over all three operands). The call is `unmodeled-builtin` (its
// `verifier_skip_reason` in docs/spec/operations.json says why).
fn replaced_length(s: String) -> u64 vow {
  ensures: result == result
} {
  string_replace(s, String::from("a"), String::from("b")).len()
}

fn main() -> i32 [io] {
  print_u64(replaced_length(String::from("aba")));
  0
}
