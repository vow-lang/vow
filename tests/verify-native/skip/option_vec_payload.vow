// TEST: skip-reason unsupported-opcode
// TEST: native-gap "the payload of an Option parameter is a Vec, a collection the model keeps per parameter and not per object, and which collections are one object is decided by #1663, so the function is skipped where ESBMC proves it" #1663
// The payload of an `Option` parameter is a `Vec`: the pointer read out of the
// field is a collection, which the model keeps per parameter, not per object. The
// payload is not read as a handle here (`vc_payload`): a `Vec` handle is a part of
// the object identity of #1663, so the read stays a pointer used as a collection.
module OptionVecPayload

fn first_len(o: Option<Vec<i64>>) -> i64 vow {
  ensures: result >= 0
} {
  match o {
    Option::Some(v) => v.len() as i64,
    Option::None => 0,
  }
}

fn main() -> i32 {
  0
}
