// TEST: category unverifiable
// TEST: skip-reason unsupported-opcode
// An `Option<String>` payload is a pointer slot, which the aggregate model does
// not scalarise (only `bool` and integer fields are terms), whatever the String
// model can do with the string itself.
module OptionStringPayload

fn name_len(o: Option<String>) -> i64 [panic] vow {
  ensures: result >= 0
} {
  o.unwrap().len() as i64
}

fn main() -> i32 [io, panic] {
  print_i64(name_len(Option::Some(String::from("ab"))));
  0
}
