// TEST: category unverifiable
// TEST: skip-reason unsupported-opcode
// A `Vec` element is a 64-bit bit-vector in the array model, and SMT-LIB has no
// bit-exact conversion from a float, so a `Vec` of floats is not modelled.
module FloatVecSkipped

fn count(x: f64) -> u64 vow {
  ensures: result == 1u64
} {
  let v: Vec<f64> = Vec::new();
  v.push(x);
  v.len()
}

fn main() -> i32 [io] {
  0
}
