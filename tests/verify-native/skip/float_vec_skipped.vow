// TEST: category unverifiable
// TEST: skip-reason unsupported-opcode
// The native verifier does not model a `Vec` of floats: the lowerer moves a float
// into and out of the runtime's 8-byte slot with `F64ToBits` and `BitsToF64`
// (#1681), and the executor has no encoding for them yet.
module FloatVecSkipped

fn count(x: f64) -> u64 vow {
  ensures: result == 1u64
} {
  let v: Vec<f64> = Vec::new();
  v.push(x);
  v.len()
}

fn main() -> i32 [io] {
  0
}
