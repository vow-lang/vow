// TEST: category unverifiable
// TEST: skip-reason unsupported-opcode
// A `Vec` of floats is not modelled: neither compiler can generate code for one
// (#1681; the lowerer types the slot read as `i64`), so the gate skips it.
module FloatVecSkipped

fn count(x: f64) -> u64 vow {
  ensures: result == 1u64
} {
  let v: Vec<f64> = Vec::new();
  v.push(x);
  v.len()
}

fn main() -> i32 [io] {
  0
}
