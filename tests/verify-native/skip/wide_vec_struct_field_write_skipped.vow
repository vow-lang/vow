// TEST: skip-reason unsupported-opcode
module WideVecStructFieldWriteSkipped

struct Bag { items: Vec<i128> }

// A `Vec<i128>` held in a field of a parameter is read through a handle, and handle memory has
// no write model: a `set` on it stays `Skipped`, never given a free answer.
fn write_then_read(b: Bag, x: i128) -> bool vow {
  requires: b.items.len() > 0,
  ensures: result
} {
  b.items[0] = x;
  b.items[0] == x
}

fn main() -> i32 [io] {
  print_i64(0);
  0
}
