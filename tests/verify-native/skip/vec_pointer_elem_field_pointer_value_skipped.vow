// TEST: skip-reason unsupported-opcode
// TEST: native-gap "a pointer written through an element of a Vec stores an object address in a field of the element, which the model does not do (ESBMC ends in an error verdict here)" #1663
// A pointer written through an element (`people[0].tag = ...`) stores an object address in a field of
// the element, which the model does not do: the function stays `Skipped`.
module VecPointerElemFieldPointerValueSkipped

struct Person { tag: Vec<i64> }

fn retag() -> u64 vow {
  ensures: result == 1
} {
  let people: Vec<Person> = Vec::new();
  people.push(Person { tag: Vec::new() });
  let t: Vec<i64> = Vec::new();
  t.push(1);
  people[0].tag = t;
  let u: Vec<i64> = people[0].tag;
  u.len()
}

fn main() -> i32 [io] {
  print_u64(retag());
  0
}
