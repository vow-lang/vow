// TEST: skip-reason unsupported-opcode
// A write to a parameter in a function that reads a payload out of another: the
// payload may be the very object the parameter names, so the read is not modelled.
module OptionPayloadParamWrite

struct Handle {
  fd: i64,
}

fn after_write(o: Option<Handle>, h: Handle) -> i64 vow {
  ensures: result >= 0
} {
  h.fd = 5;
  match o {
    Option::Some(x) => {
      if x.fd < 0 { 0 } else { x.fd }
    },
    Option::None => 0,
  }
}

fn main() -> i32 {
  0
}
