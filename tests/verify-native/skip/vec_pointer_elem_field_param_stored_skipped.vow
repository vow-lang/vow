// TEST: skip-reason unsupported-opcode
// A parameter pushed into the `Vec` and written through the element: a caller may pass one value
// for `s` and `t` (`f(p, p)` returns 5), so the function stays `Skipped`.
module VecPointerElemFieldParamStoredSkipped

struct Person { age: i64 }

fn f(s: Person, t: Person) -> i64 vow {
  requires: t.age == 4
  ensures: result == 4
} {
  let people: Vec<Person> = Vec::new();
  people.push(s);
  people[0].age = 5;
  t.age
}

fn main() -> i32 [io] {
  let p: Person = Person { age: 4 };
  print_i64(f(p, p));
  0
}
