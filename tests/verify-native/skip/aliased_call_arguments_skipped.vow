// TEST: category unverifiable
// TEST: skip-reason unsupported-opcode
// `tail` is proven for parameters that are different objects, and `run` passes one value for both:
// the call is outside what the proof says, so `run` is skipped instead of being decided.
module AliasedCallArgumentsSkipped

fn tail(a: Vec<i64>, b: Vec<i64>) -> i64 vow {
    requires: a.len() > 0 && b.len() > 0
} {
    let n: u64 = b.len();
    a.pop();
    b[n - 1]
}

fn run(v: Vec<i64>) -> i64 vow {
    requires: v.len() == 1
} {
    tail(v, v)
}

fn main() -> i32 { 0 }
