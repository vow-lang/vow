// TEST: category unverifiable
// TEST: skip-reason unmodeled-builtin
module CModelBuiltinUnmodeledNatively

// `string_trim` and `string_to_upper` are modelled by the ESBMC C model
// (`c_model` in docs/spec/operations.json) but not by the native verifier
// (`verifier_model: unmodeled`, and no entry in the `String` table of `vc_ops`),
// so the native gate still reports them as `unmodeled-builtin`, never as the
// generic `unsupported-opcode` a `known` entry would give.
fn trimmed(s: String) -> i64 vow {
  ensures: result == 1
} {
  let t: String = string_trim(s);
  1
}

fn upper(s: String) -> i64 vow {
  ensures: result == 1
} {
  let t: String = string_to_upper(s);
  1
}

fn main() -> i32 [io] {
  print_i64(trimmed(String::from(" a ")) + upper(String::from("a")));
  0
}
