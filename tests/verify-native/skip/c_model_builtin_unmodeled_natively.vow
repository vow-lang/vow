// TEST: category unverifiable
// TEST: skip-reason unmodeled-builtin
module CModelBuiltinUnmodeledNatively

// `string_trim`, `string_to_upper` and `parse_i64` are modelled by the ESBMC C
// model (`c_model` in docs/spec/operations.json) but not by the native
// verifier (`verifier_model: unmodeled`), so the native gate still reports them
// as `unmodeled-builtin`, never as the generic `unsupported-opcode` a `known`
// entry would give.
fn trimmed(s: String) -> i64 vow {
  ensures: result == 1
} {
  let t: String = string_trim(s);
  1
}

fn upper(s: String) -> i64 vow {
  ensures: result == 1
} {
  let t: String = string_to_upper(s);
  1
}

fn parsed(s: String) -> i64 vow {
  ensures: result == 1
} {
  let p: Option<i64> = parse_i64(s);
  1
}

fn main() -> i32 [io] {
  print_i64(trimmed(String::from(" a ")) + upper(String::from("b")) + parsed(String::from("7")));
  0
}
