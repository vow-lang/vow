// TEST: skip-reason unsupported-opcode
// A callee that returns its struct parameter, called with a struct loaded out of a
// field: the model would feed an address (`i64`) into an object Phi, so the call
// stays Skipped.
module HeapHandleReturnedAsObject

struct Bag { items: Vec<i64> }
struct Outer { bag: Bag }

fn pass_through(b: Bag) -> Bag {
  b
}

fn size(o: Outer) -> u64 vow {
  ensures: result == result
} {
  pass_through(o.bag).items.len()
}

fn main() -> i32 [io] {
  let o: Outer = Outer { bag: Bag { items: Vec::new() } };
  print_u64(size(o));
  0
}
