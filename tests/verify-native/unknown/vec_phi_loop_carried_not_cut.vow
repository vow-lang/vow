// TEST: category loop
// A loop that switches the Vec a variable names is never cut by its invariant (a
// pointer Phi in a loop has no havoc), so a symbolic bound is decided by unwinding
// alone: the claim is neither proven nor refuted, never `Verified`.
module VecPhiLoopCarriedNotCut

fn pick(n: i64) -> u64 vow {
  requires: n >= 0
  ensures: result == 1
} {
  let a: Vec<i64> = Vec::new();
  let b: Vec<i64> = Vec::new();
  let mut v: Vec<i64> = a;
  let mut i: i64 = 0;
  while i < n vow {
    invariant: i >= 0 && i <= n
  } {
    if i == 1 {
      v = b;
    }
    i = i + 1;
  }
  v.push(1);
  v.len()
}

fn main() -> i32 [io] {
  print_u64(pick(3));
  0
}
