// TEST: category loop
// A loop that switches the map a variable names is never cut by its invariant (a pointer Phi in a
// loop has no havoc), so a symbolic bound is decided by unwinding alone: the claim is neither
// proven nor refuted, never `Verified`.
module MapPhiLoopCarriedNotCut

fn pick(n: i64) -> u64 vow {
  requires: n >= 0
  ensures: result == 1
} {
  let a: HashMap<i64, i64> = HashMap::new();
  let b: HashMap<i64, i64> = HashMap::new();
  let mut m: HashMap<i64, i64> = a;
  let mut i: i64 = 0;
  while i < n vow {
    invariant: i >= 0 && i <= n
  } {
    if i == 1 {
      m = b;
    }
    i = i + 1;
  }
  m.insert(1, 1);
  m.len()
}

fn main() -> i32 [io] {
  print_u64(pick(3));
  0
}
