// TEST: unknown-reason unconstrained map state
// TEST: native-gap "the key type of the map is not known, so a failure that depends on the map state is not reported; ESBMC refutes it" #1853
module MapNarrowParamPresentKeyWrong

// A real run exists (a map holding `-5`), but an `i32` key has 2^32 values, so the length and the
// keys of a map the function did not build are not related by the model, and the verifier reports
// a failure that depends on them only when it holds for every state. This one does not: the map
// may lack `k`.
fn lookup(m: HashMap<i32, i32>, k: i32) -> bool vow {
  requires: k == 0i32 - 5i32
  ensures: !m.contains_key(k)
} {
  m.contains_key(k)
}

fn main() -> i32 [io] {
  let m: HashMap<i32, i32> = HashMap::new();
  if lookup(m, 0i32 - 5i32) { print_u64(1); }
  0
}
