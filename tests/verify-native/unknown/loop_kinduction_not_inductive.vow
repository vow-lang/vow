// TEST: category invariant
// No invariant. `d` counts up from 1 and wraps to 0 only after 2^64 iterations,
// far beyond the unrolling bound, so the bounded rounds find nothing and stay
// open. The step case has a state `d == -k` that reaches the division by zero at
// copy k for every k: it proves nothing, and the result is unknown, never
// Verified and never failed.
module LoopKInductionNotInductive

fn scale(n: i64) -> i64 vow {
  requires: n >= 0
  ensures: result == n
} {
  let mut i: i64 = 0;
  let mut d: i64 = 1;
  let mut acc: i64 = 0;
  while i < n {
    acc = acc + 100 / d;
    d = d + 1;
    i = i + 1;
  }
  i + acc - acc
}

fn main() -> i32 [io] {
  print_i64(scale(5));
  0
}
