// TEST: unknown-reason unwinding assertion
// A field written through an element in a loop with a symbolic trip count is decided by unrolling
// only: the loop is never cut, so no run longer than the bound is claimed, and the verdict is
// unknown, not proven.
module VecPointerElemFieldWriteInLoopUnknown

struct Cell { v: i64 }

fn fill(n: u64) -> i64 vow {
  requires: n >= 1
  ensures: result == 7
} {
  let cells: Vec<Cell> = Vec::new();
  cells.push(Cell { v: 0 });
  let mut j: u64 = 0;
  while j < n {
    cells[0].v = 7;
    j = j + 1;
  }
  cells[0].v
}

fn main() -> i32 [io] {
  print_i64(fill(2));
  0
}
