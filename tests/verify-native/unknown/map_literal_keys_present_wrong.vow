// TEST: unknown-reason unconstrained map state
module MapLiteralKeysPresentWrong

// Both keys are literals, which say nothing about the key type, so the failure (a map holding `1`
// and `2`) depends on a map state the model cannot relate to a key domain; it is reported only when
// it holds for every state, and the map may lack either key.
fn not_both(m: HashMap<i64, i64>) -> bool vow {
  ensures: !result
} {
  m.contains_key(1) && m.contains_key(2)
}

fn main() -> i32 [io] {
  let m: HashMap<i64, i64> = HashMap::new();
  if not_both(m) { print_u64(1); }
  0
}
