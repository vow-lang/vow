// TEST: summary-baseline failed
// TEST: summary-budget 200
// `reset` stores a Vec it built, with one element, into a pointer slot of its parameter. The slot is
// havoced to an unconstrained handle, so the caller cannot conclude the Vec is empty.
struct H { items: Vec<i64>, n: i64 }

fn reset(h: H, n: i64) {
    let p1: i64 = n & 255;
    let p2: i64 = (n / 2) & 255;
    let p3: i64 = (p1 + p2) & 255;
    let p4: i64 = (p3 * 3) & 255;
    let p5: i64 = (p4 + p1) & 255;
    let p6: i64 = (p5 + p2) & 255;
    let p7: i64 = (p6 * 5 + p1) & 255;
    let p8: i64 = (p7 + p6 + p5) & 255;
    let p9: i64 = (p8 * 7 + p4) & 255;
    let p10: i64 = (p9 + p3 + p2) & 255;
    let p11: i64 = (p10 * 3 + p8) & 255;
    let p12: i64 = (p11 + p10 + p1) & 255;
    let p13: i64 = p12 & 15;
    let w: Vec<i64> = Vec::new();
    w.push(p13 + 1);
    h.items = w;
}

fn run(v: Vec<i64>) -> i64 vow {
    requires: v.len() == 0,
    ensures: result == 0
} {
    let h: H = H { items: v, n: 0 };
    reset(h, 1);
    reset(h, 2);
    reset(h, 3);
    reset(h, 4);
    h.items.len() as i64
}

fn main() -> i32 { 0 }
