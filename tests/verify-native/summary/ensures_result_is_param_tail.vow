// TEST: summary-budget 60
// Same as ensures_result_is_param.vow with the paths swapped, so the site that returns the
// parameter is the last one: whichever site a clause is copied from, the copies must agree.
fn pick(x: i64, n: i64) -> i64 vow {
    requires: x <= 0 || x > 10,
    ensures: x <= 0 || result > 5
} {
    let p1: i64 = n & 255;
    let p2: i64 = (n / 2) & 255;
    let p3: i64 = (p1 + p2) & 255;
    let p4: i64 = (p3 * 3) & 255;
    let p5: i64 = (p4 + p1) & 255;
    let p6: i64 = (p5 + p2) & 255;
    let p7: i64 = (p6 * 5 + p1) & 255;
    let p8: i64 = (p7 + p6 + p5) & 255;
    let p9: i64 = (p8 * 7 + p4) & 255;
    let p10: i64 = (p9 + p3 + p2) & 255;
    let p11: i64 = (p10 * 3 + p8) & 255;
    let p12: i64 = (p11 + p10 + p1) & 255;
    let p13: i64 = p12 & 15;
    if x <= 0 + (p13 - p13) {
        return 3;
    }
    x
}

fn run(a: i64, n: i64) -> i64 vow {
    requires: a <= 0,
    ensures: result != 3
} {
    pick(a, n)
}

fn main() -> i32 { 0 }
