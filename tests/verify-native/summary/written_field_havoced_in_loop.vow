// TEST: summary-expect unknown
// TEST: summary-baseline failed
struct R { pos: i64, end: i64, err: i64 }

fn step(r: R) -> i64 {
    let a: i64 = r.pos & 255;
    let b: i64 = (r.pos / 2) & 255;
    let c: i64 = a + b;
    if c > 100 {
        r.err = 1;
        return 0;
    }
    r.pos = r.pos + 1;
    c
}

fn run(r: R, n: i64) -> i64 vow {
    requires: r.pos == 0,
    requires: n >= 0,
    ensures: r.pos == 0
} {
    let mut i: i64 = 0;
    let mut t: i64 = 0;
    while i < n vow {
        invariant: i <= n
    } {
        t = t +! step(r);
        i = i + 1;
    }
    t
}
fn main() -> i32 { 0 }
