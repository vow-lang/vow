// TEST: summary-expect unknown
// TEST: summary-baseline failed
// TEST: summary-budget 300
// `pick` returns its parameter x on one path and, after a `let x = y`, the new x (the value of y) on the
// other, and its ensures names x at both returns: the lowerer reads a different x at each. The
// summary may assume neither alone.
fn pick(x: i64, y: i64, n: i64) -> i64 vow {
    requires: x >= 0 && y >= 0,
    ensures: result == x
} {
    let p1: i64 = n & 255;
    let p2: i64 = (n / 2) & 255;
    let p3: i64 = (p1 + p2) & 255;
    let p4: i64 = (p3 * 3) & 255;
    let p5: i64 = (p4 + p1) & 255;
    let p6: i64 = (p5 + p2) & 255;
    let p7: i64 = (p6 * 5 + p1) & 255;
    let p8: i64 = (p7 + p6 + p5) & 255;
    let p9: i64 = (p8 * 7 + p4) & 255;
    let p10: i64 = (p9 + p3 + p2) & 255;
    let p11: i64 = (p10 * 3 + p8) & 255;
    let p12: i64 = (p11 + p10 + p1) & 255;
    let p13: i64 = p12 & 15;
    if n > 100 {
        return x;
    }
    let x: i64 = y + (p13 - p13);
    return x;
}

fn run(a: i64, b: i64, n: i64) -> i64 vow {
    requires: a >= 0 && b >= 0,
    ensures: result == a
} {
    pick(a, b, n) + pick(a, b, n) + pick(a, b, n) + pick(a, b, n) - 3 * a
}

fn main() -> i32 { 0 }
