// TEST: summary-expect proven
// TEST: summary-budget 90
struct R { pos: i64, end: i64 }

fn step(r: R, n: i64) -> i64 vow {
    requires: r.end == 7
} {
    let p1: i64 = n & 255;
    let p2: i64 = (n / 2) & 255;
    let p3: i64 = (p1 + p2) & 255;
    let p4: i64 = (p3 * 3) & 255;
    let p5: i64 = (p4 + p1) & 255;
    let p6: i64 = (p5 + p2) & 255;
    r.pos = p6;
    p6
}

fn run(r: R) -> i64 vow {
    requires: r.end == 7,
    ensures: r.end == 7
} {
    step(r, 1) + step(r, 2) + step(r, 3) + step(r, 4)
}

fn main() -> i32 { 0 }
