// TEST: summary-baseline proven
fn fill(v: Vec<i64>, n: i64) {
    let p1: i64 = n & 255;
    let p2: i64 = (n / 2) & 255;
    let p3: i64 = (p1 + p2) & 255;
    let p4: i64 = (p3 * 3) & 255;
    let p5: i64 = (p4 + p1) & 255;
    let p6: i64 = (p5 + p2) & 255;
    v.push(p6);
}

fn run(v: Vec<i64>) -> i64 vow {
    ensures: result == 0
} {
    fill(v, 1); fill(v, 2); fill(v, 3); fill(v, 4);
    0
}

fn main() -> i32 { 0 }
