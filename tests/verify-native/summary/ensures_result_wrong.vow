fn inc(x: i64, n: i64) -> i64 vow {
    requires: x >= 0 && x < 1000,
    ensures: result == x + 1
} {
    let p1: i64 = n & 255;
    let p2: i64 = (n / 2) & 255;
    let p3: i64 = (p1 + p2) & 255;
    let p4: i64 = (p3 * 3) & 255;
    let p5: i64 = (p4 + p1) & 255;
    let p6: i64 = (p5 + p2) & 255;
    x + 1 + (p6 - p6)
}

fn run(x: i64) -> i64 vow {
    requires: x >= 0 && x < 500,
    ensures: result == x + 5
} {
    let a: i64 = inc(x, 1);
    let b: i64 = inc(a, 2);
    let c: i64 = inc(b, 3);
    inc(c, 4)
}

fn main() -> i32 { 0 }
