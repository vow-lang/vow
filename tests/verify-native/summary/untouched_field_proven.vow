// TEST: summary-expect proven
struct R { pos: i64, end: i64, err: i64 }

fn step(r: R) -> i64 {
    let a: i64 = r.pos & 255;
    let b: i64 = (r.pos / 2) & 255;
    let c: i64 = a + b;
    if c > 100 {
        r.err = 1;
        return 0;
    }
    r.pos = r.pos + 1;
    c
}

fn run(r: R) -> i64 vow {
    requires: r.end == 7,
    ensures: r.end == 7
} {
    let x: i64 = step(r);
    let y: i64 = step(r);
    let z: i64 = step(r);
    x + y + z
}
fn main() -> i32 { 0 }
