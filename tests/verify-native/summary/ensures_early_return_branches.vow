// TEST: summary-expect proven
// TEST: summary-budget 420
fn clampish(x: i64, n: i64) -> i64 vow {
    requires: x >= 0 && x < 1000,
    ensures: result >= 0 && result <= 501 && (result == 0 || result == x + 1)
} {
    let p1: i64 = n & 255;
    let p2: i64 = (n / 2) & 255;
    let p3: i64 = (p1 + p2) & 255;
    let p4: i64 = (p3 * 3) & 255;
    let p5: i64 = (p4 + p1) & 255;
    let p6: i64 = (p5 + p2) & 255;
    let p7: i64 = (p6 * 5 + p1) & 255;
    let p8: i64 = (p7 + p6 + p5) & 255;
    let p9: i64 = (p8 * 7 + p4) & 255;
    let p10: i64 = (p9 + p3 + p2) & 255;
    let p11: i64 = (p10 * 3 + p8) & 255;
    let p12: i64 = (p11 + p10 + p1) & 255;
    let p13: i64 = p12 & 15;
    if x > 500 {
        return 0;
    }
    x + 1 + (p13 - p13)
}

fn run(x: i64) -> i64 vow {
    requires: x >= 0 && x < 1000,
    ensures: result >= 0 && result <= 501
} {
    let a: i64 = clampish(x, 1);
    let b: i64 = clampish(a, 2);
    let c: i64 = clampish(b, 3);
    clampish(c, 4)
}

fn main() -> i32 { 0 }
