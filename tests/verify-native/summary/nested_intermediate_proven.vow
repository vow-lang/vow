// TEST: summary-expect proven
// TEST: summary-baseline proven
// TEST: summary-budget 100
// `mid` has no contract, so it is no verify target and no root of the proofs, yet it is above the
// budget: its callee `bump` has to be proven first, then `mid`, and only then is `run` decided.
struct R { pos: i64, end: i64 }

fn bump(r: R, n: i64) -> i64 {
    let p1: i64 = n & 255;
    let p2: i64 = (n / 2) & 255;
    let p3: i64 = (p1 + p2) & 255;
    let p4: i64 = (p3 * 3) & 255;
    let p5: i64 = (p4 + p1) & 255;
    let p6: i64 = (p5 + p2) & 255;
    r.pos = (r.pos & 255) + 1 + (p6 - p6);
    p6
}

fn mid(r: R, n: i64) -> i64 {
    bump(r, n) + bump(r, n + 1) + bump(r, n + 2) + bump(r, n + 3) + bump(r, n + 4) + bump(r, n + 5)
}

fn run(r: R) -> i64 vow {
    requires: r.end == 7,
    ensures: r.end == 7
} {
    mid(r, 1) + mid(r, 2) + mid(r, 3)
}

fn main() -> i32 { 0 }
