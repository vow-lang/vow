// `h.p` is the pushed `Pair` or not: what is read through `h` is the old value or the one written.
module VecPointerElemFieldParamStoredHeap

struct Pair { lo: i64, hi: i64 }
struct Holder { p: Pair, n: i64 }

fn bump(s: Pair, h: Holder) -> bool vow {
  ensures: result
} {
  let before: i64 = h.p.lo;
  let pairs: Vec<Pair> = Vec::new();
  pairs.push(s);
  pairs[0].lo = before + 1;
  h.p.lo == before || h.p.lo == before + 1
}

fn main() -> i32 [io] {
  let s: Pair = Pair { lo: 0, hi: 0 };
  let h: Holder = Holder { p: Pair { lo: 1, hi: 2 }, n: 3 };
  if bump(s, h) { print_i64(1); }
  0
}
