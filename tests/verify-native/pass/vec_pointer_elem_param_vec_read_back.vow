// A pointer stored into a `Vec` parameter: the elements it already held are memory the caller gave,
// the slot written is the object stored, and a read of either is a read through a handle (#1905).
module VecPointerElemParamVecReadBack

fn push_and_read(outer: Vec<Vec<i64>>, w: Vec<i64>, i: u64) -> u64 vow {
  requires: i < outer.len()
} {
  outer.push(w);
  let e: Vec<i64> = outer[i];
  e.len()
}

fn main() -> i32 [io] {
  let outer: Vec<Vec<i64>> = Vec::new();
  let w: Vec<i64> = Vec::new();
  outer.push(w);
  print_u64(push_and_read(outer, w, 0));
  0
}
