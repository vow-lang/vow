// A symbolic index over a `Vec` of two objects and a handle: slots 0 and 1 are the objects, so the
// length read is one of theirs whatever the index.
module VecPointerElemHandleStoredSymbolic

fn pick(src: Vec<Vec<i64>>, i: u64) -> u64 vow {
  requires: src.len() > 0 && i < 2
  ensures: result == 1 || result == 2
} {
  let dst: Vec<Vec<i64>> = Vec::new();
  let a: Vec<i64> = Vec::new();
  let b: Vec<i64> = Vec::new();
  a.push(1);
  b.push(1);
  b.push(2);
  dst.push(a);
  dst.push(b);
  dst.push(src[0]);
  let e: Vec<i64> = dst[i];
  e.len()
}

fn main() -> i32 [io] {
  let src: Vec<Vec<i64>> = Vec::new();
  let w: Vec<i64> = Vec::new();
  src.push(w);
  print_u64(pick(src, 1));
  0
}
