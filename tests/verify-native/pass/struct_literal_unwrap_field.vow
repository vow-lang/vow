// Native-only: ESBMC marks every `[panic]` function non-modelable, so this
// proof has no ESBMC counterpart.
module StructLiteralUnwrapField

struct P { a: i64, b: i64 }

fn with_unwrap(x: i64) -> P [panic] vow {
  ensures: result.a == x
  ensures: result.b == 0
} {
  let o: Option<i64> = Option::Some(x);
  P { a: o.unwrap(), b: 0 }
}

fn main() -> i32 [io, panic] {
  print_i64(with_unwrap(3).a);
  0
}
