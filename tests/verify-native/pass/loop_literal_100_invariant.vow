// TEST: category invariant
// A loop that really runs 100 times is deeper than the largest unrolling bound,
// so unwinding alone is `unknown`. Its invariant is inductive and gives the
// postcondition on exit, so the induction of ADR-2026-10-08-1422 proves it
// before any k-induction step case is tried.
module LoopLiteral100Invariant

fn hundred() -> u64 vow {
  ensures: result == 100
} {
  let mut i: u64 = 0;
  while i < 100 vow {
    invariant: i <= 100
  } {
    i = i + 1;
  }
  i
}

fn main() -> i32 [io] {
  0
}
