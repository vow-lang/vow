module FloatBitsHookDeterministic

// `parse_f64_bits` is a function of the contents of its string: equal strings,
// a clone, and a string built twice the same way parse to the same bits. Nothing
// is claimed about which bits.
fn parse_equal_strings(s: String, t: String) -> bool vow {
  requires: s.eq(t)
  ensures: result == true
} {
  parse_f64_bits(s) == parse_f64_bits(t)
}

fn parse_clone(s: String) -> bool vow {
  ensures: result == true
} {
  let c: String = String::from(s);
  parse_f64_bits(s) == parse_f64_bits(c)
}

fn parse_built_twice(a: String, b: String) -> bool vow {
  ensures: result == true
} {
  let x: String = String::from(a);
  x.push_str(b);
  let y: String = String::from(a);
  y.push_str(b);
  parse_f64_bits(x) == parse_f64_bits(y)
}

fn parse_literal_twice() -> bool vow {
  ensures: result == true
} {
  parse_f64_bits(String::from("1.5")) == parse_f64_bits(String::from("1.5"))
}

// `format_f64_bits` is a function of its bits: the same bits give equal strings,
// including through a clone of one of them.
fn format_equal_bits(a: u64, b: u64) -> bool vow {
  requires: a == b
  ensures: result == true
} {
  format_f64_bits(a).eq(format_f64_bits(b))
}

fn format_clone(a: u64) -> bool vow {
  ensures: result == true
} {
  format_f64_bits(a).eq(String::from(format_f64_bits(a)))
}

// The `u64` side is an exact 64-bit vector: it passes through the call unchanged,
// and nothing about the text is needed to read it back.
fn bits_survive_format(bits: u64) -> u64 vow {
  ensures: result == bits
} {
  let text: String = format_f64_bits(bits);
  bits
}

fn bits_survive_parse(bits: u64, s: String) -> u64 vow {
  ensures: result == bits + 1u64
} {
  let n: u64 = parse_f64_bits(s);
  bits + 1u64
}

fn main() -> i32 [io] {
  0
}
