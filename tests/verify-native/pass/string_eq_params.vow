module StringEqParams

fn eq_len(a: String, b: String) -> bool vow {
  ensures: !result || a.len() == b.len()
} {
  a.eq(b)
}

fn eq_first(a: String, b: String) -> bool vow {
  ensures: !(result && a.len() > 0) || a.byte_at(0) == b.byte_at(0)
} {
  a.eq(b)
}

fn eq_refl(a: String) -> bool vow {
  ensures: result
} {
  a.eq(a)
}

fn eq_clone(a: String) -> bool vow {
  ensures: result
} {
  let c: String = String::from(a);
  a.eq(c)
}

fn eq_symmetric(a: String, b: String) -> bool vow {
  ensures: result == b.eq(a)
} {
  a.eq(b)
}

fn eq_clear_changes_it(a: String) -> bool vow {
  requires: a.len() > 0
  ensures: !result
} {
  let c: String = String::from(a);
  c.clear();
  a.eq(c)
}

fn main() -> i32 [io] {
  print_i64(1);
  0
}
