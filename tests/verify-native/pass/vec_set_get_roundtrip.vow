module VecSetGetRoundtrip

fn store_and_read(i: u64, x: i64) -> i64 vow {
  ensures: result == x
} {
  let v: Vec<i64> = Vec::new();
  v.push(0);
  v.push(0);
  v.push(0);
  v[2] = x;
  v[2]
}

fn untouched_slot(x: i64) -> i64 vow {
  ensures: result == 5
} {
  let v: Vec<i64> = Vec::new();
  v.push(5);
  v.push(6);
  v[1] = x;
  v[0]
}

fn main() -> i32 [io] {
  print_i64(store_and_read(1, 9));
  0
}
