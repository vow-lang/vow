// An element of a `Vec<Person>` is never a `Config`, whatever slot they write: the parameter keeps its field.
module VecPointerElemFieldForeignOtherType

struct Person { age: i64 }
struct Config { limit: i64 }

fn bump(cfg: Config, people: Vec<Person>) -> bool vow {
  requires: people.len() == 1
  ensures: result
} {
  let before: i64 = cfg.limit;
  people[0].age = 5;
  cfg.limit == before
}

fn main() -> i32 [io] {
  let cfg: Config = Config { limit: 3 };
  let people: Vec<Person> = Vec::new();
  people.push(Person { age: 4 });
  if bump(cfg, people) { print_i64(1); }
  0
}
