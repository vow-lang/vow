module VecFillLoop

fn fill_vec() -> Vec<i64> vow {
  ensures: result.len() == 8
} {
  let v: Vec<i64> = Vec::new();
  let mut i: u64 = 0;
  while i < 8 vow {
    invariant: i <= 8
  } {
    v.push(i as i64);
    i = i + 1;
  }
  v
}

fn main() -> i32 [io] {
  let v: Vec<i64> = fill_vec();
  print_u64(v.len());
  0
}
