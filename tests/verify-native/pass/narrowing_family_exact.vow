// Every narrowing pair of docs/spec/grammar.md ("Type Cast", the `u8`, `i8`, `i16`,
// `u16`, `i32` and `u32` targets) against its documented semantics, stated on the
// source value: `_wrap` keeps the low bits (sign-extended for a signed destination),
// `_sat` clamps into the destination's range and `_try` is `Some` exactly when the
// operand is in range. One function per pair and kind; the contracts are the spec,
// not a copy of the model.
module NarrowingFamilyExact

fn wrap_i16_to_u8(x: i16) -> u8 vow {
  ensures: result as i128 == ((x as i128) & 255)
} {
  i16_to_u8_wrap(x)
}
fn sat_i16_to_u8(x: i16) -> u8 vow {
  ensures: (x < 0 && result as i128 == 0) || (x > 255 && result as i128 == 255) || (x >= 0 && x <= 255 && result as i128 == x as i128)
} {
  i16_to_u8_sat(x)
}
fn try_i16_to_u8(x: i16) -> bool vow {
  ensures: result
} {
  match i16_to_u8_try(x) {
    Option::Some(b) => { x >= 0 && x <= 255 && b as i128 == x as i128 },
    Option::None => { x < 0 || x > 255 },
  }
}
