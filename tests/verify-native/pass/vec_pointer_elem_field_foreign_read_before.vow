// A read before the write sees the old value, the read after it the new one.
module VecPointerElemFieldForeignReadBefore

struct Person { age: i64 }

fn bump(people: Vec<Person>) -> i64 vow {
  requires: people.len() == 1 && people[0].age == 4
  ensures: result == 4 * 10 + 5
} {
  let before: i64 = people[0].age;
  people[0].age = 5;
  before * 10 + people[0].age
}

fn main() -> i32 [io] {
  let people: Vec<Person> = Vec::new();
  people.push(Person { age: 4 });
  print_i64(bump(people));
  0
}
