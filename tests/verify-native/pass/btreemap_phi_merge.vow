// A BTreeMap the function picks by a branch, as `map_phi_merge.vow` does for a HashMap.
module BTreeMapPhiMerge

fn pick_len(c: i64) -> u64 vow {
  ensures: (c > 0 && result == 1) || (c <= 0 && result == 2)
} {
  let a: BTreeMap<i64, i64> = BTreeMap::new();
  let b: BTreeMap<i64, i64> = BTreeMap::new();
  a.insert(1, 1);
  b.insert(2, 2);
  b.insert(3, 3);
  let m: BTreeMap<i64, i64> = if c > 0 { a } else { b };
  m.len()
}

fn value_of_the_pick(c: bool) -> i64 [panic] vow {
  ensures: (c && result == 10) || (!c && result == 20)
} {
  let a: BTreeMap<i64, i64> = BTreeMap::new();
  let b: BTreeMap<i64, i64> = BTreeMap::new();
  a.insert(5, 10);
  b.insert(5, 20);
  let m: BTreeMap<i64, i64> = if c { a } else { b };
  m.get(5).unwrap()
}

fn untouched_one_keeps_its_state(c: bool) -> bool vow {
  ensures: result
} {
  let a: BTreeMap<i64, i64> = BTreeMap::new();
  let b: BTreeMap<i64, i64> = BTreeMap::new();
  a.insert(1, 1);
  b.insert(2, 2);
  let m: BTreeMap<i64, i64> = if c { a } else { b };
  m.insert(9, 9);
  if c { b.len() == 1 && b.contains(2) && !b.contains(9) } else { a.len() == 1 && a.contains(1) && !a.contains(9) }
}

fn overwrite_through(c: bool) -> i64 [panic] vow {
  ensures: result == 5
} {
  let a: BTreeMap<i64, i64> = BTreeMap::new();
  let b: BTreeMap<i64, i64> = BTreeMap::new();
  a.insert(1, 1);
  b.insert(1, 2);
  let m: BTreeMap<i64, i64> = if c { a } else { b };
  m.insert(1, 5);
  if c { a.get(1).unwrap() } else { b.get(1).unwrap() }
}

fn params(a: BTreeMap<i64, i64>, b: BTreeMap<i64, i64>, c: bool) -> u64 vow {
  ensures: (c && result == a.len()) || (!c && result == b.len())
} {
  let m: BTreeMap<i64, i64> = if c { a } else { b };
  m.len()
}

fn main() -> i32 [io] {
  print_u64(pick_len(1));
  0
}
