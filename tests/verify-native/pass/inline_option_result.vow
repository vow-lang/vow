// Native-only: ESBMC marks every `[panic]` function non-modelable.
module InlineOptionResult

fn first_positive(a: i64, b: i64) -> Option<i64> {
  if a > 0 {
    Option::Some(a)
  } else if b > 0 {
    Option::Some(b)
  } else {
    Option::None
  }
}

fn pick(a: i64, b: i64) -> i64 [panic] vow {
  requires: a > 0 || b > 0
  ensures: result > 0
} {
  first_positive(a, b).unwrap()
}

fn main() -> i32 [io, panic] {
  print_i64(pick(0, 3));
  0
}
