module ResultMatch

fn value_or_zero(r: Result<i64, i32>) -> i64 vow {
  ensures: match r { Result::Ok(v) => result == v, Result::Err(_) => result == 0 }
} {
  match r {
    Result::Ok(v) => v,
    Result::Err(_) => 0,
  }
}

fn main() -> i32 [io] {
  print_i64(value_or_zero(Result::Err(3)));
  0
}
