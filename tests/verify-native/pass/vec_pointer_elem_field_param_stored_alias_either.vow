// A second parameter of the same type is the stored one or not: its age is 5 or still 4.
module VecPointerElemFieldParamStoredAliasEither

struct Person { age: i64 }

fn f(s: Person, t: Person) -> i64 vow {
  requires: t.age == 4
  ensures: result == 4 || result == 5
} {
  let people: Vec<Person> = Vec::new();
  people.push(s);
  people[0].age = 5;
  t.age
}

fn main() -> i32 [io] {
  let p: Person = Person { age: 4 };
  print_i64(f(p, p));
  0
}
