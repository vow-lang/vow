// A `Vec` the function built holds an object it made and a handle it read out of the memory it was
// given. The slot of the object is read back as the object: its length is the pushes made to it.
module VecPointerElemHandleStoredMixed

fn mixed(src: Vec<Vec<i64>>) -> u64 vow {
  requires: src.len() > 0
  ensures: result == 3
} {
  let dst: Vec<Vec<i64>> = Vec::new();
  let w: Vec<i64> = Vec::new();
  dst.push(w);
  dst.push(src[0]);
  w.push(1);
  w.push(2);
  w.push(3);
  let e: Vec<i64> = dst[0];
  e.len()
}

fn main() -> i32 [io] {
  let src: Vec<Vec<i64>> = Vec::new();
  let w: Vec<i64> = Vec::new();
  src.push(w);
  print_u64(mixed(src));
  0
}
