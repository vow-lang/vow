module InlineResultFieldWriteParam

struct P { lo: i64, hi: i64 }

fn same(p: P) -> P {
  p
}

fn first(a: P, b: P, c: bool) -> P {
  if c { a } else { b }
}

fn through_identity(q: P) -> i64 vow {
  ensures: result == 7
} {
  let r: P = same(q);
  r.hi = 7;
  q.hi
}

fn through_pick(a: P, b: P, c: bool) -> i64 vow {
  ensures: result == 5
} {
  let r: P = first(a, b, c);
  r.lo = 5;
  if c { a.lo } else { b.lo }
}

fn main() -> i32 [io] {
  print_i64(through_identity(P { lo: 1, hi: 2 }));
  0
}
