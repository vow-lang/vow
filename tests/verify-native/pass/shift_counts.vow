module ShiftCounts

fn shl_u8(value: u8, count: u32) -> u8 vow {
  requires: count < 8
  ensures: result == value << count
} {
  value << count
}

fn shr_i32(value: i32, count: u32) -> i32 vow {
  requires: count < 32
  ensures: result == value >> count
} {
  value >> count
}

fn shr_negative(count: u32) -> i64 vow {
  requires: count < 64
  ensures: result < 0
} {
  let minus: i64 = 0 - 1;
  minus >> count
}

fn shr_u64(value: u64, count: u32) -> u64 vow {
  requires: count < 64
  ensures: result <= value
} {
  value >> count
}

fn main() -> i32 [io] {
  print_i64(shl_u8(1, 3) as i64);
  print_i64(shr_i32(8, 1) as i64);
  print_i64(shr_negative(2));
  print_u64(shr_u64(8u64, 1));
  0
}
