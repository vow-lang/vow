module InlineResultFieldWriteBranches

struct P { lo: i64, hi: i64 }

fn pick(c: bool, lo: i64) -> P {
  if c {
    P { lo: lo, hi: 1 }
  } else {
    P { lo: lo + 1, hi: 2 }
  }
}

fn bump(c: bool, lo: i64) -> i64 vow {
  requires: lo >= 0 && lo < 1000
  ensures: (c && result == lo + 10) || (!c && result == lo + 11)
} {
  let p: P = pick(c, lo);
  p.hi = 10;
  p.lo + p.hi
}

fn main() -> i32 [io] {
  print_i64(bump(true, 3));
  0
}
