module InlineStructArgMutate

// TEST: esbmc-model-artifact fn="twice" blame=Callee vow_id=1 "ESBMC does not carry the write of the uncontracted callee bump to its struct argument back to the caller (c.n stays 5 after two calls); the native model tracks the write"

struct Counter { n: i64 }

fn bump(c: Counter) {
  c.n = c.n + 1;
}

fn twice(c: Counter) -> i64 vow {
  requires: c.n == 5
  ensures: result == 7
} {
  bump(c);
  bump(c);
  c.n
}

fn main() -> i32 [io] {
  print_i64(twice(Counter { n: 5 }));
  0
}
