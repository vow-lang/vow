// TEST: category invariant
// A loop-invariant divisor is guarded once, not once per iteration copy.
module LoopRepeatedDivisionGuard

fn share(total: u64, parts: u64) -> u64 vow {
  requires: parts > 0,
  ensures: result * parts <= total
} {
  let mut q: u64 = 0;
  let mut i: u64 = 0;
  while i < 4 vow {
    invariant: i <= 4
  } {
    q = total / parts;
    i = i + 1;
  }
  q
}

fn main() -> i32 [io] {
  print_u64(share(10, 3));
  0
}
