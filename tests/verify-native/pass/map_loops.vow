module MapLoops

fn four_keys() -> HashMap<i64, i64> vow {
  ensures: result.len() == 4,
  ensures: result.contains_key(3)
} {
  let m: HashMap<i64, i64> = HashMap::new();
  let mut i: u64 = 0;
  while i < 4 {
    m.insert(i as i64, 0);
    i = i + 1;
  }
  m
}

fn fill_same_key(n: u64) -> HashMap<i64, i64> vow {
  requires: n > 0,
  ensures: result.contains_key(7),
  ensures: result.len() == 1
} {
  let m: HashMap<i64, i64> = HashMap::new();
  let mut i: u64 = 0;
  while i < n vow {
    invariant: i <= n,
    invariant: (i == 0 && m.len() == 0) || (m.contains_key(7) && m.len() == 1)
  } {
    m.insert(7, i as i64);
    i = i + 1;
  }
  m
}

fn insert_then_loop(m: HashMap<i64, i64>, n: u64) -> bool vow {
  ensures: result
} {
  m.insert(1, 2);
  let mut i: u64 = 0;
  while i < n vow {
    invariant: m.contains_key(1)
  } {
    i = i + 1;
  }
  m.contains_key(1)
}

fn main() -> i32 [io] {
  print_u64(four_keys().len() + fill_same_key(3).len());
  0
}
