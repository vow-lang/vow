// TEST: esbmc-model-artifact fn="attach" blame=Callee vow_id=0 "ESBMC places the struct parameter o at an arbitrary index of its flat heap, so o can overlap the struct i the function allocates and the store o.inner = i overwrites i.a; a caller never passes a parameter that overlaps an object the callee allocates, and the native model keeps a fresh object distinct from every parameter (the debug build runs attach without a violation)"
// A struct stored into a parameter's field is that struct: a write to it after the store is
// seen through the field.
module PtrFieldStructParamStoreReadBack

struct Inner { a: i64, b: i64 }
struct Outer { inner: Inner, c: i64 }

fn attach(o: Outer) -> bool vow {
  ensures: result
} {
  let i: Inner = Inner { a: 1, b: 2 };
  o.inner = i;
  i.a = 42;
  o.inner.a == 42 && o.inner.b == 2
}

fn main() -> i32 [io] {
  let o: Outer = Outer { inner: Inner { a: 0, b: 0 }, c: 3 };
  if attach(o) { print_i64(1); }
  0
}
