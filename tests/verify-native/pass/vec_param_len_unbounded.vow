// The property holds for every length. ESBMC proves a parameter's length only
// up to its model capacity (128); the native model has no capacity.
module VecParamLenUnbounded

fn grow(v: Vec<i64>) vow {
  ensures: v.len() > 0
} {
  v.push(1);
}

fn main() -> i32 [io] {
  let v: Vec<i64> = Vec::new();
  grow(v);
  print_u64(v.len());
  0
}
