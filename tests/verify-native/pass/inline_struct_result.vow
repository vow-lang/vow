module InlineStructResult

// TEST: esbmc-model-artifact fn="span" blame=Callee vow_id=0 "ESBMC leaves the struct returned by the uncontracted callee make unconstrained and unrelated to its arguments; the native model relates the result to its arguments"

struct P { lo: i64, hi: i64 }

fn make(lo: i64, hi: i64) -> P {
  P { lo: lo, hi: hi }
}

fn span(lo: i64, hi: i64) -> i64 vow {
  ensures: result == hi - lo
} {
  let p: P = make(lo, hi);
  p.hi - p.lo
}

fn main() -> i32 [io] {
  print_i64(span(1, 4));
  0
}
