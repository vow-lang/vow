// TEST: esbmc-model-artifact fn="f" blame=Callee vow_id=0 "ESBMC places the parameters s (Person) and t (Pet) at the same index of its flat heap, so the write t.age = 5 overwrites s.age; two parameters of different struct types are never one object at run time (the type checker cannot pass one value for both), and the debug build runs f without a violation"
// A struct parameter stored into a field, and a write through a parameter of another type: two
// parameters of different types are never one object, so the field read back keeps its age.
module PtrFieldStructParamOtherType

struct Person { age: i64 }
struct Pet { age: i64 }
struct Holder { p: Person }

fn f(s: Person, t: Pet) -> bool vow {
  ensures: result
} {
  let h: Holder = Holder { p: s };
  let before: Person = h.p;
  let a0: i64 = before.age;
  t.age = 5;
  let after: Person = h.p;
  after.age == a0
}

fn main() -> i32 [io] {
  let p: Person = Person { age: 1 };
  let q: Pet = Pet { age: 2 };
  if f(p, q) {
    print_i64(1);
  } else {
    print_i64(0);
  }
  0
}
