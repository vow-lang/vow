// A `Vec` that every iteration of the outer loop creates and the inner loop fills. The outer
// loop's cut leaves it alone (nothing carries it across the back edge) and the inner loop's cut
// havocs it, so both invariants are inductive and the claim holds for every `rows` and `cols`.
module LoopVecBornInOuterLoop

fn count_nonempty(rows: u64, cols: u64) -> u64 vow {
  ensures: result <= rows
} {
  let mut r: u64 = 0;
  let mut hits: u64 = 0;
  while r < rows vow {
    invariant: r <= rows,
    invariant: hits <= r
  } {
    let row: Vec<i64> = Vec::new();
    let mut c: u64 = 0;
    while c < cols vow {
      invariant: c <= cols,
      invariant: row.len() == c
    } {
      row.push(0);
      c = c + 1;
    }
    if row.len() > 0 {
      hits = hits + 1;
    }
    r = r + 1;
  }
  hits
}

fn main() -> i32 [io] {
  print_u64(count_nonempty(3, 2));
  0
}
