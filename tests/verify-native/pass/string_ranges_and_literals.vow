module StringRangesAndLiterals

// TEST: esbmc-model-artifact fn="substring_whole_is_equal" blame=Callee vow_id=0 "ESBMC models string_eq as a cached nondeterministic Bool, so it does not relate equal strings; the native model is exact"

// Substring clamping, prefix and suffix tests and literal matching, exactly as
// grammar.md specifies them, for strings of any length.
fn substring_reads_through(s: String) -> bool vow {
  requires: s.len() >= 3
  ensures: result == true
} {
  let t: String = s.substring(1, 3);
  t.len() == 2 && t.byte_at(0) == s.byte_at(1) && t.byte_at(1) == s.byte_at(2)
}

fn substring_clamps(s: String, a: u64, b: u64) -> bool vow {
  ensures: result == true
} {
  let t: String = s.substring(a, b);
  t.len() <= s.len()
}

fn substring_whole_is_equal(s: String) -> bool vow {
  ensures: result == true
} {
  s.substring(0, s.len()).eq(s)
}

fn substr_length(s: String, a: u64, n: u64) -> bool vow {
  requires: a <= s.len()
  requires: n <= s.len() - a
  ensures: result == true
} {
  string_substr(s, a, n).len() == n
}

fn prefix_gives_bytes(s: String, p: String, i: u64) -> bool vow {
  requires: string_starts_with(s, p) == 1
  requires: i < p.len()
  ensures: result == true
} {
  s.byte_at(i) == p.byte_at(i)
}

fn suffix_gives_bytes(s: String, p: String, i: u64) -> bool vow {
  requires: string_ends_with(s, p) == 1
  requires: i < p.len()
  ensures: result == true
} {
  s.byte_at(s.len() - p.len() + i) == p.byte_at(i)
}

fn longer_prefix_never_matches(s: String, p: String) -> bool vow {
  requires: p.len() > s.len()
  ensures: result == false
} {
  string_starts_with(s, p) == 1
}

fn matches_gives_bytes(s: String, pos: u64) -> bool vow {
  requires: string_matches_literal_at(s, pos, "ab") == 1
  ensures: result == true
} {
  pos + 1 < s.len() && s.byte_at(pos) == 97 && s.byte_at(pos + 1) == 98
}

fn matches_needs_room(s: String, pos: u64) -> bool vow {
  requires: s.len() < 2
  ensures: result == false
} {
  string_matches_literal_at(s, pos, "ab") == 1
}

fn literal_bytes() -> bool vow {
  ensures: result == true
} {
  let s: String = "hello";
  s.len() == 5 && s.byte_at(0) == 104 && s.byte_at(4) == 111
    && string_matches_literal_at(s, 1, "ell") == 1
    && string_matches_literal_at(s, 3, "llo") == 0
}

fn main() -> i32 {
  0
}
