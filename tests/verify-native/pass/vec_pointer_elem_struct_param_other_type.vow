// A struct parameter pushed into a `Vec`, and a write through a parameter of another type: two
// parameters of different types are never one object, so the element read back keeps its age.
module VecPointerElemStructParamOtherType

struct Person { age: i64 }
struct Pet { age: i64 }

fn f(s: Person, t: Pet) -> bool vow {
  ensures: result
} {
  let people: Vec<Person> = Vec::new();
  people.push(s);
  let before: Person = people[0];
  let a0: i64 = before.age;
  t.age = 5;
  let after: Person = people[0];
  after.age == a0
}

fn main() -> i32 [io] {
  let p: Person = Person { age: 1 };
  let q: Pet = Pet { age: 2 };
  if f(p, q) {
    print_i64(1);
  } else {
    print_i64(0);
  }
  0
}
