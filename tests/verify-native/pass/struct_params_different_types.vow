// Two struct parameters of different types are never one object, whatever else the
// function stores or writes (#1802): the stores into `o` and `i` cannot overwrite
// each other's slot 0, and `q` cannot be `p`.
module StructParamsDifferentTypes

struct Inner { a: i64 }
struct Outer { inner: Inner }
struct P { x: i64 }
struct Q { x: i64 }

fn nested_ok(o: Outer, i: Inner) -> bool vow {
  ensures: result
} {
  o.inner = i;
  i.a = 9;
  o.inner.a == 9
}

fn distinct_ok(p: P, q: Q) -> bool vow {
  ensures: result
} {
  p.x = 1;
  q.x = 2;
  p.x == 1 && q.x == 2
}

fn mixed(p: P, p2: P, q: Q) -> i64 vow {
  ensures: result == 1 || result == 2
} {
  p.x = 1;
  p2.x = 2;
  q.x = 3;
  p.x
}

fn main() -> i32 [io] {
  print_i64(if nested_ok(Outer { inner: Inner { a: 0 } }, Inner { a: 0 }) { 1 } else { 0 });
  print_i64(if distinct_ok(P { x: 0 }, Q { x: 0 }) { 1 } else { 0 });
  print_i64(mixed(P { x: 0 }, P { x: 0 }, Q { x: 0 }));
  0
}
