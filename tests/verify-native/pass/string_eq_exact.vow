module StringEqExact

// TEST: esbmc-model-artifact fn="eq_transitive" blame=Callee vow_id=2 "ESBMC models string_eq as a cached nondeterministic Bool, so it does not relate equal strings; the native model is exact"

// `string_eq` is exact: equal lengths and every byte equal. Each property below
// holds for strings of any length, with no capacity assumed.
fn eq_symmetric(a: String, b: String) -> bool vow {
  requires: a.eq(b)
  ensures: result == true
} {
  b.eq(a)
}

fn eq_transitive(a: String, b: String, c: String) -> bool vow {
  requires: a.eq(b)
  requires: b.eq(c)
  ensures: result == true
} {
  a.eq(c)
}

fn eq_implies_length(a: String, b: String) -> bool vow {
  requires: a.eq(b)
  ensures: result == true
} {
  a.len() == b.len()
}

fn eq_implies_each_byte(a: String, b: String, i: u64) -> bool vow {
  requires: a.eq(b)
  requires: i < a.len()
  ensures: result == true
} {
  a.byte_at(i) == b.byte_at(i)
}

fn bytes_and_length_imply_eq(a: String, b: String, i: u64) -> bool vow {
  requires: a.len() == b.len()
  requires: a.len() == 1
  requires: a.byte_at(0) == b.byte_at(0)
  ensures: result == true
} {
  a.eq(b)
}

fn different_length_not_eq(a: String, b: String) -> bool vow {
  requires: a.len() != b.len()
  ensures: result == false
} {
  a.eq(b)
}

fn eq_is_repeatable(a: String, b: String) -> bool vow {
  ensures: result == true
} {
  let first: bool = a.eq(b);
  let second: bool = a.eq(b);
  first == second
}

fn literals_differ() -> bool vow {
  ensures: result == false
} {
  let a: String = "hello";
  let b: String = "hellp";
  a.eq(b)
}

fn main() -> i32 {
  0
}
