// TEST: category invariant
// Two nested unbounded loops, each with an invariant: both are cut, and the
// inner loop's entry is checked from the outer loop's havoc'd state.
module LoopUnboundedNested

fn grid(n: i64, m: i64) -> i64 vow {
  requires: n >= 0
  requires: m >= 0
  ensures: result == n
} {
  let mut i: i64 = 0;
  while i < n vow {
    invariant: i >= 0,
    invariant: i <= n
  } {
    let mut j: i64 = 0;
    while j < m vow {
      invariant: j >= 0,
      invariant: j <= m
    } {
      j = j + 1;
    }
    i = i + 1;
  }
  i
}

fn main() -> i32 [io] {
  print_i64(grid(2, 3));
  0
}
