module InlineStructLiveAcrossCall

struct Pair { lo: i64, hi: i64 }

fn successor(x: i64) -> i64 vow {
  requires: x >= 0
  ensures: result == x + 1
} {
  x + 1
}

fn widen(x: i64) -> i64 vow {
  requires: x >= 0
  ensures: result == x + 1
} {
  let p: Pair = Pair { lo: x, hi: x + 1 };
  let next: i64 = successor(p.lo);
  next - p.hi + p.hi
}

fn main() -> i32 [io] {
  print_i64(widen(3));
  0
}
