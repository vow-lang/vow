// A struct pushed into a `Vec` whose `String` field is used as an object nowhere before the element
// is read back: the `String` is entered under the class it was built as, so its length is its own.
module VecPointerElemStructWithStringField

struct Person { name: String, age: i64 }

fn name_len() -> u64 vow {
  ensures: result == 2
} {
  let people: Vec<Person> = Vec::new();
  people.push(Person { name: String::from("al"), age: 3 });
  let p: Person = people[0];
  let n: String = p.name;
  n.len()
}

fn main() -> i32 [io] {
  print_u64(name_len());
  0
}
