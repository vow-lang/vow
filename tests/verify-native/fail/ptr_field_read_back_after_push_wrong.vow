// TEST: counterexample-fn "built_len"
// TEST: counterexample-vow-id 0
// TEST: counterexample-blame Callee
// The `push` after the store is visible through the field, so the length is not 1.
module PtrFieldReadBackAfterPushWrong

struct Pair { ids: Vec<i64>, n: i64 }

fn built_len() -> u64 vow {
  ensures: result == 1
} {
  let ids: Vec<i64> = Vec::new();
  ids.push(1);
  let p: Pair = Pair { ids: ids, n: 0 };
  ids.push(2);
  p.ids.len()
}

fn main() -> i32 [io] {
  print_u64(built_len());
  0
}
