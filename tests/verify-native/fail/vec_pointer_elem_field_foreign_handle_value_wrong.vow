// TEST: counterexample-fn "f"
// TEST: counterexample-vow-id 1
// TEST: counterexample-blame Callee
// TEST: counterexample-value q.0.contents <absent>
// TEST: counterexample-value people[0].0.contents <absent>
// The element now names the object `q.p` names, not the one it was built with.
// The heap arrays are keyed by slot, not by type, so a first model may put `q.p` (a `Pair`) at the address
// of `q` (a `Node`); the listing asks again with the two kept apart (`vc_typed`), so `q.p` lists its own
// contents and replay rebuilds it. Without that round `q.0.contents` is `unlisted` and replay skips.
module VecPointerElemFieldForeignHandleValueWrong

struct Pair { lo: i64 }
struct Node { p: Pair, n: i64 }

fn f(q: Node, people: Vec<Node>) -> i64 vow {
  requires: people.len() == 1
  ensures: result == 1
} {
  let x: Pair = q.p;
  people[0].p = x;
  people[0].p.lo
}

fn main() -> i32 [io] {
  let q: Node = Node { p: Pair { lo: 7 }, n: 1 };
  let people: Vec<Node> = Vec::new();
  people.push(Node { p: Pair { lo: 1 }, n: 0 });
  print_i64(f(q, people));
  0
}
