// TEST: counterexample-fn "second_byte"
// TEST: counterexample-vow-id 1
// TEST: counterexample-blame Callee
// TEST: counterexample-value n.0.len 1
// TEST: counterexample-value n.0[0].len 2
// TEST: counterexample-value n.0[0][1] 104
// The failing String has two bytes and the second is 104: the held Vec lists the String, the String lists its bytes.
module HeapVecOfStringsFieldElementBytesWrong

struct Names { items: Vec<String>, tag: i64 }

fn second_byte(n: Names) -> i64 vow {
  requires: n.items.len() == 1 && n.items[0].len() == 2u64
  ensures: result != 104
} {
  n.items[0].byte_at(1u64)
}

fn main() -> i32 [io] {
  let n: Names = Names { items: Vec::new(), tag: 0 };
  let s: String = String::from("hi");
  n.items.push(s);
  print_i64(second_byte(n));
  0
}
