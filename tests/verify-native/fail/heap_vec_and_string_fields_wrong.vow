// TEST: esbmc-model-artifact fn="pick" blame=None vow_id=4294967293 "ESBMC reads the Vec field r.items and the String field r.text as a fresh value of nondeterministic length at each use, so the requires on their lengths does not bound the reads of r.items[0] and r.text.byte_at(0) and it reports an out-of-bounds read instead of the ensures violation; the native model reads one field as one value. A debug-mode replay of the function over 1 to 300 elements aborts only on the ensures violation the native counterexample names, never with an out-of-bounds read, and a Z3 cross-check of the native queries agrees"
// A struct that holds a Vec and a String lists each under the path of its own slot.
module HeapVecAndStringFieldsWrong

struct Rec { items: Vec<i64>, text: String }

fn pick(r: Rec) -> i64 vow {
  requires: r.items.len() > 0 && r.text.len() > 0 && r.text.byte_at(0) == 0
  ensures: result != 4
} {
  r.items[0] + r.text.byte_at(0)
}

fn main() -> i32 [io] {
  let r: Rec = Rec { items: Vec::new(), text: String::from("a") };
  r.items.push(1);
  print_i64(pick(r));
  0
}
