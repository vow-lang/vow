// TEST: counterexample-fn "twice"
// TEST: counterexample-vow-id 0
// TEST: counterexample-blame Callee
// One object in two slots: the write through slot 0 shows through slot 1, so slot 1 is not still 4.
module VecPointerElemFieldAliasTwoSlotsWrong

struct Person { age: i64 }

fn twice() -> i64 vow {
  ensures: result == 4
} {
  let people: Vec<Person> = Vec::new();
  let a: Person = Person { age: 4 };
  people.push(a);
  people.push(a);
  people[0].age = 5;
  people[1].age
}

fn main() -> i32 [io] {
  print_i64(twice());
  0
}
