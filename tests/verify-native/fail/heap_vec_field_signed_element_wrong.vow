// TEST: esbmc-model-artifact fn="first" blame=None vow_id=4294967293 "ESBMC reads the Vec field b.items as a fresh value of nondeterministic length at each use, so the requires b.items.len() > 0 does not bound b.items[0] and it reports an out-of-bounds read instead of the ensures violation; the native model reads one field as one value. A debug-mode replay of the function over 1 to 300 elements aborts only on the ensures violation the native counterexample names, never with an out-of-bounds read, and a Z3 cross-check of the native queries agrees"
// A narrow signed element prints as the value the program reads, not as its raw 8-byte slot.
module HeapVecFieldSignedElementWrong

struct Bag { items: Vec<i32>, tag: i64 }

fn first(b: Bag) -> i32 vow {
  requires: b.items.len() > 0
  ensures: result != -7
} {
  b.items[0]
}

fn main() -> i32 [io] {
  let b: Bag = Bag { items: Vec::new(), tag: 1 };
  b.items.push(7);
  print_i64(first(b) as i64);
  0
}
