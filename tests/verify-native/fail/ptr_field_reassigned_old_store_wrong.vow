// TEST: counterexample-fn "fill"
// TEST: counterexample-vow-id 0
// TEST: counterexample-blame Callee
// The pushes after the assignment are not on the Vec the literal stored, which keeps its one
// element: a length of 3 is what a read resolved to the first store would give.
module PtrFieldReassignedOldStoreWrong

struct Block { id: i64, insts: Vec<i64> }

fn fill() -> bool vow {
  ensures: result
} {
  let first: Vec<i64> = Vec::new();
  let b: Block = Block { id: 7, insts: first };
  b.insts.push(1);
  b.insts = Vec::new();
  b.insts.push(2);
  b.insts.push(3);
  first.len() == 3
}

fn main() -> i32 [io] {
  if fill() { print_i64(1); }
  0
}
