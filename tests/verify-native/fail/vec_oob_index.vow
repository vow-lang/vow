module VecOobIndex

fn at(v: Vec<i64>, i: u64) -> i64 vow {
  ensures: result == result
} {
  v[i]
}

fn main() -> i32 [io] {
  let v: Vec<i64> = Vec::new();
  v.push(1);
  print_i64(at(v, 0));
  0
}
