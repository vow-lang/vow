// TEST: counterexample-fn "age_of"
// TEST: counterexample-vow-id 1
// TEST: counterexample-blame Callee
// TEST: counterexample-value t.0.len 1
// TEST: counterexample-value t.0[0].0 42
// TEST: replay-skipped the Person in a Vec<Person> held in a field lists its slots, and replay does not rebuild a held Vec of structs yet (#1890)
// The struct in the held Vec is read through its address: its slots are listed under the element.
module HeapVecOfStructsFieldElementSkipped

struct Person { age: i64, id: i64 }
struct Team { members: Vec<Person>, size: i64 }

fn age_of(t: Team) -> i64 vow {
  requires: t.members.len() == 1
  ensures: result != 42
} {
  t.members[0].age
}

fn main() -> i32 [io] {
  let t: Team = Team { members: Vec::new(), size: 0 };
  t.members.push(Person { age: 1, id: 2 });
  print_i64(age_of(t));
  0
}
