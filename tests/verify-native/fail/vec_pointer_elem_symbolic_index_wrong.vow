// TEST: counterexample-fn "pick"
// TEST: counterexample-vow-id 1
// TEST: counterexample-blame Callee
// A symbolic index reads whichever object is stored at that index, one of the two. The postcondition names a wrong answer.
module VecPointerElemSymbolicIndexWrong

fn pick(i: u64) -> u64 vow {
  requires: i < 2
  ensures: (i == 0 && result == 2) || (i == 1 && result == 1)
} {
  let outer: Vec<Vec<i64>> = Vec::new();
  let a: Vec<i64> = Vec::new();
  a.push(1);
  let b: Vec<i64> = Vec::new();
  b.push(1);
  b.push(2);
  outer.push(a);
  outer.push(b);
  let e: Vec<i64> = outer[i];
  e.len()
}

fn main() -> i32 [io] {
  print_u64(pick(1));
  0
}
