// TEST: replay-skipped parameter 0 is a Vec, which the replay harness cannot build
// TEST: counterexample-fn "arm_only"
// TEST: counterexample-vow-id 0
// TEST: counterexample-blame Callee
// The push happens in one arm only, so the length after the join can still be 0.
module VecParamArmPushWrong

fn arm_only(v: Vec<i64>, c: i64) -> u64 vow {
  ensures: result >= 1
} {
  if c > 0 {
    v.push(1);
  }
  v.len()
}

fn main() -> i32 [io] {
  let v: Vec<i64> = Vec::new();
  v.push(1);
  print_u64(arm_only(v, 1));
  0
}
