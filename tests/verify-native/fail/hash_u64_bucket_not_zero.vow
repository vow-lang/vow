// TEST: counterexample-fn "bucket"
// TEST: counterexample-vow-id 1
// TEST: counterexample-blame Callee
// `hash_u64` is modelled exactly, so a wrong claim about its result is refuted by
// a key the runtime really maps to a non-zero bucket (the replay runs the real
// mixer on it).
module HashU64BucketNotZero

fn bucket(key: u64, buckets: u64) -> u64 vow {
  requires: buckets > 1
  ensures: result == 0
} {
  hash_u64(key) % buckets
}

fn main() -> i32 [io] {
  print_u64(bucket(7u64, 16u64));
  0
}
