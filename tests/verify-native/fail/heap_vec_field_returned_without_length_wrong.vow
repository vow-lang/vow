// TEST: counterexample-fn "pass"
// TEST: counterexample-vow-id 0
// TEST: counterexample-blame Callee
// TEST: counterexample-value b.0.contents unconstrained
// The Vec in `b.items` is returned, never measured: the counterexample lists its address and says any contents will do.
module HeapVecFieldReturnedWithoutLengthWrong

struct Bag { items: Vec<i64>, tag: i64 }

fn pass(b: Bag) -> Vec<i64> vow {
  ensures: b.tag == 7
} {
  b.items
}

fn main() -> i32 [io] {
  let b: Bag = Bag { items: Vec::new(), tag: 7 };
  let r: Vec<i64> = pass(b);
  0
}
