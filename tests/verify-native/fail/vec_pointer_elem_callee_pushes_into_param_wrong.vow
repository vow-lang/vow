// TEST: counterexample-fn "caller"
// TEST: counterexample-vow-id 0
// TEST: counterexample-blame Callee
// The callee reads back the one-element `Vec` it pushed, so the result is 1, not 0.
module VecPointerElemCalleePushesIntoParamWrong

fn push_new_and_read(o: Vec<Vec<i64>>) -> u64 {
  let w: Vec<i64> = Vec::new();
  w.push(1);
  o.push(w);
  let e: Vec<i64> = o[0];
  e.len()
}

fn caller() -> u64 vow {
  ensures: result == 0
} {
  let o: Vec<Vec<i64>> = Vec::new();
  push_new_and_read(o)
}

fn main() -> i32 [io] {
  print_u64(caller());
  0
}
