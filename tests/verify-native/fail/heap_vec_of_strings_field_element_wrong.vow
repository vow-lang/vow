// TEST: counterexample-fn "firstlen"
// TEST: counterexample-vow-id 0
// TEST: counterexample-blame Callee
// TEST: counterexample-value n.0[0].contents unconstrained
// The counterexample needs one element, a String the function never reads: it lists its address and says any String will do.
module HeapVecOfStringsFieldElementWrong

struct Names { items: Vec<String>, tag: i64 }

fn firstlen(n: Names) -> u64 vow {
  ensures: result == 7
} {
  if n.items.len() > 0u64 { 1u64 } else { 7u64 }
}

fn main() -> i32 [io] {
  let n: Names = Names { items: Vec::new(), tag: 0 };
  print_u64(firstlen(n));
  0
}
