// TEST: counterexample-fn "bump"
// TEST: counterexample-vow-id 0
// TEST: counterexample-blame Callee
// TEST: counterexample-value h.0.0 0
// `h.p` may be the `Pair` that was pushed, and then the write through the element changes what is
// read through `h`: the claim that it does not is refuted. Replay builds `s` once and puts it in `h`.
module VecPointerElemFieldParamStoredHeapWrong

struct Pair { lo: i64, hi: i64 }
struct Holder { p: Pair, n: i64 }

fn bump(s: Pair, h: Holder) -> bool vow {
  ensures: result
} {
  let before: i64 = h.p.lo;
  let pairs: Vec<Pair> = Vec::new();
  pairs.push(s);
  pairs[0].lo = before + 1;
  h.p.lo == before
}

fn main() -> i32 [io] {
  let s: Pair = Pair { lo: 0, hi: 0 };
  let h: Holder = Holder { p: Pair { lo: 1, hi: 2 }, n: 3 };
  if bump(s, h) { print_i64(1); }
  0
}
