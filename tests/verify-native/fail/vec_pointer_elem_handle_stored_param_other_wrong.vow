// TEST: replay-skipped the elements of a `Vec<Person>` parameter are objects read through memory and their fields are not listed (`src[0].contents` is `unlisted`), so replay cannot rebuild them (#1890)
// TEST: counterexample-fn "rename"
// TEST: counterexample-vow-id 1
// TEST: counterexample-blame Callee
// TEST: counterexample-value src[0].contents unlisted
// The handle in the second slot is another `Person` than the parameter unless the caller passes the
// same one twice: the write through the parameter is not what that slot reads.
module VecPointerElemHandleStoredParamOtherWrong

struct Person { age: i64 }

fn rename(src: Vec<Person>, me: Person) -> i64 vow {
  requires: src.len() > 0
  ensures: result == 7
} {
  let dst: Vec<Person> = Vec::new();
  dst.push(me);
  dst.push(src[0]);
  me.age = 7;
  let e: Person = dst[1];
  e.age
}

fn main() -> i32 [io] {
  let src: Vec<Person> = Vec::new();
  src.push(Person { age: 1 });
  print_i64(rename(src, Person { age: 2 }));
  0
}
