// TEST: category float
// TEST: counterexample-fn "square"
// TEST: counterexample-vow-id 1
// TEST: counterexample-blame Callee
// A finite operand can square past the largest finite value: the result is an
// infinity and `result - result` is a NaN.
module FloatOverflowToInfinity

fn square(x: f64) -> f64 vow {
  requires: x - x == x - x,
  ensures: result - result == result - result
} {
  x * x
}
