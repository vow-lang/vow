// TEST: counterexample-fn "bump"
// TEST: counterexample-vow-id 3
// TEST: counterexample-blame Callee
// The invariant is inductive and true, but the postcondition is off by one: the
// exit state is the havoced field under the invariant and the negated loop test,
// which does not give `n + 1`, and unwinding finds the run that shows it.
module LoopFieldWriteWrongResult

struct Counter { v: u64 }

fn bump(c: Counter, n: u64) -> u64 vow {
  requires: c.v == 0
  ensures: result == n + 1
} {
  let mut i: u64 = 0;
  while i < n vow {
    invariant: i <= n
    invariant: c.v == i
  } {
    c.v = c.v + 1;
    i = i + 1;
  }
  c.v
}

fn main() -> i32 [io] {
  let c: Counter = Counter { v: 0 };
  print_u64(bump(c, 3));
  0
}
