// TEST: counterexample-fn "keep"
// TEST: counterexample-vow-id 0
// TEST: counterexample-blame Callee
// The element is the parameter itself: its age is the caller's.
// A struct parameter stored and read back is the parameter: its field is the caller's.
module VecPointerElemStructParamStoredWrong

struct Person { age: i64 }

fn keep(p: Person) -> i64 vow {
  ensures: result == p.age + 1
} {
  let people: Vec<Person> = Vec::new();
  people.push(p);
  let q: Person = people[0];
  q.age
}

fn main() -> i32 [io] {
  print_i64(keep(Person { age: 4 }));
  0
}
