// TEST: counterexample-fn "alias"
// TEST: counterexample-vow-id 0
// TEST: counterexample-blame Callee
module FieldSetAliasThroughMergeWrong

struct Cell { v: i64 }

fn alias(x: i64) -> i64 vow {
  ensures: result == 7
} {
  let a: Cell = Cell { v: 1 };
  let b: Cell = Cell { v: 2 };
  let p: Cell = if x > 0 { a } else { b };
  a.v = 7;
  p.v
}

fn main() -> i32 [io] {
  print_i64(alias(1));
  0
}
