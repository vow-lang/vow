// TEST: counterexample-fn "not_both"
// TEST: counterexample-vow-id 1
// TEST: counterexample-blame Callee
// TEST: counterexample-value m.len 2
// A parameter map is listed by the keys the function asks it about, each present or `absent`, and
// by its length.
module MapParamTwoKeysPresentWrong

fn not_both(m: HashMap<i64, i64>, a: i64, b: i64) -> bool vow {
  requires: a != b
  ensures: !result
} {
  m.contains_key(a) && m.contains_key(b)
}

fn main() -> i32 [io] {
  let m: HashMap<i64, i64> = HashMap::new();
  if not_both(m, 1, 2) { print_u64(1); }
  0
}
