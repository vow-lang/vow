// TEST: replay-skipped the String in a Vec<String> held in a field is read and its length is listed, but replay does not rebuild a Vec of collections yet (#1890)
// TEST: counterexample-fn "firstlen"
// TEST: counterexample-vow-id 0
// TEST: counterexample-blame Callee
// TEST: counterexample-value n.0[0].len 0
// The counterexample needs one element and the function reads its length, so the element is an address that lists the contents the function read: the shortest String it fails for.
module HeapVecOfStringsFieldElementReadSkipped

struct Names { items: Vec<String>, tag: i64 }

fn firstlen(n: Names) -> u64 vow {
  ensures: result == 7
} {
  if n.items.len() > 0u64 { n.items[0].len() } else { 7u64 }
}

fn main() -> i32 [io] {
  let n: Names = Names { items: Vec::new(), tag: 0 };
  print_u64(firstlen(n));
  0
}
