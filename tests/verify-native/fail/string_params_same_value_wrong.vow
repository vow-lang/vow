// TEST: esbmc-model-artifact fn="grow" blame=None vow_id=4294967293 "ESBMC fails its own String capacity assertion on the push_str to q for a q of the 256-byte model limit, before anything about p or the ensures; the runtime has no such limit and ESBMC models p and q as distinct strings, so it cannot see the aliasing failure native reports. A debug-mode replay with distinct p and q, q of 0 to 300 bytes, returns 1 without an abort, and the aliased call aborts on the ensures violation the native counterexample names; a Z3 cross-check of the native queries agrees"
// The same for two `String` parameters: `main` passes one value for both, so the append to `q`
// changes the length `p.len()` reads.
module StringParamsSameValueWrong

fn grow(p: String, q: String) -> u64 vow {
    requires: p.len() == 1
    ensures: result == 1
} {
    q.push_str(String::from("zz"));
    p.len()
}

fn main() -> i32 [io] {
    let a: String = String::from("a");
    print_u64(grow(a, a));
    0
}
