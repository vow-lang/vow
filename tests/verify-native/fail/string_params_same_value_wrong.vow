// TEST: counterexample-fn "grow"
// TEST: counterexample-vow-id 1
// TEST: counterexample-blame Callee
// The same for two `String` parameters: `main` passes one value for both, so the append to `q`
// changes the length `p.len()` reads.
module StringParamsSameValueWrong

fn grow(p: String, q: String) -> u64 vow {
    requires: p.len() == 1
    ensures: result == 1
} {
    q.push_str(String::from("zz"));
    p.len()
}

fn main() -> i32 [io] {
    let a: String = String::from("a");
    print_u64(grow(a, a));
    0
}
