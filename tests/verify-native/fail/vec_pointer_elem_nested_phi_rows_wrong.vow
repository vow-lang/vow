// TEST: counterexample-fn "pick"
// TEST: counterexample-vow-id 0
// TEST: counterexample-blame Callee
// The write reaches the row that is picked: for `c` false it is the second row, so `a` keeps its age.
module VecPointerElemNestedPhiRowsWrong

struct Person { age: i64 }

fn pick(c: bool) -> i64 vow {
  ensures: result == 704
} {
  let grid: Vec<Vec<Person>> = Vec::new();
  let r0: Vec<Person> = Vec::new();
  let r1: Vec<Person> = Vec::new();
  let a: Person = Person { age: 4 };
  let b: Person = Person { age: 4 };
  r0.push(a);
  r1.push(b);
  grid.push(r0);
  grid.push(r1);
  let row: Vec<Person> = if c { grid[0] } else { grid[1] };
  row[0].age = 7;
  a.age * 100 + b.age
}

fn main() -> i32 [io] {
  print_i64(pick(true));
  0
}
