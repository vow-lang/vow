// TEST: counterexample-fn "fill"
// TEST: counterexample-vow-id 0
// TEST: counterexample-blame Callee
// The loop writes cells 0 to 2 and cell 3 keeps its value, so the claim about it is false.
module VecPointerElemFieldLoopWrong

struct Cell { v: i64 }

fn fill() -> i64 vow {
  ensures: result == 7
} {
  let cells: Vec<Cell> = Vec::new();
  let mut i: u64 = 0;
  while i < 4 {
    cells.push(Cell { v: 0 });
    i = i + 1;
  }
  let mut j: u64 = 0;
  while j < 3 {
    cells[j].v = 7;
    j = j + 1;
  }
  cells[3].v
}

fn main() -> i32 [io] {
  print_i64(fill());
  0
}
