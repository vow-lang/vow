// TEST: counterexample-fn "arm_len"
// TEST: counterexample-vow-id 0
// TEST: counterexample-blame Callee
// Without the arm the field is still the literal's Vec, which holds the earlier push: the length
// is 2 there. A read resolved to the arm's store alone would prove 1 for every `c`.
module PtrFieldBranchArmStoreArmOnlyWrong

struct Block { id: i64, insts: Vec<i64> }

fn arm_len(c: bool) -> u64 vow {
  ensures: result == 1
} {
  let b: Block = Block { id: 7, insts: Vec::new() };
  b.insts.push(10);
  if c { b.insts = Vec::new(); }
  b.insts.push(20);
  b.insts.len()
}

fn main() -> i32 [io] {
  print_u64(arm_len(true));
  0
}
