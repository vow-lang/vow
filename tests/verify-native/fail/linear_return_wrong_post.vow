// A linear value the replayed function returns is discharged by the harness with `drop`.
module LinearReturnWrongPost

linear struct Handle {
    fd: i64,
}

fn make(fd: i64) -> Handle vow {
    ensures: result.fd == fd + 1
} {
    Handle { fd: fd }
}

fn main() -> i32 {
    0
}
