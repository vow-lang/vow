// TEST: counterexample-fn fill_one_key
// TEST: counterexample-vow-id 2
// TEST: counterexample-blame Callee
// The invariant `m.len() == 0` does not survive the first insert.
module MapLoopInvariantViolated

fn fill_one_key(n: u64) -> HashMap<i64, i64> vow {
  requires: n > 0,
  ensures: result.len() == 1
} {
  let m: HashMap<i64, i64> = HashMap::new();
  let mut i: u64 = 0;
  while i < n vow {
    invariant: i <= n,
    invariant: m.len() == 0
  } {
    m.insert(7, 1);
    i = i + 1;
  }
  m
}

fn main() -> i32 [io] {
  print_u64(fill_one_key(2).len());
  0
}
