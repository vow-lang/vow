// TEST: counterexample-fn "f"
// TEST: counterexample-vow-id 0
// TEST: counterexample-blame Callee
// A `Vec` parameter pushed into a `Vec` is the object the caller passed, which another `Vec`
// parameter may be too (#1905): a push through `b` shows in the element read back, so `q.len()` need
// not be the length `a` had.
module VecPointerElemCollectionParamStoredWrong

fn f(a: Vec<i64>, b: Vec<i64>) -> bool vow {
  ensures: result
} {
  let outer: Vec<Vec<i64>> = Vec::new();
  outer.push(a);
  let before: u64 = a.len();
  b.push(1);
  let q: Vec<i64> = outer[0];
  q.len() == before
}

fn main() -> i32 [io] {
  let a: Vec<i64> = Vec::new();
  let b: Vec<i64> = Vec::new();
  if f(a, b) {
    print_i64(1);
  } else {
    print_i64(0);
  }
  0
}
