// TEST: category invariant
// TEST: counterexample-fn first_above_three
// TEST: counterexample-blame Callee
module LoopBreakValueWrong

fn first_above_three() -> u64 vow {
  ensures: result == 5
} {
  let mut s: u64 = 0;
  let r: u64 = loop {
    s = s + 1;
    if s > 3 {
      break s;
    }
  };
  r
}

fn main() -> i32 [io] {
  0
}
