// TEST: counterexample-fn "f"
// TEST: counterexample-vow-id 1
// TEST: counterexample-blame Callee
// A `String` parameter stored with `set` is the object the caller passed, which another `String`
// parameter may be too (#1905): `push_str` through `b` shows in the element read back, which is 3
// bytes long, not 1.
module VecPointerElemStringParamSetWrong

fn f(a: String, b: String) -> u64 vow {
  requires: a.len() == 1 && b.len() == 1
  ensures: result == 1
} {
  let names: Vec<String> = Vec::new();
  names.push(String::from("x"));
  names[0] = a;
  b.push_str(String::from("zz"));
  let n: String = names[0];
  n.len()
}

fn main() -> i32 [io] {
  let a: String = String::from("a");
  let b: String = String::from("b");
  print_u64(f(a, b));
  0
}
