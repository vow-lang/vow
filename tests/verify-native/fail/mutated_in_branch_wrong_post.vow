// TEST: counterexample-fn "bump"
// TEST: counterexample-vow-id 2
// TEST: counterexample-blame callee
// TEST: counterexample-violation "ensures result == x + 1"
module MutatedInBranchWrongPost

fn bump(x: i64) -> i64 vow {
  requires: x >= 0
  requires: x <= 1000
  ensures: result == x + 1
} {
  let mut acc: i64 = x;
  if x > 10 {
    acc = acc + 1;
  }
  acc
}
