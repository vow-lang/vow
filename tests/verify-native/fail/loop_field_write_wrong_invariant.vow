// TEST: counterexample-fn "bump"
// TEST: counterexample-vow-id 2
// TEST: counterexample-blame Callee
// The loop writes a field of its parameter and its invariant says the field never
// changes. The cut makes the field unconstrained at the header, so only unwinding
// refutes it: the invariant fails on the first iteration that writes the field.
module LoopFieldWriteWrongInvariant

struct Counter { v: u64 }

fn bump(c: Counter, n: u64) -> u64 vow {
  requires: c.v == 0
  ensures: result == n
} {
  let mut i: u64 = 0;
  while i < n vow {
    invariant: i <= n
    invariant: c.v == 0
  } {
    c.v = c.v + 1;
    i = i + 1;
  }
  c.v
}

fn main() -> i32 [io] {
  let c: Counter = Counter { v: 0 };
  print_u64(bump(c, 3));
  0
}
