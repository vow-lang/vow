// TEST: counterexample-fn "tally"
// TEST: counterexample-vow-id 2
// TEST: counterexample-blame Callee
// The loop writes the returned struct three times (the invariant is not used: a field write is decided by unwinding), so `base + 2` is refuted.
module InlineResultFieldWriteLoopWrong

struct Acc { sum: i64, n: i64 }

fn make(base: i64) -> Acc {
  Acc { sum: base, n: 0 }
}

fn tally(base: i64) -> i64 vow {
  requires: base < 9223372036854775800
  ensures: result == base + 2
} {
  let a: Acc = make(base);
  let mut i: i64 = 0;
  while i < 3 vow {
    invariant: i >= 0 && i <= 3
  } {
    a.sum = a.sum + 1;
    i = i + 1;
  }
  a.sum
}

fn main() -> i32 [io] {
  print_i64(tally(4));
  0
}
