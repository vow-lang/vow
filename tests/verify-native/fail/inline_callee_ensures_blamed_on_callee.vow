// TEST: counterexample-fn "bump"
// TEST: counterexample-vow-id 1
// TEST: counterexample-blame Callee
// TEST: replay-skipped the counterexample belongs to a co-emitted callee, whose inputs are the caller's
module InlineCalleeEnsuresBlamedOnCallee

fn caller(y: i64) -> i64 vow {
  requires: y > 0 && y < 1000
  ensures: result > y
} {
  bump(y)
}

fn bump(x: i64) -> i64 vow {
  requires: x > 0 && x < 1000
  ensures: result == x + 2
} {
  x + 1
}

fn main() -> i32 [io] {
  print_i64(caller(4));
  0
}
