// TEST: counterexample-fn "pick"
// TEST: counterexample-vow-id 0
// TEST: counterexample-blame callee
// TEST: counterexample-violation "ensures result > 0"
module BranchWrongPost

fn pick(x: i64) -> i64 vow {
  ensures: result > 0
} {
  if x > 0 {
    x
  } else {
    0
  }
}

fn main() -> i32 [io] {
  print_i64(pick(3));
  0
}
