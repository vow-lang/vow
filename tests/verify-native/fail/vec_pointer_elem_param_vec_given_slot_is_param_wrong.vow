// TEST: counterexample-fn "f"
// TEST: counterexample-vow-id 1
// TEST: counterexample-blame Callee
// An element a `Vec` parameter held before may be another parameter: the caller can pass `w` inside
// `outer`, so a push to `w` shows in the element read back (#1905).
module VecPointerElemParamVecGivenSlotIsParamWrong

fn f(outer: Vec<Vec<i64>>, w: Vec<i64>, i: u64) -> bool vow {
  requires: i < outer.len()
  ensures: result
} {
  outer.push(w);
  let g: Vec<i64> = outer[i];
  let before: u64 = g.len();
  w.push(1);
  let h: Vec<i64> = outer[i];
  h.len() == before
}

fn main() -> i32 [io] {
  let outer: Vec<Vec<i64>> = Vec::new();
  let w: Vec<i64> = Vec::new();
  outer.push(w);
  if f(outer, w, 0) {
    print_i64(1);
  } else {
    print_i64(0);
  }
  0
}
