// TEST: counterexample-fn "f"
// TEST: counterexample-vow-id 1
// TEST: counterexample-blame Callee
// A `Vec<Vec<i64>>` parameter with a listed length above 0 keeps replaying as before: its element
// is an `unconstrained` address, which the held-memory path rebuilds.
module VecVecParamListedReplayWrong

fn f(outer: Vec<Vec<i64>>) -> bool vow {
  requires: outer.len() > 0
  ensures: result
} {
  outer.len() > 1
}

fn main() -> i32 [io] {
  let outer: Vec<Vec<i64>> = Vec::new();
  let w: Vec<i64> = Vec::new();
  outer.push(w);
  if f(outer) {
    print_i64(1);
  } else {
    print_i64(0);
  }
  0
}
