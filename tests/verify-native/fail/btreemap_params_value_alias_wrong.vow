// TEST: counterexample-fn "overwrite"
// TEST: counterexample-vow-id 1
// TEST: counterexample-blame Callee
// The value stored through `q` replaces the one `p` holds when they are one object.
module BTreeMapParamsValueAliasWrong

fn overwrite(p: BTreeMap<i64, i64>, q: BTreeMap<i64, i64>, k: i64) -> i64 [panic] vow {
  requires: p.contains(k),
  ensures: result == 1
} {
  p.insert(k, 1);
  q.insert(k, 2);
  p.get(k).unwrap()
}

fn main() -> i32 [io, panic] {
  let a: BTreeMap<i64, i64> = BTreeMap::new();
  a.insert(4, 0);
  print_i64(overwrite(a, a, 4));
  0
}
