// TEST: counterexample-fn "f"
// TEST: counterexample-vow-id 0
// TEST: counterexample-blame Callee
// A struct parameter stored into a field is the object the caller passed, which another parameter of
// the same type may be too: a write through `t` shows in the field read back, so the age read before
// the write need not equal the one read after it. The stored parameter is used as an object nowhere
// else, so the class it is entered under comes from its declared type.
module PtrFieldStructParamAliasWrong

struct Person { age: i64 }
struct Holder { p: Person }

fn f(s: Person, t: Person) -> bool vow {
  ensures: result
} {
  let h: Holder = Holder { p: s };
  let before: Person = h.p;
  let a0: i64 = before.age;
  t.age = 5;
  let after: Person = h.p;
  after.age == a0
}

fn main() -> i32 [io] {
  let p: Person = Person { age: 1 };
  let q: Person = Person { age: 2 };
  if f(p, q) {
    print_i64(1);
  } else {
    print_i64(0);
  }
  0
}
