// TEST: counterexample-fn "replaced"
// TEST: counterexample-vow-id 0
// TEST: counterexample-blame Callee
// The slot holds the replacement, not the old `Vec` the function pushed to afterwards.
module VecPointerElemOverwrittenWrong

fn replaced() -> u64 vow {
  ensures: result == 1
} {
  let outer: Vec<Vec<i64>> = Vec::new();
  let old: Vec<i64> = Vec::new();
  outer.push(old);
  let fresh: Vec<i64> = Vec::new();
  fresh.push(1);
  fresh.push(2);
  fresh.push(3);
  outer[0] = fresh;
  old.push(9);
  let now: Vec<i64> = outer[0];
  now.len()
}

fn main() -> i32 [io] {
  print_u64(replaced());
  0
}
