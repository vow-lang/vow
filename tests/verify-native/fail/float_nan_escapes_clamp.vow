// TEST: category float
// TEST: counterexample-fn "clamp_unit"
// TEST: counterexample-vow-id 2
// TEST: counterexample-blame Callee
// TEST: counterexample-value x NaN
// Neither `x < 0.0` nor `x > 1.0` holds for a NaN, so the NaN falls through to
// the result and `result >= 0.0` is false.
module FloatNanEscapesClamp

fn clamp_unit(x: f64) -> f64 vow {
  ensures: result >= 0.0
} {
  if x < 0.0 {
    return 0.0;
  }
  if x > 1.0 {
    return 1.0;
  }
  x
}
