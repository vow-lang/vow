// TEST: counterexample-fn "arm_len"
// TEST: counterexample-vow-id 0
// TEST: counterexample-blame Callee
// The arm replaces the literal's Vec when `c` holds, so the length is 1 there: a read resolved to
// the literal's store alone would prove 2 for every `c`.
module PtrFieldBranchArmStoreLiteralOnlyWrong

struct Block { id: i64, insts: Vec<i64> }

fn arm_len(c: bool) -> u64 vow {
  ensures: result == 2
} {
  let b: Block = Block { id: 7, insts: Vec::new() };
  b.insts.push(10);
  if c { b.insts = Vec::new(); }
  b.insts.push(20);
  b.insts.len()
}

fn main() -> i32 [io] {
  print_u64(arm_len(true));
  0
}
