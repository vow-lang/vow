// TEST: counterexample-fn "choose"
// TEST: counterexample-vow-id 0
// TEST: counterexample-blame Callee
// The merge of the two reads names the object of the chosen slot: slot 0 is the shorter `Vec`.
// Two element reads merged by an `if` are a merge of handles: it names whichever object the
// chosen slot holds.
module VecPointerElemHandlePhiWrong

fn choose(c: bool) -> u64 vow {
  ensures: (c && result == 2) || (!c && result == 1)
} {
  let outer: Vec<Vec<i64>> = Vec::new();
  let a: Vec<i64> = Vec::new();
  a.push(1);
  let b: Vec<i64> = Vec::new();
  b.push(1);
  b.push(2);
  outer.push(a);
  outer.push(b);
  let x: Vec<i64> = if c { outer[0] } else { outer[1] };
  x.len()
}

fn main() -> i32 [io] {
  print_u64(choose(true));
  print_u64(choose(false));
  0
}
