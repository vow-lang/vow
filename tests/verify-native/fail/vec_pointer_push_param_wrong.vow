// TEST: counterexample-fn "append"
// TEST: counterexample-vow-id 0
// TEST: counterexample-blame Callee
module VecPointerPushParamWrong

fn append(v: Vec<String>, s: String) -> u64 vow {
  ensures: result == v.len() + 1
} {
  v.push(s);
  v.len()
}

fn main() -> i32 [io] {
  let v: Vec<String> = Vec::new();
  print_u64(append(v, String::from("a")));
  0
}
