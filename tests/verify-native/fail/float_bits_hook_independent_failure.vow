// TEST: counterexample-fn "off_by_one"
// TEST: counterexample-vow-id 0
// TEST: counterexample-blame Callee
// TEST: counterexample-violation "ensures result == parse_f64_bits(String::from(\"1.5\")) + 1u64"
// The claim contradicts itself for every result of `parse_f64_bits`, so the
// counterexample does not depend on the model's choice for it and is reported.
module FloatBitsHookIndependentFailure

fn off_by_one() -> u64 vow {
  ensures: result == parse_f64_bits(String::from("1.5")) + 1u64
} {
  parse_f64_bits(String::from("1.5"))
}

fn main() -> i32 [io] {
  0
}
