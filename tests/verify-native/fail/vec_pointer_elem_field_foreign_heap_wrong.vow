// TEST: counterexample-fn "f"
// TEST: counterexample-vow-id 1
// TEST: counterexample-blame Callee
// TEST: counterexample-value people[0].0 -2
// The `Pair` that `q.p` holds may be the element written through: what is read through `q` changes.
module VecPointerElemFieldForeignHeapWrong

struct Pair { lo: i64, hi: i64 }
struct Holder { p: Pair, n: i64 }

fn f(q: Holder, people: Vec<Pair>) -> bool vow {
  requires: people.len() == 1
  ensures: result
} {
  let before: i64 = q.p.lo;
  people[0].lo = before + 1;
  q.p.lo == before
}

fn main() -> i32 [io] {
  let pr: Pair = Pair { lo: 1, hi: 2 };
  let q: Holder = Holder { p: pr, n: 3 };
  let people: Vec<Pair> = Vec::new();
  people.push(pr);
  if f(q, people) { print_i64(1); }
  0
}
