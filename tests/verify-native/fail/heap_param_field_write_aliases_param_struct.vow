// TEST: counterexample-fn "bump"
// TEST: counterexample-vow-id 0
// TEST: counterexample-blame Callee
// `q` may be the `Pair` that `h.p` holds, and then writing `q.lo` changes what is read through
// `h`: the claim that it does not is refuted. Replay builds `q` once and puts it in `h`.
module HeapParamFieldWriteAliasesParamStruct

struct Pair { lo: i64, hi: i64 }
struct Holder { p: Pair, n: i64 }

fn bump(q: Pair, h: Holder) -> bool vow {
  ensures: result
} {
  let before: i64 = h.p.lo;
  q.lo = before + 1;
  h.p.lo == before
}

fn main() -> i32 [io] {
  let q: Pair = Pair { lo: 0, hi: 0 };
  let h: Holder = Holder { p: Pair { lo: 1, hi: 2 }, n: 3 };
  if bump(q, h) { print_i64(1); }
  0
}
