// TEST: counterexample-value l.0[0] 97
// TEST: esbmc-model-artifact fn="first_byte" blame=None vow_id=4294967293 "ESBMC reads the String field l.text as a fresh value of nondeterministic length at each use, so the requires l.text.len() > 0 does not bound the byte_at(0) read and it reports an out-of-bounds read instead of the ensures violation; the native model reads one field as one value. A debug-mode replay of the function over 1 to 300 elements aborts only on the ensures violation the native counterexample names, never with an out-of-bounds read, and a Z3 cross-check of the native queries agrees"
// The first byte of the String in `l.text` is whatever it is, so it can be 97.
module HeapStringFieldByteWrong

struct Label { text: String, n: i64 }

fn first_byte(l: Label) -> i64 vow {
  requires: l.text.len() > 0
  ensures: result != 97
} {
  l.text.byte_at(0)
}

fn main() -> i32 [io] {
  let l: Label = Label { text: String::from("a"), n: 1 };
  print_i64(first_byte(l));
  0
}
