// TEST: replay-skipped field 0 is a Vec, which the replay harness cannot build
// TEST: counterexample-fn "overwrite"
// TEST: counterexample-vow-id 1
// TEST: counterexample-blame Callee
// A parameter `Vec<i128>` may be the very collection a struct parameter holds in its field, so a
// write to it changes what the field reads: the handle read lays the parameter's state over the
// heap array, at both limbs of the element.
module WideVecInStructFieldAliasedWrite

struct Bag { items: Vec<i128> }

fn overwrite(b: Bag, v: Vec<i128>, x: i128) -> bool vow {
  requires: b.items.len() > 0 && v.len() > 0,
  ensures: result
} {
  let before: i128 = b.items[0];
  v[0] = x;
  b.items[0] == before
}

fn main() -> i32 [io] {
  let b: Bag = Bag { items: Vec::new() };
  let v: Vec<i128> = Vec::new();
  b.items.push(1);
  v.push(2);
  print_i64(if overwrite(b, v, 3) { 1 } else { 0 });
  0
}
