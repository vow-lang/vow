// TEST: category invariant
// TEST: counterexample-fn "extend"
// TEST: counterexample-vow-id 2
// TEST: counterexample-blame Callee
// TEST: replay-skipped Vec<i64> parameter is not rebuilt by the replay harness (#1649)
module VecLoopParamPushWrongPost

fn extend(v: Vec<i64>, n: u64) vow {
  requires: v.len() == 0,
  ensures: v.len() == n + 1
} {
  let mut i: u64 = 0;
  while i < n vow {
    invariant: i <= n && v.len() == i
  } {
    v.push(1);
    i = i + 1;
  }
}

fn main() -> i32 [io] {
  let v: Vec<i64> = Vec::new();
  extend(v, 3);
  print_u64(v.len());
  0
}
