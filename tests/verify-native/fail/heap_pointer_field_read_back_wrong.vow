// TEST: counterexample-fn "built_len"
// TEST: counterexample-vow-id 0
// TEST: counterexample-blame Callee
// The Vec stored in `ids` has one element, so a length of 2 is refuted.
module HeapPointerFieldReadBackWrong

struct Pair { ids: Vec<i64>, n: i64 }

fn built_len() -> u64 vow {
  ensures: result == 2
} {
  let ids: Vec<i64> = Vec::new();
  ids.push(1);
  let p: Pair = Pair { ids: ids, n: 0 };
  p.ids.len()
}

fn main() -> i32 [io] {
  print_u64(built_len());
  0
}
