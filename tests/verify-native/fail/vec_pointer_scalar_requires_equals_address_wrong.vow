// TEST: counterexample-fn "k"
// TEST: counterexample-vow-id 1
// TEST: counterexample-blame Callee
// TEST: counterexample-value c.0 4096
// A `requires` that fixes a scalar field at 4096 must not make every `ensures` vacuously true
// because 4096 would be the address of an object the function allocated (#1825).
module VecPointerScalarRequiresEqualsAddressWrong

struct Cfg {
  page: i64,
}

struct Box {
  v: Vec<i64>,
}

fn k(c: Cfg) -> i64 vow {
  requires: c.page == 4096
  ensures: result == 7
} {
  let a: Vec<i64> = Vec::new();
  let b: Box = Box { v: a };
  c.page
}

fn main() -> i32 [io] {
  let c: Cfg = Cfg { page: 4096 };
  print_i64(k(c));
  0
}
