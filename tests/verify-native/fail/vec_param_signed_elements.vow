// TEST: counterexample-fn "head"
// TEST: counterexample-vow-id 1
// TEST: counterexample-blame Callee
// TEST: counterexample-value v.len 2
// TEST: counterexample-value v[0] -7
// TEST: counterexample-value v[1] 9223372036854775807
// A signed element is listed in its own type: the slot of -7 is
// 18446744073709551609 as an unsigned 64-bit value.
module VecParamSignedElements

fn head(v: Vec<i64>) -> i64 vow {
  requires: v.len() == 2 && v[0] == -7 && v[1] == 9223372036854775807
  ensures: result > 0
} {
  v[0]
}

fn main() -> i32 [io] {
  let v: Vec<i64> = Vec::new();
  v.push(1);
  v.push(2);
  print_i64(head(v));
  0
}
