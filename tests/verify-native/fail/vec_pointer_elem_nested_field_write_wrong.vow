// TEST: counterexample-fn "birthday"
// TEST: counterexample-vow-id 0
// TEST: counterexample-blame Callee
// The write through `grid[1][1]` reaches the object the variable `a` holds, so `a.age` is 7, not 4.
module VecPointerElemNestedFieldWriteWrong

struct Person { age: i64 }

fn birthday() -> i64 vow {
  ensures: result == 4
} {
  let grid: Vec<Vec<Person>> = Vec::new();
  let r0: Vec<Person> = Vec::new();
  let a: Person = Person { age: 4 };
  r0.push(a);
  grid.push(r0);
  let row: Vec<Person> = grid[0];
  row[0].age = 7;
  a.age
}

fn main() -> i32 [io] {
  print_i64(birthday());
  0
}
