// TEST: counterexample-fn "first_is_seven"
// TEST: counterexample-vow-id 1
// TEST: counterexample-blame Callee
// TEST: counterexample-value v.len 2
// TEST: counterexample-value v[0] 7
// The counterexample lists the parameter's length and the elements below it, and
// the replay rebuilds the `Vec` from them.
module VecParamCexContents

fn first_is_seven(v: Vec<i64>) -> i64 vow {
  requires: v.len() == 2
  ensures: result != 7
} {
  v[0]
}

fn main() -> i32 [io] {
  let v: Vec<i64> = Vec::new();
  v.push(1);
  v.push(2);
  print_i64(first_is_seven(v));
  0
}
