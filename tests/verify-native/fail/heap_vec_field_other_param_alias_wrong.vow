// `b.items` may be the very Vec `v`; the pushed element then shows in `b.items.len()`.
module HeapVecFieldOtherParamAliasWrong

struct Bag { items: Vec<i64>, tag: i64 }

fn count(v: Vec<i64>, b: Bag) -> u64 vow {
  ensures: result == 0
} {
  v.push(1);
  b.items.len()
