// TEST: counterexample-fn "twice"
// TEST: counterexample-vow-id 0
// TEST: counterexample-blame Callee
module MapInsertOverwriteLen

fn twice(k: i64) -> HashMap<i64, i64> vow {
  ensures: result.len() == 2
} {
  let m: HashMap<i64, i64> = HashMap::new();
  m.insert(k, 1);
  m.insert(k, 2);
  m
}

fn main() -> i32 [io] {
  print_u64(twice(1).len());
  0
}
