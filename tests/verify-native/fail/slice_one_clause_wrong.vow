// TEST: counterexample-fn "scale_wrong"
// TEST: counterexample-vow-id 3
// TEST: counterexample-blame Callee
// TEST: counterexample-violation "ensures b * 3 > b + 2"
module SliceOneClauseWrong

fn scale_wrong(a: i64, b: i64) -> i64 vow {
  requires: a > 0 && a < 1000000000
  requires: b > 0 && b < 1000000000
  ensures: a * 2 > a
  ensures: b * 3 > b + 2
} {
  a * 2 + b * 3
}
