// TEST: counterexample-fn "wrap"
// TEST: counterexample-vow-id 0
// TEST: counterexample-blame Callee
// The element is the parameter itself, not an empty `Vec`.
module VecPointerElemParamStoredWrong

fn wrap(p: Vec<i64>) -> u64 vow {
  ensures: result == 0
} {
  let outer: Vec<Vec<i64>> = Vec::new();
  outer.push(p);
  let q: Vec<i64> = outer[0];
  q.len()
}

fn main() -> i32 [io] {
  let p: Vec<i64> = Vec::new();
  print_u64(wrap(p));
  0
}
