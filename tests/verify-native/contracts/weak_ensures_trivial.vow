// TEST: contract-exit 0
// TEST: contract-status weak ensures proven
// TEST: contract-trivial weak true
// TEST: contract-status pinned ensures proven
// TEST: contract-trivial pinned false
// TEST: contract-status unguarded ensures proven
// TEST: contract-trivial unguarded false
// `result >= 0` is satisfied by a body that returns 0, so the clause is
// `trivially_satisfiable`; `result == a + 1` is not. The replaced body keeps
// what its computation can abort on: `unguarded` divides by an unconstrained
// `b`, so the probe still fails on that claim and the clause is not flagged.
module WeakEnsuresTrivial

fn weak(a: i64) -> i64 vow {
  ensures: result >= 0
} {
  if a > 0 { a } else { 0 }
}

fn pinned(a: i64) -> i64 vow {
  requires: a >= 0 && a < 1000
  ensures: result == a + 1
} {
  a + 1
}

fn unguarded(a: i64, b: i64) -> i64 vow {
  ensures: result >= 0
} {
  let q: i64 = a / b;
  0 * q
}

fn main() -> i32 [io] {
  print_i64(weak(1) + pinned(1) + unguarded(4, 2));
  0
}
