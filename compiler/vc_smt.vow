module VcSmt

use vc_term

// SMT-LIB command list and its writer. This is the only module that prints
// SMT text: the symbolic executor builds `SmtScript`s and `vc_smt_render`
// turns one into the self-contained query handed to the solver.

fn VC_CMD_SET_LOGIC() -> i64 { 0 }
fn VC_CMD_SET_OPTION() -> i64 { 1 }
fn VC_CMD_DECLARE_CONST() -> i64 { 2 }
fn VC_CMD_DEFINE_FUN() -> i64 { 3 }
fn VC_CMD_ASSERT() -> i64 { 4 }
fn VC_CMD_CHECK_SAT() -> i64 { 5 }
fn VC_CMD_GET_VALUE() -> i64 { 6 }

struct SmtScript {
    kinds: Vec<i64>,
    names: Vec<String>,
    vals: Vec<String>,
    sorts: Vec<i64>,
    terms: Vec<i64>,
}

fn vc_script_new() -> SmtScript {
    SmtScript {
        kinds: Vec::new(),
        names: Vec::new(),
        vals: Vec::new(),
        sorts: Vec::new(),
        terms: Vec::new(),
    }
}

fn vc_script_push(s: SmtScript, kind: i64, name: String, val: String, sort: i64, term: i64) {
    s.kinds.push(kind);
    s.names.push(name);
    s.vals.push(val);
    s.sorts.push(sort);
    s.terms.push(term);
}

// An independent script holding the first `n` commands of `s`.
fn vc_script_prefix(s: SmtScript, n: u64) -> SmtScript {
    let out: SmtScript = vc_script_new();
    let mut i: u64 = 0;
    while i < n && i < s.kinds.len() {
        vc_script_push(out, s.kinds[i], s.names[i], s.vals[i], s.sorts[i], s.terms[i]);
        i = i + 1;
    }
    out
}

fn vc_script_set_logic(s: SmtScript, logic: String) {
    vc_script_push(s, VC_CMD_SET_LOGIC(), logic, String::from(""), 0, -1);
}

// Swaps the logic a script was opened with (command 0, from `set_logic`).
fn vc_script_replace_logic(s: SmtScript, logic: String) {
    s.names[0] = logic;
}

fn vc_script_set_option(s: SmtScript, key: String, val: String) {
    vc_script_push(s, VC_CMD_SET_OPTION(), key, val, 0, -1);
}

fn vc_script_declare_const(s: SmtScript, name: String, sort: i64) {
    vc_script_push(s, VC_CMD_DECLARE_CONST(), name, String::from(""), sort, -1);
}

fn vc_script_define_fun(s: SmtScript, name: String, sort: i64, term: i64) {
    vc_script_push(s, VC_CMD_DEFINE_FUN(), name, String::from(""), sort, term);
}

fn vc_script_assert(s: SmtScript, term: i64) {
    vc_script_push(s, VC_CMD_ASSERT(), String::from(""), String::from(""), 0, term);
}

fn vc_script_check_sat(s: SmtScript) {
    vc_script_push(s, VC_CMD_CHECK_SAT(), String::from(""), String::from(""), 0, -1);
}

// SMT-LIB's `get-value` takes at least one term, so a query with nothing to
// read back carries no `get-value` command.
fn vc_script_get_value(s: SmtScript, names: Vec<String>) {
    if names.len() == 0 {
        return;
    }
    let joined: String = String::from("");
    let mut i: u64 = 0;
    while i < names.len() {
        if i > 0 {
            joined.push_str(String::from(" "));
        }
        joined.push_str(names[i]);
        i = i + 1;
    }
    vc_script_push(s, VC_CMD_GET_VALUE(), String::from(""), joined, 0, -1);
}

fn vc_op_symbol(op: i64) -> String {
    if op == VC_OP_BVADD() { return String::from("bvadd"); }
    if op == VC_OP_BVSUB() { return String::from("bvsub"); }
    if op == VC_OP_BVMUL() { return String::from("bvmul"); }
    if op == VC_OP_BVSDIV() { return String::from("bvsdiv"); }
    if op == VC_OP_BVSREM() { return String::from("bvsrem"); }
    if op == VC_OP_BVAND() { return String::from("bvand"); }
    if op == VC_OP_BVOR() { return String::from("bvor"); }
    if op == VC_OP_BVXOR() { return String::from("bvxor"); }
    if op == VC_OP_EQ() { return String::from("="); }
    if op == VC_OP_DISTINCT() { return String::from("distinct"); }
    if op == VC_OP_BVSLT() { return String::from("bvslt"); }
    if op == VC_OP_BVSLE() { return String::from("bvsle"); }
    if op == VC_OP_BVSGT() { return String::from("bvsgt"); }
    if op == VC_OP_BVSGE() { return String::from("bvsge"); }
    if op == VC_OP_NOT() { return String::from("not"); }
    if op == VC_OP_AND() { return String::from("and"); }
    if op == VC_OP_OR() { return String::from("or"); }
    if op == VC_OP_BVUDIV() { return String::from("bvudiv"); }
    if op == VC_OP_BVUREM() { return String::from("bvurem"); }
    if op == VC_OP_BVULT() { return String::from("bvult"); }
    if op == VC_OP_BVULE() { return String::from("bvule"); }
    if op == VC_OP_BVUGT() { return String::from("bvugt"); }
    if op == VC_OP_BVUGE() { return String::from("bvuge"); }
    if op == VC_OP_BVSHL() { return String::from("bvshl"); }
    if op == VC_OP_BVLSHR() { return String::from("bvlshr"); }
    if op == VC_OP_BVASHR() { return String::from("bvashr"); }
    if op == VC_OP_BVSADDO() { return String::from("bvsaddo"); }
    if op == VC_OP_BVUADDO() { return String::from("bvuaddo"); }
    if op == VC_OP_BVSSUBO() { return String::from("bvssubo"); }
    if op == VC_OP_BVUSUBO() { return String::from("bvusubo"); }
    if op == VC_OP_BVSMULO() { return String::from("bvsmulo"); }
    if op == VC_OP_BVUMULO() { return String::from("bvumulo"); }
    if op == VC_OP_ITE() { return String::from("ite"); }
    if op == VC_OP_SELECT() { return String::from("select"); }
    if op == VC_OP_STORE() { return String::from("store"); }
    vc_fp_op_symbol(op)
}

// Float operators. The rounding mode is part of the symbol: IEEE round to
// nearest, ties to even is the only mode the language has (`fp.add RNE a b`);
// `fp.neg` flips the sign and rounds nothing.
// `to_fp` reads a bit-vector as an IEEE-754 interchange pattern.
fn vc_fp_op_symbol(op: i64) -> String {
    if op == VC_OP_FPADD() { return String::from("fp.add RNE"); }
    if op == VC_OP_FPSUB() { return String::from("fp.sub RNE"); }
    if op == VC_OP_FPMUL() { return String::from("fp.mul RNE"); }
    if op == VC_OP_FPDIV() { return String::from("fp.div RNE"); }
    if op == VC_OP_FPNEG() { return String::from("fp.neg"); }
    if op == VC_OP_FPEQ() { return String::from("fp.eq"); }
    if op == VC_OP_FPLT() { return String::from("fp.lt"); }
    if op == VC_OP_FPLE() { return String::from("fp.leq"); }
    if op == VC_OP_FPGT() { return String::from("fp.gt"); }
    if op == VC_OP_FPGE() { return String::from("fp.geq"); }
    if op == VC_OP_TOFP32() { return String::from("(_ to_fp 8 24)"); }
    if op == VC_OP_TOFP64() { return String::from("(_ to_fp 11 53)"); }
    String::from("vc-unmapped-operator")
}

fn vc_sort_text(sort: i64) -> String {
    if sort == VC_SORT_F32() {
        return String::from("(_ FloatingPoint 8 24)");
    }
    if sort == VC_SORT_F64() {
        return String::from("(_ FloatingPoint 11 53)");
    }
    if sort == VC_SORT_BOOL() {
        return String::from("Bool");
    }
    if sort == VC_SORT_ARRAY64() {
        return String::from("(Array (_ BitVec 64) (_ BitVec 64))");
    }
    let out: String = String::from("(_ BitVec ");
    out.push_str(i64_to_string(sort));
    out.push_str(String::from(")"));
    out
}

// The low `digits` hex digits of `v`, most significant first.
fn vc_hex_digits(v: i64, digits: i64) -> String {
    let out: String = String::from("");
    let mut i: i64 = digits - 1;
    while i >= 0 {
        let nib: i64 = { if i >= 16 { 0 } else { (v >> (i * 4)) & 15 } };
        if nib < 10 {
            out.push_byte(i64_to_u8_wrap(48 + nib));
        } else {
            out.push_byte(i64_to_u8_wrap(87 + nib));
        }
        i = i - 1;
    }
    out
}

// `#x...` with width/4 digits; limbs above the width are dropped.
fn vc_bv_literal(width: i64, lo: i64, hi: i64) -> String {
    let total: i64 = width / 4;
    let out: String = String::from("#x");
    if total > 16 {
        out.push_str(vc_hex_digits(hi, total - 16));
        out.push_str(vc_hex_digits(lo, 16));
    } else {
        out.push_str(vc_hex_digits(lo, total));
    }
    out
}

fn vc_ext_prefix(kind: i64, amount: i64) -> String {
    if kind == VC_EXT_LOW() {
        let out: String = String::from("(_ extract ");
        out.push_str(i64_to_string(amount - 1));
        out.push_str(String::from(" 0)"));
        return out;
    }
    let out: String = String::from("(_ ");
    if kind == VC_EXT_ZERO() {
        out.push_str(String::from("zero_extend "));
    } else {
        out.push_str(String::from("sign_extend "));
    }
    out.push_str(i64_to_string(amount));
    out.push_str(String::from(")"));
    out
}

// The name a `VC_T_QEQ` binds. No executor symbol uses it and the operands of a
// `VC_T_QEQ` are closed terms, so it is never captured.
fn vc_qeq_var() -> String { String::from("vq_i") }

fn vc_qeq_byte(arr: String, idx: String) -> String {
    let out: String = String::from("(bvand (select ");
    out.push_str(arr);
    out.push_str(String::from(" "));
    out.push_str(idx);
    out.push_str(String::from(") #x00000000000000ff)"));
    out
}

// `(forall ((vq_i (_ BitVec 64))) (=> (bvult vq_i n) (= low8(a[vq_i]) low8(b[vq_i + k]))))`.
fn vc_qeq_text(ar: VcArena, t: i64) -> String {
    let i: String = vc_qeq_var();
    let shifted: String = String::from("(bvadd ");
    shifted.push_str(i);
    shifted.push_str(String::from(" "));
    shifted.push_str(vc_term_text(ar, ar.c[t as u64]));
    shifted.push_str(String::from(")"));
    let out: String = String::from("(forall ((");
    out.push_str(i);
    out.push_str(String::from(" (_ BitVec 64))) (=> (bvult "));
    out.push_str(i);
    out.push_str(String::from(" "));
    out.push_str(vc_term_text(ar, ar.aux[t as u64]));
    out.push_str(String::from(") (= "));
    out.push_str(vc_qeq_byte(vc_term_text(ar, ar.a[t as u64]), i));
    out.push_str(String::from(" "));
    out.push_str(vc_qeq_byte(vc_term_text(ar, ar.b[t as u64]), shifted));
    out.push_str(String::from(")))"));
    out
}

// `(forall ((vq_i (_ BitVec 64))) (=> (bvule vq_i l) <body>))`.
fn vc_bound_text(ar: VcArena, t: i64, body: String) -> String {
    let out: String = String::from("(forall ((");
    out.push_str(vc_qeq_var());
    out.push_str(String::from(" (_ BitVec 64))) (=> (bvule "));
    out.push_str(vc_qeq_var());
    out.push_str(String::from(" "));
    out.push_str(vc_term_text(ar, ar.aux[t as u64]));
    out.push_str(String::from(") "));
    out.push_str(body);
    out.push_str(String::from("))"));
    out
}

fn vc_select_text(arr: String, idx: String) -> String {
    let out: String = String::from("(select ");
    out.push_str(arr);
    out.push_str(String::from(" "));
    out.push_str(idx);
    out.push_str(String::from(")"));
    out
}

// `forall i <= l. a[i] < b`.
fn vc_qlt_text(ar: VcArena, t: i64) -> String {
    let body: String = String::from("(bvult ");
    body.push_str(vc_select_text(vc_term_text(ar, ar.a[t as u64]), vc_qeq_var()));
    body.push_str(String::from(" "));
    body.push_str(vc_term_text(ar, ar.b[t as u64]));
    body.push_str(String::from(")"));
    vc_bound_text(ar, t, body)
}

// `forall i <= l. low8(a[c[i]]) != low8(b[i + c[i]])`.
fn vc_qdiff_text(ar: VcArena, t: i64) -> String {
    let pick: String = vc_select_text(vc_term_text(ar, ar.c[t as u64]), vc_qeq_var());
    let shifted: String = String::from("(bvadd ");
    shifted.push_str(vc_qeq_var());
    shifted.push_str(String::from(" "));
    shifted.push_str(pick);
    shifted.push_str(String::from(")"));
    let body: String = String::from("(distinct ");
    body.push_str(vc_qeq_byte(vc_term_text(ar, ar.a[t as u64]), pick));
    body.push_str(String::from(" "));
    body.push_str(vc_qeq_byte(vc_term_text(ar, ar.b[t as u64]), shifted));
    body.push_str(String::from(")"));
    vc_bound_text(ar, t, body)
}

fn vc_term_text(ar: VcArena, t: i64) -> String {
    let kind: i64 = ar.kinds[t as u64];
    let aux: i64 = ar.aux[t as u64];
    if kind == VC_T_VAR() {
        return String::from(ar.strs[aux as u64]);
    }
    if kind == VC_T_QEQ() {
        return vc_qeq_text(ar, t);
    }
    if kind == VC_T_QLT() {
        return vc_qlt_text(ar, t);
    }
    if kind == VC_T_QDIFF() {
        return vc_qdiff_text(ar, t);
    }
    if kind == VC_T_BV() {
        return vc_bv_literal(ar.a[t as u64], aux, ar.b[t as u64]);
    }
    if kind == VC_T_EXT() {
        let out: String = String::from("(");
        out.push_str(vc_ext_prefix(aux, ar.b[t as u64]));
        out.push_str(String::from(" "));
        out.push_str(vc_term_text(ar, ar.a[t as u64]));
        out.push_str(String::from(")"));
        return out;
    }
    if kind == VC_T_BOOL() {
        if aux == 0 {
            return String::from("false");
        }
        return String::from("true");
    }
    let out: String = String::from("(");
    out.push_str(vc_op_symbol(aux));
    out.push_str(String::from(" "));
    out.push_str(vc_term_text(ar, ar.a[t as u64]));
    let rhs: i64 = ar.b[t as u64];
    if rhs >= 0 {
        out.push_str(String::from(" "));
        out.push_str(vc_term_text(ar, rhs));
    }
    let third: i64 = ar.c[t as u64];
    if third >= 0 {
        out.push_str(String::from(" "));
        out.push_str(vc_term_text(ar, third));
    }
    out.push_str(String::from(")"));
    out
}

fn vc_command_text(ar: VcArena, s: SmtScript, i: u64) -> String {
    let kind: i64 = s.kinds[i];
    let out: String = String::from("");
    if kind == VC_CMD_SET_LOGIC() {
        out.push_str(String::from("(set-logic "));
        out.push_str(s.names[i]);
        out.push_str(String::from(")"));
    } else if kind == VC_CMD_SET_OPTION() {
        out.push_str(String::from("(set-option "));
        out.push_str(s.names[i]);
        out.push_str(String::from(" "));
        out.push_str(s.vals[i]);
        out.push_str(String::from(")"));
    } else if kind == VC_CMD_DECLARE_CONST() {
        out.push_str(String::from("(declare-const "));
        out.push_str(s.names[i]);
        out.push_str(String::from(" "));
        out.push_str(vc_sort_text(s.sorts[i]));
        out.push_str(String::from(")"));
    } else if kind == VC_CMD_DEFINE_FUN() {
        out.push_str(String::from("(define-fun "));
        out.push_str(s.names[i]);
        out.push_str(String::from(" () "));
        out.push_str(vc_sort_text(s.sorts[i]));
        out.push_str(String::from(" "));
        out.push_str(vc_term_text(ar, s.terms[i]));
        out.push_str(String::from(")"));
    } else if kind == VC_CMD_ASSERT() {
        vc_smt_push_assert(out, ar, s.terms[i]);
    } else if kind == VC_CMD_CHECK_SAT() {
        out.push_str(String::from("(check-sat)"));
    } else {
        out.push_str(String::from("(get-value ("));
        out.push_str(s.vals[i]);
        out.push_str(String::from("))"));
    }
    out
}

// Commands `[from, to)` (clamped to the script), one per line, each line
// newline-terminated.
fn vc_smt_render_cmds(ar: VcArena, s: SmtScript, from: u64, to: u64) -> String {
    let out: String = String::from("");
    let mut i: u64 = from;
    while i < to && i < s.kinds.len() {
        out.push_str(vc_command_text(ar, s, i));
        out.push_str(String::from("\n"));
        i = i + 1;
    }
    out
}

// One command per line, each line newline-terminated.
fn vc_smt_render(ar: VcArena, s: SmtScript) -> String {
    vc_smt_render_cmds(ar, s, 0, s.kinds.len())
}

// Appends `(assert <term>)` for a term id to `out`, no trailing newline.
// `vc_command_text` writes its assertion commands through it.
fn vc_smt_push_assert(out: String, ar: VcArena, t: i64) {
    out.push_str(String::from("(assert "));
    out.push_str(vc_term_text(ar, t));
    out.push_str(String::from(")"));
}
