module VcStrfold

use vc_term
use vc_smt
use vc_agg
use vc_vec
use vc_strdeep
use vc_str

// Exact models of `hash_str`, `hex_encode` and `hex_decode` in the native verifier
// (ADR-2026-10-08-1422, #1654 addendum). Each is a total function of the bytes it reads,
// defined by assumptions over a fresh array, so a model is a conservative extension of the
// query: the assumptions only name the result and cannot make it unsatisfiable. A binder
// (`VC_T_QFOLD`, `VC_T_QHEX`, `VC_T_QUNHEX`, printed by `vc_qbind`) stands only in such an
// assumption, in a positive position, never in a goal, as `VC_T_QEQ` does. A range whose length
// is a small constant is unfolded instead, and the unfolding is an encoding choice, not a bound.
//
// - `hash_str(s)` is the FNV-1a fold of the runtime over every byte, from the offset basis:
//   `h[0] = basis` and `forall i < |s|. h[i + 1] = (h[i] xor s[i]) * prime`, the result `h[|s|]`.
// - `hex_encode(v)` is a string of length `2 |v|` whose bytes `2i`, `2i + 1` are the digits of the
//   high and the low nibble of `low8(v[i])`.
// - `hex_decode(s)` is the runtime's strict decoder: an empty `Vec` unless `|s|` is even and every
//   pair parses with `u8::from_str_radix(pair, 16)` (a hex digit, optionally after a `+`); then
//   the decoded bytes. The Bool `e` ("the string decodes") is tied to its statement in both
//   directions, the false one through a witness pair that fails, as `vc_str_range_eq` does.

fn VC_FOLD_HASH() -> i64 { 1 }
fn VC_FOLD_HEX_ENCODE() -> i64 { 2 }
fn VC_FOLD_HEX_DECODE() -> i64 { 3 }

// Unrolling bound of a fold or a hex range of known length: an encoding choice, the binder
// states the same for every length.
fn VC_FOLD_UNFOLD() -> i64 { 64 }

fn vc_fold_c(ar: VcArena, v: i64) -> i64 {
    vc_tm_bv(ar, 64, v, 0)
}

// The index of the earlier call of `kind` on the operand terms `(a, b)`, or -1.
fn vc_fold_find(vv: VcVec, kind: i64, a: i64, b: i64) -> i64 {
    let k: Vec<i64> = vv.fm_key;
    let mut i: u64 = 0;
    while i + 2 < k.len() {
        if k[i] == kind && k[i + 1] == a && k[i + 2] == b { return (i / 3) as i64; }
        i = i + 3;
    }
    -1
}

fn vc_fold_memo(vv: VcVec, kind: i64, a: i64, b: i64, arr: i64, len: i64) {
    vv.fm_key.push(kind);
    vv.fm_key.push(a);
    vv.fm_key.push(b);
    vv.fm_arr.push(arr);
    vv.fm_len.push(len);
}

// `hash_str` of the string `(arr, len)`: a closed term for a short known length, else the
// entry `len` of the prefix array.
fn vc_str_hash(vv: VcVec, ar: VcArena, hdr: SmtScript, assumed: Vec<i64>, arr: i64, len: i64) -> i64 {
    let known: i64 = vc_fold_find(vv, VC_FOLD_HASH(), arr, len);
    if known >= 0 { return vv.fm_arr[known as u64]; }
    let basis: i64 = vc_fold_c(ar, -3750763034362895579);
    let prime: i64 = vc_fold_c(ar, 1099511628211);
    let cnt: i64 = vc_str_const(ar, len);
    let mut res: i64 = basis;
    if cnt >= 0 && cnt <= VC_FOLD_UNFOLD() {
        let mut j: i64 = 0;
        while j < cnt {
            let b: i64 = vc_str_ground_byte(vv, ar, arr, vc_fold_c(ar, j));
            res = vc_tm_app2(ar, VC_OP_BVMUL(), vc_tm_app2(ar, VC_OP_BVXOR(), res, b), prime);
            j = j + 1;
        }
    } else {
        let h: i64 = vc_str_fresh_array(vv, ar, hdr, String::from("hh"));
        vc_str_axiom(ar, assumed, vc_tm_app2(ar, VC_OP_EQ(), vc_tm_app2(ar, VC_OP_SELECT(), h, vc_fold_c(ar, 0)), basis));
        vc_str_axiom(ar, assumed, vc_tm_qfold(ar, h, arr, len));
        vv.quantified = true;
        res = vc_tm_app2(ar, VC_OP_SELECT(), h, len);
    }
    vc_fold_memo(vv, VC_FOLD_HASH(), arr, len, res, -1);
    res
}

// The hex digit of a nibble `d` (a term below 16): `0123456789abcdef`.
fn vc_fold_digit(ar: VcArena, d: i64) -> i64 {
    let below: i64 = vc_tm_app2(ar, VC_OP_BVULT(), d, vc_fold_c(ar, 10));
    vc_tm_app3(ar, VC_OP_ITE(), below, vc_tm_app2(ar, VC_OP_BVADD(), d, vc_fold_c(ar, 48)), vc_tm_app2(ar, VC_OP_BVADD(), d, vc_fold_c(ar, 87)))
}

// Under `guard`, the two digits at entry `i` of `hex_encode`'s result `arr` for the element `varr[i]`:
// one instance of the encode binder, a plain fact.
fn vc_fold_hex_at(ar: VcArena, assumed: Vec<i64>, guard: i64, arr: i64, varr: i64, i: i64) {
    let x: i64 = vc_tm_app2(ar, VC_OP_BVAND(), vc_tm_app2(ar, VC_OP_SELECT(), varr, i), vc_fold_c(ar, 255));
    let hi: i64 = vc_tm_app2(ar, VC_OP_BVLSHR(), x, vc_fold_c(ar, 4));
    let lo: i64 = vc_tm_app2(ar, VC_OP_BVAND(), x, vc_fold_c(ar, 15));
    let at: i64 = vc_tm_app2(ar, VC_OP_BVMUL(), i, vc_fold_c(ar, 2));
    let next: i64 = vc_tm_app2(ar, VC_OP_BVADD(), at, vc_fold_c(ar, 1));
    vc_str_axiom(ar, assumed, vc_tm_implies(ar, guard, vc_tm_app2(ar, VC_OP_EQ(), vc_str_byte(ar, arr, at), vc_fold_digit(ar, hi))));
    vc_str_axiom(ar, assumed, vc_tm_implies(ar, guard, vc_tm_app2(ar, VC_OP_EQ(), vc_str_byte(ar, arr, next), vc_fold_digit(ar, lo))));
}

// `hex_encode` of the `Vec` `(varr, vlen)` as the `(array, length)` of a string pushed on
// `out`. The length `2 |v|` is a closed term; the caller assumes it stays below the capacity
// mask. The digits are asserted only when some instruction reads the bytes of a string.
fn vc_str_hex_encode(vv: VcVec, ar: VcArena, hdr: SmtScript, assumed: Vec<i64>, varr: i64, vlen: i64, out: Vec<i64>) {
    let known: i64 = vc_fold_find(vv, VC_FOLD_HEX_ENCODE(), varr, vlen);
    if known >= 0 {
        out.push(vv.fm_arr[known as u64]);
        out.push(vv.fm_len[known as u64]);
        return;
    }
    let arr: i64 = vc_str_fresh_array(vv, ar, hdr, String::from("hx"));
    let zero: i64 = vc_fold_c(ar, 0);
    let len: i64 = vc_tm_app2(ar, VC_OP_BVMUL(), vlen, vc_fold_c(ar, 2));
    if vv.content {
        let cnt: i64 = vc_str_const(ar, vlen);
        if cnt >= 0 && cnt <= 16 {
            let mut j: i64 = 0;
            while j < cnt {
                vc_fold_hex_at(ar, assumed, vc_tm_bool_const(ar, true), arr, varr, vc_fold_c(ar, j));
                j = j + 1;
            }
        } else {
            vc_str_axiom(ar, assumed, vc_tm_qhex(ar, arr, varr, vlen));
            vv.quantified = true;
            let some: i64 = vc_tm_app2(ar, VC_OP_BVULT(), zero, vlen);
            vc_fold_hex_at(ar, assumed, some, arr, varr, zero);
            vc_fold_hex_at(ar, assumed, some, arr, varr, vc_tm_app2(ar, VC_OP_BVSUB(), vlen, vc_fold_c(ar, 1)));
        }
    }
    vc_fold_memo(vv, VC_FOLD_HEX_ENCODE(), varr, vlen, arr, len);
    out.push(arr);
    out.push(len);
}

// Under `guard`, pair `i` of the decoded string `sarr` is accepted and `arr[i]` is its byte: one
// instance of the decode binder, a plain fact.
fn vc_fold_pair_at(ar: VcArena, assumed: Vec<i64>, guard: i64, arr: i64, sarr: i64, i: i64) {
    vc_str_axiom(ar, assumed, vc_tm_implies(ar, guard, vc_tm_hexpair(ar, sarr, i)));
    vc_str_axiom(ar, assumed, vc_tm_implies(ar, guard, vc_tm_app2(ar, VC_OP_EQ(), vc_tm_app2(ar, VC_OP_SELECT(), arr, i), vc_tm_hexval(ar, sarr, i))));
}

// `hex_decode` of the string `(sarr, slen)` as the `(array, length)` of a `Vec<u8>` pushed on
// `out`. Elements are the decoded bytes, zero-extended slots.
fn vc_str_hex_decode(vv: VcVec, ar: VcArena, hdr: SmtScript, assumed: Vec<i64>, sarr: i64, slen: i64, out: Vec<i64>) {
    let known: i64 = vc_fold_find(vv, VC_FOLD_HEX_DECODE(), sarr, slen);
    if known >= 0 {
        out.push(vv.fm_arr[known as u64]);
        out.push(vv.fm_len[known as u64]);
        return;
    }
    let zero: i64 = vc_fold_c(ar, 0);
    let arr: i64 = vc_str_fresh_array(vv, ar, hdr, String::from("hd"));
    let e: i64 = vc_agg_declare(ar, hdr, vc_vec_fresh_name(vv, String::from("hde")), VC_SORT_BOOL());
    let w: i64 = vc_agg_declare(ar, hdr, vc_vec_fresh_name(vv, String::from("hdw")), 64);
    let pairs: i64 = vc_tm_app2(ar, VC_OP_BVLSHR(), slen, vc_fold_c(ar, 1));
    let even: i64 = vc_tm_app2(ar, VC_OP_EQ(), vc_tm_app2(ar, VC_OP_BVAND(), slen, vc_fold_c(ar, 1)), zero);
    vc_str_axiom(ar, assumed, vc_tm_implies(ar, e, vc_tm_and(ar, even, vc_tm_qunhex(ar, arr, sarr, pairs))));
    let bad: i64 = vc_tm_and(ar, vc_tm_app2(ar, VC_OP_BVULT(), w, pairs), vc_tm_app1(ar, VC_OP_NOT(), vc_tm_hexpair(ar, sarr, w)));
    vc_str_axiom(ar, assumed, vc_tm_implies(ar, vc_tm_app1(ar, VC_OP_NOT(), e), vc_tm_or(ar, vc_tm_app1(ar, VC_OP_NOT(), even), bad)));
    vv.quantified = true;
    let some: i64 = vc_tm_and(ar, e, vc_tm_app2(ar, VC_OP_BVULT(), zero, pairs));
    vc_fold_pair_at(ar, assumed, some, arr, sarr, zero);
    vc_fold_pair_at(ar, assumed, some, arr, sarr, vc_tm_app2(ar, VC_OP_BVSUB(), pairs, vc_fold_c(ar, 1)));
    let len: i64 = vc_tm_app3(ar, VC_OP_ITE(), e, pairs, zero);
    vc_fold_memo(vv, VC_FOLD_HEX_DECODE(), sarr, slen, arr, len);
    out.push(arr);
    out.push(len);
}
