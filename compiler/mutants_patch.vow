module Patch

// Pure splice: return src with bytes [off, off+len) replaced by `replacement`.
fn splice(src: String, off: u64, len: u64, replacement: String) -> String {
    let r: String = src.substring(0, off);
    r.push_str(replacement);
    r.push_str(src.substring(off + len, src.len()));
    r
}
