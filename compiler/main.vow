fn has_flag(argv: Vec<String>, flag: String) -> bool {
    let mut i: u64 = 1;
    let mut found: bool = false;
    while i < argv.len() {
        if argv[i] == flag {
            found = true;
        }
        i = i + 1;
    }
    found
}

fn get_flag_arg(argv: Vec<String>, flag: String) -> String {
    let n: i64 = argv.len() as i64;
    let mut i: i64 = 1;
    while n > 1 && i < n - 1 {
        if argv[i as u64] == flag {
            return argv[(i + 1) as u64];
        }
        i = i + 1;
    }
    String::from("")
}

// `-o` and `--output` are the same flag; `-o` wins when both are given.
fn output_flag_value(argv: Vec<String>) -> String {
    if has_flag(argv, "-o") { return get_flag_arg(argv, "-o"); }
    get_flag_arg(argv, "--output")
}

fn has_output_flag(argv: Vec<String>) -> bool {
    has_flag(argv, "-o") || has_flag(argv, "--output")
}

fn get_source_path(argv: Vec<String>) -> String {
    let argc: i64 = argv.len() as i64;
    let mut i: i64 = argc - 1;
    while i >= 1 {
        let a: String = argv[i as u64];
        let first_byte: i64 = a.byte_at(0);
        if first_byte != 45 {
            if i > 1 {
                let prev: String = argv[(i - 1) as u64];
                if cli_flag_takes_value(prev) {
                    i = i - 1;
                } else {
                    return a;
                }
            } else {
                return a;
            }
        }
        i = i - 1;
    }
    String::from("")
}

fn get_source_path_sub(argv: Vec<String>) -> String {
    let argc: i64 = argv.len() as i64;
    let mut i: i64 = argc - 1;
    while i >= 2 {
        let a: String = argv[i as u64];
        let first_byte: i64 = a.byte_at(0);
        if first_byte != 45 {
            if i > 2 {
                let prev: String = argv[(i - 1) as u64];
                if cli_flag_takes_value(prev) {
                    i = i - 1;
                } else {
                    return a;
                }
            } else {
                return a;
            }
        }
        i = i - 1;
    }
    String::from("")
}


fn default_output(path: String) -> String {
    let n: u64 = path.len();
    // Find last '/' to extract basename
    let start: u64 = match str_rfind_byte(path, 47) {
        Option::None => 0,
        Option::Some(k) => k + 1u64,
    };
    // Strip .vow extension if present
    let mut end: u64 = n;
    if n - start > 4 {
        let d: i64 = path.byte_at(n - 4);
        let v: i64 = path.byte_at(n - 3);
        let o: i64 = path.byte_at(n - 2);
        let w: i64 = path.byte_at(n - 1);
        if d == 46 && v == 118 && o == 111 && w == 119 {
            end = n - 4;
        }
    };
    let r: String = String::from("build/");
    r.push_str(path.substring(start, end));
    r
}

fn get_subcommand(argv: Vec<String>) -> i64 {
    if argv.len() < 2 {
        return CMD_NONE();
    }
    let sub: String = argv[1];
    if sub == "build" {
        return CMD_BUILD();
    }
    if sub == "verify" {
        return CMD_VERIFY();
    }
    if sub == "test" {
        return CMD_TEST();
    }
    if sub == "contracts" {
        return CMD_CONTRACTS();
    }
    if sub == "skill" {
        return CMD_SKILL();
    }
    if sub == "mutants" {
        return CMD_MUTANTS();
    }
    if sub == "complexity" {
        return CMD_COMPLEXITY();
    }
    if sub == "decl" {
        return CMD_DECL();
    }
    if sub == "verify-worker" {
        return CMD_VERIFY_WORKER();
    }
    CMD_NONE()
}

fn frontend_path_from_argv(argv: Vec<String>, sub: bool, cmd: String) -> String [io] {
    let path: String = {
        if sub {
            get_source_path_sub(argv)
        } else {
            get_source_path(argv)
        }
    };
    if path.len() == 0 {
        diag_eprintln_best_effort(str3(String::from("vow "), cmd, String::from(": source file required (try --help)")));
        process_exit(1);
    }
    path
}

fn find_ir_function_index_by_id(fns: Vec<IrFunction>, id: i64) -> i64 {
    let mut i: i64 = 0;
    while i < fns.len() as i64 {
        let f: IrFunction = fns[i as u64];
        if f.id == id {
            return i;
        }
        i = i + 1;
    }
    -1
}

fn find_ir_vow_index(vows: Vec<IrVowEntry>, id: i64) -> i64 {
    let mut i: i64 = 0;
    while i < vows.len() as i64 {
        let ve: IrVowEntry = vows[i as u64];
        if ve.id == id {
            return i;
        }
        i = i + 1;
    }
    -1
}

fn find_param_index(names: Vec<String>, name: String) -> i64 {
    let mut i: i64 = 0;
    while i < names.len() as i64 {
        if names[i as u64] == name {
            return i;
        }
        i = i + 1;
    }
    -1
}

fn ce_value_for_param(names: Vec<String>, vals: Vec<String>, param: String, param_idx: i64) -> String {
    let fallback_esbmc: String = str2(String::from("$esbmc$p"), i64_to_string(param_idx));
    let fallback_raw: String = str2(String::from("p"), i64_to_string(param_idx));
    let mut i: u64 = 0;
    while i < names.len() {
        if names[i] == param || names[i] == fallback_esbmc || names[i] == fallback_raw {
            return vals[i];
        }
        i = i + 1;
    }
    String::from("")
}

fn string_is_i64_literal(s: String) -> bool {
    if s.len() == 0 {
        return false;
    }
    let v: i64 = str_to_i64(s);
    i64_to_string(v) == s
}

fn callee_i64_string_for_call(f: IrFunction, callee: IrFunction, inst_id: i64, call_inst: IrInst) -> String {
    let blocks: Vec<IrBlock> = callee.blocks;
    let mut bi: u64 = 0;
    while bi < blocks.len() {
        let insts: Vec<IrInst> = blocks[bi].insts;
        let mut ii: u64 = 0;
        while ii < insts.len() {
            let inst: IrInst = insts[ii];
            if inst.id == inst_id {
                if inst.op == IOP_CONST_I32() || inst.op == IOP_CONST_I64() {
                    return i64_to_string(inst.dv);
                }
                if inst.op == IOP_CONST_U64() && inst.dv >= 0 {
                    return i64_to_string(inst.dv);
                }
                if inst.op == IOP_GET_ARG() && inst.dk == IDATA_ARG_INDEX() {
                    let pidx: i64 = inst.dv;
                    if pidx >= 0 && pidx < call_inst.args.len() as i64 {
                        return ce_fold_i64_string(f, call_inst.args[pidx as u64]);
                    }
                    return String::from("");
                }
                if inst.args.len() >= 2 {
                    let lhs_s: String = callee_i64_string_for_call(f, callee, inst.args[0], call_inst);
                    let rhs_s: String = callee_i64_string_for_call(f, callee, inst.args[1], call_inst);
                    if string_is_i64_literal(lhs_s) && string_is_i64_literal(rhs_s) {
                        let lhs: i64 = str_to_i64(lhs_s);
                        let rhs: i64 = str_to_i64(rhs_s);
                        if inst.op == IOP_WADD() || inst.op == IOP_CADD() {
                            return i64_to_string(lhs + rhs);
                        }
                        if inst.op == IOP_WSUB() || inst.op == IOP_CSUB() {
                            return i64_to_string(lhs - rhs);
                        }
                        if inst.op == IOP_WMUL() || inst.op == IOP_CMUL() {
                            return i64_to_string(lhs * rhs);
                        }
                    }
                }
                return String::from("");
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    String::from("")
}

fn callee_bool_for_call(f: IrFunction, callee: IrFunction, inst_id: i64, call_inst: IrInst) -> i64 {
    let blocks: Vec<IrBlock> = callee.blocks;
    let mut bi: u64 = 0;
    while bi < blocks.len() {
        let insts: Vec<IrInst> = blocks[bi].insts;
        let mut ii: u64 = 0;
        while ii < insts.len() {
            let inst: IrInst = insts[ii];
            if inst.id == inst_id {
                if inst.op == IOP_CONST_BOOL() {
                    if inst.dv == 0 {
                        return 0;
                    }
                    return 1;
                }
                if inst.op == IOP_NOT() && inst.args.len() >= 1 {
                    let v: i64 = callee_bool_for_call(f, callee, inst.args[0], call_inst);
                    if v == 0 {
                        return 1;
                    }
                    if v == 1 {
                        return 0;
                    }
                    return -1;
                }
                if (inst.op == IOP_AND() || inst.op == IOP_OR()) && inst.args.len() >= 2 {
                    let lhs_b: i64 = callee_bool_for_call(f, callee, inst.args[0], call_inst);
                    let rhs_b: i64 = callee_bool_for_call(f, callee, inst.args[1], call_inst);
                    if lhs_b < 0 || rhs_b < 0 {
                        return -1;
                    }
                    if inst.op == IOP_AND() {
                        if lhs_b == 1 && rhs_b == 1 {
                            return 1;
                        }
                        return 0;
                    }
                    if lhs_b == 1 || rhs_b == 1 {
                        return 1;
                    }
                    return 0;
                }
                if inst.args.len() >= 2 {
                    let lhs_s: String = callee_i64_string_for_call(f, callee, inst.args[0], call_inst);
                    let rhs_s: String = callee_i64_string_for_call(f, callee, inst.args[1], call_inst);
                    if string_is_i64_literal(lhs_s) && string_is_i64_literal(rhs_s) {
                        let lhs: i64 = str_to_i64(lhs_s);
                        let rhs: i64 = str_to_i64(rhs_s);
                        if inst.op == IOP_EQ() {
                            if lhs == rhs { return 1; }
                            return 0;
                        }
                        if inst.op == IOP_NE() {
                            if lhs != rhs { return 1; }
                            return 0;
                        }
                        if inst.op == IOP_LT() {
                            if lhs < rhs { return 1; }
                            return 0;
                        }
                        if inst.op == IOP_LE() {
                            if lhs <= rhs { return 1; }
                            return 0;
                        }
                        if inst.op == IOP_GT() {
                            if lhs > rhs { return 1; }
                            return 0;
                        }
                        if inst.op == IOP_GE() {
                            if lhs >= rhs { return 1; }
                            return 0;
                        }
                    }
                }
                return -1;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    -1
}

fn callee_precondition_predicate_inst_id(callee: IrFunction, ve: IrVowEntry) -> i64 {
    let blocks: Vec<IrBlock> = callee.blocks;
    let mut bi: u64 = 0;
    while bi < blocks.len() {
        let insts: Vec<IrInst> = blocks[bi].insts;
        let mut ii: u64 = 0;
        while ii < insts.len() {
            let inst: IrInst = insts[ii];
            if inst.op == IOP_VOW_REQ() && inst.dk == IDATA_VOW_ID() && inst.dv == ve.id && inst.args.len() > 0 {
                return inst.args[0];
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    -1
}

fn call_violates_callee_precondition_const(f: IrFunction, callee: IrFunction, ve: IrVowEntry, inst: IrInst) -> bool {
    let pred_id: i64 = callee_precondition_predicate_inst_id(callee, ve);
    if pred_id < 0 {
        return false;
    }
    callee_bool_for_call(f, callee, pred_id, inst) == 0
}

fn call_matches_callee_precondition_values(f: IrFunction, callee: IrFunction, ve: IrVowEntry, inst: IrInst, vr: VerifyResult) -> bool {
    let mut matched_binding: bool = false;
    let mut bindi: u64 = 0;
    while bindi < ve.binding_names.len() {
        let bname: String = ve.binding_names[bindi];
        let pidx: i64 = find_param_index(callee.param_names, bname);
        if pidx < 0 || pidx >= inst.args.len() as i64 {
            return false;
        }
        let ce_val: String = ce_value_for_param(vr.var_names, vr.var_values, bname, pidx);
        if ce_val.len() == 0 {
            return false;
        }
        let arg_val: String = ce_fold_i64_string(f, inst.args[pidx as u64]);
        if arg_val.len() == 0 {
            return false;
        }
        if arg_val != ce_val {
            return false;
        }
        matched_binding = true;
        bindi = bindi + 1;
    }
    matched_binding
}

fn call_matches_callee_precondition_candidate(f: IrFunction, callee: IrFunction, ve: IrVowEntry, inst: IrInst, vr: VerifyResult) -> bool {
    if call_matches_callee_precondition_values(f, callee, ve, inst, vr) {
        return true;
    }
    call_violates_callee_precondition_const(f, callee, ve, inst)
}

fn count_exact_callee_precondition_calls(f: IrFunction, callee: IrFunction, ve: IrVowEntry, vr: VerifyResult) -> i64 {
    let mut count: i64 = 0;
    let blocks: Vec<IrBlock> = f.blocks;
    let mut bi: u64 = 0;
    while bi < blocks.len() {
        let insts: Vec<IrInst> = blocks[bi].insts;
        let mut ii: u64 = 0;
        while ii < insts.len() {
            let inst: IrInst = insts[ii];
            if inst.op == IOP_CALL() && inst.dk == IDATA_CALL_TARGET() && inst.dv == callee.id {
                if call_matches_callee_precondition_candidate(f, callee, ve, inst, vr) {
                    count = count + 1;
                }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    count
}

fn inst_offset_by_id(f: IrFunction, inst_id: i64) -> i64 {
    let blocks: Vec<IrBlock> = f.blocks;
    let mut bi: u64 = 0;
    while bi < blocks.len() {
        let insts: Vec<IrInst> = blocks[bi].insts;
        let mut ii: u64 = 0;
        while ii < insts.len() {
            let inst: IrInst = insts[ii];
            if inst.id == inst_id {
                return inst.ostart;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    0
}

fn inst_len_by_id(f: IrFunction, inst_id: i64) -> i64 {
    let blocks: Vec<IrBlock> = f.blocks;
    let mut bi: u64 = 0;
    while bi < blocks.len() {
        let insts: Vec<IrInst> = blocks[bi].insts;
        let mut ii: u64 = 0;
        while ii < insts.len() {
            let inst: IrInst = insts[ii];
            if inst.id == inst_id {
                return inst.olen;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    0
}

fn build_ce_from_result(f: IrFunction, ir_mod: IrModule, vr: VerifyResult, path: String) -> VerifyCE {
    let vow_id: i64 = vr.vow_id;
    // Keep the raw `-1` sentinel internally for vow matching. The JSON API uses
    // a reserved non-contract id so an unattributed property cannot collide
    // with the function's real vow 0.
    let public_vow_id: i64 = {
        if vow_id < 0 { verifier_unattributed_vow_id() } else { vow_id }
    };
    let mut ce_violation: String = String::from("");
    let mut ce_blame: i64 = DIAG_BLAME_NONE();
    let call_site_functions: Vec<String> = Vec::new();
    let call_site_files: Vec<String> = Vec::new();
    let call_site_offsets: Vec<i64> = Vec::new();
    let call_site_lengths: Vec<i64> = Vec::new();
    let violating_arg_params: Vec<String> = Vec::new();
    let violating_arg_values: Vec<String> = Vec::new();
    let violating_arg_offsets: Vec<i64> = Vec::new();
    let violating_arg_lengths: Vec<i64> = Vec::new();
    let mut ce_source_file: String = String::from("");
    let mut ce_source_start: i64 = 0;
    let mut ce_source_len: i64 = 0;
    let mut ce_function: String = f.name;
    if vow_id == unsupported_op_vow_id() {
        // Fail-closed assertion from emit_unsupported_for_verification: no
        // user-authored vow has this id, so synthesize an actionable message
        // instead of leaving the violation blank.
        ce_violation = String::from("function uses side-effecting operations not supported for verification");
    } else if vr.callee_precondition_func_id >= 0 && vr.callee_precondition_vow_id >= 0 {
        let fi: i64 = find_ir_function_index_by_id(ir_mod.functions, vr.callee_precondition_func_id);
        if fi >= 0 {
            let callee: IrFunction = ir_mod.functions[fi as u64];
            let vows: Vec<IrVowEntry> = callee.vows;
            let vi: i64 = find_ir_vow_index(vows, vr.callee_precondition_vow_id);
            if vi >= 0 {
                let ve: IrVowEntry = vows[vi as u64];
                ce_violation = ve.description;
                ce_blame = DIAG_BLAME_CALLER();
                let callee_src: CeSource = ce_source_for_vow(callee, ve, path);
                ce_source_file = callee_src.file;
                ce_source_start = callee_src.start;
                ce_source_len = callee_src.len;

                let exact_call_matches: i64 = count_exact_callee_precondition_calls(f, callee, ve, vr);
                let blocks: Vec<IrBlock> = f.blocks;
                let mut bi: u64 = 0;
                while bi < blocks.len() {
                    let insts: Vec<IrInst> = blocks[bi].insts;
                    let mut ii: u64 = 0;
                    while ii < insts.len() {
                        let inst: IrInst = insts[ii];
                        if inst.op == IOP_CALL() && inst.dk == IDATA_CALL_TARGET() && inst.dv == callee.id {
                            if exact_call_matches == 0 || call_matches_callee_precondition_candidate(f, callee, ve, inst, vr) {
                                call_site_functions.push(f.name);
                                call_site_files.push(path);
                                call_site_offsets.push(inst.ostart);
                                call_site_lengths.push(inst.olen);

                                let mut bindi: u64 = 0;
                                while bindi < ve.binding_names.len() {
                                    let bname: String = ve.binding_names[bindi];
                                    let pidx: i64 = find_param_index(callee.param_names, bname);
                                    if pidx >= 0 && pidx < inst.args.len() as i64 {
                                        violating_arg_params.push(bname);
                                        let arg_inst_id: i64 = inst.args[pidx as u64];
                                        let ce_val: String = ce_value_for_param(vr.var_names, vr.var_values, bname, pidx);
                                        if ce_val.len() > 0 {
                                            violating_arg_values.push(ce_val);
                                        } else {
                                            violating_arg_values.push(ce_arg_value_string(f, arg_inst_id));
                                        }
                                        violating_arg_offsets.push(inst_offset_by_id(f, arg_inst_id));
                                        violating_arg_lengths.push(inst_len_by_id(f, arg_inst_id));
                                    }
                                    bindi = bindi + 1;
                                }
                            }
                        }
                        ii = ii + 1;
                    }
                    bi = bi + 1;
                }
            }
        }
        if ce_violation.len() == 0 {
            ce_violation = String::from("callee precondition violated by the caller");
            ce_blame = DIAG_BLAME_CALLER();
        }
    } else if vr.callee_postcondition_func_id >= 0 && vr.callee_postcondition_vow_id >= 0 {
        // A co-emitted callee's `ensures`/`invariant` failed: its vow id is local
        // to the callee, so resolve it there, never against the target's vows.
        let fi: i64 = find_ir_function_index_by_id(ir_mod.functions, vr.callee_postcondition_func_id);
        if fi >= 0 {
            let callee: IrFunction = ir_mod.functions[fi as u64];
            let vows: Vec<IrVowEntry> = callee.vows;
            let vi: i64 = find_ir_vow_index(vows, vr.callee_postcondition_vow_id);
            if vi >= 0 {
                let ve: IrVowEntry = vows[vi as u64];
                ce_function = callee.name;
                ce_violation = ve.description;
                ce_blame = ve.blame;
                let callee_src: CeSource = ce_source_for_vow(callee, ve, path);
                ce_source_file = callee_src.file;
                ce_source_start = callee_src.start;
                ce_source_len = callee_src.len;
            }
        }
        if ce_violation.len() == 0 {
            let assert_description: String = parse_assert_label(vr.raw_output);
            if assert_description.len() > 0 {
                ce_violation = assert_description;
            } else {
                ce_violation = String::from("internal verifier assertion failed");
            }
        }
    } else if vow_id == caller_precondition_vow_id() {
        // A co-emitted callee's `requires` was violated by this caller. The
        // sentinel id matches no vow in `f`, so synthesize a Caller-blamed
        // precondition diagnostic rather than mis-resolving to the target's vow
        // of the same local index.
        ce_violation = String::from("callee precondition violated by the caller");
        ce_blame = DIAG_BLAME_CALLER();
    } else {
        let vow_entries: Vec<IrVowEntry> = f.vows;
        let mut vi: u64 = 0;
        while vi < vow_entries.len() {
            let ve: IrVowEntry = vow_entries[vi];
            if ve.id == vow_id {
                ce_violation = ve.description;
                ce_blame = ve.blame;
                let own_src: CeSource = ce_source_for_vow(f, ve, path);
                ce_source_file = own_src.file;
                ce_source_start = own_src.start;
                ce_source_len = own_src.len;
            }
            vi = vi + 1;
        }
        if ce_violation.len() == 0 {
            let assert_description: String = parse_assert_label(vr.raw_output);
            if assert_description.len() > 0 {
                ce_violation = assert_description;
            } else {
                ce_violation = String::from("internal verifier assertion failed");
            }
        }
    }
    VerifyCE {
        function: ce_function,
        target_function: f.name,
        var_names: vr.var_names,
        var_values: vr.var_values,
        violation: ce_violation,
        vow_id: public_vow_id,
        source: ce_source_file,
        source_start: ce_source_start,
        source_len: ce_source_len,
        blame: ce_blame,
        call_site_functions: call_site_functions,
        call_site_files: call_site_files,
        call_site_offsets: call_site_offsets,
        call_site_lengths: call_site_lengths,
        violating_arg_params: violating_arg_params,
        violating_arg_values: violating_arg_values,
        violating_arg_offsets: violating_arg_offsets,
        violating_arg_lengths: violating_arg_lengths,
        replay: String::from(""),
        replay_reason: String::from(""),
    }
}

// ---------------------------------------------------------------------------
// Counterexample replay (--replay-cex, issue #335)
//
// Differential test of the verifier model against runtime semantics: after a
// counterexample, build a `--mode debug` harness that calls the failing
// function with the counterexample's concrete inputs and check the runtime
// VowViolation agrees (same vow_id + blame). NOT part of the proof.
//
// Under `--backend native`, abort-claim counterexamples (zero divisor, signed
// MIN / -1) replay too and are confirmed by an ArithmeticOverflow abort; a
// diverged or aborted replay is reported as a VerifierBug diagnostic.
//
// Self-hosted v1 scope: scalar params (i64/u64/bool). Aggregate params or a
// Unit param are reported as `skipped` with a reason (the Rust compiler
// additionally reconstructs bounded Vecs). An entry file that already defines
// `main` replays too: that definition is renamed out of the harness.
// ---------------------------------------------------------------------------

struct ReplayVerdict {
    status: String,
    reason: String,
}

struct ReplayScan {
    violation_line: String,
    abort_kind: String,
}

// 128 + SIGABRT: the runtime's reserved abort exit status (docs/spec/errors.md
// "Exit status"). Gate abort classification on this, not any nonzero code, so
// an unrelated nonzero exit that happens to print an error-shaped line to
// stderr isn't misclassified as a runtime abort.
const RUNTIME_ABORT_EXIT_CODE: i64 = 134;

fn replay_blame_runtime_name(b: i64) -> String {
    if b == DIAG_BLAME_CALLER() { return String::from("Caller"); }
    if b == DIAG_BLAME_CALLEE() { return String::from("Callee"); }
    String::from("None")
}

fn replay_ty_name(ty: i64) -> String {
    if ty == ITY_I64() { return String::from("i64"); }
    if ty == ITY_U64() { return String::from("u64"); }
    if ty == ITY_BOOL() { return String::from("bool"); }
    String::from("")
}

fn replay_effects_suffix(effects: i64) -> String {
    // Canonical (alphabetical) effect order, per CLAUDE.md, so the synthesized
    // `fn main()` annotation matches the printer/type-checker's expected form.
    let parts: Vec<String> = Vec::new();
    if (effects & EFF_IO()) != 0 { parts.push(String::from("io")); }
    if (effects & EFF_PANIC()) != 0 { parts.push(String::from("panic")); }
    if (effects & EFF_READ()) != 0 { parts.push(String::from("read")); }
    if (effects & EFF_UNSAFE()) != 0 { parts.push(String::from("unsafe")); }
    if (effects & EFF_WRITE()) != 0 { parts.push(String::from("write")); }
    if parts.len() == 0 { return String::from(""); }
    let s: String = String::from(" [");
    let mut i: u64 = 0;
    while i < parts.len() {
        if i > 0 { s.push_str(String::from(", ")); }
        s.push_str(parts[i]);
        i = i + 1;
    }
    s.push_str(String::from("]"));
    s
}

// True if `s` is a plain decimal integer literal (optional leading `-`).
fn replay_is_int_literal(s: String) -> bool {
    let n: u64 = s.len();
    if n == 0 { return false; }
    let mut i: u64 = 0;
    if s.byte_at(0) == 45 {
        if n == 1 { return false; }
        i = 1;
    }
    while i < n {
        let b: i64 = s.byte_at(i);
        if b < 48 || b > 57 { return false; }
        i = i + 1;
    }
    true
}

// Render an ESBMC scalar value as a Vow literal for `ty`, or "" if not
// renderable in v1.
fn replay_render_scalar(ty: i64, raw: String) -> String {
    if ty == ITY_BOOL() {
        if raw == String::from("0") || raw == String::from("false") || raw == String::from("FALSE") {
            return String::from("false");
        }
        return String::from("true");
    }
    if replay_is_int_literal(raw) { return raw; }
    String::from("")
}

// Counterexample value for source name `name`, or "" if absent.
fn replay_value_for(name: String, names: Vec<String>, vals: Vec<String>) -> String {
    let mut i: u64 = 0;
    while i < names.len() {
        if names[i] == name { return vals[i]; }
        i = i + 1;
    }
    String::from("")
}

fn replay_find_fn(fns: Vec<IrFunction>, name: String) -> i64 {
    let mut i: i64 = 0;
    while i < fns.len() as i64 {
        let f: IrFunction = fns[i as u64];
        if f.name == name { return i; }
        i = i + 1;
    }
    -1
}

// Directory prefix of `path` (with trailing slash), or "./" if it has none.
fn replay_dir_of(path: String) -> String {
    match str_rfind_byte(path, 47) {
        Option::None => String::from("./"),
        Option::Some(k) => path.substring(0, k + 1u64),
    }
}

fn replay_skip(reason: String) -> ReplayVerdict {
    ReplayVerdict { status: String::from("skipped"), reason: reason }
}

fn replay_diverge(reason: String) -> ReplayVerdict {
    ReplayVerdict { status: String::from("diverged"), reason: reason }
}

fn replay_abort(reason: String) -> ReplayVerdict {
    ReplayVerdict { status: String::from("aborted"), reason: reason }
}

fn replay_confirm() -> ReplayVerdict {
    ReplayVerdict { status: String::from("confirmed"), reason: String::from("") }
}

fn replay_one_ce(ce: VerifyCE, fns: Vec<IrFunction>, path: String, main_start: i64, argv0: String, abort_claims: bool) -> ReplayVerdict [io, read, write] {
    if ce.function == String::from("main") {
        return replay_skip(String::from("cannot replay the entry function `main`"));
    }
    // Synthetic verifier-only ids never match a runtime-emitted vow_id, so an
    // exact id comparison would always diverge — skip them. The exception is
    // the native backend's unattributed id, which marks the language-specified
    // aborts (zero divisor, signed MIN / -1, unwrap on None) and replays.
    let abort_claim: bool = abort_claims && ce.vow_id == verifier_unattributed_vow_id();
    if abort_claim && ce.violation == describe_assert_label(String::from("integer shift count")) {
        return replay_skip(String::from("replay: a shift-count counterexample is a verifier obligation; the runtime masks the count (8-bit shifts excepted)"));
    }
    if abort_claim && replay_predicted_abort(ce.violation).len() == 0 {
        return replay_skip(String::from("replay: no runtime abort is predicted for this obligation"));
    }
    if !abort_claim && (ce.vow_id == caller_precondition_vow_id() || ce.vow_id == unsupported_op_vow_id() || ce.vow_id == verifier_unattributed_vow_id()) {
        return replay_skip(String::from("replay: synthetic counterexample id (caller-precondition / unsupported-op / unattributed-property sentinel)"));
    }
    if ce.function != ce.target_function {
        return replay_skip(String::from("replay: counterexample belongs to a co-emitted callee; its inputs are the caller's"));
    }
    let fi: i64 = replay_find_fn(fns, ce.function);
    if fi < 0 {
        return replay_skip(str3(String::from("no IR for function `"), ce.function, String::from("`")));
    }
    let f: IrFunction = fns[fi as u64];
    let src: String = fs_read(path);
    if src.len() == 0 {
        return replay_skip(String::from("replay: could not read source"));
    }
    let mut base: String = src;
    if main_start >= 0 {
        base = replay_rename_main(src, main_start);
        if base.len() == 0 {
            return replay_skip(String::from("replay: could not locate the entry file's main"));
        }
    }

    let params: Vec<i64> = f.params;
    let pnames: Vec<String> = f.param_names;
    let np: i64 = params.len() as i64;
    let body: String = String::from("");
    let call_args: String = String::from("");
    let mut pi: i64 = 0;
    while pi < np {
        let ty: i64 = params[pi as u64];
        if ty == ITY_UNIT() {
            return replay_skip(String::from("function has a Unit parameter"));
        }
        if ty != ITY_I64() && ty != ITY_U64() && ty != ITY_BOOL() {
            return replay_skip(str3(String::from("parameter "), i64_to_string(pi), String::from(": unsupported type (self-hosted v1: scalars only)")));
        }
        let pname: String = pnames[pi as u64];
        let raw: String = replay_value_for(pname, ce.var_names, ce.var_values);
        if raw.len() == 0 {
            return replay_skip(str3(String::from("parameter "), pname, String::from(": no counterexample value")));
        }
        let lit: String = replay_render_scalar(ty, raw);
        if lit.len() == 0 {
            return replay_skip(str3(String::from("parameter "), pname, String::from(": value not renderable as a literal")));
        }
        let aname: String = str2(String::from("__replay_a"), i64_to_string(pi));
        body.push_str(String::from("    let "));
        body.push_str(aname);
        body.push_str(String::from(": "));
        body.push_str(replay_ty_name(ty));
        body.push_str(String::from(" = "));
        body.push_str(lit);
        body.push_str(String::from(";\n"));
        if pi > 0 { call_args.push_str(String::from(", ")); }
        call_args.push_str(aname);
        pi = pi + 1;
    }
    body.push_str(String::from("    "));
    body.push_str(ce.function);
    body.push_str(String::from("("));
    body.push_str(call_args);
    body.push_str(String::from(");\n"));

    let harness: String = base;
    harness.push_str(String::from("\n\nfn main()"));
    harness.push_str(replay_effects_suffix(f.effects));
    harness.push_str(String::from(" {\n"));
    harness.push_str(body);
    harness.push_str(String::from("}\n"));

    let dir: String = replay_dir_of(path);
    // Tag by function + vow_id so two functions sharing a (per-function-local)
    // vow_id do not collide within one run.
    let tag: String = str4(String::from("__vow_replay_"), ce.function, String::from("_"), i64_to_string(ce.vow_id));
    let harness_path: String = str3(dir, tag, String::from(".vow"));
    let bin_path: String = str2(dir, tag);
    let oext: String = str2(bin_path, String::from(".o"));

    // Never overwrite an existing file in the source tree — a collision with a
    // user file would otherwise be silently clobbered and then deleted.
    if fs_exists(harness_path) != 0 || fs_exists(bin_path) != 0 {
        return replay_skip(String::from("replay: temp path already exists; not overwriting"));
    }

    if fs_write(harness_path, harness) != 0 {
        return replay_skip(String::from("replay: could not write harness"));
    }

    let bargs: Vec<String> = Vec::new();
    bargs.push(String::from("build"));
    bargs.push(String::from("--no-verify"));
    bargs.push(String::from("--mode"));
    bargs.push(String::from("debug"));
    bargs.push(harness_path);
    bargs.push(String::from("-o"));
    bargs.push(bin_path);
    let brc: i64 = process_run(argv0, bargs);

    if brc != 0 {
        fs_remove(harness_path);
        fs_remove(bin_path);
        fs_remove(oext);
        return replay_skip(String::from("replay: harness did not compile"));
    }

    // Run the harness with a bounded timeout: a replayed function could loop
    // forever (the very drift being tested), and an unbounded wait would hang
    // `verify --replay-cex` instead of returning the original VerifyFailed JSON.
    let runargs: Vec<String> = Vec::new();
    let pid: i64 = process_start(bin_path, runargs);
    if pid < 0 {
        fs_remove(harness_path);
        fs_remove(bin_path);
        fs_remove(oext);
        return replay_skip(String::from("replay: harness failed to start"));
    }
    let rrc: i64 = process_wait_timeout(pid, 10000);
    let timed_out: bool = rrc == -2;
    let err: String = {
        if timed_out {
            process_kill(pid);
            String::from("")
        } else {
            process_stderr_for(pid)
        }
    };

    fs_remove(harness_path);
    fs_remove(bin_path);
    fs_remove(oext);

    if timed_out {
        return replay_skip(String::from("replay: harness timed out"));
    }

    // Confirm only if a SINGLE VowViolation line carries both the predicted
    // vow_id and blame — a substring scan over all of stderr could otherwise
    // splice a vow_id and blame from two different lines into a false confirm.
    // `__vow_violation` always exits with the reserved abort status, so a
    // genuine violation is exit-134 too; gating on it here closes the same
    // false-match surface the abort branch below guards against (a debug
    // write that coalesces a VowViolation-shaped substring onto its line).
    let scan: ReplayScan = replay_scan_stderr(err);
    if abort_claim {
        return replay_abort_claim_verdict(scan, rrc, replay_predicted_abort(ce.violation));
    }
    let viol: String = scan.violation_line;
    let vowid_needle: String = str3(String::from("\"vow_id\":"), i64_to_string(ce.vow_id), String::from(","));
    let blame_needle: String = str3(String::from("\"blame\":\""), replay_blame_runtime_name(ce.blame), String::from("\""));
    if viol.len() > 0 && rrc == RUNTIME_ABORT_EXIT_CODE {
        if viol.contains(vowid_needle) && viol.contains(blame_needle) {
            return replay_confirm();
        }
        return replay_diverge(String::from("runtime violation did not match predicted vow_id/blame"));
    }
    if scan.abort_kind.len() > 0 && rrc == RUNTIME_ABORT_EXIT_CODE {
        let reason: String = String::from("runtime aborted with ");
        reason.push_str(scan.abort_kind);
        reason.push_str(String::from(" before reaching predicted VowViolation vow_id="));
        reason.push_str(i64_to_string(ce.vow_id));
        reason.push_str(String::from(" blame="));
        reason.push_str(replay_blame_runtime_name(ce.blame));
        return replay_abort(reason);
    }
    if rrc == 0 {
        return replay_diverge(String::from("harness exited cleanly; no VowViolation fired at runtime"));
    }
    replay_diverge(String::from("runtime violation did not match predicted vow_id/blame"))
}

// A native counterexample whose replay ran and disagreed means the model and
// the runtime differ: a verifier bug. A `skipped` replay never ran, so it
// proves nothing and is not reported.
fn report_verifier_bug_ces(dctx: DiagCtx, ces: Vec<VerifyCE>) [io] {
    let mut i: u64 = 0;
    while i < ces.len() {
        let ce: VerifyCE = ces[i];
        if ce.replay == String::from("diverged") || ce.replay == String::from("aborted") {
            let msg: String = str5(String::from("native verifier counterexample for `"), ce.function, String::from("` did not replay ("), ce.replay, String::from(": "));
            msg.push_str(ce.replay_reason);
            msg.push_str(String::from(")"));
            let d: Diagnostic = diag_new(SEV_ERROR(), EC_VERIFIER_BUG(), msg, ce.source, ce.source_start, ce.source_len, DIAG_BLAME_NONE());
            diag_add_hint(d, String::from("a counterexample that does not reproduce at runtime is a bug in the verifier model; report it"));
            diag_ctx_emit(dctx, d);
        }
        i = i + 1;
    }
}

// The abort a native abort-claim counterexample predicts: `UnwrapOnNone` for the
// unwrap claim, `ArithmeticOverflow` for the division and remainder claims, and
// "" for any other obligation, which has no runtime abort to confirm.
fn replay_predicted_abort(violation: String) -> String {
    if violation == describe_assert_label(String::from("unwrap-none")) {
        return String::from("UnwrapOnNone");
    }
    if violation == describe_assert_label(String::from("division by zero"))
        || violation == describe_assert_label(String::from("division overflow")) {
        return String::from("ArithmeticOverflow");
    }
    String::from("")
}

// Verdict for a native abort-claim counterexample: the predicted outcome is the
// runtime's abort of kind `predicted` (one `ArithmeticOverflow` envelope covers
// a zero divisor and signed MIN / -1, so it confirms the kind of failure, not
// the operation).
fn replay_abort_claim_verdict(scan: ReplayScan, rrc: i64, predicted: String) -> ReplayVerdict {
    if rrc == RUNTIME_ABORT_EXIT_CODE && scan.abort_kind == predicted {
        return replay_confirm();
    }
    if rrc == 0 {
        return replay_diverge(str3(String::from("harness exited cleanly; the predicted "), predicted, String::from(" abort did not occur")));
    }
    if rrc == RUNTIME_ABORT_EXIT_CODE && scan.abort_kind.len() > 0 {
        return replay_abort(str4(String::from("runtime aborted with "), scan.abort_kind, String::from(" instead of the predicted "), predicted));
    }
    if rrc == RUNTIME_ABORT_EXIT_CODE && scan.violation_line.len() > 0 {
        return replay_diverge(str2(String::from("runtime fired a VowViolation (a contract was violated by the counterexample inputs) instead of the predicted "), predicted));
    }
    replay_diverge(str2(String::from("runtime did not abort with the predicted "), predicted))
}

// Scans stderr once for both the VowViolation marker (confirm/diverge) and a
// structured non-VowViolation abort marker (a runtime abort that preempted
// the predicted VowViolation), so replay_one_ce doesn't walk stderr twice.
// Classification is keyed off the LAST envelope-bearing line overall (each
// line's own kind picked via its LAST `"error":"<kind>"` occurrence, mirroring
// the Rust replay path's right-to-left envelope scan): nothing runs after the
// runtime writes its final envelope and aborts, so the last matching line —
// violation or abort — is the event that actually terminated the run, and an
// earlier line whose debug output happens to look like an envelope must not
// take precedence over it. Every match overwrites both fields so only the
// winning line's classification survives.
fn replay_scan_stderr(err: String) -> ReplayScan {
    let n: u64 = err.len();
    let mut start: u64 = 0;
    let mut i: u64 = 0;
    let mut violation_line: String = String::from("");
    let mut abort_kind: String = String::from("");
    while i <= n {
        if i == n || err.byte_at(i) == 10 {
            let line: String = err.substring(start, i);
            let kind: String = replay_last_error_kind_in_line(line);
            if kind == String::from("VowViolation") {
                violation_line = line;
                abort_kind = String::from("");
            } else if kind.len() > 0 {
                abort_kind = kind;
                violation_line = String::from("");
            }
            start = i + 1;
        }
        i = i + 1;
    }
    ReplayScan { violation_line: violation_line, abort_kind: abort_kind }
}

// Extract the kind from the LAST `{"error":"<Kind>"}` marker in one stderr
// line (rightmost wins), or "" if the line has none. The kind may be
// "VowViolation" — the caller decides what that means for this line.
fn replay_last_error_kind_in_line(line: String) -> String {
    let marker: String = String::from("{\"error\":\"");
    let n: u64 = line.len();
    let m: u64 = marker.len();
    let mut i: u64 = 0;
    let mut found: String = String::from("");
    while i + m <= n {
        let mut matched: bool = true;
        let mut j: u64 = 0;
        while j < m {
            if line.byte_at(i + j) != marker.byte_at(j) {
                matched = false;
                break;
            }
            j = j + 1;
        }
        if matched {
            let start: u64 = i + m;
            let mut end: u64 = start;
            while end < n && line.byte_at(end) != 34 {
                end = end + 1;
            }
            if end > start {
                found = line.substring(start, end);
            }
        }
        i = i + 1;
    }
    found
}

// Offset of the entry file's own `main`, computed once per run and only when
// replay is requested; -1 when there is none or replay is off.
fn replay_main_start(argv: Vec<String>, fr: LoweredFrontend, path: String) -> i64 {
    if !has_flag(argv, "--replay-cex") { return -1; }
    replay_entry_main_start(fr.merged, fr.item_files, path)
}

fn replay_all(ces: Vec<VerifyCE>, fns: Vec<IrFunction>, path: String, main_start: i64, argv0: String, abort_claims: bool) -> Vec<VerifyCE> [io, read, write] {
    let out: Vec<VerifyCE> = Vec::new();
    let mut i: u64 = 0;
    while i < ces.len() {
        let ce: VerifyCE = ces[i];
        let v: ReplayVerdict = replay_one_ce(ce, fns, path, main_start, argv0, abort_claims);
        let reason: String = {
            if v.status == String::from("confirmed") { String::from("") }
            else { v.reason }
        };
        out.push(VerifyCE {
            function: ce.function,
            target_function: ce.target_function,
            var_names: ce.var_names,
            var_values: ce.var_values,
            violation: ce.violation,
            vow_id: ce.vow_id,
            source: ce.source,
            source_start: ce.source_start,
            source_len: ce.source_len,
            blame: ce.blame,
            call_site_functions: ce.call_site_functions,
            call_site_files: ce.call_site_files,
            call_site_offsets: ce.call_site_offsets,
            call_site_lengths: ce.call_site_lengths,
            violating_arg_params: ce.violating_arg_params,
            violating_arg_values: ce.violating_arg_values,
            violating_arg_offsets: ce.violating_arg_offsets,
            violating_arg_lengths: ce.violating_arg_lengths,
            replay: v.status,
            replay_reason: reason,
        });
        i = i + 1;
    }
    out
}

fn emit_ce_vars(vr: VerifyResult) [io] {
    let vnames: Vec<String> = vr.var_names;
    let vvals: Vec<String> = vr.var_values;
    let mut vi: u64 = 0;
    while vi < vnames.len() {
        diag_eprintln_best_effort(str4(String::from("    "), vnames[vi], String::from(" = "), vvals[vi]));
        vi = vi + 1;
    }
}

// Skip non-modelable vowed functions before ESBMC runs; otherwise the C emitter emits __ESBMC_assert(0) traps and the build fails closed.
fn skip_if_non_modelable(f: IrFunction, ir_mod: IrModule, const_fn_indices: Vec<i64>, dctx: DiagCtx) -> bool [io] {
    let reason: String = non_modelable_reason(f, ir_mod, const_fn_indices);
    if reason.len() == 0 {
        return false;
    }
    diag_eprintln_best_effort(str3(String::from("  "), f.name, String::from(": SKIPPED (non-modelable in verifier)")));
    let msg: String = str3(
        String::from("skipped verification of `"),
        f.name,
        str2(String::from("`: "), reason),
    );
    let d: Diagnostic = diag_new(SEV_WARNING(), EC_VERIFICATION_SKIPPED(), msg, String::from(""), 0, 0, DIAG_BLAME_NONE());
    diag_add_hint(d, String::from("the contract is documentary; runtime checks still apply in --mode debug"));
    diag_ctx_emit(dctx, d);
    true
}

// Returns 0=Verified, 1=VerifyFailed, 2=Skipped (both 1 and 2 exit 1).
fn run_verify_loop(esbmc_bin: String, fns: Vec<IrFunction>, ir_mod: IrModule, const_fn_indices: Vec<i64>, dctx: DiagCtx, path: String, ces: Vec<VerifyCE>, soft_meta: Vec<String>, max_k_step: String, use_cache: bool, solver: String, encoding: String, timeout_secs: String,
                   vec_max: i64, string_max: i64, hashmap_max: i64, btreemap_max: i64, jobs: i64) -> i64 [io, write] {
    run_verify_loop_traced(esbmc_bin, fns, ir_mod, const_fn_indices, dctx, path, ces, soft_meta, max_k_step, use_cache, solver, encoding, timeout_secs, vec_max, string_max, hashmap_max, btreemap_max, jobs, trace_off())
}

// Collect one ESBMC result and record its proof span + compiler->esbmc flow
// arrow (issue #784). `verify_origin` is the verification-driver handoff origin;
// `fi` is the function index used as the flow id. A no-op for tracing when `t`
// is disabled. Returns the proven flag from verify_collect_and_report.
fn verify_collect_traced(esbmc_bin: String, t: TraceCtx, verify_origin: i64, h: i64, tmp: String, f: IrFunction, fi: i64, ir_mod: IrModule, path: String, ces: Vec<VerifyCE>, soft_meta: Vec<String>, max_k_step: String, use_cache: bool, solver: String, encoding: String, timeout_secs: String,
                         vec_max: i64, string_max: i64, hashmap_max: i64, btreemap_max: i64, model_bounds: Vec<String>, dctx: DiagCtx) -> i64 [io, write] {
    let proof_start: i64 = trace_now(t);
    trace_flow(t, String::from("verify->esbmc"), PID_COMPILER(), TID_VERIFY_DRIVER(), verify_origin, fi, TRACE_FLOW_START());
    trace_flow(t, String::from("verify->esbmc"), PID_COMPILER(), TID_VERIFY_DRIVER(), proof_start, fi, TRACE_FLOW_END());
    let mut proven: i64 = verify_collect_and_report(esbmc_bin, h, tmp, f, ir_mod, path, ces, soft_meta, max_k_step, use_cache, solver, encoding, timeout_secs, vec_max, string_max, hashmap_max, btreemap_max, t, dctx);
    if proven == 0 && demote_undecided_caller(f, ir_mod, soft_meta, dctx) {
        proven = 1;
        model_bounds[fi as u64] = String::from("");
    }
    trace_span(t, str2(String::from("esbmc:"), f.name), PID_COMPILER(), TID_VERIFY_DRIVER(), proof_start, trace_now(t) - proof_start, f.name);
    proven
}

// Returns 0=Verified, 1=VerifyFailed, 2=Skipped (both 1 and 2 exit 1).
fn run_verify_loop_traced(esbmc_bin: String, fns: Vec<IrFunction>, ir_mod: IrModule, const_fn_indices: Vec<i64>, dctx: DiagCtx, path: String, ces: Vec<VerifyCE>, soft_meta: Vec<String>, max_k_step: String, use_cache: bool, solver: String, encoding: String, timeout_secs: String,
                   vec_max: i64, string_max: i64, hashmap_max: i64, btreemap_max: i64, jobs: i64, t: TraceCtx) -> i64 [io, write] {
    let mut all_proven: i64 = 1;
    let mut any_skipped: i64 = 0;
    let verify_origin: i64 = trace_now(t);
    // Bounded pool: ≤ jobs ESBMC processes in flight, FIFO drain. See #175.
    let in_flight_h: Vec<i64> = Vec::new();
    let in_flight_fi: Vec<i64> = Vec::new();
    let in_flight_tmp: Vec<String> = Vec::new();
    let model_bounds: Vec<String> = model_bounds_table(fns.len() as i64);
    let mut fi: i64 = 0;
    while fi < fns.len() as i64 {
        let f: IrFunction = fns[fi as u64];
        // Stop launching new ESBMC jobs once any in-flight verification has failed.
        if all_proven == 1 && is_verify_target(f, ir_mod, const_fn_indices) {
            while in_flight_h.len() as i64 >= jobs {
                let oldest_h: i64 = in_flight_h[0];
                let oldest_fi: i64 = in_flight_fi[0];
                let oldest_tmp: String = in_flight_tmp[0];
                let oldest_f: IrFunction = fns[oldest_fi as u64];
                vec_i64_remove_front(in_flight_h);
                vec_i64_remove_front(in_flight_fi);
                vec_string_remove_front(in_flight_tmp);
                let proven: i64 = verify_collect_traced(esbmc_bin, t, verify_origin, oldest_h, oldest_tmp, oldest_f, oldest_fi, ir_mod, path, ces, soft_meta, max_k_step, use_cache, solver, encoding, timeout_secs, vec_max, string_max, hashmap_max, btreemap_max, model_bounds, dctx);
                if proven == 0 {
                    all_proven = 0;
                }
            }
            if all_proven == 1 {
                if skip_if_non_modelable(f, ir_mod, const_fn_indices, dctx) {
                    // Fail closed: a non-modelable function is not statically proved.
                    any_skipped = 1;
                } else {
                    diag_eprintln_best_effort(str3(String::from("Verifying "), f.name, String::from("...")));
                    let started: EsbmcStart = verify_start(esbmc_bin, f, ir_mod, max_k_step, fi, use_cache, solver, encoding, timeout_secs, vec_max, string_max, hashmap_max, btreemap_max);
                    model_bounds[fi as u64] = started.bounds;
                    in_flight_h.push(started.handle);
                    in_flight_fi.push(fi);
                    in_flight_tmp.push(started.tmp_path);
                }
            }
        }
        fi = fi + 1;
    }
    while in_flight_h.len() > 0 {
        let oldest_h: i64 = in_flight_h[0];
        let oldest_fi: i64 = in_flight_fi[0];
        let oldest_tmp: String = in_flight_tmp[0];
        let oldest_f: IrFunction = fns[oldest_fi as u64];
        vec_i64_remove_front(in_flight_h);
        vec_i64_remove_front(in_flight_fi);
        vec_string_remove_front(in_flight_tmp);
        let proven: i64 = verify_collect_traced(esbmc_bin, t, verify_origin, oldest_h, oldest_tmp, oldest_f, oldest_fi, ir_mod, path, ces, soft_meta, max_k_step, use_cache, solver, encoding, timeout_secs, vec_max, string_max, hashmap_max, btreemap_max, model_bounds, dctx);
        if proven == 0 {
            all_proven = 0;
        }
    }
    if all_proven == 0 {
        report_unchecked_calls(fns, ir_mod, const_fn_indices, dctx);
        return 1;
    }
    if any_skipped == 1 {
        report_unchecked_calls(fns, ir_mod, const_fn_indices, dctx);
        return 2;
    }
    report_capacity_notes(fns, model_bounds, dctx);
    report_unchecked_calls(fns, ir_mod, const_fn_indices, dctx);
    0
}

fn emit_ir_warnings(ir_mod: IrModule, dctx: DiagCtx) [io] {
    let ws: Vec<String> = ir_mod.warnings;
    let mut i: u64 = 0;
    while i < ws.len() {
        let d: Diagnostic = diag_new(SEV_WARNING(), EC_LOWERING_WARNING(), ws[i], String::from(""), 0, 0, DIAG_BLAME_NONE());
        diag_ctx_emit(dctx, d);
        diag_eprintln_best_effort(ws[i]);
        i = i + 1;
    }
}

fn resolve_verify_jobs(argv: Vec<String>) -> i64 [io] {
    let raw: String = get_flag_arg(argv, "--verify-jobs");
    if raw.len() == 0 {
        let n: i64 = num_cpus() / 2;
        if n < 1 { 1 } else { n }
    } else {
        let n: i64 = match parse_i64(raw) {
            Option::Some(value) => { value },
            Option::None => { 0 },
        };
        if n < 1 {
            diag_eprintln_best_effort(String::from("error: --verify-jobs must be >= 1"));
            process_exit(1);
            1
        } else {
            n
        }
    }
}

// Concurrent test files for `vowc test`. An explicit --jobs wins; otherwise
// half the CPUs capped at 8, or 1 under --verify (ESBMC already parallelizes).
fn resolve_test_jobs(argv: Vec<String>, do_verify: bool) -> i64 [io] {
    let raw: String = get_flag_arg(argv, "--jobs");
    if raw.len() == 0 {
        if do_verify { return 1; }
        let n: i64 = num_cpus() / 2;
        if n < 1 { return 1; }
        if n > 8 { return 8; }
        return n;
    }
    let n: i64 = match parse_i64(raw) {
        Option::Some(value) => { value },
        Option::None => { 0 },
    };
    if n < 1 {
        diag_eprintln_best_effort(String::from("error: --jobs must be >= 1"));
        process_exit(1);
    }
    n
}

fn push_test_flag_value(a: Vec<String>, argv: Vec<String>, flag: String) {
    let v: String = get_flag_arg(argv, flag);
    if v.len() > 0 {
        a.push(flag);
        a.push(v);
    }
}

// Flags a parallel `vowc test` worker inherits from its parent invocation.
fn test_worker_common_flags(argv: Vec<String>) -> Vec<String> {
    let a: Vec<String> = Vec::new();
    push_test_flag_value(a, argv, String::from("--mode"));
    push_test_flag_value(a, argv, String::from("--timeout"));
    push_test_flag_value(a, argv, String::from("--max-k-step"));
    push_test_flag_value(a, argv, String::from("--verify-jobs"));
    if has_flag(argv, String::from("--verify")) {
        a.push(String::from("--verify"));
    }
    a
}

fn vec_i64_remove_front(v: Vec<i64>) {
    // Caller-enforced invariant: v.len() > 0 (drain loops guard this).
    // Guard defensively so an empty Vec becomes a no-op rather than popping below zero.
    let n: u64 = v.len();
    if n == 0 { return; }
    let mut i: u64 = 0;
    while i < n - 1 {
        v[i] = v[i + 1];
        i = i + 1;
    }
    v.pop();
}

fn vec_string_remove_front(v: Vec<String>) {
    let n: u64 = v.len();
    if n == 0 { return; }
    let mut i: u64 = 0;
    while i < n - 1 {
        v[i] = v[i + 1];
        i = i + 1;
    }
    v.pop();
}

// Record the first soft-fail ESBMC outcome (status/message/function) into `meta`.
// Convention: meta is `[]` until the first soft-fail, then `[status, message, function]`.
// The function name is needed to populate the schema-required top-level
// `function` field on VerifyFailed JSON output.
fn record_soft_fail(meta: Vec<String>, status: String, message: String, function: String) {
    if meta.len() == 0 {
        meta.push(status);
        meta.push(message);
        meta.push(function);
    }
}

// Compute (function, counterexample) for the VerifyFailed top-level JSON fields.
// Precondition: status is VerifyFailed (i.e. ces non-empty OR soft_meta has 3 entries).
// Mirrors Rust's BuildStatus::VerifyFailed { function, description } shape.
fn verify_function_index(fns: Vec<IrFunction>, name: String) -> i64 {
    let mut i: i64 = 0;
    while i < fns.len() as i64 {
        let f: IrFunction = fns[i as u64];
        if f.name == name {
            return i;
        }
        i = i + 1;
    }
    9223372036854775807
}

fn vf_prefers_counterexample(ces: Vec<VerifyCE>, soft_meta: Vec<String>, fns: Vec<IrFunction>) -> bool {
    if ces.len() == 0 {
        return false;
    }
    if soft_meta.len() < 3 {
        return true;
    }
    let ce: VerifyCE = ces[0];
    let ce_idx: i64 = verify_function_index(fns, ce.target_function);
    let soft_idx: i64 = verify_function_index(fns, soft_meta[2]);
    ce_idx <= soft_idx
}

fn vf_legacy_fields(ces: Vec<VerifyCE>, soft_meta: Vec<String>, fns: Vec<IrFunction>) -> Vec<String> {
    let result: Vec<String> = Vec::new();
    if vf_prefers_counterexample(ces, soft_meta, fns) {
        let ce: VerifyCE = ces[0];
        result.push(ce.target_function);
        result.push(String::from("[Counterexample]"));
        return result;
    }
    if soft_meta.len() >= 3 {
        let status: String = soft_meta[0];
        let message: String = soft_meta[1];
        let func: String = soft_meta[2];
        result.push(func);
        let desc: String = String::from("");
        if status == String::from("timeout") {
            desc.push_str(String::from("verification timed out"));
        } else if status == String::from("unknown") {
            desc.push_str(String::from("verification result unknown: "));
            desc.push_str(message);
        } else if status == String::from("error") {
            desc.push_str(String::from("esbmc error: "));
            desc.push_str(message);
        } else if status == String::from("tool_not_found") {
            if message.len() > 0 {
                desc.push_str(message);
            } else {
                desc.push_str(String::from("ESBMC not found"));
            }
        } else {
            desc.push_str(message);
        }
        result.push(desc);
        return result;
    }
    result
}

// Report a checked operator whose ArithmeticOverflow abort ESBMC proved
// reachable (#585). A Warning, not a failure: aborting is the operator's
// specified behaviour, and the contract is still proved for every returning
// execution. Mirrors `VerifyWarning::ArithOverflow`'s diagnostic in the Rust
// driver, which `compare_json` holds byte-identical.
// Attribute the warning to the function the operator actually lives in, which is
// not always the verify target: a model co-emits its modelable callees, so
// verifying `caller` can surface a site inside `helper`. Naming the target would
// report checked arithmetic in a function that contains none, and — because
// spans are file-relative — point the offset into the wrong file once the callee
// comes from another module. Falls back to the target when the id resolves to
// nothing. Mirrors `arith_overflow_warning` in the Rust driver.
fn arith_owner_index(m: IrModule, owner_id: i64) -> i64 {
    let fns: Vec<IrFunction> = m.functions;
    let mut i: i64 = 0;
    while i < fns.len() as i64 {
        let f: IrFunction = fns[i as u64];
        if f.id == owner_id { return i; }
        i = i + 1;
    }
    -1
}

// True when an identical ArithOverflowReachable diagnostic is already recorded.
// Compared on rendered identity — same place, same owning function via the
// message — so the several verify targets that share one site collapse to one.
fn arith_already_reported(dctx: DiagCtx, owner_name: String, file: String, ostart: i64, olen: i64) -> bool {
    let ds: Vec<Diagnostic> = dctx.diags;
    let needle: String = str3(String::from("checked arithmetic in `"), owner_name, String::from("` can abort"));
    let mut i: u64 = 0;
    while i < ds.len() {
        let d: Diagnostic = ds[i];
        if d.code == EC_ARITH_OVERFLOW_REACHABLE() && d.span_start == ostart &&
           d.span_len == olen && d.file == file && str_starts_with(d.message, needle) {
            return true;
        }
        i = i + 1;
    }
    false
}

fn report_arith_overflow(f: IrFunction, ir_mod: IrModule, path: String, site: ParsedArithSite, dctx: DiagCtx) [io] {
    let idx: i64 = arith_owner_index(ir_mod, site.owner);
    let fns: Vec<IrFunction> = ir_mod.functions;
    let owner_name: String = if idx >= 0 { let o: IrFunction = fns[idx as u64]; o.name } else { f.name };
    let owner_src: String = if idx >= 0 { let o2: IrFunction = fns[idx as u64]; o2.source_file } else { String::from("") };
    // A function's own source_file is authoritative under multi-module
    // compilation; `path` is only the entry path the CLI was given.
    let owner_file: String = if owner_src.len() > 0 { owner_src } else { path };
    diag_eprintln_best_effort(str3(String::from("  "), owner_name, String::from(": PROVEN (checked arithmetic can abort)")));
    let msg: String = str3(
        String::from("checked arithmetic in `"),
        owner_name,
        str2(String::from("` can abort: "), arith_cause_description(site.cause)),
    );
    // One site can be reported by several verify targets — a model co-emits its
    // modelable callees, so a site in `helper` surfaces both when verifying
    // `helper` and when verifying every contracted caller of it. Attributed to
    // the same owner they are the same diagnostic, so report it once. Mirrors
    // `dedup_warnings` in the Rust driver, which `compare_json` holds to the
    // same diagnostic count.
    if arith_already_reported(dctx, owner_name, owner_file, site.ostart, site.olen) {
        return;
    }
    let d: Diagnostic = diag_new(SEV_WARNING(), EC_ARITH_OVERFLOW_REACHABLE(), msg, owner_file, site.ostart, site.olen, DIAG_BLAME_NONE());
    diag_add_hint(d, String::from("the contract is proved for every execution that returns; this abort is a separate runtime outcome"));
    diag_add_hint(d, String::from("constrain the operands in `requires` to rule the abort out, or use the wrapping operator if wrapping is intended"));
    diag_ctx_emit(dctx, d);
}

// One zeroed-out model-bounds slot per function: `bounds[fi]` is "" until
// `verify_start` reports the bounds of the model it sent to ESBMC.
fn model_bounds_table(n: i64) -> Vec<String> {
    let table: Vec<String> = Vec::new();
    let mut i: i64 = 0;
    while i < n {
        table.push(String::from(""));
        i = i + 1;
    }
    table
}

// Report that a proof was obtained from a model restricting collection lengths
// to the model capacity (the structured "this proof is bounded" Note). A Note,
// not a failure: the contracts are proved, only for executions within the bound.
// `bounds` is read off the model that was proved (its `vow:model-bound`
// markers), so it describes exactly what was checked. Mirrors
// `CapacityBoundNote` in the Rust driver. `compare_json` only compares
// diagnostics as a multiset of (error_code, blame); the note text and order are
// held identical by the ordered-notes parity section of scripts/full_test.sh.
fn report_capacity_bound(function: String, bounds: String, dctx: DiagCtx) [io] {
    if bounds.len() == 0 { return; }
    let msg: String = str5(
        String::from("proof of `"),
        function,
        String::from("` is bounded: only executions within the verifier model capacity were checked ("),
        bounds,
        String::from(")"),
    );
    let d: Diagnostic = diag_new(SEV_NOTE(), EC_MODEL_CAPACITY_ASSUMED(), msg, String::from(""), 0, 0, DIAG_BLAME_NONE());
    diag_add_hint(d, String::from("the bound belongs to the bounded model checker, not to the program or its contracts; executions beyond it (longer collections, more struct allocations) were not checked"));
    diag_add_hint(d, String::from("do not add a length bound to a contract to silence this note; an unbounded verifier removes it without any source change"));
    diag_ctx_emit(dctx, d);
}

// Capacity notes describe a completed proof run: they follow every other
// finding, in function order, and exist only when every function was proved and
// none was skipped. Shared by `vowc verify` and `vowc build`, mirroring
// `to_output_with_warnings` in the Rust driver.
fn report_capacity_notes(fns: Vec<IrFunction>, model_bounds: Vec<String>, dctx: DiagCtx) [io] {
    let mut ni: i64 = 0;
    while ni < fns.len() as i64 && ni < model_bounds.len() as i64 {
        let nf: IrFunction = fns[ni as u64];
        report_capacity_bound(nf.name, model_bounds[ni as u64], dctx);
        ni = ni + 1;
    }
}

fn verify_collect_and_report(
    esbmc_bin: String, h: i64, tmp_path: String, f: IrFunction, ir_mod: IrModule, path: String, ces: Vec<VerifyCE>, soft_meta: Vec<String>,
    max_k_step: String, use_cache: bool, solver: String, encoding: String, timeout_secs: String,
    vec_max: i64, string_max: i64, hashmap_max: i64, btreemap_max: i64, t: TraceCtx, dctx: DiagCtx,
) -> i64 [io, write] {
    let effective_timeout: String = effective_timeout_for(encoding, solver, timeout_secs);
    let vr0: VerifyResult = verify_collect(h, f, effective_timeout, tmp_path, t);
    // #585: an `arith:` counterexample reports a checked operator whose abort is
    // reachable. It is not a contract violation, so it must not fail the run —
    // but it does hide the contract verdict, because ESBMC reports one violated
    // property per run and this one fired first. Ask again with the arith
    // obligations suppressed to get the verdict on returning executions.
    let arith_site: ParsedArithSite = {
        if vr0.status == VERIFY_FAILED() { parse_arith_site(vr0.raw_output) }
        else { parsed_arith_site_none() }
    };
    let has_arith: bool = arith_site.cause.len() > 0;
    let vr: VerifyResult = {
        if has_arith {
            verify_function_contracts_only(esbmc_bin, f, ir_mod, max_k_step, solver, encoding, timeout_secs, vec_max, string_max, hashmap_max, btreemap_max)
        } else {
            vr0
        }
    };
    let st: i64 = vr.status;
    // The contracts-only run answers this function completely: it ran its own
    // BV->IR ladder over the suppressed source, so its verdict is final and must
    // not fall through to the generic fallback below, which would re-emit the
    // un-suppressed model and retry an obligation IR cannot violate.
    if has_arith {
        // The abort is reported only when the contract itself is proved. If the
        // contract also fails, that failure is the actionable finding; claiming
        // the abort alongside would be guesswork, since ESBMC never told us
        // whether the arith obligation held on this second run.
        if st == VERIFY_PROVEN() || st == VERIFY_PROVEN_IR() {
            report_arith_overflow(f, ir_mod, path, arith_site, dctx);
            return 1;
        }
        if st == VERIFY_FAILED() {
            diag_eprintln_best_effort(str3(String::from("  "), f.name, String::from(": FAILED")));
            emit_ce_vars(vr);
            if ces.len() == 0 {
                ces.push(build_ce_from_result(f, ir_mod, vr, path));
            }
            return 0;
        }
        if st == VERIFY_TIMEOUT() {
            diag_eprintln_best_effort(str3(String::from("  "), f.name, String::from(": TIMEOUT")));
            record_soft_fail(soft_meta, String::from("timeout"), String::from(""), f.name);
            return 0;
        }
        if st == VERIFY_UNKNOWN() {
            diag_eprintln_best_effort(str3(String::from("  "), f.name, String::from(": UNKNOWN")));
            record_soft_fail(soft_meta, String::from("unknown"), parse_unknown_reason(vr.raw_output), f.name);
            return 0;
        }
        if st == VERIFY_NOT_FOUND() {
            diag_eprintln_best_effort(String::from("error: ESBMC not found; install ESBMC or use --no-verify"));
            record_soft_fail(soft_meta, String::from("tool_not_found"), String::from("ESBMC not found"), f.name);
            return 0;
        }
        diag_eprintln_best_effort(str3(String::from("  "), f.name, String::from(": ERROR")));
        record_soft_fail(soft_meta, String::from("error"), String::from("ESBMC error during contracts-only verification"), f.name);
        return 0;
    }
    if st == VERIFY_PROVEN() {
        diag_eprintln_best_effort(str3(String::from("  "), f.name, String::from(": PROVEN")));
        // No on-disk cache on self-hosted; see the note above
        // resolve_auto_bv_solver in verifier.vow.
        return 1;
    }
    if st == VERIFY_PROVEN_IR() {
        diag_eprintln_best_effort(str3(String::from("  "), f.name, String::from(": PROVEN (IR)")));
        return 1;
    }
    if st == VERIFY_FAILED() {
        diag_eprintln_best_effort(str3(String::from("  "), f.name, String::from(": FAILED")));
        emit_ce_vars(vr);
        if ces.len() == 0 {
            ces.push(build_ce_from_result(f, ir_mod, vr, path));
        }
        return 0;
    }
    if st == VERIFY_TIMEOUT() || st == VERIFY_UNKNOWN() {
        // BV timeout or memlimit exhaustion may retry with IR before failing
        // (Phase D fallback). Other UNKNOWN outcomes are explicit inconclusive
        // ESBMC results; do not let an IR proof hide them. Mirrors
        // run_with_fallback in vow-verify.
        let bv_is_unknown: bool = st == VERIFY_UNKNOWN();
        let bv_label: String = { if bv_is_unknown { String::from("unknown") } else { String::from("timeout") } };
        let bv_label_upper: String = { if bv_is_unknown { String::from("UNKNOWN") } else { String::from("TIMEOUT") } };
        // Timeout: empty message to match Rust's None; Unknown: include ESBMC's own explanation.
        let bv_msg_initial: String = {
            if bv_is_unknown { parse_unknown_reason(vr.raw_output) }
            else { String::from("") }
        };
        let bv_memory_limit: bool = bv_is_unknown && output_has_memory_limit(vr.raw_output);
        let bv_solver: String = resolve_auto_bv_solver(solver);
        let auto_enc: bool = is_auto_encoding(encoding);
        if (!bv_is_unknown || bv_memory_limit) && auto_enc && bv_solver != String::from("bitwuzla") {
            diag_eprintln_best_effort(str3(String::from("  "), f.name, String::from(": BV inconclusive, retrying with --z3 --ir...")));
            let vr2: VerifyResult = verify_function_ir_fallback(esbmc_bin, f, ir_mod, max_k_step, use_cache, timeout_secs, vec_max, string_max, hashmap_max, btreemap_max);
            let st2: i64 = vr2.status;
            if st2 == VERIFY_PROVEN_IR() {
                diag_eprintln_best_effort(str3(String::from("  "), f.name, String::from(": PROVEN (IR)")));
                return 1;
            }
            if st2 == VERIFY_FAILED() {
                // IR-only counterexamples can be infeasible under BV (no
                // overflow modeling), so a FAILED here is unsound — surface
                // the original timeout instead. Mirrors solver_strategy's
                // demote-IR-FAILED rule.
                diag_eprintln_best_effort(str4(String::from("  "), f.name, String::from(": "), bv_label_upper));
                record_soft_fail(soft_meta, bv_label, bv_msg_initial, f.name);
                return 0;
            }
            if st2 == VERIFY_TIMEOUT() {
                diag_eprintln_best_effort(str3(String::from("  "), f.name, String::from(": TIMEOUT (BV and IR)")));
                // Empty verify_message — match Rust's verify_status="timeout" + None shape.
                record_soft_fail(soft_meta, String::from("timeout"), String::from(""), f.name);
                return 0;
            }
            if st2 == VERIFY_UNKNOWN() {
                let reason2: String = parse_unknown_reason(vr2.raw_output);
                diag_eprintln_best_effort(str3(String::from("  "), f.name, String::from(": UNKNOWN (BV and IR)")));
                record_soft_fail(soft_meta, String::from("unknown"), reason2, f.name);
                return 0;
            }
            if st2 == VERIFY_NOT_FOUND() {
                diag_eprintln_best_effort(String::from("error: ESBMC not found; install ESBMC or use --no-verify"));
                record_soft_fail(soft_meta, String::from("tool_not_found"), String::from("ESBMC not found"), f.name);
                return 0;
            }
            diag_eprintln_best_effort(str3(String::from("  "), f.name, String::from(": ERROR")));
            record_soft_fail(soft_meta, String::from("error"), String::from("ESBMC error during IR fallback"), f.name);
            return 0;
        }
        diag_eprintln_best_effort(str4(String::from("  "), f.name, String::from(": "), bv_label_upper));
        record_soft_fail(soft_meta, bv_label, bv_msg_initial, f.name);
        return 0;
    }
    if st == VERIFY_NOT_FOUND() {
        diag_eprintln_best_effort(String::from("error: ESBMC not found; install ESBMC or use --no-verify"));
        record_soft_fail(soft_meta, String::from("tool_not_found"), String::from("ESBMC not found"), f.name);
        return 0;
    }
    let error_message: String = {
        if vr.raw_output.len() > 0 { vr.raw_output } else { String::from("unrecognized ESBMC outcome") }
    };
    diag_eprintln_best_effort(str5(String::from("  "), f.name, String::from(": ERROR ("), error_message, String::from(")")));
    record_soft_fail(soft_meta, String::from("error"), error_message, f.name);
    0
}

// Report one native-backend result for `f`. Returns 1 when proven, else 0
// after recording the counterexample or the soft failure. A proof carries one
// `ArithOverflowReachable` warning per checked operator whose abort the solver
// found reachable.
fn native_report_result(f: IrFunction, ir_mod: IrModule, path: String, oc: VcOutcome, ces: Vec<VerifyCE>, soft_meta: Vec<String>, dctx: DiagCtx) -> i64 [io] {
    let vr: VerifyResult = oc.result;
    let st: i64 = vr.status;
    if st == VERIFY_PROVEN() {
        if oc.sites.len() == 0 {
            diag_eprintln_best_effort(str3(String::from("  "), f.name, String::from(": PROVEN")));
        }
        let mut si: u64 = 0;
        while si < oc.sites.len() {
            report_arith_overflow(f, ir_mod, path, oc.sites[si], dctx);
            si = si + 1;
        }
        return 1;
    }
    if st == VERIFY_FAILED() {
        diag_eprintln_best_effort(str3(String::from("  "), f.name, String::from(": FAILED")));
        emit_ce_vars(vr);
        if ces.len() == 0 {
            ces.push(build_ce_from_result(f, ir_mod, vr, path));
        }
        return 0;
    }
    if st == VERIFY_TIMEOUT() {
        diag_eprintln_best_effort(str3(String::from("  "), f.name, String::from(": TIMEOUT")));
        record_soft_fail(soft_meta, String::from("timeout"), String::from(""), f.name);
        return 0;
    }
    if st == VERIFY_UNKNOWN() {
        diag_eprintln_best_effort(str3(String::from("  "), f.name, String::from(": UNKNOWN")));
        let why: String = {
            if output_has_memory_limit(vr.raw_output) { memory_limit_reason() }
            else if vc_output_has_unwinding(vr.raw_output) { vr.raw_output }
            else { String::from("the solver answered unknown") }
        };
        record_soft_fail(soft_meta, String::from("unknown"), why, f.name);
        return 0;
    }
    if st == VERIFY_PANICKED() {
        diag_eprintln_best_effort(str5(String::from("  "), f.name, String::from(": PANICKED ("), vr.raw_output, String::from(")")));
        record_soft_fail(soft_meta, String::from("panicked"), vr.raw_output, f.name);
        return 0;
    }
    if st == VERIFY_NOT_FOUND() {
        diag_eprintln_best_effort(String::from("error: Bitwuzla not found; install Bitwuzla to run native verification"));
        record_soft_fail(soft_meta, String::from("tool_not_found"), String::from("Bitwuzla not found"), f.name);
        return 0;
    }
    let raw: String = {
        if vr.raw_output.len() > 0 { vr.raw_output } else { String::from("unrecognized Bitwuzla outcome") }
    };
    let detail: String = str_trim(raw);
    diag_eprintln_best_effort(str5(String::from("  "), f.name, String::from(": ERROR ("), detail, String::from(")")));
    record_soft_fail(soft_meta, String::from("error"), detail, f.name);
    0
}

fn native_skip_function(f: IrFunction, reason: String, dctx: DiagCtx) [io] {
    diag_eprintln_best_effort(str3(String::from("  "), f.name, String::from(": SKIPPED (outside the native verifier subset)")));
    let msg: String = str3(
        String::from("skipped verification of `"),
        f.name,
        str2(String::from("`: "), reason),
    );
    let d: Diagnostic = diag_new(SEV_WARNING(), EC_VERIFICATION_SKIPPED(), msg, String::from(""), 0, 0, DIAG_BLAME_NONE());
    diag_add_hint(d, String::from("the contract is documentary; runtime checks still apply in --mode debug"));
    diag_ctx_emit(dctx, d);
}

// One verify target of the native driver, in IR order: either skipped with a
// reason or run as pool task `task`.
struct NativeEntry {
    fn_index: i64,
    reason: String,
    task: i64,
}

fn native_plan(fns: Vec<IrFunction>, ir_mod: IrModule, const_fn_indices: Vec<i64>, task_idx: Vec<i64>, task_names: Vec<String>) -> Vec<NativeEntry> {
    let entries: Vec<NativeEntry> = Vec::new();
    let mut fi: u64 = 0;
    while fi < fns.len() {
        let f: IrFunction = fns[fi];
        if is_verify_target(f, ir_mod, const_fn_indices) {
            let reason: String = vc_skip_reason(f);
            if reason.len() > 0 {
                entries.push(NativeEntry { fn_index: fi as i64, reason: reason, task: -1 });
            } else {
                entries.push(NativeEntry { fn_index: fi as i64, reason: String::from(""), task: task_idx.len() as i64 });
                task_idx.push(fi as i64);
                task_names.push(f.name);
            }
        }
        fi = fi + 1;
    }
    entries
}

// `verify --backend native`: every function inside the integer subset runs in its own
// `verify-worker` subprocess, at most `--verify-jobs` at a time. Results are
// reported in IR order, so the output does not depend on which worker finishes
// first, and reporting stops at the first function that is not proven, as the
// sequential driver did.
fn run_verify_native(argv: Vec<String>, fr: LoweredFrontend, path: String, tctx: TraceCtx) -> i32 [io, read, write] {
    let checked: CheckedFrontend = fr.checked;
    let dctx: DiagCtx = checked.dctx;
    let ir_mod: IrModule = fr.ir_mod;
    emit_ir_warnings(ir_mod, dctx);
    let fns: Vec<IrFunction> = ir_mod.functions;
    let ces: Vec<VerifyCE> = Vec::new();
    let soft_meta: Vec<String> = Vec::new();
    let const_fn_indices: Vec<i64> = detect_const_fns(ir_mod);
    let timeout_ms: i64 = watchdog_ms_for(get_flag_arg(argv, "--timeout"));
    let jobs: i64 = resolve_verify_jobs(argv);
    let task_idx: Vec<i64> = Vec::new();
    let task_names: Vec<String> = Vec::new();
    let entries: Vec<NativeEntry> = native_plan(fns, ir_mod, const_fn_indices, task_idx, task_names);
    let pool: VcPool = vc_pool_new(vc_worker_exe(argv[0]), path, task_idx, task_names, jobs, timeout_ms);
    let mut all_proven: bool = true;
    let mut any_skipped: bool = false;
    let t_verify: i64 = trace_now(tctx);
    let mut e: u64 = 0;
    while e < entries.len() && all_proven {
        let en: NativeEntry = entries[e];
        let f: IrFunction = fns[en.fn_index as u64];
        if en.task < 0 {
            native_skip_function(f, en.reason, dctx);
            any_skipped = true;
            e = e + 1;
        } else if vc_pool_ready(pool, en.task as u64) {
            diag_eprintln_best_effort(str3(String::from("Verifying "), f.name, String::from("...")));
            let oc: VcOutcome = pool.results[en.task as u64];
            if native_report_result(f, ir_mod, path, oc, ces, soft_meta, dctx) == 0 {
                all_proven = false;
            }
            e = e + 1;
        } else {
            vc_pool_step(pool);
        }
    }
    vc_pool_abort(pool);
    trace_span(tctx, String::from("verification"), PID_COMPILER(), TID_VERIFY_DRIVER(), t_verify, trace_now(tctx) - t_verify, String::from(""));
    report_unchecked_calls(fns, ir_mod, const_fn_indices, dctx);
    let status_str: String = {
        if !all_proven { String::from("VerifyFailed") }
        else if any_skipped { String::from("Skipped") }
        else { String::from("Verified") }
    };
    verify_finish(argv, fns, path, replay_main_start(argv, fr, path), dctx, tctx, status_str, ces, soft_meta, !all_proven || any_skipped)
}

// `verify-worker <source> --worker-index N --worker-name F --worker-budget-ms MS`:
// internal. Lowers the program again, verifies function N and prints the result
// in the `vc_worker` wire format. Exit 3 when the program no longer matches what
// the parent planned; the parent reports that as a crashed worker.
fn run_verify_worker(argv: Vec<String>) -> i32 [io, read, write] {
    let path: String = frontend_path_from_argv(argv, true, String::from("verify-worker"));
    let index: i64 = str_to_i64(get_flag_arg(argv, "--worker-index"));
    let budget_ms: i64 = str_to_i64(get_flag_arg(argv, "--worker-budget-ms"));
    let fr: LoweredFrontend = frontend_lower_path_traced(path, String::from(""), trace_off());
    let checked: CheckedFrontend = fr.checked;
    let fns: Vec<IrFunction> = fr.ir_mod.functions;
    if checked.n_errors > 0 || index < 0 || index >= fns.len() as i64 {
        diag_eprintln_best_effort(String::from("verify-worker: program does not match the planned function table"));
        return 3;
    }
    let f: IrFunction = fns[index as u64];
    if f.name != get_flag_arg(argv, "--worker-name") {
        diag_eprintln_best_effort(String::from("verify-worker: function name does not match the planned index"));
        return 3;
    }
    print_str(vc_wire_encode(vc_verify_function(f, budget_ms, get_flag_arg(argv, "--worker-scratch"))));
    0
}

fn run_verify(argv: Vec<String>) -> i32 [io, read, write] {
    let path: String = frontend_path_from_argv(argv, true, String::from("verify"));
    let tctx: TraceCtx = {
        if has_flag(argv, "--perfetto") { trace_new(get_flag_arg(argv, "--perfetto")) }
        else { trace_off() }
    };
    let fr: LoweredFrontend = frontend_lower_path_traced(path, String::from(""), tctx);
    let checked: CheckedFrontend = fr.checked;
    let dctx: DiagCtx = checked.dctx;
    let n_items: i64 = checked.n_items;
    let n_errors: i64 = checked.n_errors;
    if diag_ctx_print_all(dctx) == DIAG_EMIT_FAILED() {
        diag_emit_emission_failure_json(dctx);
        return 1;
    }
    diag_eprintln_best_effort(str4(i64_to_string(n_items), String::from(" items, "), i64_to_string(n_errors), String::from(" errors")));
    if n_errors > 0 {
        diag_emit_verify_json(String::from("CompileFailed"), dctx, Vec::new());
        return 1;
    }
    if get_flag_arg(argv, "--backend") == "native" {
        return run_verify_native(argv, fr, path, tctx);
    }
    let max_k_step_str: String = get_flag_arg(argv, "--max-k-step");
    let max_k_step: String = {
        if max_k_step_str.len() > 0 { max_k_step_str }
        else { String::from("50") }
    };
    let vec_max: i64 = VOW_VEC_MAX();
    let string_max: i64 = VOW_STRING_MAX();
    let hashmap_max: i64 = VOW_HASHMAP_MAX();
    let btreemap_max: i64 = VOW_BTREEMAP_MAX();
    let jobs: i64 = resolve_verify_jobs(argv);
    let use_cache: bool = !has_flag(argv, "--no-cache");
    let mut solver: String = get_flag_arg(argv, "--solver");
    let encoding: String = get_flag_arg(argv, "--encoding");
    let timeout_secs: String = get_flag_arg(argv, "--timeout");
    if encoding == String::from("ir") {
        if solver == String::from("boolector") || solver == String::from("bitwuzla") {
            diag_eprintln_best_effort(String::from("error: --encoding ir requires --solver z3"));
            return 1;
        }
        if solver.len() == 0 || solver == String::from("auto") {
            solver = String::from("z3");
        }
    }
    let esbmc_bin: String = esbmc_path();
    if !esbmc_exists(esbmc_bin) {
        diag_eprintln_best_effort(String::from("error: ESBMC not found; install ESBMC to run verification"));
        diag_emit_verify_json(String::from("VerifyFailed"), dctx, Vec::new());
        return 1;
    }
    let ir_mod: IrModule = fr.ir_mod;
    emit_ir_warnings(ir_mod, dctx);
    let fns: Vec<IrFunction> = ir_mod.functions;
    let ces: Vec<VerifyCE> = Vec::new();
    let soft_meta: Vec<String> = Vec::new();
    let const_fn_indices: Vec<i64> = detect_const_fns(ir_mod);
    let t_verify: i64 = trace_now(tctx);
    let outcome: i64 = run_verify_loop_traced(esbmc_bin, fns, ir_mod, const_fn_indices, dctx, path, ces, soft_meta, max_k_step, use_cache, solver, encoding, timeout_secs, vec_max, string_max, hashmap_max, btreemap_max, jobs, tctx);
    trace_span(tctx, String::from("verification"), PID_COMPILER(), TID_VERIFY_DRIVER(), t_verify, trace_now(tctx) - t_verify, String::from(""));
    let status_str: String = {
        if outcome == 0 { String::from("Verified") }
        else if outcome == 2 { String::from("Skipped") }
        else { String::from("VerifyFailed") }
    };
    verify_finish(argv, fns, path, replay_main_start(argv, fr, path), dctx, tctx, status_str, ces, soft_meta, outcome != 0)
}

// Shared tail of `verify`: counterexample selection, replay, trace output and
// the JSON result. Returns the process exit code.
fn verify_finish(argv: Vec<String>, fns: Vec<IrFunction>, path: String, main_start: i64, dctx: DiagCtx, tctx: TraceCtx, status_str: String, ces: Vec<VerifyCE>, soft_meta: Vec<String>, failed: bool) -> i32 [io, read, write] {
    let native: bool = get_flag_arg(argv, "--backend") == "native";
    let mut ces_final: Vec<VerifyCE> = Vec::new();
    let ce_wins: bool = vf_prefers_counterexample(ces, soft_meta, fns);
    if ce_wins {
        ces_final = ces;
    }
    if has_flag(argv, "--replay-cex") && ces_final.len() > 0 {
        ces_final = replay_all(ces_final, fns, path, main_start, argv[0], native);
    }
    let vstatus: String = { if ce_wins { String::from("") } else if soft_meta.len() >= 1 { soft_meta[0] } else { String::from("") } };
    let vmsg: String = { if ce_wins { String::from("") } else if soft_meta.len() >= 2 { soft_meta[1] } else { String::from("") } };
    let mut vf_func: String = String::from("");
    let mut vf_ce: String = String::from("");
    if status_str == String::from("VerifyFailed") {
        let legacy: Vec<String> = vf_legacy_fields(ces_final, soft_meta, fns);
        vf_func = legacy[0];
        vf_ce = legacy[1];
    }
    trace_write(tctx);
    vf_add_ce_diagnostics(dctx, ces_final);
    if native {
        report_verifier_bug_ces(dctx, ces_final);
    }
    diag_emit_verify_json_full(status_str, dctx, ces_final, vstatus, vmsg, vf_func, vf_ce);
    if failed {
        return 1;
    }
    0
}

// Spawn-with-FIFO-drain phase of `run_build`. Mirrors `run_verify_loop` but
// leaves the final drain to `build_drain_verify_phase`. It runs only after
// codegen and linking have finished (#179), so the Cranelift working set is
// released before the first ESBMC process starts.
//
// State threading (Vow Vecs share heap backing across by-value copies, so
// pushes/removes visible to the caller — see compiler/frontend.vow:202-204):
//   - `in_flight_h`, `in_flight_fi`, `in_flight_tmp`: caller-allocated FIFO
//     queues. This phase pushes new handles and pre-drains when the pool is
//     full. Remaining entries are drained by `build_drain_verify_phase`.
//   - `ces`, `soft_meta`: counterexample + soft-fail accumulators threaded
//     through to `verify_collect_and_report`.
//   - `model_bounds`: per-function model-bound text, filled at launch and read
//     by `report_capacity_notes` once the whole run is proved.
// Returns `[all_proven, any_skipped]`.
fn build_verify_phase(
    esbmc_bin: String, fns: Vec<IrFunction>, ir_mod: IrModule, const_fn_indices: Vec<i64>, dctx: DiagCtx, path: String,
    ces: Vec<VerifyCE>, soft_meta: Vec<String>,
    in_flight_h: Vec<i64>, in_flight_fi: Vec<i64>, in_flight_tmp: Vec<String>,
    max_k_step: String, use_cache: bool, solver: String, encoding: String, timeout_secs: String,
    vec_max: i64, string_max: i64, hashmap_max: i64, btreemap_max: i64, jobs: i64,
    verify_origin: i64, t: TraceCtx, model_bounds: Vec<String>
) -> Vec<i64> [io, write] {
    let mut all_proven: i64 = 1;
    let mut any_skipped: i64 = 0;
    let mut fi: i64 = 0;
    while fi < fns.len() as i64 {
        let f: IrFunction = fns[fi as u64];
        // Stop launching new ESBMC jobs once any in-flight verification has failed.
        if all_proven == 1 && is_verify_target(f, ir_mod, const_fn_indices) {
            while in_flight_h.len() as i64 >= jobs {
                let oldest_h: i64 = in_flight_h[0];
                let oldest_fi: i64 = in_flight_fi[0];
                let oldest_tmp: String = in_flight_tmp[0];
                let oldest_f: IrFunction = fns[oldest_fi as u64];
                vec_i64_remove_front(in_flight_h);
                vec_i64_remove_front(in_flight_fi);
                vec_string_remove_front(in_flight_tmp);
                let proven: i64 = verify_collect_traced(esbmc_bin, t, verify_origin, oldest_h, oldest_tmp, oldest_f, oldest_fi, ir_mod, path, ces, soft_meta, max_k_step, use_cache, solver, encoding, timeout_secs, vec_max, string_max, hashmap_max, btreemap_max, model_bounds, dctx);
                if proven == 0 {
                    all_proven = 0;
                }
            }
            if all_proven == 1 {
                if skip_if_non_modelable(f, ir_mod, const_fn_indices, dctx) {
                    // Fail closed: a non-modelable function is not statically proved.
                    any_skipped = 1;
                } else {
                    diag_eprintln_best_effort(str3(String::from("Starting verification of "), f.name, String::from("...")));
                    let started: EsbmcStart = verify_start(esbmc_bin, f, ir_mod, max_k_step, fi, use_cache, solver, encoding, timeout_secs, vec_max, string_max, hashmap_max, btreemap_max);
                    model_bounds[fi as u64] = started.bounds;
                    in_flight_h.push(started.handle);
                    in_flight_fi.push(fi);
                    in_flight_tmp.push(started.tmp_path);
                }
            }
        }
        fi = fi + 1;
    }
    let result: Vec<i64> = Vec::new();
    result.push(all_proven);
    result.push(any_skipped);
    result
}

// FIFO drain phase of `run_build`. Collects results from every ESBMC process
// still in flight after `build_verify_phase` returned. Mutates `ces` /
// `soft_meta` via shared Vec backings.
// Returns the post-drain `all_proven` flag (0 if any in-flight job failed,
// otherwise the input value).
//
// A no-op when `in_flight_h` is empty; callers may invoke it unconditionally
// without a do_verify guard if desired.
fn build_drain_verify_phase(esbmc_bin: String, in_flight_h: Vec<i64>, in_flight_fi: Vec<i64>, in_flight_tmp: Vec<String>, fns: Vec<IrFunction>, ir_mod: IrModule, ces: Vec<VerifyCE>, soft_meta: Vec<String>, path: String, max_k_step: String, use_cache: bool, solver: String, encoding: String, timeout_secs: String, vec_max: i64, string_max: i64, hashmap_max: i64, btreemap_max: i64, all_proven_in: i64, verify_origin: i64, t: TraceCtx, model_bounds: Vec<String>, dctx: DiagCtx) -> i64 [io, write] {
    let mut all_proven: i64 = all_proven_in;
    while in_flight_h.len() > 0 {
        let oldest_h: i64 = in_flight_h[0];
        let oldest_fi: i64 = in_flight_fi[0];
        let oldest_tmp: String = in_flight_tmp[0];
        let oldest_f: IrFunction = fns[oldest_fi as u64];
        vec_i64_remove_front(in_flight_h);
        vec_i64_remove_front(in_flight_fi);
        vec_string_remove_front(in_flight_tmp);
        let proven: i64 = verify_collect_traced(esbmc_bin, t, verify_origin, oldest_h, oldest_tmp, oldest_f, oldest_fi, ir_mod, path, ces, soft_meta, max_k_step, use_cache, solver, encoding, timeout_secs, vec_max, string_max, hashmap_max, btreemap_max, model_bounds, dctx);
        if proven == 0 {
            all_proven = 0;
        }
    }
    all_proven
}

fn codegen_failure_diagnostic(result: i64, path: String, obj_path: String) -> Diagnostic {
    if result == CLIF_ERR_WIDE_AGGREGATE_FIELD() {
        diag_error(
            EC_CODEGEN_UNSUPPORTED(),
            CLIF_WIDE_AGGREGATE_FIELD_MSG(),
            path,
            0,
            0
        )
    } else if result == CLIF_ERR_UNSUPPORTED() {
        diag_error(
            EC_CODEGEN_UNSUPPORTED(),
            String::from("native backend does not support an operation used by this program"),
            path,
            0,
            0
        )
    } else if result == CLIF_ERR_LINK() {
        diag_error(EC_LINK_FAILED(), String::from("native linker failed"), path, 0, 0)
    } else if result == CLIF_ERR_IO() {
        diag_error(EC_IO_ERROR(), str2(String::from("cannot write the generated object file: "), obj_path), path, 0, 0)
    } else if result == CLIF_ERR_IO_MKDIR() {
        diag_error(EC_IO_ERROR(), str2(String::from("cannot create the output directory: "), skill_parent_dir(obj_path)), path, 0, 0)
    } else {
        diag_error(EC_CODEGEN_FAILED(), String::from("native code generation failed"), path, 0, 0)
    }
}

fn emit_codegen_failure(result: i64, path: String, obj_path: String, dctx: DiagCtx) [io] {
    let d: Diagnostic = codegen_failure_diagnostic(result, path, obj_path);
    diag_ctx_emit(dctx, d);
    diag_eprintln_best_effort(diag_to_human(d, dctx));
}

// Codegen phase: emits the native object via Cranelift FFI and links it.
// Returns 0 on success. On any non-zero `clif_emit_module` status the helper
// emits the classified diagnostic and the `CompileFailed` JSON, and returns 1;
// the orchestrator propagates that as the process exit code.
fn build_codegen_phase(ir_mod: IrModule, out: String, mode: i64, trace: i64, path: String, dctx: DiagCtx) -> i64 [io] {
    let result: i64 = clif_emit_module(ir_mod, out, mode, trace);
    if result != 0 {
        emit_codegen_failure(result, path, str2(out, String::from(".o")), dctx);
        diag_emit_build_verify_json(String::from("CompileFailed"), String::from(""), dctx, Vec::new());
        return 1;
    }
    0
}

fn run_build(argv: Vec<String>) -> i32 [io, read, write] {
    run_build_cmd(argv, true)
}

fn run_build_cmd(argv: Vec<String>, sub: bool) -> i32 [io, read, write] {
    let path: String = frontend_path_from_argv(argv, sub, String::from("build"));
    let tctx: TraceCtx = {
        if has_flag(argv, "--perfetto") { trace_new(get_flag_arg(argv, "--perfetto")) }
        else { trace_off() }
    };
    let fr: LoweredFrontend = frontend_lower_path_traced(path, String::from(""), tctx);
    let checked: CheckedFrontend = fr.checked;
    let dctx: DiagCtx = checked.dctx;
    let n_items: i64 = checked.n_items;
    let n_errors: i64 = checked.n_errors;
    if diag_ctx_print_all(dctx) == DIAG_EMIT_FAILED() {
        diag_emit_emission_failure_json(dctx);
        return 1;
    }
    diag_eprintln_best_effort(str4(i64_to_string(n_items), String::from(" items, "), i64_to_string(n_errors), String::from(" errors")));
    if n_errors > 0 {
        diag_emit_build_verify_json(String::from("CompileFailed"), String::from(""), dctx, Vec::new());
        return 1;
    }
    let out: String = {
        if has_output_flag(argv) {
            output_flag_value(argv)
        } else {
            default_output(path)
        }
    };
    let mode_str: String = get_flag_arg(argv, "--mode");
    let mode: i64 = {
        if mode_str == String::from("debug") { 1 }
        else if mode_str == String::from("profile") { 2 }
        else if mode_str == String::from("sanitize") { 3 }
        else { 0 }
    };
    let trace_str: String = get_flag_arg(argv, "--debug-trace");
    let trace: i64 = {
        if trace_str == String::from("calls") { 1 }
        else if trace_str == String::from("full") { 2 }
        else { 0 }
    };
    let ir_mod: IrModule = fr.ir_mod;
    if has_flag(argv, "--dump-ir") {
        emit_ir_warnings(ir_mod, dctx);
        let ir_text: String = print_module(ir_mod);
        print_str(ir_text);
        return 0;
    }
    emit_ir_warnings(ir_mod, dctx);
    let do_verify: bool = !has_flag(argv, "--no-verify");
    let esbmc_bin: String = {
        if do_verify { esbmc_path() }
        else { String::from("") }
    };
    if do_verify {
        if !esbmc_exists(esbmc_bin) {
            diag_eprintln_best_effort(String::from("error: ESBMC not found; install ESBMC or use --no-verify to skip verification"));
            diag_emit_build_verify_json(String::from("VerifyFailed"), String::from(""), dctx, Vec::new());
            return 1;
        }
    }
    let use_cache: bool = !has_flag(argv, "--no-cache");
    let max_k_step_str: String = get_flag_arg(argv, "--max-k-step");
    let max_k_step: String = {
        if max_k_step_str.len() > 0 { max_k_step_str }
        else { String::from("50") }
    };
    let mut solver: String = get_flag_arg(argv, "--solver");
    let encoding: String = get_flag_arg(argv, "--encoding");
    let timeout_secs: String = get_flag_arg(argv, "--timeout");
    if encoding == String::from("ir") {
        if solver == String::from("boolector") || solver == String::from("bitwuzla") {
            diag_eprintln_best_effort(String::from("error: --encoding ir requires --solver z3"));
            return 1;
        }
        if solver.len() == 0 || solver == String::from("auto") {
            solver = String::from("z3");
        }
    }
    let vec_max: i64 = VOW_VEC_MAX();
    let string_max: i64 = VOW_STRING_MAX();
    let hashmap_max: i64 = VOW_HASHMAP_MAX();
    let btreemap_max: i64 = VOW_BTREEMAP_MAX();
    let jobs: i64 = resolve_verify_jobs(argv);
    let fns: Vec<IrFunction> = ir_mod.functions;
    let ces: Vec<VerifyCE> = Vec::new();
    let soft_meta: Vec<String> = Vec::new();
    let mut all_proven: i64 = 1;
    let mut any_skipped: i64 = 0;
    // Bounded pool: ≤ jobs ESBMC processes in flight, FIFO drain. See #175.
    let in_flight_h: Vec<i64> = Vec::new();
    let in_flight_fi: Vec<i64> = Vec::new();
    let in_flight_tmp: Vec<String> = Vec::new();
    let const_fn_indices: Vec<i64> = detect_const_fns(ir_mod);
    let model_bounds: Vec<String> = model_bounds_table(fns.len() as i64);
    let t_codegen: i64 = trace_now(tctx);
    let codegen_status: i64 = build_codegen_phase(ir_mod, out, mode, trace, path, dctx);
    trace_span(tctx, String::from("codegen"), PID_COMPILER(), TID_MAIN(), t_codegen, trace_now(tctx) - t_codegen, String::from(""));
    trace_sample(tctx, trace_now(tctx));
    if codegen_status != 0 { return 1; }
    if !do_verify {
        trace_write(tctx);
        diag_emit_build_verify_json(String::from("Unverified"), out, dctx, Vec::new());
        return 0;
    }
    // Verification starts only after codegen and linking so ESBMC children
    // never overlap the Cranelift working set; the pool bounds what remains (#179).
    let verify_origin: i64 = trace_now(tctx);
    let phase_result: Vec<i64> = build_verify_phase(esbmc_bin, fns, ir_mod, const_fn_indices, dctx, path, ces, soft_meta, in_flight_h, in_flight_fi, in_flight_tmp, max_k_step, use_cache, solver, encoding, timeout_secs, vec_max, string_max, hashmap_max, btreemap_max, jobs, verify_origin, tctx, model_bounds);
    if phase_result[0] == 0 { all_proven = 0; }
    if phase_result[1] == 1 { any_skipped = 1; }
    all_proven = build_drain_verify_phase(esbmc_bin, in_flight_h, in_flight_fi, in_flight_tmp, fns, ir_mod, ces, soft_meta, path, max_k_step, use_cache, solver, encoding, timeout_secs, vec_max, string_max, hashmap_max, btreemap_max, all_proven, verify_origin, tctx, model_bounds, dctx);
    trace_span(tctx, String::from("verification"), PID_COMPILER(), TID_VERIFY_DRIVER(), verify_origin, trace_now(tctx) - verify_origin, String::from(""));
    if all_proven == 1 && any_skipped == 0 {
        report_capacity_notes(fns, model_bounds, dctx);
    }
    report_unchecked_calls(fns, ir_mod, const_fn_indices, dctx);
    let status_str: String = {
        if all_proven == 0 { String::from("VerifyFailed") }
        else if any_skipped == 1 { String::from("Skipped") }
        else { String::from("Verified") }
    };
    let mut ces_final: Vec<VerifyCE> = Vec::new();
    let ce_wins: bool = vf_prefers_counterexample(ces, soft_meta, fns);
    if ce_wins {
        ces_final = ces;
    }
    if has_flag(argv, "--replay-cex") && ces_final.len() > 0 {
        ces_final = replay_all(ces_final, fns, path, replay_main_start(argv, fr, path), argv[0], false);
    }
    let vstatus: String = { if ce_wins { String::from("") } else if soft_meta.len() >= 1 { soft_meta[0] } else { String::from("") } };
    let vmsg: String = { if ce_wins { String::from("") } else if soft_meta.len() >= 2 { soft_meta[1] } else { String::from("") } };
    let mut vf_func: String = String::from("");
    let mut vf_ce: String = String::from("");
    if status_str == String::from("VerifyFailed") {
        let legacy: Vec<String> = vf_legacy_fields(ces_final, soft_meta, fns);
        vf_func = legacy[0];
        vf_ce = legacy[1];
    }
    trace_write(tctx);
    vf_add_ce_diagnostics(dctx, ces_final);
    diag_emit_build_verify_json_full(status_str, out, dctx, ces_final, vstatus, vmsg, vf_func, vf_ce);
    if all_proven == 0 || any_skipped == 1 {
        return 1;
    }
    0
}


fn test_json_escape(s: String) -> String {
    diag_json_escape_str(s)
}

fn emit_test_entry_json(file: String, name: String, status: String, exit_code: i64, stdout: String, stderr: String, duration_ms: i64, diagnostics_json: String) -> String {
    let r: String = String::from("{\"file\":\"");
    r.push_str(test_json_escape(file));
    r.push_str(String::from("\",\"name\":\""));
    r.push_str(test_json_escape(name));
    r.push_str(String::from("\",\"status\":\""));
    r.push_str(status);
    r.push_str(String::from("\","));
    if exit_code >= 0 {
        r.push_str(String::from("\"exit_code\":"));
        r.push_str(i64_to_string(exit_code));
    } else {
        r.push_str(String::from("\"exit_code\":null"));
    }
    r.push_str(String::from(",\"stdout\":\""));
    r.push_str(test_json_escape(stdout));
    r.push_str(String::from("\",\"stderr\":\""));
    r.push_str(test_json_escape(stderr));
    r.push_str(String::from("\",\"duration_ms\":"));
    r.push_str(i64_to_string(duration_ms));
    r.push_str(String::from(",\"diagnostics\":"));
    r.push_str(diagnostics_json);
    r.push_str(String::from(",\"counterexamples\":[]}"));
    r
}

fn run_test(argv: Vec<String>) -> i32 [io, read, write] {
    let mut path: String = get_source_path_sub(argv);
    if path.len() == 0 {
        path = String::from(".");
    }
    let filter: String = get_flag_arg(argv, "--filter");
    let mode_str: String = get_flag_arg(argv, "--mode");
    let mode: i64 = {
        if mode_str == String::from("release") { 0 }
        else { 1 }
    };
    let timeout_str: String = get_flag_arg(argv, "--timeout");
    let timeout_ms: i64 = {
        if timeout_str.len() > 0 {
            match parse_i64(timeout_str) {
                Option::Some(value) => { value },
                Option::None => { 0 },
            }
        }
        else { 30000 }
    };
    let do_verify: bool = has_flag(argv, "--verify");
    let esbmc_bin: String = {
        if do_verify { esbmc_path() }
        else { String::from("") }
    };
    let t_mks_str: String = get_flag_arg(argv, "--max-k-step");
    let t_max_k_step: String = { if t_mks_str.len() > 0 { t_mks_str } else { String::from("50") } };
    let t_vec_max: i64 = VOW_VEC_MAX();
    let t_string_max: i64 = VOW_STRING_MAX();
    let t_hashmap_max: i64 = VOW_HASHMAP_MAX();
    let t_btreemap_max: i64 = VOW_BTREEMAP_MAX();
    let t_jobs: i64 = resolve_verify_jobs(argv);

    // Validate path exists
    if fs_exists(path) == 0 {
        print_str(String::from("{\"status\":\"CompileFailed\",\"total\":0,\"passed\":0,\"failed\":0,\"skipped\":0,\"tests\":[],\"contract_density\":{\"functions_total\":0,\"functions_with_vows\":0,\"density_pct\":0.0}}"));
        print_str(String::from("\n"));
        return 1;
    }

    let module_root_flag: String = get_flag_arg(argv, "--module-root");
    let selection: TestSelection = select_tests(path, filter, module_root_flag);
    let test_files: Vec<String> = selection.files;
    let mut module_root: String = selection.module_root;
    if module_root.len() == 0 && test_files.len() == 1 && fs_is_dir(path) == 0 {
        module_root = frontend_infer_module_root(path);
    }
    let worker_mode: bool = has_flag(argv, "--worker-entry");

    let entries_json: Vec<String> = Vec::new();
    let mut passed: i64 = 0;
    let mut failed: i64 = 0;
    let mut total_fns: i64 = 0;
    let mut fns_with_vows: i64 = 0;
    let mut ti: u64 = 0;
    let test_jobs: i64 = resolve_test_jobs(argv, do_verify);
    if !worker_mode && test_jobs > 1 && test_files.len() > 1 {
        let replies: Vec<String> = run_tests_parallel(argv[0], test_files, module_root, test_worker_common_flags(argv), test_jobs);
        let mut ri: u64 = 0;
        while ri < replies.len() {
            let one: TestOne = worker_reply_parse(replies[ri]);
            if one.status.len() == 0 {
                let crashed: String = emit_test_entry_json(test_files[ri], file_stem_from_path(test_files[ri]), String::from("compile_error"), -1, String::from(""), String::from(""), 0, String::from("[{\"error_code\":\"CompileError\",\"message\":\"test worker exited without a result\",\"severity\":\"error\"}]"));
                entries_json.push(crashed);
                failed = failed + 1;
            } else {
                entries_json.push(one.entry);
                if one.status == String::from("passed") { passed = passed + 1; } else { failed = failed + 1; }
                total_fns = total_fns + one.fns;
                fns_with_vows = fns_with_vows + one.vow_fns;
            }
            ri = ri + 1;
        }
        ti = test_files.len();
    }
    while ti < test_files.len() {
        let test_path: String = test_files[ti];
        let short_name: String = file_stem_from_path(test_path);
        let start_time: i64 = time_unix_ms();

        // Compile
        let fr: LoweredFrontend = frontend_lower_path_with_root(test_path, module_root);
        let checked: CheckedFrontend = fr.checked;
        if checked.n_errors > 0 {
            let duration: i64 = time_unix_ms() - start_time;
            diag_ctx_print_all(checked.dctx);
            let diag_json: String = diag_ctx_to_json(checked.dctx);
            let entry: String = emit_test_entry_json(test_path, short_name, String::from("compile_error"), -1, String::from(""), String::from(""), duration, diag_json);
            entries_json.push(entry);
            failed = failed + 1;
            ti = ti + 1;
        } else {
            let ir_mod: IrModule = fr.ir_mod;

            // Count contract density
            let fns2: Vec<IrFunction> = ir_mod.functions;
            let mut fi: u64 = 0;
            while fi < fns2.len() {
                let f: IrFunction = fns2[fi];
                if f.name != String::from("main") {
                    total_fns = total_fns + 1;
                    let vows: Vec<IrVowEntry> = f.vows;
                    if vows.len() > 0 {
                        fns_with_vows = fns_with_vows + 1;
                    }
                }
                fi = fi + 1;
            }

            // Verify if requested — bounded pool honoring --verify-jobs.
            let mut skip_exec: bool = false;
            if do_verify {
                let vfns: Vec<IrFunction> = ir_mod.functions;
                let vin_flight_h: Vec<i64> = Vec::new();
                let vin_flight_fi: Vec<i64> = Vec::new();
                let vin_flight_tmp: Vec<String> = Vec::new();
                let mut verify_failed: bool = false;
                let mut contract_skipped: bool = false;
                let t_dctx: DiagCtx = checked.dctx;
                let t_const_fns: Vec<i64> = detect_const_fns(ir_mod);
                let mut vfi: i64 = 0;
                while vfi < vfns.len() as i64 {
                    let vf: IrFunction = vfns[vfi as u64];
                    let vows: Vec<IrVowEntry> = vf.vows;
                    // Stop launching new ESBMC jobs after a failure is observed.
                    if vows.len() > 0 && !verify_failed {
                        while vin_flight_h.len() as i64 >= t_jobs {
                            let oh: i64 = vin_flight_h[0];
                            let ofi: i64 = vin_flight_fi[0];
                            let otmp: String = vin_flight_tmp[0];
                            let ovf: IrFunction = vfns[ofi as u64];
                            vec_i64_remove_front(vin_flight_h);
                            vec_i64_remove_front(vin_flight_fi);
                            vec_string_remove_front(vin_flight_tmp);
                            if oh == -1 || oh == -3 {
                                // ESBMC spawn/not-found failure: treat as verification failure, not silent success.
                                cleanup_verify_tmp_path(otmp);
                                verify_failed = true;
                            } else if oh != -2 {
                                // cmd_test launches verify_start with empty solver/encoding/timeout,
                                // so effective_timeout matches what start_esbmc passed: 30s under auto.
                                let t_eff: String = effective_timeout_for(String::from(""), String::from(""), String::from(""));
                                let ovr: VerifyResult = verify_collect(oh, ovf, t_eff, otmp, trace_off());
                                if ovr.status == VERIFY_FAILED() {
                                    verify_failed = true;
                                } else if ovr.status == VERIFY_TIMEOUT() || (ovr.status == VERIFY_UNKNOWN() && output_has_memory_limit(ovr.raw_output)) {
                                    // BV timed out or hit the memory cap; retry with IR before failing.
                                    let ovr2: VerifyResult = verify_function_ir_fallback(esbmc_bin, ovf, ir_mod, t_max_k_step, false, String::from(""), t_vec_max, t_string_max, t_hashmap_max, t_btreemap_max);
                                    if ovr2.status != VERIFY_PROVEN() && ovr2.status != VERIFY_PROVEN_IR() {
                                        verify_failed = true;
                                    }
                                } else if ovr.status == VERIFY_UNKNOWN() {
                                    // UNKNOWN is an explicit inconclusive BV outcome; do not let
                                    // a weaker IR proof turn it into a passing test.
                                    verify_failed = true;
                                }
                            }
                        }
                        if !verify_failed {
                            // Fail closed: a non-modelable contract was not statically proved.
                            // Reported as contract_skipped (ESBMC never invoked) rather than
                            // verify_failed (a proved violation); a real violation in any other
                            // function still sets verify_failed, which takes precedence (#386).
                            if skip_if_non_modelable(vf, ir_mod, t_const_fns, t_dctx) {
                                contract_skipped = true;
                            } else {
                                let vstarted: EsbmcStart = verify_start(esbmc_bin, vf, ir_mod, t_max_k_step, vfi, false, String::from(""), String::from(""), String::from(""), t_vec_max, t_string_max, t_hashmap_max, t_btreemap_max);
                                vin_flight_h.push(vstarted.handle);
                                vin_flight_fi.push(vfi);
                                vin_flight_tmp.push(vstarted.tmp_path);
                            }
                        }
                    }
                    vfi = vfi + 1;
                }
                while vin_flight_h.len() > 0 {
                    let oh: i64 = vin_flight_h[0];
                    let ofi: i64 = vin_flight_fi[0];
                    let otmp: String = vin_flight_tmp[0];
                    let ovf: IrFunction = vfns[ofi as u64];
                    vec_i64_remove_front(vin_flight_h);
                    vec_i64_remove_front(vin_flight_fi);
                    vec_string_remove_front(vin_flight_tmp);
                    if oh == -1 || oh == -3 {
                        // Spawn/not-found failure: critical when t_jobs >= nfns and every handle lands here.
                        cleanup_verify_tmp_path(otmp);
                        verify_failed = true;
                    } else if oh != -2 {
                        let t_eff: String = effective_timeout_for(String::from(""), String::from(""), String::from(""));
                        let ovr: VerifyResult = verify_collect(oh, ovf, t_eff, otmp, trace_off());
                        if ovr.status == VERIFY_FAILED() {
                            verify_failed = true;
                        } else if ovr.status == VERIFY_TIMEOUT() || (ovr.status == VERIFY_UNKNOWN() && output_has_memory_limit(ovr.raw_output)) {
                            // Mirror the bounded-pool drain: retry IR before treating Timeout or memlimit as passing.
                            // Without this, the common nfns <= t_jobs case silently accepts unverified functions.
                            let ovr2: VerifyResult = verify_function_ir_fallback(esbmc_bin, ovf, ir_mod, t_max_k_step, false, String::from(""), t_vec_max, t_string_max, t_hashmap_max, t_btreemap_max);
                            if ovr2.status != VERIFY_PROVEN() && ovr2.status != VERIFY_PROVEN_IR() {
                                verify_failed = true;
                            }
                        } else if ovr.status == VERIFY_UNKNOWN() {
                            // UNKNOWN is an explicit inconclusive BV outcome; do not let
                            // a weaker IR proof turn it into a passing test.
                            verify_failed = true;
                        }
                    }
                }
                if verify_failed {
                    let duration: i64 = time_unix_ms() - start_time;
                    let diag_vf: String = String::from("[{\"error_code\":\"VerifyFailed\",\"message\":\"contract verification failed\",\"severity\":\"error\"}]");
                    let entry: String = emit_test_entry_json(test_path, short_name, String::from("verify_failed"), -1, String::from(""), String::from(""), duration, diag_vf);
                    entries_json.push(entry);
                    failed = failed + 1;
                    skip_exec = true;
                } else if contract_skipped {
                    // Fail closed but distinguishable: ESBMC was never invoked
                    // because a vowed function is non-modelable (#386).
                    let duration: i64 = time_unix_ms() - start_time;
                    let diag_cs: String = String::from("[{\"error_code\":\"VerificationSkipped\",\"message\":\"contract verification skipped: function not modelable\",\"severity\":\"error\"}]");
                    let entry: String = emit_test_entry_json(test_path, short_name, String::from("contract_skipped"), -1, String::from(""), String::from(""), duration, diag_cs);
                    entries_json.push(entry);
                    failed = failed + 1;
                    skip_exec = true;
                }
            }

            if !skip_exec {
                // Compile to binary
                let worker_tag: String = { if worker_mode { str2(get_flag_arg(argv, "--worker-entry"), String::from("_")) } else { String::from("") } };
                let tmp_out: String = str2(str3(String::from("build/vow_test_"), short_name, String::from("_")), str2(worker_tag, i64_to_string(time_unix_ms())));
                let result: i64 = clif_emit_module(ir_mod, tmp_out, mode, 0);
                if result != 0 {
                    let duration: i64 = time_unix_ms() - start_time;
                    let codegen_diag: Diagnostic = codegen_failure_diagnostic(result, test_path, str2(tmp_out, String::from(".o")));
                    diag_eprintln_best_effort(diag_to_human(codegen_diag, checked.dctx));
                    let diag_json2: String = str3(String::from("["), diag_to_json(codegen_diag), String::from("]"));
                    let entry: String = emit_test_entry_json(test_path, short_name, String::from("compile_error"), -1, String::from(""), String::from(""), duration, diag_json2);
                    entries_json.push(entry);
                    failed = failed + 1;
                } else {
                    // Execute with a timeout
                    let no_args: Vec<String> = Vec::new();
                    let handle: i64 = process_start(tmp_out, no_args);
                    let exit_code: i64 = process_wait_timeout(handle, timeout_ms);
                    let stdout: String = {
                        if exit_code == -2 {
                            process_kill(handle);
                            String::from("")
                        } else {
                            process_stdout_for(handle)
                        }
                    };
                    let stderr: String = {
                        if exit_code == -2 {
                            String::from("timeout")
                        } else {
                            process_stderr_for(handle)
                        }
                    };
                    fs_remove(tmp_out);
                    process_kill(handle);
                    let duration: i64 = time_unix_ms() - start_time;
                    let status: String = {
                        if exit_code == 0 { String::from("passed") }
                        else if exit_code == -2 { String::from("timeout") }
                        else { String::from("failed") }
                    };
                    if exit_code == 0 {
                        passed = passed + 1;
                    } else {
                        failed = failed + 1;
                    }
                    let entry: String = emit_test_entry_json(test_path, short_name, status, exit_code, stdout, stderr, duration, String::from("[]"));
                    entries_json.push(entry);
                }
            }
            ti = ti + 1;
        }
    }

    if worker_mode {
        let wstatus: String = { if passed == 1 { String::from("passed") } else { String::from("failed") } };
        if entries_json.len() == 0 { return 1; }
        print_str(worker_reply_line(TestOne { status: wstatus, entry: entries_json[0], fns: total_fns, vow_fns: fns_with_vows }));
        return 0;
    }

    // Emit JSON result
    let total: i64 = passed + failed;
    let result_status: String = {
        if failed > 0 { String::from("TestsFailed") }
        else { String::from("TestsPassed") }
    };
    let density_pct: i64 = {
        if total_fns > 0 { (fns_with_vows * 1000) / total_fns }
        else { 0 }
    };
    let r: String = String::from("{\"status\":\"");
    r.push_str(result_status);
    r.push_str(String::from("\",\"total\":"));
    r.push_str(i64_to_string(total));
    r.push_str(String::from(",\"passed\":"));
    r.push_str(i64_to_string(passed));
    r.push_str(String::from(",\"failed\":"));
    r.push_str(i64_to_string(failed));
    r.push_str(String::from(",\"skipped\":0,\"tests\":["));
    let mut ji: u64 = 0;
    while ji < entries_json.len() {
        if ji > 0 {
            r.push_str(String::from(","));
        }
        r.push_str(entries_json[ji]);
        ji = ji + 1;
    }
    r.push_str(String::from("],\"contract_density\":{\"functions_total\":"));
    r.push_str(i64_to_string(total_fns));
    r.push_str(String::from(",\"functions_with_vows\":"));
    r.push_str(i64_to_string(fns_with_vows));
    r.push_str(String::from(",\"density_pct\":"));
    // Emit density as X.Y
    let whole: i64 = density_pct / 10;
    let frac: i64 = density_pct - (whole * 10);
    r.push_str(i64_to_string(whole));
    r.push_str(String::from("."));
    r.push_str(i64_to_string(frac));
    r.push_str(String::from("}}"));
    print_str(r);
    if failed > 0 {
        return 1;
    }
    0
}

