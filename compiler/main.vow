// Usage error for a misplaced or malformed `--backend`, else "". Only `verify`,
// `contracts --verify` and `test --verify` have a native backend; accepting the
// flag elsewhere would run ESBMC silently.
fn backend_flag_error(argv: Vec<String>, cmd: i64) -> String {
    if !has_flag(argv, "--backend") {
        return String::from("");
    }
    let backend: String = get_flag_arg(argv, "--backend");
    if backend != "esbmc" && backend != "native" {
        return String::from("error: --backend must be `esbmc` or `native`");
    }
    if backend == "esbmc" {
        return String::from("");
    }
    let verifying: bool = cmd == CMD_VERIFY() || ((cmd == CMD_CONTRACTS() || cmd == CMD_TEST()) && has_flag(argv, "--verify"));
    if !verifying {
        if cmd == CMD_CONTRACTS() || cmd == CMD_TEST() {
            return String::from("error: --backend native requires --verify");
        }
        return String::from("error: --backend native is only supported by `vowc verify`, `vowc contracts --verify` and `vowc test --verify`");
    }
    if has_flag(argv, "--max-k-step") {
        return String::from("error: --max-k-step is not supported with --backend native");
    }
    if has_flag(argv, "--solver") {
        return String::from("error: --solver is not supported with --backend native");
    }
    if has_flag(argv, "--encoding") {
        return String::from("error: --encoding is not supported with --backend native");
    }
    String::from("")
}

fn main() -> i32 [io, read, write] {
    let argv: Vec<String> = args();
    if has_flag(argv, "--help") {
        if has_flag(argv, "--human") {
            print_str(skill_human());
        } else {
            print_str(skill_json());
        }
        return 0;
    }
    if argv.len() <= 1 {
        diag_eprintln_best_effort("vow: source file required (try --help or use a subcommand)");
        return 1;
    }
    let cmd: i64 = get_subcommand(argv);
    let backend_error: String = backend_flag_error(argv, cmd);
    if backend_error.len() > 0 {
        diag_eprintln_best_effort(backend_error);
        return 1;
    }
    let flag_error: String = cli_flag_error(argv, cmd);
    if flag_error.len() > 0 {
        diag_eprintln_best_effort(flag_error);
        return 2;
    }
    if cmd == CMD_TEST() {
        return run_test(argv);
    }
    if cmd == CMD_SKILL() {
        return run_skill(argv);
    }
    if cmd == CMD_BUILD() {
        maybe_auto_install_skill();
        return run_build(argv);
    }
    if cmd == CMD_VERIFY() {
        return run_verify(argv);
    }
    if cmd == CMD_CONTRACTS() {
        return run_contracts(argv);
    }
    if cmd == CMD_MUTANTS() {
        return run_mutants(argv);
    }
    if cmd == CMD_COMPLEXITY() {
        return run_complexity(argv);
    }
    if cmd == CMD_DECL() {
        return run_decl(argv);
    }
    if cmd == CMD_VERIFY_WORKER() {
        return run_verify_worker(argv);
    }
    if get_source_path(argv).len() == 0 {
        diag_eprintln_best_effort("vow: source file required (try --help or use a subcommand)");
        return 1;
    }
    maybe_auto_install_skill();
    run_build_cmd(argv, false)
}
