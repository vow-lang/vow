module VcPtrHandle

use ir
use vc_ops
use vc_heap

// A handle stored into a `Vec` that also holds objects (`mixed.push(src[0])`, #1663). The IR types a
// pointer an element read returned `i64`, so storing it is no pointer store (`vc_ptr_store_value`): a
// `Vec` that receives only handles is read like any `Vec` of words. A `Vec` that also receives an
// object (`held`) then holds two kinds of word, the address of an object the function stored and a
// word of the memory it was given, which the model cannot tell apart. Only a direct `get` result is
// admitted; any other `i64` stored (a field read, a Phi, a call result) keeps its skip.
//
// The word is stored as it is (`vc_walk_slot_word`), so a read of the slot returns the same term, and
// a read through it is the `ite` chain over the entries ending in the heap array, which is exact for
// both kinds. What a `Vec` of addresses alone may assume does not hold for it: the chain must keep
// its array arm (`VcOverlay.exact` off), and no element of its elements is a stored word
// (`vc_elem_derived`); a field written through one of its elements stays refused.

// 1 for the result of a `Vec` `get`, 0 for every other value.
fn vc_ptr_handle_gets(f: IrFunction, n_ids: u64) -> Vec<i64> {
    let gets: Vec<i64> = Vec::new();
    let mut i: u64 = 0;
    while i < n_ids {
        gets.push(0);
        i = i + 1;
    }
    let mut bi: u64 = 0;
    while bi < f.blocks.len() {
        let blk: IrBlock = f.blocks[bi];
        let mut ii: u64 = 0;
        while ii < blk.insts.len() {
            let inst: IrInst = blk.insts[ii];
            if inst.op == IOP_CALL() && inst.id >= 0 && (inst.id as u64) < n_ids && inst.ty == ITY_I64()
                && vc_inst_vec_kind(inst) == VC_VEC_GET() {
                gets[inst.id as u64] = 1;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    gets
}

// True when `id` is the result of a `Vec` `get`.
fn vc_ptr_handle_is_get(gets: Vec<i64>, id: i64) -> bool {
    id >= 0 && (id as u64) < gets.len() && gets[id as u64] == 1
}

// True when a `push` or `set` stores the result of a `get` into a receiver of a pointer store.
fn vc_ptr_store_handles(f: IrFunction, held: Vec<i64>, tys: Vec<i64>) -> bool {
    let gets: Vec<i64> = vc_ptr_handle_gets(f, tys.len());
    let mut bi: u64 = 0;
    while bi < f.blocks.len() {
        let blk: IrBlock = f.blocks[bi];
        let mut ii: u64 = 0;
        while ii < blk.insts.len() {
            let inst: IrInst = blk.insts[ii];
            let stored: i64 = vc_inst_stored_operand(inst);
            if inst.op == IOP_CALL() && stored >= 0 && inst.args.len() > 0 && vc_ptr_handle_is_get(gets, stored)
                && inst.args[0] >= 0 && (inst.args[0] as u64) < held.len() && held[inst.args[0] as u64] == 1 {
                return true;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    false
}
