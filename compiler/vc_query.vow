module VcQuery

use ir
use vc_ops
use vc_term
use vc_heap
use vc_smt

// Claim recording and query construction. Recording captures header and assumption
// prefixes; full, selected, incremental and hook callers ask this module to assemble
// them. Solver transport, cone selection and verdict decisions stay with callers.

// One shared command list (`header`) and one append-only assumption list serve
// every claim: claim `k` is the first `header_lens[k]` header commands, the
// first `assumed_lens[k]` assumptions and its negated goal. Queries are built
// on demand by `vc_claim_script`, so memory stays linear in the function size.
struct VcClaims {
    arena: VcArena,
    header: SmtScript,
    assumed: Vec<i64>,
    kinds: Vec<i64>,
    frames: Vec<i64>,
    fr: VcFrames,
    pre_only: bool,
    step: bool,
    hyp_now: bool,
    vow_ids: Vec<i64>,
    labels: Vec<String>,
    ostarts: Vec<i64>,
    olens: Vec<i64>,
    negated_goals: Vec<i64>,
    header_lens: Vec<i64>,
    assumed_lens: Vec<i64>,
    model_names: Vec<String>,
    model_params: Vec<i64>,
    // Parallel to `model_params`: the path from the parameter to the child object a
    // field belongs to (`.1` for the payload in slot 1), "" for the parameter itself.
    model_paths: Vec<String>,
    model_tys: Vec<i64>,
    model_widths: Vec<i64>,
    model_slots: Vec<i64>,
    model_hdr: Vec<i64>,
    model_ambig: Vec<i64>,
    hook_vars: Vec<i64>,
    map_vars: Vec<i64>,
    vec_param: Vec<i64>,
    vec_arr: Vec<String>,
    vec_len: Vec<String>,
    vec_hdr: Vec<i64>,
    // Parallel to `vec_param`: the element type of a parameter whose elements are
    // 128-bit integers (`ITY_I128`/`ITY_U128`), else -1.
    vec_wide: Vec<i64>,
    // Parallel to `vec_param`: "" for a `Vec` or `String` parameter; for a collection a struct
    // parameter holds in a field, the path to that field (`.1.0`, see `vc_held`), and the symbol
    // of the address the field holds, whose `helem`/`hbyte` entries the elements are.
    vec_path: Vec<String>,
    vec_handle: Vec<String>,
    // The lengths of the `HashMap` and `BTreeMap` parameters (`vc_map`) the way `vec_len` has
    // those of a `Vec`: the symbol and the header position of its declaration.
    map_len: Vec<String>,
    map_len_hdr: Vec<i64>,
    // The fields the function read through a handle that the counterexample lists (`vc_heaplist`).
    listed: VcHeapListed,
}

fn VC_CLAIM_ENSURES() -> i64 { 0 }
fn VC_CLAIM_DIV_ZERO() -> i64 { 1 }
fn VC_CLAIM_DIV_OVERFLOW() -> i64 { 2 }
fn VC_CLAIM_SHIFT_COUNT() -> i64 { 3 }
fn VC_CLAIM_ARITH() -> i64 { 4 }
fn VC_CLAIM_UNWRAP_NONE() -> i64 { 5 }
fn VC_CLAIM_UNWIND() -> i64 { 6 }
fn VC_CLAIM_CALLER_PRE() -> i64 { 7 }
fn VC_CLAIM_CALLEE_POST() -> i64 { 8 }
fn VC_CLAIM_VEC_BOUNDS() -> i64 { 9 }

// Allocate storage without imposing a query prologue. The two constructors
// below share this initialization without allocating unused frame metadata.
fn vc_claims_storage(fr: VcFrames, pre_only: bool, step: bool) -> VcClaims {
    let cs: VcClaims = VcClaims {
        arena: vc_arena_new(),
        header: vc_script_new(),
        assumed: Vec::new(),
        kinds: Vec::new(),
        frames: Vec::new(),
        fr: fr,
        pre_only: pre_only,
        step: step,
        hyp_now: false,
        vow_ids: Vec::new(),
        labels: Vec::new(),
        ostarts: Vec::new(),
        olens: Vec::new(),
        negated_goals: Vec::new(),
        header_lens: Vec::new(),
        assumed_lens: Vec::new(),
        model_names: Vec::new(),
        model_params: Vec::new(),
        model_paths: Vec::new(),
        model_tys: Vec::new(),
        model_widths: Vec::new(),
        model_slots: Vec::new(),
        model_hdr: Vec::new(),
        model_ambig: Vec::new(),
        hook_vars: Vec::new(),
        vec_param: Vec::new(),
        vec_arr: Vec::new(),
        vec_len: Vec::new(),
        vec_hdr: Vec::new(),
        map_vars: Vec::new(),
        vec_wide: Vec::new(),
        vec_path: Vec::new(),
        vec_handle: Vec::new(),
        map_len: Vec::new(),
        map_len_hdr: Vec::new(),
        listed: vc_heap_listed_new(),
    };
    cs
}

// A complete production recording session; the executor finalizes the logic
// command after discovering which theories the function uses.
fn vc_claims_new(fr: VcFrames, pre_only: bool, step: bool) -> VcClaims {
    let cs: VcClaims = vc_claims_storage(fr, pre_only, step);
    vc_script_set_logic(cs.header, String::from("QF_BV"));
    vc_script_set_option(cs.header, String::from(":produce-models"), String::from("true"));
    cs
}

// Empty storage for consumers constructing partial model/query snapshots.
fn vc_claims_empty() -> VcClaims {
    vc_claims_storage(vc_frames_new(), false, false)
}

// Records the claim that `goal` holds on the paths satisfying `pc`, unless the
// simplifier already decided it: the negated query is the constant `false`, or
// `pc => goal` is itself an earlier assumption (the terms are hash-consed, so
// equal formulas are one id). Both are `unsat` under any assumptions, so the
// solver would only confirm what the claim list already says.
fn vc_add_claim(cs: VcClaims, kind: i64, vow_id: i64, label: String, pc: i64, goal: i64, ostart: i64, olen: i64, frame: i64) {
    if cs.hyp_now {
        return;
    }
    if cs.pre_only && kind != VC_CLAIM_CALLER_PRE() && kind != VC_CLAIM_UNWIND() {
        return;
    }
    let ar: VcArena = cs.arena;
    let negated: i64 = vc_tm_and(ar, pc, vc_tm_app1(ar, VC_OP_NOT(), goal));
    if vc_tm_is_false(ar, negated) {
        return;
    }
    if cs.assumed.len() > 0 {
        if ar.assumed[vc_tm_implies(ar, pc, goal) as u64] == 1 {
            return;
        }
    }
    let hdr: SmtScript = cs.header;
    cs.kinds.push(kind);
    cs.frames.push(frame);
    cs.vow_ids.push(vow_id);
    cs.labels.push(label);
    cs.ostarts.push(ostart);
    cs.olens.push(olen);
    cs.negated_goals.push(negated);
    cs.header_lens.push(hdr.kinds.len() as i64);
    cs.assumed_lens.push(cs.assumed.len() as i64);
}

fn vc_assume(cs: VcClaims, pc: i64, t: i64) {
    let ar: VcArena = cs.arena;
    let fact: i64 = vc_tm_implies(ar, pc, t);
    if vc_tm_is_true(ar, fact) {
        return;
    }
    ar.assumed[fact as u64] = 1;
    cs.assumed.push(fact);
}

// Claims `goal` on the paths reaching `inst`, then assumes it.
fn vc_guard(cs: VcClaims, kind: i64, label: String, pc: i64, goal: i64, inst: IrInst) {
    vc_add_claim(cs, kind, -1, label, pc, goal, inst.ostart, inst.olen, vc_frame_of(inst));
    vc_assume(cs, pc, goal);
}

// `model_slots` of the length of a `Vec` or `String` parameter; a scalar
// parameter is -1, an aggregate parameter's identity `VC_ALIAS_SLOT` (-2) and a
// field of an aggregate one its slot, 0 or more.
fn VC_SLOT_VEC_LEN() -> i64 { -3 }

// `model_slots` of the address a parameter that may be the memory a handle names carries
// (`vc_overlay`): `<param>.addr` in a counterexample.
fn VC_SLOT_ADDR() -> i64 { -4 }

// `model_slots` of the three entries that tell a key a `HashMap` or `BTreeMap` parameter was
// asked about (`vc_map`): the key, its presence word in the parameter's own state, and the value
// slot it holds there. A counterexample lists the three as one `<param>[<key>]` entry.
fn VC_SLOT_MAP_KEY() -> i64 { -5 }

fn VC_SLOT_MAP_PRES() -> i64 { -6 }

fn VC_SLOT_MAP_VAL() -> i64 { -7 }

// Number of model symbols claim `k`'s query declares: the header is only
// declared up to `header_lens[k]`, and `get-value` of a symbol declared later
// is a solver error. Symbols are listed in declaration order, so these are the
// first entries of every `model_*` list.
fn vc_claim_model_count(cs: VcClaims, k: u64) -> u64 {
    let mut n: u64 = 0;
    while n < cs.model_hdr.len() && cs.model_hdr[n] < cs.header_lens[k] {
        n = n + 1;
    }
    n
}

fn vc_claim_model_names(cs: VcClaims, k: u64) -> Vec<String> {
    let out: Vec<String> = Vec::new();
    let n: u64 = vc_claim_model_count(cs, k);
    let mut j: u64 = 0;
    while j < n {
        out.push(cs.model_names[j]);
        j = j + 1;
    }
    out
}

fn vc_claim_model_widths(cs: VcClaims, k: u64) -> Vec<i64> {
    let out: Vec<i64> = Vec::new();
    let n: u64 = vc_claim_model_count(cs, k);
    let mut j: u64 = 0;
    while j < n {
        out.push(cs.model_widths[j]);
        j = j + 1;
    }
    out
}

// The tail every query of claim `k` ends in: its negated goal, the check and
// the model request.
fn vc_claim_script_finish(s: SmtScript, cs: VcClaims, k: u64) -> SmtScript {
    vc_script_assert(s, cs.negated_goals[k]);
    vc_script_check_sat(s);
    vc_script_get_value(s, vc_claim_model_names(cs, k));
    s
}

// An independent full prefix, without the goal, check or model request.
// Hook confirmation adds its own question without mutating shared storage.
fn vc_claim_context_script(cs: VcClaims, k: u64) -> SmtScript {
    let hdr: SmtScript = cs.header;
    let s: SmtScript = vc_script_prefix(hdr, cs.header_lens[k] as u64);
    let na: u64 = cs.assumed_lens[k] as u64;
    let mut i: u64 = 0;
    while i < na {
        vc_script_assert(s, cs.assumed[i]);
        i = i + 1;
    }
    s
}

// The self-contained query that decides claim `k`, with its visible model.
fn vc_claim_script(cs: VcClaims, k: u64) -> SmtScript {
    vc_claim_script_finish(vc_claim_context_script(cs, k), cs, k)
}

// The exact standalone text also serves as the result-cache key.
fn vc_claim_query(cs: VcClaims, k: u64) -> String {
    vc_smt_render(cs.arena, vc_claim_script(cs, k))
}

// The slicer supplies ascending header/assumption indices inside claim `k`'s
// recorded prefix. It owns dependency closure; this module owns assembly and
// the ordinary query tail. All declarations remain in the selected header.
fn vc_claim_script_selected(cs: VcClaims, k: u64, commands: Vec<i64>, assumptions: Vec<i64>) -> SmtScript {
    let hdr: SmtScript = cs.header;
    let s: SmtScript = vc_script_new();
    let mut i: u64 = 0;
    while i < commands.len() {
        let c: u64 = commands[i] as u64;
        vc_script_push(s, hdr.kinds[c], hdr.names[c], hdr.vals[c], hdr.sorts[c], hdr.terms[c]);
        i = i + 1;
    }
    let mut j: u64 = 0;
    while j < assumptions.len() {
        vc_script_assert(s, cs.assumed[assumptions[j] as u64]);
        j = j + 1;
    }
    vc_claim_script_finish(s, cs, k)
}

// A session's capability probe sends this header without assumptions, goal,
// check or model request. Rendering directly avoids temporary command arrays.
fn vc_claim_header_text(cs: VcClaims, k: u64) -> String {
    vc_smt_render_cmds(cs.arena, cs.header, 0, cs.header_lens[k] as u64)
}

// The unsent part of the full claim context: header commands first, then
// assumptions. Session cursors refer to successful writes and must not exceed
// this claim's recorded lengths; claims are asked in prefix order.
fn vc_claim_context_delta(cs: VcClaims, k: u64, sent_header: u64, sent_assumptions: u64) -> String {
    let out: String = vc_smt_render_cmds(cs.arena, cs.header, sent_header, cs.header_lens[k] as u64);
    let na: u64 = cs.assumed_lens[k] as u64;
    let mut i: u64 = sent_assumptions;
    while i < na {
        vc_smt_push_assert(out, cs.arena, cs.assumed[i]);
        out.push_str(String::from("\n"));
        i = i + 1;
    }
    out
}
