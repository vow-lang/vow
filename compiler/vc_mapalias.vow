module VcMapAlias

use ir
use ir_dominance
use vc_term
use vc_agg
use vc_sources
use vc_objects
use vc_map
use vc_mapops
use vc_mapkeys

// `HashMap` (or `BTreeMap`) parameters of one declared type may be one object, as `Vec` and
// `String` parameters may (`vc_vecalias`, ADR-2026-10-19-1700): a change through one is a change
// of the other, and two are one object exactly when their identities are equal. A function needs
// identities when it changes a map it was given and has two map parameters of one declared type
// (`HashMap<i64,i64>` and `BTreeMap<i64,i64>` are two types). A map is never passed to a call
// (`vc_mapgate`); one merged by a Phi is each map it merges (`vc_sources_leaves`), and a write
// through the Phi reaches each of them, spread to the parameters that may be one object.

// Adds the class `VC_OV_MAP` to the parameters `f` uses as the object of a map operation, and
// `VC_VA_CHANGED` to those it changes, in `cls` (per parameter). `src` and `arg_param` are the
// function's sources and `GetArg` parameters (`vc_sources_new`, `vc_agg_arg_params`).
fn vc_mapalias_classes(f: IrFunction, src: VcSources, arg_param: Vec<i64>, n_ids: u64, cls: Vec<i64>) {
    let mut bi: u64 = 0;
    while bi < f.blocks.len() {
        let blk: IrBlock = f.blocks[bi];
        let mut ii: u64 = 0;
        while ii < blk.insts.len() {
            let inst: IrInst = blk.insts[ii];
            let k: i64 = vc_inst_map_kind(inst);
            let havoc: bool = vc_is_havoc_map(inst);
            if (havoc || (k != VC_MAP_NONE() && k != VC_MAP_NEW())) && inst.args.len() > 0 {
                let leaves: Vec<i64> = vc_sources_leaves(src, inst.args[0]);
                let mut li: u64 = 0;
                while li < leaves.len() {
                    let l: i64 = leaves[li];
                    if l >= 0 && (l as u64) < n_ids && arg_param[l as u64] >= 0 {
                        let p: u64 = arg_param[l as u64] as u64;
                        cls[p] = cls[p] | VC_OV_MAP();
                        if havoc || vc_map_kind_mutates(k) { cls[p] = cls[p] | VC_VA_CHANGED(); }
                    }
                    li = li + 1;
                }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
}

// Gives the map parameters among the aliasable ones (`ag.al_params`, identities already declared)
// their slots, and relates them: parameters of one type group that have equal identities have
// equal initial contents, and `vc_map_write` spreads a write to each. `cls` is
// `vc_vecalias_classes`.
fn vc_mapalias_enable(mp: VcMap, ag: VcAgg, ar: VcArena, hdr: SmtScript, assumed: Vec<i64>, cls: Vec<i64>) {
    let pos: Vec<i64> = Vec::new();
    let mut i: u64 = 0;
    while i < ag.al_params.len() {
        if (cls[ag.al_params[i] as u64] & VC_OV_MAP()) != 0 {
            mp.al_slot.push(vc_map_slot(mp, ag, ar, hdr, assumed, vc_agg_param(ag, ag.al_params[i])));
            pos.push(i as i64);
        }
        i = i + 1;
    }
    let n: u64 = mp.al_slot.len();
    let mut a: u64 = 0;
    while a < n * n {
        mp.al_same.push(-1);
        a = a + 1;
    }
    a = 0;
    while a < n {
        let mut b: u64 = 0;
        while b < a {
            if vc_agg_same_group(ag, pos[a], pos[b]) {
                let same: i64 = vc_agg_same_object(ag, ar, hdr, pos[a], pos[b]);
                mp.al_same[a * n + b] = same;
                mp.al_same[b * n + a] = same;
                let sa: u64 = mp.al_slot[a] as u64;
                let sb: u64 = mp.al_slot[b] as u64;
                let pres: i64 = vc_tm_app2(ar, VC_OP_EQ(), mp.base_pres[sa], mp.base_pres[sb]);
                let vals: i64 = vc_tm_app2(ar, VC_OP_EQ(), mp.base_vals[sa], mp.base_vals[sb]);
                let len: i64 = vc_tm_app2(ar, VC_OP_EQ(), mp.base_len[sa], mp.base_len[sb]);
                let equal: i64 = vc_tm_app2(ar, VC_OP_AND(), vc_tm_app2(ar, VC_OP_AND(), pres, vals), len);
                assumed.push(vc_tm_app2(ar, VC_OP_OR(), vc_tm_app1(ar, VC_OP_NOT(), same), equal));
            }
            b = b + 1;
        }
        a = a + 1;
    }
}
