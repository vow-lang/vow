module MainTestVerify

fn test_json_escape(s: String) -> String {
    diag_json_escape_str(s)
}

fn emit_test_entry_json(file: String, name: String, status: String, exit_code: i64, stdout: String, stderr: String, duration_ms: i64, diagnostics_json: String) -> String {
    let r: String = String::from("{\"file\":\"");
    r.push_str(test_json_escape(file));
    r.push_str(String::from("\",\"name\":\""));
    r.push_str(test_json_escape(name));
    r.push_str(String::from("\",\"status\":\""));
    r.push_str(status);
    r.push_str(String::from("\","));
    if exit_code >= 0 {
        r.push_str(String::from("\"exit_code\":"));
        r.push_str(i64_to_string(exit_code));
    } else {
        r.push_str(String::from("\"exit_code\":null"));
    }
    r.push_str(String::from(",\"stdout\":\""));
    r.push_str(test_json_escape(stdout));
    r.push_str(String::from("\",\"stderr\":\""));
    r.push_str(test_json_escape(stderr));
    r.push_str(String::from("\",\"duration_ms\":"));
    r.push_str(i64_to_string(duration_ms));
    r.push_str(String::from(",\"diagnostics\":"));
    r.push_str(diagnostics_json);
    r.push_str(String::from(",\"counterexamples\":[]}"));
    r
}

// What `test --verify --backend native` found in one test file. Every vowed
// function must be proven: unlike the ESBMC path, an `error` or `panicked`
// verdict fails the test, since nothing was established for that function.
// `failed` takes precedence over `skipped`, as in the ESBMC path.
struct TestNativeVerdict {
    failed: bool,
    skipped: bool,
    diag_json: String,
}

fn test_native_verify(ir_mod: IrModule, exe: String, test_path: String, module_root: String, jobs: i64, dctx: DiagCtx) -> TestNativeVerdict [io, read, write] {
    let drv: VcDriverRun = vc_driver_run(exe, test_path, module_root, ir_mod, false, jobs, watchdog_ms_for(String::from("")));
    let fns: Vec<IrFunction> = ir_mod.functions;
    let mut failed: bool = false;
    let mut skipped: bool = false;
    let mut fi: u64 = 0;
    while fi < fns.len() {
        if drv.skip[fi].len() > 0 {
            native_skip_function(fns[fi], drv.skip[fi], dctx);
            skipped = true;
        } else if drv.ran[fi] == 1 {
            let oc: VcOutcome = drv.outcomes[fi];
            if oc.result.status != VERIFY_PROVEN() { failed = true; }
        }
        fi = fi + 1;
    }
    let mut diag: String = String::from("[]");
    if failed {
        diag = String::from("[{\"error_code\":\"VerifyFailed\",\"message\":\"contract verification failed\",\"severity\":\"error\"}]");
    } else if skipped {
        diag = String::from("[{\"error_code\":\"VerificationSkipped\",\"message\":\"contract verification skipped: function not modelable\",\"severity\":\"error\"}]");
    }
    TestNativeVerdict { failed: failed, skipped: skipped, diag_json: diag }
}

fn test_esbmc_verdict(ir_mod: IrModule, dctx: DiagCtx, esbmc_bin: String, t_max_k_step: String, t_jobs: i64) -> i64 [io, read, write] {
    let t_vec_max: i64 = VOW_VEC_MAX();
    let t_string_max: i64 = VOW_STRING_MAX();
    let t_hashmap_max: i64 = VOW_HASHMAP_MAX();
    let t_btreemap_max: i64 = VOW_BTREEMAP_MAX();
    let vfns: Vec<IrFunction> = ir_mod.functions;
    let vin_flight_h: Vec<i64> = Vec::new();
    let vin_flight_fi: Vec<i64> = Vec::new();
    let vin_flight_tmp: Vec<String> = Vec::new();
    let mut verify_failed: bool = false;
    let mut contract_skipped: bool = false;
    let t_dctx: DiagCtx = dctx;
    let t_const_fns: Vec<i64> = detect_const_fns(ir_mod);
    let mut vfi: i64 = 0;
    while vfi < vfns.len() as i64 {
        let vf: IrFunction = vfns[vfi as u64];
        let vows: Vec<IrVowEntry> = vf.vows;
        if vows.len() > 0 {
            // Fail closed: a non-modelable contract was not statically proved.
            // Reported as contract_skipped (ESBMC never invoked) rather than
            // verify_failed (a proved violation); a real violation in any other
            // function still sets verify_failed, which takes precedence (#386).
            if skip_if_non_modelable(vf, ir_mod, t_const_fns, t_dctx) {
                contract_skipped = true;
            } else if !verify_failed {
                // Stop launching new ESBMC jobs after a failure is observed.
                while vin_flight_h.len() as i64 >= t_jobs {
                    let oh: i64 = vin_flight_h[0];
                    let ofi: i64 = vin_flight_fi[0];
                    let otmp: String = vin_flight_tmp[0];
                    let ovf: IrFunction = vfns[ofi as u64];
                    vec_i64_remove_front(vin_flight_h);
                    vec_i64_remove_front(vin_flight_fi);
                    vec_string_remove_front(vin_flight_tmp);
                    if oh == -1 || oh == -3 {
                        // ESBMC spawn/not-found failure: treat as verification failure, not silent success.
                        cleanup_verify_tmp_path(otmp);
                        verify_failed = true;
                    } else if oh != -2 {
                        // cmd_test launches verify_start with empty solver/encoding/timeout,
                        // so effective_timeout matches what start_esbmc passed: 30s under auto.
                        let t_eff: String = effective_timeout_for(String::from(""), String::from(""), String::from(""));
                        let ovr: VerifyResult = verify_collect(oh, ovf, t_eff, otmp, trace_off());
                        if ovr.status == VERIFY_FAILED() {
                            verify_failed = true;
                        } else if bv_resource_limited(ovr.status, ovr.raw_output) {
                            // BV timed out or hit the memory cap; retry with IR before failing.
                            let ovr2: VerifyResult = verify_function_ir_fallback(esbmc_bin, ovf, ir_mod, t_max_k_step, false, String::from(""), t_vec_max, t_string_max, t_hashmap_max, t_btreemap_max);
                            if ovr2.status != VERIFY_PROVEN() && ovr2.status != VERIFY_PROVEN_IR() {
                                verify_failed = true;
                            }
                        } else if ovr.status == VERIFY_UNKNOWN() {
                            // UNKNOWN is an explicit inconclusive BV outcome; do not let
                            // a weaker IR proof turn it into a passing test.
                            verify_failed = true;
                        }
                    }
                }
                if !verify_failed {
                    let vstarted: EsbmcStart = verify_start(esbmc_bin, vf, ir_mod, t_max_k_step, vfi, false, String::from(""), String::from(""), String::from(""), t_vec_max, t_string_max, t_hashmap_max, t_btreemap_max);
                    vin_flight_h.push(vstarted.handle);
                    vin_flight_fi.push(vfi);
                    vin_flight_tmp.push(vstarted.tmp_path);
                }
            }
        }
        vfi = vfi + 1;
    }
    while vin_flight_h.len() > 0 {
        let oh: i64 = vin_flight_h[0];
        let ofi: i64 = vin_flight_fi[0];
        let otmp: String = vin_flight_tmp[0];
        let ovf: IrFunction = vfns[ofi as u64];
        vec_i64_remove_front(vin_flight_h);
        vec_i64_remove_front(vin_flight_fi);
        vec_string_remove_front(vin_flight_tmp);
        if oh == -1 || oh == -3 {
            // Spawn/not-found failure: critical when t_jobs >= nfns and every handle lands here.
            cleanup_verify_tmp_path(otmp);
            verify_failed = true;
        } else if oh != -2 {
            let t_eff: String = effective_timeout_for(String::from(""), String::from(""), String::from(""));
            let ovr: VerifyResult = verify_collect(oh, ovf, t_eff, otmp, trace_off());
            if ovr.status == VERIFY_FAILED() {
                verify_failed = true;
            } else if bv_resource_limited(ovr.status, ovr.raw_output) {
                // Mirror the bounded-pool drain: retry IR before treating Timeout or memlimit as passing.
                // Without this, the common nfns <= t_jobs case silently accepts unverified functions.
                let ovr2: VerifyResult = verify_function_ir_fallback(esbmc_bin, ovf, ir_mod, t_max_k_step, false, String::from(""), t_vec_max, t_string_max, t_hashmap_max, t_btreemap_max);
                if ovr2.status != VERIFY_PROVEN() && ovr2.status != VERIFY_PROVEN_IR() {
                    verify_failed = true;
                }
            } else if ovr.status == VERIFY_UNKNOWN() {
                // UNKNOWN is an explicit inconclusive BV outcome; do not let
                // a weaker IR proof turn it into a passing test.
                verify_failed = true;
            }
        }
    }
    if verify_failed {
        return 1;
    }
    if contract_skipped {
        return 2;
    }
    0
}
