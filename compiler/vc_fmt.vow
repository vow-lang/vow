module VcFmt

use ir
use ast
use vc_int

// Decimal text of solver-model integers for counterexample values, by the
// declared IR type: signed types print their two's-complement value, unsigned
// types their magnitude, and 128-bit values are formatted from two 64-bit limbs.

fn vc_u128_decimal(hi: i64, lo: i64) -> String {
    u128_limbs_to_text(lo as u64, hi as u64)
}

fn vc_i128_decimal(hi: i64, lo: i64) -> String {
    if hi >= 0 { return vc_u128_decimal(hi, lo); }
    let nlo: u64 = (lo as u64) ^ 18446744073709551615u64;
    let nhi: u64 = (hi as u64) ^ 18446744073709551615u64;
    let lo2: u64 = nlo + 1u64;
    let mut hi2: u64 = nhi;
    if lo2 == 0 { hi2 = nhi + 1u64; }
    let out: String = String::from("-");
    out.push_str(vc_u128_decimal(hi2 as i64, lo2 as i64));
    out
}

// The binary64 bits of the binary32 value with bits `b`: every f32 is exactly an
// f64, so the counterexample text is the shortest decimal of that f64.
fn vc_f32_bits_to_f64_bits(b: i64) -> i64 {
    let sign: i64 = (b >> 31) & 1;
    let exp: i64 = (b >> 23) & 255;
    let frac: i64 = b & 8388607;
    let top: i64 = sign << 63;
    if exp == 255 { return top | (2047 << 52) | (frac << 29); }
    if exp != 0 { return top | ((exp + 896) << 52) | (frac << 29); }
    if frac == 0 { return top; }
    let mut p: i64 = 22;
    while (frac >> p) & 1 == 0 { p = p - 1; }
    top | ((p + 874) << 52) | (((frac << (52 - p)) & 4503599627370495))
}

// Decimal text of a float counterexample value, as the runtime prints an f64:
// shortest round-trip digits, `inf`, `-inf` and `NaN`. The solver's one NaN is
// canonical, so a NaN's payload and sign are not reported.
fn vc_format_float(ty: i64, lo: i64) -> String {
    let mut bits: i64 = lo;
    if ty == ITY_F32() { bits = vc_f32_bits_to_f64_bits(lo & 4294967295); }
    format_f64_bits(bits as u64)
}

// Decimal text of the `ty`-typed value with limbs `hi:lo`; bits above the
// type's width are ignored. A Bool prints as `true` or `false`, a float as
// `vc_format_float`.
fn vc_format_int(ty: i64, lo: i64, hi: i64) -> String {
    if vc_ty_is_float(ty) { return vc_format_float(ty, lo); }
    if ty == ITY_BOOL() {
        if lo != 0 { return String::from("true"); }
        return String::from("false");
    }
    let w: i64 = vc_ty_bits(ty);
    let signed: bool = vc_ty_signed(ty);
    if w == 128 {
        if signed { return vc_i128_decimal(hi, lo); }
        return vc_u128_decimal(hi, lo);
    }
    if w == 64 {
        if signed { return i64_to_string(lo); }
        return uint_to_string(lo as u64);
    }
    let v: i64 = lo & ((1 << w) - 1);
    if signed && (v >> (w - 1)) & 1 == 1 {
        return i64_to_string(v - (1 << w));
    }
    i64_to_string(v)
}
