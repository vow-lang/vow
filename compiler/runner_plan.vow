module RunnerPlan

// The complete input to the `vow test` execution loop. `files` is already
// filtered and sorted; an empty `module_root` delegates module resolution to
// the entry file's parent directory.
struct TestSelection {
    files: Vec<String>,
    module_root: String,
}

fn strip_vow_ext(path: String) -> String {
    let n: u64 = path.len();
    if n > 4 {
        let d: i64 = path.byte_at(n - 4);
        let v: i64 = path.byte_at(n - 3);
        let o: i64 = path.byte_at(n - 2);
        let w: i64 = path.byte_at(n - 1);
        if d == 46 && v == 118 && o == 111 && w == 119 {
            return string_substr(path, 0, n - 4);
        }
    }
    path
}

// Return the final path component without its `.vow` extension. Filtering and
// result names use this one definition so parent directories never participate.
fn file_stem_from_path(path: String) -> String {
    let parts: Vec<String> = string_split(path, String::from("/"));
    if parts.len() == 0 {
        return strip_vow_ext(path);
    }
    strip_vow_ext(parts[parts.len() - 1])
}

// Byte-wise lexicographic order mirrors Rust PathBuf ordering for the
// ASCII-clean paths accepted by test discovery.
fn test_path_lt(a: String, b: String) -> bool {
    let na: u64 = a.len();
    let nb: u64 = b.len();
    let mut i: u64 = 0;
    while i < na && i < nb {
        let ca: i64 = a.byte_at(i);
        let cb: i64 = b.byte_at(i);
        if ca < cb { return true; }
        if ca > cb { return false; }
        i = i + 1;
    }
    na < nb
}

fn sort_test_paths(paths: Vec<String>) {
    let n: u64 = paths.len();
    let mut i: u64 = 1;
    while i < n {
        let current: String = paths[i];
        let mut j: u64 = i;
        while j > 0 && test_path_lt(current, paths[j - 1]) {
            paths[j] = paths[j - 1];
            j = j - 1;
        }
        paths[j] = current;
        i = i + 1;
    }
}

fn is_test_file(name: String) -> bool {
    if string_ends_with(name, String::from(".vow")) == 0 {
        return false;
    }
    if string_starts_with(name, String::from("test_")) != 0 {
        return true;
    }
    let n: u64 = name.len();
    if n > 9 {
        let suffix: String = string_substr(name, n - 9, 9);
        if suffix == String::from("_test.vow") {
            return true;
        }
    }
    false
}

fn test_path_join(dir: String, entry: String) -> String {
    let joined: String = String::from("");
    let n: u64 = dir.len();
    if n > 0 && dir.byte_at(n - 1) == 47 {
        joined.push_str(string_substr(dir, 0, n - 1));
    } else {
        joined.push_str(dir);
    }
    joined.push_str(String::from("/"));
    joined.push_str(entry);
    joined
}

fn test_filter_matches(path: String, filter: String) -> bool {
    filter.len() == 0 || file_stem_from_path(path).contains(filter)
}

// Discover and filter in one traversal. Symlink entries are skipped, matching
// Rust DirEntry::file_type lstat semantics; a direct scan path retains the
// existing behavior and is selected by stem filter regardless of its filename.
fn discover_selected_tests(root: String, filter: String, root_is_dir: bool) -> Vec<String> [io, read] {
    let files: Vec<String> = Vec::new();
    if !root_is_dir {
        if test_filter_matches(root, filter) {
            files.push(root);
        }
        return files;
    }

    let stack: Vec<String> = Vec::new();
    stack.push(root);
    while stack.len() > 0 {
        let dir: String = stack[stack.len() - 1];
        stack.pop();
        let entries: Vec<String> = fs_listdir(dir);
        let mut i: u64 = 0;
        while i < entries.len() {
            let entry: String = entries[i];
            let full: String = test_path_join(dir, entry);
            if fs_is_symlink(full) == 1 {
                i = i + 1;
                continue;
            }
            if fs_is_dir(full) == 1 {
                stack.push(full);
            } else if is_test_file(entry) && test_filter_matches(full, filter) {
                files.push(full);
            }
            i = i + 1;
        }
    }
    sort_test_paths(files);
    files
}

// Build the only selection interface consumed by `run_test`. The caller owns
// nonexistent-path diagnostics; this function assumes `scan_path` exists.
fn select_tests(scan_path: String, filter: String, module_root_override: String) -> TestSelection [io, read] {
    let scan_is_dir: bool = fs_is_dir(scan_path) == 1;
    let files: Vec<String> = discover_selected_tests(scan_path, filter, scan_is_dir);
    let module_root: String = {
        if module_root_override.len() > 0 { module_root_override }
        else if scan_is_dir { scan_path }
        else { String::from("") }
    };
    TestSelection {
        files: files,
        module_root: module_root,
    }
}

// One executed test file: `status` is the per-test status string, `entry` the
// finished JSON object for the `tests` array, and `fns`/`vow_fns` the
// contract-density contribution (0/0 when the frontend rejected the file).
struct TestOne {
    status: String,
    entry: String,
    fns: i64,
    vow_fns: i64,
}

// Worker handshake: a worker prints "<status> <fns> <vow_fns>\n<entry json>\n"
// instead of the suite document.
fn worker_reply_line(one: TestOne) -> String {
    let r: String = String::from("");
    r.push_str(one.status);
    r.push_str(String::from(" "));
    r.push_str(i64_to_string(one.fns));
    r.push_str(String::from(" "));
    r.push_str(i64_to_string(one.vow_fns));
    r.push_str(String::from("\n"));
    r.push_str(one.entry);
    r.push_str(String::from("\n"));
    r
}

// Inverse of `worker_reply_line`. A malformed or empty reply (the worker
// crashed) yields an empty `status`, which the caller turns into a
// fail-closed entry.
fn worker_reply_parse(reply: String) -> TestOne {
    let bad: TestOne = TestOne { status: String::from(""), entry: String::from(""), fns: 0, vow_fns: 0 };
    let lines: Vec<String> = string_split(reply, String::from("\n"));
    if lines.len() < 2 || lines[1].len() == 0 { return bad; }
    let head: Vec<String> = string_split(lines[0], String::from(" "));
    if head.len() != 3 { return bad; }
    let fns: i64 = match parse_i64(head[1]) {
        Option::Some(v) => { v },
        Option::None => { return bad; },
    };
    let vow_fns: i64 = match parse_i64(head[2]) {
        Option::Some(v) => { v },
        Option::None => { return bad; },
    };
    TestOne { status: head[0], entry: lines[1], fns: fns, vow_fns: vow_fns }
}

// Integer part of the `avg10` figure on the PSI line starting with `kind`
// ("some" or "full"); -1 when absent (no /proc/pressure, e.g. macOS).
fn psi_avg10_int(text: String, kind: String) -> i64 {
    let prefix: String = String::from("");
    prefix.push_str(kind);
    prefix.push_str(String::from(" "));
    let lines: Vec<String> = string_split(text, String::from("\n"));
    let mut i: u64 = 0;
    while i < lines.len() {
        let line: String = lines[i];
        if string_starts_with(line, prefix) != 0 {
            let fields: Vec<String> = string_split(line, String::from(" "));
            let mut j: u64 = 0;
            while j < fields.len() {
                let f: String = fields[j];
                if string_starts_with(f, String::from("avg10=")) != 0 {
                    let num: Vec<String> = string_split(string_substr(f, 6, f.len() - 6), String::from("."));
                    if num.len() == 0 { return -1; }
                    return match parse_i64(num[0]) {
                        Option::Some(v) => { v },
                        Option::None => { -1 },
                    };
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    -1
}

// Extra workers are only started while the machine is not under memory or IO
// stall pressure; the first worker is always allowed so progress is guaranteed.
fn machine_under_pressure() -> bool [io, read] {
    let mem: i64 = psi_avg10_int(fs_read(String::from("/proc/pressure/memory")), String::from("some"));
    let stall: i64 = psi_avg10_int(fs_read(String::from("/proc/pressure/io")), String::from("full"));
    mem >= 20 || stall >= 20
}

// `common` carries the flags every worker inherits (mode, timeout, verify
// settings), already rendered by the caller.
// `tag` is unique to this worker within the parent run; the worker folds it
// into its scratch executable name so concurrent workers never share a path.
fn test_worker_argv(test_path: String, module_root: String, common: Vec<String>, tag: String) -> Vec<String> {
    let a: Vec<String> = Vec::new();
    a.push(String::from("test"));
    a.push(test_path);
    if module_root.len() > 0 {
        a.push(String::from("--module-root"));
        a.push(module_root);
    }
    let mut i: u64 = 0;
    while i < common.len() {
        a.push(common[i]);
        i = i + 1;
    }
    a.push(String::from("--worker-entry"));
    a.push(tag);
    a
}

// Run every file in a worker subprocess of `exe`, at most `jobs` at a time.
// Returns the raw worker replies in file order regardless of completion order;
// a worker that could not start or died without a reply yields "".
fn run_tests_parallel(exe: String, files: Vec<String>, module_root: String, common: Vec<String>, jobs: i64) -> Vec<String> [io, read] {
    let n: u64 = files.len();
    let replies: Vec<String> = Vec::new();
    let mut k: u64 = 0;
    while k < n {
        replies.push(String::from(""));
        k = k + 1;
    }
    let handles: Vec<i64> = Vec::new();
    let slots: Vec<u64> = Vec::new();
    let mut next: u64 = 0;
    let mut done: u64 = 0;
    let still: i64 = 0 - 999999;
    let nonce: String = i64_to_string(time_unix_ms());
    while done < n {
        while next < n && (handles.len() as i64) < jobs && (handles.len() == 0 || !machine_under_pressure()) {
            let tag: String = String::from("");
            tag.push_str(i64_to_string(next as i64));
            tag.push_str(String::from("_"));
            tag.push_str(nonce);
            let h: i64 = process_start(exe, test_worker_argv(files[next], module_root, common, tag));
            if h < 0 {
                done = done + 1;
            } else {
                handles.push(h);
                slots.push(next);
            }
            next = next + 1;
        }
        let mut hi: u64 = 0;
        while hi < handles.len() {
            let rc: i64 = process_poll_wait(handles[hi], 20);
            if rc == still {
                hi = hi + 1;
            } else {
                let diag: String = process_stderr_for(handles[hi]);
                if diag.len() > 0 { eprintln_str(diag); }
                replies[slots[hi]] = process_stdout_for(handles[hi]);
                // Releases the finished worker's process-table entry and its
                // captured output.
                process_kill(handles[hi]);
                let last: u64 = handles.len() - 1;
                handles[hi] = handles[last];
                slots[hi] = slots[last];
                handles.pop();
                slots.pop();
                done = done + 1;
            }
        }
    }
    replies
}
