module VcLoops

use ir
use ir_dominance

// Natural-loop analysis for the native verifier's loop unwinding. A retreating
// edge of the reverse-postorder numbering is a back edge when its target
// dominates its source; one that is not makes the CFG irreducible, and such a
// function is not unrolled. The back edges sharing a header form one loop (the
// header plus every block that reaches a back-edge source without passing the
// header). In a reducible CFG two loops are nested or disjoint, so the loops
// containing a block form a chain, stored outer to inner, which is the order of
// strictly decreasing member count.

fn VC_MAX_LOOP_DEPTH() -> i64 { 8 }

struct VcLoopInfo {
    irreducible: bool,
    n_loops: i64,
    headers: Vec<i64>,
    loop_of_header: Vec<i64>,
    chain_off: Vec<i64>,
    chain: Vec<i64>,
    max_depth: i64,
    idom: Vec<i64>,
    nums: Vec<i64>,
    pred_off: Vec<i64>,
    preds: Vec<i64>,
}

// Back edges as parallel (source, loop) lists; false when a retreating edge is
// not a back edge. `headers`/`loop_of_header` are filled in discovery order.
fn vc_find_back_edges(nb: u64, succ: Vec<i64>, rpo: Vec<i64>, nums: Vec<i64>, headers: Vec<i64>, loop_of_header: Vec<i64>, be_src: Vec<i64>, be_loop: Vec<i64>) -> bool {
    let mut b: u64 = 0;
    while b < nb {
        if rpo[b] >= 0 {
            let mut k: u64 = 0;
            while k < 2 {
                let s: i64 = succ[b * 2 + k];
                if s >= 0 && rpo[s as u64] <= rpo[b] {
                    if !dom_dominates(nums, nb, s, b as i64) {
                        return false;
                    }
                    if loop_of_header[s as u64] < 0 {
                        loop_of_header[s as u64] = headers.len() as i64;
                        headers.push(s);
                    }
                    be_src.push(b as i64);
                    be_loop.push(loop_of_header[s as u64]);
                }
                k = k + 1;
            }
        }
        b = b + 1;
    }
    true
}

// Appends the members of loop `j` to `mem`, using `mark[b] == j` as the visited
// stamp (loops are processed in increasing `j`, so no reset is needed).
fn vc_collect_loop(j: i64, header: i64, be_src: Vec<i64>, be_loop: Vec<i64>, off: Vec<i64>, preds: Vec<i64>, mark: Vec<i64>, mem: Vec<i64>) {
    let stack: Vec<i64> = Vec::new();
    mark[header as u64] = j;
    mem.push(header);
    let mut e: u64 = 0;
    while e < be_src.len() {
        let src: i64 = be_src[e];
        if be_loop[e] == j && mark[src as u64] != j {
            mark[src as u64] = j;
            mem.push(src);
            stack.push(src);
        }
        e = e + 1;
    }
    while stack.len() > 0 {
        let b: i64 = stack[stack.len() - 1];
        stack.pop();
        let mut pi: i64 = off[b as u64];
        while pi < off[(b + 1) as u64] {
            let p: i64 = preds[pi as u64];
            if mark[p as u64] != j {
                mark[p as u64] = j;
                mem.push(p);
                stack.push(p);
            }
            pi = pi + 1;
        }
    }
}

// Loop indices ordered by decreasing member count (insertion sort; loop counts
// are small and the order must be deterministic).
fn vc_loops_by_size_desc(n: u64, mem_off: Vec<i64>) -> Vec<i64> {
    let order: Vec<i64> = Vec::new();
    let mut j: u64 = 0;
    while j < n {
        let size: i64 = mem_off[j + 1] - mem_off[j];
        order.push(j as i64);
        let mut p: u64 = order.len() - 1;
        let mut sifting: bool = true;
        while sifting && p > 0 {
            let prev: i64 = order[p - 1];
            let prev_size: i64 = mem_off[(prev + 1) as u64] - mem_off[prev as u64];
            if prev_size >= size {
                sifting = false;
            } else {
                order[p] = prev;
                order[p - 1] = j as i64;
                p = p - 1;
            }
        }
        j = j + 1;
    }
    order
}

fn vc_empty_loop_info(nb: u64, irreducible: bool, idom: Vec<i64>, nums: Vec<i64>, off: Vec<i64>, preds: Vec<i64>) -> VcLoopInfo {
    VcLoopInfo {
        irreducible: irreducible,
        n_loops: 0,
        headers: Vec::new(),
        loop_of_header: dom_fill(nb, -1),
        chain_off: dom_fill(nb + 1, 0),
        chain: Vec::new(),
        max_depth: 0,
        idom: idom,
        nums: nums,
        pred_off: off,
        preds: preds,
    }
}

// True when a reachable edge goes to a block numbered no later than its source.
fn vc_has_retreating_edge(nb: u64, succ: Vec<i64>, rpo: Vec<i64>) -> bool {
    let mut b: u64 = 0;
    while b < nb {
        if rpo[b] >= 0 {
            let mut k: u64 = 0;
            while k < 2 {
                let s: i64 = succ[b * 2 + k];
                if s >= 0 && rpo[s as u64] <= rpo[b] {
                    return true;
                }
                k = k + 1;
            }
        }
        b = b + 1;
    }
    false
}

fn vc_loop_analysis(nb: u64, succ: Vec<i64>, rpo: Vec<i64>) -> VcLoopInfo {
    if !vc_has_retreating_edge(nb, succ, rpo) {
        return vc_empty_loop_info(nb, false, Vec::new(), Vec::new(), Vec::new(), Vec::new());
    }
    let order: Vec<i64> = dom_rpo_order(rpo);
    let off: Vec<i64> = dom_pred_offsets(nb, succ, rpo);
    let preds: Vec<i64> = dom_pred_list(nb, succ, rpo, off);
    let idom: Vec<i64> = dom_idoms(nb, rpo, order, off, preds);
    let nums: Vec<i64> = dom_tree_numbers(nb, idom, order);

    let headers: Vec<i64> = Vec::new();
    let loop_of_header: Vec<i64> = dom_fill(nb, -1);
    let be_src: Vec<i64> = Vec::new();
    let be_loop: Vec<i64> = Vec::new();
    if !vc_find_back_edges(nb, succ, rpo, nums, headers, loop_of_header, be_src, be_loop) {
        return vc_empty_loop_info(nb, true, idom, nums, off, preds);
    }
    let n: u64 = headers.len();

    let mark: Vec<i64> = dom_fill(nb, -1);
    let mem: Vec<i64> = Vec::new();
    let mem_off: Vec<i64> = Vec::new();
    let mut j: u64 = 0;
    while j < n {
        mem_off.push(mem.len() as i64);
        vc_collect_loop(j as i64, headers[j], be_src, be_loop, off, preds, mark, mem);
        j = j + 1;
    }
    mem_off.push(mem.len() as i64);

    let cnt: Vec<i64> = dom_fill(nb, 0);
    let mut m: u64 = 0;
    while m < mem.len() {
        cnt[mem[m] as u64] = cnt[mem[m] as u64] + 1;
        m = m + 1;
    }
    let chain_off: Vec<i64> = dom_fill(nb + 1, 0);
    let mut max_depth: i64 = 0;
    let mut b: u64 = 0;
    while b < nb {
        chain_off[b + 1] = chain_off[b] + cnt[b];
        if cnt[b] > max_depth {
            max_depth = cnt[b];
        }
        b = b + 1;
    }
    let chain: Vec<i64> = dom_fill(mem.len() as u64, -1);
    let fill: Vec<i64> = dom_fill(nb, 0);
    let by_size: Vec<i64> = vc_loops_by_size_desc(n, mem_off);
    let mut oi: u64 = 0;
    while oi < by_size.len() {
        let lp: i64 = by_size[oi];
        let mut mi: i64 = mem_off[lp as u64];
        while mi < mem_off[(lp + 1) as u64] {
            let blk: u64 = mem[mi as u64] as u64;
            chain[(chain_off[blk] + fill[blk]) as u64] = lp;
            fill[blk] = fill[blk] + 1;
            mi = mi + 1;
        }
        oi = oi + 1;
    }
    VcLoopInfo {
        irreducible: false,
        n_loops: n as i64,
        headers: headers,
        loop_of_header: loop_of_header,
        chain_off: chain_off,
        chain: chain,
        max_depth: max_depth,
        idom: idom,
        nums: nums,
        pred_off: off,
        preds: preds,
    }
}

fn vc_chain_len(li: VcLoopInfo, b: u64) -> i64 {
    li.chain_off[b + 1] - li.chain_off[b]
}

// Loop at depth `i` (0 is the outermost) of block `b`'s chain.
fn vc_chain_at(li: VcLoopInfo, b: u64, i: i64) -> i64 {
    li.chain[(li.chain_off[b] + i) as u64]
}

// Number of leading loops two blocks have in common.
fn vc_chain_common(li: VcLoopInfo, a: u64, b: u64) -> i64 {
    let la: i64 = vc_chain_len(li, a);
    let lb: i64 = vc_chain_len(li, b);
    let mut n: i64 = 0;
    while n < la && n < lb && vc_chain_at(li, a, n) == vc_chain_at(li, b, n) {
        n = n + 1;
    }
    n
}

struct VcDefs {
    blk: Vec<i64>,
    pos: Vec<i64>,
}

// Block index and position of the instruction defining each value id (-1 when
// undefined), over the reachable blocks.
fn vc_def_table(f: IrFunction, rpo: Vec<i64>, n_ids: u64) -> VcDefs {
    let blk: Vec<i64> = dom_fill(n_ids, -1);
    let pos: Vec<i64> = dom_fill(n_ids, -1);
    let mut bi: u64 = 0;
    while bi < f.blocks.len() {
        if rpo[bi] >= 0 {
            let b: IrBlock = f.blocks[bi];
            let mut ii: u64 = 0;
            while ii < b.insts.len() {
                let inst: IrInst = b.insts[ii];
                if inst.id >= 0 && (inst.id as u64) < n_ids && blk[inst.id as u64] < 0 {
                    blk[inst.id as u64] = bi as i64;
                    pos[inst.id as u64] = ii as i64;
                }
                ii = ii + 1;
            }
        }
        bi = bi + 1;
    }
    VcDefs { blk: blk, pos: pos }
}

// True when value `d`, read in block `bi`, is defined in a loop the block is not
// inside. The unroller keeps one copy of a loop value per iteration, so after the
// loop only the exit Phis (which belong to the block outside it) may carry a
// value out; `vc_close_loops` makes every other read go through one.
fn vc_read_escapes(li: VcLoopInfo, def_blk: Vec<i64>, d: i64, bi: u64) -> bool {
    if d < 0 || (d as u64) >= def_blk.len() || def_blk[d as u64] < 0 {
        return false;
    }
    let db: u64 = def_blk[d as u64] as u64;
    let dl: i64 = vc_chain_len(li, db);
    dl > vc_chain_len(li, bi) || vc_chain_common(li, db, bi) < dl
}

// The first value block `bi` reads that escapes its loop, or -1.
fn vc_escaping_value(f: IrFunction, li: VcLoopInfo, def_blk: Vec<i64>, bi: u64) -> i64 {
    let blk: IrBlock = f.blocks[bi];
    let mut ii: u64 = 0;
    while ii < blk.insts.len() {
        let inst: IrInst = blk.insts[ii];
        let mut ai: u64 = 0;
        while ai < inst.args.len() {
            if vc_read_escapes(li, def_blk, inst.args[ai], bi) {
                return inst.args[ai];
            }
            ai = ai + 1;
        }
        ii = ii + 1;
    }
    -1
}

// "" when every loop of the reachable CFG can be unrolled, else the detail of an
// `unsupported-opcode` skip. A function without a loop is always accepted.
fn vc_loop_shape_detail(f: IrFunction, succ: Vec<i64>, rpo: Vec<i64>) -> String {
    let nb: u64 = f.blocks.len();
    let li: VcLoopInfo = vc_loop_analysis(nb, succ, rpo);
    if li.irreducible {
        return String::from("irreducible loop (back edge to a block that does not dominate its source)");
    }
    if li.n_loops == 0 {
        return String::from("");
    }
    if li.loop_of_header[0] >= 0 {
        return String::from("entry block is a loop header");
    }
    if li.max_depth > VC_MAX_LOOP_DEPTH() {
        return String::from("loop nest deeper than 8");
    }
    let defs: VcDefs = vc_def_table(f, rpo, (dom_max_inst_id(f) + 1) as u64);
    let def_blk: Vec<i64> = defs.blk;
    let mut bi: u64 = 0;
    while bi < nb {
        if rpo[bi] >= 0 && vc_escaping_value(f, li, def_blk, bi) >= 0 {
            return String::from("loop value used outside its loop");
        }
        bi = bi + 1;
    }
    String::from("")
}

// Loop-closed form. A value defined in a loop and read after it (a `break` arm
// reading the iteration's variable, a `return` of one) is routed through a Phi
// at the block where control leaves the loop: that block's predecessors all
// lie in the loop, each feeds the value to the Phi, and every read it
// dominates reads the Phi instead. The Phi belongs to the enclosing loop, so a
// read outside that one is closed again, innermost loop first. A read the
// verifier cannot close this way is left alone and rejected by
// `vc_loop_shape_detail`.

fn VC_MAX_CLOSE_ROUNDS() -> i64 { 256 }

struct VcClosed {
    f: IrFunction,
    changed: bool,
}

fn vc_in_loop(li: VcLoopInfo, b: u64, lp: i64) -> bool {
    let n: i64 = vc_chain_len(li, b);
    let mut i: i64 = 0;
    while i < n {
        if vc_chain_at(li, b, i) == lp {
            return true;
        }
        i = i + 1;
    }
    false
}

fn vc_preds_all_in_loop(li: VcLoopInfo, b: u64, lp: i64) -> bool {
    let first: i64 = li.pred_off[b];
    let last: i64 = li.pred_off[b + 1];
    if first == last {
        return false;
    }
    let mut pi: i64 = first;
    while pi < last {
        if !vc_in_loop(li, li.preds[pi as u64] as u64, lp) {
            return false;
        }
        pi = pi + 1;
    }
    true
}

// The block on the dominator chain of `u` (u itself included) that control
// enters from loop `lp` alone; -1 when there is none.
fn vc_landing_block(li: VcLoopInfo, u: u64, lp: i64) -> i64 {
    if vc_in_loop(li, u, lp) {
        return -1;
    }
    let mut x: i64 = u as i64;
    let mut steps: u64 = 0;
    while x > 0 && steps <= li.idom.len() {
        let p: i64 = li.idom[x as u64];
        if p < 0 {
            return -1;
        }
        if vc_in_loop(li, p as u64, lp) {
            if vc_preds_all_in_loop(li, x as u64, lp) {
                return x;
            }
            return -1;
        }
        x = p;
        steps = steps + 1;
    }
    -1
}

fn vc_last_terminal(blk: IrBlock) -> i64 {
    let mut i: i64 = blk.insts.len() as i64;
    while i > 0 {
        i = i - 1;
        let inst: IrInst = blk.insts[i as u64];
        if dom_is_terminal(inst.op) {
            return i;
        }
    }
    -1
}

// `orig` with a new id, argument list and branch/phi targets.
fn vc_clone_inst(orig: IrInst, new_id: i64, args: Vec<i64>, dv: i64, dv2: i64) -> IrInst {
    IrInst {
        id: new_id,
        op: orig.op,
        ty: orig.ty,
        args: args,
        dk: orig.dk,
        dv: dv,
        dv2: dv2,
        ds: orig.ds,
        ostart: orig.ostart,
        olen: orig.olen,
        rgn: orig.rgn,
    }
}

fn vc_replace_arg(inst: IrInst, v: i64, w: i64) -> IrInst {
    let mut hit: bool = false;
    let mut ai: u64 = 0;
    while ai < inst.args.len() {
        if inst.args[ai] == v {
            hit = true;
        }
        ai = ai + 1;
    }
    if !hit {
        return inst;
    }
    let args: Vec<i64> = Vec::new();
    ai = 0;
    while ai < inst.args.len() {
        if inst.args[ai] == v {
            args.push(w);
        } else {
            args.push(inst.args[ai]);
        }
        ai = ai + 1;
    }
    vc_clone_inst(inst, inst.id, args, inst.dv, inst.dv2)
}

// `f`'s signature and contracts with no blocks, for a transformed copy.
fn vc_function_shell(f: IrFunction) -> IrFunction {
    let g: IrFunction = ir_function_new(f.id, f.name, f.return_ty, f.effects, f.source_file);
    g.params = f.params;
    g.param_names = f.param_names;
    g.vows = f.vows;
    g
}

// `f` with a Phi for each value `vs[k]` (of type `tys[k]`) at the head of block
// `e`, fed by an Upsilon in each predecessor, and every read of `vs[k]` that `e`
// dominates redirected to it.
fn vc_close_values(f: IrFunction, li: VcLoopInfo, rpo: Vec<i64>, e: u64, vs: Vec<i64>, tys: Vec<i64>) -> IrFunction {
    let nb: u64 = f.blocks.len();
    let first_phi: i64 = dom_max_inst_id(f) + 1;
    let nv: i64 = vs.len() as i64;
    let mut next_id: i64 = first_phi + nv;
    let g: IrFunction = vc_function_shell(f);
    let is_pred: Vec<i64> = dom_fill(nb, 0);
    let mut pi: i64 = li.pred_off[e];
    while pi < li.pred_off[e + 1] {
        is_pred[li.preds[pi as u64] as u64] = 1;
        pi = pi + 1;
    }
    let mut bi: u64 = 0;
    while bi < nb {
        let src: IrBlock = f.blocks[bi];
        let out: IrBlock = ir_block_new(src.id);
        let redirect: bool = rpo[bi] >= 0 && dom_dominates(li.nums, nb, e as i64, bi as i64);
        let term: i64 = vc_last_terminal(src);
        if bi == e {
            let mut k: u64 = 0;
            while k < vs.len() {
                out.insts.push(ir_inst_new(first_phi + k as i64, IOP_PHI(), tys[k], Vec::new(), IDATA_NONE(), 0, 0, String::from("")));
                k = k + 1;
            }
        }
        let mut ii: u64 = 0;
        while ii < src.insts.len() {
            if is_pred[bi] == 1 && ii as i64 == term {
                let t: IrInst = src.insts[ii];
                let mut k: u64 = 0;
                while k < vs.len() {
                    let feed: Vec<i64> = Vec::new();
                    feed.push(vs[k]);
                    let ups: IrInst = ir_inst_new(next_id, IOP_UPSILON(), ITY_UNIT(), feed, IDATA_PHI_TARGET(), first_phi + k as i64, 0, String::from(""));
                    ups.ostart = t.ostart;
                    ups.olen = t.olen;
                    out.insts.push(ups);
                    next_id = next_id + 1;
                    k = k + 1;
                }
            }
            let mut inst: IrInst = src.insts[ii];
            if redirect {
                let mut k: u64 = 0;
                while k < vs.len() {
                    inst = vc_replace_arg(inst, vs[k], first_phi + k as i64);
                    k = k + 1;
                }
            }
            out.insts.push(inst);
            ii = ii + 1;
        }
        g.blocks.push(out);
        bi = bi + 1;
    }
    g
}

// Every value of loop `lp` read, in a block `e` dominates, outside `lp`: they all
// close at `e`, so one rebuild serves them instead of one per value.
fn vc_values_closing_at(f: IrFunction, li: VcLoopInfo, rpo: Vec<i64>, defs: VcDefs, e: u64, lp: i64, vs: Vec<i64>, tys: Vec<i64>) {
    let nb: u64 = f.blocks.len();
    let def_blk: Vec<i64> = defs.blk;
    let def_pos: Vec<i64> = defs.pos;
    let picked: Vec<i64> = dom_fill(def_blk.len(), 0);
    let mut bi: u64 = 0;
    while bi < nb {
        if rpo[bi] >= 0 && dom_dominates(li.nums, nb, e as i64, bi as i64) {
            let blk: IrBlock = f.blocks[bi];
            let mut ii: u64 = 0;
            while ii < blk.insts.len() {
                let inst: IrInst = blk.insts[ii];
                let mut ai: u64 = 0;
                while ai < inst.args.len() {
                    let d: i64 = inst.args[ai];
                    if vc_read_escapes(li, def_blk, d, bi) && picked[d as u64] == 0 {
                        let db: u64 = def_blk[d as u64] as u64;
                        if vc_chain_at(li, db, vc_chain_len(li, db) - 1) == lp {
                            picked[d as u64] = 1;
                            let dblk: IrBlock = f.blocks[db];
                            let dinst: IrInst = dblk.insts[def_pos[d as u64] as u64];
                            vs.push(d);
                            tys.push(dinst.ty);
                        }
                    }
                    ai = ai + 1;
                }
                ii = ii + 1;
            }
        }
        bi = bi + 1;
    }
}

// One closing step: the function after routing every value of one loop that
// lands at the first escaping read's block through Phis (one rebuild), or `f`
// itself (`changed` false) when nothing is left or it cannot be closed.
fn vc_close_one(f: IrFunction) -> VcClosed {
    let nb: u64 = f.blocks.len();
    if nb == 0 {
        return VcClosed { f: f, changed: false };
    }
    let succ: Vec<i64> = dom_successors(f, dom_block_id_table(f));
    let rpo: Vec<i64> = dom_rpo_numbers(nb, succ);
    let li: VcLoopInfo = vc_loop_analysis(nb, succ, rpo);
    if li.irreducible || li.n_loops == 0 || li.max_depth > VC_MAX_LOOP_DEPTH() || li.loop_of_header[0] >= 0 {
        return VcClosed { f: f, changed: false };
    }
    let defs: VcDefs = vc_def_table(f, rpo, (dom_max_inst_id(f) + 1) as u64);
    let def_blk: Vec<i64> = defs.blk;
    let mut bi: u64 = 0;
    while bi < nb {
        if rpo[bi] >= 0 {
            let v: i64 = vc_escaping_value(f, li, def_blk, bi);
            if v >= 0 {
                let db: u64 = def_blk[v as u64] as u64;
                let lp: i64 = vc_chain_at(li, db, vc_chain_len(li, db) - 1);
                let e: i64 = vc_landing_block(li, bi, lp);
                if e < 0 {
                    return VcClosed { f: f, changed: false };
                }
                let vs: Vec<i64> = Vec::new();
                let tys: Vec<i64> = Vec::new();
                vc_values_closing_at(f, li, rpo, defs, e as u64, lp, vs, tys);
                return VcClosed { f: vc_close_values(f, li, rpo, e as u64, vs, tys), changed: true };
            }
        }
        bi = bi + 1;
    }
    VcClosed { f: f, changed: false }
}

// `f` in loop-closed form (see above); `f` itself when it has no escaping read.
fn vc_close_loops(f: IrFunction) -> IrFunction {
    let mut cur: IrFunction = f;
    let mut round: i64 = 0;
    while round < VC_MAX_CLOSE_ROUNDS() {
        let r: VcClosed = vc_close_one(cur);
        if !r.changed {
            return cur;
        }
        cur = r.f;
        round = round + 1;
    }
    cur
}
