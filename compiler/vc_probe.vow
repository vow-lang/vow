module VcProbe

use ir
use ir_dominance
use verifier
use vc_ops
use vc_loops

// The two weak-contract probes of `contracts --verify`, as rewrites of a
// function's IR. The rewritten function goes through the ordinary engine
// (`vc_verify_function_mode`), so slicing, inlining, loops and the solver
// pipeline are the verifier's own and no probe-specific claim kind exists.
//
// Vacuity: the function is cut right after its last `requires` and the cut
// point is made a claim that can only hold when it is unreachable. `proven`
// then means the `requires` are jointly unsatisfiable.
//
// Trivial: the single returned value is replaced by the type's default
// constant. `proven` then means a body that ignores its inputs satisfies every
// `ensures`. The replaced computation stays in the function, so what it can
// abort on is still a claim.
//
// Anything but `proven` means "not weak": an undecided probe never claims a
// weakness.

// The `VowReq` whose position in reverse postorder is last, as [block, index],
// or [-1, -1]. The requires of a function are lowered in sequence ahead of its
// body, so each one dominates the next and the last of them is the point where
// every `requires` has been assumed.
fn vc_probe_last_requires(f: IrFunction, rpo: Vec<i64>) -> Vec<i64> {
    let at: Vec<i64> = Vec::new();
    at.push(-1);
    at.push(-1);
    let mut best: i64 = -1;
    let mut bi: u64 = 0;
    while bi < f.blocks.len() {
        if rpo[bi] >= 0 {
            let blk: IrBlock = f.blocks[bi];
            let mut ii: u64 = 0;
            while ii < blk.insts.len() {
                let inst: IrInst = blk.insts[ii];
                let here: i64 = ii as i64;
                if inst.op == IOP_VOW_REQ() && (rpo[bi] > best || (rpo[bi] == best && here > at[1])) {
                    best = rpo[bi];
                    at[0] = bi as i64;
                    at[1] = ii as i64;
                }
                ii = ii + 1;
            }
        }
        bi = bi + 1;
    }
    at
}

fn vc_probe_cfg_rpo(f: IrFunction) -> Vec<i64> {
    let ids: Vec<i64> = dom_block_id_table(f);
    dom_rpo_numbers(f.blocks.len(), dom_successors(f, ids))
}

fn vc_probe_vacuity_applicable(f: IrFunction) -> bool {
    if f.blocks.len() == 0 || !function_has_requires(f) { return false; }
    let at: Vec<i64> = vc_probe_last_requires(f, vc_probe_cfg_rpo(f));
    at[0] >= 0
}

// An id above every vow id of `f`, and equal to the new entry's index when the
// entries are numbered by position, as lowering does.
fn vc_probe_fresh_vow_id(f: IrFunction) -> i64 {
    let mut id: i64 = f.vows.len() as i64;
    let mut i: u64 = 0;
    while i < f.vows.len() {
        let v: IrVowEntry = f.vows[i];
        if v.id >= id { id = v.id + 1; }
        i = i + 1;
    }
    id
}

// `f` cut after its last `requires`, ending in a claim that is false. Blocks the
// cut makes unreachable are dropped. `f` itself when it has no reachable
// `requires`.
fn vc_probe_vacuity(f: IrFunction) -> IrFunction {
    let rpo: Vec<i64> = vc_probe_cfg_rpo(f);
    let at: Vec<i64> = vc_probe_last_requires(f, rpo);
    if at[0] < 0 { return f; }
    let first: i64 = dom_max_inst_id(f) + 1;
    let vow_id: i64 = vc_probe_fresh_vow_id(f);
    let cut: IrFunction = vc_function_shell(f);
    let vows: Vec<IrVowEntry> = Vec::new();
    let mut vi: u64 = 0;
    while vi < f.vows.len() {
        vows.push(f.vows[vi]);
        vi = vi + 1;
    }
    let none: Vec<i64> = Vec::new();
    vows.push(IrVowEntry {
        id: vow_id,
        description: String::from("ensures false"),
        blame: BLAME_CALLEE(),
        binding_ids: none,
        binding_names: Vec::new(),
        file: f.source_file,
        offset: 0,
    });
    cut.vows = vows;
    let mut bi: u64 = 0;
    while bi < f.blocks.len() {
        let src: IrBlock = f.blocks[bi];
        if bi != at[0] as u64 {
            cut.blocks.push(src);
        } else {
            let out: IrBlock = ir_block_new(src.id);
            let keep: u64 = (at[1] + 1) as u64;
            let mut ii: u64 = 0;
            while ii < keep {
                out.insts.push(src.insts[ii]);
                ii = ii + 1;
            }
            out.insts.push(ir_inst_new(first, IOP_CONST_BOOL(), ITY_BOOL(), Vec::new(), IDATA_CONST_BOOL(), 0, 0, String::from("")));
            let claim_args: Vec<i64> = Vec::new();
            claim_args.push(first);
            out.insts.push(ir_inst_new(first + 1, IOP_VOW_ENS(), ITY_UNIT(), claim_args, IDATA_VOW_ID(), vow_id, 0, String::from("")));
            out.insts.push(ir_inst_new(first + 2, IOP_UNREACHABLE(), ITY_UNIT(), Vec::new(), IDATA_NONE(), 0, 0, VC_INTERNAL_CUT_END()));
            cut.blocks.push(out);
        }
        bi = bi + 1;
    }
    let live: Vec<i64> = vc_probe_cfg_rpo(cut);
    let g: IrFunction = vc_function_shell(cut);
    g.vows = cut.vows;
    let mut k: u64 = 0;
    while k < cut.blocks.len() {
        if live[k] >= 0 { g.blocks.push(cut.blocks[k]); }
        k = k + 1;
    }
    g
}

// The constant opcode that carries a default of type `ty`, or -1 for a type the
// native subset has no constant for (floats, pointers).
fn vc_probe_default_op(ty: i64) -> i64 {
    if ty == ITY_BOOL() { return IOP_CONST_BOOL(); }
    if ty == ITY_I64() { return IOP_CONST_I64(); }
    if ty == ITY_U64() { return IOP_CONST_U64(); }
    if ty == ITY_I32() || ty == ITY_U32() || ty == ITY_I16() || ty == ITY_U16() { return IOP_CONST_I32(); }
    if ty == ITY_I8() || ty == ITY_U8() { return IOP_CONST_U8(); }
    if ty == ITY_I128() { return IOP_CONST_I128(); }
    if ty == ITY_U128() { return IOP_CONST_U128(); }
    -1
}

fn vc_probe_default_dk(op: i64) -> i64 {
    if op == IOP_CONST_BOOL() { return IDATA_CONST_BOOL(); }
    if op == IOP_CONST_I64() { return IDATA_CONST_I64(); }
    if op == IOP_CONST_U64() { return IDATA_CONST_U64(); }
    if op == IOP_CONST_I32() { return IDATA_CONST_I32(); }
    if op == IOP_CONST_U8() { return IDATA_CONST_U8(); }
    if op == IOP_CONST_I128() { return IDATA_CONST_I128(); }
    IDATA_CONST_U128()
}

// The value the single `Return` yields, or -1.
fn vc_probe_result_id(f: IrFunction) -> i64 {
    let mut out: i64 = -1;
    let mut bi: u64 = 0;
    while bi < f.blocks.len() {
        let blk: IrBlock = f.blocks[bi];
        let mut ii: u64 = 0;
        while ii < blk.insts.len() {
            let inst: IrInst = blk.insts[ii];
            if inst.op == IOP_RETURN() && inst.args.len() > 0 { out = inst.args[0]; }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    out
}

// The type of instruction `id`, or -1.
fn vc_probe_inst_ty(f: IrFunction, id: i64) -> i64 {
    let mut bi: u64 = 0;
    while bi < f.blocks.len() {
        let blk: IrBlock = f.blocks[bi];
        let mut ii: u64 = 0;
        while ii < blk.insts.len() {
            let inst: IrInst = blk.insts[ii];
            if inst.id == id { return inst.ty; }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    -1
}

// The same decision as the C model's body-replace (`verify_function_trivial`):
// an `ensures`, a scalar result produced by one `Return` from a body
// instruction. A result type without a default constant is not replaceable.
fn vc_probe_trivial_applicable(f: IrFunction) -> bool {
    if !function_has_ensures(f) || !returns_scalar(f) || !body_replaceable_result(f) { return false; }
    vc_probe_default_op(vc_probe_inst_ty(f, vc_probe_result_id(f))) >= 0
}

// `f` with every read of the returned value `R` redirected to a fresh default
// constant defined right after `R`, after the leading Phis of its block when `R`
// is one. `R`'s own definition is unchanged, and so is every Upsilon's Phi
// target, which names the Phi by id.
fn vc_probe_trivial(f: IrFunction) -> IrFunction {
    let r: i64 = vc_probe_result_id(f);
    let ty: i64 = vc_probe_inst_ty(f, r);
    let op: i64 = vc_probe_default_op(ty);
    if r < 0 || op < 0 { return f; }
    let cid: i64 = dom_max_inst_id(f) + 1;
    let c: IrInst = ir_inst_new(cid, op, ty, Vec::new(), vc_probe_default_dk(op), 0, 0, String::from(""));
    let g: IrFunction = vc_function_shell(f);
    let mut bi: u64 = 0;
    while bi < f.blocks.len() {
        let src: IrBlock = f.blocks[bi];
        let out: IrBlock = ir_block_new(src.id);
        let mut pending: bool = false;
        let mut ii: u64 = 0;
        while ii < src.insts.len() {
            let inst: IrInst = src.insts[ii];
            if pending && inst.op != IOP_PHI() {
                out.insts.push(c);
                pending = false;
            }
            out.insts.push(vc_replace_arg(inst, r, cid));
            if inst.id == r {
                if inst.op == IOP_PHI() {
                    pending = true;
                } else {
                    out.insts.push(c);
                }
            }
            ii = ii + 1;
        }
        g.blocks.push(out);
        bi = bi + 1;
    }
    g
}
