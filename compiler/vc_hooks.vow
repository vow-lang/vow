module VcHooks

use vc_ops
use vc_term
use vc_smt
use vc_agg
use vc_vec
use vc_str

// The float-text hooks `parse_f64_bits(s) -> u64` and `format_f64_bits(bits) -> String`
// in the native verifier (ADR-2026-10-08-1422, #1646 addendum). Both are total
// functions of their operand: the `u64` side is an exact 64-bit vector (no cast,
// no `Float`), the `String` side is a function of the string's contents, and the
// text conversion itself is not encoded (no decimal grammar, no round trip, no NaN
// payload), so a result is an unconstrained constant apart from the two facts
// every total function has. Equal operands give equal results (Ackermann
// axioms against every earlier call, built on the exact `vc_str_eq`, global because
// they hold on every path), and a formatted string keeps the runtime's length
// invariant. A hook term is a fresh declared constant listed in `vv.hk_vars`; a
// counterexample whose query reaches one is checked for independence of it
// (`vc_native`).

// The result of parsing the string `(arr, len)`: the earlier call's term when the
// operand terms are the same, else a fresh 64-bit constant equal to the result of
// every earlier parse of an equal string.
fn vc_hook_parse(vv: VcVec, ar: VcArena, hdr: SmtScript, assumed: Vec<i64>, arr: i64, len: i64) -> i64 {
    let n: u64 = vv.pk_res.len();
    let mut i: u64 = 0;
    while i < n {
        if vv.pk_arr[i] == arr && vv.pk_len[i] == len { return vv.pk_res[i]; }
        i = i + 1;
    }
    let r: i64 = vc_agg_declare(ar, hdr, vc_vec_fresh_name(vv, String::from("hkp")), 64);
    i = 0;
    while i < n {
        let same: i64 = vc_str_eq(vv, ar, hdr, assumed, arr, len, vv.pk_arr[i], vv.pk_len[i]);
        if !vc_tm_is_false(ar, same) {
            vc_str_axiom(ar, assumed, vc_tm_implies(ar, same, vc_tm_app2(ar, VC_OP_EQ(), r, vv.pk_res[i])));
        }
        i = i + 1;
    }
    vv.pk_arr.push(arr);
    vv.pk_len.push(len);
    vv.pk_res.push(r);
    vv.hk_vars.push(r);
    r
}

// The index in `fk_*` of the string `format_f64_bits(bits)` returns: the earlier
// call's when the bits term is the same, else a fresh array and length whose
// string equals that of every earlier call on equal bits. The length is below
// `VOW_CAP_VALUE_MASK` like any runtime string's.
fn vc_hook_format(vv: VcVec, ar: VcArena, hdr: SmtScript, assumed: Vec<i64>, bits: i64) -> u64 {
    let n: u64 = vv.fk_bits.len();
    let mut i: u64 = 0;
    while i < n {
        if vv.fk_bits[i] == bits { return i; }
        i = i + 1;
    }
    let arr: i64 = vc_str_fresh_array(vv, ar, hdr, String::from("hkf"));
    let len: i64 = vc_agg_declare(ar, hdr, vc_vec_fresh_name(vv, String::from("hkl")), 64);
    vc_str_axiom(ar, assumed, vc_tm_app2(ar, VC_OP_BVULT(), len, vc_vec_len_mask(ar)));
    i = 0;
    while i < n {
        let guard: i64 = vc_tm_app2(ar, VC_OP_EQ(), bits, vv.fk_bits[i]);
        if !vc_tm_is_false(ar, guard) {
            let same: i64 = vc_str_eq(vv, ar, hdr, assumed, arr, len, vv.fk_arr[i], vv.fk_len[i]);
            vc_str_axiom(ar, assumed, vc_tm_implies(ar, guard, same));
        }
        i = i + 1;
    }
    vv.fk_bits.push(bits);
    vv.fk_arr.push(arr);
    vv.fk_len.push(len);
    vv.hk_vars.push(arr);
    vv.hk_vars.push(len);
    n
}
