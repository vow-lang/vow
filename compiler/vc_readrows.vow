module VcReadRows

use vc_term
use vc_smt
use vc_heap
use vc_query
use vc_reads
use vc_solver

// The handles a claim's query can read through (`vc_reads`), projected in the model of a failed
// claim. Like the elements of a `Vec` parameter (`vc_vecmodel`) they are read back from the
// enrichment's model, behind everything else it carries, so the handles belong to the same
// counterexample as the addresses it lists. A read made at a header position the claim's query
// does not declare yet is not part of it.

// Positions in the registry of the reads the query of claim `k` can make; none when the registry
// was dropped or never completed.
fn vc_read_rows(cs: VcClaims, k: u64) -> Vec<i64> {
    let out: Vec<i64> = Vec::new();
    let ls: VcHeapListed = cs.listed;
    if ls.rd_over || !ls.rd_ok { return out; }
    let mut i: u64 = 0;
    while i < ls.rd_hdr.len() {
        if ls.rd_hdr[i] <= cs.header_lens[k] { out.push(i as i64); }
        i = i + 1;
    }
    out
}

fn vc_read_row_name(i: i64) -> String {
    let out: String = String::from("hrd");
    out.push_str(i64_to_string(i));
    out
}

// Appends the handle of each row of `rows` to one model projection, with its name and 64-bit sort.
fn vc_append_read_rows(cs: VcClaims, rows: Vec<i64>, s: SmtScript, names: Vec<String>, widths: Vec<i64>) {
    let ls: VcHeapListed = cs.listed;
    let mut q: u64 = 0;
    while q < rows.len() {
        let name: String = vc_read_row_name(rows[q]);
        vc_script_define_fun(s, name, 64, ls.rd_term[rows[q] as u64]);
        names.push(name);
        widths.push(64);
        q = q + 1;
    }
}

// True when the model of a failed claim `k` can be asked again for the contents behind the handles
// it reads (`vc_nested`): it reads some, and every value it gives can be fixed in that second query.
// A float cannot be, and the contents would then belong to another counterexample.
fn vc_nest_enabled(cs: VcClaims, k: u64) -> bool {
    if vc_read_rows(cs, k).len() == 0 { return false; }
    let n: u64 = vc_claim_model_count(cs, k);
    let mut j: u64 = 0;
    while j < n {
        if cs.model_widths[j] == VC_SORT_F32() || cs.model_widths[j] == VC_SORT_F64() { return false; }
        j = j + 1;
    }
    true
}

// How many values `ans` carries after the claim's handle reads when `vc_nest_enabled`: the contents
// behind the handles and the count of them, which closes the answer (0 for an answer that was not
// enriched, which has neither reads nor count).
fn vc_nest_extra(cs: VcClaims, k: u64, ans: VcSolverAnswer) -> u64 {
    if !vc_nest_enabled(cs, k) { return 0; }
    let total: u64 = ans.values.len();
    let base: u64 = vc_claim_model_count(cs, k) + vc_read_rows(cs, k).len();
    if total <= base { return 0; }
    let cells: i64 = ans.values[total - 1];
    if cells < 0 || (cells as u64) + 1 > total - base { return 0; }
    (cells as u64) + 1
}

// Closes the enriched model `ans` of claim `k` with the count of the contents behind its handle
// reads, none yet, so every enriched answer of a claim `vc_nest_enabled` ends in one.
fn vc_nest_seal(cs: VcClaims, k: u64, ans: VcSolverAnswer) -> VcSolverAnswer {
    if ans.verdict == VC_ANS_SAT() && vc_nest_enabled(cs, k) {
        ans.values.push(0);
        ans.highs.push(0);
    }
    ans
}
