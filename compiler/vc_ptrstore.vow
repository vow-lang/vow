module VcPtrStore

use ir
use ir_dominance
use vc_ops
use vc_strops
use vc_heap
use vc_vec
use vc_overlay

// Gate rule for a pointer stored into a `Vec` (`outer.push(inner)`, `names.push(s)`,
// `rows[i] = row`). The slot holds the object's address. When nothing looks at it again, `push`
// and `set` store a fresh 64-bit constant (`vc_exec`), exact for everything the function can
// observe: the length, the bounds of the other elements and the returned `Vec`. A function that
// could look at the slot is one of three cases:
//
//   - it reads an element back (`get` of a `Vec` that holds a stored pointer) and every `Vec` a
//     pointer is stored into is one it created, so every element is an address it stored: the slot
//     holds the address of the object (`vc_overlay_addr_of`, the entry of #1756) and a read through
//     the element is a read of that object, `vc_ptr_store_resolvable`;
//   - it copies (`pin_to_root`, `vec_sort`) such a `Vec`, which carries the slot along, or reads
//     back an element of a `Vec` the function was given, which the model cannot tell from a stored
//     address: `Skipped`;
//   - it reads memory through a handle (a stored pointer may be reachable through any handle the
//     function loaded): exact when every `Vec` a pointer is stored into is one the function built
//     and no pointer read out of memory is used as an object, `vc_ptr_store_exact`; the address
//     model also covers it (`vc_ptr_store_resolvable`) when the function reads an element back.
//
// The constant is exact, not a bound. A `Vec` the function built is no object a handle loaded
// from the memory it was given can name, and the model makes no pointer visible through one: the
// slot holds a constant nothing else mentions, so a read of the slot is a value the model leaves
// free, which only a function that uses that value as an object (a `Vec` operation or a field
// access on a pointer an element read returned) could turn into a claim about the pushed object.
// A function with no such use cannot tell.

// The verdict of the gate on a function that stores pointers into `Vec`s: `detail` is "" when
// the function is inside the subset, else the detail of an `unsupported-opcode` skip. `addr` is
// true when the slots hold the address of the object (`vc_overlay_addr_of`) and not a fresh
// constant, which is what a function that reads such a slot back needs.
struct VcPtrStores {
    detail: String,
    addr: bool,
}

fn vc_ptr_stores_none() -> VcPtrStores {
    VcPtrStores { detail: String::from(""), addr: false }
}

fn vc_ptr_stores_refused(detail: String) -> VcPtrStores {
    VcPtrStores { detail: detail, addr: false }
}

// "" when no pointer is stored, or none can be read back; else the detail of an
// `unsupported-opcode` skip.
fn vc_ptr_store_detail(f: IrFunction, tys: Vec<i64>, calls: bool) -> String {
    vc_ptr_store_analyze(f, tys, calls).detail
}

fn vc_ptr_store_analyze(f: IrFunction, tys: Vec<i64>, calls: bool) -> VcPtrStores {
    let held: Vec<i64> = vc_ptr_store_held(f, tys);
    if vc_heap_count_marked(held) == 0 { return vc_ptr_stores_none(); }
    let mut reads: bool = false;
    let mut gets: bool = false;
    let mut bi: u64 = 0;
    while bi < f.blocks.len() {
        let blk: IrBlock = f.blocks[bi];
        let mut ii: u64 = 0;
        while ii < blk.insts.len() {
            let inst: IrInst = blk.insts[ii];
            let k: i64 = vc_inst_vec_kind(inst);
            if inst.op == IOP_CALL() && inst.args.len() > 0 && held[inst.args[0] as u64] == 1 {
                if k == VC_VEC_GET() { gets = true; }
                if k == VC_VEC_SORT() || k == VC_STR_CLONE() { return vc_ptr_stores_refused(String::from("a Vec of pointer elements is copied")); }
            }
            if vc_heap_is_read(inst, tys) {
                reads = true;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    if !gets {
        if reads && !vc_ptr_store_exact(f, held, tys, calls) {
            return vc_ptr_stores_refused(String::from("a pointer element is stored in a function that reads memory through a handle"));
        }
        return vc_ptr_stores_none();
    }
    if vc_ptr_store_resolvable(f, held, tys, calls) { return VcPtrStores { detail: String::from(""), addr: true }; }
    vc_ptr_stores_refused(String::from("a pointer element is read back"))
}

// 1 for every receiver of a pointer store (`push` or `set` of an object), closed over Phis.
fn vc_ptr_store_held(f: IrFunction, tys: Vec<i64>) -> Vec<i64> {
    let n_ids: u64 = tys.len();
    let held: Vec<i64> = dom_fill(n_ids, 0);
    let mut any: bool = false;
    let mut bi: u64 = 0;
    while bi < f.blocks.len() {
        let blk: IrBlock = f.blocks[bi];
        let mut ii: u64 = 0;
        while ii < blk.insts.len() {
            let inst: IrInst = blk.insts[ii];
            if inst.op == IOP_CALL() && vc_ptr_store_value(inst, tys) {
                held[inst.args[0] as u64] = 1;
                any = true;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    if any { vc_phi_merges_objects(f, held, n_ids, true); }
    held
}

// True when the function reads an element back out of a `Vec` a pointer is stored into: its slots
// hold the address of the object (`vc_ptr_store_analyze` has admitted the function on that
// ground). The walk asks this of the unrolled or loop-closed function it executes, which has the
// instructions of the one the gate checked.
fn vc_ptr_store_reads_back(f: IrFunction, tys: Vec<i64>) -> bool {
    let held: Vec<i64> = vc_ptr_store_held(f, tys);
    let mut bi: u64 = 0;
    while bi < f.blocks.len() {
        let blk: IrBlock = f.blocks[bi];
        let mut ii: u64 = 0;
        while ii < blk.insts.len() {
            let inst: IrInst = blk.insts[ii];
            if inst.op == IOP_CALL() && inst.args.len() > 0 && held[inst.args[0] as u64] == 1 && vc_inst_vec_kind(inst) == VC_VEC_GET() { return true; }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    false
}

// The values the address model can name by an object: a pointer parameter, an allocation, a
// string literal, a `Vec` or `String` a builtin builds, and a Phi all of whose edges are. 2 is the
// result of a user call, which `vc_inline` replaces by such a Phi (`calls`, the check of one
// function of a call tree before inlining); the flattened function is checked again.
fn vc_ptr_store_known(f: IrFunction, tys: Vec<i64>, calls: bool) -> Vec<i64> {
    let n_ids: u64 = tys.len();
    let known: Vec<i64> = dom_fill(n_ids, 0);
    let phi: Vec<i64> = dom_fill(n_ids, 0);
    let mut bi: u64 = 0;
    while bi < f.blocks.len() {
        let blk: IrBlock = f.blocks[bi];
        let mut ii: u64 = 0;
        while ii < blk.insts.len() {
            let inst: IrInst = blk.insts[ii];
            if inst.id >= 0 && (inst.id as u64) < n_ids {
                let k: i64 = vc_inst_vec_kind(inst);
                if inst.op == IOP_GET_ARG() && inst.ty == ITY_PTR() { known[inst.id as u64] = 1; }
                if inst.op == IOP_REGION_ALLOC() || inst.op == IOP_CONST_STR() { known[inst.id as u64] = 1; }
                if inst.op == IOP_CALL() && (k == VC_VEC_NEW() || vc_str_kind_creates(k)) { known[inst.id as u64] = 1; }
                if inst.op == IOP_CALL() && calls && inst.dk == IDATA_CALL_TARGET() { known[inst.id as u64] = 2; }
                if inst.op == IOP_PHI() && inst.ty == ITY_PTR() {
                    known[inst.id as u64] = 1;
                    phi[inst.id as u64] = 1;
                }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    let mut changed: bool = true;
    while changed {
        changed = false;
        bi = 0;
        while bi < f.blocks.len() {
            let blk: IrBlock = f.blocks[bi];
            let mut ii: u64 = 0;
            while ii < blk.insts.len() {
                let inst: IrInst = blk.insts[ii];
                if inst.op == IOP_UPSILON() && inst.args.len() == 1 && inst.dv >= 0 && (inst.dv as u64) < n_ids
                    && phi[inst.dv as u64] == 1 && known[inst.dv as u64] != 0
                    && (inst.args[0] < 0 || (inst.args[0] as u64) >= n_ids || known[inst.args[0] as u64] == 0) {
                    known[inst.dv as u64] = 0;
                    changed = true;
                }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
    }
    known
}

// True when the address model (`vc_overlay_addr_of`) reads back every element of every `Vec` a
// pointer is stored into, so a read through an element names the object that was stored:
//   - each such `Vec` is one the function created empty (`Vec::new`): every element it holds is
//     an address the function stored, never one of the memory it was given, which a stored
//     address is assumed different from (`vc_overlay_tag_start`);
//   - each pointer stored is a known object with a class (`vc_ptr_store_known`; an object used as
//     no `Vec`, `String` or struct, and not built as one, has no state to read back) and nothing
//     but a pointer is stored (a handle read out of memory is no address the tags know);
//   - an element read of any other `Vec` is not used as an object, since it may equal the address
//     of an object the function stored.
// `held[v]` marks the receivers of the stores, closed over Phis.
fn vc_ptr_store_resolvable(f: IrFunction, held: Vec<i64>, tys: Vec<i64>, calls: bool) -> bool {
    let n_ids: u64 = tys.len();
    let known: Vec<i64> = vc_ptr_store_known(f, tys, calls);
    let classes: Vec<i64> = vc_overlay_class_table(f, tys);
    let built: Vec<i64> = vc_overlay_elem_table(f, n_ids);
    let foreign: Vec<i64> = dom_fill(n_ids, 0);
    let mut bi: u64 = 0;
    while bi < f.blocks.len() {
        let blk: IrBlock = f.blocks[bi];
        let mut ii: u64 = 0;
        while ii < blk.insts.len() {
            let inst: IrInst = blk.insts[ii];
            let k: i64 = vc_inst_vec_kind(inst);
            if inst.id >= 0 && (inst.id as u64) < n_ids && held[inst.id as u64] == 1 && inst.op != IOP_PHI() {
                let deferred: bool = calls && inst.op == IOP_FIELD_GET() && inst.ty == ITY_I64();
                if !deferred && !(inst.op == IOP_CALL() && k == VC_VEC_NEW()) { return false; }
            }
            if inst.op == IOP_CALL() && inst.args.len() > 0 && held[inst.args[0] as u64] == 1 {
                if (k == VC_VEC_PUSH() && inst.args.len() == 2) || (k == VC_VEC_SET() && inst.args.len() == 3) {
                    let v: i64 = inst.args[inst.args.len() - 1];
                    if vc_heap_ty(tys, v) != ITY_PTR() || known[v as u64] == 0 { return false; }
                    if known[v as u64] == 1 && classes[v as u64] + built[v as u64] == 0 { return false; }
                }
            }
            if inst.op == IOP_CALL() && k == VC_VEC_GET() && inst.id >= 0 && inst.args.len() > 0 && held[inst.args[0] as u64] == 0 {
                foreign[inst.id as u64] = 1;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    vc_heap_close_over_phis(f, foreign);
    bi = 0;
    while bi < f.blocks.len() {
        let blk: IrBlock = f.blocks[bi];
        let mut ii: u64 = 0;
        while ii < blk.insts.len() {
            let inst: IrInst = blk.insts[ii];
            if vc_ptr_store_is_object_use(inst) && vc_ptr_store_uses_elem(inst, foreign, n_ids) { return false; }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    true
}

// True when `inst` reads or writes an object through its first operand: a field access or an
// extern `Vec`/`String` operation.
fn vc_ptr_store_is_object_use(inst: IrInst) -> bool {
    inst.op == IOP_FIELD_GET() || inst.op == IOP_FIELD_SET()
        || (inst.op == IOP_CALL() && inst.dk == IDATA_CALL_EXTERN() && vc_inst_vec_kind(inst) != VC_VEC_NONE())
}

// True when the pointer stores of a function that reads memory through a handle are all
// into `Vec`s it built, and no pointer an element read through memory returned is used as an
// object. `held[v]` marks the receivers of the stores, closed over Phis.
fn vc_ptr_store_exact(f: IrFunction, held: Vec<i64>, tys: Vec<i64>, calls: bool) -> bool {
    let n_ids: u64 = tys.len();
    let elem: Vec<i64> = dom_fill(n_ids, 0);
    let mut bi: u64 = 0;
    while bi < f.blocks.len() {
        let blk: IrBlock = f.blocks[bi];
        let mut ii: u64 = 0;
        while ii < blk.insts.len() {
            let inst: IrInst = blk.insts[ii];
            if inst.id >= 0 && (inst.id as u64) < n_ids && held[inst.id as u64] == 1 && inst.op != IOP_PHI() {
                let k: i64 = vc_inst_vec_kind(inst);
                // With `calls` (one function of a call tree, before `vc_inline` flattens it) a
                // collection read out of a field of a struct a callee builds is what
                // `vc_resolve_ptr_fields` names by the object it holds once the callee is inlined;
                // the check of the flattened function, which has no `calls`, refuses it if it did not.
                let deferred: bool = calls && inst.op == IOP_FIELD_GET() && inst.ty == ITY_I64();
                if !deferred && (inst.op != IOP_CALL() || !(k == VC_VEC_NEW() || vc_str_kind_creates(k))) { return false; }
            }
            if inst.op == IOP_CALL() && inst.id >= 0 && (inst.id as u64) < n_ids && inst.args.len() > 0
                && vc_inst_vec_kind(inst) == VC_VEC_GET() {
                elem[inst.id as u64] = 1;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    vc_heap_close_over_phis(f, elem);
    bi = 0;
    while bi < f.blocks.len() {
        let blk: IrBlock = f.blocks[bi];
        let mut ii: u64 = 0;
        while ii < blk.insts.len() {
            let inst: IrInst = blk.insts[ii];
            if vc_ptr_store_is_object_use(inst) && vc_ptr_store_uses_elem(inst, elem, n_ids) {
                return false;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    true
}

// True when an object operand of `inst` (the first, and the further strings of a `String`
// operation) is a pointer an element read returned.
fn vc_ptr_store_uses_elem(inst: IrInst, elem: Vec<i64>, n_ids: u64) -> bool {
    let k: i64 = vc_inst_vec_kind(inst);
    let mut n: u64 = 1;
    if inst.op == IOP_CALL() && k != VC_VEC_NONE() && !vc_str_kind_no_object_operand(k) { n = vc_str_kind_object_operands(k); }
    let mut p: u64 = 0;
    while p < n && p < inst.args.len() {
        let a: i64 = inst.args[p];
        if a >= 0 && (a as u64) < n_ids && elem[a as u64] == 1 { return true; }
        p = p + 1;
    }
    false
}

// True when `inst` is a `push` or `set` whose stored value is an object.
fn vc_ptr_store_value(inst: IrInst, tys: Vec<i64>) -> bool {
    let k: i64 = vc_inst_vec_kind(inst);
    if k == VC_VEC_PUSH() && inst.args.len() == 2 { return vc_heap_ty(tys, inst.args[1]) == ITY_PTR(); }
    if k == VC_VEC_SET() && inst.args.len() == 3 { return vc_heap_ty(tys, inst.args[2]) == ITY_PTR(); }
    false
}
