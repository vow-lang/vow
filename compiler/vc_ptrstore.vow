module VcPtrStore

use ir
use ir_dominance
use vc_ops
use vc_strops
use vc_heap
use vc_vec

// Gate rule for a pointer stored into a `Vec` (`outer.push(inner)`, `names.push(s)`,
// `rows[i] = row`). The slot holds the object's address, and the model has no
// address for an object the function built: `push` and `set` store a fresh
// 64-bit constant (`vc_exec`), exact for everything that never looks at the slot
// again, which is what the length, the bounds of the other elements and the
// returned `Vec` need. A function that could look at it is not modelled:
//
//   - `get` of a `Vec` that holds a stored pointer returns that constant, and a read
//     through it (`len`, `get`, `byte_at`, a field) is a read of memory the model does
//     not tie to the object that was pushed, so it would be free where the runtime has
//     one answer;
//   - a copy (`pin_to_root`, `vec_sort`) of such a `Vec` carries the slot along;
//   - a stored pointer may be reachable through any handle the function loaded (the
//     `Vec` may be a parameter another handle names), so a function that reads memory
//     through a handle at all is left to ESBMC.
//
// The full model (an address per object, read back through the overlay of
// `vc_overlay`) is the object-identity work tracked by #1663.

// "" when no pointer is stored, or none can be read back; else the detail of an
// `unsupported-opcode` skip.
fn vc_ptr_store_detail(f: IrFunction, tys: Vec<i64>) -> String {
    let n_ids: u64 = tys.len();
    let held: Vec<i64> = dom_fill(n_ids, 0);
    let mut any: bool = false;
    let mut bi: u64 = 0;
    while bi < f.blocks.len() {
        let blk: IrBlock = f.blocks[bi];
        let mut ii: u64 = 0;
        while ii < blk.insts.len() {
            let inst: IrInst = blk.insts[ii];
            if inst.op == IOP_CALL() && vc_ptr_store_value(inst, tys) {
                held[inst.args[0] as u64] = 1;
                any = true;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    if !any { return String::from(""); }
    vc_phi_merges_objects(f, held, n_ids, true);
    bi = 0;
    while bi < f.blocks.len() {
        let blk: IrBlock = f.blocks[bi];
        let mut ii: u64 = 0;
        while ii < blk.insts.len() {
            let inst: IrInst = blk.insts[ii];
            let k: i64 = vc_inst_vec_kind(inst);
            if inst.op == IOP_CALL() && inst.args.len() > 0 && held[inst.args[0] as u64] == 1 {
                if k == VC_VEC_GET() { return String::from("a pointer element is read back"); }
                if k == VC_VEC_SORT() || k == VC_STR_CLONE() { return String::from("a Vec of pointer elements is copied"); }
            }
            if vc_heap_is_read(inst, tys) {
                return String::from("a pointer element is stored in a function that reads memory through a handle");
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    String::from("")
}

// True when `inst` is a `push` or `set` whose stored value is an object.
fn vc_ptr_store_value(inst: IrInst, tys: Vec<i64>) -> bool {
    let k: i64 = vc_inst_vec_kind(inst);
    if k == VC_VEC_PUSH() && inst.args.len() == 2 { return vc_heap_ty(tys, inst.args[1]) == ITY_PTR(); }
    if k == VC_VEC_SET() && inst.args.len() == 3 { return vc_heap_ty(tys, inst.args[2]) == ITY_PTR(); }
    false
}
