module VcLinear

use ir
use vc_loops

// Linearity is the type checker's business: a `linear struct` value is consumed
// exactly once, and the lowerer marks that with `LinearConsume`, a no-op for the
// verifier. As data a linear value is an ordinary aggregate, so the native
// verifier reads the IR with the linear pointer type (`ITY_LPTR`) erased to the
// plain pointer type (`ITY_PTR`). Codegen and the region pass keep the
// distinction; only the copy handed to the verifier loses it.

fn vc_lin_ty(ty: i64) -> i64 {
    if ty == ITY_LPTR() { ITY_PTR() } else { ty }
}

fn vc_has_linear_ty(f: IrFunction) -> bool {
    if f.return_ty == ITY_LPTR() { return true; }
    let mut pi: u64 = 0;
    while pi < f.params.len() {
        if f.params[pi] == ITY_LPTR() { return true; }
        pi = pi + 1;
    }
    let mut bi: u64 = 0;
    while bi < f.blocks.len() {
        let blk: IrBlock = f.blocks[bi];
        let mut ii: u64 = 0;
        while ii < blk.insts.len() {
            if blk.insts[ii].ty == ITY_LPTR() { return true; }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    false
}

// `f` with every linear pointer type read as a plain pointer. `f` itself is not
// changed; it is returned as it is when it mentions no linear type.
fn vc_erase_linear_fn(f: IrFunction) -> IrFunction {
    if !vc_has_linear_ty(f) { return f; }
    let g: IrFunction = vc_function_shell(f);
    g.return_ty = vc_lin_ty(f.return_ty);
    let params: Vec<i64> = Vec::new();
    let mut pi: u64 = 0;
    while pi < f.params.len() {
        params.push(vc_lin_ty(f.params[pi]));
        pi = pi + 1;
    }
    g.params = params;
    let mut bi: u64 = 0;
    while bi < f.blocks.len() {
        let blk: IrBlock = f.blocks[bi];
        let nb: IrBlock = ir_block_new(blk.id);
        let mut ii: u64 = 0;
        while ii < blk.insts.len() {
            let inst: IrInst = blk.insts[ii];
            if inst.ty == ITY_LPTR() {
                let out: IrInst = vc_clone_inst(inst, inst.id, inst.args, inst.dv, inst.dv2);
                out.ty = ITY_PTR();
                nb.insts.push(out);
            } else {
                nb.insts.push(inst);
            }
            ii = ii + 1;
        }
        g.blocks.push(nb);
        bi = bi + 1;
    }
    g
}

// `m` with every function read through `vc_erase_linear_fn`, in the same order.
// The driver and each worker build this once, so function indices agree.
fn vc_erase_linear(m: IrModule) -> IrModule {
    let out: IrModule = ir_module_new(m.name);
    let mut fi: u64 = 0;
    while fi < m.functions.len() {
        out.functions.push(vc_erase_linear_fn(m.functions[fi]));
        fi = fi + 1;
    }
    out.strings = m.strings;
    out.struct_layouts = m.struct_layouts;
    out.enum_layouts = m.enum_layouts;
    out.warnings = m.warnings;
    out
}
