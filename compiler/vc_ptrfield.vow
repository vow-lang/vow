module VcPtrField

use ir
use ir_dominance
use vc_ops
use vc_strops
use vc_gate
use vc_loops
use vc_agg_shape
use vc_sources
use vc_ptrphi

// A collection held in a field of a struct the function allocated, and used where an
// object is declared. The IR types such a field `i64` (a handle, see `vc_heap`), so
// `block.insts.push(x)` is a call whose receiver is a value the model reads through
// memory and cannot write. When the function stores that field exactly once and the
// store dominates the read, the read is the stored object, and the call is the call on
// that object. `vc_resolve_ptr_fields` makes this substitution on the inlined function,
// before the gate: it changes which value an object operand names, never what an
// instruction does.
//
// The rule is per read, and fail-closed:
//
//   - the field is read from an allocation `A` (a `RegionAlloc`, reached through the
//     Phis a call result is after inlining, which must lead to nothing else);
//   - the stores of that slot that may name `A` are every `FieldSet` of the slot through `A`,
//     through a Phi that merges `A`, through a receiver the rule cannot place, or, when `A`
//     has escaped (it was stored into a field, pushed into a collection or passed as a value,
//     so a pointer the function loaded may be it), through any pointer that is not a
//     parameter or an allocation. A receiver the rule cannot place leaves the read alone;
//   - the read is the value of the last store that dominates it (an earlier position in the
//     read's own block, or a dominating block). Each store must name `A`
//     alone: a store through a Phi that merges `A` with another object may leave the slot as
//     it was. Every store that does not dominate the read must be unable to reach it, in a
//     block from which the read's block cannot be entered. A read that fails this because a
//     store in one arm of a branch merges before it is the Phi of the stored objects
//     (`vc_phi_reach`, vc_ptrphi); a loop around the read or a store leaves it alone;
//   - the stored value is a pointer, and it is defined where the read is.
//
// Only the object operands of a `Vec` or `String` operation are replaced. A read with
// another use keeps its instruction; a read whose every use was replaced is dropped,
// so the gate no longer sees a field read back. A parameter's field is never resolved:
// another parameter may be the same object and store the slot too. A `FieldSet` of a
// shape the rule does not know makes the whole pass a no-op.

// What the rule knows about one function. `s_*` are the `FieldSet`s of the reachable blocks
// (stored value, slot, block index, position). Each store is linked under every allocation or
// parameter its receiver may be (`a_head[v]` is a list through `a_next` of indices into
// `s_*`), and a store whose receiver is none of those is `loose` (`loose_any` when it has no
// leaves at all, so it may be anything; `loose_loaded` when a leaf was loaded from memory,
// which only an allocation that escaped may be). `escaped[v]` is 1 for an allocation that may
// be reached by a pointer the function did not name. `s_only[s]` is the one allocation or
// parameter the receiver of store `s` leads to, -1 when it leads to several. `nums`, `poff` and
// `plist` are the dominator numbering and the predecessor lists (offsets, then the blocks),
// built when a store and a read in different blocks first need them (`nums` is empty until then).
struct VcPfCtx {
    ok: bool,
    f: IrFunction,
    src: VcSources,
    tys: Vec<i64>,
    nums: Vec<i64>,
    poff: Vec<i64>,
    plist: Vec<i64>,
    s_val: Vec<i64>,
    s_slot: Vec<i64>,
    s_blk: Vec<i64>,
    s_pos: Vec<i64>,
    s_only: Vec<i64>,
    a_head: Vec<i64>,
    a_next: Vec<i64>,
    a_store: Vec<i64>,
    loose_any: Vec<i64>,
    loose_loaded: Vec<i64>,
    escaped: Vec<i64>,
}

// The number of leading operands of `inst` that are objects of a `Vec` or `String`
// operation: 0 for an instruction that is none.
fn vc_pf_object_operands(inst: IrInst) -> u64 {
    if inst.op != IOP_CALL() || inst.dk != IDATA_CALL_EXTERN() { return 0; }
    let k: i64 = vc_inst_vec_kind(inst);
    if k == VC_VEC_NONE() || vc_str_kind_no_object_operand(k) { return 0; }
    if string_starts_with(inst.ds, VC_STR_PREFIX()) == 1 { return vc_str_kind_object_operands(k); }
    1
}

// True when a leaf is a pointer that is neither built in this function nor received as a
// parameter: one the function loaded, which an allocation that escaped may be.
fn vc_pf_loaded_leaf(leaves: Vec<i64>, def_op: Vec<i64>) -> bool {
    let mut i: u64 = 0;
    while i < leaves.len() {
        let v: i64 = leaves[i];
        if v < 0 || (v as u64) >= def_op.len() { return true; }
        let op: i64 = def_op[v as u64];
        if op != IOP_REGION_ALLOC() && op != IOP_GET_ARG() { return true; }
        i = i + 1;
    }
    false
}

fn vc_pf_mark_escaped(c: VcPfCtx, v: i64) {
    let src: VcSources = c.src;
    if v < 0 || (v as u64) >= c.tys.len() || c.tys[v as u64] != ITY_PTR() { return; }
    let leaves: Vec<i64> = vc_sources_leaves(src, v);
    let mut i: u64 = 0;
    while i < leaves.len() {
        if leaves[i] >= 0 && (leaves[i] as u64) < c.escaped.len() { c.escaped[leaves[i] as u64] = 1; }
        i = i + 1;
    }
}

// Links store `s` under `leaf`.
fn vc_pf_link(c: VcPfCtx, leaf: i64, s: i64) {
    let at: i64 = c.a_store.len() as i64;
    c.a_store.push(s);
    c.a_next.push(c.a_head[leaf as u64]);
    c.a_head[leaf as u64] = at;
}

// The context of `f`; `ok` is false when a `FieldSet` has a shape the rule does not know.
fn vc_pf_context(f: IrFunction, tys: Vec<i64>, rpo: Vec<i64>, n_ids: u64) -> VcPfCtx {
    let src: VcSources = vc_sources_new(f, rpo, n_ids);
    let c: VcPfCtx = VcPfCtx {
        ok: false,
        f: f,
        src: src,
        tys: tys,
        nums: Vec::new(),
        poff: Vec::new(),
        plist: Vec::new(),
        s_val: Vec::new(),
        s_slot: Vec::new(),
        s_blk: Vec::new(),
        s_pos: Vec::new(),
        s_only: Vec::new(),
        a_head: dom_fill(n_ids, -1),
        a_next: Vec::new(),
        a_store: Vec::new(),
        loose_any: Vec::new(),
        loose_loaded: Vec::new(),
        escaped: dom_fill(n_ids, 0),
    };
    let mut b: u64 = 0;
    while b < f.blocks.len() {
        if rpo[b] >= 0 {
            let blk: IrBlock = f.blocks[b];
            let mut i: u64 = 0;
            while i < blk.insts.len() {
                let inst: IrInst = blk.insts[i];
                if inst.op == IOP_FIELD_SET() {
                    if inst.args.len() != 2 || inst.dv < 0 { return c; }
                    let s: i64 = c.s_val.len() as i64;
                    c.s_val.push(inst.args[1]);
                    c.s_slot.push(inst.dv);
                    c.s_blk.push(b as i64);
                    c.s_pos.push(i as i64);
                    let leaves: Vec<i64> = vc_sources_leaves(src, inst.args[0]);
                    if leaves.len() == 1 { c.s_only.push(leaves[0]); } else { c.s_only.push(-1); }
                    let mut l: u64 = 0;
                    while l < leaves.len() {
                        let v: i64 = leaves[l];
                        if v >= 0 && (v as u64) < n_ids && (src.op[v as u64] == IOP_REGION_ALLOC() || src.op[v as u64] == IOP_GET_ARG()) {
                            vc_pf_link(c, v, s);
                        }
                        l = l + 1;
                    }
                    if leaves.len() == 0 {
                        c.loose_any.push(s);
                    } else if vc_pf_loaded_leaf(leaves, src.op) {
                        c.loose_loaded.push(s);
                    }
                    vc_pf_mark_escaped(c, inst.args[1]);
                } else if inst.op == IOP_CALL() {
                    let objs: u64 = vc_pf_object_operands(inst);
                    let mut p: u64 = objs;
                    while p < inst.args.len() {
                        vc_pf_mark_escaped(c, inst.args[p]);
                        p = p + 1;
                    }
                }
                i = i + 1;
            }
        }
        b = b + 1;
    }
    c.ok = true;
    c
}

// True when store `x` runs before store or read `y` (a block, a position) on every path to `y`.
fn vc_pf_before(c: VcPfCtx, x: i64, yb: i64, yi: i64) -> bool {
    if c.s_blk[x as u64] == yb { return c.s_pos[x as u64] < yi; }
    vc_pf_dominates(c, c.s_blk[x as u64], yb)
}

// True when no store of `slot` whose receiver the rule cannot place may name `a`.
fn vc_pf_slot_clean(c: VcPfCtx, a: i64, slot: i64) -> bool {
    let mut n: u64 = 0;
    while n < c.loose_any.len() {
        if c.s_slot[c.loose_any[n] as u64] == slot { return false; }
        n = n + 1;
    }
    if c.escaped[a as u64] == 1 {
        n = 0;
        while n < c.loose_loaded.len() {
            if c.s_slot[c.loose_loaded[n] as u64] == slot { return false; }
            n = n + 1;
        }
    }
    true
}

// The value stored into slot `slot` of allocation `a` by the last store that dominates the
// read at (`rb`, `ri`), when no other store can reach the read; -1 otherwise.
fn vc_pf_last_store(c: VcPfCtx, a: i64, slot: i64, rb: i64, ri: i64) -> i64 {
    if !vc_pf_slot_clean(c, a, slot) { return -1; }
    let mut last: i64 = -1;
    let mut e: i64 = c.a_head[a as u64];
    while e >= 0 {
        let s: i64 = c.a_store[e as u64];
        if c.s_slot[s as u64] == slot {
            if vc_pf_before(c, s, rb, ri) {
                if last < 0 || vc_pf_before(c, last, c.s_blk[s as u64], c.s_pos[s as u64]) {
                    last = s;
                } else if !vc_pf_before(c, s, c.s_blk[last as u64], c.s_pos[last as u64]) {
                    return -1;
                }
            }
        }
        e = c.a_next[e as u64];
    }
    if last < 0 { return -1; }
    if !vc_pf_others_cannot_reach(c, a, slot, rb, ri) { return -1; }
    let v: i64 = c.s_val[last as u64];
    if v < 0 || (v as u64) >= c.tys.len() || c.tys[v as u64] != ITY_PTR() { return -1; }
    v
}

// The value of slot `slot` of `a` at the read (`rb`, `ri`) when it depends on the path taken:
// a Phi (or the one value every path agrees on) of the stores that reach the read. Every store
// of the slot must name `a` alone and store a pointer; -1 when the walk fails.
fn vc_pf_merge_store(c: VcPfCtx, plan: VcPhiPlan, a: i64, slot: i64, rb: i64, ri: i64) -> i64 {
    if !vc_pf_slot_clean(c, a, slot) { return -1; }
    vc_pf_cfg(c);
    let last: Vec<i64> = dom_fill(c.f.blocks.len(), -1);
    let at: Vec<i64> = dom_fill(c.f.blocks.len(), -1);
    let mut e: i64 = c.a_head[a as u64];
    while e >= 0 {
        let s: u64 = c.a_store[e as u64] as u64;
        if c.s_slot[s] == slot {
            let v: i64 = c.s_val[s];
            if c.s_only[s] != a || v < 0 || (v as u64) >= c.tys.len() || c.tys[v as u64] != ITY_PTR() { return -1; }
            let blk: u64 = c.s_blk[s] as u64;
            if (blk as i64 != rb || c.s_pos[s] < ri) && c.s_pos[s] > at[blk] {
                at[blk] = c.s_pos[s];
                last[blk] = v;
            }
        }
        e = c.a_next[e as u64];
    }
    vc_phi_reach(plan, last, c.poff, c.plist, c.nums, rb)
}

// Every store of the slot names `a` alone (a store through a Phi that merges `a` with another
// object may leave the slot as it was), and each that is not before the read is in a block the
// read's block cannot be entered from.
fn vc_pf_others_cannot_reach(c: VcPfCtx, a: i64, slot: i64, rb: i64, ri: i64) -> bool {
    let mut from: Vec<i64> = Vec::new();
    let mut e: i64 = c.a_head[a as u64];
    while e >= 0 {
        let s: i64 = c.a_store[e as u64];
        if c.s_slot[s as u64] == slot {
            if c.s_only[s as u64] != a { return false; }
            if !vc_pf_before(c, s, rb, ri) {
                if from.len() == 0 { from = vc_pf_entering(c, rb); }
                if from[c.s_blk[s as u64] as u64] == 1 { return false; }
            }
        }
        e = c.a_next[e as u64];
    }
    true
}

// `out[b]` is 1 when block `rb` can be entered from block `b` along one or more edges.
fn vc_pf_entering(c: VcPfCtx, rb: i64) -> Vec<i64> {
    vc_pf_cfg(c);
    let nb: u64 = c.f.blocks.len();
    let out: Vec<i64> = dom_fill(nb, 0);
    let work: Vec<i64> = Vec::new();
    work.push(rb);
    while work.len() > 0 {
        let b: i64 = work[work.len() - 1];
        work.pop();
        let mut k: i64 = c.poff[b as u64];
        while k < c.poff[(b + 1) as u64] {
            let p: i64 = c.plist[k as u64];
            if out[p as u64] == 0 {
                out[p as u64] = 1;
                work.push(p);
            }
            k = k + 1;
        }
    }
    out
}

// True when block `a` dominates block `b`.
fn vc_pf_dominates(c: VcPfCtx, a: i64, b: i64) -> bool {
    vc_pf_cfg(c);
    dom_dominates(c.nums, c.f.blocks.len(), a, b)
}

// Builds the dominator numbering and the predecessor lists on first use.
fn vc_pf_cfg(c: VcPfCtx) {
    if c.nums.len() > 0 { return; }
    let f: IrFunction = c.f;
    let nb: u64 = f.blocks.len();
    let id_to_idx: Vec<i64> = dom_block_id_table(f);
    let succ: Vec<i64> = dom_successors(f, id_to_idx);
    let rpo: Vec<i64> = dom_rpo_numbers(nb, succ);
    let order: Vec<i64> = dom_rpo_order(rpo);
    let off: Vec<i64> = dom_pred_offsets(nb, succ, rpo);
    let preds: Vec<i64> = dom_pred_list(nb, succ, rpo, off);
    let nums: Vec<i64> = dom_tree_numbers(nb, dom_idoms(nb, rpo, order, off, preds), order);
    let mut i: u64 = 0;
    while i < nums.len() {
        c.nums.push(nums[i]);
        i = i + 1;
    }
    i = 0;
    while i < off.len() {
        c.poff.push(off[i]);
        i = i + 1;
    }
    i = 0;
    while i < preds.len() {
        c.plist.push(preds[i]);
        i = i + 1;
    }
}

// `repl[id]` is the pointer value the field read `id` resolves to, -1 for a read left alone.
fn vc_pf_resolve(c: VcPfCtx, plan: VcPhiPlan, rpo: Vec<i64>, n_ids: u64) -> Vec<i64> {
    let f: IrFunction = c.f;
    let repl: Vec<i64> = dom_fill(n_ids, -1);
    let src: VcSources = c.src;
    let mut b: u64 = 0;
    while b < f.blocks.len() {
        if rpo[b] >= 0 {
            let blk: IrBlock = f.blocks[b];
            let mut i: u64 = 0;
            while i < blk.insts.len() {
                let inst: IrInst = blk.insts[i];
                if inst.op == IOP_FIELD_GET() && inst.ty == ITY_I64() && inst.dk == IDATA_FIELD() && inst.id >= 0
                    && inst.args.len() == 1 && inst.args[0] >= 0 && (inst.args[0] as u64) < n_ids && c.tys[inst.args[0] as u64] == ITY_PTR() {
                    let leaves: Vec<i64> = vc_sources_leaves(src, inst.args[0]);
                    if leaves.len() == 1 && leaves[0] >= 0 && (leaves[0] as u64) < n_ids && src.op[leaves[0] as u64] == IOP_REGION_ALLOC() {
                        let mut v: i64 = vc_pf_last_store(c, leaves[0], inst.dv, b as i64, i as i64);
                        if v < 0 { v = vc_pf_merge_store(c, plan, leaves[0], inst.dv, b as i64, i as i64); }
                        repl[inst.id as u64] = v;
                    }
                }
                i = i + 1;
            }
        }
        b = b + 1;
    }
    repl
}

fn vc_pf_candidate(f: IrFunction) -> bool {
    let mut gets: bool = false;
    let mut sets: bool = false;
    let mut b: u64 = 0;
    while b < f.blocks.len() {
        let blk: IrBlock = f.blocks[b];
        let mut i: u64 = 0;
        while i < blk.insts.len() {
            let inst: IrInst = blk.insts[i];
            if inst.op == IOP_FIELD_GET() && inst.ty == ITY_I64() { gets = true; }
            if inst.op == IOP_FIELD_SET() { sets = true; }
            i = i + 1;
        }
        b = b + 1;
    }
    gets && sets
}

// The value operand `p` of `inst` is replaced by, -1 when it stays.
fn vc_pf_operand(inst: IrInst, p: u64, objs: u64, repl: Vec<i64>) -> i64 {
    let a: i64 = inst.args[p];
    if p < objs && a >= 0 && (a as u64) < repl.len() { return repl[a as u64]; }
    -1
}

// `inst` with its object operands replaced, or `inst` itself when none is.
fn vc_pf_rewrite(inst: IrInst, repl: Vec<i64>) -> IrInst {
    let objs: u64 = vc_pf_object_operands(inst);
    if objs == 0 { return inst; }
    let mut hit: bool = false;
    let mut p: u64 = 0;
    while p < objs && p < inst.args.len() {
        if vc_pf_operand(inst, p, objs, repl) >= 0 { hit = true; }
        p = p + 1;
    }
    if !hit { return inst; }
    let args: Vec<i64> = Vec::new();
    p = 0;
    while p < inst.args.len() {
        let r: i64 = vc_pf_operand(inst, p, objs, repl);
        if r >= 0 { args.push(r); } else { args.push(inst.args[p]); }
        p = p + 1;
    }
    vc_clone_inst(inst, inst.id, args, inst.dv, inst.dv2)
}

// `f` with every resolvable field read replaced where it is an object operand. `f` itself is
// returned when nothing resolves; an untouched block of the result is `f`'s own.
fn vc_resolve_ptr_fields(f: IrFunction) -> IrFunction {
    if !vc_pf_candidate(f) { return f; }
    let nb: u64 = f.blocks.len();
    let id_to_idx: Vec<i64> = dom_block_id_table(f);
    let succ: Vec<i64> = dom_successors(f, id_to_idx);
    let rpo: Vec<i64> = dom_rpo_numbers(nb, succ);
    let n_ids: u64 = (dom_max_inst_id(f) + 1) as u64;
    let tys: Vec<i64> = vc_ty_table(f);
    if tys.len() < n_ids { return f; }
    let c: VcPfCtx = vc_pf_context(f, tys, rpo, n_ids);
    if !c.ok { return f; }
    let plan: VcPhiPlan = vc_phi_plan_new(n_ids as i64, nb);
    let repl: Vec<i64> = vc_pf_resolve(c, plan, rpo, n_ids);
    let uses: Vec<i64> = dom_fill(n_ids, 0);
    let done: Vec<i64> = dom_fill(n_ids, 0);
    let mut any: bool = false;
    let mut b: u64 = 0;
    while b < nb {
        let blk: IrBlock = f.blocks[b];
        let mut i: u64 = 0;
        while i < blk.insts.len() {
            let inst: IrInst = blk.insts[i];
            let objs: u64 = vc_pf_object_operands(inst);
            let mut p: u64 = 0;
            while p < inst.args.len() {
                let a: i64 = inst.args[p];
                if a >= 0 && (a as u64) < n_ids {
                    uses[a as u64] = uses[a as u64] + 1;
                    if p < objs && repl[a as u64] >= 0 {
                        done[a as u64] = done[a as u64] + 1;
                        any = true;
                    }
                }
                p = p + 1;
            }
            i = i + 1;
        }
        b = b + 1;
    }
    if !any { return f; }
    let g: IrFunction = vc_function_shell(f);
    b = 0;
    while b < nb {
        let blk: IrBlock = f.blocks[b];
        let out: IrBlock = ir_block_new(blk.id);
        vc_phi_emit_heads(plan, b, out);
        let term: i64 = if plan.ups_head[b] >= 0 { vc_last_terminal(blk) } else { -1 };
        let mut i: u64 = 0;
        while i < blk.insts.len() {
            let inst: IrInst = blk.insts[i];
            if i as i64 == term { vc_phi_emit_ups(plan, b, out, inst); }
            let dead: bool = inst.id >= 0 && (inst.id as u64) < n_ids && done[inst.id as u64] > 0 && done[inst.id as u64] == uses[inst.id as u64];
            if !dead {
                out.insts.push(vc_pf_rewrite(inst, repl));
            }
            i = i + 1;
        }
        g.blocks.push(out);
        b = b + 1;
    }
    g
}
