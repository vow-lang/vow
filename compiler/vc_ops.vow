module VcOps

use ir
use ir_dominance
use vc_fp

// The native verifier's op-model table: the one place that says which IR
// opcodes and runtime builtins the verifier models, and the closed set of
// `Skipped` reason codes of ADR-2026-10-08-1430. Opcodes are listed here;
// builtins come from `docs/spec/operations.json` (`verifier_model`) through the
// generated lookups below. Anything not listed is not modelled: the gate skips
// the function, it never guesses.

fn VC_SKIP_FUNCTION_HAS_EFFECTS() -> String { String::from("function-has-effects") }
fn VC_SKIP_RECURSION() -> String { String::from("recursion-unsupported") }
fn VC_SKIP_FLOAT_REM() -> String { String::from("float-rem-unsupported") }
fn VC_SKIP_NON_DOMINATING_READ() -> String { SKIP_IR_NON_DOMINATING_READ() }
fn VC_SKIP_UNMODELED_BUILTIN() -> String { String::from("unmodeled-builtin") }
fn VC_SKIP_UNSUPPORTED_OPCODE() -> String { String::from("unsupported-opcode") }
fn VC_SKIP_NON_MODELABLE_CALLEE() -> String { String::from("non-modelable-callee") }
fn VC_SKIP_RESERVED_SYMBOL() -> String { String::from("reserved-verifier-symbol") }

// The closed list; adding a code requires amending the ADR.
fn vc_skip_code_valid(code: String) -> bool {
    code == VC_SKIP_FUNCTION_HAS_EFFECTS()
        || code == VC_SKIP_RECURSION()
        || code == VC_SKIP_FLOAT_REM()
        || code == VC_SKIP_NON_DOMINATING_READ()
        || code == VC_SKIP_UNMODELED_BUILTIN()
        || code == VC_SKIP_UNSUPPORTED_OPCODE()
        || code == VC_SKIP_NON_MODELABLE_CALLEE()
        || code == VC_SKIP_RESERVED_SYMBOL()
}

// A function named after one of the checker's own intrinsics is never verified
// (the ESBMC model's reserved set, kept so both backends skip the same
// functions). No native query contains a function name, so this is a verdict
// policy, not a collision the encoding could suffer.
fn vc_reserved_symbol(name: String) -> bool {
    string_starts_with(name, String::from("__ESBMC_")) == 1
        || string_starts_with(name, String::from("__VERIFIER_")) == 1
}

fn VC_OPM_UNCLASSIFIED() -> i64 { -1 }
// The symbolic executor encodes the opcode (the gate still checks operand types).
fn VC_OPM_MODELED() -> i64 { 0 }
// Deliberately not modelled yet: `unsupported-opcode`.
fn VC_OPM_UNSUPPORTED() -> i64 { 1 }
// Decided per instruction: an extern call is looked up in the builtin model.
fn VC_OPM_CALL() -> i64 { 2 }
// `float-rem-unsupported` until codegen defines float `%`.
fn VC_OPM_FLOAT_REM() -> i64 { 4 }

fn vc_op_modeled(op: i64) -> bool {
    vc_op_modeled_int(op) || vc_op_modeled_core(op) || vc_fp_is_op(op)
}

fn vc_op_modeled_int(op: i64) -> bool {
    op == IOP_CONST_I32() || op == IOP_CONST_U64() || op == IOP_CONST_U8()
        || op == IOP_CONST_I128() || op == IOP_CONST_U128()
        || op == IOP_CADD() || op == IOP_CSUB() || op == IOP_CMUL() || op == IOP_CDIV() || op == IOP_CREM()
        || op == IOP_SHL() || op == IOP_SHR() || op == IOP_INT_CAST()
}

fn vc_op_modeled_core(op: i64) -> bool {
    op == IOP_FIELD_GET() || op == IOP_FIELD_SET()
        || op == IOP_CONST_I64() || op == IOP_CONST_BOOL() || op == IOP_GET_ARG()
        || op == IOP_WADD() || op == IOP_WSUB() || op == IOP_WMUL() || op == IOP_WDIV() || op == IOP_WREM()
        || op == IOP_BITAND() || op == IOP_BITOR() || op == IOP_BITXOR()
        || op == IOP_EQ() || op == IOP_NE() || op == IOP_LT() || op == IOP_LE() || op == IOP_GT() || op == IOP_GE()
        || op == IOP_NOT() || op == IOP_AND() || op == IOP_OR()
        || op == IOP_VOW_REQ() || op == IOP_VOW_ENS() || op == IOP_VOW_INV() || op == IOP_RETURN()
        || op == IOP_CONST_UNIT() || op == IOP_BRANCH() || op == IOP_JUMP() || op == IOP_UNREACHABLE()
        || op == IOP_PHI() || op == IOP_UPSILON()
        || op == IOP_REGION_ALLOC() || op == IOP_REGION_OPEN() || op == IOP_REGION_CLOSE()
        || op == IOP_CONST_STR()
}

fn vc_op_unsupported(op: i64) -> bool {
    op == IOP_LOAD() || op == IOP_STORE()
        || op == IOP_DEBUG_CALL()
        || op == IOP_COMPLEXITY_DESCRIPTOR()
        || op == IOP_LINEAR_CONSUME() || op == IOP_LINEAR_BORROW()
}

// How the verifier treats an opcode. An opcode in none of the lists is
// `VC_OPM_UNCLASSIFIED`, which the gate treats like an unsupported one; the
// table test fails if an opcode of ir.vow is left unclassified. The per-
// instruction classes come first: they are the ones the gate asks about.
fn vc_op_model(op: i64) -> i64 {
    if op == IOP_CALL() { return VC_OPM_CALL(); }
    if op == IOP_REM_F32() || op == IOP_REM_F64() { return VC_OPM_FLOAT_REM(); }
    if vc_op_modeled(op) { return VC_OPM_MODELED(); }
    if vc_op_unsupported(op) { return VC_OPM_UNSUPPORTED(); }
    VC_OPM_UNCLASSIFIED()
}

// The lowerer's own call to the unwrap abort: reaching it is the unwrap-on-None
// failure. It is not a catalogue builtin, so the table lists it here; the
// executor turns it into a claim that its path is infeasible.
fn VC_INTERNAL_UNWRAP_PANIC() -> String { String::from("__vow_unwrap_panic") }

fn vc_is_unwrap_abort(inst: IrInst) -> bool {
    inst.op == IOP_CALL() && inst.dk == IDATA_CALL_EXTERN() && inst.ds == VC_INTERNAL_UNWRAP_PANIC()
}

// `Vec` and `String` operations the symbolic executor models as an array plus a
// symbolic length (`vc_vec`, `vc_str`). They are listed here by runtime symbol,
// like the unwrap abort, and not in the builtin catalogue: the catalogue is keyed
// by Vow builtin name and its entries need a grammar row. A symbol not listed
// (`truncate`, `reserve`, `from_raw_parts_copy`, the wide-slot variants, `trim`,
// `split`, ...) is an unmodelled builtin. A `String` shares the `VowVec` layout of
// a `Vec<u8>`, so its length is `VC_VEC_LEN` and the other string kinds start at
// `VC_STR_BASE`.
fn VC_VEC_NONE() -> i64 { 0 }
fn VC_VEC_NEW() -> i64 { 1 }
fn VC_VEC_PUSH() -> i64 { 2 }
fn VC_VEC_GET() -> i64 { 3 }
fn VC_VEC_SET() -> i64 { 4 }
fn VC_VEC_LEN() -> i64 { 5 }
fn VC_VEC_POP() -> i64 { 6 }

fn VC_STR_BASE() -> i64 { 16 }
fn VC_STR_LITERAL() -> i64 { 16 }
fn VC_STR_CLONE() -> i64 { 17 }
fn VC_STR_NEW() -> i64 { 18 }
fn VC_STR_PUSH_BYTE() -> i64 { 19 }
fn VC_STR_BYTE_AT() -> i64 { 20 }
fn VC_STR_CLEAR() -> i64 { 21 }
fn VC_STR_PUSH_STR() -> i64 { 22 }
fn VC_STR_EQ() -> i64 { 23 }
fn VC_STR_MATCHES() -> i64 { 24 }
fn VC_STR_SUBSTRING() -> i64 { 25 }
fn VC_STR_SUBSTR() -> i64 { 26 }
fn VC_STR_PARSE() -> i64 { 27 }
fn VC_STR_FORMAT() -> i64 { 28 }

// The integer parsers and formatters the executor models as opaque: a parse
// returns an `Option` whose tag and payload are unconstrained, a format returns a
// String of unconstrained content and length. Each call is independent of every
// other and of its operand's bytes. The 128-bit variants are not modelled.
fn vc_str_opaque_kind(sym: String) -> i64 {
    if sym == String::from("__vow_string_from_i64") || sym == String::from("__vow_string_from_u64") {
        return VC_STR_FORMAT();
    }
    if string_starts_with(sym, String::from("__vow_string_parse_")) != 1 { return VC_VEC_NONE(); }
    if sym == String::from("__vow_string_parse_i8_opt") || sym == String::from("__vow_string_parse_i16_opt")
        || sym == String::from("__vow_string_parse_i32_opt") || sym == String::from("__vow_string_parse_i64_opt")
        || sym == String::from("__vow_string_parse_u8_opt") || sym == String::from("__vow_string_parse_u16_opt")
        || sym == String::from("__vow_string_parse_u32_opt") || sym == String::from("__vow_string_parse_u64_opt") {
        return VC_STR_PARSE();
    }
    VC_VEC_NONE()
}

fn vc_str_op_kind(sym: String) -> i64 {
    if string_starts_with(sym, String::from("__vow_string_")) != 1 { return VC_VEC_NONE(); }
    let opaque: i64 = vc_str_opaque_kind(sym);
    if opaque != VC_VEC_NONE() { return opaque; }
    if sym == String::from("__vow_string_len") { return VC_VEC_LEN(); }
    if sym == String::from("__vow_string_literal") { return VC_STR_LITERAL(); }
    if sym == String::from("__vow_string_clone") || sym == String::from("__vow_string_pin_to_root") {
        return VC_STR_CLONE();
    }
    if sym == String::from("__vow_string_new") { return VC_STR_NEW(); }
    if sym == String::from("__vow_string_push_byte") { return VC_STR_PUSH_BYTE(); }
    if sym == String::from("__vow_string_byte_at") { return VC_STR_BYTE_AT(); }
    if sym == String::from("__vow_string_clear") { return VC_STR_CLEAR(); }
    if sym == String::from("__vow_string_push_str") { return VC_STR_PUSH_STR(); }
    if sym == String::from("__vow_string_eq") { return VC_STR_EQ(); }
    if sym == String::from("__vow_string_matches_literal_at") { return VC_STR_MATCHES(); }
    if sym == String::from("__vow_string_substring") { return VC_STR_SUBSTRING(); }
    if sym == String::from("__vow_string_substr") { return VC_STR_SUBSTR(); }
    VC_VEC_NONE()
}

// The reason a `__vow_string_*` helper is not modelled, "" for a modelled one and
// for any symbol that is not a string helper. The table is closed over the
// runtime's string symbols: `test_vc_ops` lists them all and fails when one is
// neither modelled (`vc_str_op_kind`) nor given a reason here.
fn vc_str_unmodeled_reason(sym: String) -> String {
    if string_starts_with(sym, String::from("__vow_string_")) != 1 { return String::from(""); }
    if vc_str_op_kind(sym) != VC_VEC_NONE() { return String::from(""); }
    if string_ends_with(sym, String::from("_in_arena")) == 1 || string_ends_with(sym, String::from("_in_candidate_arena")) == 1 {
        return String::from("arena-routed variant of a string helper");
    }
    if sym == String::from("__vow_string_from_raw_parts_copy") { return String::from("raw memory copy, capacity trap not modelled"); }
    if sym == String::from("__vow_string_from_cstr") { return String::from("C string read"); }
    if sym == String::from("__vow_string_from_i128") || sym == String::from("__vow_string_from_u128")
        || sym == String::from("__vow_string_parse_i128_opt") || sym == String::from("__vow_string_parse_u128_opt") {
        return String::from("128-bit number parse or format");
    }
    if sym == String::from("__vow_string_contains") || sym == String::from("__vow_string_starts_with")
        || sym == String::from("__vow_string_ends_with") {
        return String::from("substring search");
    }
    if sym == String::from("__vow_string_trim") || sym == String::from("__vow_string_to_upper")
        || sym == String::from("__vow_string_to_lower") || sym == String::from("__vow_string_replace") {
        return String::from("content transform");
    }
    if sym == String::from("__vow_string_split") || sym == String::from("__vow_string_join") {
        return String::from("Vec<String> operation");
    }
    if sym == String::from("__vow_string_print") { return String::from("I/O"); }
    String::from("unlisted string helper")
}

// The kinds that change the contents or length of an existing object: a loop
// that runs one cannot be cut for induction with stale entry state.
fn vc_vec_kind_writes(kind: i64) -> bool {
    kind == VC_VEC_PUSH() || kind == VC_VEC_SET() || kind == VC_VEC_POP()
        || kind == VC_STR_PUSH_BYTE() || kind == VC_STR_CLEAR() || kind == VC_STR_PUSH_STR()
}

// The kinds whose result is a new container object.
fn vc_vec_kind_creates(kind: i64) -> bool {
    kind == VC_VEC_NEW() || kind == VC_STR_LITERAL() || kind == VC_STR_CLONE() || kind == VC_STR_NEW()
        || kind == VC_STR_SUBSTRING() || kind == VC_STR_SUBSTR() || kind == VC_STR_FORMAT()
}

// Operand 0 / operand 1 is a container the operation reads or changes (a
// literal's operand 0 is the constant, a `new`'s are the empty data).
fn vc_vec_kind_arg0_container(kind: i64) -> bool {
    kind != VC_VEC_NEW() && kind != VC_STR_LITERAL() && kind != VC_STR_NEW() && kind != VC_STR_FORMAT()
}

fn vc_vec_kind_arg1_container(kind: i64) -> bool {
    kind == VC_STR_PUSH_STR() || kind == VC_STR_EQ()
}

// Dispatched on the symbol's length, so a call to anything else costs one
// comparison instead of one per operation.
fn vc_vec_op_kind(sym: String) -> i64 {
    let n: u64 = sym.len();
    if n == 13 {
        if sym == String::from("__vow_vec_new") { return VC_VEC_NEW(); }
        if sym == String::from("__vow_vec_len") { return VC_VEC_LEN(); }
        if sym == String::from("__vow_vec_pop") { return VC_VEC_POP(); }
    } else if n == 17 {
        if sym == String::from("__vow_vec_get_val") { return VC_VEC_GET(); }
        if sym == String::from("__vow_vec_set_val") { return VC_VEC_SET(); }
    } else if n == 18 {
        if sym == String::from("__vow_vec_push_val") { return VC_VEC_PUSH(); }
    }
    vc_str_op_kind(sym)
}

// The `Vec` operation an instruction is, or `VC_VEC_NONE`.
fn vc_inst_vec_kind(inst: IrInst) -> i64 {
    if inst.op != IOP_CALL() || inst.dk != IDATA_CALL_EXTERN() { return VC_VEC_NONE(); }
    vc_vec_op_kind(inst.ds)
}

// The `Unreachable` the loop unroller puts where a back edge goes past the
// bound. Reaching it means some run needs more iterations than the bound.
fn VC_INTERNAL_UNWIND_SINK() -> String { String::from("__vc_unwind_sink") }

fn vc_is_unwind_sink(inst: IrInst) -> bool {
    inst.op == IOP_UNREACHABLE() && inst.ds == VC_INTERNAL_UNWIND_SINK()
}

// The two markers of the inductive loop cut (`vc_induct`) and of the k-induction
// step function (`vc_unroll_step`). A havoc call defines
// a header Phi's value as an unconstrained constant of its type; the `Unreachable`
// ends the preservation copy of a loop header, where control returns to the
// header and no claim is left to make.
fn VC_INTERNAL_HAVOC() -> String { String::from("__vc_havoc") }

fn vc_is_havoc(inst: IrInst) -> bool {
    inst.op == IOP_CALL() && inst.dk == IDATA_CALL_EXTERN() && inst.ds == VC_INTERNAL_HAVOC()
}

fn VC_INTERNAL_CUT_END() -> String { String::from("__vc_cut_end") }

fn vc_is_cut_end(inst: IrInst) -> bool {
    inst.op == IOP_UNREACHABLE() && inst.ds == VC_INTERNAL_CUT_END()
}

// Inlined callee bodies. The splicer (`vc_inline`) copies a callee into its
// caller; every clause and abort-bearing instruction of the copy carries the
// frame it came from in `ds`, which no such opcode uses otherwise and which
// `vc_clone_inst` preserves, so the marker survives loop closing and unrolling.
// Frame k of `VcFrames` is the k-th spliced call, in depth-first order: the
// function it enters, the source range of the call and the frame of the call's
// own caller (-1 for the verify target).
struct VcFrames {
    func_ids: Vec<i64>,
    call_starts: Vec<i64>,
    call_lens: Vec<i64>,
    parents: Vec<i64>,
}

fn vc_frames_new() -> VcFrames {
    VcFrames { func_ids: Vec::new(), call_starts: Vec::new(), call_lens: Vec::new(), parents: Vec::new() }
}

fn VC_FRAME_PREFIX() -> String { String::from("__vc_frame:") }

fn vc_frame_mark(k: i64) -> String {
    let out: String = VC_FRAME_PREFIX();
    out.push_str(i64_to_string(k));
    out
}

// An extern call that can fail keeps its symbol in `ds`, so the frame it was
// spliced from travels in `dv2` (`frame + 1`; 0 for the target's own, which the
// lowerer emits with `dv2` 0): the unwrap abort and a `Vec` `get`/`set`, whose
// bounds check is a claim.
fn vc_frame_in_dv2(inst: IrInst) -> bool {
    if vc_is_unwrap_abort(inst) { return true; }
    let k: i64 = vc_inst_vec_kind(inst);
    k == VC_VEC_GET() || k == VC_VEC_SET() || k == VC_STR_BYTE_AT()
}

// The frame an instruction was spliced from; -1 for the target's own.
fn vc_frame_of(inst: IrInst) -> i64 {
    if vc_frame_in_dv2(inst) { return inst.dv2 - 1; }
    // Only the opcodes `vc_map_inst` marks carry a frame in `ds`: a `ConstStr`'s
    // `ds` is the literal's own bytes, which may spell the prefix.
    if !vc_op_frame_marked(inst.op) { return -1; }
    let pre: String = VC_FRAME_PREFIX();
    if inst.ds.len() <= pre.len() || string_starts_with(inst.ds, pre) != 1 {
        return -1;
    }
    match parse_i64(inst.ds.substring(pre.len(), inst.ds.len())) {
        Option::Some(k) => { k },
        Option::None => { -1 },
    }
}

// The function that owns frame `k` (`root` for the target).
fn vc_frame_func(fr: VcFrames, k: i64, root: i64) -> i64 {
    if k < 0 || k >= fr.func_ids.len() as i64 { return root; }
    fr.func_ids[k as u64]
}

// Opcodes whose instances carry a frame marker when spliced.
fn vc_op_frame_marked(op: i64) -> bool {
    op == IOP_VOW_REQ() || op == IOP_VOW_ENS() || op == IOP_VOW_INV()
        || op == IOP_CADD() || op == IOP_CSUB() || op == IOP_CMUL() || op == IOP_CDIV() || op == IOP_CREM()
        || op == IOP_WDIV() || op == IOP_WREM() || op == IOP_SHL() || op == IOP_SHR()
}

// Opcodes the gate looks at: modelled outright, or decided per instruction.
fn vc_op_gate_candidate(op: i64) -> bool {
    let model: i64 = vc_op_model(op);
    model == VC_OPM_MODELED() || model == VC_OPM_CALL()
}

// Builtins are modelled only when `catalogue_verifier_known` lists their runtime
// symbol; an `unmodeled` entry and a symbol the catalogue lacks are skipped alike.

// GENERATE:OPERATIONS:START
fn catalogue_verifier_known(sym: String) -> bool {
    return false;
}
// GENERATE:OPERATIONS:END
