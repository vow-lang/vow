module Oracle

// Status codes — match the JSON record's "status" field.
fn ST_CAUGHT()   -> i64 { 0 }
fn ST_MISSED()   -> i64 { 1 }
fn ST_TIMEOUT()  -> i64 { 2 }
fn ST_UNVIABLE() -> i64 { 3 }
fn ST_UNRUN()    -> i64 { 4 }

// Tier sentinel for the Tier-1.5 checkpoint (fast partial `full_test.sh`,
// between Tier 1's build-only oracle and Tier 2's full suite). Deliberately
// not 1 or 2, so every existing "tier":1/"tier":2 meaning is untouched;
// `tier_json_str` special-cases this value to serialize the literal
// JSON number 1.5 instead of 15.
fn TIER_15() -> i64 { 15 }

// Mirrors status_str(): the single formatter every tier-serializing call
// site goes through, so a future tier (e.g. 1.75) adds one case here
// instead of a second ad hoc branch at its own call site.
fn tier_json_str(tier: i64) -> String {
    if tier == TIER_15() { return String::from("1.5"); }
    i64_to_string(tier)
}

fn status_str(s: i64) -> String {
    if s == ST_CAUGHT()   { return String::from("caught"); }
    if s == ST_MISSED()   { return String::from("missed"); }
    if s == ST_TIMEOUT()  { return String::from("timeout"); }
    if s == ST_UNVIABLE() { return String::from("unviable"); }
    if s == ST_UNRUN()    { return String::from("unrun"); }
    String::from("unknown")
}

// Verdict for an oracle run on the unmutated tree: "" means the baseline
// passed, anything else is the human-readable reason it did not. Any
// nonzero rc is a failure here, unlike per-mutant classification where it
// means the mutant was caught.
fn baseline_failure_reason(rc: i64) -> String {
    if rc == 0 { return String::from(""); }
    if rc == -1 { return String::from("could not spawn the oracle command"); }
    if rc == -2 { return String::from("timed out"); }
    let r: String = String::from("exit code ");
    r.push_str(i64_to_string(rc));
    r
}

// Run a shell command via `sh -c`, return exit code (or -2 on timeout, -1 on
// spawn error). Cmd is interpreted by the shell, so it can include flags,
// pipes, redirections, etc.
//
// To kill the entire process tree on timeout (otherwise the `sh -c`
// process dies but its grandchildren — cargo, ESBMC, gcc — survive and
// leak into subsequent mutant runs within the same shard), the command
// is wrapped in coreutils `timeout(1)`. `timeout` sends SIGTERM to the
// process group on expiry, then SIGKILL after a 5s grace period.
//
// `process_wait_timeout` is still set with a 30s slack window past
// timeout_ms as a backstop; in practice `timeout(1)` should fire first
// and the shell exits with code 124 (mapped to -2 here for parity with
// `process_wait_timeout`'s native timeout sentinel).
fn run_shell(cmd: String, timeout_ms: i64) -> i64 [io] {
    let mut to_secs: i64 = timeout_ms / 1000;
    if to_secs <= 0 { to_secs = 1; }
    let to_arg: String = i64_to_string(to_secs);
    to_arg.push_byte(115);
    let args: Vec<String> = Vec::new();
    args.push(String::from("--kill-after=5s"));
    args.push(to_arg);
    args.push(String::from("sh"));
    args.push(String::from("-c"));
    args.push(cmd);
    let pid: i64 = process_start(String::from("timeout"), args);
    if pid < 0 { return -1; }
    let rc: i64 = process_wait_timeout(pid, timeout_ms + 30000);
    if rc == -2 {
        process_kill(pid);
        return -2;
    }
    // Both timeout exit codes from coreutils `timeout(1)` map to the
    // -2 sentinel: 124 = SIGTERM fired on timeout; 137 = SIGKILL fired
    // after `--kill-after` because the oracle ignored SIGTERM during
    // the grace period. Without the 137 case, hung oracles fall through
    // as "exit > 0" and are misclassified as `caught`.
    if rc == 124 || rc == 137 {
        return -2;
    }
    rc
}
