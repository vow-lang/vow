module VcClaimSolver

use vc_ops
use vc_term
use vc_smt
use vc_query
use vc_solver
use vc_cache
use vc_session
use vc_slice
use vc_summary

// Internal claim-decision machinery of `vc_round`. Query text, cache identity,
// session reuse, slicing, full confirmation and the hedge stay together here.
// Only standalone full queries supply models for hard counterexamples.

// Test-only switch, like `VOW_VERIFY_NO_SLICE`: `VOW_VERIFY_NO_INCREMENTAL=1`
// gives every claim its own solver process, so the corpus can be run both ways
// to show that sharing a solver across the claims of a round never changes a
// verdict or a counterexample.
fn vc_incremental_enabled() -> bool [read] {
    getenv(String::from("VOW_VERIFY_NO_INCREMENTAL")) != String::from("1")
}

// A soft claim is one whose `sat` is not a failure: a reachable checked-operator
// abort, or an unwinding claim.
fn vc_claim_is_soft(cs: VcClaims, k: u64) -> bool {
    cs.kinds[k] == VC_CLAIM_ARITH() || cs.kinds[k] == VC_CLAIM_UNWIND()
}

// True when claim `k` is `sat` without a solver: its negated goal is the
// constant `true` and nothing is assumed before it, so the query is the header
// (declarations and definitions only, which any assignment satisfies) alone. A
// hard claim still goes to the solver, which supplies its counterexample.
fn vc_claim_is_static_sat(cs: VcClaims, k: u64) -> bool {
    if !vc_claim_is_soft(cs, k) { return false; }
    cs.assumed_lens[k] == 0 && vc_tm_is_true(cs.arena, cs.negated_goals[k])
}

// True when hard claim `k` is inside the body of a function proven on its own (`fr.trusted`):
// that proof decided every claim of the body for every argument its `requires` admits. Not
// the `requires` of the trusted function itself, which is the caller's to meet, nor the soft
// claims, which the callers report (`vc_claim_site_known`), nor a loop's unwinding claim, which
// depends on the bound of the round.
fn vc_claim_trusted(fr: VcFrames, cs: VcClaims, k: u64) -> bool {
    let kind: i64 = cs.kinds[k];
    if kind == VC_CLAIM_ARITH() || kind == VC_CLAIM_UNWIND() || fr.trusted.len() == 0 { return false; }
    let mut at: i64 = cs.frames[k];
    if at >= 0 && kind == VC_CLAIM_CALLER_PRE() { at = fr.parents[at as u64]; }
    while at >= 0 {
        if vc_id_in(fr.trusted, fr.func_ids[at as u64]) { return true; }
        at = fr.parents[at as u64];
    }
    false
}

// True when claim `k` is decided by a solver run: not by its own form (`vc_claim_is_static_sat`)
// and not by the proof of the function it lies in (`vc_claim_trusted`).
fn vc_claim_needs_solver(fr: VcFrames, cs: VcClaims, k: u64) -> bool {
    !vc_claim_is_static_sat(cs, k) && !vc_claim_trusted(fr, cs, k)
}

// The index of the last claim of `cs` that needs a solver, -1 when none does.
fn vc_claims_last_solver(fr: VcFrames, cs: VcClaims) -> i64 {
    let mut k: u64 = cs.kinds.len();
    while k > 0 {
        k = k - 1;
        if vc_claim_needs_solver(fr, cs, k) { return k as i64; }
    }
    -1
}

// Whether the claims of a round share one solver process: only when at least
// two of them need a solver and a session may ask them (`vc_session_admits`),
// and the test-only switch is not set.
fn vc_session_wanted(fr: VcFrames, cs: VcClaims, binder_at: i64) -> bool [read] {
    if !vc_incremental_enabled() { return false; }
    let mut needed: i64 = 0;
    let mut k: u64 = 0;
    while k < cs.kinds.len() {
        if vc_claim_needs_solver(fr, cs, k) && vc_session_admits(binder_at, cs, k) { needed = needed + 1; }
        k = k + 1;
    }
    needed >= 2
}

// Asks claim `k`'s full query, prefix and all, in a standalone process.
fn vc_check_claim_full(cache: VcCache, bin: String, cs: VcClaims, k: u64, budget_ms: i64, scratch: String) -> VcSolverAnswer [io, read, write] {
    let query: String = vc_claim_query(cs, k);
    vc_solver_check_cached(cache, bin, query, vc_claim_model_names(cs, k), vc_claim_model_widths(cs, k), budget_ms, scratch)
}

// Decides claim `k` with standalone queries. With slicing on, the query holds
// only the claim's cone of influence and an `unsat` answer to it is final: the
// sliced query is a relaxation of the full one. Any other answer says nothing
// about the full query (the dropped assumptions may be contradictory on their
// own, which makes the claim vacuously proven), so the full query is asked in
// what is left of the budget and alone decides. Two cases do not ask it twice.
// A soft claim from which only definitions were dropped: that query is
// equisatisfiable with the full one and its answer carries no model, so it
// stands. And a hard claim in the same case: the slice kept every assumption
// and dropped only definitions nothing kept references, so its ask re-decides
// the full query's answer at the full query's cost -- a `sat` is discarded for
// the full query anyway (the counterexample is the standalone model of the
// claim's own text), and an `unsat` is the one the full query gives too. The
// full query is asked directly, and it alone decides.
fn vc_check_claim_oneshot(cache: VcCache, bin: String, cs: VcClaims, sx: VcSlicer, slicing: bool, k: u64, budget_ms: i64, scratch: String) -> VcSolverAnswer [io, read, write] {
    if slicing {
        let sl: VcSlice = vc_slice_claim(sx, cs, k);
        if sl.dropped_asserts || sl.dropped_defs {
            if !vc_claim_is_soft(cs, k) && vc_slice_is_defs_only(sl) {
                return vc_check_claim_full(cache, bin, cs, k, budget_ms, scratch);
            }
            let started: i64 = time_micros();
            let small: String = vc_smt_render(cs.arena, vc_claim_script_sliced(cs, k, sl));
            let ans: VcSolverAnswer = vc_solver_check_cached(cache, bin, small, vc_claim_model_names(cs, k), vc_claim_model_widths(cs, k), budget_ms, scratch);
            if ans.verdict == VC_ANS_UNSAT() { return ans; }
            if !sl.dropped_asserts && vc_claim_is_soft(cs, k) { return ans; }
            let left_ms: i64 = budget_ms - (time_micros() - started) / 1000;
            return vc_check_claim_full(cache, bin, cs, k, left_ms, scratch);
        }
    }
    vc_check_claim_full(cache, bin, cs, k, budget_ms, scratch)
}

// Decides claim `k`. The result cache is consulted first under the claim's full
// query text, the key a standalone query of the claim uses too, so a decision
// made by a session or by a standalone process serves both. A hit is the
// answer; a miss goes on. A live session is asked next, with at most half of the
// budget so a hard full prefix cannot starve the standalone queries. Its `unsat`
// is final (and stored), and so is its `sat` on a soft claim, whose model is
// never read and so is not stored. A `sat` on a hard claim goes straight to the
// full standalone query, which alone supplies the counterexample (the model of
// an incremental solver is not promised to equal a fresh one's). Anything else
// -- `unknown`, a timeout, a dead or absent session -- takes the standalone path
// in the time that is left. The last claim of a round that needs a solver is
// hedged (`vc_check_claim_race`): nothing follows it for the session to help, so
// when the session has not answered within `vc_session_hedge_window_ms` a fresh
// process is asked alongside it and the first final answer stands. A
// non-positive budget never reaches the cache.
fn vc_check_claim(cache: VcCache, bin: String, cs: VcClaims, sx: VcSlicer, ss: VcSession, slicing: bool, k: u64, budget_ms: i64, scratch: String) -> VcSolverAnswer [io, read, write] {
    let started: i64 = time_micros();
    let mut query: String = String::from("");
    if budget_ms > 0 && vc_cache_on(cache) {
        query = vc_claim_query(cs, k);
        let hit: VcSolverAnswer = vc_cache_peek(cache, query, vc_claim_model_count(cs, k));
        if hit.verdict != VC_ANS_NONE() { return hit; }
    }
    if vc_session_hedges(ss, cs, k) && budget_ms > 0 {
        let hedged: i64 = vc_session_ask_hedged(ss, bin, cs, k, budget_ms / 2, vc_session_hedge_window_ms());
        if hedged == VC_SESSION_PENDING() {
            return vc_check_claim_race(cache, bin, cs, ss, k, budget_ms - (time_micros() - started) / 1000, scratch);
        }
        return vc_check_claim_after_session(cache, bin, cs, sx, slicing, k, budget_ms, scratch, started, query, hedged);
    }
    let said: i64 = vc_session_ask(ss, bin, cs, k, budget_ms / 2);
    return vc_check_claim_after_session(cache, bin, cs, sx, slicing, k, budget_ms, scratch, started, query, said);
}

// What `vc_check_claim` does with the session's answer `said` to claim `k`
// (`VC_ANS_NONE` when it gave none): `unsat`, and `sat` on a soft claim, stand;
// a hard `sat` is decided by the full standalone query; anything else by the
// standalone path in the time that is left. `query` is the claim's full query
// text when the cache is on, else "".
fn vc_check_claim_after_session(cache: VcCache, bin: String, cs: VcClaims, sx: VcSlicer, slicing: bool, k: u64, budget_ms: i64, scratch: String, started: i64, query: String, said: i64) -> VcSolverAnswer [io, read, write] {
    if said == VC_ANS_UNSAT() {
        let proof: VcSolverAnswer = vc_answer_plain(VC_ANS_UNSAT(), String::from(""));
        if query.len() > 0 { vc_cache_put(cache, query, proof); }
        return proof;
    }
    if said == VC_ANS_SAT() && vc_claim_is_soft(cs, k) { return vc_answer_plain(VC_ANS_SAT(), String::from("")); }
    let left_ms: i64 = budget_ms - (time_micros() - started) / 1000;
    if said == VC_ANS_SAT() { return vc_check_claim_full(cache, bin, cs, k, left_ms, scratch); }
    vc_check_claim_oneshot(cache, bin, cs, sx, slicing, k, left_ms, scratch)
}

// The session has not answered the last claim of its round within the hedge
// window: a fresh process is asked the claim's full query alongside it and the
// first answer that is final stands. A session `unsat`, and its `sat` on a soft
// claim, end the standalone process; a standalone answer of any kind ends the
// session (nothing follows this claim). Any other session reply leaves the
// standalone process to decide, as after a session `sat` on a hard claim. Both
// run until `budget_ms` is spent, then neither is waited for. The full query is
// the one a `sat` on a hard claim is decided by, so the counterexample is the
// standalone model whichever process finishes first.
fn vc_check_claim_race(cache: VcCache, bin: String, cs: VcClaims, ss: VcSession, k: u64, budget_ms: i64, scratch: String) -> VcSolverAnswer [io, read, write] {
    let query: String = vc_claim_query(cs, k);
    let names: Vec<String> = vc_claim_model_names(cs, k);
    let run: VcSolverRun = vc_solver_begin(bin, query, scratch);
    if run.handle < 0 {
        vc_session_close(ss);
        return vc_answer_plain(VC_ANS_ERROR(), run.err);
    }
    let soft: bool = vc_claim_is_soft(cs, k);
    let deadline_us: i64 = time_micros() + budget_ms * 1000;
    let mut waiting: bool = true;
    let mut decided: bool = false;
    let mut result: VcSolverAnswer = vc_answer_plain(VC_ANS_TIMEOUT(), String::from(""));
    while !decided {
        let wait_ms: i64 = { if waiting { 0 } else { 5 } };
        let rc: i64 = process_poll_wait(run.handle, wait_ms);
        if rc != vc_solver_running() {
            result = vc_solver_end(run, names, vc_claim_model_widths(cs, k), rc);
            vc_cache_put(cache, query, result);
            decided = true;
        } else if time_micros() >= deadline_us {
            vc_solver_abandon(run);
            decided = true;
        } else if waiting {
            let said: i64 = vc_session_collect(ss, k, time_micros() + 2000);
            if said == VC_ANS_UNSAT() || (said == VC_ANS_SAT() && soft) {
                vc_solver_abandon(run);
                result = vc_answer_plain(said, String::from(""));
                if said == VC_ANS_UNSAT() { vc_cache_put(cache, query, result); }
                decided = true;
            } else if said != VC_SESSION_PENDING() {
                vc_session_close(ss);
                waiting = false;
            }
        }
    }
    vc_session_close(ss);
    result
}
