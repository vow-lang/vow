module VcNative

use ir
use verifier
use vc_smt
use vc_solver
use vc_exec
use vc_cex

// Native verification of one function inside the subset accepted by
// `vc_skip_reason`: every claim is decided by its own solver run, in IR order,
// and the first claim that is not `unsat` decides the result. `unsat` is the
// only outcome that counts as proof. `timeout_ms` is the budget for the whole
// function; each claim gets what is left of it.

fn vc_verify_function(bin: String, f: IrFunction, timeout_ms: i64) -> VerifyResult [io, read, write] {
    let cs: VcClaims = vc_claims(f);
    let started: i64 = time_micros();
    let mut k: u64 = 0;
    while k < cs.scripts.len() {
        let spent_ms: i64 = (time_micros() - started) / 1000;
        let query: String = vc_smt_render(cs.arena, cs.scripts[k]);
        let ans: VcSolverAnswer = vc_solver_check(bin, query, cs.model_names, timeout_ms - spent_ms);
        if ans.verdict != VC_ANS_UNSAT() {
            return vc_claim_result(f, cs, k, ans);
        }
        k = k + 1;
    }
    vc_proven_result()
}
