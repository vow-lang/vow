module VcNative

use ir
use verifier
use vc_smt
use vc_solver
use vc_ops
use vc_gate
use vc_inline
use ir_dominance
use vc_cfg
use vc_loops
use vc_exec
use vc_unroll
use vc_induct
use vc_cex
use vc_term

// Native verification of one function inside the subset accepted by
// `vc_skip_reason`. A function with loops is unrolled to a bound taken from
// `vc_unwind_bounds`, smallest first; each round decides every claim of the
// unrolled function by its own solver run, in IR order. A hard claim that is not
// `unsat` decides the result: a counterexample inside the unrolled prefix is a
// real run, so it fails the function at once. `unsat` is the only outcome that
// counts as proof, and only when the round's unwinding claim is `unsat` too. A
// `sat` unwinding claim means some run needs more iterations than the bound: the
// next round unrolls further, and after the last the result is `unknown`, never
// `proven`. A soft claim (a checked operator's abort) never fails the function:
// `sat` records that the abort is reachable, `unsat` that it is not, and only an
// undecided run (unknown, timeout, error) stops the check. `timeout_ms` is the
// budget for the whole function, shared by all rounds; each claim gets what is
// left of it. `scratch`, when not empty, is the directory for the query files.
// The solver is looked up only when there is a claim to decide: a function
// without obligations is proven without one.
//
// A function whose loops all carry an `invariant` is first tried inductively
// (`vc_induct`): each loop is cut at its header, its variables are havoc'd and
// the invariant is assumed there, so one query set covers every trip count.
// All claims `unsat` is a proof; anything else says nothing, because a
// counterexample may be a state no run reaches, so the bounded schedule above
// decides. A proof with no checked-arithmetic claim ends the check. With one,
// the bounded rounds still run, so the warnings are the aborts they find, and
// the proof is used where they end `unknown` (open at the largest bound, over
// the size budget, or undecided). It never changes a counterexample.

// A verdict plus the reachable checked-arithmetic aborts found on the way. The
// sites are meaningful only when the result is `proven`. A failure inside an
// inlined callee also carries the call chain that leads to it, outermost first:
// per call the function it is made in and the source range of the call.
struct VcOutcome {
    result: VerifyResult,
    sites: Vec<ParsedArithSite>,
    chain_funcs: Vec<i64>,
    chain_starts: Vec<i64>,
    chain_lens: Vec<i64>,
}

// Number of back edges a loop may take before the unwinding claim fails, per
// round. The last bound is at least ESBMC's default `--max-k-step`, so every
// loop ESBMC proves by unwinding is still proven. Internal: `--timeout` is the
// only user knob.
fn vc_unwind_bounds() -> Vec<i64> {
    let b: Vec<i64> = Vec::new();
    b.push(2);
    b.push(4);
    b.push(8);
    b.push(16);
    b.push(32);
    b.push(64);
    b
}

fn vc_bare_outcome(result: VerifyResult) -> VcOutcome {
    VcOutcome { result: result, sites: Vec::new(), chain_funcs: Vec::new(), chain_starts: Vec::new(), chain_lens: Vec::new() }
}

// `result` for a claim of frame `frame`: the calls from the target down to it.
fn vc_chain_outcome(f: IrFunction, fr: VcFrames, frame: i64, result: VerifyResult) -> VcOutcome {
    let oc: VcOutcome = vc_bare_outcome(result);
    let up: Vec<i64> = Vec::new();
    let mut k: i64 = frame;
    while k >= 0 && k < fr.func_ids.len() as i64 {
        up.push(k);
        k = fr.parents[k as u64];
    }
    let mut i: i64 = up.len() as i64;
    while i > 0 {
        i = i - 1;
        let j: i64 = up[i as u64];
        oc.chain_funcs.push(vc_frame_func(fr, fr.parents[j as u64], f.id));
        oc.chain_starts.push(fr.call_starts[j as u64]);
        oc.chain_lens.push(fr.call_lens[j as u64]);
    }
    oc
}

fn vc_check_claim(bin: String, cs: VcClaims, k: u64, budget_ms: i64, scratch: String) -> VcSolverAnswer [io, read, write] {
    let query: String = vc_smt_render(cs.arena, vc_claim_script(cs, k));
    vc_solver_check(bin, query, cs.model_names, cs.model_widths, budget_ms, scratch)
}

// Every unrolled copy of a checked operator repeats one source site.
fn vc_has_site(sites: Vec<ParsedArithSite>, site: ParsedArithSite) -> bool {
    let mut i: u64 = 0;
    while i < sites.len() {
        let s: ParsedArithSite = sites[i];
        if s.ostart == site.ostart && s.olen == site.olen && s.owner == site.owner && s.cause == site.cause {
            return true;
        }
        i = i + 1;
    }
    false
}

fn vc_has_kind(kinds: Vec<i64>, kind: i64) -> bool {
    let mut i: u64 = 0;
    while i < kinds.len() {
        if kinds[i] == kind {
            return true;
        }
        i = i + 1;
    }
    false
}

struct VcRound {
    result: VerifyResult,
    ended: bool,
    open: bool,
    frame: i64,
    soft: bool,
}

// A soft claim is one whose `sat` is not a failure: a reachable checked-operator
// abort, or an unwinding claim.
fn vc_claim_is_soft(cs: VcClaims, k: u64) -> bool {
    cs.kinds[k] == VC_CLAIM_ARITH() || cs.kinds[k] == VC_CLAIM_UNWIND()
}

// True when claim `k` is `sat` without a solver: its negated goal is the
// constant `true` and nothing is assumed before it, so the query is the header
// (declarations and definitions only, which any assignment satisfies) alone. A
// hard claim still goes to the solver, which supplies its counterexample.
fn vc_claim_is_static_sat(cs: VcClaims, k: u64) -> bool {
    if !vc_claim_is_soft(cs, k) { return false; }
    cs.assumed_lens[k] == 0 && vc_tm_is_true(cs.arena, cs.negated_goals[k])
}

// Records a `sat` verdict on a soft claim: the reachable abort of a checked
// operator is a site, an unwinding claim leaves the round open. True when it
// opens the round.
fn vc_note_soft_sat(f: IrFunction, fr: VcFrames, cs: VcClaims, k: u64, sites: Vec<ParsedArithSite>) -> bool {
    if cs.kinds[k] != VC_CLAIM_ARITH() { return true; }
    let site: ParsedArithSite = ParsedArithSite { cause: cs.labels[k], owner: vc_frame_func(fr, cs.frames[k], f.id), ostart: cs.ostarts[k], olen: cs.olens[k] };
    if !vc_has_site(sites, site) {
        sites.push(site);
    }
    false
}

// One round: the claims of the unrolled function `g` of `f`. `sites` collects
// the reachable soft aborts. Returns the verdict that ends the check (any
// outcome but `unsat`/soft `sat`/open unwinding), or `proven` with `open` set
// when only the unwinding claim was `sat`. The solver is located when the first
// claim that needs it comes up. `soft` tells whether `g` has a soft claim at
// all.
fn vc_run_round(f: IrFunction, g: IrFunction, fr: VcFrames, sites: Vec<ParsedArithSite>, started: i64, timeout_ms: i64, scratch: String) -> VcRound [io, read, write] {
    let cs: VcClaims = vc_claims_mode(g, fr, f.vows.len() == 0);
    if cs.kinds.len() == 0 {
        return VcRound { result: vc_proven_result(), ended: false, open: false, frame: -1, soft: false };
    }
    let mut bin: String = String::from("");
    let mut located: bool = false;
    let mut open: bool = false;
    let soft: bool = vc_has_kind(cs.kinds, VC_CLAIM_ARITH());
    let mut k: u64 = 0;
    while k < cs.kinds.len() {
        if vc_claim_is_static_sat(cs, k) {
            if vc_note_soft_sat(f, fr, cs, k, sites) { open = true; }
        } else {
            if !located {
                bin = vc_solver_locate();
                located = true;
            }
            if bin.len() == 0 {
                let nf: VerifyResult = vc_claim_result(f, cs, k, vc_answer_plain(VC_ANS_NOT_FOUND(), String::from("Bitwuzla not found")));
                return VcRound { result: nf, ended: true, open: false, frame: -1, soft: false };
            }
            let spent_ms: i64 = (time_micros() - started) / 1000;
            let ans: VcSolverAnswer = vc_check_claim(bin, cs, k, timeout_ms - spent_ms, scratch);
            if ans.verdict != VC_ANS_UNSAT() {
                if vc_claim_is_soft(cs, k) && ans.verdict == VC_ANS_SAT() {
                    if vc_note_soft_sat(f, fr, cs, k, sites) { open = true; }
                } else {
                    return VcRound { result: vc_claim_result(f, cs, k, ans), ended: true, open: false, frame: cs.frames[k], soft: soft };
                }
            }
        }
        k = k + 1;
    }
    VcRound { result: vc_proven_result(), ended: false, open: open, frame: -1, soft: soft }
}

// The inductive attempt on `closed` (the loop-closed function of target `f`):
// `proves` when every claim of the cut function is `unsat`, `soft` when that
// function has a checked-arithmetic claim. Only `proves` is ever acted on: a
// counterexample to an inductive claim may be a state no run reaches, so a
// failure here says nothing and the bounded verdict stands.
struct VcInduction {
    proves: bool,
    soft: bool,
}

fn vc_induction_attempt(f: IrFunction, closed: IrFunction, fr: VcFrames, started: i64, timeout_ms: i64, scratch: String) -> VcInduction [io, read, write] {
    let none: VcInduction = VcInduction { proves: false, soft: false };
    let c: VcInduct = vc_induct_cut(closed);
    if c.status != VC_INDUCT_OK() {
        return none;
    }
    let g: IrFunction = c.f;
    if vc_unrolled_detail(g, vc_ty_table(g)).len() > 0 || ir_non_dominating_read(g).len() > 0 {
        return none;
    }
    let sites: Vec<ParsedArithSite> = Vec::new();
    let r: VcRound = vc_run_round(f, g, fr, sites, started, timeout_ms, scratch);
    VcInduction { proves: !r.ended && !r.open, soft: r.soft }
}

fn vc_proven_with(sites: Vec<ParsedArithSite>) -> VcOutcome {
    let proven: VcOutcome = vc_bare_outcome(vc_proven_result());
    proven.sites = sites;
    proven
}

// A bounded round that ends undecided (solver unknown, timeout) cannot overturn
// an inductive proof; a counterexample or an error does.
fn vc_undecided(r: VcRound) -> bool {
    r.result.status == VERIFY_TIMEOUT() || r.result.status == VERIFY_UNKNOWN()
}

fn vc_verify_function(f: IrFunction, m: IrModule, timeout_ms: i64, scratch: String) -> VcOutcome [io, read, write] {
    let bounds: Vec<i64> = vc_unwind_bounds();
    let inl: VcInlined = vc_inline(f, m, VC_INLINE_INST_CAP());
    if inl.status == VC_INLINE_TOO_LARGE() {
        return vc_bare_outcome(vc_plain_result(VERIFY_UNKNOWN(), vc_inline_budget_reason(VC_INLINE_INST_CAP())));
    }
    if inl.status != VC_INLINE_OK() {
        return vc_bare_outcome(vc_plain_result(VERIFY_ERROR(), String::from("internal error: call inlining failed")));
    }
    let closed: IrFunction = vc_close_loops(inl.f);
    let started: i64 = time_micros();
    let ind: VcInduction = vc_induction_attempt(f, closed, inl.frames, started, timeout_ms, scratch);
    if ind.proves && !ind.soft {
        return vc_proven_with(Vec::new());
    }
    let mut last_sites: Vec<ParsedArithSite> = Vec::new();
    let mut round: u64 = 0;
    while round < bounds.len() {
        let bound: i64 = bounds[round];
        let u: VcUnrolled = vc_unroll(closed, bound);
        if u.status == VC_UNROLL_TOO_LARGE() {
            if ind.proves {
                return vc_proven_with(last_sites);
            }
            return vc_bare_outcome(vc_plain_result(VERIFY_UNKNOWN(), vc_unwinding_budget_reason(bound)));
        }
        let g: IrFunction = u.f;
        if u.status != VC_UNROLL_OK() || (u.looped && vc_unrolled_detail(g, vc_ty_table(g)).len() > 0) {
            return vc_bare_outcome(vc_plain_result(VERIFY_ERROR(), String::from("internal error: loop unrolling produced an unsupported control-flow graph")));
        }
        let sites: Vec<ParsedArithSite> = Vec::new();
        let r: VcRound = vc_run_round(f, g, inl.frames, sites, started, timeout_ms, scratch);
        if r.ended {
            if ind.proves && vc_undecided(r) {
                return vc_proven_with(sites);
            }
            return vc_chain_outcome(f, inl.frames, r.frame, r.result);
        }
        if !r.open {
            return vc_proven_with(sites);
        }
        last_sites = sites;
        if round + 1 == bounds.len() {
            if ind.proves {
                return vc_proven_with(last_sites);
            }
            return vc_bare_outcome(vc_plain_result(VERIFY_UNKNOWN(), vc_unwinding_reason(bound)));
        }
        round = round + 1;
    }
    vc_bare_outcome(vc_plain_result(VERIFY_UNKNOWN(), vc_unwinding_reason(bounds[bounds.len() - 1])))
}
