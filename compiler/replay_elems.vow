module ReplayElems

use ast
use replay_main
use replay_nested
use replay_alias
use replay_listed

// The counterexample lists the address of each element of a `Vec<S>` parameter (`S` a struct,
// `String` or `Vec`). An element that is the `.addr` of a parameter of type `S` is that
// parameter's object; any other element is built once per address from the contents listed behind
// it (`replay_obj_arg`).

// The element type id of the alias-resolved type `tid` when it is a `Vec` of objects (a `String`,
// a `Vec` or a struct that is not a `linear struct`); -1 for any other type.
fn replay_object_elem_type(m: Module, tid: i64) -> i64 {
    let a: AstArena = m.arena;
    if type_tag(a, tid) != TY_GENERIC() || arena_str(a, type_a(a, tid)) != String::from("Vec") { return -1; }
    let args_lid: i64 = type_b(a, tid);
    if list_len(a, args_lid) != 1 { return -1; }
    let elem: i64 = replay_resolve_type(m, list_get(a, args_lid, 0), 0);
    if !replay_holds_object(m, elem) { return -1; }
    elem
}

// `replay_agg_arg`, except that a non-empty `Vec` of objects holds the objects its elements name:
// a parameter's, or the one the counterexample lists the contents of. Elements with one address
// are one object: the harness binds it once and pushes the binding for each.
fn replay_param_value(m: Module, fn_name: String, pi: i64, names: Vec<String>, vals: Vec<String>, avoid: Vec<i64>, objs: ReplayObjs) -> ReplayArg {
    let a: AstArena = m.arena;
    let fid: i64 = replay_find_fn_item(m, fn_name);
    let lid: i64 = { if fid < 0 { -1 } else { fn_params_lid(a, fid) } };
    if lid < 0 || pi < 0 || pi >= list_len(a, lid) / 4 {
        return replay_agg_arg(m, fn_name, pi, names, vals, avoid, objs);
    }
    let pname: String = arena_str(a, list_get(a, lid, pi * 4));
    let tid: i64 = replay_resolve_type(m, list_get(a, lid, pi * 4 + 1), 0);
    let len: i64 = replay_vec_len(pname, names, vals);
    if replay_object_elem_type(m, tid) < 0 || len <= 0 { return replay_agg_arg(m, fn_name, pi, names, vals, avoid, objs); }
    replay_obj_vec(m, tid, pname, len, names, vals, 0, avoid, replay_objs_at(objs, pi))
}
