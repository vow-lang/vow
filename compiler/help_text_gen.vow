    r.push_str(String::from("          \"description\": \"Per-function verification timeout in seconds; the only resource knob of the native backend, where the default is a fixed 300. ESBMC backend: under --encoding auto, a 30s default is applied so the BV-timeout fallback to --encoding ir --solver z3 can trigger when bit-vector solving takes too long. With explicit encodings, a 300s safety watchdog bounds the run; explicit --timeout overrides both. --timeout 0 is an immediate watchdog kill under ESBMC and a zero budget (no solver is spawned; statically decided claims still resolve) under --backend native (default: 300 (or 30 when --encoding is auto))\",\n          \"long\": \"--timeout\",\n          \"value_name\": \"N\",\n          \"value_kind\": \"integer\",\n          \"default\": \"300 (or 30 when --encoding is auto)\"\n        },\n        {\n          \"form\": \"--verify-jobs <N>\",\n          \"description\": \"Max concurrent verification jobs (ESBMC processes, or verify-worker subprocesses under --backend native)\",\n          \"long\": \"--verify-jobs\",\n          \"value_name\": \"N\",\n          \"value_kind\": \"integer\",\n          \"default\": \"num_cpus/2\"\n        },\n        {\n          \"form\": \"--backend <esbmc|native>\",\n          \"description\": \"Verification backend. native is accepted only by vowc verify, contracts --verify and test --verify; on build and the bare form it is a usage error (exit 1) that points at vowc verify, and esbmc is accepted silently (default: esbmc)\",\n          \"long\": \"--backend\",\n          \"value_name\": \"esbmc|native\",\n          \"value_kind\": \"enum\",\n          \"values\": [\n            \"esbmc\",\n            \"native\"\n          ],\n          \"default\": \"esbmc\"\n        },\n        {\n          \"form\": \"--replay-cex\",\n          \"description\": \"Differential test the verifier model against runtime semantics (same as vow verify --replay-cex; see below)\",\n          \"long\": \"-