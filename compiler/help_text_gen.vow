// GENERATE:SKILL_HUMAN:START
fn skill_human() -> String {
    let r: String = String::from("vow -- Vow compiler\n\nUSAGE\n  vow build [OPTIONS] <source.vow>    Compile to native executable\n  vow verify [OPTIONS] <source.vow>    Verify contracts only (no executable)\n  vow test [OPTIONS] [<path>]          Run tests with JSON results\n  vow contracts [OPTIONS] <source.vow> List all contracts\n  vow complexity [OPTIONS] <source.vow> Report per-function complexity metrics (JSON)\n  vow decl [OPTIONS] <source.vow>    Emit declaration file (.vow.d)\n  vow skill [print [--bundle]|install [--local|--global]]\n                                        Generate or install Claude Code skill\n  vow [OPTIONS] <source.vow>          Legacy mode (same as vow build)\n\nBUILD OPTIONS\n  -o, --output <path>     Output executable path (default: build/<stem>)\n  --mode <debug|release|profile|sanitize>  Build mode: debug inserts runtime vow checks, profile inserts call counters and prints report on normal exit, sanitize adds debug checks + use-after-region-close detection for Vecs (default: release)\n  --no-verify             Skip static verification\n  --dump-ir               Print IR text to stdout and exit (no JSON output, no codegen)\n  --debug-trace <off|calls|full>  Emit JSON trace lines to stderr at runtime (default: off)\n  --no-cache              Disable verification result caching, and (for --no-verify builds) the compile-object cache. See \"Compile-object cache behavior\" below\n  --max-k-step <N>        ESBMC backend only; a usage error under --backend native. ESBMC incremental BMC max iterations (default: 50)\n  --solver <boolector|z3|bitwuzla|auto>  ESBMC backend only; a usage error under --backend native. ESBMC SMT solver; auto selects per-function via heuristic (default: auto)\n  --encoding <bv|ir|auto>  ESBMC backend only; a usage error under --backend native. ESBMC encoding mode: bv (bit-vector) or ir (integer/real arithmetic); ir requires z3 (default: auto)\n");
    r.push_str(String::from("  --timeout <N>           Per-function verification timeout in seconds; the only resource knob of the native backend, where the default is a fixed 300. ESBMC backend: under --encoding auto, a 30s default is applied so the BV-timeout fallback to --encoding ir --solver z3 can trigger when bit-vector solving takes too long. With explicit encodings, a 300s safety watchdog bounds the run; explicit --timeout overrides both. --timeout 0 is an immediate watchdog kill under ESBMC and a zero budget (no solver is spawned; statically decided claims still resolve) under --backend native (default: 300 (or 30 when --encoding is auto))\n  --verify-jobs <N>       Max concurrent verification jobs (ESBMC processes, or verify-worker subprocesses under --backend native)\n  --backend <esbmc|native>  Verification backend. native is accepted only by vowc verify, contracts --verify and test --verify; on build and the bare form it is a usage error (exit 1) that points at vowc verify, and esbmc is accepted silently (default: esbmc)\n  --replay-cex            Differential test the verifier model against runtime semantics (same as vow verify --replay-cex; see below)\n  --perfetto <path>       Write a gzipped Chrome Trace Event Format trace of this compilation to <path> (load directly at ui.perfetto.dev). Captures per-phase spans, codegen/link and, under the ESBMC backend, per-function ESBMC proof spans, the compiler→ESBMC handoff, and time-series CPU/RSS for the compiler and each ESBMC process. Distinct from --mode profile, which instruments the *compiled program*. Pure side artifact: never affects codegen, the build JSON, or the cache.\n\nVERIFY OPTIONS\n  --no-cache              Disable verification result caching; under --backend native it disables the native result cache of verify (see \"Result cache\" below)\n  --max-k-step <N>        ESBMC backend only; a usage error under --backend native. ESBMC incremental BMC max iterations (default: 50)\n"));
    r.push_str(String::from("  --solver <boolector|z3|bitwuzla|auto>  ESBMC backend only; a usage error under --backend native. ESBMC SMT solver; auto selects per-function via heuristic (default: auto)\n  --encoding <bv|ir|auto>  ESBMC backend only; a usage error under --backend native. ESBMC encoding mode: bv (bit-vector) or ir (integer/real arithmetic); ir requires z3 (default: auto)\n  --timeout <N>           Per-function verification timeout in seconds; the only resource knob of the native backend, where the default is a fixed 300. ESBMC backend: under --encoding auto, a 30s default is applied so the BV-timeout fallback to --encoding ir --solver z3 can trigger when bit-vector solving takes too long. With explicit encodings, a 300s safety watchdog bounds the run; explicit --timeout overrides both. --timeout 0 is an immediate watchdog kill under ESBMC and a zero budget (no solver is spawned; statically decided claims still resolve) under --backend native (default: 300 (or 30 when --encoding is auto))\n  --verify-jobs <N>       Max concurrent verification jobs (ESBMC processes, or verify-worker subprocesses under --backend native)\n  --backend <esbmc|native>  Verification backend. native is the symbolic checker with Bitwuzla, run in verify-worker subprocesses (epic #1398); self-hosted vowc only, see \"Native backend\" below. Accepted by verify, contracts --verify and test --verify; contracts and test without --verify, build and the bare vowc <file> form (identical to build) reject --backend native with a usage error (exit 1) instead of silently running ESBMC or reporting not_verified as if the native backend had run. Any value other than esbmc or native is a usage error (default: esbmc)\n"));
    r.push_str(String::from("  --replay-cex            Differential test of the verifier model against runtime semantics. After the verifier reports a counterexample, build a --mode debug harness that calls the failing function with the counterexample's concrete inputs and check that the runtime VowViolation agrees (same vow_id and blame). Adds a replay field to each counterexample (see \"Counterexample replay\" below). Opt-in, off by default; also accepted by vow build.\n  --perfetto <path>       Write a gzipped Chrome Trace Event Format trace of this verification run to <path> (load directly at ui.perfetto.dev). Captures frontend phase spans and, under the ESBMC backend, per-function ESBMC proof spans, the compiler→ESBMC handoff, and time-series CPU/RSS for the compiler and each ESBMC process; under --backend native it records the frontend phase spans (module-load, parse, typecheck, lower, ...) and one verification span (no per-claim worker or solver spans, no per-worker RSS yet). Accepted only by build and verify. Pure side artifact.\n\nTEST OPTIONS\n  --verify                Run verification (ESBMC, or the native backend with --backend native) on test files\n  --backend <esbmc|native>  Verification backend; native requires --verify (see \"Native backend: contracts and test\")\n  --filter <pat>          Only run tests whose file stem contains pat (default: (none))\n  --module-root <path>    Resolve use declarations against <path>. Defaults to the scan path when it's a directory, otherwise the nearest ancestor of the entry file that resolves all of its use declarations. (default: (auto))\n  --jobs <N>              Max test files compiled and run concurrently (default: min(num_cpus/2, 8) (1 with --verify))\n  --mode <debug|release>  Build mode; debug inserts runtime vow checks (default: (default))\n  --timeout <ms>          Per-test execution timeout in milliseconds (default: 30000)\n  --max-k-step <N>        ESBMC backend only; a usage error under --backend native. ESBMC incremental BMC max iterations (with --verify)\n"));
    r.push_str(String::from("  --verify-jobs <N>       Max concurrent verification jobs (with --verify)\n\nCONTRACTS OPTIONS\n  --verify                Run verification (the ESBMC backend by default, or the native backend with --backend native) and report per-contract status\n  --no-cache              Disable verification result caching\n  --max-k-step <N>        ESBMC backend only; a usage error under --backend native. ESBMC incremental BMC max iterations (with --verify)\n  --solver <boolector|z3|bitwuzla|auto>  ESBMC backend only; a usage error under --backend native. ESBMC SMT solver (with --verify)\n  --encoding <bv|ir|auto>  ESBMC backend only; a usage error under --backend native. ESBMC encoding mode (with --verify); ir requires z3 (default: auto)\n  --verify-jobs <N>       Max concurrent verify-worker subprocesses under --backend native; a no-op under ESBMC (the ESBMC loop is serial)\n  --backend <esbmc|native>  Verification backend; native requires --verify (see \"Native backend: contracts and test\")\n  --timeout <N>           Seconds per function (and per probe) under --backend native; ESBMC's own timeout otherwise (default: 300 (native))\n\nCOMPLEXITY OPTIONS\n  --cog-anchor <N>        Cognitive-complexity value mapped to sub-score 0.800 (SonarQube's default flag line). (default: 15)\n  --nloc-anchor <N>       NLOC value mapped to sub-score 0.800 (~50–60 line guidance). (default: 60)\n  --max-score <N>         CI gate: exit nonzero if any function's complexity_score exceeds N. The recommended line is 80, but gating is opt-in only. (default: (unset))\n  --max-cognitive <N>     CI gate: exit nonzero if any function's cognitive exceeds N. (default: (unset))\n  --max-cyclomatic <N>    CI gate: exit nonzero if any function's cyclomatic exceeds N. (default: (unset))\n\nDECL OPTIONS\n  -o, --output <path>     Output declaration file path (default: <source>.vow.d)\n\nGLOBAL OPTIONS\n  --help                Emit versioned JSON tool-help data\n  --help --human        Emit legacy text help\n\nOUTPUT (JSON on stdout)\n"));
    r.push_str(String::from("  status      : Verified | Unverified | Skipped | CompileFailed | VerifyFailed\n  executable  : path to compiled binary, or null\n  diagnostics : array of {error_code, message, severity, span: {file, offset, length}}\n  message     : error detail (CompileFailed)\n  function    : function name (VerifyFailed)\n  counterexample: verifier counterexample (VerifyFailed)\n\nEXIT CODES\n  0  success (Verified or Unverified)\n  1  failure (CompileFailed, VerifyFailed, or Skipped)\n\nLANGUAGE SUMMARY\n  module Hello\n  use math.utils\n\n  struct Point { x: i64, y: i64 }\n\n  fn add(x: i64, y: i64) -> i64 {\n    x + y\n  }\n\n  fn divide(x: i64, y: i64) -> i64 vow {\n    requires: y != 0\n    ensures:  result * y == x\n  } {\n    x / y\n  }\n\n  fn main() -> i32 [io] {\n    let v: Vec<i64> = Vec::new();\n    v.push(divide(10, 2));\n    print_i64(v[0]);\n    0\n  }\n\nTYPES     : i8  i16  i32  i64  i128  u8  u16  u32  u64  u128  f32  f64  bool  ()  !  Vec<T>  Option<T>  Result<T, E>  String  HashMap<K, V>  BTreeMap<K, V>\nEFFECTS   : io  read  write  panic  unsafe\nBUILTINS  : pin_to_root: fn(value: String) -> String and fn<T>(value: Vec<T>) -> Vec<T> for one-slot scalar T []   drop: fn(value: L) -> () for a linear owner L []   print_str: fn(s: String) -> () [io]\n"));
    r.push_str(String::from("            print_i64: fn(v: i64) -> () [io]   print_u64: fn(v: u64) -> () [io]   eprintln_str: fn(s: String) -> () [io]   try_eprintln_str: fn(s: String) -> i64 [io]   debug_str: fn(s: String) -> () []   debug_i64: fn(v: i64) -> () []   debug_u64: fn(v: u64) -> () []   fs_read: fn(path: String) -> String [read]   fs_open: fn(path: String) -> i64 [read]   fs_read_line: fn(handle: i64) -> String [read]   fs_status: fn(handle: i64) -> i64 [read]   fs_read_status: fn() -> i64 [read]   getenv: fn(name: String) -> String [read]   path_lookup: fn(name: String) -> String [read]   mktemp_dir: fn(prefix: String) -> String [io]   fs_close: fn(handle: i64) -> i64 [read]   fs_write: fn(path: String, data: String) -> i64 [write]   fs_exists: fn(path: String) -> i64 [read]   fs_mkdir: fn(path: String) -> i64 [io]   fs_listdir: fn(path: String) -> Vec<String> [read]   fs_remove: fn(path: String) -> i64 [io]   fs_remove_dir: fn(path: String) -> i64 [io]   fs_remove_dir_all: fn(path: String) -> i64 [io]   fs_is_dir: fn(path: String) -> i64 [read]   fs_is_symlink: fn(path: String) -> i64 [read]   fs_rename: fn(old: String, new: String) -> i64 [io]   string_substr: fn(s: String, start: u64, len: u64) -> String []   string_split: fn(s: String, delim: String) -> Vec<String> []   string_starts_with: fn(s: String, prefix: String) -> i64 []   string_ends_with: fn(s: String, suffix: String) -> i64 []   string_matches_literal_at: fn(s: String, pos: u64, literal: String literal) -> i64 []   string_trim: fn(s: String) -> String []   string_to_upper: fn(s: String) -> String []   string_to_lower: fn(s: String) -> String []   string_replace: fn(s: String, from: String, to: String) -> String []   string_join: fn(parts: Vec<String>, sep: String) -> String []   int_to_string: fn(v: i64) -> String []   uint_to_string: fn(v: u64) -> String []   i64_to_string: fn(v: i64) -> String (alias of int_to_string) []   int128_to_string: fn(v: i128) -> String []   uint128_to_string: fn(v: u128) -> String []   parse_i8: fn(s: String) -> Option<i8> []   parse_i16: fn(s: String) -> Option<i16> []   parse_i32: fn(s: String) -> Option<i32> []   parse_i64: fn(s: String) -> Option<i64> []   parse_i128: fn(s: String) -> Option<i128> []   parse_u8: fn(s: String) -> Option<u8> []   parse_u16: fn(s: String) -> Option<u16> []   parse_u32: fn(s: String) -> Option<u32> []   parse_u128: fn(s: String) -> Option<u128> []   parse_f64_bits: fn(s: String) -> u64 []   format_f64_bits: fn(bits: u64) -> String []   vec_sort: fn(v: Vec<i64>) -> Vec<i64> []   time_unix: fn() -> i64 [io]   time_unix_ms: fn() -> i64 [io]   time_micros: fn() -> i64 [io]   num_cpus: fn() -> i64 [io]   proc_sample: fn() -> String [io]   gzip_write_file: fn(path: String, data: String) -> i64 [io]   memory_root_arena_bytes: fn() -> u64 [io]   memory_peak_bytes: fn() -> u64 [io]   memory_alloc_count_since_start: fn() -> u64 [io]   hex_encode: fn(data: Vec<u8>) -> String []   hex_decode: fn(s: String) -> Vec<u8> []   hash_u64: fn(x: u64) -> u64 []   hash_str: fn(s: String) -> u64 []   args: fn() -> Vec<String> [read]   stdin_read: fn() -> String [read]   stdin_read_line: fn() -> String [read]   stdin_ready: fn() -> bool [read]   process_exit: fn(code: i64) -> ! [io]   process_run: fn(cmd: String, args: Vec<String>) -> i64 [io]   process_get_stdout: fn() -> String [io]   process_get_stderr: fn() -> String [io]   process_start: fn(cmd: String, args: Vec<String>) -> i64 [io]   process_start_capped: fn(cmd: String, args: Vec<String>, mem_kb: i64) -> i64 [io]   process_wait: fn(pid: i64) -> i64 [io]   process_wait_timeout: fn(pid: i64, timeout_ms: i64) -> i64 [io]   process_poll_wait: fn(pid: i64, timeout_ms: i64) -> i64 [io]   process_kill: fn(pid: i64) -> i64 [io]   process_stdout_for: fn(pid: i64) -> String [io]   process_stderr_for: fn(pid: i64) -> String [io]   process_start_piped: fn(cmd: String, args: Vec<String>) -> i64 [io]   process_write_stdin: fn(pid: i64, data: String) -> i64 [io]   process_close_stdin: fn(pid: i64) -> i64 [io]   process_read_line: fn(pid: i64, timeout_ms: i64) -> String [io]   process_read_status: fn(pid: i64) -> i64 [io]\n"));
    r.push_str(String::from("METHODS   : Vec: Vec::new/Vec::from_raw_parts_copy/push/pop/len/clear/truncate/v[i]/v[i] = val   String: String::from/String::new/String::from_raw_parts_copy/len/byte_at/push_byte/push_str/clear/contains/eq/substring/parse_i64/parse_u64\n            HashMap: HashMap::new/insert/get/contains_key/remove/len   BTreeMap: BTreeMap::new/insert/get/contains/len   Option: unwrap\nOPERATORS : + - * / %   +! -! *! /! %! (checked)   == != < <= > >=   && || !   & | ^ << >> (bitwise, integer-only)   unary - ! ?\n\nVERIFICATION DEFAULTS\n  ESBMC backend (default) : incremental-bmc (incremental BMC up to --max-k-step; forward-condition completeness, no k-induction step)\n  Incremental BMC         : 50 max iterations (--max-k-step)\n  Native backend          : bounded unwinding with invariant induction and k-induction (--backend native; no bound flag, --timeout is the only knob)\n"));
    r
}
