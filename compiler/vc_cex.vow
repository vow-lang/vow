module VcCex

use ir
use vc_ops
use verifier
use vc_solver
use vc_exec
use vc_agg
use vc_int
use vc_fmt
use vc_vecmodel
use vc_fieldrows
use vc_readrows
use vc_reads
use vc_heap

// Maps a solver answer for one claim onto the `VerifyResult` the shared
// counterexample reporting (`build_ce_from_result`) already consumes.
// Abort claims have no vow id (-1, reported as the unattributed sentinel); their
// `raw_output` carries the "Violated property:" label so the description comes
// from `parse_assert_label`.

// Name of model entry `j` in a counterexample: the source name of a scalar
// parameter, `<param>.<slot>` for a field of an aggregate one (`.0` is an enum's
// tag), with `:bool` or `:<bits>` after it when the function reads that slot at
// more than one sort. The IR carries no field names, so the slot stands in.
fn vc_model_symbol_name(f: IrFunction, cs: VcClaims, j: u64) -> String {
    let base: String = vc_source_param_name(f, cs.model_params[j]);
    if cs.model_slots[j] == VC_ALIAS_SLOT() {
        let alias: String = String::from(base);
        alias.push_str(String::from(".alias"));
        return alias;
    }
    if cs.model_slots[j] == VC_SLOT_VEC_LEN() {
        let named: String = String::from(base);
        named.push_str(cs.model_paths[j]);
        named.push_str(String::from(".len"));
        return named;
    }
    if cs.model_slots[j] == VC_SLOT_ADDR() {
        let named: String = String::from(base);
        named.push_str(String::from(".addr"));
        return named;
    }
    if cs.model_slots[j] < 0 {
        return base;
    }
    let out: String = String::from(base);
    out.push_str(cs.model_paths[j]);
    out.push_str(String::from("."));
    out.push_str(i64_to_string(cs.model_slots[j]));
    if cs.model_ambig[j] != 0 {
        out.push_str(String::from(":"));
        out.push_str(vc_sort_suffix(cs.model_widths[j]));
    }
    out
}

// Index among the first `n` model entries of the identity of aggregate parameter
// `p` (`<p>.alias`), or -1.
fn vc_alias_entry(cs: VcClaims, n: u64, p: i64) -> i64 {
    let mut e: u64 = 0;
    while e < n {
        if cs.model_slots[e] == VC_ALIAS_SLOT() && cs.model_params[e] == p { return e as i64; }
        e = e + 1;
    }
    -1
}

// The entry whose value model entry `j` has in the counterexample. A field of an
// aggregate parameter that is the same object as an earlier one (equal
// identities) reads that parameter's field, so its own symbol, which the formula
// ignores then, must not show a value of its own: the first such parameter's
// entry for the same slot and width, else `j`. Only the first `n` entries of
// `vals` are model entries; an enriched answer carries `Vec` elements behind them.
fn vc_alias_value_source(cs: VcClaims, vals: Vec<i64>, n: u64, j: u64) -> u64 {
    if cs.model_slots[j] < 0 || cs.model_paths[j].len() > 0 { return j; }
    let me: i64 = vc_alias_entry(cs, n, cs.model_params[j]);
    if me < 0 { return j; }
    let mut best: u64 = j;
    let mut i: u64 = 0;
    while i < n {
        let q: i64 = cs.model_params[i];
        if cs.model_slots[i] == cs.model_slots[j] && cs.model_paths[i].len() == 0 && cs.model_widths[i] == cs.model_widths[j] && q < cs.model_params[best] {
            let qe: i64 = vc_alias_entry(cs, n, q);
            if qe >= 0 && vals[qe as u64] == vals[me as u64] { best = i; }
        }
        i = i + 1;
    }
    best
}

// The entry a map parameter's asked key makes in a counterexample: the key, presence and value
// entries `j`, `j + 1` and `j + 2` become `<param>[<key>]`, the value slot when the key is in the
// parameter's own state and `absent` when it is not. Both print as the raw unsigned 64-bit slot,
// which the driver retypes from the declared key and value types (`vc_cex_elem`). A key asked
// twice, or two keys with one value, lists once.
fn vc_append_map_entry(f: IrFunction, cs: VcClaims, ans: VcSolverAnswer, j: u64, names: Vec<String>, values: Vec<String>) {
    if j + 2 >= ans.values.len() { return; }
    let name: String = String::from(vc_source_param_name(f, cs.model_params[j]));
    name.push_str(String::from("["));
    name.push_str(uint_to_string(ans.values[j] as u64));
    name.push_str(String::from("]"));
    let mut i: u64 = 0;
    while i < names.len() {
        if names[i] == name { return; }
        i = i + 1;
    }
    names.push(name);
    if ans.values[j + 1] == 0 {
        values.push(String::from("absent"));
    } else {
        values.push(uint_to_string(ans.values[j + 2] as u64));
    }
}

fn vc_violated_property_text(label: String) -> String {
    let out: String = String::from("Violated property:\n  ");
    out.push_str(label);
    out.push_str(String::from("\n"));
    out
}

fn vc_verify_result(status: i64, vow_id: i64, names: Vec<String>, values: Vec<String>, raw: String) -> VerifyResult {
    VerifyResult {
        status: status,
        vow_id: vow_id,
        callee_precondition_func_id: -1,
        callee_precondition_vow_id: -1,
        callee_postcondition_func_id: -1,
        callee_postcondition_vow_id: -1,
        var_names: names,
        var_values: values,
        block_visits: Vec::new(),
        raw_output: raw,
    }
}

fn vc_proven_result() -> VerifyResult {
    vc_verify_result(VERIFY_PROVEN(), -1, Vec::new(), Vec::new(), String::from(""))
}

// True when another element row of the same array and slot reads it at another sort: the entry
// names then carry the sort, as a field of a parameter read at two sorts does.
fn vc_field_row_ambiguous(ls: VcHeapListed, r: i64) -> bool {
    let mut o: u64 = 0;
    while o < ls.earr.len() {
        if o as i64 != r && ls.earr[o] == ls.earr[r as u64] && ls.eslot[o] == ls.eslot[r as u64] && vc_ty_sort(ls.ety[o]) != vc_ty_sort(ls.ety[r as u64]) { return true; }
        o = o + 1;
    }
    false
}

// Appends `<param>[<i>].<slot>` for the fields of the elements below each `Vec` parameter's length
// that the answer carries behind the elements (`vc_append_field_rows`: for each row of
// `vc_field_rows`, the same number of values per parameter of `vc_cex_vecs`).
fn vc_append_field_answer(f: IrFunction, cs: VcClaims, k: u64, ans: VcSolverAnswer, names: Vec<String>, values: Vec<String>) {
    let n: u64 = vc_answer_regular_count(cs, k, ans);
    let rows: Vec<i64> = vc_field_rows(cs, k);
    if vc_answer_body(cs, k, ans) <= n || rows.len() == 0 { return; }
    let vecs: Vec<i64> = vc_cex_vecs(cs, k);
    let per: u64 = vc_answer_elems_per_vec(cs, k, ans);
    let ls: VcHeapListed = cs.listed;
    let mut q: u64 = 0;
    while q < rows.len() {
        let r: u64 = rows[q] as u64;
        let mut p: u64 = 0;
        while p < vecs.len() {
            if cs.vec_arr[vecs[p] as u64] == ls.earr[r] && vc_cex_vec_path(cs, vecs[p]).len() == 0 {
                let len: i64 = vc_answer_vec_len(cs, ans, n, vecs[p]);
                let base: String = vc_source_param_name(f, cs.vec_param[vecs[p] as u64]);
                let mut i: i64 = 0;
                while i < len && len as u64 <= per {
                    let at: u64 = n + (vecs.len() + q) * per + i as u64;
                    if at < ans.values.len() {
                        let key: String = String::from(base);
                        key.push_str(String::from("["));
                        key.push_str(i64_to_string(i));
                        key.push_str(String::from("]."));
                        key.push_str(i64_to_string(ls.eslot[r]));
                        if vc_field_row_ambiguous(ls, r as i64) {
                            key.push_str(String::from(":"));
                            key.push_str(vc_sort_suffix(vc_ty_sort(ls.ety[r])));
                        }
                        names.push(key);
                        values.push(vc_format_value(ls.ety[r], ans.values[at], ans.highs[at]));
                    }
                    i = i + 1;
                }
            }
            p = p + 1;
        }
        q = q + 1;
    }
}

// Appends the handle reads of the claim (`vc_reads`) as the entries the driver compares the listed
// addresses with (`vc_cex_verdict`), which strips them: `$read.n` their number and `$read.<i>` the
// class and address of each. No `$read.n` says the reads are unknown (the registry was dropped, or
// the answer carries no projection of them).
fn vc_append_read_answer(cs: VcClaims, k: u64, ans: VcSolverAnswer, names: Vec<String>, values: Vec<String>) {
    let ls: VcHeapListed = cs.listed;
    if ls.rd_over || !ls.rd_ok { return; }
    let rows: Vec<i64> = vc_read_rows(cs, k);
    let body: u64 = vc_answer_body(cs, k, ans);
    if rows.len() > 0 && ans.values.len() < body + rows.len() { return; }
    names.push(String::from("$read.n"));
    values.push(i64_to_string(rows.len() as i64));
    let mut q: u64 = 0;
    while q < rows.len() {
        let key: String = String::from("$read.");
        key.push_str(i64_to_string(q as i64));
        names.push(key);
        let text: String = String::from(vc_reads_class_name(ls.rd_cls[rows[q] as u64]));
        text.push_str(String::from(":"));
        text.push_str(i64_to_string(ans.values[body + q]));
        values.push(text);
        q = q + 1;
    }
}

// Result for claim `k` of `cs` given the solver's answer for it. `sat` is a
// counterexample; `unsat` is not handled here (the caller moves on).
fn vc_claim_result(f: IrFunction, cs: VcClaims, k: u64, ans: VcSolverAnswer) -> VerifyResult {
    if ans.verdict == VC_ANS_SAT() {
        let names: Vec<String> = Vec::new();
        let values: Vec<String> = Vec::new();
        let n: u64 = vc_answer_regular_count(cs, k, ans);
        let mut j: u64 = 0;
        while j < n {
            if cs.model_slots[j] == VC_SLOT_MAP_KEY() {
                vc_append_map_entry(f, cs, ans, j, names, values);
            } else if cs.model_slots[j] != VC_SLOT_MAP_PRES() && cs.model_slots[j] != VC_SLOT_MAP_VAL() {
                names.push(vc_model_symbol_name(f, cs, j));
                let src: u64 = vc_alias_value_source(cs, ans.values, n, j);
                values.push(vc_format_value(cs.model_tys[j], ans.values[src], ans.highs[src]));
            }
            j = j + 1;
        }
        vc_append_vec_answer_contents(f, cs, k, ans, names, values);
        vc_append_field_answer(f, cs, k, ans, names, values);
        vc_append_read_answer(cs, k, ans, names, values);
        let kind: i64 = cs.kinds[k];
        let mut raw: String = String::from("");
        if kind != VC_CLAIM_ENSURES() && kind != VC_CLAIM_CALLER_PRE() && kind != VC_CLAIM_CALLEE_POST() {
            raw = vc_violated_property_text(cs.labels[k]);
        }
        let vr: VerifyResult = vc_verify_result(VERIFY_FAILED(), cs.vow_ids[k], names, values, raw);
        let owner: i64 = vc_frame_func(cs.fr, cs.frames[k], f.id);
        if kind == VC_CLAIM_CALLER_PRE() {
            vr.callee_precondition_func_id = owner;
            vr.callee_precondition_vow_id = cs.vow_ids[k];
        } else if kind == VC_CLAIM_CALLEE_POST() {
            vr.callee_postcondition_func_id = owner;
            vr.callee_postcondition_vow_id = cs.vow_ids[k];
        }
        return vr;
    }
    if ans.verdict == VC_ANS_UNKNOWN() {
        return vc_verify_result(VERIFY_UNKNOWN(), -1, Vec::new(), Vec::new(), ans.raw);
    }
    if ans.verdict == VC_ANS_MEMORY() {
        return vc_verify_result(VERIFY_UNKNOWN(), -1, Vec::new(), Vec::new(), memory_limit_reason());
    }
    if ans.verdict == VC_ANS_TIMEOUT() {
        return vc_verify_result(VERIFY_TIMEOUT(), -1, Vec::new(), Vec::new(), ans.raw);
    }
    if ans.verdict == VC_ANS_NOT_FOUND() {
        return vc_verify_result(VERIFY_NOT_FOUND(), -1, Vec::new(), Vec::new(), ans.raw);
    }
    vc_verify_result(VERIFY_ERROR(), -1, Vec::new(), Vec::new(), ans.raw)
}

// A counterexample depends on the value `parse_f64_bits` or a `parse_*` returns, or the
// text `format_f64_bits`, `string_trim`, `string_to_upper` or `string_to_lower` returns,
// which the model leaves unconstrained: it may not be a run, so the claim is neither
// proven nor refuted.
fn vc_opaque_hook_label() -> String { String::from("opaque builtin result") }

fn vc_opaque_hook_reason() -> String {
    let out: String = vc_opaque_hook_label();
    out.push_str(String::from(": the counterexample depends on the result of parse_f64_bits, format_f64_bits, a parse_* builtin, string_trim, string_to_upper, string_to_lower, string_replace, string_split or string_join, which the native verifier models only as a total function of its operands"));
    out
}

// The unwinding assertion could not be discharged at the largest bound: some
// run may need more iterations than the verifier unrolls, so nothing is proven.
// The text travels in `raw_output` through the worker wire format.
fn vc_unwinding_reason(bound: i64) -> String {
    let out: String = VC_LABEL_UNWIND();
    out.push_str(String::from(": a loop may run more than "));
    out.push_str(i64_to_string(bound));
    out.push_str(String::from(" iterations (internal unrolling bound reached)"));
    out
}

fn vc_unwinding_budget_reason(bound: i64) -> String {
    let out: String = VC_LABEL_UNWIND();
    out.push_str(String::from(": unrolling the loops to "));
    out.push_str(i64_to_string(bound));
    out.push_str(String::from(" iterations exceeds the verifier's size budget"));
    out
}

// The call tree of a function is too large to inline within the budget: nothing
// was proven, and nothing is claimed either.
fn vc_inline_budget_label() -> String { String::from("inlining budget") }

fn vc_inline_budget_reason(cap: i64) -> String {
    let out: String = vc_inline_budget_label();
    out.push_str(String::from(": inlining the calls exceeds the verifier's size budget of "));
    out.push_str(i64_to_string(cap));
    out.push_str(String::from(" instructions"));
    out
}

// A counterexample depends on the key set or length of a map the function did not
// build (a parameter, or a map a loop cut forgot): the model keeps the two apart,
// where a real map's length is its number of keys, so it may not be a run.
fn vc_map_state_label() -> String { String::from("unconstrained map state") }

fn vc_map_state_reason() -> String {
    let out: String = vc_map_state_label();
    out.push_str(String::from(": the counterexample depends on the keys or the length of a HashMap or BTreeMap the function did not build, which the native verifier does not relate"));
    out
}

// A counterexample was found in a function whose call tree is decided with a summary standing
// for a proven callee (`vc_summary`): the summary admits states and results the callee cannot
// produce, so the counterexample may not be a run and nothing is claimed.
fn vc_summary_label() -> String { String::from("callee summary") }

fn vc_summary_reason() -> String {
    let out: String = vc_summary_label();
    out.push_str(String::from(": a counterexample found with a proven callee summarised by its contract, not by its body, which the verifier cannot tell from a run"));
    out
}

fn vc_output_has_summary(raw: String) -> bool {
    str_find_str(raw, vc_summary_label()) >= 0
}

fn vc_output_has_unwinding(raw: String) -> bool {
    str_find_str(raw, VC_LABEL_UNWIND()) >= 0
}

fn vc_output_has_opaque_hook(raw: String) -> bool {
    str_find_str(raw, vc_opaque_hook_label()) >= 0
}

fn vc_output_has_map_state(raw: String) -> bool {
    str_find_str(raw, vc_map_state_label()) >= 0
}

fn vc_output_has_inline_budget(raw: String) -> bool {
    str_find_str(raw, vc_inline_budget_label()) >= 0
}

fn vc_plain_result(status: i64, raw: String) -> VerifyResult {
    vc_verify_result(status, -1, Vec::new(), Vec::new(), raw)
}
