module VcAgg

use ir
use vc_term
use vc_smt
use vc_flow

// Scalarised model of the heap aggregates (structs, enums, `Option`, `Result`)
// the native verifier reads. A pointer value is an object, and an object is a
// set of scalar field terms; no pointer is ever an SMT term, so field access,
// construction and `match` reduce to the i64/Bool terms the executor already
// handles.
//
// Three kinds of object exist. An allocation (`RegionAlloc`) starts with no
// field values and is written by `FieldSet`; a parameter's fields are
// per-parameter symbols; a pointer Phi is the `ite` over its incoming objects.
// A field nothing wrote is a fresh unconstrained constant, never 0: it is what
// the other arm of a `Some`/`None` merge would leave in the payload slot. Slots
// are read lazily, so a parameter needs no layout. A slot is keyed by index and
// sort (Bool or a bit-vector width), because one enum slot can hold an i64
// payload in one variant and a Bool in another. A 128-bit value is one term of
// sort 128 that occupies slots `idx` and `idx + 1`.
//
// A write at path condition `pc` stores `ite(pc, new, old)`. This is exact
// because the executor walks the blocks of an acyclic function once, in
// topological order, and `pc` is the condition for execution to reach the
// writing block. A read walked before a write cannot execute after it, and two
// blocks that do not reach each other never both run, so the chain of writes in
// walk order is the object's state on whichever path is taken. A write whose
// path condition is the one the object was created under, or `true`, has no
// observable old value and replaces the slot. The gate
// (`vc_agg_shape_detail`) allows a `FieldSet` only on an allocation, a
// parameter or a merge of them; mutation of anything else is `Skipped`, never
// guessed at.
//
// A write through a pointer Phi reaches each object the merge may stand for,
// under the condition of the edge that supplies it. Parameters may be one object:
// when the function writes through a parameter and several parameters are
// aggregates (`vc_agg_alias_params`), each such parameter carries a free
// identity (an 8-bit bit-vector, `alias` in a counterexample) and two are the
// same object exactly when their identities are equal, so the relation is an
// equivalence by construction. A parameter's initial slot is then the initial
// symbol of the first parameter with its identity, and a write to one parameter
// is also applied, under the identity test, to every other.

fn VC_OBJ_ALLOC() -> i64 { 0 }
fn VC_OBJ_PARAM() -> i64 { 1 }
fn VC_OBJ_PHI() -> i64 { 2 }

// Slot number of a parameter's identity in the parameter-symbol tables.
fn VC_ALIAS_SLOT() -> i64 { -2 }

struct VcAgg {
    fl: VcFlow,
    kinds: Vec<i64>,
    owners: Vec<i64>,
    phis: Vec<i64>,
    heads: Vec<i64>,
    sl_next: Vec<i64>,
    sl_idx: Vec<i64>,
    sl_sort: Vec<i64>,
    sl_term: Vec<i64>,
    sl_epoch: Vec<i64>,
    births: Vec<i64>,
    epoch: i64,
    ps_param: Vec<i64>,
    ps_slot: Vec<i64>,
    ps_sort: Vec<i64>,
    ps_ty: Vec<i64>,
    ps_hdr: Vec<i64>,
    al_params: Vec<i64>,
    al_ids: Vec<i64>,
    junk: i64,
}

// `fl` is the control-flow state of the walk: a Phi object reads its incoming
// objects from the edges and Upsilons recorded there.
fn vc_agg_new(fl: VcFlow) -> VcAgg {
    VcAgg {
        fl: fl,
        kinds: Vec::new(),
        owners: Vec::new(),
        phis: Vec::new(),
        heads: Vec::new(),
        sl_next: Vec::new(),
        sl_idx: Vec::new(),
        sl_sort: Vec::new(),
        sl_term: Vec::new(),
        sl_epoch: Vec::new(),
        births: Vec::new(),
        epoch: 0,
        ps_param: Vec::new(),
        ps_slot: Vec::new(),
        ps_sort: Vec::new(),
        ps_ty: Vec::new(),
        ps_hdr: Vec::new(),
        al_params: Vec::new(),
        al_ids: Vec::new(),
        junk: 0,
    }
}

// `owner` is the parameter index of a parameter object and the block of a Phi
// object (whose Phi is `phi`); -1 otherwise. `births` is the path condition an
// allocation was created under; -1 for every other kind.
fn vc_agg_push_obj(ag: VcAgg, kind: i64, owner: i64, phi: i64) -> i64 {
    let id: i64 = ag.kinds.len() as i64;
    ag.kinds.push(kind);
    ag.owners.push(owner);
    ag.phis.push(phi);
    ag.heads.push(-1);
    ag.births.push(-1);
    id
}

// `pc` is the path condition of the block that allocates the object.
fn vc_agg_alloc(ag: VcAgg, pc: i64) -> i64 {
    let obj: i64 = vc_agg_push_obj(ag, VC_OBJ_ALLOC(), -1, -1);
    ag.births[obj as u64] = pc;
    obj
}

// One object per parameter index, so a parameter's field symbols are declared once.
fn vc_agg_param(ag: VcAgg, k: i64) -> i64 {
    let mut o: u64 = 0;
    while o < ag.kinds.len() {
        if ag.kinds[o] == VC_OBJ_PARAM() && ag.owners[o] == k {
            return o as i64;
        }
        o = o + 1;
    }
    vc_agg_push_obj(ag, VC_OBJ_PARAM(), k, -1)
}

fn vc_agg_find(ag: VcAgg, obj: i64, idx: i64, sort: i64) -> i64 {
    let mut s: i64 = ag.heads[obj as u64];
    while s >= 0 {
        if ag.sl_idx[s as u64] == idx && ag.sl_sort[s as u64] == sort {
            return s;
        }
        s = ag.sl_next[s as u64];
    }
    -1
}

fn vc_agg_store(ag: VcAgg, obj: i64, idx: i64, sort: i64, term: i64) {
    let s: i64 = vc_agg_find(ag, obj, idx, sort);
    if s >= 0 {
        ag.sl_term[s as u64] = term;
        ag.sl_epoch[s as u64] = ag.epoch;
        return;
    }
    let id: i64 = ag.sl_idx.len() as i64;
    ag.sl_next.push(ag.heads[obj as u64]);
    ag.sl_idx.push(idx);
    ag.sl_sort.push(sort);
    ag.sl_term.push(term);
    ag.sl_epoch.push(ag.epoch);
    ag.heads[obj as u64] = id;
}

// A 128-bit value takes two 8-byte slots, every other sort one.
fn vc_agg_slot_width(sort: i64) -> i64 {
    if sort == 128 { return 2; }
    1
}

fn vc_agg_overlaps(ag: VcAgg, s: i64, idx: i64, end: i64) -> bool {
    let si: i64 = ag.sl_idx[s as u64];
    si < end && idx < si + vc_agg_slot_width(ag.sl_sort[s as u64])
}

// Unconditional write: `term` goes into slot `idx` at `sort`; every view of a
// slot the write covers reads as unconstrained, then the exact view takes `term`.
fn vc_agg_set(ag: VcAgg, obj: i64, idx: i64, sort: i64, term: i64) {
    ag.epoch = ag.epoch + 1;
    let end: i64 = idx + vc_agg_slot_width(sort);
    let mut s: i64 = ag.heads[obj as u64];
    while s >= 0 {
        if vc_agg_overlaps(ag, s, idx, end) {
            ag.sl_term[s as u64] = -1;
        }
        s = ag.sl_next[s as u64];
    }
    vc_agg_store(ag, obj, idx, sort, term);
}

// Writes `term` into slot `idx` of `obj` when the block runs under `pc`. A write
// through a Phi reaches every object the merge may stand for, and one through an
// aliasable parameter every parameter that may be the same object.
fn vc_agg_write(ag: VcAgg, ar: VcArena, hdr: SmtScript, obj: i64, idx: i64, sort: i64, term: i64, pc: i64) {
    let kind: i64 = ag.kinds[obj as u64];
    if kind == VC_OBJ_PHI() {
        vc_agg_write_phi(ag, ar, hdr, obj, idx, sort, term, pc);
    } else if kind == VC_OBJ_PARAM() && vc_agg_alias_pos(ag, ag.owners[obj as u64]) >= 0 {
        vc_agg_write_aliased(ag, ar, hdr, vc_agg_alias_pos(ag, ag.owners[obj as u64]), idx, sort, term, pc);
    } else {
        vc_agg_write_one(ag, ar, hdr, obj, idx, sort, term, pc);
    }
}

// The write to each object a Phi merges, under `pc` and the condition of the edge
// that supplies the object.
fn vc_agg_write_phi(ag: VcAgg, ar: VcArena, hdr: SmtScript, obj: i64, idx: i64, sort: i64, term: i64, pc: i64) {
    let fl: VcFlow = ag.fl;
    let phi: i64 = ag.phis[obj as u64];
    let mut e: i64 = fl.in_head[ag.owners[obj as u64] as u64];
    while e >= 0 {
        let child: i64 = vc_flow_upsilon_from(fl, phi, fl.e_src[e as u64]);
        vc_agg_write(ag, ar, hdr, child, idx, sort, term, vc_flow_and(fl, ar, hdr, pc, fl.e_cond[e as u64]));
        e = fl.e_next[e as u64];
    }
}

// The write to the aliasable parameter at position `pos`, and to each other one
// when the two identities are equal.
fn vc_agg_write_aliased(ag: VcAgg, ar: VcArena, hdr: SmtScript, pos: i64, idx: i64, sort: i64, term: i64, pc: i64) {
    let mut i: i64 = 0;
    while i < ag.al_params.len() as i64 {
        let o: i64 = vc_agg_param(ag, ag.al_params[i as u64]);
        let at: i64 = { if i == pos { pc } else { vc_flow_and(ag.fl, ar, hdr, pc, vc_agg_same_object(ag, ar, hdr, pos, i)) } };
        vc_agg_write_one(ag, ar, hdr, o, idx, sort, term, at);
        i = i + 1;
    }
}

// Writes `term` into slot `idx` of the allocation or parameter `obj` when the
// block runs under `pc`. A write that always runs once the object exists replaces
// the slot; any other keeps the old value on the paths that skip it, and every
// other view the write covers becomes unconstrained on the paths that take it.
fn vc_agg_write_one(ag: VcAgg, ar: VcArena, hdr: SmtScript, obj: i64, idx: i64, sort: i64, term: i64, pc: i64) {
    if vc_tm_is_true(ar, pc) || pc == ag.births[obj as u64] {
        vc_agg_set(ag, obj, idx, sort, term);
        return;
    }
    let old: i64 = vc_agg_get(ag, ar, hdr, obj, idx, sort);
    let end: i64 = idx + vc_agg_slot_width(sort);
    let mut s: i64 = ag.heads[obj as u64];
    while s >= 0 {
        let view: i64 = ag.sl_term[s as u64];
        if view >= 0 && vc_agg_overlaps(ag, s, idx, end) && !(ag.sl_idx[s as u64] == idx && ag.sl_sort[s as u64] == sort) {
            let junk: i64 = vc_agg_junk(ag, ar, hdr, ag.sl_sort[s as u64]);
            ag.sl_term[s as u64] = vc_tm_app3(ar, VC_OP_ITE(), pc, junk, view);
        }
        s = ag.sl_next[s as u64];
    }
    ag.epoch = ag.epoch + 1;
    vc_agg_store(ag, obj, idx, sort, vc_tm_app3(ar, VC_OP_ITE(), pc, term, old));
}

fn vc_agg_declare(ar: VcArena, hdr: SmtScript, name: String, sort: i64) -> i64 {
    vc_script_declare_const(hdr, name, sort);
    vc_tm_var(ar, name)
}

fn vc_agg_junk(ag: VcAgg, ar: VcArena, hdr: SmtScript, sort: i64) -> i64 {
    let name: String = String::from("j");
    name.push_str(i64_to_string(ag.junk));
    ag.junk = ag.junk + 1;
    vc_agg_declare(ar, hdr, name, sort)
}

// Name of the symbol for slot `idx` of parameter `k` read at `sort`.
fn vc_agg_symbol_name(k: i64, idx: i64, sort: i64) -> String {
    let name: String = String::from("p");
    name.push_str(i64_to_string(k));
    if idx == VC_ALIAS_SLOT() {
        name.push_str(String::from("alias"));
        return name;
    }
    name.push_str(String::from("f"));
    name.push_str(i64_to_string(idx));
    name.push_str(String::from("s"));
    name.push_str(i64_to_string(sort));
    name
}

// Declares the symbol of slot `idx` of parameter `k` at `sort` and records it
// (`ps_*`, in declaration order) so a counterexample can read it back: `ps_hdr`
// is its position in the header, `ps_ty` is filled in by the caller that knows
// the IR type of the read.
fn vc_agg_param_symbol(ag: VcAgg, ar: VcArena, hdr: SmtScript, k: i64, idx: i64, sort: i64) -> i64 {
    ag.ps_param.push(k);
    ag.ps_slot.push(idx);
    ag.ps_sort.push(sort);
    ag.ps_ty.push(-1);
    ag.ps_hdr.push(hdr.kinds.len() as i64);
    vc_agg_declare(ar, hdr, vc_agg_symbol_name(k, idx, sort), sort)
}

// Declares the identity of each parameter in `params` (ascending indices of the
// parameters that may be one object), when there is more than one. 8 bits tell
// up to 256 parameters apart, 64 any more.
fn vc_agg_enable_alias(ag: VcAgg, ar: VcArena, hdr: SmtScript, params: Vec<i64>) {
    if params.len() < 2 { return; }
    let sort: i64 = { if params.len() <= 256 { 8 } else { 64 } };
    let ty: i64 = { if sort == 8 { ITY_U8() } else { ITY_U64() } };
    let mut i: u64 = 0;
    while i < params.len() {
        ag.al_ids.push(vc_agg_param_symbol(ag, ar, hdr, params[i], VC_ALIAS_SLOT(), sort));
        ag.ps_ty[ag.ps_ty.len() - 1] = ty;
        ag.al_params.push(params[i]);
        i = i + 1;
    }
}

// Position of parameter `k` among the aliasable ones, or -1.
fn vc_agg_alias_pos(ag: VcAgg, k: i64) -> i64 {
    let mut i: u64 = 0;
    while i < ag.al_params.len() {
        if ag.al_params[i] == k { return i as i64; }
        i = i + 1;
    }
    -1
}

// The Bool term "the aliasable parameters at positions `i` and `j` are one object".
fn vc_agg_same_object(ag: VcAgg, ar: VcArena, hdr: SmtScript, i: i64, j: i64) -> i64 {
    vc_flow_name(ag.fl, ar, hdr, VC_SORT_BOOL(), vc_tm_app2(ar, VC_OP_EQ(), ag.al_ids[i as u64], ag.al_ids[j as u64]))
}

// The symbol of slot `idx` of parameter `k` at `sort`, declared on first use.
fn vc_agg_own_symbol(ag: VcAgg, ar: VcArena, hdr: SmtScript, k: i64, idx: i64, sort: i64) -> i64 {
    let mut i: u64 = 0;
    while i < ag.ps_param.len() {
        if ag.ps_param[i] == k && ag.ps_slot[i] == idx && ag.ps_sort[i] == sort {
            return vc_tm_var(ar, vc_agg_symbol_name(k, idx, sort));
        }
        i = i + 1;
    }
    vc_agg_param_symbol(ag, ar, hdr, k, idx, sort)
}

// Initial value of slot `idx` of parameter `k` at `sort`: its own symbol, unless
// it is the same object as an earlier aliasable parameter, when it is that one's
// initial value (each earlier value already follows its own earlier twin, so the
// result is the symbol of the first parameter with this identity).
fn vc_agg_param_initial(ag: VcAgg, ar: VcArena, hdr: SmtScript, k: i64, idx: i64, sort: i64) -> i64 {
    let pos: i64 = vc_agg_alias_pos(ag, k);
    if pos < 0 { return vc_agg_own_symbol(ag, ar, hdr, k, idx, sort); }
    let vals: Vec<i64> = Vec::new();
    let mut i: i64 = 0;
    while i <= pos {
        let mut acc: i64 = vc_agg_own_symbol(ag, ar, hdr, ag.al_params[i as u64], idx, sort);
        let mut j: i64 = 0;
        while j < i {
            acc = vc_tm_app3(ar, VC_OP_ITE(), vc_agg_same_object(ag, ar, hdr, j, i), vals[j as u64], acc);
            j = j + 1;
        }
        vals.push(vc_flow_name(ag.fl, ar, hdr, sort, acc));
        i = i + 1;
    }
    vals[pos as u64]
}

// Gives the parameter symbols declared since the first `seen` the IR type `ty` of
// the access that declared them, which is what a counterexample prints them as.
fn vc_agg_type_symbols(ag: VcAgg, seen: u64, ty: i64) {
    let mut j: u64 = seen;
    while j < ag.ps_param.len() {
        ag.ps_ty[j] = ty;
        j = j + 1;
    }
}

// Term of slot `idx` of `obj` at `sort` at the current point of the walk. A slot
// is cached; a Phi object's slot only until the next write, because that write
// may have changed one of the objects it merges. A view that a write covered
// reads as a fresh unconstrained constant, whatever the object's kind.
fn vc_agg_get(ag: VcAgg, ar: VcArena, hdr: SmtScript, obj: i64, idx: i64, sort: i64) -> i64 {
    let s: i64 = vc_agg_find(ag, obj, idx, sort);
    let kind: i64 = ag.kinds[obj as u64];
    if s >= 0 && ag.sl_term[s as u64] >= 0 && (kind != VC_OBJ_PHI() || ag.sl_epoch[s as u64] == ag.epoch) {
        return ag.sl_term[s as u64];
    }
    let t: i64 = {
        if kind == VC_OBJ_PARAM() && s < 0 {
            vc_agg_param_initial(ag, ar, hdr, ag.owners[obj as u64], idx, sort)
        } else if kind == VC_OBJ_PHI() {
            // Named like a scalar Phi: merges of merges would otherwise print
            // every shared subterm once per use and grow exponentially.
            vc_flow_name(ag.fl, ar, hdr, sort, vc_agg_phi_read(ag, ar, hdr, obj, idx, sort))
        } else {
            vc_agg_junk(ag, ar, hdr, sort)
        }
    };
    vc_agg_store(ag, obj, idx, sort, t);
    t
}

// The `ite` chain `vc_flow_phi_value` builds, over the slot of each incoming
// object: the first edge is the base, each later one wraps it. A block's edges
// are final once the block is entered, so this may run at any later read.
fn vc_agg_phi_read(ag: VcAgg, ar: VcArena, hdr: SmtScript, obj: i64, idx: i64, sort: i64) -> i64 {
    let fl: VcFlow = ag.fl;
    let phi: i64 = ag.phis[obj as u64];
    let first: i64 = fl.in_head[ag.owners[obj as u64] as u64];
    let base: i64 = vc_flow_upsilon_from(fl, phi, fl.e_src[first as u64]);
    let mut acc: i64 = vc_agg_get(ag, ar, hdr, base, idx, sort);
    let mut e: i64 = fl.e_next[first as u64];
    while e >= 0 {
        let child: i64 = vc_flow_upsilon_from(fl, phi, fl.e_src[e as u64]);
        let v: i64 = vc_agg_get(ag, ar, hdr, child, idx, sort);
        if v != acc {
            acc = vc_tm_app3(ar, VC_OP_ITE(), fl.e_cond[e as u64], v, acc);
        }
        e = fl.e_next[e as u64];
    }
    acc
}

// Object of the Phi `phi_id` at the head of block `bi`: the object itself when
// every live edge supplies the same one, else a Phi object that merges them. The
// Upsilons recorded the supplied objects in place of terms.
fn vc_agg_phi(ag: VcAgg, bi: u64, phi_id: i64) -> i64 {
    let fl: VcFlow = ag.fl;
    let first: i64 = fl.in_head[bi];
    let base: i64 = vc_flow_upsilon_from(fl, phi_id, fl.e_src[first as u64]);
    let mut e: i64 = fl.e_next[first as u64];
    while e >= 0 {
        if vc_flow_upsilon_from(fl, phi_id, fl.e_src[e as u64]) != base {
            return vc_agg_push_obj(ag, VC_OBJ_PHI(), bi as i64, phi_id);
        }
        e = fl.e_next[e as u64];
    }
    base
}
