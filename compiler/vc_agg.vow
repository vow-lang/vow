module VcAgg

use ir
use ir_dominance
use vc_term
use vc_smt
use vc_flow

// Scalarised model of the heap aggregates (structs, enums, `Option`, `Result`)
// the native verifier reads. A pointer value is an object, and an object is a
// set of scalar field terms; no pointer is ever an SMT term, so field access,
// construction and `match` reduce to the i64/Bool terms the executor already
// handles.
//
// Three kinds of object exist. An allocation (`RegionAlloc`) starts with no
// field values and is written by `FieldSet`; a parameter's fields are
// per-parameter symbols; a pointer Phi is the `ite` over its incoming objects.
// A field nothing wrote is a fresh unconstrained constant, never 0: it is what
// the other arm of a `Some`/`None` merge would leave in the payload slot. Slots
// are read lazily, so a parameter needs no layout. A slot is keyed by index and
// sort (Bool or a bit-vector width), because one enum slot can hold an i64
// payload in one variant and a Bool in another. A 128-bit value is one term of
// sort 128 that occupies slots `idx` and `idx + 1`.
//
// A write at path condition `pc` stores `ite(pc, new, old)`. This is exact
// because the executor walks the blocks of an acyclic function once, in
// topological order, and `pc` is the condition for execution to reach the
// writing block. A read walked before a write cannot execute after it, and two
// blocks that do not reach each other never both run, so the chain of writes in
// walk order is the object's state on whichever path is taken. A write whose
// path condition is the one the object was created under, or `true`, has no
// observable old value and replaces the slot. The gate
// (`vc_agg_shape_detail`) allows a `FieldSet` only on an allocation or a
// parameter; mutation of anything else is `Skipped`, never guessed at.

fn VC_OBJ_ALLOC() -> i64 { 0 }
fn VC_OBJ_PARAM() -> i64 { 1 }
fn VC_OBJ_PHI() -> i64 { 2 }

struct VcAgg {
    fl: VcFlow,
    kinds: Vec<i64>,
    owners: Vec<i64>,
    phis: Vec<i64>,
    heads: Vec<i64>,
    sl_next: Vec<i64>,
    sl_idx: Vec<i64>,
    sl_sort: Vec<i64>,
    sl_term: Vec<i64>,
    sl_epoch: Vec<i64>,
    births: Vec<i64>,
    epoch: i64,
    junk: i64,
}

// `fl` is the control-flow state of the walk: a Phi object reads its incoming
// objects from the edges and Upsilons recorded there.
fn vc_agg_new(fl: VcFlow) -> VcAgg {
    VcAgg {
        fl: fl,
        kinds: Vec::new(),
        owners: Vec::new(),
        phis: Vec::new(),
        heads: Vec::new(),
        sl_next: Vec::new(),
        sl_idx: Vec::new(),
        sl_sort: Vec::new(),
        sl_term: Vec::new(),
        sl_epoch: Vec::new(),
        births: Vec::new(),
        epoch: 0,
        junk: 0,
    }
}

// `owner` is the parameter index of a parameter object and the block of a Phi
// object (whose Phi is `phi`); -1 otherwise. `births` is the path condition an
// allocation was created under; -1 for every other kind.
fn vc_agg_push_obj(ag: VcAgg, kind: i64, owner: i64, phi: i64) -> i64 {
    let id: i64 = ag.kinds.len() as i64;
    ag.kinds.push(kind);
    ag.owners.push(owner);
    ag.phis.push(phi);
    ag.heads.push(-1);
    ag.births.push(-1);
    id
}

fn vc_agg_alloc(ag: VcAgg) -> i64 {
    vc_agg_push_obj(ag, VC_OBJ_ALLOC(), -1, -1)
}

// One object per parameter index, so a parameter's field symbols are declared once.
fn vc_agg_param(ag: VcAgg, k: i64) -> i64 {
    let mut o: u64 = 0;
    while o < ag.kinds.len() {
        if ag.kinds[o] == VC_OBJ_PARAM() && ag.owners[o] == k {
            return o as i64;
        }
        o = o + 1;
    }
    vc_agg_push_obj(ag, VC_OBJ_PARAM(), k, -1)
}

fn vc_agg_find(ag: VcAgg, obj: i64, idx: i64, sort: i64) -> i64 {
    let mut s: i64 = ag.heads[obj as u64];
    while s >= 0 {
        if ag.sl_idx[s as u64] == idx && ag.sl_sort[s as u64] == sort {
            return s;
        }
        s = ag.sl_next[s as u64];
    }
    -1
}

fn vc_agg_store(ag: VcAgg, obj: i64, idx: i64, sort: i64, term: i64) {
    let s: i64 = vc_agg_find(ag, obj, idx, sort);
    if s >= 0 {
        ag.sl_term[s as u64] = term;
        ag.sl_epoch[s as u64] = ag.epoch;
        return;
    }
    let id: i64 = ag.sl_idx.len() as i64;
    ag.sl_next.push(ag.heads[obj as u64]);
    ag.sl_idx.push(idx);
    ag.sl_sort.push(sort);
    ag.sl_term.push(term);
    ag.sl_epoch.push(ag.epoch);
    ag.heads[obj as u64] = id;
}

// A 128-bit value takes two 8-byte slots, every other sort one.
fn vc_agg_slot_width(sort: i64) -> i64 {
    if sort == 128 { return 2; }
    1
}

// Writes `term` into slot `idx` at `sort`; every view of a slot the write covers
// reads as unconstrained, then the exact view takes `term`.
fn vc_agg_set(ag: VcAgg, obj: i64, idx: i64, sort: i64, term: i64) {
    ag.epoch = ag.epoch + 1;
    let end: i64 = idx + vc_agg_slot_width(sort);
    let mut s: i64 = ag.heads[obj as u64];
    while s >= 0 {
        let si: i64 = ag.sl_idx[s as u64];
        if si < end && idx < si + vc_agg_slot_width(ag.sl_sort[s as u64]) {
            ag.sl_term[s as u64] = -1;
        }
        s = ag.sl_next[s as u64];
    }
    vc_agg_store(ag, obj, idx, sort, term);
}

fn vc_agg_overlaps(ag: VcAgg, s: i64, idx: i64, end: i64) -> bool {
    let si: i64 = ag.sl_idx[s as u64];
    si < end && idx < si + vc_agg_slot_width(ag.sl_sort[s as u64])
}

// Writes `term` into slot `idx` of `obj` when the block runs under `pc`. A write
// that always runs once the object exists replaces the slot; any other keeps the
// old value on the paths that skip it, and every other view the write covers
// becomes unconstrained on the paths that take it.
fn vc_agg_write(ag: VcAgg, ar: VcArena, hdr: SmtScript, obj: i64, idx: i64, sort: i64, term: i64, pc: i64) {
    if vc_tm_is_true(ar, pc) || pc == ag.births[obj as u64] {
        vc_agg_set(ag, obj, idx, sort, term);
        return;
    }
    let old: i64 = vc_agg_get(ag, ar, hdr, obj, idx, sort);
    let end: i64 = idx + vc_agg_slot_width(sort);
    let mut s: i64 = ag.heads[obj as u64];
    while s >= 0 {
        let view: i64 = ag.sl_term[s as u64];
        if view >= 0 && vc_agg_overlaps(ag, s, idx, end) && !(ag.sl_idx[s as u64] == idx && ag.sl_sort[s as u64] == sort) {
            let junk: i64 = vc_agg_junk(ag, ar, hdr, ag.sl_sort[s as u64]);
            ag.sl_term[s as u64] = vc_tm_app3(ar, VC_OP_ITE(), pc, junk, view);
        }
        s = ag.sl_next[s as u64];
    }
    ag.epoch = ag.epoch + 1;
    vc_agg_store(ag, obj, idx, sort, vc_tm_app3(ar, VC_OP_ITE(), pc, term, old));
}

fn vc_agg_declare(ar: VcArena, hdr: SmtScript, name: String, sort: i64) -> i64 {
    vc_script_declare_const(hdr, name, sort);
    vc_tm_var(ar, name)
}

fn vc_agg_junk(ag: VcAgg, ar: VcArena, hdr: SmtScript, sort: i64) -> i64 {
    let name: String = String::from("j");
    name.push_str(i64_to_string(ag.junk));
    ag.junk = ag.junk + 1;
    vc_agg_declare(ar, hdr, name, sort)
}

fn vc_agg_param_symbol(ar: VcArena, hdr: SmtScript, k: i64, idx: i64, sort: i64) -> i64 {
    let name: String = String::from("p");
    name.push_str(i64_to_string(k));
    name.push_str(String::from("f"));
    name.push_str(i64_to_string(idx));
    name.push_str(String::from("s"));
    name.push_str(i64_to_string(sort));
    vc_agg_declare(ar, hdr, name, sort)
}

// Term of slot `idx` of `obj` at `sort` at the current point of the walk. A slot
// is cached; a Phi object's slot only until the next write, because that write
// may have changed one of the objects it merges. A view that a write covered
// reads as a fresh unconstrained constant, whatever the object's kind.
fn vc_agg_get(ag: VcAgg, ar: VcArena, hdr: SmtScript, obj: i64, idx: i64, sort: i64) -> i64 {
    let s: i64 = vc_agg_find(ag, obj, idx, sort);
    let kind: i64 = ag.kinds[obj as u64];
    if s >= 0 && ag.sl_term[s as u64] >= 0 && (kind != VC_OBJ_PHI() || ag.sl_epoch[s as u64] == ag.epoch) {
        return ag.sl_term[s as u64];
    }
    let t: i64 = {
        if kind == VC_OBJ_PARAM() && s < 0 {
            vc_agg_param_symbol(ar, hdr, ag.owners[obj as u64], idx, sort)
        } else if kind == VC_OBJ_PHI() {
            // Named like a scalar Phi: merges of merges would otherwise print
            // every shared subterm once per use and grow exponentially.
            vc_flow_name(ag.fl, ar, hdr, sort, vc_agg_phi_read(ag, ar, hdr, obj, idx, sort))
        } else {
            vc_agg_junk(ag, ar, hdr, sort)
        }
    };
    vc_agg_store(ag, obj, idx, sort, t);
    t
}

// The `ite` chain `vc_flow_phi_value` builds, over the slot of each incoming
// object: the first edge is the base, each later one wraps it. A block's edges
// are final once the block is entered, so this may run at any later read.
fn vc_agg_phi_read(ag: VcAgg, ar: VcArena, hdr: SmtScript, obj: i64, idx: i64, sort: i64) -> i64 {
    let fl: VcFlow = ag.fl;
    let phi: i64 = ag.phis[obj as u64];
    let first: i64 = fl.in_head[ag.owners[obj as u64] as u64];
    let base: i64 = vc_flow_upsilon_from(fl, phi, fl.e_src[first as u64]);
    let mut acc: i64 = vc_agg_get(ag, ar, hdr, base, idx, sort);
    let mut e: i64 = fl.e_next[first as u64];
    while e >= 0 {
        let child: i64 = vc_flow_upsilon_from(fl, phi, fl.e_src[e as u64]);
        let v: i64 = vc_agg_get(ag, ar, hdr, child, idx, sort);
        if v != acc {
            acc = vc_tm_app3(ar, VC_OP_ITE(), fl.e_cond[e as u64], v, acc);
        }
        e = fl.e_next[e as u64];
    }
    acc
}

// Object of the Phi `phi_id` at the head of block `bi`: the object itself when
// every live edge supplies the same one, else a Phi object that merges them. The
// Upsilons recorded the supplied objects in place of terms.
fn vc_agg_phi(ag: VcAgg, bi: u64, phi_id: i64) -> i64 {
    let fl: VcFlow = ag.fl;
    let first: i64 = fl.in_head[bi];
    let base: i64 = vc_flow_upsilon_from(fl, phi_id, fl.e_src[first as u64]);
    let mut e: i64 = fl.e_next[first as u64];
    while e >= 0 {
        if vc_flow_upsilon_from(fl, phi_id, fl.e_src[e as u64]) != base {
            return vc_agg_push_obj(ag, VC_OBJ_PHI(), bi as i64, phi_id);
        }
        e = fl.e_next[e as u64];
    }
    base
}

// Gate rule for writes: a `FieldSet` must target a `RegionAlloc` or a pointer
// parameter. A write through a merged object would have to reach every object
// the merge may stand for, and a parameter may be the very object another
// parameter names, so neither is modelled. "" when every write is, else the
// detail of an `unsupported-opcode` skip. `n_ids` is the size of the
// instruction-id space.
fn vc_agg_shape_detail(f: IrFunction, n_ids: u64) -> String {
    let def_op: Vec<i64> = dom_fill(n_ids, -1);
    let mut bi: u64 = 0;
    while bi < f.blocks.len() {
        let blk: IrBlock = f.blocks[bi];
        let mut ii: u64 = 0;
        while ii < blk.insts.len() {
            let inst: IrInst = blk.insts[ii];
            if inst.id >= 0 {
                def_op[inst.id as u64] = inst.op;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    let mut n_ptr_params: i64 = 0;
    let mut pi: u64 = 0;
    while pi < f.params.len() {
        if f.params[pi] == ITY_PTR() { n_ptr_params = n_ptr_params + 1; }
        pi = pi + 1;
    }
    bi = 0;
    while bi < f.blocks.len() {
        let blk: IrBlock = f.blocks[bi];
        let mut ii: u64 = 0;
        while ii < blk.insts.len() {
            let inst: IrInst = blk.insts[ii];
            if inst.op == IOP_FIELD_SET() {
                let op: i64 = def_op[inst.args[0] as u64];
                if op == IOP_PHI() {
                    return String::from("FieldSet through a merged value");
                }
                if op == IOP_GET_ARG() && n_ptr_params > 1 {
                    return String::from("FieldSet on a parameter that may alias another parameter");
                }
                if op != IOP_REGION_ALLOC() && op != IOP_GET_ARG() {
                    return String::from("FieldSet on a value that is neither an allocation nor a parameter");
                }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    String::from("")
}
