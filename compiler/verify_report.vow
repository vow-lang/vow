module VerifyReport

use ir
use diag
use verifier_ids

// Building the agent-facing report of a failed verification: where a violated
// clause lives, the call-site argument values a counterexample names, and the
// per-counterexample diagnostics. Mirrors vow/src/verify_outcome.rs and
// vow/src/counterexample.rs so both compilers emit the same `vow verify` JSON.

struct CeSource {
    file: String,
    start: i64,
    len: i64,
}

// The source range of one vow clause, read off its Vow* instruction's origin
// exactly as the Rust driver's `find_vow_span` does. An empty `file` means the
// clause has no recoverable location (reported as `"source": null`).
fn ce_source_for_vow(func: IrFunction, ve: IrVowEntry, path: String) -> CeSource {
    let blocks: Vec<IrBlock> = func.blocks;
    let mut bi: u64 = 0;
    while bi < blocks.len() {
        let insts: Vec<IrInst> = blocks[bi].insts;
        let mut ii: u64 = 0;
        while ii < insts.len() {
            let inst: IrInst = insts[ii];
            if (inst.op == IOP_VOW_REQ() || inst.op == IOP_VOW_ENS() || inst.op == IOP_VOW_INV()) && inst.dk == IDATA_VOW_ID() && inst.dv == ve.id {
                let mut file: String = ve.file;
                if file.len() == 0 {
                    file = func.source_file;
                }
                if file.len() == 0 {
                    file = path;
                }
                return CeSource { file: file, start: inst.ostart, len: inst.olen };
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    CeSource { file: String::from(""), start: 0, len: 0 }
}

fn ce_u64_to_string(v: i64) -> String {
    if v >= 0 {
        return i64_to_string(v);
    }
    let n: u64 = v as u64;
    let q: u64 = n / 10;
    let r: u64 = n % 10;
    let out: String = i64_to_string(q as i64);
    out.push_str(i64_to_string(r as i64));
    out
}

// A constant instruction's value as a counterexample display string. Mirrors
// `inst_constant_value_for_counterexample` in vow/src/cex_eval.rs.
fn ce_leaf_const_string(inst: IrInst) -> String {
    if inst.op == IOP_CONST_I32() || inst.op == IOP_CONST_I64() {
        return i64_to_string(inst.dv);
    }
    if inst.op == IOP_CONST_U64() {
        return ce_u64_to_string(inst.dv);
    }
    if inst.op == IOP_CONST_BOOL() {
        if inst.dv != 0 {
            return String::from("true");
        }
        return String::from("false");
    }
    String::from("")
}

struct CeFold {
    ok: bool,
    value: i64,
}

// Folds an argument subtree to an i64, or reports that it does not fold.
// Mirrors `eval_const_i64_for_counterexample` in vow/src/cex_eval.rs: only
// ConstI32/ConstI64 leaves, and only the wrapping operators fold (a checked
// operator aborts on overflow, so there is no value to invent for it).
fn ce_fold_i64(f: IrFunction, inst_id: i64) -> CeFold {
    let blocks: Vec<IrBlock> = f.blocks;
    let mut bi: u64 = 0;
    while bi < blocks.len() {
        let insts: Vec<IrInst> = blocks[bi].insts;
        let mut ii: u64 = 0;
        while ii < insts.len() {
            let inst: IrInst = insts[ii];
            if inst.id == inst_id {
                if inst.op == IOP_CONST_I32() || inst.op == IOP_CONST_I64() {
                    return CeFold { ok: true, value: inst.dv };
                }
                let wrapping: bool = inst.op == IOP_WADD() || inst.op == IOP_WSUB() || inst.op == IOP_WMUL();
                if wrapping && inst.args.len() >= 2 {
                    let lhs: CeFold = ce_fold_i64(f, inst.args[0]);
                    let rhs: CeFold = ce_fold_i64(f, inst.args[1]);
                    if lhs.ok && rhs.ok {
                        if inst.op == IOP_WADD() {
                            return CeFold { ok: true, value: lhs.value + rhs.value };
                        }
                        if inst.op == IOP_WSUB() {
                            return CeFold { ok: true, value: lhs.value - rhs.value };
                        }
                        return CeFold { ok: true, value: lhs.value * rhs.value };
                    }
                }
                return CeFold { ok: false, value: 0 };
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    CeFold { ok: false, value: 0 }
}

fn ce_arg_value_string(f: IrFunction, inst_id: i64) -> String {
    let folded: CeFold = ce_fold_i64(f, inst_id);
    if folded.ok {
        return i64_to_string(folded.value);
    }
    let blocks: Vec<IrBlock> = f.blocks;
    let mut bi: u64 = 0;
    while bi < blocks.len() {
        let insts: Vec<IrInst> = blocks[bi].insts;
        let mut ii: u64 = 0;
        while ii < insts.len() {
            if insts[ii].id == inst_id {
                return ce_leaf_const_string(insts[ii]);
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    String::from("")
}

// One error diagnostic per counterexample, mirroring `to_output_with_warnings`
// in vow/src/verify_outcome.rs: the code follows the blame, an unattributed
// verifier property gets its own code, and caller-blame call sites become the
// secondary spans. Appended after any warnings already in `dctx`.
fn vf_add_ce_diagnostics(dctx: DiagCtx, ces: Vec<VerifyCE>) {
    let mut i: u64 = 0;
    while i < ces.len() {
        let ce: VerifyCE = ces[i];
        let msg: String = String::from("");
        let mut code: i64 = EC_VOW_REQUIRES_VIOLATED();
        if ce.vow_id == verifier_unattributed_vow_id() {
            code = EC_VERIFIER_ASSERTION_UNATTRIBUTED();
            msg.push_str(String::from("verification failed in `"));
            msg.push_str(ce.function);
            msg.push_str(String::from("` on an unattributed property: "));
        } else {
            if ce.blame == DIAG_BLAME_CALLEE() {
                code = EC_VOW_ENSURES_VIOLATED();
            }
            msg.push_str(String::from("contract violation in `"));
            msg.push_str(ce.function);
            msg.push_str(String::from("`: "));
        }
        msg.push_str(ce.violation);
        let d: Diagnostic = diag_new(SEV_ERROR(), code, msg, ce.source, ce.source_start, ce.source_len, ce.blame);
        if ce.blame == DIAG_BLAME_CALLER() {
            let h: String = String::from("the call site violated function `");
            h.push_str(ce.function);
            h.push_str(String::from("`'s precondition"));
            diag_add_hint(d, h);
            let mut ai: u64 = 0;
            while ai < ce.violating_arg_params.len() {
                let ah: String = String::from("argument `");
                ah.push_str(ce.violating_arg_params[ai]);
                ah.push_str(String::from("` = "));
                ah.push_str(ce.violating_arg_values[ai]);
                ah.push_str(String::from(" violates the contract"));
                diag_add_hint(d, ah);
                ai = ai + 1;
            }
        }
        if ce.blame == DIAG_BLAME_CALLEE() {
            let h: String = String::from("function `");
            h.push_str(ce.function);
            h.push_str(String::from("` failed to establish its postcondition"));
            diag_add_hint(d, h);
        }
        let mut si: u64 = 0;
        while si < ce.call_site_functions.len() {
            diag_add_secondary(d, ce.call_site_files[si], ce.call_site_offsets[si], ce.call_site_lengths[si]);
            si = si + 1;
        }
        diag_ctx_emit(dctx, d);
        i = i + 1;
    }
}
