module ContractText

use ast
use diag

// Canonical source text of expressions, types, patterns, statements and blocks.
// The contract `description` (and from it `VowViolation.description` and the
// counterexample `violation`) is "{kind} {print_expr_text(predicate)}"; it must be
// byte-identical to what `vow_syntax::printer::print_expr` renders for the same
// predicate, so every function here mirrors its counterpart in
// vow-syntax/src/printer.rs, including how it indents nested blocks (4 spaces per
// nesting level, a closing brace aligned with its opener). Every node a contract
// can reach is covered; forms the parser cannot build (borrow, refinement types)
// and forms the checker rejects inside a contract have no arm here. The checker
// rejects tuple expressions directly (`contract_depth`); a tuple pattern is
// rejected indirectly, because it needs a syntactic tuple-literal initializer.

// Render an AST type node as source text, mirroring `print_type` in
// vow-syntax/src/printer.rs. The parser has no refinement type (`{ x: T | p }`
// is a parse error in both compilers) and builds a tuple type only with two or
// more elements, so every type node a contract can reach is covered.
fn print_type_text(a: AstArena, tid: i64) -> String {
    let tag: i64 = type_tag(a, tid);
    if tag == TY_NAMED() {
        return arena_str(a, type_a(a, tid));
    }
    if tag == TY_GENERIC() {
        let name: String = arena_str(a, type_a(a, tid));
        let result: String = String::from("");
        result.push_str(name);
        result.push_str(String::from("<"));
        result.push_str(print_type_list_text(a, type_b(a, tid)));
        result.push_str(String::from(">"));
        return result;
    }
    if tag == TY_UNIT() { return String::from("()"); }
    if tag == TY_NEVER() { return String::from("!"); }
    if tag == TY_REF() {
        let result: String = String::from("&");
        result.push_str(print_type_text(a, type_a(a, tid)));
        return result;
    }
    if tag == TY_SLICE() {
        let result: String = String::from("[");
        result.push_str(print_type_text(a, type_a(a, tid)));
        result.push_str(String::from("]"));
        return result;
    }
    if tag == TY_TUPLE() {
        let result: String = String::from("(");
        result.push_str(print_type_list_text(a, type_a(a, tid)));
        result.push_str(String::from(")"));
        return result;
    }
    String::from("")
}

fn print_type_list_text(a: AstArena, lid: i64) -> String {
    let result: String = String::from("");
    let n: i64 = list_len(a, lid);
    let mut i: i64 = 0;
    while i < n {
        if i > 0 { result.push_str(String::from(", ")); }
        result.push_str(print_type_text(a, list_get(a, lid, i)));
        i = i + 1;
    }
    result
}

// Four spaces per nesting level, mirroring `indent` in printer.rs.
fn indent_text(level: i64) -> String {
    let result: String = String::from("");
    let mut i: i64 = 0;
    while i < level {
        result.push_str(String::from("    "));
        i = i + 1;
    }
    result
}

fn print_expr_list_text(a: AstArena, lid: i64, level: i64) -> String {
    let result: String = String::from("");
    let n: i64 = list_len(a, lid);
    let mut i: i64 = 0;
    while i < n {
        if i > 0 { result.push_str(String::from(", ")); }
        result.push_str(print_expr_text_at(a, list_get(a, lid, i), level));
        i = i + 1;
    }
    result
}

fn print_pat_list_text(a: AstArena, lid: i64) -> String {
    let result: String = String::from("");
    let n: i64 = list_len(a, lid);
    let mut i: i64 = 0;
    while i < n {
        if i > 0 { result.push_str(String::from(", ")); }
        result.push_str(print_pat_text(a, list_get(a, lid, i)));
        i = i + 1;
    }
    result
}

// Escape a string literal for contract text, mirroring `print_lit`'s
// Lit::String arm in vow-syntax/src/printer.rs.
fn print_str_lit_text(raw: String) -> String {
    let result: String = String::from("\"");
    let n: u64 = raw.len();
    let mut i: u64 = 0;
    while i < n {
        let bu: u8 = byte_at_u8(raw, i);
        let b: i64 = bu as i64;
        if b == 10 { result.push_str(String::from("\\n")); }
        else if b == 9 { result.push_str(String::from("\\t")); }
        else if b == 13 { result.push_str(String::from("\\r")); }
        else if b == 92 { result.push_str(String::from("\\\\")); }
        else if b == 34 { result.push_str(String::from("\\\"")); }
        else if b == 0 { result.push_str(String::from("\\0")); }
        else { result.push_byte(bu); }
        i = i + 1;
    }
    result.push_str(String::from("\""));
    result
}

fn print_path_text(a: AstArena, path_lid: i64) -> String {
    let result: String = String::from("");
    let n: i64 = list_len(a, path_lid);
    let mut i: i64 = 0;
    while i < n {
        if i > 0 { result.push_str(String::from("::")); }
        result.push_str(arena_str(a, list_get(a, path_lid, i)));
        i = i + 1;
    }
    result
}

fn parenthesize_text(inner: String) -> String {
    let result: String = String::from("(");
    result.push_str(inner);
    result.push_str(String::from(")"));
    result
}

// Mirrors `binop_precedence` in vow-syntax/src/printer.rs.
fn binop_precedence(op: i64) -> i64 {
    if op == BINOP_OR() { return 1; }
    if op == BINOP_AND() { return 2; }
    if op == BINOP_EQ() || op == BINOP_NE() || op == BINOP_LT() || op == BINOP_LE()
        || op == BINOP_GT() || op == BINOP_GE() { return 3; }
    if op == BINOP_BITOR() { return 4; }
    if op == BINOP_XOR() { return 5; }
    if op == BINOP_BITAND() { return 6; }
    if op == BINOP_SHL() || op == BINOP_SHR() { return 7; }
    if op == BINOP_ADD() || op == BINOP_SUB() || op == BINOP_ADD_CHK() || op == BINOP_SUB_CHK() {
        return 8;
    }
    9
}

// Mirrors `question_chain_ends_in_cast` in vow-syntax/src/printer.rs: `-x as T?`
// parses as `((-x) as T)?`, so a unary operand that is a `?` chain wrapping a
// cast keeps its parentheses.
fn question_chain_ends_in_cast(a: AstArena, eid: i64) -> bool {
    let mut cur: i64 = eid;
    while expr_tag(a, cur) == EXPR_QUESTION() {
        cur = expr_a(a, cur);
        if expr_tag(a, cur) == EXPR_CAST() { return true; }
    }
    false
}

// Mirrors `print_postfix_base`: an unparenthesised block-like expression ends
// the expression, so it (like any operator expression) is parenthesized before
// a postfix `.`, `[`, `(` or `?`.
fn print_postfix_base_text(a: AstArena, eid: i64, level: i64) -> String {
    let text: String = print_expr_text_at(a, eid, level);
    let tag: i64 = expr_tag(a, eid);
    if is_block_expr(a, eid) || tag == EXPR_BINOP() || tag == EXPR_UNOP() || tag == EXPR_ASSIGN()
        || tag == EXPR_BREAK() || tag == EXPR_RETURN() {
        return parenthesize_text(text);
    }
    text
}

// Mirrors `print_expr_with_parens`: a nested binary operand is parenthesized
// when it binds no tighter than its parent (strictly looser on the left); a
// block-like left operand is always parenthesized.
fn print_binop_operand_text(a: AstArena, eid: i64, parent_prec: i64, is_right: bool, level: i64) -> String {
    let text: String = print_expr_text_at(a, eid, level);
    if !is_right && is_block_expr(a, eid) { return parenthesize_text(text); }
    if expr_tag(a, eid) != EXPR_BINOP() { return text; }
    let child_prec: i64 = binop_precedence(expr_a(a, eid));
    let needs: bool = if is_right { child_prec <= parent_prec } else { child_prec < parent_prec };
    if needs { return parenthesize_text(text); }
    text
}

fn print_expr_text(a: AstArena, eid: i64) -> String {
    print_expr_text_at(a, eid, 0)
}

// Mirrors `print_expr_at`: `level` is the indent level of the line the
// expression starts on.
fn print_expr_text_at(a: AstArena, eid: i64, level: i64) -> String {
    let tag: i64 = expr_tag(a, eid);
    if tag == EXPR_LIT_INT() {
        return expr_int_text(a, eid);
    }
    if tag == EXPR_LIT_FLOAT() {
        let bits: i64 = expr_a(a, eid);
        let text: String = format_f64_bits(bits as u64);
        let mut has_dot: bool = false;
        let mut k: u64 = 0u64;
        while k < text.len() {
            if text.byte_at(k) == 46 { has_dot = true; }
            k = k + 1u64;
        }
        if has_dot { return text; }
        let with_frac: String = String::from("");
        with_frac.push_str(text);
        with_frac.push_str(String::from(".0"));
        return with_frac;
    }
    if tag == EXPR_LIT_BOOL() {
        let val: i64 = expr_a(a, eid);
        if val != 0 { return String::from("true"); }
        return String::from("false");
    }
    if tag == EXPR_IDENT() {
        let name_sid: i64 = expr_a(a, eid);
        return arena_str(a, name_sid);
    }
    if tag == EXPR_RESULT() {
        return String::from("result");
    }
    if tag == EXPR_BINOP() {
        let op: i64 = expr_a(a, eid);
        let lhs_eid: i64 = expr_b(a, eid);
        let rhs_eid: i64 = expr_c(a, eid);
        let prec: i64 = binop_precedence(op);
        let lhs_s: String = print_binop_operand_text(a, lhs_eid, prec, false, level);
        let rhs_s: String = print_binop_operand_text(a, rhs_eid, prec, true, level);
        let op_s: String = binop_str(op);
        let result: String = String::from("");
        result.push_str(lhs_s);
        result.push_str(String::from(" "));
        result.push_str(op_s);
        result.push_str(String::from(" "));
        result.push_str(rhs_s);
        return result;
    }
    if tag == EXPR_UNOP() {
        let op: i64 = expr_a(a, eid);
        let operand_eid: i64 = expr_b(a, eid);
        let operand_tag: i64 = expr_tag(a, operand_eid);
        let mut inner_s: String = print_expr_text_at(a, operand_eid, level);
        if operand_tag == EXPR_BINOP() || operand_tag == EXPR_CAST()
            || question_chain_ends_in_cast(a, operand_eid) {
            inner_s = parenthesize_text(inner_s);
        }
        // `-!x` would lex as the checked-subtraction token `-!`.
        if op != UNOP_NOT() && operand_tag == EXPR_UNOP() && expr_a(a, operand_eid) == UNOP_NOT() {
            inner_s = parenthesize_text(inner_s);
        }
        if op == UNOP_NOT() {
            let result: String = String::from("!");
            result.push_str(inner_s);
            return result;
        }
        let result: String = String::from("-");
        result.push_str(inner_s);
        return result;
    }
    if tag == EXPR_CAST() {
        let inner_eid: i64 = expr_a(a, eid);
        let inner_s: String = print_expr_text_at(a, inner_eid, level);
        let result: String = String::from("");
        // A non-atomic operand is parenthesized so the cast binds where the
        // source said it did. EXPR_RESULT is listed because the self-hosted
        // parser makes `result` a distinct node, where the Rust parser sees
        // Ident("result").
        let inner_tag: i64 = expr_tag(a, inner_eid);
        let atomic: bool = inner_tag == EXPR_LIT_INT() || inner_tag == EXPR_LIT_FLOAT()
            || inner_tag == EXPR_LIT_BOOL()
            || inner_tag == EXPR_LIT_STR() || inner_tag == EXPR_IDENT()
            || inner_tag == EXPR_RESULT() || inner_tag == EXPR_CALL()
            || inner_tag == EXPR_METHOD() || inner_tag == EXPR_FIELD()
            || inner_tag == EXPR_INDEX() || inner_tag == EXPR_QUESTION()
            || inner_tag == EXPR_CAST();
        if atomic {
            result.push_str(inner_s);
        } else {
            result.push_str(parenthesize_text(inner_s));
        }
        result.push_str(String::from(" as "));
        result.push_str(print_type_text(a, expr_b(a, eid)));
        return result;
    }
    if tag == EXPR_LIT_STR() {
        return print_str_lit_text(arena_str(a, expr_a(a, eid)));
    }
    if tag == EXPR_SLIT() {
        let result: String = print_path_text(a, expr_a(a, eid));
        let fields_lid: i64 = expr_b(a, eid);
        let nfields: i64 = list_len(a, fields_lid) / 2;
        if nfields == 0 {
            result.push_str(String::from(" {}"));
            return result;
        }
        result.push_str(String::from(" { "));
        let mut i: i64 = 0;
        while i < nfields {
            if i > 0 { result.push_str(String::from(", ")); }
            result.push_str(arena_str(a, list_get(a, fields_lid, i * 2)));
            result.push_str(String::from(": "));
            result.push_str(print_expr_text_at(a, list_get(a, fields_lid, i * 2 + 1), level));
            i = i + 1;
        }
        result.push_str(String::from(" }"));
        return result;
    }
    if tag == EXPR_ECTOR() {
        let result: String = print_path_text(a, expr_a(a, eid));
        let args_lid: i64 = expr_b(a, eid);
        if list_len(a, args_lid) == 0 { return result; }
        result.push_str(String::from("("));
        result.push_str(print_expr_list_text(a, args_lid, level));
        result.push_str(String::from(")"));
        return result;
    }
    if tag == EXPR_QUESTION() {
        let result: String = String::from("");
        result.push_str(print_postfix_base_text(a, expr_a(a, eid), level));
        result.push_str(String::from("?"));
        return result;
    }
    if tag == EXPR_FIELD() {
        let base_s: String = print_postfix_base_text(a, expr_a(a, eid), level);
        let result: String = String::from("");
        result.push_str(base_s);
        result.push_str(String::from("."));
        result.push_str(arena_str(a, expr_b(a, eid)));
        return result;
    }
    if tag == EXPR_INDEX() {
        let base_s: String = print_postfix_base_text(a, expr_a(a, eid), level);
        let idx_s: String = print_expr_text_at(a, expr_b(a, eid), level);
        let result: String = String::from("");
        result.push_str(base_s);
        result.push_str(String::from("["));
        result.push_str(idx_s);
        result.push_str(String::from("]"));
        return result;
    }
    if tag == EXPR_METHOD() {
        let recv_s: String = print_postfix_base_text(a, expr_a(a, eid), level);
        let result: String = String::from("");
        result.push_str(recv_s);
        result.push_str(String::from("."));
        result.push_str(arena_str(a, expr_b(a, eid)));
        result.push_str(String::from("("));
        result.push_str(print_expr_list_text(a, expr_c(a, eid), level));
        result.push_str(String::from(")"));
        return result;
    }
    if tag == EXPR_CALL() {
        let callee_s: String = print_postfix_base_text(a, expr_a(a, eid), level);
        let result: String = String::from("");
        result.push_str(callee_s);
        result.push_str(String::from("("));
        result.push_str(print_expr_list_text(a, expr_b(a, eid), level));
        result.push_str(String::from(")"));
        return result;
    }
    print_control_expr_text(a, eid, tag, level)
}

// Mirrors `head_exposes_struct_literal` in vow-syntax/src/printer.rs: true when
// printing `eid` leaves a struct literal outside every delimiter, where an
// `if` / `while` / `for` / `match` head would read `Name {` as the body. An
// over-approximation by design; both printers must keep the same arm list.
fn head_exposes_struct_literal_text(a: AstArena, eid: i64) -> bool {
    let tag: i64 = expr_tag(a, eid);
    if tag == EXPR_SLIT() { return true; }
    if tag == EXPR_BINOP() {
        return head_exposes_struct_literal_text(a, expr_b(a, eid))
            || head_exposes_struct_literal_text(a, expr_c(a, eid));
    }
    if tag == EXPR_ASSIGN() {
        return head_exposes_struct_literal_text(a, expr_a(a, eid))
            || head_exposes_struct_literal_text(a, expr_b(a, eid));
    }
    if tag == EXPR_UNOP() {
        return head_exposes_struct_literal_text(a, expr_b(a, eid));
    }
    if tag == EXPR_CAST() || tag == EXPR_QUESTION() || tag == EXPR_FIELD()
        || tag == EXPR_INDEX() || tag == EXPR_METHOD() || tag == EXPR_CALL() {
        return head_exposes_struct_literal_text(a, expr_a(a, eid));
    }
    if tag == EXPR_BREAK() || tag == EXPR_RETURN() {
        let value_eid: i64 = expr_a(a, eid);
        return value_eid != -1 && head_exposes_struct_literal_text(a, value_eid);
    }
    false
}

fn print_head_text(a: AstArena, eid: i64, level: i64) -> String {
    let text: String = print_expr_text_at(a, eid, level);
    if head_exposes_struct_literal_text(a, eid) { return parenthesize_text(text); }
    text
}

// The compound forms: `if`, blocks, `match` and the loop / jump expressions.
fn print_control_expr_text(a: AstArena, eid: i64, tag: i64, level: i64) -> String {
    if tag == EXPR_IF() {
        let result: String = String::from("if ");
        result.push_str(print_head_text(a, expr_a(a, eid), level));
        result.push_str(String::from(" "));
        result.push_str(print_block_text(a, expr_b(a, eid), level));
        let else_eid: i64 = expr_c(a, eid);
        if else_eid != -1 {
            result.push_str(String::from(" else "));
            result.push_str(print_expr_text_at(a, else_eid, level));
        }
        return result;
    }
    if tag == EXPR_BLOCK() {
        return print_block_text(a, expr_a(a, eid), level);
    }
    if tag == EXPR_MATCH() {
        let result: String = String::from("match ");
        result.push_str(print_head_text(a, expr_a(a, eid), level));
        result.push_str(String::from(" {\n"));
        let arms_lid: i64 = expr_b(a, eid);
        let narms: i64 = list_len(a, arms_lid) / 2;
        let mut i: i64 = 0;
        while i < narms {
            result.push_str(indent_text(level + 1));
            result.push_str(print_pat_text(a, list_get(a, arms_lid, i * 2)));
            result.push_str(String::from(" => "));
            result.push_str(print_expr_text_at(a, list_get(a, arms_lid, i * 2 + 1), level + 1));
            result.push_str(String::from(",\n"));
            i = i + 1;
        }
        result.push_str(indent_text(level));
        result.push_str(String::from("}"));
        return result;
    }
    if tag == EXPR_WHILE() {
        let result: String = String::from("while ");
        result.push_str(print_head_text(a, expr_a(a, eid), level));
        result.push_str(print_loop_vow_text(a, expr_c(a, eid), level));
        result.push_str(print_block_text(a, expr_b(a, eid), level));
        return result;
    }
    if tag == EXPR_LOOP() {
        let result: String = String::from("loop");
        result.push_str(print_loop_vow_text(a, expr_b(a, eid), level));
        result.push_str(print_block_text(a, expr_a(a, eid), level));
        return result;
    }
    if tag == EXPR_FOR() {
        let info_lid: i64 = expr_c(a, eid);
        let result: String = String::from("for ");
        result.push_str(arena_str(a, list_get(a, info_lid, 0)));
        result.push_str(String::from(" in "));
        result.push_str(print_head_text(a, expr_a(a, eid), level));
        result.push_str(print_loop_vow_text(a, list_get(a, info_lid, 1), level));
        result.push_str(print_block_text(a, expr_b(a, eid), level));
        return result;
    }
    if tag == EXPR_BREAK() || tag == EXPR_RETURN() {
        let result: String = String::from("");
        if tag == EXPR_BREAK() { result.push_str(String::from("break")); }
        else { result.push_str(String::from("return")); }
        let value_eid: i64 = expr_a(a, eid);
        if value_eid != -1 {
            result.push_str(String::from(" "));
            result.push_str(print_expr_text_at(a, value_eid, level));
        }
        return result;
    }
    if tag == EXPR_CONTINUE() { return String::from("continue"); }
    if tag == EXPR_ASSIGN() {
        let result: String = String::from("");
        result.push_str(print_expr_text_at(a, expr_a(a, eid), level));
        result.push_str(String::from(" = "));
        result.push_str(print_expr_text_at(a, expr_b(a, eid), level));
        return result;
    }
    String::from("")
}

fn binop_str(op: i64) -> String {
    if op == BINOP_ADD() { return String::from("+"); }
    if op == BINOP_SUB() { return String::from("-"); }
    if op == BINOP_MUL() { return String::from("*"); }
    if op == BINOP_DIV() { return String::from("/"); }
    if op == BINOP_REM() { return String::from("%"); }
    if op == BINOP_EQ() { return String::from("=="); }
    if op == BINOP_NE() { return String::from("!="); }
    if op == BINOP_LT() { return String::from("<"); }
    if op == BINOP_LE() { return String::from("<="); }
    if op == BINOP_GT() { return String::from(">"); }
    if op == BINOP_GE() { return String::from(">="); }
    if op == BINOP_AND() { return String::from("&&"); }
    if op == BINOP_OR() { return String::from("||"); }
    if op == BINOP_BITAND() { return String::from("&"); }
    if op == BINOP_BITOR() { return String::from("|"); }
    if op == BINOP_ADD_CHK() { return String::from("+!"); }
    if op == BINOP_SUB_CHK() { return String::from("-!"); }
    if op == BINOP_MUL_CHK() { return String::from("*!"); }
    if op == BINOP_DIV_CHK() { return String::from("/!"); }
    if op == BINOP_REM_CHK() { return String::from("%!"); }
    if op == BINOP_XOR() { return String::from("^"); }
    if op == BINOP_SHL() { return String::from("<<"); }
    if op == BINOP_SHR() { return String::from(">>"); }
    String::from("?")
}

// Mirrors `print_pat`. Only the pattern forms the checker accepts reach a
// contract: `_`, identifiers and qualified enum variants. A tuple pattern needs a
// tuple-literal initializer, which a contract rejects; literal and struct patterns
// are rejected with UnsupportedPattern before lowering, and the parser has no
// or-pattern.
fn print_pat_text(a: AstArena, pid: i64) -> String {
    let tag: i64 = pat_tag(a, pid);
    if tag == PAT_WILD() { return String::from("_"); }
    if tag == PAT_IDENT() {
        let result: String = String::from("");
        if pat_b(a, pid) == 1 { result.push_str(String::from("mut ")); }
        result.push_str(arena_str(a, pat_a(a, pid)));
        return result;
    }
    if tag == PAT_ENUM() {
        let result: String = print_path_text(a, pat_a(a, pid));
        let inner_lid: i64 = pat_b(a, pid);
        if list_len(a, inner_lid) == 0 { return result; }
        result.push_str(String::from("("));
        result.push_str(print_pat_list_text(a, inner_lid));
        result.push_str(String::from(")"));
        return result;
    }
    String::from("")
}

// The ` vow { ... } ` clause list a loop carries, or a single space when it has
// none. Mirrors the While/ForEach/Loop arms of `print_expr` in printer.rs.
fn print_loop_vow_text(a: AstArena, vow_lid: i64, level: i64) -> String {
    if vow_lid == -1 { return String::from(" "); }
    let result: String = String::from(" vow {\n");
    let n: i64 = list_len(a, vow_lid);
    let mut i: i64 = 0;
    while i < n {
        let cid: i64 = list_get(a, vow_lid, i);
        let kind: i64 = vow_clause_kind(a, cid);
        result.push_str(indent_text(level + 1));
        if kind == CLAUSE_REQUIRES() { result.push_str(String::from("requires")); }
        else if kind == CLAUSE_ENSURES() { result.push_str(String::from("ensures")); }
        else { result.push_str(String::from("invariant")); }
        result.push_str(String::from(": "));
        result.push_str(print_expr_text_at(a, vow_clause_expr(a, cid), level + 1));
        result.push_str(String::from("\n"));
        i = i + 1;
    }
    result.push_str(indent_text(level));
    result.push_str(String::from("} "));
    result
}

// Mirrors `print_stmt` without the leading indent and trailing newline.
fn print_stmt_text(a: AstArena, sid: i64, level: i64) -> String {
    let result: String = String::from("");
    if stmt_tag(a, sid) == STMT_LET() {
        result.push_str(String::from("let "));
        result.push_str(print_pat_text(a, stmt_a(a, sid)));
        let annot_tid: i64 = stmt_b(a, sid);
        if annot_tid != -1 {
            result.push_str(String::from(": "));
            result.push_str(print_type_text(a, annot_tid));
        }
        result.push_str(String::from(" = "));
        result.push_str(print_expr_text_at(a, stmt_c(a, sid), level));
        result.push_str(String::from(";"));
        return result;
    }
    result.push_str(print_expr_text_at(a, stmt_a(a, sid), level));
    if stmt_b(a, sid) == 1 { result.push_str(String::from(";")); }
    result
}

// Mirrors `print_block`: statements are indented one level deeper than `level`
// and the closing brace sits at `level`, exactly as the Rust printer renders
// them, so the two outputs match byte for byte. The parser
// stores a block's trailing expression as its last statement (no semicolon), so
// `blk_trail` is never set and prints identically to Rust's `trailing_expr`.
fn print_block_text(a: AstArena, bid: i64, level: i64) -> String {
    let result: String = String::from("{\n");
    let stmts_lid: i64 = blk_stmts(a, bid);
    let n: i64 = list_len(a, stmts_lid);
    let mut i: i64 = 0;
    while i < n {
        result.push_str(indent_text(level + 1));
        result.push_str(print_stmt_text(a, list_get(a, stmts_lid, i), level + 1));
        result.push_str(String::from("\n"));
        i = i + 1;
    }
    result.push_str(indent_text(level));
    result.push_str(String::from("}"));
    result
}
