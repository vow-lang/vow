module VcHeap

use ir
use ir_dominance
use vc_ops
use vc_strops
use vc_term
use vc_smt
use vc_int
use vc_agg

// Model of memory a function reads through a pointer it loaded: a `Vec`, a
// struct or a `Vec` element that is a field of a parameter or an element of a
// `Vec`. The IR types such a value `i64`, so it is a 64-bit handle (an address),
// never an object of `vc_agg`: no pointer is an SMT term, but an address is a
// bit-vector like any other, and what lives at it is a function of it.
//
//   field `k` of the object at handle `h`   hf<k>[h]            (64-bit slot)
//   length of the collection at `h`         hlen[h]
//   element `i` of the collection at `h`    helem[h ++ i]       (128-bit key)
//
// `hf<k>`, `hlen` and `helem` are unconstrained arrays declared on first use and
// never stored to. They are exact for every object the function cannot change: the
// instruction gates let a function write only an object it allocated or a parameter
// (every `FieldSet` and every mutating `Vec` operation needs a pointer-typed
// object, never a handle), and a fresh object cannot be at a handle it did not
// allocate. A parameter may be the object a handle names, so a function that reads
// through a handle and also writes a parameter lays the parameters' own state over
// the arrays (`vc_overlay`).
// Two reads of one handle are one array read, so `b.insts.len()` and
// `b.insts[n - 1]` agree on which `Vec` `b.insts` is, and handles that merge
// through a Phi, a `Vec` element or a field are plain 64-bit terms. A length is
// below the runtime's capacity mask (`vc_vec`), assumed for every handle read.
// An element is read as the 8-byte slot the runtime keeps, and a field is read at
// its own type from the low bits of its slot, like a `Vec` element.

struct VcHeap {
    slots: Vec<i64>,
    fields: Vec<i64>,
    len_arr: i64,
    elem_arr: i64,
    byte_arr: i64,
}

fn vc_heap_new() -> VcHeap {
    VcHeap {
        slots: Vec::new(),
        fields: Vec::new(),
        len_arr: -1,
        elem_arr: -1,
        byte_arr: -1,
    }
}

// True when the function read memory through a handle: its query needs arrays.
fn vc_heap_used(hp: VcHeap) -> bool {
    hp.len_arr >= 0 || hp.elem_arr >= 0 || hp.byte_arr >= 0 || hp.fields.len() > 0
}

// The 64-bit slot `slot` of the object at handle `h`.
fn vc_heap_slot(hp: VcHeap, ar: VcArena, hdr: SmtScript, h: i64, slot: i64) -> i64 {
    let mut i: u64 = 0;
    while i < hp.slots.len() {
        if hp.slots[i] == slot {
            return vc_tm_app2(ar, VC_OP_SELECT(), hp.fields[i], h);
        }
        i = i + 1;
    }
    let name: String = String::from("hf");
    name.push_str(i64_to_string(slot));
    let arr: i64 = vc_agg_declare(ar, hdr, name, VC_SORT_ARRAY64());
    hp.slots.push(slot);
    hp.fields.push(arr);
    vc_tm_app2(ar, VC_OP_SELECT(), arr, h)
}

// A 64-bit slot read as a field of type `ty` (Bool or an integer of up to 64 bits).
fn vc_heap_field(hp: VcHeap, ar: VcArena, hdr: SmtScript, h: i64, slot: i64, ty: i64) -> i64 {
    let raw: i64 = vc_heap_slot(hp, ar, hdr, h, slot);
    if ty == ITY_BOOL() {
        return vc_tm_app2(ar, VC_OP_DISTINCT(), raw, vc_tm_bv(ar, 64, 0, 0));
    }
    vc_cast(ar, ITY_I64(), ty, raw)
}

// The length of the collection at `h`. Its first read adds the runtime's own
// fact that a length is below the capacity mask to `assumed`.
fn vc_heap_len(hp: VcHeap, ar: VcArena, hdr: SmtScript, assumed: Vec<i64>, h: i64) -> i64 {
    if hp.len_arr < 0 {
        hp.len_arr = vc_agg_declare(ar, hdr, String::from("hlen"), VC_SORT_ARRAY64());
    }
    let len: i64 = vc_tm_app2(ar, VC_OP_SELECT(), hp.len_arr, h);
    let fact: i64 = vc_tm_app2(ar, VC_OP_BVULT(), len, vc_tm_bv(ar, 64, 9223372036854775807, 0));
    if ar.assumed[fact as u64] != 1 {
        ar.assumed[fact as u64] = 1;
        assumed.push(fact);
    }
    len
}

// Element `idx` of the collection at `h`, as its 8-byte slot.
fn vc_heap_elem(hp: VcHeap, ar: VcArena, hdr: SmtScript, h: i64, idx: i64) -> i64 {
    if hp.elem_arr < 0 {
        hp.elem_arr = vc_agg_declare(ar, hdr, String::from("helem"), VC_SORT_ARRAY128());
    }
    vc_tm_app2(ar, VC_OP_SELECT(), hp.elem_arr, vc_tm_app2(ar, VC_OP_CONCAT(), h, idx))
}

// Byte `idx` of the string at `h`: the low byte of its 64-bit cell, like a string the
// function built (`vc_str_byte`).
fn vc_heap_byte(hp: VcHeap, ar: VcArena, hdr: SmtScript, h: i64, idx: i64) -> i64 {
    if hp.byte_arr < 0 {
        hp.byte_arr = vc_agg_declare(ar, hdr, String::from("hbyte"), VC_SORT_ARRAY128());
    }
    let cell: i64 = vc_tm_app2(ar, VC_OP_SELECT(), hp.byte_arr, vc_tm_app2(ar, VC_OP_CONCAT(), h, idx));
    vc_tm_app2(ar, VC_OP_BVAND(), cell, vc_tm_bv(ar, 64, 255, 0))
}

// Gate: a `FieldGet` of a field of the object at a handle (an `i64` base). Only a
// Bool or an integer of up to 64 bits is read from the 8-byte slot; a float or a
// 128-bit field has no memory model.
fn vc_heap_field_get_ok(inst: IrInst, base_ty: i64) -> bool {
    inst.args.len() == 1 && base_ty == ITY_I64() && inst.dv >= 0 && inst.dk == IDATA_FIELD()
        && (inst.ty == ITY_BOOL() || (vc_ty_is_int(inst.ty) && vc_ty_bits(inst.ty) <= 64))
}

// Gate: `len`, an element or a byte read on a handle.
fn vc_heap_vec_call_ok(inst: IrInst, idx_ty: i64, kind: i64) -> bool {
    if kind == VC_VEC_LEN() { return inst.args.len() == 1 && inst.ty == ITY_U64(); }
    (kind == VC_VEC_GET() || kind == VC_STR_BYTE_AT()) && inst.args.len() == 2 && inst.ty == ITY_I64()
        && vc_ty_is_int(idx_ty) && vc_ty_bits(idx_ty) == 64
}

fn vc_heap_ty(tys: Vec<i64>, id: i64) -> i64 {
    if id < 0 || id >= tys.len() as i64 { return -1; }
    tys[id as u64]
}

fn vc_heap_is_read(inst: IrInst, tys: Vec<i64>) -> bool {
    if inst.args.len() == 0 { return false; }
    let t0: i64 = vc_heap_ty(tys, inst.args[0]);
    if t0 != ITY_I64() { return false; }
    if inst.op == IOP_FIELD_GET() { return true; }
    let k: i64 = vc_inst_vec_kind(inst);
    k == VC_VEC_LEN() || k == VC_VEC_GET() || k == VC_STR_BYTE_AT()
}

// Marks every Phi that an `Upsilon` of a marked value feeds, until nothing changes.
fn vc_heap_close_over_phis(f: IrFunction, flags: Vec<i64>) {
    let mut changed: bool = true;
    while changed {
        changed = false;
        let mut bi: u64 = 0;
        while bi < f.blocks.len() {
            let blk: IrBlock = f.blocks[bi];
            let mut ii: u64 = 0;
            while ii < blk.insts.len() {
                let inst: IrInst = blk.insts[ii];
                if inst.op == IOP_UPSILON() && inst.args.len() == 1 && flags[inst.args[0] as u64] == 1 && flags[inst.dv as u64] != 1 {
                    flags[inst.dv as u64] = 1;
                    changed = true;
                }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
    }
}

// 1 for every value that is, or merges through a Phi, a parameter object.
fn vc_heap_param_table(f: IrFunction, n_ids: u64) -> Vec<i64> {
    let param: Vec<i64> = dom_fill(n_ids, 0);
    let mut bi: u64 = 0;
    while bi < f.blocks.len() {
        let blk: IrBlock = f.blocks[bi];
        let mut ii: u64 = 0;
        while ii < blk.insts.len() {
            let inst: IrInst = blk.insts[ii];
            if inst.id >= 0 && inst.op == IOP_GET_ARG() && inst.ty == ITY_PTR() { param[inst.id as u64] = 1; }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    vc_heap_close_over_phis(f, param);
    param
}

// True when the function reads memory through a handle and also writes a
// parameter (`FieldSet` on a struct parameter, or a mutating `Vec` or `String`
// operation on a `Vec` or `String` parameter). A parameter may be the very object a
// handle names (`q.child` is `p`), so such a function is modelled with the
// parameters' own state laid over the arrays (`vc_overlay`); any other function reads
// the arrays alone. A fresh object cannot be at a handle the function loaded, so
// building and mutating one never needs it. `tys` is the type of every value
// (`vc_ty_table`).
fn vc_heap_overlay_needed(f: IrFunction, tys: Vec<i64>) -> bool {
    let mut reads: bool = false;
    let mut bi: u64 = 0;
    while bi < f.blocks.len() {
        let blk: IrBlock = f.blocks[bi];
        let mut ii: u64 = 0;
        while ii < blk.insts.len() {
            if vc_heap_is_read(blk.insts[ii], tys) { reads = true; }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    if !reads { return false; }
    let param: Vec<i64> = vc_heap_param_table(f, tys.len());
    bi = 0;
    while bi < f.blocks.len() {
        let blk: IrBlock = f.blocks[bi];
        let mut ii: u64 = 0;
        while ii < blk.insts.len() {
            let inst: IrInst = blk.insts[ii];
            if inst.op == IOP_FIELD_SET() && param[inst.args[0] as u64] == 1 { return true; }
            if inst.op == IOP_CALL() && inst.args.len() > 0 && vc_vec_kind_mutates(vc_inst_vec_kind(inst)) && param[inst.args[0] as u64] == 1 {
                return true;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    false
}

// Gate rule for a pointer written into a field (`SortedLocalNames { ids: a, names: b }`).
// The model keeps no object in a field, so the write has no effect on any read and
// is only admitted when nothing reads the field back: the target must be an
// allocation, and no `FieldGet` may read an allocation that received a pointer
// (directly or through a Phi). "" when every pointer write is such, else the
// detail of an `unsupported-opcode` skip.
fn vc_heap_store_detail(f: IrFunction, tys: Vec<i64>) -> String {
    let n_ids: u64 = tys.len();
    let def_op: Vec<i64> = dom_fill(n_ids, -1);
    let held: Vec<i64> = dom_fill(n_ids, 0);
    let mut any: bool = false;
    let mut bi: u64 = 0;
    while bi < f.blocks.len() {
        let blk: IrBlock = f.blocks[bi];
        let mut ii: u64 = 0;
        while ii < blk.insts.len() {
            let inst: IrInst = blk.insts[ii];
            if inst.id >= 0 { def_op[inst.id as u64] = inst.op; }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    bi = 0;
    while bi < f.blocks.len() {
        let blk: IrBlock = f.blocks[bi];
        let mut ii: u64 = 0;
        while ii < blk.insts.len() {
            let inst: IrInst = blk.insts[ii];
            if inst.op == IOP_FIELD_SET() && inst.args.len() == 2 && vc_heap_ty(tys, inst.args[1]) == ITY_PTR() {
                if def_op[inst.args[0] as u64] != IOP_REGION_ALLOC() {
                    return String::from("pointer written into a field of a value that is not an allocation");
                }
                held[inst.args[0] as u64] = 1;
                any = true;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    if !any { return String::from(""); }
    vc_heap_close_over_phis(f, held);
    bi = 0;
    while bi < f.blocks.len() {
        let blk: IrBlock = f.blocks[bi];
        let mut ii: u64 = 0;
        while ii < blk.insts.len() {
            let inst: IrInst = blk.insts[ii];
            if inst.op == IOP_FIELD_GET() && inst.args.len() == 1 && held[inst.args[0] as u64] == 1 {
                return String::from("a field that holds a pointer is read back");
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    String::from("")
}
