module VcSession

use vc_term
use vc_smt
use vc_exec
use vc_solver

// One interactive Bitwuzla process answering the claims of a verification
// round in order. Claim `k`'s query is the first `header_lens[k]` header
// commands, the first `assumed_lens[k]` assumptions and its negated goal
// (`vc_claim_script`); both lists are append-only, so a session sends each
// command once, at base level, and asks the negated goal inside a
// `push`/`pop` scope. Claim `k`'s answer is delimited by an `(echo "vow-k")`
// sentinel: a reply that is not exactly `<verdict>` then the sentinel is a
// desynchronised solver and ends the session. Nothing here decides a verdict
// on its own: a session answer is `VC_ANS_NONE` unless the reply is
// well-formed, and the caller re-decides anything but `unsat` (and a soft
// `sat`) with a standalone query, so counterexample models never come from it.
//
// A session never asks a claim whose prefix holds a quantifier binder (the `String`
// model's `VC_T_QEQ`, `VC_T_QLT`, `VC_T_QDIFF`; `binder_at` is the index of the first
// such assumption, -1 for none). Bitwuzla decides a scoped check under a quantifier
// far slower than the same query asked once (hundreds of milliseconds against a few
// for a `String` append), the session's `sat` on a hard claim is discarded for the
// standalone query anyway, and its `unsat` is as cheap standalone. Those claims go
// straight to the standalone path.
//
// The last claim of a round that needs a solver (`last_at`, -1 for none) is the
// one claim a session cannot help afterwards: nothing follows it to reuse what the
// solver learnt, and a `sat` on a hard claim is thrown away for the standalone
// query. On a query it rewrites as it is asserted an incremental solver can need
// about twice what a fresh one does (0.17 s against 0.09 s for the digit formatter
// of `int_to_string`), yet on another (64-bit division, where it reuses the
// circuits of the claims before) it answers sooner. That claim is therefore
// hedged rather than predicted: the session gets `vc_session_hedge_window_ms`,
// and a reply that has not come by then is left outstanding while the caller asks
// a fresh process the same query (`vc_session_ask_hedged`, `vc_session_collect`).

struct VcSession {
    handle: i64,
    live: bool,
    sent_hdr: u64,
    sent_assumed: u64,
    binder_at: i64,
    last_at: i64,
    pending: Vec<String>,
}

// `live` false makes every ask `VC_ANS_NONE` without starting a process.
fn vc_session_new(live: bool, binder_at: i64) -> VcSession {
    VcSession { handle: -1, live: live, sent_hdr: 0, sent_assumed: 0, binder_at: binder_at, last_at: -1, pending: Vec::new() }
}

// A reply that has not arrived yet (see `vc_session_ask_hedged`).
fn VC_SESSION_PENDING() -> i64 { 8 }

// How long the session may take over the last claim that needs a solver before a
// fresh process is asked the same query alongside it: a few times what starting
// one costs, so a claim the session settles at once never pays for a second
// process.
fn vc_session_hedge_window_ms() -> i64 {
    10
}

// True when claim `k` is the one the session hedges: the last claim of its round
// that needs a solver (`last_at`, -1 for none), which the session may ask.
fn vc_session_hedges(ss: VcSession, cs: VcClaims, k: u64) -> bool {
    ss.live && ss.last_at == k as i64 && vc_session_admits(ss.binder_at, cs, k)
}

// True when claim `k`'s query is free of quantifier binders, so a session may ask it.
fn vc_session_admits(binder_at: i64, cs: VcClaims, k: u64) -> bool {
    binder_at < 0 || cs.assumed_lens[k] <= binder_at
}

fn vc_session_probe_sentinel() -> String {
    String::from("\"vow-open\"")
}

// `"vow-<k>"`, quotes included, as `(echo "vow-<k>")` prints it.
fn vc_session_sentinel(k: u64) -> String {
    let out: String = String::from("\"vow-");
    out.push_str(i64_to_string(k as i64));
    out.push_str(String::from("\""));
    out
}

// The scoped question for claim `k`.
fn vc_session_frame(cs: VcClaims, k: u64) -> String {
    let out: String = String::from("(push 1)\n");
    vc_smt_push_assert(out, cs.arena, cs.negated_goals[k]);
    out.push_str(String::from("\n(check-sat)\n(echo "));
    out.push_str(vc_session_sentinel(k));
    out.push_str(String::from(")\n(pop 1)\n"));
    out
}

// `lines` are the trimmed stdout lines of one reply. The verdict only when the
// reply is exactly `<verdict>` followed by claim `k`'s sentinel; anything
// else, an `(error ...)` text included, is `VC_ANS_NONE`.
fn vc_session_classify(lines: Vec<String>, k: u64) -> i64 {
    if lines.len() != 2 { return VC_ANS_NONE(); }
    if lines[1] != vc_session_sentinel(k) { return VC_ANS_NONE(); }
    if lines[0] == String::from("unsat") { return VC_ANS_UNSAT(); }
    if lines[0] == String::from("sat") { return VC_ANS_SAT(); }
    if lines[0] == String::from("unknown") { return VC_ANS_UNKNOWN(); }
    VC_ANS_NONE()
}

// Ends the session and reaps the process. Safe to call more than once.
fn vc_session_close(ss: VcSession) [io] {
    ss.live = false;
    if ss.handle >= 0 {
        process_close_stdin(ss.handle);
        process_kill(ss.handle);
        ss.handle = -1;
    }
}

// Reads stdout lines until `sentinel`, the solver's end of file or `deadline_us`
// (a `time_micros` instant), at most `limit` lines. The trimmed lines read,
// the sentinel last when it arrived.
fn vc_session_read_until(handle: i64, sentinel: String, deadline_us: i64, limit: u64) -> Vec<String> [io] {
    let lines: Vec<String> = Vec::new();
    while lines.len() < limit {
        let left_ms: i64 = (deadline_us - time_micros()) / 1000;
        if left_ms <= 0 { return lines; }
        let raw: String = process_read_line(handle, left_ms);
        if process_read_status(handle) != 0 { return lines; }
        let line: String = str_trim(raw);
        lines.push(line);
        if line == sentinel { return lines; }
    }
    lines
}

// Starts the process on the first ask: the header up to claim `k`'s, then a
// scope round trip. A solver without `push`/`pop` or `echo` support prints an
// error and exits, which shows as end of file here.
fn vc_session_start(ss: VcSession, bin: String, cs: VcClaims, k: u64, deadline_us: i64) -> bool [io] {
    let hello: String = vc_claim_header_text(cs, k);
    let handle: i64 = process_start_piped(bin, vc_solver_stdin_args(hello));
    if handle < 0 { return false; }
    ss.handle = handle;
    hello.push_str(String::from("(push 1)\n(pop 1)\n(echo "));
    hello.push_str(vc_session_probe_sentinel());
    hello.push_str(String::from(")\n"));
    if process_write_stdin(handle, hello) != 0 { return false; }
    let lines: Vec<String> = vc_session_read_until(handle, vc_session_probe_sentinel(), deadline_us, 2);
    if lines.len() != 1 || lines[0] != vc_session_probe_sentinel() { return false; }
    ss.sent_hdr = cs.header_lens[k] as u64;
    true
}

// Sends claim `k`'s question, starting the process first when there is none (its
// handshake is read until `deadline_us`). False when the session cannot be used;
// it is then closed.
fn vc_session_send(ss: VcSession, bin: String, cs: VcClaims, k: u64, deadline_us: i64) -> bool [io] {
    if ss.handle < 0 {
        if !vc_session_start(ss, bin, cs, k, deadline_us) {
            vc_session_close(ss);
            return false;
        }
    }
    let query: String = vc_claim_context_delta(cs, k, ss.sent_hdr, ss.sent_assumed);
    query.push_str(vc_session_frame(cs, k));
    if process_write_stdin(ss.handle, query) != 0 {
        vc_session_close(ss);
        return false;
    }
    ss.sent_hdr = cs.header_lens[k] as u64;
    ss.sent_assumed = cs.assumed_lens[k] as u64;
    ss.pending = Vec::new();
    true
}

// Reads claim `k`'s reply into `ss.pending` until `deadline_us`. The verdict once
// the sentinel has arrived in a well-formed reply; `VC_SESSION_PENDING` when the
// reply is incomplete and the solver is alive, in which case a later call
// continues where this one stopped (`process_read_line` keeps a partial line);
// `VC_ANS_NONE` for anything else (end of file, a stray line), which closes the
// session.
fn vc_session_collect(ss: VcSession, k: u64, deadline_us: i64) -> i64 [io] {
    let sentinel: String = vc_session_sentinel(k);
    let pend: Vec<String> = ss.pending;
    while pend.len() < 3 {
        let left_ms: i64 = (deadline_us - time_micros()) / 1000;
        if left_ms <= 0 { return VC_SESSION_PENDING(); }
        let raw: String = process_read_line(ss.handle, left_ms);
        let status: i64 = process_read_status(ss.handle);
        if status == 2 { return VC_SESSION_PENDING(); }
        if status != 0 {
            vc_session_close(ss);
            return VC_ANS_NONE();
        }
        let line: String = str_trim(raw);
        pend.push(line);
        if line == sentinel {
            let verdict: i64 = vc_session_classify(pend, k);
            if verdict == VC_ANS_NONE() { vc_session_close(ss); }
            return verdict;
        }
    }
    vc_session_close(ss);
    VC_ANS_NONE()
}

// Asks claim `k` of `cs`, waiting at most `wait_ms`. `VC_ANS_SAT`, `UNSAT` or
// `UNKNOWN` only from a well-formed reply; every failure (no process, write
// error, end of file, timeout, a stray line) is `VC_ANS_NONE` and kills the
// session, so no later ask can read a stale reply. `bin` is the solver path.
fn vc_session_ask(ss: VcSession, bin: String, cs: VcClaims, k: u64, wait_ms: i64) -> i64 [io] {
    if !ss.live || wait_ms <= 0 { return VC_ANS_NONE(); }
    if !vc_session_admits(ss.binder_at, cs, k) { return VC_ANS_NONE(); }
    let deadline_us: i64 = time_micros() + wait_ms * 1000;
    if !vc_session_send(ss, bin, cs, k, deadline_us) { return VC_ANS_NONE(); }
    let verdict: i64 = vc_session_collect(ss, k, deadline_us);
    if verdict == VC_SESSION_PENDING() {
        vc_session_close(ss);
        return VC_ANS_NONE();
    }
    verdict
}

// `vc_session_ask` for the hedged claim: the reply is waited for `window_ms` only
// (the process start and its handshake may take up to `wait_ms`), and one that
// has not arrived by then is `VC_SESSION_PENDING` with the session left alive and
// the question outstanding. The caller either keeps collecting it with
// `vc_session_collect` or closes the session.
fn vc_session_ask_hedged(ss: VcSession, bin: String, cs: VcClaims, k: u64, wait_ms: i64, window_ms: i64) -> i64 [io] {
    if !ss.live || wait_ms <= 0 { return VC_ANS_NONE(); }
    if !vc_session_admits(ss.binder_at, cs, k) { return VC_ANS_NONE(); }
    let deadline_us: i64 = time_micros() + wait_ms * 1000;
    if !vc_session_send(ss, bin, cs, k, deadline_us) { return VC_ANS_NONE(); }
    let mut until_us: i64 = time_micros() + window_ms * 1000;
    if until_us > deadline_us { until_us = deadline_us; }
    vc_session_collect(ss, k, until_us)
}
