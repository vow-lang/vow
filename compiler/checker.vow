module Checker

use ast
use types
use env
use ir

fn primitive_tid(ts: TyStore, name: String) -> i64 {
    if name == String::from("i8") { return CTY_I8(); }
    if name == String::from("i16") { return CTY_I16(); }
    if name == String::from("i32") { return CTY_I32(); }
    if name == String::from("i64") { return CTY_I64(); }
    if name == String::from("i128") { return CTY_I128(); }
    if name == String::from("u8") { return CTY_U8(); }
    if name == String::from("u16") { return CTY_U16(); }
    if name == String::from("u32") { return CTY_U32(); }
    if name == String::from("u64") { return CTY_U64(); }
    if name == String::from("u128") { return CTY_U128(); }
    if name == String::from("f32") { return CTY_F32(); }
    if name == String::from("f64") { return CTY_F64(); }
    if name == String::from("bool") { return CTY_BOOL(); }
    if name == String::from("String") { return CTY_STR(); }
    if name == String::from("str") { return CTY_STR(); }
    -1
}

fn linear_visited_has(v: Vec<i64>, key: i64) -> i64 {
    let n: u64 = v.len();
    let mut i: u64 = 0u64;
    while i < n {
        if v[i] == key {
            return 1;
        }
        i = i + 1;
    }
    0
}

// Render a type for the `found '...'` part of a BTreeMap diagnostic. Nominal
// types print their name (e.g. 'Token'), matching the Rust compiler's
// `{val_ty}` output and the example in docs/spec/errors.md; other types print
// their tag category.
fn ty_value_display_name(ts: TyStore, tid: i64) -> String {
    let tag: i64 = ty_tag(ts, tid);
    if tag == CTY_STRUCT() || tag == CTY_ENUM() {
        return ty_struct_name(ts, tid);
    }
    ty_tag_name(tag)
}

// The full user-facing spelling of a type, identical to Rust `Ty::user_name`:
// `String`, `HashMap<i64, i64>`, `&T`, `(i64, i64)`, `!`. Diagnostics that name
// a type use it so both compilers print the same text. The applied case copies
// the base name before appending: `ty_struct_name` returns the interned string
// itself, and pushing onto it would corrupt the type store.
fn ty_full_display_name(ts: TyStore, tid: i64) -> String {
    let tag: i64 = ty_tag(ts, tid);
    if tag == CTY_APPLIED() {
        let out: String = String::from(ty_full_display_name(ts, ty_a(ts, tid)));
        out.push_str(String::from("<"));
        let args_lid: i64 = ty_b(ts, tid);
        let n: i64 = ts_arg_len(ts, args_lid);
        let mut i: i64 = 0;
        while i < n {
            if i > 0 { out.push_str(String::from(", ")); }
            out.push_str(ty_full_display_name(ts, ts_arg_get(ts, args_lid, i)));
            i = i + 1;
        }
        out.push_str(String::from(">"));
        return out;
    }
    if tag == CTY_REF() {
        let out: String = String::from("&");
        out.push_str(ty_full_display_name(ts, ty_a(ts, tid)));
        return out;
    }
    if tag == CTY_TUPLE() {
        let out: String = String::from("(");
        let elems_lid: i64 = ty_a(ts, tid);
        let n: i64 = ts_arg_len(ts, elems_lid);
        let mut i: i64 = 0;
        while i < n {
            if i > 0 { out.push_str(String::from(", ")); }
            out.push_str(ty_full_display_name(ts, ts_arg_get(ts, elems_lid, i)));
            i = i + 1;
        }
        out.push_str(String::from(")"));
        return out;
    }
    if tag == CTY_NEVER() { return String::from("!"); }
    ty_value_display_name(ts, tid)
}

// True for the base of a built-in collection type. Collections never count as
// linear themselves: the rule is enforced at the collection that holds the
// linear value, so one written site is reported once.
fn is_collection_base(e: CheckEnv, base: i64) -> bool {
    let btag: i64 = ty_tag(e.ts, base);
    if btag != CTY_STRUCT() && btag != CTY_ENUM() {
        return false;
    }
    let name: String = ty_struct_name(e.ts, base);
    name == String::from("Vec") || name == String::from("HashMap") || name == String::from("BTreeMap")
}

// Returns 1 if `tid` is or transitively contains a linear struct.
// Mirrors vow-types/src/check.rs::is_linear_ty. Looks through references and
// tuples. Used to gate map values and tuple destructuring: bitwise shift/copy
// in the runtime/verifier would silently duplicate a linear obligation. A
// collection never counts as linear itself; the collection rules fire where
// the collection is written. Vec elements use is_linear_vec_element (owner
// semantics) instead.
fn is_linear_ty(e: CheckEnv, tid: i64) -> i64 {
    let visited: Vec<i64> = Vec::new();
    is_linear_ty_rec(e, tid, visited)
}

// `visited` records nominal types (structs keyed sidx*2, enums eidx*2+1)
// already on the current walk so a recursive type (e.g. `struct Node { kids:
// Vec<Node> }`) terminates instead of overflowing the stack. A cycle edge
// contributes no new linearity, so re-entry resolves to 0.
fn is_linear_ty_rec(e: CheckEnv, tid: i64, visited: Vec<i64>) -> i64 {
    let tag: i64 = ty_tag(e.ts, tid);
    if tag == CTY_STRUCT() {
        let name: String = ty_struct_name(e.ts, tid);
        if env_struct_is_linear(e, name) == 1 {
            return 1;
        }
        let sidx: i64 = env_lookup_struct(e, name);
        if sidx == -1 {
            return 0;
        }
        let skey: i64 = sidx * 2;
        if linear_visited_has(visited, skey) == 1 {
            return 0;
        }
        visited.push(skey);
        let nf: i64 = e.sdef_field_count[sidx as u64];
        let tid_lid: i64 = e.sdef_field_tid_lids[sidx as u64];
        let mut i: i64 = 0;
        while i < nf {
            let ftid: i64 = ts_arg_get(e.ts, tid_lid, i);
            if is_linear_ty_rec(e, ftid, visited) == 1 {
                return 1;
            }
            i = i + 1;
        }
        return 0;
    }
    if tag == CTY_ENUM() {
        let ename: String = ty_struct_name(e.ts, tid);
        let eidx: i64 = env_lookup_enum(e, ename);
        if eidx == -1 {
            return 0;
        }
        let ekey: i64 = eidx * 2 + 1;
        if linear_visited_has(visited, ekey) == 1 {
            return 0;
        }
        visited.push(ekey);
        let nv: i64 = e.edef_variant_count[eidx as u64];
        let vpayload_lid: i64 = e.edef_vpayload_lids[eidx as u64];
        let mut vi: i64 = 0;
        while vi < nv {
            let payload_lid: i64 = ts_arg_get(e.ts, vpayload_lid, vi);
            let pn: i64 = ts_arg_len(e.ts, payload_lid);
            let mut pi: i64 = 0;
            while pi < pn {
                let ptid: i64 = ts_arg_get(e.ts, payload_lid, pi);
                if is_linear_ty_rec(e, ptid, visited) == 1 {
                    return 1;
                }
                pi = pi + 1;
            }
            vi = vi + 1;
        }
        return 0;
    }
    if tag == CTY_APPLIED() {
        let base: i64 = ty_a(e.ts, tid);
        if is_collection_base(e, base) {
            return 0;
        }
        if is_linear_ty_rec(e, base, visited) == 1 {
            return 1;
        }
        let lid: i64 = ty_b(e.ts, tid);
        let n: i64 = ts_arg_len(e.ts, lid);
        let mut i: i64 = 0;
        while i < n {
            let arg_tid: i64 = ts_arg_get(e.ts, lid, i);
            if is_linear_ty_rec(e, arg_tid, visited) == 1 {
                return 1;
            }
            i = i + 1;
        }
        return 0;
    }
    if tag == CTY_TUPLE() {
        let lid: i64 = ty_a(e.ts, tid);
        let n: i64 = ts_arg_len(e.ts, lid);
        let mut i: i64 = 0;
        while i < n {
            let elem_tid: i64 = ts_arg_get(e.ts, lid, i);
            if is_linear_ty_rec(e, elem_tid, visited) == 1 {
                return 1;
            }
            i = i + 1;
        }
        return 0;
    }
    if tag == CTY_REF() {
        return is_linear_ty_rec(e, ty_a(e.ts, tid), visited);
    }
    0
}

// Returns 1 only when `tid` owns a linear obligation. Enum-like wrappers
// inherit ownership from owned payloads; references remain borrows and
// collections do not become linear merely because an element type is linear.
fn is_linear_owner_ty(e: CheckEnv, tid: i64) -> i64 {
    let visited: Vec<i64> = Vec::new();
    is_linear_owner_ty_rec(e, tid, visited)
}

fn is_linear_owner_ty_rec(e: CheckEnv, tid: i64, visited: Vec<i64>) -> i64 {
    let tag: i64 = ty_tag(e.ts, tid);
    if tag == CTY_STRUCT() {
        return env_struct_is_linear(e, ty_struct_name(e.ts, tid));
    }
    if tag == CTY_ENUM() {
        let name: String = ty_struct_name(e.ts, tid);
        let eidx: i64 = env_lookup_enum(e, name);
        if eidx == -1 {
            return 0;
        }
        let key: i64 = eidx * 2 + 1;
        if linear_visited_has(visited, key) == 1 {
            return 0;
        }
        visited.push(key);
        let nv: i64 = e.edef_variant_count[eidx as u64];
        let payloads_lid: i64 = e.edef_vpayload_lids[eidx as u64];
        let mut vi: i64 = 0;
        while vi < nv {
            let payload_lid: i64 = ts_arg_get(e.ts, payloads_lid, vi);
            let mut pi: i64 = 0;
            while pi < ts_arg_len(e.ts, payload_lid) {
                if is_linear_owner_ty_rec(e, ts_arg_get(e.ts, payload_lid, pi), visited) == 1 {
                    visited.pop();
                    return 1;
                }
                pi = pi + 1;
            }
            vi = vi + 1;
        }
        visited.pop();
        return 0;
    }
    if tag == CTY_APPLIED() {
        let base: i64 = ty_a(e.ts, tid);
        if ty_tag(e.ts, base) != CTY_ENUM() {
            return 0;
        }
        let name: String = ty_struct_name(e.ts, base);
        if name != String::from("Option") && name != String::from("Result") && env_lookup_enum(e, name) == -1 {
            return 0;
        }
        if is_linear_owner_ty_rec(e, base, visited) == 1 {
            return 1;
        }
        let args_lid: i64 = ty_b(e.ts, tid);
        let mut ai: i64 = 0;
        while ai < ts_arg_len(e.ts, args_lid) {
            if is_linear_owner_ty_rec(e, ts_arg_get(e.ts, args_lid, ai), visited) == 1 {
                return 1;
            }
            ai = ai + 1;
        }
    }
    0
}

// A Vec element is rejected when it owns a linear obligation: a linear struct,
// an enum-like wrapper around one, or a tuple holding one. References borrow,
// so Vec<&Token> is fine. Mirrors Rust `is_linear_vec_element`.
fn is_linear_vec_element(e: CheckEnv, tid: i64) -> i64 {
    if ty_tag(e.ts, tid) == CTY_TUPLE() {
        let lid: i64 = ty_a(e.ts, tid);
        let n: i64 = ts_arg_len(e.ts, lid);
        let mut i: i64 = 0;
        while i < n {
            if is_linear_vec_element(e, ts_arg_get(e.ts, lid, i)) == 1 {
                return 1;
            }
            i = i + 1;
        }
        return 0;
    }
    is_linear_owner_ty(e, tid)
}

fn resolve_ast_ty(e: CheckEnv, m: Module, ast_tid: i64) -> i64 [io] {
    if ast_tid == -1 {
        return CTY_UNIT();
    }
    let a: AstArena = m.arena;
    let tag: i64 = type_tag(a, ast_tid);
    if tag == TY_UNIT() {
        return CTY_UNIT();
    }
    if tag == TY_NEVER() {
        return CTY_NEVER();
    }
    if tag == TY_NAMED() {
        let name_sid: i64 = type_a(a, ast_tid);
        let name: String = arena_str(a, name_sid);
        let ptid: i64 = primitive_tid(e.ts, name);
        if ptid != -1 {
            return ptid;
        }
        let sidx: i64 = env_lookup_struct(e, name);
        if sidx != -1 {
            return ts_make_struct(e.ts, name);
        }
        let eidx: i64 = env_lookup_enum(e, name);
        if eidx != -1 {
            return ts_make_enum(e.ts, name);
        }
        let alias_tid: i64 = env_lookup_alias(e, name);
        if alias_tid != -1 {
            return alias_tid;
        }
        let err_msg: String = String::from("unknown type: ");
        err_msg.push_str(name);
        env_emit_error(e, err_msg, type_span(a, ast_tid));
        return CTY_UNKNOWN();
    }
    if tag == TY_GENERIC() {
        let name_sid: i64 = type_a(a, ast_tid);
        let name: String = arena_str(a, name_sid);
        let args_lid: i64 = type_b(a, ast_tid);
        let n: i64 = list_len(a, args_lid);
        let arg_tids: Vec<i64> = Vec::new();
        let mut i: i64 = 0;
        while i < n {
            let arg_ast_tid: i64 = list_get(a, args_lid, i);
            arg_tids.push(resolve_ast_ty(e, m, arg_ast_tid));
            i = i + 1;
        }
        if name == String::from("Option") {
            if arg_tids.len() == 1 {
                return ts_make_applied(e.ts, ts_make_enum(e.ts, name), arg_tids);
            }
            env_emit_error_code(e, EC_TYPE_MISMATCH(),
                String::from("Option requires one type argument"),
                type_span(a, ast_tid));
            return CTY_UNKNOWN();
        }
        if name == String::from("Result") {
            if arg_tids.len() == 2 {
                return ts_make_applied(e.ts, ts_make_enum(e.ts, name), arg_tids);
            }
            env_emit_error_code(e, EC_TYPE_MISMATCH(),
                String::from("Result requires two type arguments"),
                type_span(a, ast_tid));
            return CTY_UNKNOWN();
        }
        let base_ptid: i64 = primitive_tid(e.ts, name);
        if base_ptid != -1 {
            return ts_make_applied(e.ts, base_ptid, arg_tids);
        }
        if name == String::from("Vec") {
            if arg_tids.len() > 0 {
                check_vec_element_type(e, arg_tids[0], type_span(a, ast_tid));
            }
            return ts_make_applied(e.ts, ts_make_enum(e.ts, name), arg_tids);
        }
        if name == String::from("Option") {
            if arg_tids.len() != 1 {
                env_emit_error_code(e, EC_TYPE_MISMATCH(),
                    String::from("Option requires one type argument"),
                    type_span(a, ast_tid));
            }
            return ts_make_applied(e.ts, ts_make_enum(e.ts, name), arg_tids);
        }
        if name == String::from("Result") {
            if arg_tids.len() != 2 {
                env_emit_error_code(e, EC_TYPE_MISMATCH(),
                    String::from("Result requires two type arguments"),
                    type_span(a, ast_tid));
            }
            return ts_make_applied(e.ts, ts_make_enum(e.ts, name), arg_tids);
        }
        if name == String::from("HashMap") || name == String::from("BTreeMap") {
            // Mirrors Rust env.rs: BTreeMap requires exactly two type arguments;
            // every per-map key/value rule lives in check_map_slot_types.
            if name == String::from("BTreeMap") && arg_tids.len() != 2 {
                env_emit_error_code(e, EC_TYPE_MISMATCH(),
                    String::from("BTreeMap requires two type arguments"),
                    type_span(a, ast_tid));
            } else {
                let mkey_tid: i64 = if arg_tids.len() > 0 { arg_tids[0] } else { -1 };
                let mval_tid: i64 = if arg_tids.len() > 1 { arg_tids[1] } else { -1 };
                check_map_slot_types(e, name, mkey_tid, mval_tid, type_span(a, ast_tid));
            }
            return ts_make_applied(e.ts, ts_make_struct(e.ts, name), arg_tids);
        }
        let sidx: i64 = env_lookup_struct(e, name);
        if sidx != -1 {
            return ts_make_applied(e.ts, ts_make_struct(e.ts, name), arg_tids);
        }
        let eidx: i64 = env_lookup_enum(e, name);
        if eidx != -1 {
            return ts_make_applied(e.ts, ts_make_enum(e.ts, name), arg_tids);
        }
        return CTY_UNKNOWN();
    }
    if tag == TY_REF() {
        let inner: i64 = resolve_ast_ty(e, m, type_a(a, ast_tid));
        return ty_add(e.ts, CTY_REF(), inner, 0);
    }
    if tag == TY_SLICE() {
        // `[T]` has no constructor, no indexing and no iteration, so no value of
        // that type can exist. The error is the point; the Slice<T> shape only
        // keeps the cascade identical to the Rust resolver.
        env_emit_error_code_hint(e, EC_UNSUPPORTED_FEATURE(),
            String::from("slice types (`[T]`) are not supported in Vow"),
            type_span(a, ast_tid),
            String::from("use `Vec<T>` to hold a sequence of values"));
        let elem_tids: Vec<i64> = Vec::new();
        elem_tids.push(resolve_ast_ty(e, m, type_a(a, ast_tid)));
        return ts_make_applied(e.ts, ts_make_struct(e.ts, String::from("Slice")), elem_tids);
    }
    if tag == TY_TUPLE() {
        let elems_lid: i64 = type_a(a, ast_tid);
        let n: i64 = list_len(a, elems_lid);
        let elem_tids: Vec<i64> = Vec::new();
        let mut i: i64 = 0;
        while i < n {
            elem_tids.push(resolve_ast_ty(e, m, list_get(a, elems_lid, i)));
            i = i + 1;
        }
        let lid: i64 = ts_add_args(e.ts, elem_tids);
        return ty_add(e.ts, CTY_TUPLE(), lid, 0);
    }
    // Every parser-built tag is handled above. An unhandled tag must never
    // degrade to the unit type: that silently turns an unresolved annotation
    // into `()` and surfaces later as an unrelated error (or none at all).
    let tag_msg: String = String::from("unsupported type form (internal AST type tag ");
    tag_msg.push_str(i64_to_string(tag));
    tag_msg.push_str(String::from(")"));
    env_emit_error_code(e, EC_UNSUPPORTED_FEATURE(), tag_msg, type_span(a, ast_tid));
    CTY_UNKNOWN()
}

fn hashmap_key_tag_supported(tag: i64) -> bool {
    (tag >= CTY_I8() && tag <= CTY_U64() && tag != CTY_I128())
        || tag == CTY_BOOL()
        || tag == CTY_NEVER()
        || tag == CTY_UNKNOWN()
}

// The one place every per-map rule lives, for a single `HashMap`/`BTreeMap`
// type. Diagnostics are emitted in this order: key, linear value, wide value.
// A BTreeMap key must be i64 and a linear BTreeMap value uses the dedicated
// BTreeMap codes; the runtime stores every other key and value in one 64-bit
// slot, so a HashMap key that is not a by-value scalar (<= 64-bit integer or
// bool), a linear HashMap value (copied bitwise), and a 128-bit or float value
// in either map are UnsupportedFeature. A tid of -1 means the type argument is
// absent. Mirrors Rust `check_map_slot_types`.
fn check_map_slot_types(e: CheckEnv, name: String, key_tid: i64, val_tid: i64, span: i64) {
    let is_btree: bool = name == String::from("BTreeMap");
    if key_tid >= 0 {
        let ktag: i64 = ty_tag(e.ts, key_tid);
        if is_btree {
            if ktag != CTY_I64() && ktag != CTY_NEVER() {
                let kerr: String = String::from("BTreeMap key type must be i64; found '");
                kerr.push_str(ty_full_display_name(e.ts, key_tid));
                kerr.push_str(String::from("'"));
                env_emit_error_code(e, EC_BTREEMAP_KEY_TYPE_MUST_BE_I64(), kerr, span);
            }
        } else if !hashmap_key_tag_supported(ktag) {
            let kmsg: String = String::from("HashMap key type `");
            kmsg.push_str(ty_full_display_name(e.ts, key_tid));
            kmsg.push_str(String::from("` is not supported: keys are compared by value as a single machine word"));
            env_emit_error_code_hint(
                e, EC_UNSUPPORTED_FEATURE(), kmsg, span,
                String::from("use an integer type of at most 64 bits or `bool` as the key; hash or intern other keys to `u64` at the call site and keep a side table for the originals")
            );
        }
    }
    if val_tid < 0 { return; }
    if !e.defer_map_linear && is_linear_ty(e, val_tid) == 1 {
        emit_map_linear_value_error(e, name, val_tid, span);
    }
    let vtag: i64 = ty_tag(e.ts, val_tid);
    if vtag == CTY_I128() || vtag == CTY_U128() || vtag == CTY_F32() || vtag == CTY_F64() {
        let vmsg: String = String::from(name);
        vmsg.push_str(String::from(" value type `"));
        vmsg.push_str(ty_full_display_name(e.ts, val_tid));
        vmsg.push_str(String::from("` is not supported: map values occupy a single 64-bit integer slot"));
        env_emit_error_code_hint(
            e, EC_UNSUPPORTED_FEATURE(), vmsg, span,
            String::from("keep a 128-bit value as two `u64` halves under separate keys or in two maps; floats cannot be map values")
        );
    }
}

// A Vec copies and shifts elements bitwise, so an element that owns a linear
// obligation would be duplicated. Deferred while definitions are still being
// registered; recheck_tid_map_linearity re-runs the rule afterwards. Mirrors
// Rust `check_vec_element_ty`.
fn check_vec_element_type(e: CheckEnv, elem_tid: i64, span: i64) {
    if !e.defer_map_linear && is_linear_vec_element(e, elem_tid) == 1 {
        emit_vec_linear_element_error(e, elem_tid, span);
    }
}

// The linear-element diagnostic shared by the first-pass Vec check and the
// post-definition re-check.
fn emit_vec_linear_element_error(e: CheckEnv, elem_tid: i64, span: i64) {
    let msg: String = String::from("Vec element type must be non-linear; found '");
    msg.push_str(ty_full_display_name(e.ts, elem_tid));
    msg.push_str(String::from("'"));
    env_emit_error_code_hint(
        e, EC_UNSUPPORTED_FEATURE(), msg, span,
        String::from("a Vec copies and shifts elements bitwise, so a linear element would be duplicated; keep the value in a local binding and store an integer handle instead")
    );
}

// The linear-value diagnostic shared by the first-pass map check and the
// post-definition re-check: BTreeMap uses its dedicated code, HashMap
// UnsupportedFeature.
fn emit_map_linear_value_error(e: CheckEnv, name: String, val_tid: i64, span: i64) {
    let msg: String = String::from(name);
    msg.push_str(String::from(" value type must be non-linear; found '"));
    msg.push_str(ty_full_display_name(e.ts, val_tid));
    msg.push_str(String::from("'"));
    let code: i64 = if name == String::from("BTreeMap") {
        EC_BTREEMAP_VALUE_MUST_BE_NON_LINEAR()
    } else {
        EC_UNSUPPORTED_FEATURE()
    };
    env_emit_error_code_hint(
        e, code, msg, span,
        String::from("the map copies values bitwise, so a linear value would be duplicated; keep it in a local binding and store an integer handle instead")
    );
}

fn is_opaque(tid: i64) -> bool vow {
    requires: tid >= 0
} {
    tid == CTY_NEVER() || tid == CTY_UNKNOWN()
}

// CTY_UNKNOWN is the marker for an expression that already failed type
// checking; every later check absorbs it so one mistake yields one
// diagnostic. CTY_NEVER is a different thing: the bottom type of
// `Option::None`, `Vec::new()` and diverging expressions.
fn is_unknown(tid: i64) -> bool vow {
    requires: tid >= 0
} {
    tid == CTY_UNKNOWN()
}

// The bottom type coerces to everything, so it would let `Option::None` or
// `Vec::new()` stand in for a scalar. Where an index or builtin argument
// expects a non-aggregate type, a Never-typed expression is accepted only if it
// really diverges (mirrors Rust `never_is_not_a_value`).
fn is_diverging_never(e: CheckEnv, m: Module, eid: i64, tid: i64) -> bool {
    tid == CTY_NEVER() && expr_diverges(e, m, eid)
}

fn never_is_not_a_value(e: CheckEnv, m: Module, eid: i64, from_tid: i64, to_tid: i64) -> bool {
    if from_tid != CTY_NEVER() {
        return false;
    }
    let to_tag: i64 = ty_tag(e.ts, to_tid);
    if to_tag == CTY_APPLIED() || is_opaque(to_tid) {
        return false;
    }
    !expr_diverges(e, m, eid)
}

fn is_flat_slot_tid(ts: TyStore, tid: i64) -> bool {
    let tag: i64 = ty_tag(ts, tid);
    (tag >= CTY_I8() && tag <= CTY_U128()) || tag == CTY_F32() || tag == CTY_F64() || tag == CTY_BOOL()
}

fn is_flat_vec_tid(ts: TyStore, tid: i64) -> bool {
    let args_lid: i64 = ty_applied_args(ts, tid, -1, String::from("Vec"));
    if args_lid < 0 { return false; }
    if ts_arg_len(ts, args_lid) == 0 {
        return false;
    }
    is_flat_slot_tid(ts, ts_arg_get(ts, args_lid, 0))
}

fn is_supported_pin_tid(ts: TyStore, tid: i64) -> bool {
    tid == CTY_STR() || is_flat_vec_tid(ts, tid)
}

fn is_vec_raw_parts_copy_expr(a: AstArena, eid: i64) -> bool {
    if expr_tag(a, eid) != EXPR_ECTOR() {
        return false;
    }
    let path_lid: i64 = expr_a(a, eid);
    if list_len(a, path_lid) < 2 {
        return false;
    }
    let first_sid: i64 = list_get(a, path_lid, 0);
    let second_sid: i64 = list_get(a, path_lid, 1);
    arena_str(a, first_sid) == String::from("Vec") && arena_str(a, second_sid) == String::from("from_raw_parts_copy")
}

// The linearity rules for one written `Vec`/`HashMap`/`BTreeMap` node, run once
// every definition is complete. Non-recursive.
fn recheck_collection_node(e: CheckEnv, tid: i64, span: i64) [io] {
    let vec_args: i64 = ty_applied_args(e.ts, tid, CTY_ENUM(), String::from("Vec"));
    if vec_args >= 0 && ts_arg_len(e.ts, vec_args) == 1 &&
       is_linear_vec_element(e, ts_arg_get(e.ts, vec_args, 0)) == 1 {
        emit_vec_linear_element_error(e, ts_arg_get(e.ts, vec_args, 0), span);
    }
    let tree_args: i64 = ty_applied_args(e.ts, tid, CTY_STRUCT(), String::from("BTreeMap"));
    let map_args: i64 = ty_applied_args(e.ts, tid, CTY_STRUCT(), String::from("HashMap"));
    let map_lid: i64 = if tree_args >= 0 { tree_args } else { map_args };
    if map_lid >= 0 && ts_arg_len(e.ts, map_lid) == 2 {
        let vtid: i64 = ts_arg_get(e.ts, map_lid, 1);
        if is_linear_ty(e, vtid) == 1 {
            let bname: String = if tree_args >= 0 { String::from("BTreeMap") } else { String::from("HashMap") };
            emit_map_linear_value_error(e, bname, vtid, span);
        }
    }
}

// Walks a written type in step with its resolved tid and applies the collection
// linearity rules at every written collection. A type alias is not entered: its
// expansion is checked once, at the alias definition, instead of at every use.
// The only linearity check for struct fields, enum payloads and aliases
// (resolved with defer_map_linear set). Mirrors Rust `check_written_ty`.
fn recheck_written_ty(e: CheckEnv, a: AstArena, ast_tid: i64, tid: i64, span: i64) [io] {
    let atag: i64 = type_tag(a, ast_tid);
    let tag: i64 = ty_tag(e.ts, tid);
    if atag == TY_GENERIC() && tag == CTY_APPLIED() {
        recheck_collection_node(e, tid, span);
        let ast_args: i64 = type_b(a, ast_tid);
        let alid: i64 = ty_b(e.ts, tid);
        let an: i64 = list_len(a, ast_args);
        let mut ai: i64 = 0;
        while ai < an && ai < ts_arg_len(e.ts, alid) {
            recheck_written_ty(e, a, list_get(a, ast_args, ai), ts_arg_get(e.ts, alid, ai), span);
            ai = ai + 1;
        }
    }
    if atag == TY_TUPLE() && tag == CTY_TUPLE() {
        let ast_elems: i64 = type_a(a, ast_tid);
        let tlid: i64 = ty_a(e.ts, tid);
        let tn: i64 = list_len(a, ast_elems);
        let mut ti: i64 = 0;
        while ti < tn && ti < ts_arg_len(e.ts, tlid) {
            recheck_written_ty(e, a, list_get(a, ast_elems, ti), ts_arg_get(e.ts, tlid, ti), span);
            ti = ti + 1;
        }
    }
    if atag == TY_REF() && tag == CTY_REF() {
        recheck_written_ty(e, a, type_a(a, ast_tid), ty_a(e.ts, tid), span);
    }
}

fn check_module(e: CheckEnv, m: Module, item_files: Vec<String>) [io] {
    let n: u64 = m.items.len();
    if item_files.len() != n {
        eprintln_str("item_files must be parallel to module.items");
        process_exit(1);
    }

    let mut i: u64 = 0u64;
    while i < n {
        let cur: String = item_files[i];
        e.cur_file = cur;
        let item: i64 = m.items[i];
        let kind: i64 = item_kind(item);
        let id: i64 = item_id(item);
        if kind == ITEM_STRUCT() {
            register_struct_name(e, m, id);
        } else if kind == ITEM_ENUM() {
            register_enum_name(e, m, id);
        } else if kind == ITEM_TYPE_ALIAS() {
            register_alias_name(e, m, id);
        }
        i = i + 1;
    }

    i = 0u64;
    while i < n {
        let cur: String = item_files[i];
        e.cur_file = cur;
        let item: i64 = m.items[i];
        let kind: i64 = item_kind(item);
        let id: i64 = item_id(item);
        if kind == ITEM_STRUCT() {
            register_struct(e, m, id);
        } else if kind == ITEM_ENUM() {
            register_enum(e, m, id);
        } else if kind == ITEM_TYPE_ALIAS() {
            register_alias(e, m, id);
        }
        i = i + 1;
    }

    // Validate map value linearity now that all struct/enum
    // definitions are complete. During register_struct, forward-referenced
    // structs may not have had their fields or is_linear flag populated.
    i = 0u64;
    while i < n {
        let cur: String = item_files[i];
        e.cur_file = cur;
        let item: i64 = m.items[i];
        let kind: i64 = item_kind(item);
        let id: i64 = item_id(item);
        if kind == ITEM_STRUCT() {
            let a: AstArena = m.arena;
            let sidx: i64 = env_lookup_struct(e, arena_str(a, sdef_name_sid(a, id)));
            if sidx != -1 {
                let nf: i64 = e.sdef_field_count[sidx as u64];
                let ftid_lid: i64 = e.sdef_field_tid_lids[sidx as u64];
                let fields_lid: i64 = sdef_fields_lid(a, id);
                let struct_name: String = arena_str(a, sdef_name_sid(a, id));
                let mut fi: i64 = 0;
                while fi < nf {
                    let ftid: i64 = ts_arg_get(e.ts, ftid_lid, fi);
                    let ast_ftid: i64 = list_get(a, fields_lid, fi * 2 + 1);
                    recheck_written_ty(e, a, ast_ftid, ftid, sdef_span(a, id));
                    if is_linear_owner_ty(e, ftid) == 1 {
                        let field_name: String = arena_str(a, list_get(a, fields_lid, fi * 2));
                        let msg: String = String::from("struct fields cannot own linear values: `");
                        msg.push_str(struct_name);
                        msg.push_str(String::from("."));
                        msg.push_str(field_name);
                        msg.push_str(String::from("` requires move-out semantics that are not supported"));
                        env_emit_error_code(e, EC_LINEAR_TYPE_VIOLATION(), msg, type_span(a, ast_ftid));
                    }
                    fi = fi + 1;
                }
            }
        } else if kind == ITEM_ENUM() {
            let a: AstArena = m.arena;
            let eidx: i64 = env_lookup_enum(e, arena_str(a, edef_name_sid(a, id)));
            if eidx != -1 {
                let nv: i64 = e.edef_variant_count[eidx as u64];
                let vpayload_lid: i64 = e.edef_vpayload_lids[eidx as u64];
                let variants_lid: i64 = edef_variants_lid(a, id);
                let mut vi: i64 = 0;
                while vi < nv {
                    let payload_lid: i64 = ts_arg_get(e.ts, vpayload_lid, vi);
                    let ast_payload_lid: i64 = list_get(a, variants_lid, vi * 2 + 1);
                    let pn: i64 = ts_arg_len(e.ts, payload_lid);
                    let mut pi: i64 = 0;
                    while pi < pn {
                        let ptid: i64 = ts_arg_get(e.ts, payload_lid, pi);
                        recheck_written_ty(e, a, list_get(a, ast_payload_lid, pi), ptid, edef_span(a, id));
                        pi = pi + 1;
                    }
                    vi = vi + 1;
                }
            }
        } else if kind == ITEM_TYPE_ALIAS() {
            let a: AstArena = m.arena;
            let alias_tid: i64 = env_lookup_alias(e, arena_str(a, alias_name_sid(a, id)));
            if alias_tid != -1 {
                recheck_written_ty(e, a, alias_type_tid(a, id), alias_tid, alias_span(a, id));
            }
        }
        i = i + 1;
    }

    i = 0u64;
    while i < n {
        let cur: String = item_files[i];
        e.cur_file = cur;
        let item: i64 = m.items[i];
        let kind: i64 = item_kind(item);
        let id: i64 = item_id(item);
        if kind == ITEM_CONST() {
            register_const(e, m, id);
        }
        i = i + 1;
    }

    // Also collects every ITEM_FN id for the may-write pass below, in the
    // same scan (issue #1032) — whether calling each module function can
    // write through its own parameters. That pass must run after every
    // function's signature is registered here (so env_lookup_fn can tell a
    // builtin free function apart from an unresolvable name) and before the
    // check_fn loop below, whose check_clause_purity calls consume the table
    // via e.may_write_fns. Declarations are included (not filtered out) —
    // compute_may_write_table seeds them straight to 1, since an
    // `fn f(..) -> T;` stub's "body" is an empty placeholder, not evidence of
    // purity.
    let write_fids: Vec<i64> = Vec::new();
    i = 0u64;
    while i < n {
        let cur: String = item_files[i];
        e.cur_file = cur;
        let item: i64 = m.items[i];
        let kind: i64 = item_kind(item);
        let id: i64 = item_id(item);
        if kind == ITEM_FN() {
            register_fn(e, m, id);
            write_fids.push(id);
        } else if kind == ITEM_EXTERN() {
            let a: AstArena = m.arena;
            let fns_lid: i64 = ext_fns_lid(a, id);
            let nf: i64 = list_len(a, fns_lid);
            if ext_vow_lid(a, id) == -1 && nf > 0 {
                env_emit_error_code_hint(
                    e, EC_MISSING_CONTRACT(), String::from("extern block requires a vow contract"), ext_span(a, id),
                    String::from("add a `vow { ... }` block specifying contracts for foreign functions")
                );
            }
            let mut fi: i64 = 0;
            while fi < nf {
                let ext_fid: i64 = list_get(a, fns_lid, fi);
                register_fn(e, m, ext_fid);
                env_mark_extern_fn(e, arena_str(a, fn_name_sid(a, ext_fid)));
                fi = fi + 1;
            }
        }
        i = i + 1;
    }
    compute_may_write_table(e, m, write_fids);

    i = 0u64;
    while i < n {
        let cur: String = item_files[i];
        e.cur_file = cur;
        let item: i64 = m.items[i];
        let kind: i64 = item_kind(item);
        let id: i64 = item_id(item);
        if kind == ITEM_FN() && !fn_is_declaration(m.arena, id) {
            check_fn(e, m, id);
        } else if kind == ITEM_FN() {
            check_param_refinements(e, m, id);
        } else if kind == ITEM_EXTERN() {
            let a: AstArena = m.arena;
            let fns_lid: i64 = ext_fns_lid(a, id);
            let nf: i64 = list_len(a, fns_lid);
            let mut fi: i64 = 0;
            while fi < nf {
                check_param_refinements(e, m, list_get(a, fns_lid, fi));
                fi = fi + 1;
            }
        }
        i = i + 1;
    }
}

fn register_alias(e: CheckEnv, m: Module, aid: i64) [io] {
    let a: AstArena = m.arena;
    let name: String = arena_str(a, alias_name_sid(a, aid));
    e.defer_map_linear = true;
    let tid: i64 = resolve_ast_ty(e, m, alias_type_tid(a, aid));
    e.defer_map_linear = false;
    if tid != CTY_UNKNOWN() {
        env_define_alias(e, name, tid);
    }
}

fn emit_const_type_mismatch(e: CheckEnv, name: String, tid: i64, expected: String, span: i64) {
    let msg: String = String::from("const `");
    msg.push_str(name);
    msg.push_str(String::from("` has type `"));
    msg.push_str(ty_value_display_name(e.ts, tid));
    msg.push_str(String::from("`, expected "));
    msg.push_str(expected);
    env_emit_error(e, msg, span);
}

fn register_const(e: CheckEnv, m: Module, cid: i64) [io] {
    let a: AstArena = m.arena;
    let name_sid: i64 = cdef_name_sid(a, cid);
    let name: String = arena_str(a, name_sid);
    let type_tid: i64 = cdef_type_tid(a, cid);
    let resolved_tid: i64 = resolve_ast_ty(e, m, type_tid);
    let val_eid: i64 = cdef_value_eid(a, cid);
    let val_tag: i64 = expr_tag(a, val_eid);
    if ty_is_integer(e.ts, resolved_tid) {
        check_integer_literal_range(e, a, val_eid, ty_tag(e.ts, resolved_tid));
    }
    if val_tag == EXPR_LIT_INT() {
        if !ty_is_integer(e.ts, resolved_tid) {
            emit_const_type_mismatch(e, name, resolved_tid, String::from("integer type"), cdef_span(a, cid));
        }
    } else if val_tag == EXPR_LIT_BOOL() {
        if resolved_tid != CTY_BOOL() {
            emit_const_type_mismatch(e, name, resolved_tid, String::from("bool"), cdef_span(a, cid));
        }
    } else if val_tag == EXPR_UNOP() {
        let op: i64 = expr_a(a, val_eid);
        if op != UNOP_NEG() {
            env_emit_error(e, String::from("const value must be a literal"), expr_span(a, val_eid));
        } else {
            if !ty_is_integer(e.ts, resolved_tid) {
                emit_const_type_mismatch(e, name, resolved_tid, String::from("integer type"), cdef_span(a, cid));
            }
            let inner_eid: i64 = expr_b(a, val_eid);
            let inner_tag: i64 = expr_tag(a, inner_eid);
            if inner_tag != EXPR_LIT_INT() {
                env_emit_error(e, String::from("const value must be a literal"), expr_span(a, val_eid));
            }
        }
    } else {
        env_emit_error(e, String::from("const value must be a literal"), expr_span(a, val_eid));
    }
    e.const_names.push(name);
    e.const_tids.push(resolved_tid);
}

// A `()` parameter carries no information and has no ABI slot. Mirrors Rust
// `check_param_ty`.
fn emit_unit_param_error(e: CheckEnv, pname: String, span: i64) {
    let msg: String = String::from("parameter `");
    msg.push_str(pname);
    msg.push_str(String::from("` has type `()`: unit parameters are not supported"));
    env_emit_error_code_hint(
        e, EC_UNSUPPORTED_FEATURE(), msg, span,
        String::from("remove the parameter; a `()` argument carries no information")
    );
}

fn register_fn(e: CheckEnv, m: Module, fid: i64) [io] {
    let a: AstArena = m.arena;
    let name_sid: i64 = fn_name_sid(a, fid);
    let name: String = arena_str(a, name_sid);
    let params_lid: i64 = fn_params_lid(a, fid);
    let n_pairs: i64 = list_len(a, params_lid);
    let n_params: i64 = n_pairs / 4;
    let param_tids: Vec<i64> = Vec::new();
    let mut i: i64 = 0;
    while i < n_params {
        let ast_tid: i64 = list_get(a, params_lid, i * 4 + 1);
        let ptid: i64 = resolve_ast_ty(e, m, ast_tid);
        if ptid == CTY_UNIT() {
            emit_unit_param_error(e, arena_str(a, list_get(a, params_lid, i * 4)), list_get(a, params_lid, i * 4 + 3));
        }
        param_tids.push(ptid);
        i = i + 1;
    }
    let ret_ast_tid: i64 = fn_ret_ast_tid(a, fid);
    let ret_tid: i64 = resolve_ast_ty(e, m, ret_ast_tid);
    let eff: i64 = fn_eff(a, fid);
    env_define_fn(e, name, param_tids, ret_tid, eff);
}

// The resolver binds primitive names and the builtin generic names before any
// user type, so a user type of the same name would silently alias the builtin in
// some positions (`Vec`) and shadow it in others. Mirrors Rust
// `check_reserved_type_name`.
fn check_reserved_type_name(e: CheckEnv, name: String, span: i64) {
    let reserved: bool = primitive_tid(e.ts, name) != -1
        || name == String::from("Vec")
        || name == String::from("Option")
        || name == String::from("Result")
        || name == String::from("HashMap")
        || name == String::from("BTreeMap");
    if reserved {
        let msg: String = String::from("`");
        msg.push_str(name);
        msg.push_str(String::from("` is a builtin type name and cannot be declared as a user type"));
        env_emit_error_code_hint(e, EC_UNSUPPORTED_FEATURE(), msg, span,
            String::from("choose a different name for this type"));
    }
}

fn register_struct_name(e: CheckEnv, m: Module, sid: i64) [io] {
    let a: AstArena = m.arena;
    let name_s: i64 = sdef_name_sid(a, sid);
    let name: String = arena_str(a, name_s);
    check_reserved_type_name(e, name, sdef_span(a, sid));
    env_define_struct_name(e, name);
}

fn register_enum_name(e: CheckEnv, m: Module, eid: i64) [io] {
    let a: AstArena = m.arena;
    let name_s: i64 = edef_name_sid(a, eid);
    let name: String = arena_str(a, name_s);
    check_reserved_type_name(e, name, edef_span(a, eid));
    env_define_enum_name(e, name);
}

fn register_alias_name(e: CheckEnv, m: Module, aid: i64) [io] {
    let a: AstArena = m.arena;
    let name: String = arena_str(a, alias_name_sid(a, aid));
    check_reserved_type_name(e, name, alias_span(a, aid));
}

fn register_struct(e: CheckEnv, m: Module, sid: i64) [io] {
    let a: AstArena = m.arena;
    let name_s: i64 = sdef_name_sid(a, sid);
    let name: String = arena_str(a, name_s);
    let fields_lid: i64 = sdef_fields_lid(a, sid);
    let n_pairs: i64 = list_len(a, fields_lid);
    let n_fields: i64 = n_pairs / 2;
    let fnames: Vec<String> = Vec::new();
    let ftids: Vec<i64> = Vec::new();
    let mut i: i64 = 0;
    while i < n_fields {
        let fsid: i64 = list_get(a, fields_lid, i * 2);
        let fname: String = arena_str(a, fsid);
        let ast_ftid: i64 = list_get(a, fields_lid, i * 2 + 1);
        fnames.push(fname);
        e.defer_map_linear = true;
        ftids.push(resolve_ast_ty(e, m, ast_ftid));
        e.defer_map_linear = false;
        i = i + 1;
    }
    let is_linear: i64 = sdef_is_linear(a, sid);
    env_update_struct(e, name, fnames, ftids, is_linear);
}

fn register_enum(e: CheckEnv, m: Module, eid: i64) [io] {
    let a: AstArena = m.arena;
    let name_s: i64 = edef_name_sid(a, eid);
    let name: String = arena_str(a, name_s);
    let variants_lid: i64 = edef_variants_lid(a, eid);
    let n_pairs: i64 = list_len(a, variants_lid);
    let n_variants: i64 = n_pairs / 2;
    let vnames: Vec<String> = Vec::new();
    let vpayloads: Vec<i64> = Vec::new();
    let mut i: i64 = 0;
    while i < n_variants {
        let vsid: i64 = list_get(a, variants_lid, i * 2);
        let payload_lid: i64 = list_get(a, variants_lid, i * 2 + 1);
        let vname: String = arena_str(a, vsid);
        vnames.push(vname);
        let n_fields: i64 = list_len(a, payload_lid);
        let resolved_fields: Vec<i64> = Vec::new();
        let mut fi: i64 = 0;
        while fi < n_fields {
            let ast_tid: i64 = list_get(a, payload_lid, fi);
            e.defer_map_linear = true;
            let resolved: i64 = resolve_ast_ty(e, m, ast_tid);
            e.defer_map_linear = false;
            resolved_fields.push(resolved);
            fi = fi + 1;
        }
        let fields_lid: i64 = ts_add_args(e.ts, resolved_fields);
        vpayloads.push(fields_lid);
        i = i + 1;
    }
    env_update_enum(e, name, vnames, vpayloads);
}

// Contract clauses must be pure: a requires/ensures/invariant predicate may not
// call an effectful function (mirrors the Rust frontend's check_vow_purity in
// vow-types/src/effects.rs). Without this the production self-hosted compiler
// admits e.g. `requires: read_file(p).len() > 0` into a contract — an effectful,
// possibly-failing predicate the verifier model cannot faithfully represent
// (issue #586). `__unwrap__` panic sites are out of scope here (issue #601),
// matching the Rust check which also does not flag them.
fn check_clause_purity(e: CheckEnv, m: Module, clause_eid: i64) [io] {
    let a: AstArena = m.arena;
    let calls: Vec<String> = Vec::new();
    collect_calls_in_expr(e, m, clause_eid, calls);
    let n: u64 = calls.len();
    let mut i: u64 = 0u64;
    while i < n {
        let cname: String = calls[i];
        if cname != String::from("__unwrap__") {
            let fidx: i64 = env_lookup_fn(e, cname);
            if fidx != -1 {
                let callee_eff: i64 = e.fn_effects[fidx as u64];
                if callee_eff != 0 {
                    let msg: String = String::from("vow predicate must be pure but calls effectful function `");
                    msg.push_str(cname);
                    msg.push_str(String::from("`"));
                    env_emit_error_code_hint(
                        e, EC_EFFECT_VIOLATION(), msg, expr_span(a, clause_eid),
                        String::from("vow predicates must be pure — move effectful code outside the vow block")
                    );
                }
            }
        }
        i = i + 1;
    }

    let write_sites: Vec<i64> = Vec::new();
    collect_may_write_sites_in_expr(e, m, clause_eid, write_sites);
    let n_writes: u64 = write_sites.len();
    let mut wi: u64 = 0u64;
    while wi < n_writes {
        let site_eid: i64 = write_sites[wi];
        let msg: String = String::from("vow predicate must be pure but this expression may write through a shared argument");
        env_emit_error_code_hint(
            e, EC_EFFECT_VIOLATION(), msg, expr_span(a, site_eid),
            String::from("vow predicates must not write to a struct field, a Vec/map element, or call a mutating builtin method — move the write outside the vow block")
        );
        wi = wi + 1;
    }
}

fn where_scope_hint(e: CheckEnv, name: String) -> String {
    if e.where_active == 0 {
        return String::new();
    }
    if name_list_contains(e.where_sibs, name) {
        let hint: String = String::from("a `where` clause can only reference its own parameter `");
        hint.push_str(e.where_own);
        hint.push_str(String::from("`; put a condition on several parameters in `requires`"));
        return hint;
    }
    if name == String::from("result") {
        return String::from("a `where` clause is checked before the function runs, so `result` does not exist yet; constrain the return value with `ensures`");
    }
    String::new()
}

fn emit_unknown_struct(e: CheckEnv, sname: String, span: i64) {
    let msg: String = String::from("unknown struct `");
    msg.push_str(sname);
    msg.push_str(String::from("`"));
    env_emit_error_code(e, EC_TYPE_MISMATCH(), msg, span);
}

fn emit_no_such_field(e: CheckEnv, sname: String, fname: String, span: i64) {
    let msg: String = String::from("struct `");
    msg.push_str(sname);
    msg.push_str(String::from("` has no field `"));
    msg.push_str(fname);
    msg.push_str(String::from("`"));
    env_emit_error_code(e, EC_TYPE_MISMATCH(), msg, span);
}

fn emit_undefined_variable(e: CheckEnv, name: String, span: i64) {
    let msg: String = String::from("undefined variable `");
    msg.push_str(name);
    msg.push_str(String::from("`"));
    let mut hint: String = where_scope_hint(e, name);
    if hint.len() == 0 {
        let suggestion: String = diag_suggest_similar(name, env_visible_var_names(e));
        if suggestion.len() > 0 {
            hint = String::from("did you mean `");
            hint.push_str(suggestion);
            hint.push_str(String::from("`?"));
        }
    }
    if hint.len() == 0 {
        env_emit_error(e, msg, span);
    } else {
        env_emit_error_code_hint(e, EC_TYPE_MISMATCH(), msg, span, hint);
    }
}

// Checks each parameter's `where` refinement like a `requires` clause, in a
// scope holding only that parameter: a pure `bool` predicate with no tuple
// expressions. Mirrors `check_param_refinements` in vow-types/src/check.rs.
fn check_param_refinements(e: CheckEnv, m: Module, fid: i64) [io] {
    let a: AstArena = m.arena;
    let params_lid: i64 = fn_params_lid(a, fid);
    let n_params: i64 = list_len(a, params_lid) / 4;
    let mut any: bool = false;
    let mut i: i64 = 0;
    while i < n_params {
        if list_get(a, params_lid, i * 4 + 2) != -1 {
            any = true;
        }
        i = i + 1;
    }
    if !any {
        return;
    }
    e.cur_fn_name = arena_str(a, fn_name_sid(a, fid));
    let fidx: i64 = env_lookup_fn(e, e.cur_fn_name);
    i = 0;
    while i < n_params {
        let ref_eid: i64 = list_get(a, params_lid, i * 4 + 2);
        if ref_eid != -1 {
            let pname: String = arena_str(a, list_get(a, params_lid, i * 4));
            let ptid: i64 = if fidx != -1 && i < e.fn_param_count[fidx as u64] {
                ts_arg_get(e.ts, e.fn_param_lids[fidx as u64], i)
            } else {
                resolve_ast_ty(e, m, list_get(a, params_lid, i * 4 + 1))
            };
            let sibs: Vec<String> = Vec::new();
            let mut j: i64 = 0;
            while j < n_params {
                if j != i {
                    sibs.push(arena_str(a, list_get(a, params_lid, j * 4)));
                }
                j = j + 1;
            }
            env_push_scope(e);
            env_define_var(e, pname, ptid);
            e.where_active = 1;
            e.where_own = pname;
            e.where_sibs = sibs;
            e.contract_depth = e.contract_depth + 1;
            let pred_tid: i64 = check_expr(e, m, ref_eid);
            e.contract_depth = e.contract_depth - 1;
            e.where_active = 0;
            env_pop_scope(e);
            if pred_tid != CTY_BOOL() && !is_opaque(pred_tid) {
                env_emit_error_code_hint(
                    e, EC_CONTRACT_TYPE_MISMATCH(), String::from("`where` clause must be `bool`"),
                    expr_span(a, ref_eid),
                    String::from("parameter `where` clauses must evaluate to `bool`")
                );
            }
            check_clause_purity(e, m, ref_eid);
        }
        i = i + 1;
    }
}

fn check_vow_clause(e: CheckEnv, m: Module, vow_lid: i64, kind: i64, context: String) [io] {
    let a: AstArena = m.arena;
    let n: i64 = list_len(a, vow_lid);
    let mut i: i64 = 0;
    while i < n {
        let cid: i64 = list_get(a, vow_lid, i);
        let ck: i64 = vow_clause_kind(a, cid);
        if ck == kind {
            let clause_eid: i64 = vow_clause_expr(a, cid);
            e.contract_depth = e.contract_depth + 1;
            let clause_tid: i64 = check_expr(e, m, clause_eid);
            e.contract_depth = e.contract_depth - 1;
            if clause_tid != CTY_BOOL() && !is_opaque(clause_tid) {
                let kind_name: String = if kind == CLAUSE_REQUIRES() {
                    String::from("requires")
                } else if kind == CLAUSE_ENSURES() {
                    String::from("ensures")
                } else {
                    String::from("invariant")
                };
                let msg: String = String::from("`");
                msg.push_str(kind_name);
                msg.push_str(String::from("` clause must be `bool`"));
                let hint: String = String::from(context);
                hint.push_str(String::from(" `"));
                hint.push_str(kind_name);
                hint.push_str(String::from("` clauses must evaluate to `bool`"));
                env_emit_error_code_hint(e, EC_CONTRACT_TYPE_MISMATCH(), msg, expr_span(a, clause_eid), hint);
            }
            check_clause_purity(e, m, clause_eid);
        }
        i = i + 1;
    }
}

fn checker_block_result_eid(a: AstArena, bid: i64) -> i64 {
    let trail_eid: i64 = blk_trail(a, bid);
    if trail_eid != -1 {
        return trail_eid;
    }
    let stmts_lid: i64 = blk_stmts(a, bid);
    let n: i64 = list_len(a, stmts_lid);
    if n == 0 {
        return -1;
    }
    let last_sid: i64 = list_get(a, stmts_lid, n - 1);
    if stmt_tag(a, last_sid) == STMT_EXPR() && stmt_b(a, last_sid) == 0 {
        return stmt_a(a, last_sid);
    }
    -1
}

fn checker_expr_is_coercible_int_marker(a: AstArena, eid: i64) -> bool {
    let tag: i64 = expr_tag(a, eid);
    if tag == EXPR_LIT_INT() {
        return true;
    }
    if tag == EXPR_UNOP() {
        if expr_a(a, eid) == UNOP_NEG() {
            return checker_expr_is_coercible_int_marker(a, expr_b(a, eid));
        }
        return false;
    }
    if tag == EXPR_BINOP() {
        let op: i64 = expr_a(a, eid);
        let marker_op: bool = op == BINOP_ADD() || op == BINOP_SUB()
            || op == BINOP_MUL() || op == BINOP_DIV() || op == BINOP_REM()
            || op == BINOP_ADD_CHK() || op == BINOP_SUB_CHK()
            || op == BINOP_MUL_CHK() || op == BINOP_DIV_CHK() || op == BINOP_REM_CHK()
            || op == BINOP_BITAND() || op == BINOP_BITOR() || op == BINOP_XOR()
            || op == BINOP_SHL() || op == BINOP_SHR();
        if marker_op {
            return checker_expr_is_coercible_int_marker(a, expr_b(a, eid))
                && checker_expr_is_coercible_int_marker(a, expr_c(a, eid));
        }
        return false;
    }
    if tag == EXPR_BLOCK() {
        let result_eid: i64 = checker_block_result_eid(a, expr_a(a, eid));
        return result_eid != -1 && checker_expr_is_coercible_int_marker(a, result_eid);
    }
    if tag == EXPR_IF() {
        let then_result: i64 = checker_block_result_eid(a, expr_b(a, eid));
        let else_eid: i64 = expr_c(a, eid);
        return then_result != -1 && else_eid != -1 &&
            checker_expr_is_coercible_int_marker(a, then_result) &&
            checker_expr_is_coercible_int_marker(a, else_eid);
    }
    if tag == EXPR_MATCH() || tag == EXPR_LOOP() { return true; }
    false
}

fn check_fn(e: CheckEnv, m: Module, fid: i64) [io] {
    let a: AstArena = m.arena;
    let save_ret: i64 = e.cur_ret_tid;
    let save_eff: i64 = e.cur_effects;

    let name_sid: i64 = fn_name_sid(a, fid);
    e.cur_fn_name = arena_str(a, name_sid);
    let fidx: i64 = env_lookup_fn(e, e.cur_fn_name);

    let ret_ast_tid: i64 = fn_ret_ast_tid(a, fid);
    let ret_tid: i64 = if fidx != -1 {
        e.fn_ret_tids[fidx as u64]
    } else {
        resolve_ast_ty(e, m, ret_ast_tid)
    };
    e.cur_ret_tid = ret_tid;
    e.cur_effects = fn_eff(a, fid);

    check_param_refinements(e, m, fid);

    let mut_base: u64 = e.var_names.len();
    env_push_scope(e);

    let params_lid: i64 = fn_params_lid(a, fid);
    let n_pairs: i64 = list_len(a, params_lid);
    let n_params: i64 = n_pairs / 4;
    let mut i: i64 = 0;
    while i < n_params {
        let psid: i64 = list_get(a, params_lid, i * 4);
        let pname: String = arena_str(a, psid);
        let ast_ptid: i64 = list_get(a, params_lid, i * 4 + 1);
        let ptid: i64 = if fidx != -1 && i < e.fn_param_count[fidx as u64] {
            ts_arg_get(e.ts, e.fn_param_lids[fidx as u64], i)
        } else {
            resolve_ast_ty(e, m, ast_ptid)
        };
        env_define_var(e, pname, ptid);
        i = i + 1;
    }

    let vow_lid: i64 = fn_vow_lid(a, fid);
    if vow_lid != -1 {
        check_vow_clause(e, m, vow_lid, CLAUSE_REQUIRES(), String::from("function"));
    }

    let body_bid: i64 = fn_body_bid(a, fid);
    let body_tid: i64 = check_block(e, m, body_bid);
    let body_result_eid: i64 = checker_block_result_eid(a, body_bid);
    if body_result_eid != -1 {
        check_contextual_integer_literal_ranges(e, a, body_result_eid, ret_tid);
    }

    if !is_coercible(e.ts, body_tid, ret_tid) {
        env_emit_error(e, String::from("function body type mismatch"), fn_span(a, fid));
    }

    if vow_lid != -1 {
        env_push_scope(e);
        env_define_var(e, String::from("result"), ret_tid);
        check_vow_clause(e, m, vow_lid, CLAUSE_ENSURES(), String::from("function"));
        env_pop_scope(e);
    }

    env_pop_scope(e);

    let var_total: u64 = e.var_names.len();
    let mut vi: u64 = mut_base;
    while vi < var_total {
        if e.var_muts[vi] == 1 && e.var_mutated[vi] == 0 {
            let uname: String = e.var_names[vi];
            let umsg: String = String::from("`mut` binding `");
            umsg.push_str(uname);
            umsg.push_str(String::from("` is never reassigned; remove `mut`"));
            env_emit_error_code(e, EC_UNUSED_MUT(), umsg, e.var_decl_spans[vi]);
        }
        vi = vi + 1;
    }

    check_effects_fn(e, m, fid);

    e.cur_ret_tid = save_ret;
    e.cur_effects = save_eff;
}

fn call_returns_never(e: CheckEnv, m: Module, eid: i64) -> bool {
    let a: AstArena = m.arena;
    if expr_tag(a, eid) != EXPR_CALL() {
        return false;
    }
    let callee_eid: i64 = expr_a(a, eid);
    if expr_tag(a, callee_eid) != EXPR_IDENT() {
        return false;
    }
    let name_sid: i64 = expr_a(a, callee_eid);
    let name: String = arena_str(a, name_sid);
    let fidx: i64 = env_lookup_fn(e, name);
    if fidx == -1 {
        return false;
    }
    ty_tag(e.ts, e.fn_ret_tids[fidx as u64]) == CTY_NEVER()
}

fn stmt_diverges(e: CheckEnv, m: Module, sid: i64) -> bool {
    let a: AstArena = m.arena;
    if stmt_tag(a, sid) != STMT_EXPR() {
        return false;
    }
    expr_diverges(e, m, stmt_a(a, sid))
}

fn block_diverges(e: CheckEnv, m: Module, bid: i64) -> bool {
    let a: AstArena = m.arena;
    let trail: i64 = blk_trail(a, bid);
    if trail != -1 {
        return expr_diverges(e, m, trail);
    }
    let stmts_lid: i64 = blk_stmts(a, bid);
    let n: i64 = list_len(a, stmts_lid);
    if n == 0 {
        return false;
    }
    stmt_diverges(e, m, list_get(a, stmts_lid, n - 1))
}

fn expr_list_diverges(e: CheckEnv, m: Module, lid: i64) -> bool {
    let a: AstArena = m.arena;
    let n: i64 = list_len(a, lid);
    let mut i: i64 = 0;
    while i < n {
        if expr_diverges(e, m, list_get(a, lid, i)) {
            return true;
        }
        i = i + 1;
    }
    false
}

fn expr_pair_value_list_diverges(e: CheckEnv, m: Module, lid: i64) -> bool {
    let a: AstArena = m.arena;
    let n_pairs: i64 = list_len(a, lid);
    let n: i64 = n_pairs / 2;
    let mut i: i64 = 0;
    while i < n {
        if expr_diverges(e, m, list_get(a, lid, i * 2 + 1)) {
            return true;
        }
        i = i + 1;
    }
    false
}

fn expr_diverges(e: CheckEnv, m: Module, eid: i64) -> bool {
    let a: AstArena = m.arena;
    let tag: i64 = expr_tag(a, eid);

    if tag == EXPR_RETURN() || tag == EXPR_BREAK() || tag == EXPR_CONTINUE() {
        return true;
    }
    if tag == EXPR_BLOCK() {
        return block_diverges(e, m, expr_a(a, eid));
    }
    if tag == EXPR_IF() {
        if expr_diverges(e, m, expr_a(a, eid)) {
            return true;
        }
        let else_eid: i64 = expr_c(a, eid);
        return else_eid != -1 && block_diverges(e, m, expr_b(a, eid)) && expr_diverges(e, m, else_eid);
    }
    if tag == EXPR_MATCH() {
        if expr_diverges(e, m, expr_a(a, eid)) {
            return true;
        }
        let arms_lid: i64 = expr_b(a, eid);
        let n_pairs: i64 = list_len(a, arms_lid);
        let n: i64 = n_pairs / 2;
        if n == 0 {
            return false;
        }
        let mut i: i64 = 0;
        while i < n {
            if !expr_diverges(e, m, list_get(a, arms_lid, i * 2 + 1)) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }
    if tag == EXPR_BINOP() {
        if expr_diverges(e, m, expr_b(a, eid)) {
            return true;
        }
        let op: i64 = expr_a(a, eid);
        if op != BINOP_AND() && op != BINOP_OR() && expr_diverges(e, m, expr_c(a, eid)) {
            return true;
        }
        return false;
    }
    if tag == EXPR_UNOP() {
        return expr_diverges(e, m, expr_b(a, eid));
    }
    if tag == EXPR_CALL() {
        if expr_diverges(e, m, expr_a(a, eid)) {
            return true;
        }
        if expr_list_diverges(e, m, expr_b(a, eid)) {
            return true;
        }
        return call_returns_never(e, m, eid);
    }
    if tag == EXPR_METHOD() {
        if expr_diverges(e, m, expr_a(a, eid)) {
            return true;
        }
        return expr_list_diverges(e, m, expr_c(a, eid));
    }
    if tag == EXPR_FIELD() || tag == EXPR_QUESTION() || tag == EXPR_CAST() || tag == EXPR_FOR() {
        return expr_diverges(e, m, expr_a(a, eid));
    }
    if tag == EXPR_INDEX() || tag == EXPR_ASSIGN() {
        return expr_diverges(e, m, expr_a(a, eid)) || expr_diverges(e, m, expr_b(a, eid));
    }
    if tag == EXPR_WHILE() {
        return expr_diverges(e, m, expr_a(a, eid));
    }
    if tag == EXPR_TUPLE() {
        return expr_list_diverges(e, m, expr_a(a, eid));
    }
    if tag == EXPR_SLIT() {
        return expr_pair_value_list_diverges(e, m, expr_b(a, eid));
    }
    if tag == EXPR_ECTOR() {
        return expr_list_diverges(e, m, expr_b(a, eid));
    }
    false
}

// The unsigned type tag two comparison operands share, or -1. An unsuffixed
// integer literal takes the other operand's type, so `u64` against a literal
// counts.
fn unsigned_comparison_tag(ts: TyStore, lhs_tid: i64, rhs_tid: i64) -> i64 {
    let lhs_unsigned: bool = ty_is_unsigned(ts, lhs_tid);
    let rhs_unsigned: bool = ty_is_unsigned(ts, rhs_tid);
    if lhs_unsigned && rhs_unsigned {
        if ty_tag(ts, lhs_tid) == ty_tag(ts, rhs_tid) {
            return ty_tag(ts, lhs_tid);
        }
        return -1;
    }
    if lhs_unsigned && ty_is_lit_int(ts, rhs_tid) {
        return ty_tag(ts, lhs_tid);
    }
    if rhs_unsigned && ty_is_lit_int(ts, lhs_tid) {
        return ty_tag(ts, rhs_tid);
    }
    -1
}

// Verdict for a comparison against a constant 0: 1 = always true, 0 = always
// false, -1 = meaningful, keep compiling (`x > 0`, `x <= 0`, `x == 0`, `x != 0`).
fn unsigned_zero_comparison_verdict(a: AstArena, op: i64, lhs_eid: i64, rhs_eid: i64) -> i64 {
    if op == BINOP_GE() && expr_folds_to_zero(a, rhs_eid) { return 1; }
    if op == BINOP_LE() && expr_folds_to_zero(a, lhs_eid) { return 1; }
    if op == BINOP_LT() && expr_folds_to_zero(a, rhs_eid) { return 0; }
    if op == BINOP_GT() && expr_folds_to_zero(a, lhs_eid) { return 0; }
    -1
}

// Which side of the comparison carries the value when the other side is a
// constant 0, or -1. `0 <= x` and `x <= 0` share an operator but only the first
// is the tautological shape, so the caller must test *that* side.
fn zero_comparison_value_eid(a: AstArena, op: i64, lhs_eid: i64, rhs_eid: i64) -> i64 {
    if op == BINOP_GE() && expr_folds_to_zero(a, rhs_eid) { return lhs_eid; }
    if op == BINOP_LE() && expr_folds_to_zero(a, lhs_eid) { return rhs_eid; }
    if op == BINOP_LT() && expr_folds_to_zero(a, rhs_eid) { return lhs_eid; }
    if op == BINOP_GT() && expr_folds_to_zero(a, lhs_eid) { return rhs_eid; }
    -1
}

// The unsigned source type tag whose zero-extension makes a cast
// `inner_eid as tgt_tid` provably non-negative in the signed target, or -1.
//
// `as` is widening-only plus same-width signedness change
// (docs/spec/grammar.md), which makes the rule exact: zero-extension happens
// iff the source is unsigned and the target is strictly wider. The excluded
// cases are meaningful comparisons and must keep compiling — a same-width
// `u64 as i64` is a bit reinterpretation (`u64::MAX as i64` is -1) and a signed
// source sign-extends. Casts to an unsigned target are left alone so
// unsigned_comparison_tag reports them once instead of both paths firing.
fn zero_extended_source_tag(e: CheckEnv, a: AstArena, inner_eid: i64, src_tid: i64, tgt_tid: i64) -> i64 {
    if ty_is_unsigned(e.ts, tgt_tid) {
        return -1;
    }
    let src_tag: i64 = ty_tag(e.ts, src_tid);
    let tgt_tag: i64 = ty_tag(e.ts, tgt_tid);
    if ty_is_unsigned(e.ts, src_tid) && integer_tag_width(tgt_tag) > integer_tag_width(src_tag) {
        return src_tag;
    }
    // A chain (`v as u32 as i64`) stays non-negative: every further `as` is
    // widening or a same-width reinterpretation of an already-non-negative
    // value, so carry the original unsigned source through.
    if expr_tag(a, inner_eid) == EXPR_CAST() {
        return env_nonneg_cast_src_tag(e, inner_eid);
    }
    -1
}

fn integer_literal_out_of_range(a: AstArena, lit_eid: i64, target_tag: i64) -> bool {
    let mut magnitude_eid: i64 = lit_eid;
    let mut negative: bool = false;
    if expr_tag(a, lit_eid) == EXPR_UNOP() && expr_a(a, lit_eid) == UNOP_NEG() {
        negative = true;
        magnitude_eid = expr_b(a, lit_eid);
        if expr_tag(a, magnitude_eid) == EXPR_CAST() {
            magnitude_eid = expr_a(a, magnitude_eid);
        }
    }
    if expr_tag(a, magnitude_eid) != EXPR_LIT_INT() {
        return false;
    }
    let lo: u64 = expr_int_lo(a, magnitude_eid);
    let hi: u64 = expr_int_hi(a, magnitude_eid);
    if negative && lo == 0u64 && hi == 0u64 {
        return false;
    }
    let range: IntegerTypeRange = integer_tag_range(target_tag);
    let maximum: IntegerMagnitude = if negative {
        if !range.has_negative { return true; }
        range.negative_max
    } else {
        range.positive_max
    };
    integer_magnitude_exceeds(lo, hi, maximum)
}

fn wide_literal_decimal(a: AstArena, lit_eid: i64) -> String {
    let mut magnitude_eid: i64 = lit_eid;
    let mut negative: bool = false;
    if expr_tag(a, magnitude_eid) == EXPR_UNOP() && expr_a(a, magnitude_eid) == UNOP_NEG() {
        negative = true;
        magnitude_eid = expr_b(a, magnitude_eid);
    }
    if expr_tag(a, magnitude_eid) == EXPR_CAST() {
        magnitude_eid = expr_a(a, magnitude_eid);
    }
    let result: String = String::from("");
    if negative && !expr_folds_to_zero(a, magnitude_eid) {
        result.push_str(String::from("-"));
    }
    result.push_str(expr_int_text(a, magnitude_eid));
    result
}

fn integer_tag_range_text(tag: i64) -> String {
    if tag == CTY_I128() {
        return String::from(
            "-170141183460469231731687303715884105728..=170141183460469231731687303715884105727"
        );
    }
    if tag == CTY_U128() {
        return String::from("0..=340282366920938463463374607431768211455");
    }
    if tag == CTY_U64() {
        return String::from("0..=18446744073709551615");
    }
    let width: i64 = integer_tag_width(tag);
    let is_unsigned: bool = tag >= CTY_U8() && tag <= CTY_U128();
    let min_value: i64 = if is_unsigned {
        0
    } else if width == 64 {
        -9223372036854775807 - 1
    } else {
        -(1 << (width - 1))
    };
    let max_value: i64 = if width == 64 {
        9223372036854775807
    } else if is_unsigned {
        (1 << width) - 1
    } else {
        (1 << (width - 1)) - 1
    };
    let result: String = i64_to_string(min_value);
    result.push_str(String::from("..="));
    result.push_str(i64_to_string(max_value));
    result
}

fn wide_literal_range_message(a: AstArena, lit_eid: i64, target_tag: i64) -> String {
    let msg: String = String::from("literal ");
    msg.push_str(wide_literal_decimal(a, lit_eid));
    msg.push_str(String::from(" does not fit in "));
    msg.push_str(ty_tag_name(target_tag));
    msg.push_str(String::from(" (range "));
    msg.push_str(integer_tag_range_text(target_tag));
    msg.push_str(String::from(")"));
    msg
}

fn emit_literal_out_of_range(e: CheckEnv, a: AstArena, lit_eid: i64, target_tag: i64) {
    let hint: String = String::from("use a value in ");
    hint.push_str(integer_tag_range_text(target_tag));
    hint.push_str(String::from(" or choose an explicit narrowing intrinsic"));
    env_emit_error_code_hint(
        e, EC_LITERAL_OUT_OF_RANGE(),
        wide_literal_range_message(a, lit_eid, target_tag), expr_span(a, lit_eid), hint
    );
}

// 64- and 128-bit shifts additionally accept a count of the left operand's
// own type (docs/spec/grammar.md "Shift count type"); narrower ones are u32-only.
fn shift_own_type_count_allowed(width: i64) -> bool {
    width >= 64
}

// A constant shift count is out of range when negative or >= the shifted
// type's bit width. Reads both literal limbs so a magnitude of 2^64 or more is
// never truncated to its low 64 bits.
fn shift_count_out_of_range(a: AstArena, count_eid: i64, width: i64) -> bool {
    let mut magnitude_eid: i64 = count_eid;
    let mut negative: bool = false;
    if expr_tag(a, count_eid) == EXPR_UNOP() && expr_a(a, count_eid) == UNOP_NEG() {
        negative = true;
        magnitude_eid = expr_b(a, count_eid);
    }
    if expr_tag(a, magnitude_eid) != EXPR_LIT_INT() {
        return false;
    }
    let lo: u64 = expr_int_lo(a, magnitude_eid);
    let hi: u64 = expr_int_hi(a, magnitude_eid);
    if lo == 0u64 && hi == 0u64 {
        return false;
    }
    negative || hi != 0u64 || lo >= (width as u64)
}

fn check_integer_literal_range(e: CheckEnv, a: AstArena, lit_eid: i64, target_tag: i64) {
    if !expr_is_const_int(a, lit_eid) {
        if expr_tag(a, lit_eid) == EXPR_MATCH() {
            let arms_lid: i64 = expr_b(a, lit_eid);
            let n: i64 = list_len(a, arms_lid) / 2;
            let mut i: i64 = 0;
            while i < n {
                check_integer_literal_range(
                    e, a, list_get(a, arms_lid, i * 2 + 1), target_tag
                );
                i = i + 1;
            }
            return;
        }
        if expr_tag(a, lit_eid) == EXPR_LOOP() {
            let values: Vec<i64> = loop_break_value_eids(a, expr_a(a, lit_eid));
            let mut i: u64 = 0u64;
            while i < values.len() {
                check_integer_literal_range(e, a, values[i], target_tag);
                i = i + 1;
            }
            return;
        }
        if !checker_expr_is_coercible_int_marker(a, lit_eid) {
            return;
        }
        let tag: i64 = expr_tag(a, lit_eid);
        if tag == EXPR_UNOP() {
            let is_unsigned_target: bool =
                target_tag >= CTY_U8() && target_tag <= CTY_U128();
            if expr_a(a, lit_eid) == UNOP_NEG() && is_unsigned_target {
                let msg: String = String::from("unary negation is not allowed on unsigned type `");
                msg.push_str(ty_tag_name(target_tag));
                msg.push_str(String::from("`"));
                env_emit_error_code(e, EC_TYPE_MISMATCH(), msg, expr_span(a, lit_eid));
                return;
            }
            check_integer_literal_range(e, a, expr_b(a, lit_eid), target_tag);
            return;
        }
        if tag == EXPR_BINOP() {
            check_integer_literal_range(e, a, expr_b(a, lit_eid), target_tag);
            let op: i64 = expr_a(a, lit_eid);
            let rhs_target: i64 = if op == BINOP_SHL() || op == BINOP_SHR() {
                CTY_U32()
            } else {
                target_tag
            };
            check_integer_literal_range(e, a, expr_c(a, lit_eid), rhs_target);
            return;
        }
        if tag == EXPR_BLOCK() {
            let result_eid: i64 = checker_block_result_eid(a, expr_a(a, lit_eid));
            if result_eid != -1 {
                check_integer_literal_range(e, a, result_eid, target_tag);
            }
            return;
        }
        if tag == EXPR_IF() {
            let then_result: i64 = checker_block_result_eid(a, expr_b(a, lit_eid));
            if then_result != -1 {
                check_integer_literal_range(e, a, then_result, target_tag);
            }
            let else_eid: i64 = expr_c(a, lit_eid);
            if else_eid != -1 {
                check_integer_literal_range(e, a, else_eid, target_tag);
            }
            return;
        }
        return;
    }
    if integer_literal_out_of_range(a, lit_eid, target_tag) {
        emit_literal_out_of_range(e, a, lit_eid, target_tag);
    }
}

fn check_contextual_integer_literal_ranges(e: CheckEnv, a: AstArena, eid: i64, target_tid: i64) {
    if ty_is_integer(e.ts, target_tid) {
        check_integer_literal_range(e, a, eid, ty_tag(e.ts, target_tid));
        return;
    }
    let expr_kind: i64 = expr_tag(a, eid);
    if expr_kind == EXPR_BLOCK() {
        let result_eid: i64 = checker_block_result_eid(a, expr_a(a, eid));
        if result_eid != -1 {
            check_contextual_integer_literal_ranges(e, a, result_eid, target_tid);
        }
        return;
    }
    if expr_kind == EXPR_IF() {
        let then_result: i64 = checker_block_result_eid(a, expr_b(a, eid));
        if then_result != -1 {
            check_contextual_integer_literal_ranges(e, a, then_result, target_tid);
        }
        let else_eid: i64 = expr_c(a, eid);
        if else_eid != -1 {
            check_contextual_integer_literal_ranges(e, a, else_eid, target_tid);
        }
        return;
    }
    if expr_kind == EXPR_MATCH() {
        let arms_lid: i64 = expr_b(a, eid);
        let n: i64 = list_len(a, arms_lid) / 2;
        let mut i: i64 = 0;
        while i < n {
            check_contextual_integer_literal_ranges(
                e, a, list_get(a, arms_lid, i * 2 + 1), target_tid
            );
            i = i + 1;
        }
        return;
    }
    if expr_kind == EXPR_LOOP() {
        let values: Vec<i64> = loop_break_value_eids(a, expr_a(a, eid));
        let mut i: u64 = 0u64;
        while i < values.len() {
            check_contextual_integer_literal_ranges(e, a, values[i], target_tid);
            i = i + 1;
        }
        return;
    }
    if ty_tag(e.ts, target_tid) != CTY_APPLIED() || expr_kind != EXPR_ECTOR() {
        return;
    }
    let base_tid: i64 = ty_a(e.ts, target_tid);
    if ty_tag(e.ts, base_tid) != CTY_ENUM() {
        return;
    }
    let enum_name: String = ty_struct_name(e.ts, base_tid);
    let path_lid: i64 = expr_a(a, eid);
    if list_len(a, path_lid) < 2 || arena_str(a, list_get(a, path_lid, 0)) != enum_name {
        return;
    }
    let variant_name: String = arena_str(a, list_get(a, path_lid, 1));
    let payload_index: i64 = {
        if (enum_name == String::from("Option") && variant_name == String::from("Some")) ||
           (enum_name == String::from("Result") && variant_name == String::from("Ok")) {
            0
        } else if enum_name == String::from("Result") && variant_name == String::from("Err") {
            1
        } else {
            -1
        }
    };
    let target_args_lid: i64 = ty_b(e.ts, target_tid);
    let fields_lid: i64 = expr_b(a, eid);
    let payload_tid: i64 = if payload_index >= 0 &&
                              payload_index < ts_arg_len(e.ts, target_args_lid) {
        ts_arg_get(e.ts, target_args_lid, payload_index)
    } else {
        -1
    };
    let payload_tag: i64 = if payload_tid == -1 { -1 } else { ty_tag(e.ts, payload_tid) };
    if payload_tid != -1 &&
       (ty_is_integer(e.ts, payload_tid) || payload_tag == CTY_APPLIED()) &&
       list_len(a, fields_lid) > 0 {
        check_contextual_integer_literal_ranges(
            e, a, list_get(a, fields_lid, 0), payload_tid
        );
    }
}

fn default_literal_integer_tid(e: CheckEnv, tid: i64) -> i64 {
    let tag: i64 = ty_tag(e.ts, tid);
    if tag == CTY_LIT_INT() { return CTY_I64(); }
    if tag == CTY_APPLIED() {
        let args_lid: i64 = ty_b(e.ts, tid);
        let args: Vec<i64> = Vec::new();
        let mut i: i64 = 0;
        while i < ts_arg_len(e.ts, args_lid) {
            args.push(default_literal_integer_tid(e, ts_arg_get(e.ts, args_lid, i)));
            i = i + 1;
        }
        return ts_make_applied(e.ts, default_literal_integer_tid(e, ty_a(e.ts, tid)), args);
    }
    if tag == CTY_REF() {
        return ty_add(
            e.ts, CTY_REF(), default_literal_integer_tid(e, ty_a(e.ts, tid)), 0
        );
    }
    if tag == CTY_TUPLE() {
        let elems_lid: i64 = ty_a(e.ts, tid);
        let elems: Vec<i64> = Vec::new();
        let mut i: i64 = 0;
        while i < ts_arg_len(e.ts, elems_lid) {
            elems.push(default_literal_integer_tid(e, ts_arg_get(e.ts, elems_lid, i)));
            i = i + 1;
        }
        return ty_add(e.ts, CTY_TUPLE(), ts_add_args(e.ts, elems), 0);
    }
    tid
}

// The `index`-th type argument of a generic receiver, or Unknown when the
// receiver is malformed. Keeps a missing type argument from manufacturing a
// bogus expectation, matching the Rust checker's empty expectation list.
fn ts_arg_or_unknown(ts: TyStore, args_lid: i64, index: i64) -> i64 {
    if index < 0 || index >= ts_arg_len(ts, args_lid) { return CTY_UNKNOWN(); }
    ts_arg_get(ts, args_lid, index)
}

fn builtin_method_candidates(tyname: String) -> Vec<String> {
    let names: Vec<String> = Vec::new();
    if tyname == String::from("String") {
        names.push(String::from("len"));
        names.push(String::from("push_str"));
        names.push(String::from("eq"));
        names.push(String::from("contains"));
        names.push(String::from("byte_at"));
        names.push(String::from("push_byte"));
        names.push(String::from("substring"));
        names.push(String::from("parse_i64"));
        names.push(String::from("parse_u64"));
        names.push(String::from("clear"));
    } else if tyname == String::from("Vec") {
        names.push(String::from("len"));
        names.push(String::from("push"));
        names.push(String::from("pop"));
        names.push(String::from("clear"));
        names.push(String::from("truncate"));
    } else if tyname == String::from("HashMap") {
        names.push(String::from("len"));
        names.push(String::from("insert"));
        names.push(String::from("get"));
        names.push(String::from("contains_key"));
        names.push(String::from("remove"));
    } else if tyname == String::from("BTreeMap") {
        names.push(String::from("len"));
        names.push(String::from("insert"));
        names.push(String::from("get"));
        names.push(String::from("contains"));
    } else if tyname == String::from("Option") {
        names.push(String::from("unwrap"));
    } else if tyname == String::from("Result") {
        names.push(String::from("unwrap"));
    }
    names
}

fn emit_unknown_method(e: CheckEnv, a: AstArena, eid: i64, mname: String, tyname: String) {
    let msg: String = String::from("unknown method `");
    msg.push_str(mname);
    msg.push_str(String::from("` on type `"));
    msg.push_str(tyname);
    msg.push_str(String::from("`"));
    let mut hint: String = diag_candidate_hint(mname, builtin_method_candidates(tyname), String::from("methods"));
    if tyname == String::from("Vec") && mname == String::from("get") {
        hint = String::from("use `v[i]` to read an element; `Vec` has no `get`");
    }
    if hint.len() > 0 {
        env_emit_error_code_hint(e, EC_UNKNOWN_METHOD(), msg, expr_span(a, eid), hint);
    } else {
        env_emit_error_code(e, EC_UNKNOWN_METHOD(), msg, expr_span(a, eid));
    }
}

// Value-shaped builtin-method argument: the actual type must coerce to
// `target_tid`, mirroring the Rust checker's per-argument expected `Ty` from
// `method_argument_expectations`. Argument types come from the caller's
// pre-check loop; re-checking here would double-emit diagnostics and
// double-consume linear values.
fn check_method_argument_exact(
    e: CheckEnv, m: Module, a: AstArena, args_lid: i64, arg_tids: Vec<i64>, index: i64, target_tid: i64, mname: String
) {
    if index < 0 || index >= list_len(a, args_lid) { return; }
    let arg_eid: i64 = list_get(a, args_lid, index);
    check_contextual_integer_literal_ranges(e, a, arg_eid, target_tid);
    if is_opaque(target_tid) { return; }
    if index >= arg_tids.len() as i64 { return; }
    let arg_tid: i64 = arg_tids[index as u64];
    if is_unknown(arg_tid) { return; }
    if never_is_not_a_value(e, m, arg_eid, arg_tid, target_tid) || !is_coercible(e.ts, arg_tid, target_tid) {
        let msg: String = String::from("argument has type `");
        msg.push_str(ty_full_display_name(e.ts, arg_tid));
        msg.push_str(String::from("` but `"));
        msg.push_str(mname);
        msg.push_str(String::from("` expects `"));
        msg.push_str(ty_value_display_name(e.ts, target_tid));
        msg.push_str(String::from("`"));
        env_emit_error_code(e, EC_TYPE_MISMATCH(), msg, expr_span(a, arg_eid));
    }
}

fn check_block(e: CheckEnv, m: Module, bid: i64) -> i64 [io] {
    let a: AstArena = m.arena;
    env_push_scope(e);
    let stmts_lid: i64 = blk_stmts(a, bid);
    let n: i64 = list_len(a, stmts_lid);
    let mut result_tid: i64 = CTY_UNIT();
    let mut i: i64 = 0;
    while i < n {
        let sid: i64 = list_get(a, stmts_lid, i);
        let stag: i64 = stmt_tag(a, sid);
        if stag == STMT_LET() {
            let pat_pid: i64 = stmt_a(a, sid);
            let annot_ast_tid: i64 = stmt_b(a, sid);
            let init_eid: i64 = stmt_c(a, sid);
            let init_tid: i64 = check_expr(e, m, init_eid);
            let bound_tid: i64 = if annot_ast_tid == -1 {
                let defaulted_tid: i64 = default_literal_integer_tid(e, init_tid);
                check_contextual_integer_literal_ranges(e, a, init_eid, defaulted_tid);
                defaulted_tid
            } else {
                let at_tid: i64 = resolve_ast_ty(e, m, annot_ast_tid);
                check_contextual_integer_literal_ranges(e, a, init_eid, at_tid);
                if !is_coercible(e.ts, init_tid, at_tid) {
                    env_emit_error(e, String::from("let binding type mismatch"), stmt_span(a, sid));
                }
                if is_vec_raw_parts_copy_expr(a, init_eid) && !is_flat_vec_tid(e.ts, at_tid) {
                    env_emit_error(e, String::from("Vec::from_raw_parts_copy requires a flat scalar Vec<T>"), stmt_span(a, sid));
                }
                at_tid
            };
            bind_pattern(e, m, pat_pid, init_eid, bound_tid, stmt_span(a, sid));
            result_tid = CTY_UNIT();
        } else {
            let eid: i64 = stmt_a(a, sid);
            let has_semi: i64 = stmt_b(a, sid);
            let etid: i64 = check_expr(e, m, eid);
            if has_semi == 0 && i == n - 1 {
                result_tid = etid;
            } else if expr_diverges(e, m, eid) {
                result_tid = CTY_NEVER();
            } else {
                result_tid = CTY_UNIT();
            }
        }
        i = i + 1;
    }
    let trail: i64 = blk_trail(a, bid);
    let final_tid: i64 = if trail != -1 {
        check_expr(e, m, trail)
    } else {
        result_tid
    };
    env_pop_scope(e);
    final_tid
}

// `let` binds only irrefutable identifier/wildcard/tuple patterns, and tuple
// patterns only against a syntactic tuple-literal initializer of matching
// arity -- tuple values have no IR-lowering representation, so destructuring
// is a compile-time desugaring into per-element `let`s, never a runtime
// projection. Every rejected shape must emit EC_UNSUPPORTED_PATTERN rather
// than silently binding nothing.
fn bind_pattern(e: CheckEnv, m: Module, pid: i64, init_eid: i64, tid: i64, decl_span: i64) [io] {
    let a: AstArena = m.arena;
    let tag: i64 = pat_tag(a, pid);
    if tag == PAT_IDENT() {
        let name_sid: i64 = pat_a(a, pid);
        let name: String = arena_str(a, name_sid);
        let is_mut: i64 = pat_b(a, pid);
        env_define_var_m(e, name, tid, is_mut, decl_span);
        return;
    }
    if tag == PAT_WILD() {
        return;
    }
    if tag == PAT_TUPLE() {
        bind_tuple_pattern(e, m, pid, init_eid, tid, decl_span);
        return;
    }
    env_emit_error_code_hint(
        e,
        EC_UNSUPPORTED_PATTERN(),
        String::from("let bindings only support identifier, wildcard, and tuple patterns"),
        pat_span(a, pid),
        String::from("refutable patterns (literals, enum variants, struct fields, or-patterns) are not allowed in `let`"),
    );
}

fn bind_tuple_pattern(e: CheckEnv, m: Module, pid: i64, init_eid: i64, tid: i64, decl_span: i64) [io] {
    let a: AstArena = m.arena;
    let pats_lid: i64 = pat_a(a, pid);
    let n: i64 = list_len(a, pats_lid);
    let ty_ok: bool = ty_tag(e.ts, tid) == CTY_TUPLE() && ts_arg_len(e.ts, ty_a(e.ts, tid)) == n;
    let init_ok: bool = init_eid != -1 && expr_tag(a, init_eid) == EXPR_TUPLE() && list_len(a, expr_a(a, init_eid)) == n;
    if !ty_ok || !init_ok {
        env_emit_error_code_hint(
            e,
            EC_UNSUPPORTED_PATTERN(),
            String::from("tuple destructuring requires a tuple literal initializer with matching arity"),
            pat_span(a, pid),
            String::from("rewrite as `let (a, b) = (expr1, expr2);` with one element per pattern slot"),
        );
        return;
    }
    let elems_lid: i64 = ty_a(e.ts, tid);
    let init_elems_lid: i64 = expr_a(a, init_eid);
    let mut i: i64 = 0;
    while i < n {
        let sub_pid: i64 = list_get(a, pats_lid, i);
        let sub_tid: i64 = ts_arg_get(e.ts, elems_lid, i);
        let sub_init_eid: i64 = list_get(a, init_elems_lid, i);
        if is_linear_ty(e, sub_tid) != 0 {
            let linear_hint: String = String::from("`");
            linear_hint.push_str(ty_value_display_name(e.ts, sub_tid));
            linear_hint.push_str(String::from("` is linear; bind the whole tuple's owner separately instead"));
            env_emit_error_code_hint(
                e,
                EC_UNSUPPORTED_PATTERN(),
                String::from("tuple destructuring cannot bind a linear-typed element"),
                pat_span(a, sub_pid),
                linear_hint,
            );
        } else {
            bind_pattern(e, m, sub_pid, sub_init_eid, sub_tid, decl_span);
        }
        i = i + 1;
    }
}

fn enum_name_from_tid(ts: TyStore, tid: i64) -> String {
    let tag: i64 = ty_tag(ts, tid);
    if tag == CTY_ENUM() {
        let name_idx: i64 = ty_a(ts, tid);
        return ts.strs[name_idx as u64];
    }
    if tag == CTY_APPLIED() || tag == CTY_REF() {
        let base_tid: i64 = ty_a(ts, tid);
        return enum_name_from_tid(ts, base_tid);
    }
    String::from("")
}

fn enum_pattern_matches_tid(ts: TyStore, a: AstArena, pid: i64, tid: i64) -> bool {
    if pat_tag(a, pid) != PAT_ENUM() {
        return false;
    }
    let path_lid: i64 = pat_a(a, pid);
    if list_len(a, path_lid) != 2 {
        return false;
    }
    let qualifier: String = arena_str(a, list_get(a, path_lid, 0));
    qualifier == enum_name_from_tid(ts, tid)
}

fn lookup_variant_payload(e: CheckEnv, enum_idx: i64, variant_name: String, field_idx: i64) -> i64 {
    let vname_lid: i64 = e.edef_vname_lids[enum_idx as u64];
    let nv: i64 = e.edef_variant_count[enum_idx as u64];
    let mut i: i64 = 0;
    while i < nv {
        let vsid: i64 = ts_arg_get(e.ts, vname_lid, i);
        let ts: TyStore = e.ts;
        let vname: String = ts.strs[vsid as u64];
        if vname == variant_name {
            let vpayload_lid: i64 = e.edef_vpayload_lids[enum_idx as u64];
            let fields_lid: i64 = ts_arg_get(e.ts, vpayload_lid, i);
            let n_fields: i64 = ts_arg_len(e.ts, fields_lid);
            if field_idx < n_fields {
                return ts_arg_get(e.ts, fields_lid, field_idx);
            }
            return CTY_UNIT();
        }
        i = i + 1;
    }
    CTY_UNIT()
}

fn lookup_variant_payload_count(e: CheckEnv, enum_idx: i64, variant_name: String) -> i64 {
    let vname_lid: i64 = e.edef_vname_lids[enum_idx as u64];
    let nv: i64 = e.edef_variant_count[enum_idx as u64];
    let mut i: i64 = 0;
    while i < nv {
        let vsid: i64 = ts_arg_get(e.ts, vname_lid, i);
        let ts: TyStore = e.ts;
        if ts.strs[vsid as u64] == variant_name {
            let vpayload_lid: i64 = e.edef_vpayload_lids[enum_idx as u64];
            let fields_lid: i64 = ts_arg_get(e.ts, vpayload_lid, i);
            return ts_arg_len(e.ts, fields_lid);
        }
        i = i + 1;
    }
    -1
}

// Built-in Option/Result are not registered in `env`; derive their tuple
// payload types from the scrutinee's applied type arguments instead, so a
// `match Option::Some(x)` arm binds `x` to the right type (mirrors the Rust
// checker's bind_arm_pattern builtin special-case).
fn builtin_variant_payload(ts: TyStore, scrutinee_tid: i64, enum_name: String, variant_name: String, field_idx: i64) -> i64 {
    if ty_tag(ts, scrutinee_tid) != CTY_APPLIED() {
        return CTY_UNIT();
    }
    let args_lid: i64 = ty_b(ts, scrutinee_tid);
    let n: i64 = ts_arg_len(ts, args_lid);
    if enum_name == String::from("Option") && variant_name == String::from("Some") && field_idx == 0 && n >= 1 {
        return ts_arg_get(ts, args_lid, 0);
    }
    if enum_name == String::from("Result") && variant_name == String::from("Ok") && field_idx == 0 && n >= 1 {
        return ts_arg_get(ts, args_lid, 0);
    }
    if enum_name == String::from("Result") && variant_name == String::from("Err") && field_idx == 0 && n >= 2 {
        return ts_arg_get(ts, args_lid, 1);
    }
    CTY_UNIT()
}

fn builtin_variant_payload_count(enum_name: String, variant_name: String) -> i64 {
    if enum_name == String::from("Option") {
        if variant_name == String::from("Some") { return 1; }
        if variant_name == String::from("None") { return 0; }
    }
    if enum_name == String::from("Result") {
        if variant_name == String::from("Ok") || variant_name == String::from("Err") { return 1; }
    }
    -1
}

fn validate_arm_pattern(e: CheckEnv, m: Module, pid: i64, is_last: bool) -> bool [io] {
    let a: AstArena = m.arena;
    let tag: i64 = pat_tag(a, pid);
    if tag == PAT_WILD() {
        if !is_last {
            env_emit_error_code_hint(e, EC_UNSUPPORTED_PATTERN(), String::from("catchall match patterns must be the final arm"), pat_span(a, pid), String::from("move the catchall pattern to the final match arm"));
            return false;
        }
        return true;
    }
    if tag == PAT_IDENT() {
        if pat_b(a, pid) == 0 {
            if !is_last {
                env_emit_error_code_hint(e, EC_UNSUPPORTED_PATTERN(), String::from("catchall match patterns must be the final arm"), pat_span(a, pid), String::from("move the catchall pattern to the final match arm"));
                return false;
            }
            return true;
        }
        env_emit_error_code_hint(e, EC_UNSUPPORTED_PATTERN(), String::from("mutable identifier patterns are not supported"), pat_span(a, pid), String::from("remove `mut` from the identifier binding"));
        return false;
    }
    if tag == PAT_ENUM() {
        let path_lid: i64 = pat_a(a, pid);
        if list_len(a, path_lid) != 2 {
            env_emit_error_code_hint(e, EC_UNSUPPORTED_PATTERN(), String::from("enum variant patterns must use a qualified `Enum::Variant` path"), pat_span(a, pid), String::from("qualify the variant with its enum name"));
            return false;
        }
        let inner_lid: i64 = pat_b(a, pid);
        let n_inner: i64 = list_len(a, inner_lid);
        let mut i: i64 = 0;
        while i < n_inner {
            let inner_pid: i64 = list_get(a, inner_lid, i);
            let inner_tag: i64 = pat_tag(a, inner_pid);
            let supported_ident: bool = inner_tag == PAT_IDENT() && pat_b(a, inner_pid) == 0;
            if inner_tag != PAT_WILD() && !supported_ident {
                env_emit_error_code_hint(e, EC_UNSUPPORTED_PATTERN(), String::from("nested enum payload patterns are not supported"), pat_span(a, pid), String::from("bind each payload to an immutable identifier and inspect it separately"));
                return false;
            }
            i = i + 1;
        }
        return true;
    }
    if tag == PAT_LIT() {
        env_emit_error_code_hint(e, EC_UNSUPPORTED_PATTERN(), String::from("literal match patterns are not supported"), pat_span(a, pid), String::from("use `if`/`else` comparisons for literal values"));
    } else if tag == PAT_TUPLE() {
        env_emit_error_code_hint(e, EC_UNSUPPORTED_PATTERN(), String::from("tuple match patterns are not supported"), pat_span(a, pid), String::from("access tuple elements explicitly instead of destructuring in `match`"));
    } else if tag == PAT_STRUCT() {
        env_emit_error_code_hint(e, EC_UNSUPPORTED_PATTERN(), String::from("struct match patterns are not supported"), pat_span(a, pid), String::from("access struct fields explicitly instead of destructuring in `match`"));
    } else if tag == PAT_OR() {
        env_emit_error_code_hint(e, EC_UNSUPPORTED_PATTERN(), String::from("or-patterns are not supported"), pat_span(a, pid), String::from("write a separate match arm for each enum variant"));
    } else {
        env_emit_error_code(e, EC_UNSUPPORTED_PATTERN(), String::from("pattern form is not supported"), pat_span(a, pid));
    }
    false
}

fn is_enum_match_tid(ts: TyStore, tid: i64) -> bool {
    let tag: i64 = ty_tag(ts, tid);
    if tag == CTY_ENUM() {
        return true;
    }
    if tag == CTY_APPLIED() {
        return ty_tag(ts, ty_a(ts, tid)) == CTY_ENUM();
    }
    false
}

// Built-in generic enums have no edef_* entry; their variant sets are fixed.
fn builtin_enum_variant_names(enum_name: String) -> Vec<String> {
    let names: Vec<String> = Vec::new();
    if enum_name == String::from("Option") {
        names.push(String::from("Some"));
        names.push(String::from("None"));
        return names;
    }
    if enum_name == String::from("Result") {
        names.push(String::from("Ok"));
        names.push(String::from("Err"));
        return names;
    }
    names
}

fn check_exhaustive(e: CheckEnv, m: Module, scrutinee_tid: i64, arms_lid: i64, n_arms: i64, span: i64) {
    let a: AstArena = m.arena;
    if n_arms > 0 {
        let last_pid: i64 = list_get(a, arms_lid, (n_arms - 1) * 2);
        let last_tag: i64 = pat_tag(a, last_pid);
        if last_tag == PAT_WILD() {
            return;
        }
        if last_tag == PAT_IDENT() && pat_b(a, last_pid) == 0 {
            return;
        }
    }
    let enum_name: String = enum_name_from_tid(e.ts, scrutinee_tid);
    let builtin_names: Vec<String> = builtin_enum_variant_names(enum_name);
    let enum_idx: i64 = env_lookup_enum(e, enum_name);
    if enum_idx == -1 && builtin_names.len() == 0u64 {
        return;
    }
    let covered: Vec<String> = Vec::new();
    let mut j: i64 = 0;
    while j < n_arms {
        let pid: i64 = list_get(a, arms_lid, j * 2);
        if pat_tag(a, pid) == PAT_ENUM() {
            let path_lid: i64 = pat_a(a, pid);
            let path_len: i64 = list_len(a, path_lid);
            if path_len > 0 {
                let variant_name: String = arena_str(a, list_get(a, path_lid, path_len - 1));
                if !handled_variant_contains(covered, variant_name) {
                    covered.push(variant_name);
                }
            }
        }
        j = j + 1;
    }
    let missing: Vec<String> = Vec::new();
    if builtin_names.len() > 0u64 {
        let mut bi: u64 = 0u64;
        while bi < builtin_names.len() {
            let vname: String = builtin_names[bi];
            if !handled_variant_contains(covered, vname) {
                missing.push(vname);
            }
            bi = bi + 1;
        }
    } else {
        let vname_lid: i64 = e.edef_vname_lids[enum_idx as u64];
        let nv: i64 = e.edef_variant_count[enum_idx as u64];
        let mut k: i64 = 0;
        while k < nv {
            let vsid: i64 = ts_arg_get(e.ts, vname_lid, k);
            let ts: TyStore = e.ts;
            let vname: String = ts.strs[vsid as u64];
            if !handled_variant_contains(covered, vname) {
                missing.push(vname);
            }
            k = k + 1;
        }
    }
    if missing.len() > 0u64 {
        let joined: String = string_join(missing, String::from(", "));
        let msg: String = String::from("non-exhaustive match: missing patterns: ");
        msg.push_str(joined);
        let d: Diagnostic = env_error_diag(e, EC_NON_EXHAUSTIVE_MATCH(), msg, span);
        let hint1: String = String::from("add arms for: ");
        hint1.push_str(joined);
        diag_add_hint(d, hint1);
        diag_add_hint(d, String::from("or add a wildcard '_' arm to match remaining patterns"));
        let dctx: DiagCtx = e.dctx;
        diag_ctx_emit(dctx, d);
    }
}

fn pattern_aggregate_name(ts: TyStore, tid: i64) -> String {
    let tag: i64 = ty_tag(ts, tid);
    if tag == CTY_STR() {
        return String::from("String");
    }
    if tag == CTY_STRUCT() || tag == CTY_ENUM() {
        return ty_struct_name(ts, tid);
    }
    if tag == CTY_APPLIED() || tag == CTY_REF() {
        return pattern_aggregate_name(ts, ty_a(ts, tid));
    }
    String::from("")
}

fn pattern_vec_elem_path(ts: TyStore, tid: i64) -> Vec<String> {
    let result: Vec<String> = Vec::new();
    let tag: i64 = ty_tag(ts, tid);
    if tag == CTY_REF() {
        return pattern_vec_elem_path(ts, ty_a(ts, tid));
    }
    if tag != CTY_APPLIED() {
        return result;
    }
    if pattern_aggregate_name(ts, ty_a(ts, tid)) != String::from("Vec") {
        return result;
    }
    let args_lid: i64 = ty_b(ts, tid);
    if ts_arg_len(ts, args_lid) == 0 {
        return result;
    }
    let elem_tid: i64 = ts_arg_get(ts, args_lid, 0);
    let elem_name: String = pattern_aggregate_name(ts, elem_tid);
    if elem_name.len() == 0 {
        return result;
    }
    result.push(elem_name);
    if elem_name == String::from("Vec") {
        let nested: Vec<String> = pattern_vec_elem_path(ts, elem_tid);
        let mut i: u64 = 0u64;
        while i < nested.len() {
            result.push(nested[i]);
            i = i + 1;
        }
    }
    result
}

fn pattern_aggregate_is_linear(e: CheckEnv, tid: i64) -> i64 {
    is_linear_owner_ty(e, tid)
}

fn pattern_option_elem_ir_ty(ts: TyStore, tid: i64) -> i64 {
    if ty_tag(ts, tid) == CTY_REF() {
        return pattern_option_elem_ir_ty(ts, ty_a(ts, tid));
    }
    let args_lid: i64 = ty_applied_args(ts, tid, CTY_ENUM(), String::from("Option"));
    if args_lid < 0 { return -1; }
    if ts_arg_len(ts, args_lid) == 0 {
        return -1;
    }
    let elem_tag: i64 = ty_tag(ts, ts_arg_get(ts, args_lid, 0));
    if elem_tag == CTY_I8() { return ITY_I8(); }
    if elem_tag == CTY_I16() { return ITY_I16(); }
    if elem_tag == CTY_I32() { return ITY_I32(); }
    if elem_tag == CTY_I64() { return ITY_I64(); }
    if elem_tag == CTY_I128() { return ITY_I128(); }
    if elem_tag == CTY_U8() { return ITY_U8(); }
    if elem_tag == CTY_U16() { return ITY_U16(); }
    if elem_tag == CTY_U32() { return ITY_U32(); }
    if elem_tag == CTY_U64() { return ITY_U64(); }
    if elem_tag == CTY_U128() { return ITY_U128(); }
    if elem_tag == CTY_F32() { return ITY_F32(); }
    if elem_tag == CTY_F64() { return ITY_F64(); }
    if elem_tag == CTY_BOOL() { return ITY_BOOL(); }
    -1
}

fn pattern_scalar_ir_ty(ts: TyStore, tid: i64) -> i64 {
    let elem_tag: i64 = ty_tag(ts, tid);
    if elem_tag == CTY_I8() { return ITY_I8(); }
    if elem_tag == CTY_I16() { return ITY_I16(); }
    if elem_tag == CTY_I32() { return ITY_I32(); }
    if elem_tag == CTY_I64() { return ITY_I64(); }
    if elem_tag == CTY_I128() { return ITY_I128(); }
    if elem_tag == CTY_U8() { return ITY_U8(); }
    if elem_tag == CTY_U16() { return ITY_U16(); }
    if elem_tag == CTY_U32() { return ITY_U32(); }
    if elem_tag == CTY_U64() { return ITY_U64(); }
    if elem_tag == CTY_U128() { return ITY_U128(); }
    if elem_tag == CTY_F32() { return ITY_F32(); }
    if elem_tag == CTY_F64() { return ITY_F64(); }
    if elem_tag == CTY_BOOL() { return ITY_BOOL(); }
    -1
}

fn extractable_payload_ir_ty(ts: TyStore, tid: i64) -> i64 {
    let scalar: i64 = pattern_scalar_ir_ty(ts, tid);
    if scalar == ITY_I128() || scalar == ITY_U128() { return -1; }
    scalar
}

fn pattern_variant_payload_ir_tys(ts: TyStore, tid: i64) -> Vec<i64> {
    if ty_tag(ts, tid) == CTY_REF() {
        return pattern_variant_payload_ir_tys(ts, ty_a(ts, tid));
    }
    let result: Vec<i64> = Vec::new();
    if ty_tag(ts, tid) != CTY_APPLIED() {
        return result;
    }
    let base: i64 = ty_a(ts, tid);
    if ty_tag(ts, base) != CTY_ENUM() {
        return result;
    }
    let name: String = ty_struct_name(ts, base);
    let args_lid: i64 = ty_b(ts, tid);
    if name == String::from("Option") {
        result.push(-1);
        if ts_arg_len(ts, args_lid) > 0 {
            result.push(pattern_scalar_ir_ty(ts, ts_arg_get(ts, args_lid, 0)));
        } else {
            result.push(-1);
        }
    } else if name == String::from("Result") {
        if ts_arg_len(ts, args_lid) > 0 {
            result.push(pattern_scalar_ir_ty(ts, ts_arg_get(ts, args_lid, 0)));
        } else {
            result.push(-1);
        }
        if ts_arg_len(ts, args_lid) > 1 {
            result.push(pattern_scalar_ir_ty(ts, ts_arg_get(ts, args_lid, 1)));
        } else {
            result.push(-1);
        }
    }
    result
}

fn pattern_vec_option_elem_ty_path(ts: TyStore, tid: i64) -> Vec<i64> {
    let result: Vec<i64> = Vec::new();
    let tag: i64 = ty_tag(ts, tid);
    if tag == CTY_REF() {
        return pattern_vec_option_elem_ty_path(ts, ty_a(ts, tid));
    }
    if tag != CTY_APPLIED() || pattern_aggregate_name(ts, ty_a(ts, tid)) != String::from("Vec") {
        return result;
    }
    let args_lid: i64 = ty_b(ts, tid);
    if ts_arg_len(ts, args_lid) == 0 {
        return result;
    }
    let elem_tid: i64 = ts_arg_get(ts, args_lid, 0);
    let elem_name: String = pattern_aggregate_name(ts, elem_tid);
    if elem_name.len() == 0 {
        return result;
    }
    result.push(pattern_option_elem_ir_ty(ts, elem_tid));
    if elem_name == String::from("Vec") {
        let nested: Vec<i64> = pattern_vec_option_elem_ty_path(ts, elem_tid);
        let mut i: u64 = 0u64;
        while i < nested.len() {
            result.push(nested[i]);
            i = i + 1;
        }
    }
    result
}

fn pattern_vec_variant_payload_ty_path(ts: TyStore, tid: i64) -> Vec<Vec<i64>> {
    let result: Vec<Vec<i64>> = Vec::new();
    let tag: i64 = ty_tag(ts, tid);
    if tag == CTY_REF() {
        return pattern_vec_variant_payload_ty_path(ts, ty_a(ts, tid));
    }
    if tag != CTY_APPLIED() || pattern_aggregate_name(ts, ty_a(ts, tid)) != String::from("Vec") {
        return result;
    }
    let args_lid: i64 = ty_b(ts, tid);
    if ts_arg_len(ts, args_lid) == 0 {
        return result;
    }
    let elem_tid: i64 = ts_arg_get(ts, args_lid, 0);
    let elem_name: String = pattern_aggregate_name(ts, elem_tid);
    if elem_name.len() == 0 {
        return result;
    }
    result.push(pattern_variant_payload_ir_tys(ts, elem_tid));
    if elem_name == String::from("Vec") {
        let nested: Vec<Vec<i64>> = pattern_vec_variant_payload_ty_path(ts, elem_tid);
        let mut i: u64 = 0u64;
        while i < nested.len() {
            result.push(nested[i]);
            i = i + 1;
        }
    }
    result
}

// Records payload scalar or aggregate metadata for an expression that extracts an
// Option/Result payload via FieldGet. Both `?` and `.unwrap()` register here;
// the arrays are keyed by expression id, so the two never collide.
fn record_extracted_payload(e: CheckEnv, eid: i64, payload_tid: i64) {
    let scalar: i64 = extractable_payload_ir_ty(e.ts, payload_tid);
    if scalar != -1 {
        while e.question_scalar_tys.len() as i64 <= eid {
            e.question_scalar_tys.push(-1);
        }
        e.question_scalar_tys[eid as u64] = scalar;
    }
    let aggregate_name: String = pattern_aggregate_name(e.ts, payload_tid);
    if aggregate_name.len() == 0 {
        return;
    }
    while e.question_aggregate_names.len() as i64 <= eid {
        e.question_aggregate_names.push(String::from(""));
        e.question_vec_elem_paths.push(Vec::new());
        e.question_vec_option_elem_ty_paths.push(Vec::new());
        e.question_option_elem_tys.push(-1);
        e.question_aggregate_linear.push(0);
    }
    e.question_aggregate_names[eid as u64] = aggregate_name;
    e.question_vec_elem_paths[eid as u64] = pattern_vec_elem_path(e.ts, payload_tid);
    e.question_vec_option_elem_ty_paths[eid as u64] = pattern_vec_option_elem_ty_path(e.ts, payload_tid);
    e.question_option_elem_tys[eid as u64] = pattern_option_elem_ir_ty(e.ts, payload_tid);
    e.question_aggregate_linear[eid as u64] = pattern_aggregate_is_linear(e, payload_tid);
}

fn bind_arm_pattern(e: CheckEnv, m: Module, pid: i64, scrutinee_tid: i64) [io] {
    let a: AstArena = m.arena;
    let tag: i64 = pat_tag(a, pid);
    if tag == PAT_WILD() {
        return;
    }
    if tag == PAT_IDENT() {
        let name_sid: i64 = pat_a(a, pid);
        let name: String = arena_str(a, name_sid);
        let scalar: i64 = extractable_payload_ir_ty(e.ts, scrutinee_tid);
        if scalar != -1 {
            while e.pat_scalar_tys.len() as i64 <= pid {
                e.pat_scalar_tys.push(-1);
            }
            e.pat_scalar_tys[pid as u64] = scalar;
        }
        let aggregate_name: String = pattern_aggregate_name(e.ts, scrutinee_tid);
        if aggregate_name.len() > 0 {
            while e.pat_aggregate_names.len() as i64 <= pid {
                e.pat_aggregate_names.push(String::from(""));
                e.pat_vec_elem_paths.push(Vec::new());
                e.pat_vec_option_elem_ty_paths.push(Vec::new());
                e.pat_vec_variant_payload_ty_paths.push(Vec::new());
                e.pat_option_elem_tys.push(-1);
                e.pat_variant_payload_tys.push(Vec::new());
                e.pat_aggregate_linear.push(0);
            }
            e.pat_aggregate_names[pid as u64] = aggregate_name;
            e.pat_vec_elem_paths[pid as u64] = pattern_vec_elem_path(e.ts, scrutinee_tid);
            e.pat_vec_option_elem_ty_paths[pid as u64] = pattern_vec_option_elem_ty_path(e.ts, scrutinee_tid);
            e.pat_vec_variant_payload_ty_paths[pid as u64] = pattern_vec_variant_payload_ty_path(e.ts, scrutinee_tid);
            e.pat_option_elem_tys[pid as u64] = pattern_option_elem_ir_ty(e.ts, scrutinee_tid);
            e.pat_variant_payload_tys[pid as u64] = pattern_variant_payload_ir_tys(e.ts, scrutinee_tid);
            e.pat_aggregate_linear[pid as u64] = pattern_aggregate_is_linear(e, scrutinee_tid);
        }
        env_define_var(e, name, scrutinee_tid);
        return;
    }
    if tag == PAT_LIT() {
        return;
    }
    if tag == PAT_ENUM() {
        let path_lid: i64 = pat_a(a, pid);
        let inner_lid: i64 = pat_b(a, pid);
        let n_inner: i64 = list_len(a, inner_lid);
        let n_path: i64 = list_len(a, path_lid);
        let variant_sid: i64 = if n_path >= 2 {
            list_get(a, path_lid, n_path - 1)
        } else if n_path == 1 {
            list_get(a, path_lid, 0)
        } else {
            -1
        };
        let enum_name: String = enum_name_from_tid(e.ts, scrutinee_tid);
        if !enum_pattern_matches_tid(e.ts, a, pid, scrutinee_tid) {
            let qualifier: String = if n_path > 0 {
                arena_str(a, list_get(a, path_lid, 0))
            } else {
                String::from("<missing>")
            };
            let message: String = String::from("pattern enum `");
            message.push_str(qualifier);
            message.push_str(String::from("` does not match scrutinee enum `"));
            message.push_str(enum_name);
            message.push_str(String::from("`"));
            env_emit_error_code(e, EC_TYPE_MISMATCH(), message, pat_span(a, pid));
            return;
        }
        let enum_idx: i64 = env_lookup_enum(e, enum_name);
        let variant_name: String = if variant_sid != -1 { arena_str(a, variant_sid) } else { String::from("") };
        // Built-in Option/Result aren't in `env`; a registered (user) enum wins,
        // else take payload types from the scrutinee's applied args.
        let is_builtin_enum: bool =
            enum_name == String::from("Option") || enum_name == String::from("Result");
        let expected_payloads: i64 = if enum_idx != -1 && variant_sid != -1 {
            lookup_variant_payload_count(e, enum_idx, variant_name)
        } else if is_builtin_enum && variant_sid != -1 {
            builtin_variant_payload_count(enum_name, variant_name)
        } else {
            -1
        };
        if expected_payloads >= 0 && n_inner != expected_payloads {
            let message: String = String::from("variant pattern expects ");
            message.push_str(i64_to_string(expected_payloads));
            message.push_str(String::from(" payload bindings, found "));
            message.push_str(i64_to_string(n_inner));
            env_emit_error_code(e, EC_UNSUPPORTED_PATTERN(), message, pat_span(a, pid));
        }
        let mut i: i64 = 0;
        while i < n_inner {
            let ipid: i64 = list_get(a, inner_lid, i);
            let field_tid: i64 = if enum_idx != -1 && variant_sid != -1 {
                lookup_variant_payload(e, enum_idx, variant_name, i)
            } else if is_builtin_enum && variant_sid != -1 {
                builtin_variant_payload(e.ts, scrutinee_tid, enum_name, variant_name, i)
            } else {
                CTY_UNIT()
            };
            if pat_tag(a, ipid) == PAT_WILD() && is_linear_owner_ty(e, field_tid) == 1 {
                env_emit_error_code(
                    e,
                    EC_LINEAR_TYPE_VIOLATION(),
                    String::from("wildcard pattern discards a linear value; bind it to an identifier and consume it explicitly"),
                    pat_span(a, ipid),
                );
            }
            bind_arm_pattern(e, m, ipid, field_tid);
            i = i + 1;
        }
        return;
    }
    if tag == PAT_STRUCT() {
        let fields_lid: i64 = pat_b(a, pid);
        let n_pairs: i64 = list_len(a, fields_lid);
        let n_fields: i64 = n_pairs / 2;
        let mut i: i64 = 0;
        while i < n_fields {
            let fpid: i64 = list_get(a, fields_lid, i * 2 + 1);
            bind_arm_pattern(e, m, fpid, CTY_UNIT());
            i = i + 1;
        }
        return;
    }
    if tag == PAT_TUPLE() {
        let elems_lid: i64 = pat_a(a, pid);
        let n: i64 = list_len(a, elems_lid);
        let mut i: i64 = 0;
        while i < n {
            let epid: i64 = list_get(a, elems_lid, i);
            bind_arm_pattern(e, m, epid, CTY_UNIT());
            i = i + 1;
        }
        return;
    }
}

fn handled_variant_contains(handled: Vec<String>, name: String) -> bool {
    let mut i: u64 = 0u64;
    while i < handled.len() {
        if handled[i] == name {
            return true;
        }
        i = i + 1;
    }
    false
}

fn unhandled_variant_owns_linear_payload(e: CheckEnv, scrutinee_tid: i64, handled: Vec<String>) -> bool {
    let enum_name: String = enum_name_from_tid(e.ts, scrutinee_tid);
    let enum_idx: i64 = env_lookup_enum(e, enum_name);
    if enum_idx != -1 {
        let variant_names_lid: i64 = e.edef_vname_lids[enum_idx as u64];
        let variant_payloads_lid: i64 = e.edef_vpayload_lids[enum_idx as u64];
        let nvariants: i64 = e.edef_variant_count[enum_idx as u64];
        let mut vi: i64 = 0;
        while vi < nvariants {
            let variant_sid: i64 = ts_arg_get(e.ts, variant_names_lid, vi);
            let ts: TyStore = e.ts;
            let variant_name: String = ts.strs[variant_sid as u64];
            if !handled_variant_contains(handled, variant_name) {
                let payload_lid: i64 = ts_arg_get(e.ts, variant_payloads_lid, vi);
                let mut pi: i64 = 0;
                while pi < ts_arg_len(e.ts, payload_lid) {
                    if is_linear_owner_ty(e, ts_arg_get(e.ts, payload_lid, pi)) == 1 {
                        return true;
                    }
                    pi = pi + 1;
                }
            }
            vi = vi + 1;
        }
        return false;
    }

    if ty_tag(e.ts, scrutinee_tid) != CTY_APPLIED() {
        return false;
    }
    let args_lid: i64 = ty_b(e.ts, scrutinee_tid);
    if enum_name == String::from("Option") {
        return !handled_variant_contains(handled, String::from("Some")) &&
            ts_arg_len(e.ts, args_lid) >= 1 &&
            is_linear_owner_ty(e, ts_arg_get(e.ts, args_lid, 0)) == 1;
    }
    if enum_name == String::from("Result") {
        let ok_owns: bool = !handled_variant_contains(handled, String::from("Ok")) &&
            ts_arg_len(e.ts, args_lid) >= 1 &&
            is_linear_owner_ty(e, ts_arg_get(e.ts, args_lid, 0)) == 1;
        let err_owns: bool = !handled_variant_contains(handled, String::from("Err")) &&
            ts_arg_len(e.ts, args_lid) >= 2 &&
            is_linear_owner_ty(e, ts_arg_get(e.ts, args_lid, 1)) == 1;
        return ok_owns || err_owns;
    }
    false
}

// True when a value of type `from_tid` may appear where `to_tid` is expected.
// Only the dedicated unsuffixed integer literal marker may coerce across
// integer types; genuine integer values must already match.
fn operand_coercible(ts: TyStore, from_tid: i64, to_tid: i64) -> bool {
    if from_tid == to_tid {
        return true;
    }
    if tids_equal(ts, from_tid, to_tid) {
        return true;
    }
    let from_tag: i64 = ty_tag(ts, from_tid);
    if from_tag == CTY_NEVER() || from_tag == CTY_UNKNOWN() {
        return true;
    }
    let to_tag: i64 = ty_tag(ts, to_tid);
    if to_tag == CTY_NEVER() || to_tag == CTY_UNKNOWN() {
        return true;
    }
    if from_tag == CTY_LIT_INT() && ty_is_integer(ts, to_tid) {
        return true;
    }
    false
}

// Symmetric operand compatibility for comparison and arithmetic: either side may
// be the coercible one (a literal on the left or right). Call sites gate this on
// both operands being numeric: the #848 hole is numeric (u64/i64) confusion, and
// restricting to numeric types avoids false positives on values the checker
// under-resolves (e.g. a match payload it types as Unit), preserving the
// self-hosted compiler's historically lenient handling of non-numeric operands.
fn bin_operands_compatible(ts: TyStore, lhs_tid: i64, rhs_tid: i64) -> bool {
    operand_coercible(ts, lhs_tid, rhs_tid) || operand_coercible(ts, rhs_tid, lhs_tid)
}

fn result_tids_compatible(ts: TyStore, a_tid: i64, b_tid: i64) -> bool {
    is_coercible(ts, a_tid, b_tid) || is_coercible(ts, b_tid, a_tid)
}

fn merge_result_tid(ts: TyStore, current_tid: i64, incoming_tid: i64) -> i64 {
    if is_coercible(ts, current_tid, incoming_tid) {
        return incoming_tid;
    }
    current_tid
}

fn check_expr(e: CheckEnv, m: Module, eid: i64) -> i64 [io] {
    let tid: i64 = check_expr_inner(e, m, eid);
    if tid == CTY_STR() {
        env_record_str_expr(e, eid);
    }
    tid
}

// A constant integer expression: a bare literal, or a literal wrapped in
// unary negation (e.g. `-1`).
fn check_expr_inner(e: CheckEnv, m: Module, eid: i64) -> i64 [io] {
    let a: AstArena = m.arena;
    let tag: i64 = expr_tag(a, eid);

    if tag == EXPR_LIT_INT() {
        // Unsuffixed integer literals carry a marker that context-coerces to
        // integer types. Genuine i32 values keep CTY_I32 and do not widen.
        return CTY_LIT_INT();
    }
    if tag == EXPR_LIT_BOOL() {
        return CTY_BOOL();
    }
    if tag == EXPR_LIT_STR() {
        return CTY_STR();
    }
    if tag == EXPR_LIT_FLOAT() {
        return CTY_F64();
    }

    if tag == EXPR_IDENT() {
        let name_sid: i64 = expr_a(a, eid);
        let name: String = arena_str(a, name_sid);
        let ncnst: u64 = e.const_names.len();
        let mut ci: u64 = 0u64;
        while ci < ncnst {
            let cn: String = e.const_names[ci];
            if cn.eq(name) {
                return e.const_tids[ci];
            }
            ci = ci + 1;
        }
        let vidx: i64 = env_find_var(e, name);
        if vidx < 0 {
            emit_undefined_variable(e, name, expr_span(a, eid));
            return CTY_UNKNOWN();
        }
        return e.var_tids[vidx as u64];
    }

    if tag == EXPR_BINOP() {
        let op: i64 = expr_a(a, eid);
        let lhs_eid: i64 = expr_b(a, eid);
        let rhs_eid: i64 = expr_c(a, eid);
        let lhs_tid: i64 = check_expr(e, m, lhs_eid);
        let rhs_tid: i64 = check_expr(e, m, rhs_eid);
        if op != BINOP_SHL() && op != BINOP_SHR() {
            let rhs_is_real_literal: bool = ty_is_integer(e.ts, lhs_tid) && ty_is_lit_int(e.ts, rhs_tid);
            let lhs_is_real_literal: bool = ty_is_integer(e.ts, rhs_tid) && ty_is_lit_int(e.ts, lhs_tid);
            if rhs_is_real_literal {
                check_integer_literal_range(e, a, rhs_eid, ty_tag(e.ts, lhs_tid));
            }
            if lhs_is_real_literal {
                check_integer_literal_range(e, a, lhs_eid, ty_tag(e.ts, rhs_tid));
            }
        }
        if op == BINOP_AND() || op == BINOP_OR() {
            return CTY_BOOL();
        }
        if op == BINOP_EQ() || op == BINOP_NE() || op == BINOP_LT() || op == BINOP_LE() || op == BINOP_GT() || op == BINOP_GE() {
            if ty_is_lit_int(e.ts, lhs_tid) && ty_is_lit_int(e.ts, rhs_tid) {
                check_integer_literal_range(e, a, lhs_eid, CTY_I64());
                check_integer_literal_range(e, a, rhs_eid, CTY_I64());
            }
            if ty_is_numeric_or_lit_int(e.ts, lhs_tid) && ty_is_numeric_or_lit_int(e.ts, rhs_tid) && !bin_operands_compatible(e.ts, lhs_tid, rhs_tid) {
                env_emit_error(e, String::from("comparison operands have different types"), expr_span(a, eid));
            } else {
                let verdict: i64 = unsigned_zero_comparison_verdict(a, op, lhs_eid, rhs_eid);
                if verdict >= 0 {
                    let unsigned_tag: i64 = unsigned_comparison_tag(e.ts, lhs_tid, rhs_tid);
                    // The cast route: `(u32_value as i64) >= 0`. The compared
                    // type is signed, so unsigned_comparison_tag returns -1,
                    // but a zero-extended unsigned value is still never
                    // negative.
                    let mut widened_tag: i64 = -1;
                    let mut widened_to_tag: i64 = -1;
                    if unsigned_tag < 0 {
                        let value_eid: i64 = zero_comparison_value_eid(a, op, lhs_eid, rhs_eid);
                        if value_eid >= 0 && expr_tag(a, value_eid) == EXPR_CAST() {
                            widened_tag = env_nonneg_cast_src_tag(e, value_eid);
                            if value_eid == lhs_eid {
                                widened_to_tag = ty_tag(e.ts, lhs_tid);
                            } else {
                                widened_to_tag = ty_tag(e.ts, rhs_tid);
                            }
                        }
                    }
                    if unsigned_tag >= 0 || widened_tag >= 0 {
                        let message: String = String::from("comparison with 0 is always ");
                        if verdict == 1 {
                            message.push_str(String::from("true"));
                        } else {
                            message.push_str(String::from("false"));
                        }
                        if widened_tag >= 0 {
                            message.push_str(String::from(" for `"));
                            message.push_str(ty_tag_name(widened_tag));
                            message.push_str(String::from("` zero-extended to `"));
                            message.push_str(ty_tag_name(widened_to_tag));
                            message.push_str(String::from("`"));
                        } else {
                            message.push_str(String::from(" for unsigned type `"));
                            message.push_str(ty_tag_name(unsigned_tag));
                            message.push_str(String::from("`"));
                        }
                        let hint: String = String::from("`");
                        if widened_tag >= 0 {
                            hint.push_str(ty_tag_name(widened_tag));
                            hint.push_str(String::from("` zero-extends into `"));
                            hint.push_str(ty_tag_name(widened_to_tag));
                            hint.push_str(String::from("`, so the result is never negative"));
                        } else {
                            hint.push_str(ty_tag_name(unsigned_tag));
                            hint.push_str(String::from("` values are never negative"));
                        }
                        hint.push_str(String::from("; drop the clause, or state the real bound (e.g. `i < v.len()`)"));
                        env_emit_error_code_hint(e, EC_TAUTOLOGICAL_COMPARISON(), message, expr_span(a, eid), hint);
                    }
                }
            }
            return CTY_BOOL();
        }
        if is_unknown(lhs_tid) || is_unknown(rhs_tid) {
            return CTY_UNKNOWN();
        }
        if op == BINOP_BITAND() || op == BINOP_BITOR() || op == BINOP_XOR() || op == BINOP_SHL() || op == BINOP_SHR() {
            if !ty_is_integer_or_lit_int(e.ts, lhs_tid) {
                env_emit_error(e, String::from("bitwise operator requires integer operands"), expr_span(a, eid));
                return CTY_UNKNOWN();
            }
            if !ty_is_integer_or_lit_int(e.ts, rhs_tid) {
                env_emit_error(e, String::from("bitwise operator requires integer operands"), expr_span(a, eid));
                return CTY_UNKNOWN();
            }
            let literal_lhs_shift: bool = ty_is_lit_int(e.ts, lhs_tid) && ty_is_integer(e.ts, rhs_tid);
            if (op == BINOP_SHL() || op == BINOP_SHR()) && (ty_is_integer(e.ts, lhs_tid) || literal_lhs_shift) {
                // An unsuffixed-literal left operand has no type of its own: it
                // takes the count's type, and that pair must satisfy the rule.
                let shift_tid: i64 = if literal_lhs_shift { rhs_tid } else { lhs_tid };
                let shift_tag: i64 = ty_tag(e.ts, shift_tid);
                let width: i64 = integer_tag_width(shift_tag);
                let same_type_count_ok: bool = shift_own_type_count_allowed(width) && ty_tag(e.ts, rhs_tid) == shift_tag;
                if ty_tag(e.ts, rhs_tid) != CTY_U32() && !ty_is_lit_int(e.ts, rhs_tid) && !is_opaque(rhs_tid) && !same_type_count_ok {
                    let type_msg: String = ty_tag_name(shift_tag);
                    if shift_own_type_count_allowed(width) {
                        type_msg.push_str(String::from(" shift count must be u32 or "));
                        type_msg.push_str(ty_tag_name(shift_tag));
                    } else {
                        type_msg.push_str(String::from(" shift count must be u32"));
                    }
                    type_msg.push_str(String::from(", found `"));
                    type_msg.push_str(ty_value_display_name(e.ts, rhs_tid));
                    type_msg.push_str(String::from("`"));
                    env_emit_error_code(e, EC_TYPE_MISMATCH(), type_msg, expr_span(a, rhs_eid));
                }
                if expr_is_const_int(a, rhs_eid) && shift_count_out_of_range(a, rhs_eid, width) {
                    let message: String = String::from("shift count ");
                    message.push_str(wide_literal_decimal(a, rhs_eid));
                    message.push_str(String::from(" is out of range for "));
                    message.push_str(ty_tag_name(shift_tag));
                    let hint: String = ty_tag_name(shift_tag);
                    hint.push_str(String::from(" shift counts must be in 0.."));
                    hint.push_str(i64_to_string(width));
                    env_emit_error_code_hint(e, EC_SHIFT_COUNT_OUT_OF_RANGE(), message, expr_span(a, rhs_eid), hint);
                }
                return shift_tid;
            }
            // An unsuffixed-literal marker coerces to the other
            // operand's integer type; two markers stay a marker.
            if ty_is_lit_int(e.ts, lhs_tid) && ty_is_integer(e.ts, rhs_tid) {
                return rhs_tid;
            }
            if ty_is_lit_int(e.ts, rhs_tid) && ty_is_integer(e.ts, lhs_tid) {
                return lhs_tid;
            }
            if lhs_tid != rhs_tid {
                env_emit_error(e, String::from("bitwise operator requires matching integer types"), expr_span(a, eid));
                return CTY_UNKNOWN();
            }
            return lhs_tid;
        }
        if ty_is_numeric_or_lit_int(e.ts, lhs_tid) && ty_is_numeric_or_lit_int(e.ts, rhs_tid) && !bin_operands_compatible(e.ts, lhs_tid, rhs_tid) {
            env_emit_error(e, String::from("arithmetic operands have different types"), expr_span(a, eid));
            return CTY_UNKNOWN();
        }
        // The concrete operand fixes the result type; an unsuffixed-literal
        // marker coerces to it. Two markers stay a marker (mirrors
        // check_same_numeric in the Rust checker).
        let mut result_tid: i64 = CTY_I64();
        if ty_is_lit_int(e.ts, lhs_tid) && ty_is_integer(e.ts, rhs_tid) {
            result_tid = rhs_tid;
        } else if ty_is_lit_int(e.ts, rhs_tid) && ty_is_integer(e.ts, lhs_tid) {
            result_tid = lhs_tid;
        } else if ty_is_numeric_or_lit_int(e.ts, lhs_tid) {
            result_tid = lhs_tid;
        }
        // Checked arithmetic (+!, -!, *!, /!, %!) means "abort instead of
        // wrapping on integer overflow" — a condition floats have no
        // equivalent of. Reject float operands here rather than emitting IR
        // that maps to the integer-only sadd_overflow-family opcodes.
        let is_checked_arith: bool = op == BINOP_ADD_CHK() || op == BINOP_SUB_CHK()
            || op == BINOP_MUL_CHK() || op == BINOP_DIV_CHK() || op == BINOP_REM_CHK();
        let result_tag: i64 = ty_tag(e.ts, result_tid);
        if is_checked_arith && (result_tag == CTY_F32() || result_tag == CTY_F64()) {
            let msg: String = String::from("checked arithmetic operators do not support `");
            msg.push_str(ty_tag_name(result_tag));
            msg.push_str(String::from("`; checked overflow has no meaning for floating-point types"));
            env_emit_error_code(e, EC_UNSUPPORTED_FEATURE(), msg, expr_span(a, eid));
        }
        return result_tid;
    }

    if tag == EXPR_UNOP() {
        let op: i64 = expr_a(a, eid);
        let operand_eid: i64 = expr_b(a, eid);
        if op == UNOP_NEG() && expr_tag(a, operand_eid) == EXPR_CAST() &&
            type_tag(a, expr_b(a, operand_eid)) == TY_NAMED() {
            let inner_eid: i64 = expr_a(a, operand_eid);
            let target_ast_tid: i64 = expr_b(a, operand_eid);
            let target_tid: i64 = resolve_ast_ty(e, m, target_ast_tid);
            let target_tag: i64 = ty_tag(e.ts, target_tid);
            let is_signed_wide: bool = target_tag == CTY_I128();
            let is_unsigned_zero: bool = target_tag == CTY_U128() &&
                expr_tag(a, inner_eid) == EXPR_LIT_INT() &&
                expr_int_lo(a, inner_eid) == 0u64 && expr_int_hi(a, inner_eid) == 0u64;
            if (is_signed_wide || is_unsigned_zero) && expr_tag(a, inner_eid) == EXPR_LIT_INT() {
                if integer_literal_out_of_range(a, eid, target_tag) {
                    emit_literal_out_of_range(e, a, eid, target_tag);
                }
                return target_tid;
            }
        }
        let operand_tid: i64 = check_expr(e, m, operand_eid);
        if op == UNOP_NOT() {
            return CTY_BOOL();
        }
        if op == UNOP_NEG() && ty_is_unsigned(e.ts, operand_tid) {
            env_emit_error(e, String::from("unary negation is not allowed on unsigned type"), expr_span(a, eid));
            return CTY_UNKNOWN();
        }
        return operand_tid;
    }

    if tag == EXPR_CALL() {
        let callee_eid: i64 = expr_a(a, eid);
        let args_lid: i64 = expr_b(a, eid);
        let callee_tag: i64 = expr_tag(a, callee_eid);
        let n_args: i64 = list_len(a, args_lid);
        let mut i: i64 = 0;
        let arg_tids: Vec<i64> = Vec::new();
        while i < n_args {
            let arg_eid: i64 = list_get(a, args_lid, i);
            let arg_tid: i64 = check_expr(e, m, arg_eid);
            arg_tids.push(arg_tid);
            i = i + 1;
        }
        if callee_tag == EXPR_IDENT() {
            let name_sid: i64 = expr_a(a, callee_eid);
            let name: String = arena_str(a, name_sid);
            if name == String::from("drop") && env_lookup_fn(e, name) == -1 {
                if n_args != 1 {
                    let amsg: String = String::from("function `drop` expects 1 argument but got ");
                    amsg.push_str(i64_to_string(n_args));
                    env_emit_error_code_hint(
                        e, EC_TYPE_MISMATCH(), amsg, expr_span(a, eid),
                        String::from("expected signature: (linear_value)")
                    );
                    return CTY_UNKNOWN();
                }
                let drop_tid: i64 = arg_tids[0];
                if !is_opaque(drop_tid) && is_linear_owner_ty(e, drop_tid) != 1 {
                    let dmsg: String = String::from("drop requires a linear value, found `");
                    dmsg.push_str(ty_full_display_name(e.ts, drop_tid));
                    dmsg.push_str(String::from("`"));
                    env_emit_error_code_hint(
                        e, EC_TYPE_MISMATCH(), dmsg, expr_span(a, list_get(a, args_lid, 0)),
                        String::from("only a `linear struct` or an owned enum wrapper that contains one can be dropped; other values need no explicit discharge")
                    );
                }
                return CTY_UNIT();
            }
            if name == String::from("pin_to_root") {
                if n_args != 1 {
                    env_emit_error(e, String::from("wrong argument count"), expr_span(a, eid));
                    return CTY_UNKNOWN();
                }
                let arg_eid: i64 = list_get(a, args_lid, 0);
                let arg_tid: i64 = check_expr(e, m, arg_eid);
                if !is_supported_pin_tid(e.ts, arg_tid) && !is_opaque(arg_tid) {
                    env_emit_error(e, String::from("pin_to_root supports String and flat scalar Vec<T> only"), expr_span(a, eid));
                }
                return arg_tid;
            }
            if name == String::from("string_matches_literal_at") {
                if n_args != 3 {
                    env_emit_error(e, String::from("wrong argument count"), expr_span(a, eid));
                    return CTY_UNKNOWN();
                }
                let s_eid: i64 = list_get(a, args_lid, 0);
                let pos_eid: i64 = list_get(a, args_lid, 1);
                let literal_eid: i64 = list_get(a, args_lid, 2);
                let s_tid: i64 = check_expr(e, m, s_eid);
                let pos_tid: i64 = check_expr(e, m, pos_eid);
                let literal_tid: i64 = check_expr(e, m, literal_eid);
                check_contextual_integer_literal_ranges(e, a, pos_eid, CTY_U64());
                if !is_coercible(e.ts, s_tid, CTY_STR()) {
                    env_emit_error(e, String::from("argument has wrong type for string_matches_literal_at"), expr_span(a, s_eid));
                }
                if !is_coercible(e.ts, pos_tid, CTY_U64()) {
                    env_emit_error(e, String::from("argument has wrong type for string_matches_literal_at"), expr_span(a, pos_eid));
                }
                if !is_coercible(e.ts, literal_tid, CTY_STR()) {
                    env_emit_error(e, String::from("argument has wrong type for string_matches_literal_at"), expr_span(a, literal_eid));
                }
                if expr_tag(a, literal_eid) != EXPR_LIT_STR() {
                    env_emit_error_code_hint(
                        e,
                        EC_STATIC_LITERAL_REQUIRED(),
                        String::from("string_matches_literal_at requires a string literal as its third argument"),
                        expr_span(a, literal_eid),
                        String::from("pass the literal directly so the compiler can lower it without allocating a String")
                    );
                }
                return CTY_I64();
            }
            let fidx: i64 = env_lookup_fn(e, name);
            if fidx == -1 {
                let msg: String = String::from("undefined function `");
                msg.push_str(name);
                msg.push_str(String::from("`"));
                env_emit_error(e, msg, expr_span(a, eid));
                return CTY_UNKNOWN();
            }
            if env_is_extern_fn(e, name) {
                let msg: String = String::from("calling extern-declared function `");
                msg.push_str(name);
                msg.push_str(String::from("` is not yet supported"));
                env_emit_error_code_hint(
                    e, EC_UNSUPPORTED_FEATURE(), msg, expr_span(a, eid),
                    String::from("extern \"C\" functions can be declared but not called yet; lowering extern calls to IR/codegen is not implemented")
                );
                return CTY_UNKNOWN();
            }
            if e.fn_param_count[fidx as u64] != n_args {
                env_emit_error(e, String::from("wrong argument count"), expr_span(a, eid));
            } else {
                let plid: i64 = e.fn_param_lids[fidx as u64];
                let mut ai: i64 = 0;
                while ai < n_args {
                    let ptid: i64 = ts_arg_get(e.ts, plid, ai);
                    let atid: i64 = arg_tids[ai as u64];
                    let aeid: i64 = list_get(a, args_lid, ai);
                    check_contextual_integer_literal_ranges(e, a, aeid, ptid);
                    if !is_coercible(e.ts, atid, ptid) {
                        env_emit_error(e, String::from("argument has wrong type"), expr_span(a, aeid));
                    }
                    ai = ai + 1;
                }
            }
            return e.fn_ret_tids[fidx as u64];
        }
        let _callee_tid: i64 = check_expr(e, m, callee_eid);
        env_emit_error(e, String::from("function call callee must be an identifier"), expr_span(a, callee_eid));
        return CTY_UNKNOWN();
    }

    if tag == EXPR_METHOD() {
        let recv_eid: i64 = expr_a(a, eid);
        let mname_sid: i64 = expr_b(a, eid);
        let args_lid: i64 = expr_c(a, eid);
        let recv_tid: i64 = check_expr(e, m, recv_eid);
        let mname: String = arena_str(a, mname_sid);
        let n_args: i64 = list_len(a, args_lid);
        let arg_tids: Vec<i64> = Vec::new();
        let mut i: i64 = 0;
        while i < n_args {
            let arg_eid: i64 = list_get(a, args_lid, i);
            let arg_tid: i64 = check_expr(e, m, arg_eid);
            arg_tids.push(arg_tid);
            i = i + 1;
        }
        if is_opaque(recv_tid) {
            if recv_tid == CTY_NEVER() {
                let nmsg: String = String::from("cannot infer the collection type of the receiver of `");
                nmsg.push_str(mname);
                nmsg.push_str(String::from("`: annotate its binding with a full type"));
                env_emit_error_code_hint(
                    e, EC_TYPE_MISMATCH(), nmsg, expr_span(a, eid),
                    String::from("`Vec::new()`, `HashMap::new()` and `BTreeMap::new()` take their element types from the annotation, for example `let m: HashMap<i64, i64> = HashMap::new();`")
                );
            }
            return CTY_UNKNOWN();
        }
        let recv_tag: i64 = ty_tag(e.ts, recv_tid);
        if recv_tag == CTY_STR() {
            if mname == String::from("push_str") || mname == String::from("eq") ||
               mname == String::from("contains") {
                check_method_argument_exact(e, m, a, args_lid, arg_tids, 0, CTY_STR(), mname);
            }
            if mname == String::from("byte_at") {
                check_method_argument_exact(e, m, a, args_lid, arg_tids, 0, CTY_U64(), mname);
            }
            if mname == String::from("push_byte") {
                check_method_argument_exact(e, m, a, args_lid, arg_tids, 0, CTY_U8(), mname);
            }
            if mname == String::from("substring") {
                check_method_argument_exact(e, m, a, args_lid, arg_tids, 0, CTY_U64(), mname);
                check_method_argument_exact(e, m, a, args_lid, arg_tids, 1, CTY_U64(), mname);
            }
            if mname == String::from("len") { return CTY_U64(); }
            if mname == String::from("byte_at") { return CTY_I64(); }
            if mname == String::from("push_str") { return CTY_UNIT(); }
            if mname == String::from("push_byte") { return CTY_UNIT(); }
            if mname == String::from("eq") { return CTY_BOOL(); }
            if mname == String::from("contains") { return CTY_BOOL(); }
            if mname == String::from("substring") { return CTY_STR(); }
            if mname == String::from("clear") { return CTY_UNIT(); }
            if mname == String::from("parse_i64") {
                let opt_base: i64 = ts_make_enum(e.ts, String::from("Option"));
                let opt_args: Vec<i64> = Vec::new();
                opt_args.push(CTY_I64());
                return ts_make_applied(e.ts, opt_base, opt_args);
            }
            if mname == String::from("parse_u64") {
                let opt_base: i64 = ts_make_enum(e.ts, String::from("Option"));
                let opt_args: Vec<i64> = Vec::new();
                opt_args.push(CTY_U64());
                return ts_make_applied(e.ts, opt_base, opt_args);
            }
            emit_unknown_method(e, a, eid, mname, String::from("String"));
            return CTY_UNKNOWN();
        }
        let vec_args: i64 = ty_applied_args(e.ts, recv_tid, -1, String::from("Vec"));
        if vec_args >= 0 {
            let hargs_lid: i64 = vec_args;
            if mname == String::from("push") {
                check_method_argument_exact(e, m, a, args_lid, arg_tids, 0, ts_arg_or_unknown(e.ts, hargs_lid, 0), mname);
            }
            if mname == String::from("truncate") {
                check_method_argument_exact(e, m, a, args_lid, arg_tids, 0, CTY_U64(), mname);
            }
            if mname == String::from("len") { return CTY_U64(); }
            if mname == String::from("push") { return CTY_UNIT(); }
            if mname == String::from("pop") { return CTY_UNIT(); }
            if mname == String::from("clear") { return CTY_UNIT(); }
            if mname == String::from("truncate") { return CTY_UNIT(); }
            emit_unknown_method(e, a, eid, mname, String::from("Vec"));
            return CTY_UNKNOWN();
        }
        let option_args: i64 = ty_applied_args(e.ts, recv_tid, -1, String::from("Option"));
        let result_args: i64 = ty_applied_args(e.ts, recv_tid, -1, String::from("Result"));
        if option_args >= 0 || result_args >= 0 {
            let hargs_lid: i64 = if option_args >= 0 { option_args } else { result_args };
            let base_name: String = if option_args >= 0 { String::from("Option") } else { String::from("Result") };
            let inner_tid: i64 = if ts_arg_len(e.ts, hargs_lid) > 0 {
                ts_arg_get(e.ts, hargs_lid, 0)
            } else {
                CTY_UNIT()
            };
            if mname == String::from("unwrap") {
                // `unwrap` takes no arguments. Without this the lowerer
                // accepts them and drops them unevaluated, silently
                // discarding their side effects (#1108 review).
                if n_args > 0 {
                    let uerr_msg: String = String::from("method `unwrap` expects 0 arguments but got ");
                    uerr_msg.push_str(i64_to_string(n_args));
                    env_emit_error_code(e, EC_TYPE_MISMATCH(), uerr_msg, expr_span(a, eid));
                }
                // The unwrap payload reaches IR through a FieldGet, so
                // it needs the same aggregate metadata `?` records.
                record_extracted_payload(e, eid, inner_tid);
                return inner_tid;
            }
            emit_unknown_method(e, a, eid, mname, base_name);
            return CTY_UNKNOWN();
        }
        let map_args: i64 = ty_applied_args(e.ts, recv_tid, -1, String::from("HashMap"));
        if map_args >= 0 {
            let hargs_lid: i64 = map_args;
            let val_tid: i64 = if ts_arg_len(e.ts, hargs_lid) > 1 {
                ts_arg_get(e.ts, hargs_lid, 1)
            } else {
                CTY_I64()
            };
            if mname == String::from("insert") {
                check_method_argument_exact(e, m, a, args_lid, arg_tids, 0, ts_arg_or_unknown(e.ts, hargs_lid, 0), mname);
                check_method_argument_exact(e, m, a, args_lid, arg_tids, 1, ts_arg_or_unknown(e.ts, hargs_lid, 1), mname);
            }
            if mname == String::from("get") ||
               mname == String::from("contains_key") ||
               mname == String::from("remove") {
                check_method_argument_exact(e, m, a, args_lid, arg_tids, 0, ts_arg_or_unknown(e.ts, hargs_lid, 0), mname);
            }
            if mname == String::from("insert") { return CTY_UNIT(); }
            if mname == String::from("get") {
                let hopt_base: i64 = ts_make_enum(e.ts, String::from("Option"));
                let hopt_args: Vec<i64> = Vec::new();
                hopt_args.push(val_tid);
                return ts_make_applied(e.ts, hopt_base, hopt_args);
            }
            if mname == String::from("contains_key") { return CTY_BOOL(); }
            if mname == String::from("len") { return CTY_U64(); }
            if mname == String::from("remove") { return CTY_UNIT(); }
            emit_unknown_method(e, a, eid, mname, String::from("HashMap"));
            return CTY_UNKNOWN();
        }
        let tree_args: i64 = ty_applied_args(e.ts, recv_tid, -1, String::from("BTreeMap"));
        if tree_args >= 0 {
            let bargs_lid: i64 = tree_args;
            let bval_tid: i64 = if ts_arg_len(e.ts, bargs_lid) > 1 {
                ts_arg_get(e.ts, bargs_lid, 1)
            } else {
                CTY_I64()
            };
            if mname == String::from("insert") {
                check_method_argument_exact(e, m, a, args_lid, arg_tids, 0, ts_arg_or_unknown(e.ts, bargs_lid, 0), mname);
                check_method_argument_exact(e, m, a, args_lid, arg_tids, 1, ts_arg_or_unknown(e.ts, bargs_lid, 1), mname);
            }
            if mname == String::from("get") || mname == String::from("contains") {
                check_method_argument_exact(e, m, a, args_lid, arg_tids, 0, ts_arg_or_unknown(e.ts, bargs_lid, 0), mname);
            }
            if mname == String::from("len") { return CTY_U64(); }
            if mname == String::from("contains") { return CTY_BOOL(); }
            if mname == String::from("insert") {
                let opt_base: i64 = ts_make_enum(e.ts, String::from("Option"));
                let opt_args: Vec<i64> = Vec::new();
                opt_args.push(bval_tid);
                return ts_make_applied(e.ts, opt_base, opt_args);
            }
            if mname == String::from("get") {
                let opt_base: i64 = ts_make_enum(e.ts, String::from("Option"));
                let opt_args: Vec<i64> = Vec::new();
                opt_args.push(bval_tid);
                return ts_make_applied(e.ts, opt_base, opt_args);
            }
            emit_unknown_method(e, a, eid, mname, String::from("BTreeMap"));
            return CTY_UNKNOWN();
        }
        let uerr_msg: String = String::from("unknown method `");
        uerr_msg.push_str(mname);
        uerr_msg.push_str(String::from("` on this type"));
        env_emit_error_code(e, EC_UNKNOWN_METHOD(), uerr_msg, expr_span(a, eid));
        return CTY_UNKNOWN();
    }

    if tag == EXPR_FIELD() {
        let recv_eid: i64 = expr_a(a, eid);
        let fname_sid: i64 = expr_b(a, eid);
        let recv_tid: i64 = check_expr(e, m, recv_eid);
        if is_unknown(recv_tid) {
            return recv_tid;
        }
        let fname: String = arena_str(a, fname_sid);
        let mut base_tid: i64 = recv_tid;
        if ty_tag(e.ts, recv_tid) == CTY_REF() {
            base_tid = ty_a(e.ts, recv_tid);
        }
        let recv_tag: i64 = ty_tag(e.ts, base_tid);
        if recv_tag == CTY_STRUCT() {
            let sname: String = ty_struct_name(e.ts, base_tid);
            let sidx: i64 = env_lookup_struct(e, sname);
            if sidx != -1 {
                let fname_lid: i64 = e.sdef_field_name_lids[sidx as u64];
                let ftid_lid: i64 = e.sdef_field_tid_lids[sidx as u64];
                let nf: i64 = e.sdef_field_count[sidx as u64];
                let mut i: i64 = 0;
                while i < nf {
                    let fsid: i64 = ts_arg_get(e.ts, fname_lid, i);
                    let ts_local: TyStore = e.ts;
                    let fn_str: String = ts_local.strs[fsid as u64];
                    if fn_str == fname {
                        return ts_arg_get(e.ts, ftid_lid, i);
                    }
                    i = i + 1;
                }
                emit_no_such_field(e, sname, fname, expr_span(a, eid));
                return CTY_UNKNOWN();
            }
            emit_unknown_struct(e, sname, expr_span(a, eid));
            return CTY_UNKNOWN();
        }
        let fmsg: String = String::from("field access on non-struct type `");
        fmsg.push_str(ty_full_display_name(e.ts, recv_tid));
        fmsg.push_str(String::from("`"));
        env_emit_error_code(e, EC_TYPE_MISMATCH(), fmsg, expr_span(a, eid));
        return CTY_UNKNOWN();
    }

    if tag == EXPR_INDEX() {
        let recv_eid: i64 = expr_a(a, eid);
        let idx_eid: i64 = expr_b(a, eid);
        let recv_tid: i64 = check_expr(e, m, recv_eid);
        let idx_tid: i64 = check_expr(e, m, idx_eid);
        check_contextual_integer_literal_ranges(e, a, idx_eid, CTY_U64());
        if !is_unknown(idx_tid) && (never_is_not_a_value(e, m, idx_eid, idx_tid, CTY_U64()) || !is_coercible(e.ts, idx_tid, CTY_U64())) {
            let imsg: String = String::from("index has type `");
            imsg.push_str(ty_full_display_name(e.ts, idx_tid));
            imsg.push_str(String::from("` but must be `u64`"));
            env_emit_error_code(e, EC_TYPE_MISMATCH(), imsg, expr_span(a, idx_eid));
        }
        if is_unknown(recv_tid) {
            return recv_tid;
        }
        if is_diverging_never(e, m, recv_eid, recv_tid) {
            return recv_tid;
        }
        let index_args: i64 = ty_applied_args(e.ts, recv_tid, -1, String::from("Vec"));
        if index_args >= 0 {
            if ts_arg_len(e.ts, index_args) > 0 {
                return ts_arg_get(e.ts, index_args, 0);
            }
            return CTY_UNIT();
        }
        let inmsg: String = String::from("index operation on non-indexable type `");
        inmsg.push_str(ty_full_display_name(e.ts, recv_tid));
        inmsg.push_str(String::from("`"));
        env_emit_error_code_hint(
            e, EC_TYPE_MISMATCH(), inmsg, expr_span(a, eid),
            String::from("indexing is supported on Vec<T> only; read a map entry with `get`, which returns an `Option`")
        );
        return CTY_UNKNOWN();
    }

    if tag == EXPR_IF() {
        let cond_eid: i64 = expr_a(a, eid);
        let then_bid: i64 = expr_b(a, eid);
        let else_eid: i64 = expr_c(a, eid);
        let cond_tid: i64 = check_expr(e, m, cond_eid);
        if cond_tid != CTY_BOOL() && !is_opaque(cond_tid) {
            let msg: String = String::from("if condition must be `bool`, found `");
            msg.push_str(ty_value_display_name(e.ts, cond_tid));
            msg.push_str(String::from("`"));
            env_emit_error(e, msg, expr_span(a, cond_eid));
        }
        let then_tid: i64 = check_block(e, m, then_bid);
        if else_eid == -1 {
            return CTY_UNIT();
        }
        let else_tid: i64 = check_expr(e, m, else_eid);
        if is_opaque(then_tid) {
            return else_tid;
        }
        if is_opaque(else_tid) {
            return then_tid;
        }
        // A literal-marker branch is absorbed by a concrete-integer
        // branch, so the if-expression takes the concrete type — otherwise a
        // genuine integer branch could masquerade as the coercible marker.
        if !result_tids_compatible(e.ts, then_tid, else_tid) {
            env_emit_error(e, String::from("if branches have different types"), expr_span(a, eid));
            return then_tid;
        }
        if ty_is_lit_int(e.ts, then_tid) && ty_is_integer(e.ts, else_tid) {
            return else_tid;
        }
        if ty_is_lit_int(e.ts, else_tid) && ty_is_integer(e.ts, then_tid) {
            return then_tid;
        }
        return then_tid;
    }

    if tag == EXPR_WHILE() {
        let cond_eid: i64 = expr_a(a, eid);
        let body_bid: i64 = expr_b(a, eid);
        let wvow_lid: i64 = expr_c(a, eid);
        let _cond_tid: i64 = check_expr(e, m, cond_eid);
        if wvow_lid != -1 {
            check_vow_clause(e, m, wvow_lid, CLAUSE_INVARIANT(), String::from("while loop"));
        }
        e.loop_kind_stack.push(0);
        e.break_counts.push(0);
        let _body_tid: i64 = check_block(e, m, body_bid);
        e.break_counts.pop();
        e.loop_kind_stack.pop();
        return CTY_UNIT();
    }

    if tag == EXPR_LOOP() {
        let body_bid: i64 = expr_a(a, eid);
        let lvow_lid: i64 = expr_b(a, eid);
        if lvow_lid != -1 {
            check_vow_clause(e, m, lvow_lid, CLAUSE_INVARIANT(), String::from("loop"));
        }
        let break_start: u64 = e.break_tids.len();
        e.loop_kind_stack.push(1);
        e.break_counts.push(0);
        let _body_tid: i64 = check_block(e, m, body_bid);
        let bc_idx: u64 = e.break_counts.len() - 1u64;
        let bc: u64 = e.break_counts[bc_idx] as u64;
        let mut loop_tid: i64 = CTY_NEVER();
        let mut saw_unknown: bool = false;
        let mut bi: u64 = 0u64;
        while bi < bc {
            let btid: i64 = e.break_tids[break_start + bi];
            if is_unknown(btid) {
                saw_unknown = true;
            }
            if !is_opaque(btid) {
                if is_opaque(loop_tid) {
                    loop_tid = btid;
                } else {
                    // Either the break value or the running result may be the
                    // coercible literal marker; a concrete-integer break value
                    // absorbs a marker result.
                    let ok: bool = result_tids_compatible(e.ts, btid, loop_tid);
                    if !ok {
                        env_emit_error(e, String::from("break type mismatch in loop"), expr_span(a, eid));
                        break;
                    }
                    loop_tid = merge_result_tid(e.ts, loop_tid, btid);
                }
            }
            bi = bi + 1;
        }
        if is_opaque(loop_tid) {
            loop_tid = if saw_unknown { CTY_UNKNOWN() } else { CTY_UNIT() };
        }
        let mut ti: u64 = 0u64;
        while ti < bc {
            e.break_tids.pop();
            ti = ti + 1;
        }
        e.break_counts.pop();
        e.loop_kind_stack.pop();
        return loop_tid;
    }

    if tag == EXPR_FOR() {
        let iterable_eid: i64 = expr_a(a, eid);
        let body_bid: i64 = expr_b(a, eid);
        let info_lid: i64 = expr_c(a, eid);
        let name_sid: i64 = list_get(a, info_lid, 0);
        let binding_name: String = arena_str(a, name_sid);
        let iter_tid: i64 = check_expr(e, m, iterable_eid);
        let mut elem_tid: i64 = CTY_I64();
        if is_opaque(iter_tid) {
            elem_tid = iter_tid;
        } else {
            let iter_tag: i64 = ty_tag(e.ts, iter_tid);
            if iter_tag == CTY_APPLIED() {
                let base_tid: i64 = ty_a(e.ts, iter_tid);
                let base_tag: i64 = ty_tag(e.ts, base_tid);
                if base_tag == CTY_ENUM() || base_tag == CTY_STRUCT() {
                    let base_name: String = ty_struct_name(e.ts, base_tid);
                    if base_name == String::from("Vec") {
                        let hargs_lid: i64 = ty_b(e.ts, iter_tid);
                        if ts_arg_len(e.ts, hargs_lid) > 0 {
                            elem_tid = ts_arg_get(e.ts, hargs_lid, 0);
                        }
                    } else {
                        let ferr_msg: String = String::from("for-each requires `Vec<T>` iterable, got `");
                        ferr_msg.push_str(base_name);
                        ferr_msg.push_str(String::from("`"));
                        env_emit_error_code(e, EC_TYPE_MISMATCH(), ferr_msg, expr_span(a, eid));
                    }
                } else {
                    let ferr2_msg: String = String::from("for-each requires `Vec<T>` iterable");
                    env_emit_error_code(e, EC_TYPE_MISMATCH(), ferr2_msg, expr_span(a, eid));
                }
            } else {
                let ferr3_msg: String = String::from("for-each requires `Vec<T>` iterable");
                env_emit_error_code(e, EC_TYPE_MISMATCH(), ferr3_msg, expr_span(a, eid));
            }
        }
        env_push_scope(e);
        env_define_var(e, binding_name, elem_tid);
        let fvow_lid: i64 = list_get(a, info_lid, 1);
        if fvow_lid != -1 {
            check_vow_clause(e, m, fvow_lid, CLAUSE_INVARIANT(), String::from("for-each loop"));
        }
        e.loop_kind_stack.push(0);
        e.break_counts.push(0);
        let _body_tid: i64 = check_block(e, m, body_bid);
        e.break_counts.pop();
        e.loop_kind_stack.pop();
        env_pop_scope(e);
        return CTY_UNIT();
    }

    if tag == EXPR_MATCH() {
        let scrutinee_eid: i64 = expr_a(a, eid);
        let arms_lid: i64 = expr_b(a, eid);
        let scrutinee_tid: i64 = check_expr(e, m, scrutinee_eid);
        let ts: TyStore = e.ts;
        let n_pairs: i64 = list_len(a, arms_lid);
        let n_arms: i64 = n_pairs / 2;
        let supported_arms: Vec<bool> = Vec::new();
        let mut all_arms_supported: bool = true;
        let mut validation_i: i64 = 0;
        while validation_i < n_arms {
            let validation_pid: i64 = list_get(a, arms_lid, validation_i * 2);
            let arm_supported: bool = validate_arm_pattern(e, m, validation_pid, validation_i == n_arms - 1);
            supported_arms.push(arm_supported);
            if !arm_supported {
                all_arms_supported = false;
            }
            validation_i = validation_i + 1;
        }
        let scrutinee_supported: bool = is_enum_match_tid(e.ts, scrutinee_tid);
        if all_arms_supported && !scrutinee_supported && !is_unknown(scrutinee_tid) {
            env_emit_error_code_hint(e, EC_UNSUPPORTED_PATTERN(), String::from("match scrutinee must be an enum"), expr_span(a, scrutinee_eid), String::from("use `if`/`else` comparisons for scalar values"));
        }
        if all_arms_supported && scrutinee_supported {
            check_exhaustive(e, m, scrutinee_tid, arms_lid, n_arms, expr_span(a, eid));
        }
        let mut result_tid: i64 = CTY_NEVER();
        let handled_variants: Vec<String> = Vec::new();
        let mut i: i64 = 0;
        while i < n_arms {
            let pat_pid: i64 = list_get(a, arms_lid, i * 2);
            let body_eid: i64 = list_get(a, arms_lid, i * 2 + 1);
            env_push_scope(e);
            if supported_arms[i as u64] && scrutinee_supported {
                if pat_tag(a, pat_pid) == PAT_WILD() && unhandled_variant_owns_linear_payload(e, scrutinee_tid, handled_variants) {
                    env_emit_error_code(
                        e,
                        EC_LINEAR_TYPE_VIOLATION(),
                        String::from("catchall pattern discards an unhandled linear enum payload; add explicit arms that bind and consume every linear payload"),
                        pat_span(a, pat_pid),
                    );
                }
                bind_arm_pattern(e, m, pat_pid, scrutinee_tid);
                if pat_tag(a, pat_pid) == PAT_ENUM() {
                    let path_lid: i64 = pat_a(a, pat_pid);
                    let path_len: i64 = list_len(a, path_lid);
                    if path_len > 0 && enum_pattern_matches_tid(e.ts, a, pat_pid, scrutinee_tid) {
                        let variant_name: String = arena_str(a, list_get(a, path_lid, path_len - 1));
                        if !handled_variant_contains(handled_variants, variant_name) {
                            handled_variants.push(variant_name);
                        }
                    }
                }
            }
            let arm_tid: i64 = check_expr(e, m, body_eid);
            env_pop_scope(e);
            if is_opaque(result_tid) {
                result_tid = arm_tid;
            } else if !tids_equal(ts, arm_tid, result_tid) && !is_opaque(arm_tid) {
                let coercible: bool = result_tids_compatible(ts, arm_tid, result_tid);
                if coercible {
                    result_tid = merge_result_tid(ts, result_tid, arm_tid);
                } else {
                    env_emit_error(e, String::from("match arm type mismatch"), expr_span(a, body_eid));
                }
            }
            i = i + 1;
        }
        return result_tid;
    }

    if tag == EXPR_RETURN() {
        let val_eid: i64 = expr_a(a, eid);
        if val_eid == -1 {
            if !is_coercible(e.ts, CTY_UNIT(), e.cur_ret_tid) {
                env_emit_error(e, String::from("return type mismatch"), expr_span(a, eid));
            }
        } else {
            let val_tid: i64 = check_expr(e, m, val_eid);
            check_contextual_integer_literal_ranges(e, a, val_eid, e.cur_ret_tid);
            if !is_coercible(e.ts, val_tid, e.cur_ret_tid) {
                env_emit_error(e, String::from("return type mismatch"), expr_span(a, eid));
            }
        }
        return CTY_NEVER();
    }

    if tag == EXPR_BREAK() {
        if e.loop_kind_stack.len() == 0 {
            env_emit_error(e, String::from("`break` outside of a loop"), expr_span(a, eid));
        }
        let val_eid: i64 = expr_a(a, eid);
        let mut val_tid: i64 = CTY_UNIT();
        if val_eid != -1 {
            val_tid = check_expr(e, m, val_eid);
            let nk: u64 = e.loop_kind_stack.len();
            if nk > 0 {
                if e.loop_kind_stack[nk - 1] == 0 {
                    env_emit_error(e, String::from("`break` with a value is only allowed inside `loop`, not `while`"), expr_span(a, eid));
                }
            }
        }
        let nk2: u64 = e.loop_kind_stack.len();
        if nk2 > 0 {
            if e.loop_kind_stack[nk2 - 1] == 1 {
                e.break_tids.push(val_tid);
                let cnt_idx: u64 = e.break_counts.len() - 1u64;
                e.break_counts[cnt_idx] = e.break_counts[cnt_idx] + 1;
            }
        }
        return CTY_NEVER();
    }

    if tag == EXPR_CONTINUE() {
        if e.loop_kind_stack.len() == 0 {
            env_emit_error(e, String::from("`continue` outside of a loop"), expr_span(a, eid));
        }
        return CTY_NEVER();
    }

    if tag == EXPR_BLOCK() {
        let bid: i64 = expr_a(a, eid);
        return check_block(e, m, bid);
    }

    if tag == EXPR_ASSIGN() {
        let lhs_eid: i64 = expr_a(a, eid);
        let rhs_eid: i64 = expr_b(a, eid);
        let lhs_tid: i64 = check_expr(e, m, lhs_eid);
        let rhs_tid: i64 = check_expr(e, m, rhs_eid);
        check_contextual_integer_literal_ranges(e, a, rhs_eid, lhs_tid);
        if !is_opaque(lhs_tid) && !is_coercible(e.ts, rhs_tid, lhs_tid) {
            let msg: String = String::from("assignment type mismatch: left is '");
            msg.push_str(ty_value_display_name(e.ts, lhs_tid));
            msg.push_str(String::from("' but right is '"));
            msg.push_str(ty_value_display_name(e.ts, rhs_tid));
            msg.push_str(String::from("'"));
            env_emit_error(e, msg, expr_span(a, eid));
        }
        if expr_tag(a, lhs_eid) == EXPR_IDENT() {
            let lhs_name: String = arena_str(a, expr_a(a, lhs_eid));
            let mut_status: i64 = env_mark_mutated(e, lhs_name);
            if mut_status == 2 {
                let amsg: String = String::from("cannot assign to immutable binding `");
                amsg.push_str(lhs_name);
                amsg.push_str(String::from("`; declare it with `let mut "));
                amsg.push_str(lhs_name);
                amsg.push_str(String::from("`"));
                env_emit_error_code(e, EC_IMMUTABLE_ASSIGNMENT(), amsg, expr_span(a, lhs_eid));
            }
        }
        return CTY_UNIT();
    }

    if tag == EXPR_SLIT() {
        let path_lid: i64 = expr_a(a, eid);
        let fields_lid: i64 = expr_b(a, eid);
        let n_path: i64 = list_len(a, path_lid);
        let last_sid: i64 = list_get(a, path_lid, n_path - 1);
        let sname: String = arena_str(a, last_sid);
        let sidx: i64 = env_lookup_struct(e, sname);
        if sidx == -1 {
            emit_unknown_struct(e, sname, expr_span(a, eid));
        }
        let n_pairs: i64 = list_len(a, fields_lid);
        let n_fields: i64 = n_pairs / 2;
        let mut i: i64 = 0;
        while i < n_fields {
            let fname_sid: i64 = list_get(a, fields_lid, i * 2);
            let fname: String = arena_str(a, fname_sid);
            let feid: i64 = list_get(a, fields_lid, i * 2 + 1);
            let ftid: i64 = check_expr(e, m, feid);
            if sidx != -1 {
                let fname_lid: i64 = e.sdef_field_name_lids[sidx as u64];
                let ftid_lid: i64 = e.sdef_field_tid_lids[sidx as u64];
                let nf: i64 = e.sdef_field_count[sidx as u64];
                let mut field_index: i64 = 0;
                let mut expected_tid: i64 = -1;
                while field_index < nf {
                    let declared_sid: i64 = ts_arg_get(e.ts, fname_lid, field_index);
                    let ts_local: TyStore = e.ts;
                    if ts_local.strs[declared_sid as u64] == fname {
                        let expected_tid_here: i64 = ts_arg_get(e.ts, ftid_lid, field_index);
                        check_contextual_integer_literal_ranges(e, a, feid, expected_tid_here);
                        expected_tid = expected_tid_here;
                        field_index = nf;
                    } else {
                        field_index = field_index + 1;
                    }
                }
                if expected_tid != -1 {
                    if !is_opaque(expected_tid) && !is_coercible(e.ts, ftid, expected_tid) {
                        let msg: String = String::from("field `");
                        msg.push_str(fname);
                        msg.push_str(String::from("` of struct `"));
                        msg.push_str(sname);
                        msg.push_str(String::from("` expects `"));
                        msg.push_str(ty_value_display_name(e.ts, expected_tid));
                        msg.push_str(String::from("`, found `"));
                        msg.push_str(ty_value_display_name(e.ts, ftid));
                        msg.push_str(String::from("`"));
                        env_emit_error_code(e, EC_TYPE_MISMATCH(), msg, expr_span(a, feid));
                    }
                } else {
                    emit_no_such_field(e, sname, fname, expr_span(a, feid));
                }
            }
            i = i + 1;
        }
        if sidx == -1 {
            return CTY_UNKNOWN();
        }
        return ts_make_struct(e.ts, sname);
    }

    if tag == EXPR_ECTOR() {
        let path_lid: i64 = expr_a(a, eid);
        let args_lid: i64 = expr_b(a, eid);
        let n_path: i64 = list_len(a, path_lid);
        let first_sid: i64 = list_get(a, path_lid, 0);
        let first_name: String = arena_str(a, first_sid);
        let n_args: i64 = list_len(a, args_lid);
        let mut i: i64 = 0;
        let mut first_arg_tid: i64 = CTY_UNKNOWN();
        let arg_tids: Vec<i64> = Vec::new();
        while i < n_args {
            let arg_eid: i64 = list_get(a, args_lid, i);
            let arg_tid: i64 = check_expr(e, m, arg_eid);
            arg_tids.push(arg_tid);
            if i == 0 {
                first_arg_tid = arg_tid;
            }
            i = i + 1;
        }
        if first_name == String::from("Option") {
            if n_path > 1 {
                let second_sid: i64 = list_get(a, path_lid, 1);
                let second_name: String = arena_str(a, second_sid);
                if second_name == String::from("None") {
                    return CTY_NEVER();
                }
                if second_name == String::from("Some") {
                    let payload_tid: i64 = if n_args > 0 { first_arg_tid } else { CTY_UNIT() };
                    let opt_args: Vec<i64> = Vec::new();
                    opt_args.push(payload_tid);
                    return ts_make_applied(e.ts, ts_make_enum(e.ts, String::from("Option")), opt_args);
                }
            }
            return ts_make_enum(e.ts, String::from("Option"));
        }
        if first_name == String::from("Result") {
            if n_path > 1 {
                let second_sid: i64 = list_get(a, path_lid, 1);
                let second_name: String = arena_str(a, second_sid);
                let payload_tid: i64 = if n_args > 0 { first_arg_tid } else { CTY_UNIT() };
                if second_name == String::from("Ok") {
                    let result_args: Vec<i64> = Vec::new();
                    result_args.push(payload_tid);
                    result_args.push(CTY_UNIT());
                    return ts_make_applied(e.ts, ts_make_enum(e.ts, String::from("Result")), result_args);
                }
                if second_name == String::from("Err") {
                    let result_args: Vec<i64> = Vec::new();
                    result_args.push(CTY_NEVER());
                    result_args.push(payload_tid);
                    return ts_make_applied(e.ts, ts_make_enum(e.ts, String::from("Result")), result_args);
                }
            }
            return ts_make_enum(e.ts, String::from("Result"));
        }
        if first_name == String::from("Vec") {
            if n_path > 1 {
                let second_sid: i64 = list_get(a, path_lid, 1);
                let second_name: String = arena_str(a, second_sid);
                if second_name == String::from("from_raw_parts_copy") {
                    if n_args != 2 {
                        env_emit_error(e, String::from("wrong argument count"), expr_span(a, eid));
                    }
                    check_method_argument_exact(e, m, a, args_lid, arg_tids, 0, CTY_I64(), second_name);
                    check_method_argument_exact(e, m, a, args_lid, arg_tids, 1, CTY_U64(), second_name);
                    return CTY_NEVER();
                }
            }
        }
        if n_path > 1 && (first_name == String::from("Vec") || first_name == String::from("HashMap") || first_name == String::from("BTreeMap")) {
            let ctor_sid: i64 = list_get(a, path_lid, 1);
            if arena_str(a, ctor_sid) == String::from("new") {
                // The element types come from the binding's annotation, so the
                // bare constructor is the unresolved marker; mirrors Rust
                // `builtin_constructor`.
                return CTY_NEVER();
            }
        }
        if first_name == String::from("String") {
            if n_path > 1 {
                let second_sid: i64 = list_get(a, path_lid, 1);
                let second_name: String = arena_str(a, second_sid);
                if second_name == String::from("from_raw_parts_copy") {
                    if n_args != 2 {
                        env_emit_error(e, String::from("wrong argument count"), expr_span(a, eid));
                    }
                    check_method_argument_exact(e, m, a, args_lid, arg_tids, 0, CTY_I64(), second_name);
                    check_method_argument_exact(e, m, a, args_lid, arg_tids, 1, CTY_U64(), second_name);
                    return CTY_STR();
                }
                if second_name == String::from("from") {
                    if n_args != 1 {
                        env_emit_error(e, String::from("String::from expects one String argument"), expr_span(a, eid));
                        return CTY_STR();
                    }
                    if first_arg_tid != CTY_STR() && !is_unknown(first_arg_tid)
                        && !is_diverging_never(e, m, list_get(a, args_lid, 0), first_arg_tid) {
                        env_emit_error(e, String::from("String::from argument must be String"), expr_span(a, eid));
                    }
                    return CTY_STR();
                }
            }
            return CTY_STR();
        }
        if n_path > 1 {
            let eidx: i64 = env_lookup_enum(e, first_name);
            if eidx != -1 {
                let variant_sid: i64 = list_get(a, path_lid, 1);
                let variant_name: String = arena_str(a, variant_sid);
                let expected_count: i64 = lookup_variant_payload_count(e, eidx, variant_name);
                let mut payload_index: i64 = 0;
                while payload_index < n_args && payload_index < expected_count {
                    let expected_tid: i64 = lookup_variant_payload(
                        e, eidx, variant_name, payload_index
                    );
                    let arg_eid: i64 = list_get(a, args_lid, payload_index);
                    check_contextual_integer_literal_ranges(e, a, arg_eid, expected_tid);
                    payload_index = payload_index + 1;
                }
                return ts_make_enum(e.ts, first_name);
            }
            return CTY_UNKNOWN();
        }
        let eidx: i64 = env_lookup_enum(e, first_name);
        if eidx != -1 {
            return ts_make_enum(e.ts, first_name);
        }
        return CTY_UNIT();
    }

    if tag == EXPR_QUESTION() {
        let inner_eid: i64 = expr_a(a, eid);
        let inner_tid: i64 = check_expr(e, m, inner_eid);
        if is_opaque(inner_tid) {
            return inner_tid;
        }
        if ty_tag(e.ts, inner_tid) == CTY_APPLIED() {
            let base_tid: i64 = ty_a(e.ts, inner_tid);
            if ty_tag(e.ts, base_tid) == CTY_ENUM() {
                let base_name: String = ty_struct_name(e.ts, base_tid);
                if base_name == String::from("Option") {
                    if ty_tag(e.ts, e.cur_ret_tid) != CTY_APPLIED() || enum_name_from_tid(e.ts, e.cur_ret_tid) != String::from("Option") {
                        env_emit_error_code(e, EC_TYPE_MISMATCH(),
                            String::from("the `?` operator on Option requires the caller to return `Option`"),
                            expr_span(a, eid));
                        return CTY_UNKNOWN();
                    }
                    let args_lid: i64 = ty_b(e.ts, inner_tid);
                    if ts_arg_len(e.ts, args_lid) > 0 {
                        let payload_tid: i64 = ts_arg_get(e.ts, args_lid, 0);
                        record_extracted_payload(e, eid, payload_tid);
                        return payload_tid;
                    }
                    return CTY_UNIT();
                }
                if base_name == String::from("Result") {
                    env_emit_error_code(e, EC_TYPE_MISMATCH(),
                        String::from("Result propagation with `?` is not lowered yet"),
                        expr_span(a, eid));
                    return CTY_UNKNOWN();
                }
            }
        }
        env_emit_error(e, String::from("the `?` operator requires `Option<T>` or `Result<T,E>`"), expr_span(a, eid));
        return CTY_UNKNOWN();
    }

    if tag == EXPR_RESULT() {
        return e.cur_ret_tid;
    }

    if tag == EXPR_CAST() {
        let inner_eid: i64 = expr_a(a, eid);
        let target_ast_tid: i64 = expr_b(a, eid);
        let src_tid: i64 = check_expr(e, m, inner_eid);
        let tgt_tid: i64 = resolve_ast_ty(e, m, target_ast_tid);
        let src_tag: i64 = ty_tag(e.ts, src_tid);
        let tgt_tag: i64 = ty_tag(e.ts, tgt_tid);
        if src_tag == CTY_LIT_INT() && ty_is_integer(e.ts, tgt_tid) {
            check_integer_literal_range(e, a, inner_eid, tgt_tag);
            return tgt_tid;
        }
        if ty_is_integer(e.ts, src_tid) && ty_is_integer(e.ts, tgt_tid) {
            let src_width: i64 = integer_tag_width(src_tag);
            let tgt_width: i64 = integer_tag_width(tgt_tag);
            if tgt_width < src_width {
                let message: String = String::from("cannot cast ");
                message.push_str(ty_tag_name(src_tag));
                message.push_str(String::from(" to "));
                message.push_str(ty_tag_name(tgt_tag));
                message.push_str(String::from(" via as"));
                let hint: String = String::from("use a `");
                hint.push_str(ty_tag_name(src_tag));
                hint.push_str(String::from("_to_"));
                hint.push_str(ty_tag_name(tgt_tag));
                hint.push_str(String::from("_try`, `_wrap`, or `_sat` narrowing intrinsic"));
                env_emit_error_code_hint(e, EC_NARROWING_CAST_NOT_ALLOWED(),
                    message,
                    expr_span(a, inner_eid), hint);
            }
            let root_src_tag: i64 = zero_extended_source_tag(e, a, inner_eid, src_tid, tgt_tid);
            if root_src_tag >= 0 {
                env_record_nonneg_cast(e, eid, root_src_tag);
            }
            return tgt_tid;
        }
        if !is_opaque(src_tid) {
            env_emit_error_code(e, EC_TYPE_MISMATCH(), String::from("invalid cast"), expr_span(a, eid));
        }
        return tgt_tid;
    }

    if tag == EXPR_TUPLE() {
        let elems_lid: i64 = expr_a(a, eid);
        let n: i64 = list_len(a, elems_lid);
        if e.contract_depth > 0 {
            env_emit_error_code(
                e,
                EC_UNSUPPORTED_FEATURE(),
                String::from("tuple expressions are not supported in contract predicates"),
                expr_span(a, eid),
            );
        }
        if n == 0 {
            return CTY_UNIT();
        }
        let elem_tids: Vec<i64> = Vec::new();
        let mut i: i64 = 0;
        while i < n {
            elem_tids.push(check_expr(e, m, list_get(a, elems_lid, i)));
            i = i + 1;
        }
        let lid: i64 = ts_add_args(e.ts, elem_tids);
        return ty_add(e.ts, CTY_TUPLE(), lid, 0);
    }

    CTY_UNIT()
}

// Builtin methods that never write through their receiver or arguments.
// Allowlist, not a denylist, mirroring the Rust frontend's READ_ONLY_METHODS
// in vow-types/src/effects.rs: a builtin method not on this list is
// write-suspect until proven otherwise, so a newly added mutating method
// ships guarded by default. Exhaustive against the builtin method tables
// (Str, Vec, HashMap, BTreeMap, Option/Result) — Vow has no user-defined
// methods.
fn is_read_only_method(name: String) -> bool {
    name == String::from("len")
        || name == String::from("get")
        || name == String::from("eq")
        || name == String::from("contains")
        || name == String::from("contains_key")
        || name == String::from("byte_at")
        || name == String::from("substring")
        || name == String::from("parse_i64")
        || name == String::from("parse_u64")
        || name == String::from("unwrap")
}

// Collects every sub-expression of `eid` that, when evaluated, performs a
// write reachable from a parameter: a FieldAccess/Index assignment target, a
// builtin method call not in is_read_only_method, or a call to a function
// whose own may-write bit (e.may_write_fns, see compute_may_write_table) is
// set or unresolvable. Mirrors collect_calls_in_expr's traversal shape and
// EXPR_* arms one-for-one so a new expression kind can't silently escape one
// walker but not the other (issue #1032).
fn collect_may_write_sites_in_expr(e: CheckEnv, m: Module, eid: i64, sites: Vec<i64>) [io] {
    let a: AstArena = m.arena;
    let tag: i64 = expr_tag(a, eid);

    if tag == EXPR_ASSIGN() {
        let lhs_eid: i64 = expr_a(a, eid);
        let rhs_eid: i64 = expr_b(a, eid);
        let lhs_tag: i64 = expr_tag(a, lhs_eid);
        if lhs_tag == EXPR_FIELD() || lhs_tag == EXPR_INDEX() {
            sites.push(eid);
        }
        collect_may_write_sites_in_expr(e, m, lhs_eid, sites);
        collect_may_write_sites_in_expr(e, m, rhs_eid, sites);
        return;
    }

    if tag == EXPR_METHOD() {
        let recv_eid: i64 = expr_a(a, eid);
        let mname_sid: i64 = expr_b(a, eid);
        let args_lid: i64 = expr_c(a, eid);
        let mname: String = arena_str(a, mname_sid);
        if !is_read_only_method(mname) {
            sites.push(eid);
        }
        collect_may_write_sites_in_expr(e, m, recv_eid, sites);
        let n: i64 = list_len(a, args_lid);
        let mut i: i64 = 0;
        while i < n {
            collect_may_write_sites_in_expr(e, m, list_get(a, args_lid, i), sites);
            i = i + 1;
        }
        return;
    }

    if tag == EXPR_CALL() {
        let callee_eid: i64 = expr_a(a, eid);
        let args_lid: i64 = expr_b(a, eid);
        let callee_tag: i64 = expr_tag(a, callee_eid);
        let mut may_write: bool = true;
        if callee_tag == EXPR_IDENT() {
            let name_sid: i64 = expr_a(a, callee_eid);
            let name: String = arena_str(a, name_sid);
            let fidx: i64 = env_lookup_fn(e, name);
            if fidx == -1 {
                may_write = true;
            } else {
                may_write = e.may_write_fns[fidx as u64] != 0;
            }
        }
        if may_write {
            sites.push(eid);
        }
        collect_may_write_sites_in_expr(e, m, callee_eid, sites);
        let n: i64 = list_len(a, args_lid);
        let mut i: i64 = 0;
        while i < n {
            collect_may_write_sites_in_expr(e, m, list_get(a, args_lid, i), sites);
            i = i + 1;
        }
        return;
    }

    if tag == EXPR_BINOP() {
        collect_may_write_sites_in_expr(e, m, expr_b(a, eid), sites);
        collect_may_write_sites_in_expr(e, m, expr_c(a, eid), sites);
        return;
    }

    if tag == EXPR_UNOP() {
        collect_may_write_sites_in_expr(e, m, expr_b(a, eid), sites);
        return;
    }

    if tag == EXPR_FIELD() || tag == EXPR_QUESTION() {
        collect_may_write_sites_in_expr(e, m, expr_a(a, eid), sites);
        return;
    }

    if tag == EXPR_INDEX() {
        collect_may_write_sites_in_expr(e, m, expr_a(a, eid), sites);
        collect_may_write_sites_in_expr(e, m, expr_b(a, eid), sites);
        return;
    }

    if tag == EXPR_IF() {
        collect_may_write_sites_in_expr(e, m, expr_a(a, eid), sites);
        collect_may_write_sites_in_block(e, m, expr_b(a, eid), sites);
        let else_eid: i64 = expr_c(a, eid);
        if else_eid != -1 {
            collect_may_write_sites_in_expr(e, m, else_eid, sites);
        }
        return;
    }

    if tag == EXPR_WHILE() {
        collect_may_write_sites_in_expr(e, m, expr_a(a, eid), sites);
        collect_may_write_sites_in_block(e, m, expr_b(a, eid), sites);
        return;
    }

    if tag == EXPR_LOOP() {
        collect_may_write_sites_in_block(e, m, expr_a(a, eid), sites);
        return;
    }

    if tag == EXPR_FOR() {
        collect_may_write_sites_in_expr(e, m, expr_a(a, eid), sites);
        collect_may_write_sites_in_block(e, m, expr_b(a, eid), sites);
        return;
    }

    if tag == EXPR_MATCH() {
        collect_may_write_sites_in_expr(e, m, expr_a(a, eid), sites);
        let arms_lid: i64 = expr_b(a, eid);
        let n_pairs: i64 = list_len(a, arms_lid);
        let n_arms: i64 = n_pairs / 2;
        let mut i: i64 = 0;
        while i < n_arms {
            collect_may_write_sites_in_expr(e, m, list_get(a, arms_lid, i * 2 + 1), sites);
            i = i + 1;
        }
        return;
    }

    if tag == EXPR_RETURN() {
        let val_eid: i64 = expr_a(a, eid);
        if val_eid != -1 {
            collect_may_write_sites_in_expr(e, m, val_eid, sites);
        }
        return;
    }

    if tag == EXPR_BLOCK() {
        collect_may_write_sites_in_block(e, m, expr_a(a, eid), sites);
        return;
    }

    if tag == EXPR_SLIT() {
        let fields_lid: i64 = expr_b(a, eid);
        let n_pairs: i64 = list_len(a, fields_lid);
        let n_fields: i64 = n_pairs / 2;
        let mut i: i64 = 0;
        while i < n_fields {
            collect_may_write_sites_in_expr(e, m, list_get(a, fields_lid, i * 2 + 1), sites);
            i = i + 1;
        }
        return;
    }

    if tag == EXPR_ECTOR() {
        let args_lid: i64 = expr_b(a, eid);
        let n: i64 = list_len(a, args_lid);
        let mut i: i64 = 0;
        while i < n {
            collect_may_write_sites_in_expr(e, m, list_get(a, args_lid, i), sites);
            i = i + 1;
        }
        return;
    }

    if tag == EXPR_CAST() {
        collect_may_write_sites_in_expr(e, m, expr_a(a, eid), sites);
        return;
    }

    if tag == EXPR_TUPLE() {
        let elems_lid: i64 = expr_a(a, eid);
        let n: i64 = list_len(a, elems_lid);
        let mut i: i64 = 0;
        while i < n {
            collect_may_write_sites_in_expr(e, m, list_get(a, elems_lid, i), sites);
            i = i + 1;
        }
        return;
    }

    if tag == EXPR_BREAK() {
        let val_eid: i64 = expr_a(a, eid);
        if val_eid != -1 {
            collect_may_write_sites_in_expr(e, m, val_eid, sites);
        }
        return;
    }
}

fn collect_may_write_sites_in_block(e: CheckEnv, m: Module, bid: i64, sites: Vec<i64>) [io] {
    let a: AstArena = m.arena;
    let stmts_lid: i64 = blk_stmts(a, bid);
    let n: i64 = list_len(a, stmts_lid);
    let mut i: i64 = 0;
    while i < n {
        let sid: i64 = list_get(a, stmts_lid, i);
        let stag: i64 = stmt_tag(a, sid);
        if stag == STMT_LET() {
            collect_may_write_sites_in_expr(e, m, stmt_c(a, sid), sites);
        } else {
            collect_may_write_sites_in_expr(e, m, stmt_a(a, sid), sites);
        }
        i = i + 1;
    }
    let trail: i64 = blk_trail(a, bid);
    if trail != -1 {
        collect_may_write_sites_in_expr(e, m, trail, sites);
    }
}

// Computes, for every function id in `fids` (declarations included — the
// caller must pass every ITEM_FN, not just the ones with a real body),
// whether calling it can perform a write reachable from its own parameters —
// a monotone fixed point over the call graph (0 -> 1 only), so (mutual)
// recursion is handled by construction: a cycle with one writing member
// taints the whole cycle, and the loop terminates because each bit only ever
// flips once. A declaration (`fn f(..) -> T;`, no body — the `.vow.d` stub
// form `use` can load instead of a module's real source, see
// tests/multi/decl_stub_preference/) is seeded straight to 1: its "body" is a
// parsed-but-empty placeholder block, so analyzing it would find no writes
// and fail *open* on a function this translation unit has no definition for.
// Iterates `fids` in caller-supplied (module item) order, not a hash-keyed
// structure, so the fixed point is deterministic — required for the stage
// A/B/C binary fixed point. Mutates e.may_write_fns in place; must run after
// every function's signature is registered (env_define_fn) and before any
// check_fn/check_clause_purity call consumes the table.
fn compute_may_write_table(e: CheckEnv, m: Module, fids: Vec<i64>) [io] {
    let a: AstArena = m.arena;
    let n: u64 = fids.len();
    let fidxs: Vec<i64> = Vec::new();
    let mut i: u64 = 0u64;
    while i < n {
        let fid: i64 = fids[i];
        let name: String = arena_str(a, fn_name_sid(a, fid));
        let fidx: i64 = env_lookup_fn(e, name);
        fidxs.push(fidx);
        if fidx != -1 && fn_is_declaration(a, fid) {
            e.may_write_fns[fidx as u64] = 1;
        }
        i = i + 1;
    }

    let mut changed: bool = true;
    while changed {
        changed = false;
        i = 0u64;
        while i < n {
            let fidx: i64 = fidxs[i];
            let fid: i64 = fids[i];
            if fidx != -1 && e.may_write_fns[fidx as u64] == 0 && !fn_is_declaration(a, fid) {
                let body_bid: i64 = fn_body_bid(a, fid);
                let sites: Vec<i64> = Vec::new();
                collect_may_write_sites_in_block(e, m, body_bid, sites);
                if sites.len() > 0u64 {
                    e.may_write_fns[fidx as u64] = 1;
                    changed = true;
                }
            }
            i = i + 1;
        }
    }
}

// Panic sites are builtin aborts the verifier cannot model: `.unwrap()` only.
// Index, checked-arithmetic and `/ %` aborts are verifier-modelled obligations
// of pure functions and deliberately not sites (docs/adr/2026-10-09-0900-panic-effect-scope.md).
fn collect_calls_in_expr(e: CheckEnv, m: Module, eid: i64, calls: Vec<String>) [io] {
    let a: AstArena = m.arena;
    let tag: i64 = expr_tag(a, eid);

    if tag == EXPR_CALL() {
        let callee_eid: i64 = expr_a(a, eid);
        let args_lid: i64 = expr_b(a, eid);
        let callee_tag: i64 = expr_tag(a, callee_eid);
        if callee_tag == EXPR_IDENT() {
            let name_sid: i64 = expr_a(a, callee_eid);
            let name: String = arena_str(a, name_sid);
            calls.push(name);
        }
        collect_calls_in_expr(e, m, callee_eid, calls);
        let n: i64 = list_len(a, args_lid);
        let mut i: i64 = 0;
        while i < n {
            collect_calls_in_expr(e, m, list_get(a, args_lid, i), calls);
            i = i + 1;
        }
        return;
    }

    if tag == EXPR_METHOD() {
        let recv_eid: i64 = expr_a(a, eid);
        let mname_sid: i64 = expr_b(a, eid);
        let args_lid: i64 = expr_c(a, eid);
        collect_calls_in_expr(e, m, recv_eid, calls);
        let n: i64 = list_len(a, args_lid);
        let mut i: i64 = 0;
        while i < n {
            collect_calls_in_expr(e, m, list_get(a, args_lid, i), calls);
            i = i + 1;
        }
        let mname: String = arena_str(a, mname_sid);
        if mname == String::from("unwrap") {
            calls.push(String::from("__unwrap__"));
        }
        return;
    }

    if tag == EXPR_BINOP() {
        collect_calls_in_expr(e, m, expr_b(a, eid), calls);
        collect_calls_in_expr(e, m, expr_c(a, eid), calls);
        return;
    }

    if tag == EXPR_UNOP() {
        collect_calls_in_expr(e, m, expr_b(a, eid), calls);
        return;
    }

    if tag == EXPR_FIELD() || tag == EXPR_QUESTION() {
        collect_calls_in_expr(e, m, expr_a(a, eid), calls);
        return;
    }

    if tag == EXPR_INDEX() {
        collect_calls_in_expr(e, m, expr_a(a, eid), calls);
        collect_calls_in_expr(e, m, expr_b(a, eid), calls);
        return;
    }

    if tag == EXPR_IF() {
        collect_calls_in_expr(e, m, expr_a(a, eid), calls);
        collect_calls_in_block(e, m, expr_b(a, eid), calls);
        let else_eid: i64 = expr_c(a, eid);
        if else_eid != -1 {
            collect_calls_in_expr(e, m, else_eid, calls);
        }
        return;
    }

    if tag == EXPR_WHILE() {
        collect_calls_in_expr(e, m, expr_a(a, eid), calls);
        collect_calls_in_block(e, m, expr_b(a, eid), calls);
        return;
    }

    if tag == EXPR_LOOP() {
        collect_calls_in_block(e, m, expr_a(a, eid), calls);
        return;
    }

    if tag == EXPR_FOR() {
        collect_calls_in_expr(e, m, expr_a(a, eid), calls);
        collect_calls_in_block(e, m, expr_b(a, eid), calls);
        return;
    }

    if tag == EXPR_MATCH() {
        collect_calls_in_expr(e, m, expr_a(a, eid), calls);
        let arms_lid: i64 = expr_b(a, eid);
        let n_pairs: i64 = list_len(a, arms_lid);
        let n_arms: i64 = n_pairs / 2;
        let mut i: i64 = 0;
        while i < n_arms {
            collect_calls_in_expr(e, m, list_get(a, arms_lid, i * 2 + 1), calls);
            i = i + 1;
        }
        return;
    }

    if tag == EXPR_RETURN() {
        let val_eid: i64 = expr_a(a, eid);
        if val_eid != -1 {
            collect_calls_in_expr(e, m, val_eid, calls);
        }
        return;
    }

    if tag == EXPR_BLOCK() {
        collect_calls_in_block(e, m, expr_a(a, eid), calls);
        return;
    }

    if tag == EXPR_ASSIGN() {
        collect_calls_in_expr(e, m, expr_a(a, eid), calls);
        collect_calls_in_expr(e, m, expr_b(a, eid), calls);
        return;
    }

    if tag == EXPR_SLIT() {
        let fields_lid: i64 = expr_b(a, eid);
        let n_pairs: i64 = list_len(a, fields_lid);
        let n_fields: i64 = n_pairs / 2;
        let mut i: i64 = 0;
        while i < n_fields {
            collect_calls_in_expr(e, m, list_get(a, fields_lid, i * 2 + 1), calls);
            i = i + 1;
        }
        return;
    }

    if tag == EXPR_ECTOR() {
        let args_lid: i64 = expr_b(a, eid);
        let n: i64 = list_len(a, args_lid);
        let mut i: i64 = 0;
        while i < n {
            collect_calls_in_expr(e, m, list_get(a, args_lid, i), calls);
            i = i + 1;
        }
        return;
    }

    if tag == EXPR_CAST() {
        collect_calls_in_expr(e, m, expr_a(a, eid), calls);
        return;
    }

    if tag == EXPR_TUPLE() {
        let elems_lid: i64 = expr_a(a, eid);
        let n: i64 = list_len(a, elems_lid);
        let mut i: i64 = 0;
        while i < n {
            collect_calls_in_expr(e, m, list_get(a, elems_lid, i), calls);
            i = i + 1;
        }
        return;
    }
}

fn collect_calls_in_block(e: CheckEnv, m: Module, bid: i64, calls: Vec<String>) [io] {
    let a: AstArena = m.arena;
    let stmts_lid: i64 = blk_stmts(a, bid);
    let n: i64 = list_len(a, stmts_lid);
    let mut i: i64 = 0;
    while i < n {
        let sid: i64 = list_get(a, stmts_lid, i);
        let stag: i64 = stmt_tag(a, sid);
        if stag == STMT_LET() {
            collect_calls_in_expr(e, m, stmt_c(a, sid), calls);
        } else {
            collect_calls_in_expr(e, m, stmt_a(a, sid), calls);
        }
        i = i + 1;
    }
    let trail: i64 = blk_trail(a, bid);
    if trail != -1 {
        collect_calls_in_expr(e, m, trail, calls);
    }
}

fn check_effects_fn(e: CheckEnv, m: Module, fid: i64) [io] {
    let a: AstArena = m.arena;
    let declared_eff: i64 = fn_eff(a, fid);
    let body_bid: i64 = fn_body_bid(a, fid);
    let calls: Vec<String> = Vec::new();
    collect_calls_in_block(e, m, body_bid, calls);
    let n: u64 = calls.len();
    let mut i: u64 = 0u64;
    let eff_panic: i64 = 2;
    while i < n {
        let cname: String = calls[i];
        if cname == String::from("__unwrap__") {
            if !has_eff_bit(declared_eff, eff_panic) {
                let fname: String = arena_str(a, fn_name_sid(a, fid));
                let hint: String = String::from("add 'Panic' to `");
                hint.push_str(fname);
                hint.push_str(String::from("`'s effect list, or use `?` to propagate the error instead"));
                env_emit_error_code_hint(e, EC_EFFECT_VIOLATION(), String::from(".unwrap() requires [panic] effect"), fn_span(a, fid), hint);
            }
        } else {
            let fidx: i64 = env_lookup_fn(e, cname);
            if fidx != -1 {
                let needed_eff: i64 = e.fn_effects[fidx as u64];
                if needed_eff != 0 && !effect_covered(declared_eff, needed_eff) {
                    env_emit_error(e, String::from("effectful call from pure function"), fn_span(a, fid));
                }
            }
        }
        i = i + 1;
    }
}
