module TestVcStr

use ir
use vc_ops
use vc_strops
use vc_term
use vc_smt
use vc_gate
use vc_exec
use vc_inline
use vc_str
use vc_vec
use verifier
use tests.builders

fn args1(a: i64) -> Vec<i64> {
    let v: Vec<i64> = Vec::new();
    v.push(a);
    v
}

fn args2(a: i64, b: i64) -> Vec<i64> {
    let v: Vec<i64> = args1(a);
    v.push(b);
    v
}

fn args3(a: i64, b: i64, c: i64) -> Vec<i64> {
    let v: Vec<i64> = args2(a, b);
    v.push(c);
    v
}

fn args4(a: i64, b: i64, c: i64, d: i64) -> Vec<i64> {
    let v: Vec<i64> = args3(a, b, c);
    v.push(d);
    v
}

fn ptr_params(n: u64) -> Vec<i64> {
    let p: Vec<i64> = Vec::new();
    let mut i: u64 = 0;
    while i < n {
        p.push(ITY_PTR());
        i = i + 1;
    }
    p
}

fn ptr_u64_params() -> Vec<i64> {
    let p: Vec<i64> = ptr_params(1);
    p.push(ITY_U64());
    p
}

fn one_block(params: Vec<i64>, ret: i64, insts: Vec<IrInst>) -> IrFunction {
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, insts));
    mk_function(1, String::from("f"), params, ret, blocks)
}

fn contains(hay: String, needle: String) -> bool {
    str_find_str(hay, needle) >= 0
}

fn query(cs: VcClaims, k: u64) -> String {
    vc_smt_render(cs.arena, vc_claim_script(cs, k))
}

fn mk_str(id: i64, text: String) -> IrInst {
    ir_inst_new(id, IOP_CONST_STR(), ITY_PTR(), Vec::new(), IDATA_CONST_STR(), 0, VC_STR_RESOLVED(), text)
}

fn mk_u64(id: i64, v: i64) -> IrInst {
    ir_inst_new(id, IOP_CONST_U64(), ITY_U64(), Vec::new(), IDATA_CONST_I64(), v, 0, String::from(""))
}

fn mk_u8(id: i64, v: i64) -> IrInst {
    ir_inst_new(id, IOP_CONST_U8(), ITY_U8(), Vec::new(), IDATA_CONST_I64(), v, 0, String::from(""))
}

fn mk_eq_u64(id: i64, a: i64, b: i64) -> IrInst {
    ir_inst_new(id, IOP_EQ(), ITY_BOOL(), args2(a, b), IDATA_NONE(), 0, 0, String::from(""))
}

fn mk_ens(id: i64, pred: i64, vow_id: i64) -> IrInst {
    ir_inst_new(id, IOP_VOW_ENS(), ITY_UNIT(), args1(pred), IDATA_VOW_ID(), vow_id, 0, String::from(""))
}

fn call(id: i64, ty: i64, args: Vec<i64>, sym: String) -> IrInst {
    mk_inst_call_extern(id, ty, args, sym)
}

// Every `String` runtime symbol the lowerer can emit that the catalogue does not
// carry is a modelled kind or has a reason of its own; a catalogue entry carries
// its reason in `operations.json` (checked by the generator).
fn check_op_table() -> i64 {
    if vc_inst_vec_kind(call(0, ITY_U64(), args1(0), String::from("__vow_string_len"))) != VC_VEC_LEN() { return 1; }
    if vc_vec_op_kind(String::from("__vow_string_new")) != VC_STR_NEW() { return 2; }
    if vc_vec_op_kind(String::from("__vow_string_literal")) != VC_STR_LITERAL() { return 3; }
    if vc_vec_op_kind(String::from("__vow_string_clone")) != VC_STR_CLONE() { return 4; }
    if vc_vec_op_kind(String::from("__vow_string_push_str")) != VC_STR_PUSH_STR() { return 5; }
    if vc_vec_op_kind(String::from("__vow_string_push_byte")) != VC_STR_PUSH_BYTE() { return 6; }
    if vc_vec_op_kind(String::from("__vow_string_clear")) != VC_STR_CLEAR() { return 7; }
    if vc_vec_op_kind(String::from("__vow_string_byte_at")) != VC_STR_BYTE_AT() { return 8; }
    if vc_vec_op_kind(String::from("__vow_string_eq")) != VC_STR_EQ() { return 9; }
    if vc_vec_op_kind(String::from("__vow_string_matches_literal_at")) != VC_STR_MATCHES_LITERAL_AT() { return 10; }
    if vc_vec_op_kind(String::from("__vow_string_substring")) != VC_STR_SUBSTRING() { return 11; }
    if vc_vec_op_kind(String::from("__vow_string_substr")) != VC_STR_SUBSTR() { return 12; }
    if vc_vec_op_kind(String::from("__vow_string_starts_with")) != VC_STR_STARTS_WITH() { return 13; }
    if vc_vec_op_kind(String::from("__vow_string_ends_with")) != VC_STR_ENDS_WITH() { return 14; }
    if vc_vec_op_kind(String::from("__vow_string_contains")) != VC_STR_NONE() { return 15; }
    if vc_vec_op_kind(String::from("__vow_string")) != VC_STR_NONE() { return 16; }
    if vc_vec_op_kind(String::from("__vow_string_")) != VC_STR_NONE() { return 17; }
    if vc_vec_op_kind(String::from("__vow_vec_clear")) != VC_STR_NONE() { return 18; }
    let rest: Vec<String> = Vec::new();
    rest.push(String::from("__vow_string_contains"));
    rest.push(String::from("__vow_string_pin_to_root"));
    rest.push(String::from("__vow_string_from_raw_parts_copy"));
    rest.push(String::from("__vow_string_from_cstr"));
    rest.push(String::from("__vow_string_parse_u64_opt"));
    rest.push(String::from("__vow_string_new_in_arena"));
    rest.push(String::from("__vow_string_push_str_in_arena"));
    rest.push(String::from("__vow_string_substring_in_arena"));
    let mut i: u64 = 0;
    while i < rest.len() {
        if vc_str_unmodeled_reason(rest[i]).len() == 0 { return 20 + i as i64; }
        i = i + 1;
    }
    if vc_str_unmodeled_reason(String::from("__vow_string_eq")).len() != 0 { return 40; }
    if !vc_vec_kind_mutates(VC_STR_PUSH_STR()) || !vc_vec_kind_mutates(VC_STR_PUSH_BYTE()) || !vc_vec_kind_mutates(VC_STR_CLEAR()) { return 41; }
    if vc_vec_kind_mutates(VC_STR_BYTE_AT()) || vc_vec_kind_mutates(VC_VEC_LEN()) { return 42; }
    0
}

// fn f(s: String, i: u64) -> i64 { s.byte_at(i) }
fn param_byte_at() -> IrFunction {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_arg(0, ITY_PTR(), 0));
    insts.push(mk_inst_arg(1, ITY_U64(), 1));
    insts.push(call(2, ITY_I64(), args2(0, 1), String::from("__vow_string_byte_at")));
    insts.push(mk_inst_const_i64(3, 255));
    insts.push(ir_inst_new(4, IOP_LE(), ITY_BOOL(), args2(2, 3), IDATA_NONE(), 0, 0, String::from("")));
    insts.push(mk_ens(5, 4, 0));
    insts.push(mk_inst_return(6, 2));
    one_block(ptr_u64_params(), ITY_I64(), insts)
}

// A byte read is the low byte of the element behind a bounds claim labelled like
// ESBMC's, and the element's junk high bits never show.
fn check_byte_at() -> i64 {
    let f: IrFunction = param_byte_at();
    if vc_skip_reason(f).len() != 0 { return 50; }
    let cs: VcClaims = vc_claims(f);
    if cs.kinds.len() != 2 { return 51; }
    if cs.kinds[0] != VC_CLAIM_VEC_BOUNDS() { return 52; }
    if cs.labels[0] != VC_LABEL_STRING_BOUNDS() { return 53; }
    let q: String = query(cs, 0);
    if !contains(q, String::from("(bvult p1 p0_vlen)")) { return 54; }
    if !contains(query(cs, 1), String::from("(bvand (select p0_varr p1) #x00000000000000ff)")) { return 55; }
    if contains(q, String::from("forall")) { return 56; }
    let hdr: SmtScript = cs.header;
    if hdr.names[0] != String::from("QF_ABV") { return 57; }
    0
}

// fn f(a: String, b: String) -> bool { a.eq(b) } with `ensures: result`.
fn param_eq() -> IrFunction {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_arg(0, ITY_PTR(), 0));
    insts.push(mk_inst_arg(1, ITY_PTR(), 1));
    insts.push(call(2, ITY_BOOL(), args2(0, 1), String::from("__vow_string_eq")));
    insts.push(mk_ens(3, 2, 0));
    insts.push(mk_inst_return(4, 2));
    one_block(ptr_params(2), ITY_BOOL(), insts)
}

// Equality of two parameter strings is exact at both polarities: a fresh Bool and
// index, one assumption for each direction, and the quantifier only inside an
// assumption, never in the goal. The query leaves the quantifier-free logic.
fn check_param_eq_is_exact() -> i64 {
    let f: IrFunction = param_eq();
    if vc_skip_reason(f).len() != 0 { return 60; }
    let cs: VcClaims = vc_claims(f);
    if cs.kinds.len() != 1 { return 61; }
    let hdr: SmtScript = cs.header;
    if hdr.names[0] != String::from("ABV") { return 62; }
    let q: String = query(cs, 0);
    if !contains(q, String::from("(declare-const se0 Bool)")) { return 63; }
    if !contains(q, String::from("(declare-const sk1 (_ BitVec 64))")) { return 64; }
    let fa: String = String::from("(forall ((vq_i (_ BitVec 64))) (=> (bvult vq_i p0_vlen) (= (bvand (select p0_varr vq_i) #x00000000000000ff) (bvand (select p1_varr (bvadd vq_i #x0000000000000000)) #x00000000000000ff))))");
    if !contains(q, fa) { return 65; }
    if !contains(q, String::from("(bvult sk1 p0_vlen)")) { return 66; }
    if !contains(q, String::from("(not (= p0_vlen p1_vlen))")) { return 67; }
    if !contains(q, String::from("(assert (not se0))")) { return 68; }
    // Length invariants of the two parameters plus the two halves of the equality.
    if cs.assumed_lens[0] != 4 { return 69; }
    0
}

// A string compared with itself is equal without a solver call.
fn check_eq_with_itself_folds() -> i64 {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_arg(0, ITY_PTR(), 0));
    insts.push(call(1, ITY_BOOL(), args2(0, 0), String::from("__vow_string_eq")));
    insts.push(mk_ens(2, 1, 0));
    insts.push(mk_inst_return(3, 1));
    let f: IrFunction = one_block(ptr_params(1), ITY_BOOL(), insts);
    if vc_skip_reason(f).len() != 0 { return 70; }
    let cs: VcClaims = vc_claims(f);
    if cs.kinds.len() != 0 { return 71; }
    0
}

// let a = "hello"; let b = "hello"; a.eq(b): both lengths are constants, so the
// comparison is a finite conjunction, never a quantifier.
fn check_literal_eq_unfolds() -> i64 {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_str(0, String::from("hello")));
    insts.push(call(1, ITY_PTR(), args1(0), String::from("__vow_string_literal")));
    insts.push(mk_str(2, String::from("hello")));
    insts.push(call(3, ITY_PTR(), args1(2), String::from("__vow_string_literal")));
    insts.push(call(4, ITY_BOOL(), args2(1, 3), String::from("__vow_string_eq")));
    insts.push(mk_ens(5, 4, 0));
    insts.push(mk_inst_return(6, 4));
    let f: IrFunction = one_block(Vec::new(), ITY_BOOL(), insts);
    if vc_skip_reason(f).len() != 0 { return 80; }
    let cs: VcClaims = vc_claims(f);
    if cs.kinds.len() != 1 { return 81; }
    let q: String = query(cs, 0);
    if contains(q, String::from("forall")) { return 82; }
    let hdr: SmtScript = cs.header;
    if hdr.names[0] != String::from("QF_ABV") { return 83; }
    // Each literal's bytes are facts about its array.
    if cs.assumed_lens[0] != 10 { return 84; }
    0
}

// Two literals of different lengths are unequal, with no assumption at all.
fn check_literal_eq_lengths_differ() -> i64 {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_str(0, String::from("hello")));
    insts.push(call(1, ITY_PTR(), args1(0), String::from("__vow_string_literal")));
    insts.push(mk_str(2, String::from("help")));
    insts.push(call(3, ITY_PTR(), args1(2), String::from("__vow_string_literal")));
    insts.push(call(4, ITY_BOOL(), args2(1, 3), String::from("__vow_string_eq")));
    insts.push(mk_inst_const_bool(5, 0));
    insts.push(mk_eq_u64(6, 4, 5));
    insts.push(mk_ens(7, 6, 0));
    insts.push(mk_inst_return(8, 4));
    let f: IrFunction = one_block(Vec::new(), ITY_BOOL(), insts);
    if vc_skip_reason(f).len() != 0 { return 90; }
    let cs: VcClaims = vc_claims(f);
    if cs.kinds.len() != 0 { return 91; }
    0
}

// let s = String::from("hi"); s.push_str(String::from(" there")); s.len() == 8:
// no instruction reads a byte, so the strings' contents are left unconstrained:
// no byte fact and no quantifier, and the length is a closed form that folds.
fn check_append_length_needs_no_contents() -> i64 {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_str(0, String::from("hi")));
    insts.push(call(1, ITY_PTR(), args1(0), String::from("__vow_string_literal")));
    insts.push(call(2, ITY_PTR(), args1(1), String::from("__vow_string_clone")));
    insts.push(mk_str(3, String::from(" there")));
    insts.push(call(4, ITY_PTR(), args1(3), String::from("__vow_string_literal")));
    insts.push(call(5, ITY_PTR(), args1(4), String::from("__vow_string_clone")));
    insts.push(call(6, ITY_UNIT(), args2(2, 5), String::from("__vow_string_push_str")));
    insts.push(call(7, ITY_U64(), args1(2), String::from("__vow_string_len")));
    insts.push(mk_u64(8, 8));
    insts.push(mk_eq_u64(9, 7, 8));
    insts.push(mk_ens(10, 9, 0));
    insts.push(mk_inst_return(11, 7));
    let f: IrFunction = one_block(Vec::new(), ITY_U64(), insts);
    if vc_skip_reason(f).len() != 0 { return 100; }
    let cs: VcClaims = vc_claims(f);
    if cs.kinds.len() != 0 { return 101; }
    if cs.assumed.len() != 0 { return 102; }
    0
}

// Appending reads back exactly: with a byte read the new array is a fresh array
// defined from both operands, and the length is the sum.
fn check_append_defines_contents() -> i64 {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_arg(0, ITY_PTR(), 0));
    insts.push(mk_inst_arg(1, ITY_PTR(), 1));
    insts.push(call(2, ITY_UNIT(), args2(0, 1), String::from("__vow_string_push_str")));
    insts.push(mk_u64(3, 0));
    insts.push(call(4, ITY_I64(), args2(0, 3), String::from("__vow_string_byte_at")));
    insts.push(mk_inst_return(5, 4));
    let f: IrFunction = one_block(ptr_params(2), ITY_I64(), insts);
    if vc_skip_reason(f).len() != 0 { return 110; }
    let cs: VcClaims = vc_claims(f);
    if cs.kinds.len() != 1 { return 111; }
    let q: String = query(cs, 0);
    if !contains(q, String::from("(declare-const ssa0_varr")) && !contains(q, String::from("_varr (Array")) { return 112; }
    if !contains(q, String::from("(bvadd p0_vlen p1_vlen)")) { return 113; }
    if !contains(q, String::from("(forall ((vq_i (_ BitVec 64))) (=> (bvult vq_i p0_vlen)")) { return 114; }
    if !contains(q, String::from("(bvult (bvadd p0_vlen p1_vlen) #x7fffffffffffffff)")) { return 115; }
    0
}

// Two appends of the same operands share one array, so equal builds compare equal
// without the solver relating two quantified definitions; an append of different
// operands does not share.
fn check_identical_appends_share_an_array() -> i64 {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_arg(0, ITY_PTR(), 0));
    insts.push(mk_inst_arg(1, ITY_PTR(), 1));
    insts.push(call(2, ITY_PTR(), args1(0), String::from("__vow_string_clone")));
    insts.push(call(3, ITY_UNIT(), args2(2, 1), String::from("__vow_string_push_str")));
    insts.push(call(4, ITY_PTR(), args1(0), String::from("__vow_string_clone")));
    insts.push(call(5, ITY_UNIT(), args2(4, 1), String::from("__vow_string_push_str")));
    insts.push(call(6, ITY_BOOL(), args2(2, 4), String::from("__vow_string_eq")));
    insts.push(mk_ens(7, 6, 0));
    insts.push(mk_inst_return(8, 6));
    let f: IrFunction = one_block(ptr_params(2), ITY_BOOL(), insts);
    if vc_skip_reason(f).len() != 0 { return 195; }
    let cs: VcClaims = vc_claims(f);
    if cs.kinds.len() != 0 { return 196; }
    let hdr: SmtScript = cs.header;
    let mut built: i64 = 0;
    let mut i: u64 = 0;
    while i < hdr.names.len() {
        if hdr.kinds[i] == VC_CMD_DECLARE_CONST() && hdr.names[i].len() > 2 && hdr.names[i].substring(0, 2) == String::from("sa") { built = built + 1; }
        i = i + 1;
    }
    if built != 1 { return 197; }

    let other: Vec<IrInst> = Vec::new();
    other.push(mk_inst_arg(0, ITY_PTR(), 0));
    other.push(mk_inst_arg(1, ITY_PTR(), 1));
    other.push(call(2, ITY_PTR(), args1(0), String::from("__vow_string_clone")));
    other.push(call(3, ITY_UNIT(), args2(2, 1), String::from("__vow_string_push_str")));
    other.push(call(4, ITY_PTR(), args1(1), String::from("__vow_string_clone")));
    other.push(call(5, ITY_UNIT(), args2(4, 0), String::from("__vow_string_push_str")));
    other.push(call(6, ITY_BOOL(), args2(2, 4), String::from("__vow_string_eq")));
    other.push(mk_ens(7, 6, 0));
    other.push(mk_inst_return(8, 6));
    let g: IrFunction = one_block(ptr_params(2), ITY_BOOL(), other);
    let cg: VcClaims = vc_claims(g);
    if cg.kinds.len() != 1 { return 198; }
    0
}

// `push_byte` stores the zero-extended byte at the length; `clear` empties the
// length and keeps the array.
fn check_push_byte_and_clear() -> i64 {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_arg(0, ITY_PTR(), 0));
    insts.push(mk_u8(1, 200));
    insts.push(call(2, ITY_UNIT(), args2(0, 1), String::from("__vow_string_push_byte")));
    insts.push(call(3, ITY_U64(), args1(0), String::from("__vow_string_len")));
    insts.push(call(4, ITY_UNIT(), args1(0), String::from("__vow_string_clear")));
    insts.push(call(5, ITY_U64(), args1(0), String::from("__vow_string_len")));
    insts.push(mk_u64(6, 0));
    insts.push(mk_eq_u64(7, 5, 6));
    insts.push(mk_ens(8, 7, 0));
    insts.push(mk_inst_return(9, 3));
    let f: IrFunction = one_block(ptr_params(1), ITY_U64(), insts);
    if vc_skip_reason(f).len() != 0 { return 120; }
    let cs: VcClaims = vc_claims(f);
    // The clear leaves a constant 0 length: the postcondition folds away.
    if cs.kinds.len() != 0 { return 121; }
    if cs.assumed_lens.len() != 0 { return 122; }
    if cs.assumed.len() != 2 { return 123; }
    if vc_term_text(cs.arena, cs.assumed[1]) != String::from("(bvult p0_vlen #x7ffffffffffffffe)") { return 124; }
    0
}

// string_matches_literal_at is a finite conjunction over the literal's bytes
// behind the no-wrap length test.
fn check_matches_literal_at() -> i64 {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_arg(0, ITY_PTR(), 0));
    insts.push(mk_inst_arg(1, ITY_U64(), 1));
    insts.push(mk_str(2, String::from("ab")));
    insts.push(mk_inst_const_i64(3, 2));
    insts.push(call(4, ITY_I64(), args4(0, 1, 2, 3), String::from("__vow_string_matches_literal_at")));
    insts.push(mk_inst_const_i64(5, 1));
    insts.push(ir_inst_new(6, IOP_EQ(), ITY_BOOL(), args2(4, 5), IDATA_NONE(), 0, 0, String::from("")));
    insts.push(mk_ens(7, 6, 0));
    insts.push(mk_inst_return(8, 4));
    let f: IrFunction = one_block(ptr_u64_params(), ITY_I64(), insts);
    if vc_skip_reason(f).len() != 0 { return 130; }
    let cs: VcClaims = vc_claims(f);
    if cs.kinds.len() != 1 { return 131; }
    let q: String = query(cs, 0);
    if contains(q, String::from("forall")) { return 132; }
    if !contains(q, String::from("(bvule p1 p0_vlen)")) { return 133; }
    if !contains(q, String::from("(bvule #x0000000000000002 (bvsub p0_vlen p1))")) { return 134; }
    if !contains(q, String::from("(= (bvand (select p0_varr p1) #x00000000000000ff) #x0000000000000061)")) { return 135; }
    if !contains(q, String::from("(= (bvand (select p0_varr (bvadd p1 #x0000000000000001)) #x00000000000000ff) #x0000000000000062)")) { return 136; }
    0
}

// substring clamps start to the length and end into [start, length]; the result
// is a new object, so the receiver is untouched.
fn check_substring_length() -> i64 {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_arg(0, ITY_PTR(), 0));
    insts.push(mk_inst_arg(1, ITY_U64(), 1));
    insts.push(mk_inst_arg(2, ITY_U64(), 2));
    insts.push(call(3, ITY_PTR(), args3(0, 1, 2), String::from("__vow_string_substring")));
    insts.push(call(4, ITY_U64(), args1(3), String::from("__vow_string_len")));
    insts.push(call(5, ITY_U64(), args1(0), String::from("__vow_string_len")));
    insts.push(ir_inst_new(6, IOP_LE(), ITY_BOOL(), args2(4, 5), IDATA_NONE(), 0, 0, String::from("")));
    insts.push(mk_ens(7, 6, 0));
    insts.push(mk_inst_return(8, 4));
    let p: Vec<i64> = ptr_u64_params();
    p.push(ITY_U64());
    let f: IrFunction = one_block(p, ITY_U64(), insts);
    if vc_skip_reason(f).len() != 0 { return 140; }
    let cs: VcClaims = vc_claims(f);
    if cs.kinds.len() != 1 { return 141; }
    let q: String = query(cs, 0);
    if contains(q, String::from("forall")) { return 142; }
    0
}

// A ConstStr is only modelled once the module's pool has been read into it, and
// the module's own function is not changed by that.
fn check_resolve_literals() -> i64 {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(ir_inst_new(0, IOP_CONST_STR(), ITY_PTR(), Vec::new(), IDATA_CONST_STR(), 1, 0, String::from("")));
    insts.push(call(1, ITY_PTR(), args1(0), String::from("__vow_string_literal")));
    insts.push(call(2, ITY_U64(), args1(1), String::from("__vow_string_len")));
    insts.push(mk_inst_return(3, 2));
    let f: IrFunction = one_block(Vec::new(), ITY_U64(), insts);
    if vc_skip_reason(f).len() == 0 { return 150; }
    let funcs: Vec<IrFunction> = Vec::new();
    funcs.push(f);
    let m: IrModule = mk_module(funcs);
    m.strings.push(String::from("zero"));
    m.strings.push(String::from("one"));
    let g: IrFunction = vc_resolve_str_literals(f, m);
    let blk: IrBlock = g.blocks[0];
    let lit: IrInst = blk.insts[0];
    if lit.ds != String::from("one") { return 151; }
    if lit.dv2 != VC_STR_RESOLVED() { return 152; }
    let orig: IrBlock = f.blocks[0];
    let orig_lit: IrInst = orig.insts[0];
    if orig_lit.dv2 == VC_STR_RESOLVED() { return 153; }
    if vc_skip_reason(g).len() != 0 { return 154; }
    if vc_module_skip_reason(f, m).len() != 0 { return 155; }
    let cs: VcClaims = vc_claims(g);
    if cs.kinds.len() != 0 { return 156; }
    // An index outside the pool stays unresolved: fail closed.
    let far: IrInst = ir_inst_new(0, IOP_CONST_STR(), ITY_PTR(), Vec::new(), IDATA_CONST_STR(), 9, 0, String::from(""));
    let fi: Vec<IrInst> = Vec::new();
    fi.push(far);
    fi.push(call(1, ITY_PTR(), args1(0), String::from("__vow_string_literal")));
    fi.push(mk_inst_return(2, 1));
    let bad: IrFunction = one_block(Vec::new(), ITY_PTR(), fi);
    let r: IrFunction = vc_resolve_str_literals(bad, m);
    if vc_skip_reason(r).len() == 0 { return 157; }
    0
}

// The shape rules of the String model.
fn check_shape_rejections() -> i64 {
    // The static bytes of a literal feed nothing but a literal.
    let leak: Vec<IrInst> = Vec::new();
    leak.push(mk_str(0, String::from("x")));
    leak.push(call(1, ITY_PTR(), args1(0), String::from("__vow_string_clone")));
    leak.push(mk_inst_return(2, 1));
    let f1: IrFunction = one_block(Vec::new(), ITY_PTR(), leak);
    if vc_str_shape_detail(f1, 8) != String::from("String literal bytes used outside a literal") { return 160; }
    if vc_skip_reason(f1).len() == 0 { return 161; }

    // A literal is read-only at run time: a mutation traps, outside the model.
    let mutated: Vec<IrInst> = Vec::new();
    mutated.push(mk_str(0, String::from("x")));
    mutated.push(call(1, ITY_PTR(), args1(0), String::from("__vow_string_literal")));
    mutated.push(call(2, ITY_UNIT(), args1(1), String::from("__vow_string_clear")));
    mutated.push(mk_inst_return(3, 1));
    let f2: IrFunction = one_block(Vec::new(), ITY_PTR(), mutated);
    if vc_str_shape_detail(f2, 8) != String::from("String literal mutated") { return 162; }
    if vc_skip_reason(f2).len() == 0 { return 163; }

    // A clone of a literal is a fresh, mutable string.
    let cloned: Vec<IrInst> = Vec::new();
    cloned.push(mk_str(0, String::from("x")));
    cloned.push(call(1, ITY_PTR(), args1(0), String::from("__vow_string_literal")));
    cloned.push(call(2, ITY_PTR(), args1(1), String::from("__vow_string_clone")));
    cloned.push(call(3, ITY_UNIT(), args1(2), String::from("__vow_string_clear")));
    cloned.push(mk_inst_return(4, 2));
    let f3: IrFunction = one_block(Vec::new(), ITY_PTR(), cloned);
    if vc_str_shape_detail(f3, 8).len() != 0 { return 164; }
    if vc_skip_reason(f3).len() != 0 { return 165; }

    // String::new has a null pointer and a zero length.
    let fresh: Vec<IrInst> = Vec::new();
    fresh.push(mk_inst_const_i64(0, 0));
    fresh.push(mk_inst_const_i64(1, 8));
    fresh.push(call(2, ITY_PTR(), args2(0, 1), String::from("__vow_string_new")));
    fresh.push(mk_inst_return(3, 2));
    let f4: IrFunction = one_block(Vec::new(), ITY_PTR(), fresh);
    if vc_str_shape_detail(f4, 8) != String::from("String::new with a non-zero pointer or length") { return 166; }
    let empty: Vec<IrInst> = Vec::new();
    empty.push(mk_inst_const_i64(0, 0));
    empty.push(mk_inst_const_i64(1, 0));
    empty.push(call(2, ITY_PTR(), args2(0, 1), String::from("__vow_string_new")));
    empty.push(mk_inst_return(3, 2));
    let f5: IrFunction = one_block(Vec::new(), ITY_PTR(), empty);
    if vc_str_shape_detail(f5, 8).len() != 0 { return 167; }
    if vc_skip_reason(f5).len() != 0 { return 168; }
    0
}

// Gate type rules: a byte is a `u8`, an offset a 64-bit integer, equality yields a Bool.
fn check_gate_types() -> i64 {
    let wide: Vec<IrInst> = Vec::new();
    wide.push(mk_inst_arg(0, ITY_PTR(), 0));
    wide.push(mk_inst_const_i64(1, 7));
    wide.push(call(2, ITY_UNIT(), args2(0, 1), String::from("__vow_string_push_byte")));
    wide.push(mk_inst_return(3, 2));
    let f1: IrFunction = one_block(ptr_params(1), ITY_UNIT(), wide);
    if vc_skip_reason(f1).len() == 0 { return 170; }

    let narrow: Vec<IrInst> = Vec::new();
    narrow.push(mk_inst_arg(0, ITY_PTR(), 0));
    narrow.push(mk_inst_arg(1, ITY_I32(), 1));
    narrow.push(call(2, ITY_I64(), args2(0, 1), String::from("__vow_string_byte_at")));
    narrow.push(mk_inst_return(3, 2));
    let p: Vec<i64> = ptr_params(1);
    p.push(ITY_I32());
    let f2: IrFunction = one_block(p, ITY_I64(), narrow);
    if vc_skip_reason(f2).len() == 0 { return 171; }

    let notbool: Vec<IrInst> = Vec::new();
    notbool.push(mk_inst_arg(0, ITY_PTR(), 0));
    notbool.push(mk_inst_arg(1, ITY_PTR(), 1));
    notbool.push(call(2, ITY_I64(), args2(0, 1), String::from("__vow_string_eq")));
    notbool.push(mk_inst_return(3, 2));
    let f3: IrFunction = one_block(ptr_params(2), ITY_I64(), notbool);
    if vc_skip_reason(f3).len() == 0 { return 172; }

    // `contains` stays an unmodelled builtin, with the symbol as its detail.
    let sub: Vec<IrInst> = Vec::new();
    sub.push(mk_inst_arg(0, ITY_PTR(), 0));
    sub.push(mk_inst_arg(1, ITY_PTR(), 1));
    sub.push(call(2, ITY_BOOL(), args2(0, 1), String::from("__vow_string_contains")));
    sub.push(mk_inst_return(3, 2));
    let f4: IrFunction = one_block(ptr_params(2), ITY_BOOL(), sub);
    if vc_skip_reason(f4) != String::from("unmodeled-builtin: __vow_string_contains") { return 173; }
    0
}

// A byte read spliced from a callee carries its frame, so its bounds claim is
// blamed on the right call.
fn check_frame_of_byte_at() -> i64 {
    let get: IrInst = call(2, ITY_I64(), args2(0, 1), String::from("__vow_string_byte_at"));
    if vc_frame_of(get) != -1 { return 180; }
    get.dv2 = 3;
    if vc_frame_of(get) != 2 { return 181; }
    let eq: IrInst = call(3, ITY_BOOL(), args2(0, 1), String::from("__vow_string_eq"));
    eq.dv2 = 3;
    if vc_frame_of(eq) != -1 { return 182; }
    0
}

// The binder's text is closed and fixed: nothing in it names a variable of the
// query but the operands.
fn check_binder_text() -> i64 {
    let ar: VcArena = vc_arena_new();
    let a: i64 = vc_tm_var(ar, String::from("A"));
    let b: i64 = vc_tm_var(ar, String::from("B"));
    let k: i64 = vc_tm_var(ar, String::from("K"));
    let n: i64 = vc_tm_var(ar, String::from("N"));
    let t: i64 = vc_tm_qeq(ar, a, b, k, n);
    let want: String = String::from("(forall ((vq_i (_ BitVec 64))) (=> (bvult vq_i N) (= (bvand (select A vq_i) #x00000000000000ff) (bvand (select B (bvadd vq_i K)) #x00000000000000ff))))");
    if vc_term_text(ar, t) != want { return 190; }
    if vc_tm_is_leaf(ar, t) { return 191; }
    if vc_tm_qeq(ar, a, b, k, n) != t { return 192; }
    if vc_tm_qeq(ar, b, a, k, n) == t { return 193; }
    0
}

fn main() -> i32 {
    let mut r: i64 = check_op_table();
    if r == 0 { r = check_byte_at(); }
    if r == 0 { r = check_param_eq_is_exact(); }
    if r == 0 { r = check_eq_with_itself_folds(); }
    if r == 0 { r = check_literal_eq_unfolds(); }
    if r == 0 { r = check_literal_eq_lengths_differ(); }
    if r == 0 { r = check_append_length_needs_no_contents(); }
    if r == 0 { r = check_append_defines_contents(); }
    if r == 0 { r = check_identical_appends_share_an_array(); }
    if r == 0 { r = check_push_byte_and_clear(); }
    if r == 0 { r = check_matches_literal_at(); }
    if r == 0 { r = check_substring_length(); }
    if r == 0 { r = check_resolve_literals(); }
    if r == 0 { r = check_shape_rejections(); }
    if r == 0 { r = check_gate_types(); }
    if r == 0 { r = check_frame_of_byte_at(); }
    if r == 0 { r = check_binder_text(); }
    i64_to_i32_wrap(r)
}
