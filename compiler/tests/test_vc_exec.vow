module TestVcExec

use ir
use vc_term
use vc_smt
use vc_gate
use vc_exec
use tests.builders

fn args1(a: i64) -> Vec<i64> {
    let v: Vec<i64> = Vec::new();
    v.push(a);
    v
}

fn args2(a: i64, b: i64) -> Vec<i64> {
    let v: Vec<i64> = Vec::new();
    v.push(a);
    v.push(b);
    v
}

fn params2() -> Vec<i64> {
    let p: Vec<i64> = Vec::new();
    p.push(ITY_I64());
    p.push(ITY_I64());
    p
}

fn mk_vow(id: i64, op: i64, pred: i64, vow_id: i64) -> IrInst {
    ir_inst_new(id, op, ITY_UNIT(), args1(pred), IDATA_VOW_ID(), vow_id, 0, String::from(""))
}

fn one_block(name: String, params: Vec<i64>, ret: i64, insts: Vec<IrInst>) -> IrFunction {
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, insts));
    mk_function(1, name, params, ret, blocks)
}

fn query(cs: VcClaims, k: u64) -> String {
    vc_smt_render(cs.arena, vc_claim_script(cs, k))
}

fn count_of(hay: String, needle: String) -> i64 {
    let mut n: i64 = 0;
    let mut i: u64 = 0;
    while i + needle.len() <= hay.len() {
        if hay.substring(i, i + needle.len()) == needle {
            n = n + 1;
        }
        i = i + 1;
    }
    n
}

// divide(x, y) requires y > 0, body x / y
fn divide_with_requires(op: i64) -> IrFunction {
    let i: Vec<IrInst> = Vec::new();
    i.push(mk_inst_arg(0, ITY_I64(), 0));
    i.push(mk_inst_arg(1, ITY_I64(), 1));
    i.push(mk_inst_const_i64(2, 0));
    i.push(mk_inst(3, IOP_GT(), ITY_BOOL(), args2(1, 2)));
    i.push(mk_vow(4, IOP_VOW_REQ(), 3, 0));
    i.push(mk_inst(5, op, ITY_I64(), args2(0, 1)));
    i.push(mk_inst_return(6, 5));
    one_block(String::from("divide"), params2(), ITY_I64(), i)
}

fn check_divide_with_requires() -> i64 {
    let f: IrFunction = divide_with_requires(IOP_WDIV());
    if vc_skip_reason(f).len() != 0 { return 1; }
    let cs: VcClaims = vc_claims(f);
    if cs.kinds.len() != 2 { return 2; }
    if cs.kinds[0] != VC_CLAIM_DIV_ZERO() { return 3; }
    if cs.kinds[1] != VC_CLAIM_DIV_OVERFLOW() { return 4; }
    if cs.vow_ids[0] != -1 { return 5; }
    if cs.labels[0] != String::from("division by zero") { return 6; }
    if cs.labels[1] != String::from("division overflow") { return 7; }
    let q0: String = query(cs, 0);
    if !q0.contains(String::from("(assert v3)\n(assert (not (distinct v1 (_ bv0 64))))\n(check-sat)")) { return 8; }
    let q1: String = query(cs, 1);
    if !q1.contains(String::from("(assert v3)\n(assert (distinct v1 (_ bv0 64)))\n(assert (not (not (and (= v0 (_ bv9223372036854775808 64)) (= v1 (_ bv18446744073709551615 64))))))\n")) { return 9; }
    0
}

fn check_rem_has_only_zero_claim() -> i64 {
    let cs: VcClaims = vc_claims(divide_with_requires(IOP_WREM()));
    if cs.kinds.len() != 1 { return 10; }
    if cs.kinds[0] != VC_CLAIM_DIV_ZERO() { return 11; }
    0
}

// twice(x) requires x > 0 ensures result > x, body x + x
fn check_ensures_claim_golden() -> i64 {
    let i: Vec<IrInst> = Vec::new();
    i.push(mk_inst_arg(0, ITY_I64(), 0));
    i.push(mk_inst_const_i64(1, 0));
    i.push(mk_inst(2, IOP_GT(), ITY_BOOL(), args2(0, 1)));
    i.push(mk_vow(3, IOP_VOW_REQ(), 2, 0));
    i.push(mk_inst_add(4, 0, 0));
    i.push(mk_inst(5, IOP_GT(), ITY_BOOL(), args2(4, 0)));
    i.push(mk_vow(6, IOP_VOW_ENS(), 5, 1));
    i.push(mk_inst_return(7, 4));
    let p: Vec<i64> = Vec::new();
    p.push(ITY_I64());
    let f: IrFunction = one_block(String::from("twice"), p, ITY_I64(), i);
    let cs: VcClaims = vc_claims(f);
    if cs.kinds.len() != 1 { return 20; }
    if cs.kinds[0] != VC_CLAIM_ENSURES() { return 21; }
    if cs.vow_ids[0] != 1 { return 22; }
    let want: String = String::from("(set-logic QF_BV)\n");
    want.push_str(String::from("(set-option :produce-models true)\n"));
    want.push_str(String::from("(declare-const p0 (_ BitVec 64))\n"));
    want.push_str(String::from("(define-fun v0 () (_ BitVec 64) p0)\n"));
    want.push_str(String::from("(define-fun v1 () (_ BitVec 64) (_ bv0 64))\n"));
    want.push_str(String::from("(define-fun v2 () Bool (bvsgt v0 v1))\n"));
    want.push_str(String::from("(define-fun v4 () (_ BitVec 64) (bvadd v0 v0))\n"));
    want.push_str(String::from("(define-fun v5 () Bool (bvsgt v4 v0))\n"));
    want.push_str(String::from("(assert v2)\n"));
    want.push_str(String::from("(assert (not v5))\n"));
    want.push_str(String::from("(check-sat)\n"));
    want.push_str(String::from("(get-value (p0))\n"));
    if query(cs, 0) != want { return 23; }
    0
}

fn check_requires_only_has_no_claims() -> i64 {
    let i: Vec<IrInst> = Vec::new();
    i.push(mk_inst_arg(0, ITY_I64(), 0));
    i.push(mk_inst_const_i64(1, 0));
    i.push(mk_inst(2, IOP_GE(), ITY_BOOL(), args2(0, 1)));
    i.push(mk_vow(3, IOP_VOW_REQ(), 2, 0));
    i.push(mk_inst_return(4, 0));
    let p: Vec<i64> = Vec::new();
    p.push(ITY_I64());
    let cs: VcClaims = vc_claims(one_block(String::from("r"), p, ITY_I64(), i));
    if cs.kinds.len() != 0 { return 30; }
    0
}

fn check_second_division_assumes_first() -> i64 {
    let i: Vec<IrInst> = Vec::new();
    i.push(mk_inst_arg(0, ITY_I64(), 0));
    i.push(mk_inst_arg(1, ITY_I64(), 1));
    i.push(mk_inst(2, IOP_WDIV(), ITY_I64(), args2(0, 1)));
    i.push(mk_inst(3, IOP_WREM(), ITY_I64(), args2(2, 1)));
    i.push(mk_inst_return(4, 3));
    let cs: VcClaims = vc_claims(one_block(String::from("dd"), params2(), ITY_I64(), i));
    if cs.kinds.len() != 3 { return 40; }
    if cs.kinds[2] != VC_CLAIM_DIV_ZERO() { return 41; }
    let q: String = query(cs, 2);
    if count_of(q, String::from("(assert (distinct v1 (_ bv0 64)))")) != 1 { return 42; }
    if !q.contains(String::from("(assert (not (and (= v0 ")) { return 43; }
    let first: String = query(cs, 0);
    if first.contains(String::from("(assert (distinct v1")) { return 44; }
    if first.contains(String::from("(define-fun v2 ")) { return 45; }
    if !query(cs, 2).contains(String::from("(define-fun v2 ")) { return 46; }
    0
}

// A division inside a requires clause is a claim that must not assume that requires.
fn check_division_in_requires_is_positional() -> i64 {
    let i: Vec<IrInst> = Vec::new();
    i.push(mk_inst_arg(0, ITY_I64(), 0));
    i.push(mk_inst_arg(1, ITY_I64(), 1));
    i.push(mk_inst(2, IOP_WREM(), ITY_I64(), args2(0, 1)));
    i.push(mk_inst_const_i64(3, 0));
    i.push(mk_inst(4, IOP_EQ(), ITY_BOOL(), args2(2, 3)));
    i.push(mk_vow(5, IOP_VOW_REQ(), 4, 0));
    i.push(mk_inst_return(6, 0));
    let cs: VcClaims = vc_claims(one_block(String::from("rq"), params2(), ITY_I64(), i));
    if cs.kinds.len() != 1 { return 50; }
    if query(cs, 0).contains(String::from("(assert v4)")) { return 51; }
    0
}

fn check_names_are_internal() -> i64 {
    let i: Vec<IrInst> = Vec::new();
    i.push(mk_inst_arg(0, ITY_I64(), 0));
    i.push(mk_inst(1, IOP_EQ(), ITY_BOOL(), args2(0, 0)));
    i.push(mk_vow(2, IOP_VOW_ENS(), 1, 0));
    i.push(mk_inst_return(3, 0));
    let p: Vec<i64> = Vec::new();
    p.push(ITY_I64());
    let f: IrFunction = one_block(String::from("evil"), p, ITY_I64(), i);
    f.param_names[0] = String::from("x\"; (assert false)");
    let cs: VcClaims = vc_claims(f);
    if cs.kinds.len() != 1 { return 60; }
    let q: String = query(cs, 0);
    if q.contains(String::from("assert false")) { return 61; }
    if q.contains(String::from("evil")) { return 62; }
    if cs.model_names.len() != 1 || cs.model_names[0] != String::from("p0") { return 63; }
    0
}

fn check_bool_operators() -> i64 {
    let i: Vec<IrInst> = Vec::new();
    i.push(mk_inst_const_i64(0, 1));
    i.push(mk_inst(1, IOP_EQ(), ITY_BOOL(), args2(0, 0)));
    i.push(mk_inst(2, IOP_NOT(), ITY_BOOL(), args1(1)));
    i.push(mk_inst(3, IOP_OR(), ITY_BOOL(), args2(1, 2)));
    i.push(mk_inst(4, IOP_AND(), ITY_BOOL(), args2(3, 1)));
    i.push(mk_vow(5, IOP_VOW_ENS(), 4, 0));
    i.push(mk_inst_return(6, 0));
    let f: IrFunction = one_block(String::from("b"), Vec::new(), ITY_I64(), i);
    let cs: VcClaims = vc_claims(f);
    let q: String = query(cs, 0);
    if !q.contains(String::from("(define-fun v2 () Bool (not v1))\n")) { return 70; }
    if !q.contains(String::from("(define-fun v3 () Bool (or v1 v2))\n")) { return 71; }
    if !q.contains(String::from("(define-fun v4 () Bool (and v3 v1))\n")) { return 72; }
    if q.contains(String::from("get-value")) { return 73; }
    0
}

// pick(x): ensures result >= 0 over `if x > 0 { x } else { 0 }`.
fn pick_function() -> IrFunction {
    let a: Vec<IrInst> = Vec::new();
    a.push(mk_inst_arg(0, ITY_I64(), 0));
    a.push(mk_inst_const_i64(1, 0));
    a.push(mk_inst(2, IOP_GT(), ITY_BOOL(), args2(0, 1)));
    a.push(mk_inst_branch(3, 2, 1, 2));
    let t: Vec<IrInst> = Vec::new();
    t.push(mk_inst_upsilon(4, 0, 9));
    t.push(mk_inst_jump(5, 3));
    let e: Vec<IrInst> = Vec::new();
    e.push(mk_inst_const_i64(6, 0));
    e.push(mk_inst_upsilon(7, 6, 9));
    e.push(mk_inst_jump(8, 3));
    let m: Vec<IrInst> = Vec::new();
    m.push(mk_inst_phi(9, ITY_I64()));
    m.push(mk_inst_const_i64(10, 0));
    m.push(mk_inst(11, IOP_GE(), ITY_BOOL(), args2(9, 10)));
    m.push(mk_vow(12, IOP_VOW_ENS(), 11, 0));
    m.push(mk_inst_return(13, 9));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, a));
    blocks.push(mk_block(1, t));
    blocks.push(mk_block(2, e));
    blocks.push(mk_block(3, m));
    mk_function(1, String::from("pick"), mk_params1(), ITY_I64(), blocks)
}

fn check_diamond_phi_is_ite() -> i64 {
    let f: IrFunction = pick_function();
    if vc_skip_reason(f).len() != 0 { return 80; }
    let cs: VcClaims = vc_claims(f);
    if cs.kinds.len() != 1 { return 81; }
    let q: String = query(cs, 0);
    if !q.contains(String::from("(define-fun g0 () Bool (not v2))\n")) { return 82; }
    if !q.contains(String::from("(define-fun g1 () Bool (or v2 g0))\n")) { return 83; }
    if !q.contains(String::from("(define-fun v9 () (_ BitVec 64) (ite g0 v6 v0))\n")) { return 84; }
    if !q.contains(String::from("(assert (and g1 (not v11)))\n")) { return 85; }
    0
}

// Two returning arms, each with its own ensures: a claim holds only under its
// own path condition.
fn check_early_return_claims_carry_path_condition() -> i64 {
    let a: Vec<IrInst> = Vec::new();
    a.push(mk_inst_arg(0, ITY_I64(), 0));
    a.push(mk_inst_const_i64(1, 0));
    a.push(mk_inst(2, IOP_LT(), ITY_BOOL(), args2(0, 1)));
    a.push(mk_inst_branch(3, 2, 1, 2));
    let neg: Vec<IrInst> = Vec::new();
    neg.push(mk_inst(4, IOP_GE(), ITY_BOOL(), args2(0, 1)));
    neg.push(mk_vow(5, IOP_VOW_ENS(), 4, 0));
    neg.push(mk_inst_return(6, 0));
    let pos: Vec<IrInst> = Vec::new();
    pos.push(mk_inst(7, IOP_GE(), ITY_BOOL(), args2(0, 1)));
    pos.push(mk_vow(8, IOP_VOW_ENS(), 7, 1));
    pos.push(mk_inst_return(9, 0));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, a));
    blocks.push(mk_block(1, neg));
    blocks.push(mk_block(2, pos));
    let f: IrFunction = mk_function(1, String::from("early"), mk_params1(), ITY_I64(), blocks);
    if vc_skip_reason(f).len() != 0 { return 90; }
    let cs: VcClaims = vc_claims(f);
    if cs.kinds.len() != 2 { return 91; }
    let mut neg_k: u64 = 0;
    if cs.vow_ids[1] == 0 { neg_k = 1; }
    let pos_k: u64 = 1 - neg_k;
    if cs.vow_ids[neg_k] != 0 || cs.vow_ids[pos_k] != 1 { return 92; }
    if !query(cs, neg_k).contains(String::from("(assert (and v2 (not v4)))\n")) { return 93; }
    if !query(cs, pos_k).contains(String::from("(assert (and g0 (not v7)))\n")) { return 94; }
    0
}

// A guard the path already decided leaves the other arm unexecuted.
fn check_constant_guard_prunes_dead_arm() -> i64 {
    let a: Vec<IrInst> = Vec::new();
    a.push(mk_inst_arg(0, ITY_I64(), 0));
    a.push(mk_inst_const_bool(1, 1));
    a.push(mk_inst_branch(2, 1, 1, 2));
    let t: Vec<IrInst> = Vec::new();
    t.push(mk_inst_const_bool(3, 1));
    t.push(mk_vow(4, IOP_VOW_ENS(), 3, 0));
    t.push(mk_inst_return(5, 0));
    let e: Vec<IrInst> = Vec::new();
    e.push(mk_inst_const_bool(6, 0));
    e.push(mk_vow(7, IOP_VOW_ENS(), 6, 1));
    e.push(mk_inst_return(8, 0));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, a));
    blocks.push(mk_block(1, t));
    blocks.push(mk_block(2, e));
    let cs: VcClaims = vc_claims(mk_function(1, String::from("k"), mk_params1(), ITY_I64(), blocks));
    if cs.kinds.len() != 1 { return 100; }
    if cs.vow_ids[0] != 0 { return 101; }
    0
}

fn check_repeated_guard_prunes_inner_else() -> i64 {
    let a: Vec<IrInst> = Vec::new();
    a.push(mk_inst_arg(0, ITY_I64(), 0));
    a.push(mk_inst_const_i64(1, 0));
    a.push(mk_inst(2, IOP_GT(), ITY_BOOL(), args2(0, 1)));
    a.push(mk_inst_branch(3, 2, 1, 2));
    let outer_then: Vec<IrInst> = Vec::new();
    outer_then.push(mk_inst_branch(4, 2, 3, 4));
    let outer_else: Vec<IrInst> = Vec::new();
    outer_else.push(mk_inst_return(5, 0));
    let inner_then: Vec<IrInst> = Vec::new();
    inner_then.push(mk_vow(6, IOP_VOW_ENS(), 2, 0));
    inner_then.push(mk_inst_return(7, 0));
    let inner_else: Vec<IrInst> = Vec::new();
    inner_else.push(mk_inst_const_bool(8, 0));
    inner_else.push(mk_vow(9, IOP_VOW_ENS(), 8, 1));
    inner_else.push(mk_inst_return(10, 0));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, a));
    blocks.push(mk_block(1, outer_then));
    blocks.push(mk_block(2, outer_else));
    blocks.push(mk_block(3, inner_then));
    blocks.push(mk_block(4, inner_else));
    let cs: VcClaims = vc_claims(mk_function(1, String::from("rep"), mk_params1(), ITY_I64(), blocks));
    if cs.kinds.len() != 1 { return 110; }
    if cs.vow_ids[0] != 0 { return 111; }
    0
}

// A division in one arm is guarded only on that arm: the other arm, and the
// code after the merge, are not constrained by it beyond the implication.
fn check_arm_division_assumption_is_guarded() -> i64 {
    let a: Vec<IrInst> = Vec::new();
    a.push(mk_inst_arg(0, ITY_I64(), 0));
    a.push(mk_inst_arg(1, ITY_I64(), 1));
    a.push(mk_inst_const_i64(2, 0));
    a.push(mk_inst(3, IOP_GT(), ITY_BOOL(), args2(0, 2)));
    a.push(mk_inst_branch(4, 3, 1, 2));
    let t: Vec<IrInst> = Vec::new();
    t.push(mk_inst(5, IOP_WDIV(), ITY_I64(), args2(0, 1)));
    t.push(mk_inst_upsilon(6, 5, 9));
    t.push(mk_inst_jump(7, 3));
    let e: Vec<IrInst> = Vec::new();
    e.push(mk_inst_upsilon(8, 2, 9));
    e.push(mk_inst_jump(10, 3));
    let m: Vec<IrInst> = Vec::new();
    m.push(mk_inst_phi(9, ITY_I64()));
    m.push(mk_inst_return(11, 9));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, a));
    blocks.push(mk_block(1, t));
    blocks.push(mk_block(2, e));
    blocks.push(mk_block(3, m));
    let cs: VcClaims = vc_claims(mk_function(1, String::from("armdiv"), params2(), ITY_I64(), blocks));
    if cs.kinds.len() != 2 { return 120; }
    if !query(cs, 0).contains(String::from("(assert (and v3 (not (distinct v1 (_ bv0 64)))))\n")) { return 121; }
    if !query(cs, 1).contains(String::from("(assert (or (not v3) (distinct v1 (_ bv0 64))))\n")) { return 122; }
    0
}

// `n` sequential `if x > 0 { acc = acc + x }` joined by Phis; ends with an
// ensures on the final accumulator.
fn stress_function(n: i64) -> IrFunction {
    let blocks: Vec<IrBlock> = Vec::new();
    let mut id: i64 = 3;
    let mut acc: i64 = 2;
    let mut cur: Vec<IrInst> = Vec::new();
    cur.push(mk_inst_arg(0, ITY_I64(), 0));
    cur.push(mk_inst_const_i64(1, 0));
    cur.push(mk_inst_const_i64(2, 0));
    let mut i: i64 = 0;
    while i < n {
        let cond: i64 = id;
        let br: i64 = id + 1;
        let sum: i64 = id + 2;
        let up_t: i64 = id + 3;
        let jt: i64 = id + 4;
        let up_e: i64 = id + 5;
        let je: i64 = id + 6;
        let phi: i64 = id + 7;
        id = id + 8;
        cur.push(mk_inst(cond, IOP_GT(), ITY_BOOL(), args2(0, 1)));
        cur.push(mk_inst_branch(br, cond, 3 * i + 1, 3 * i + 2));
        blocks.push(mk_block(3 * i, cur));
        let t: Vec<IrInst> = Vec::new();
        t.push(mk_inst_add(sum, acc, 0));
        t.push(mk_inst_upsilon(up_t, sum, phi));
        t.push(mk_inst_jump(jt, 3 * i + 3));
        blocks.push(mk_block(3 * i + 1, t));
        let e: Vec<IrInst> = Vec::new();
        e.push(mk_inst_upsilon(up_e, acc, phi));
        e.push(mk_inst_jump(je, 3 * i + 3));
        blocks.push(mk_block(3 * i + 2, e));
        cur = Vec::new();
        cur.push(mk_inst_phi(phi, ITY_I64()));
        acc = phi;
        i = i + 1;
    }
    cur.push(mk_inst(id, IOP_EQ(), ITY_BOOL(), args2(acc, acc)));
    cur.push(mk_vow(id + 1, IOP_VOW_ENS(), id, 0));
    cur.push(mk_inst_return(id + 2, acc));
    blocks.push(mk_block(3 * n, cur));
    mk_function(1, String::from("stress"), mk_params1(), ITY_I64(), blocks)
}

// The query grows with the number of changed names and edges, not with the
// number of paths (2^n here).
fn check_query_size_is_linear_in_nesting() -> i64 {
    let f8: IrFunction = stress_function(8);
    let f16: IrFunction = stress_function(16);
    if vc_skip_reason(f8).len() != 0 { return 130; }
    if vc_skip_reason(f16).len() != 0 { return 131; }
    let c8: VcClaims = vc_claims(f8);
    let c16: VcClaims = vc_claims(f16);
    if c8.kinds.len() != 1 || c16.kinds.len() != 1 { return 132; }
    let s8: i64 = query(c8, 0).len() as i64;
    let s16: i64 = query(c16, 0).len() as i64;
    if s16 > 3 * s8 { return 133; }
    if count_of(query(c16, 0), String::from("(define-fun v")) < 2 * count_of(query(c8, 0), String::from("(define-fun v")) - 4 { return 134; }
    0
}

// Under a non-trivial path condition the else-edge is one name, `(and pc (not c))`.
fn check_nested_else_edge_is_one_name() -> i64 {
    let a: Vec<IrInst> = Vec::new();
    a.push(mk_inst_arg(0, ITY_I64(), 0));
    a.push(mk_inst_const_i64(1, 0));
    a.push(mk_inst(2, IOP_GT(), ITY_BOOL(), args2(0, 1)));
    a.push(mk_inst(3, IOP_LT(), ITY_BOOL(), args2(0, 1)));
    a.push(mk_inst_branch(4, 2, 1, 2));
    let outer_then: Vec<IrInst> = Vec::new();
    outer_then.push(mk_inst_branch(5, 3, 3, 4));
    let outer_else: Vec<IrInst> = Vec::new();
    outer_else.push(mk_inst_return(6, 0));
    let inner_then: Vec<IrInst> = Vec::new();
    inner_then.push(mk_inst_return(7, 0));
    let inner_else: Vec<IrInst> = Vec::new();
    inner_else.push(mk_inst(8, IOP_EQ(), ITY_BOOL(), args2(0, 0)));
    inner_else.push(mk_vow(9, IOP_VOW_ENS(), 8, 0));
    inner_else.push(mk_inst_return(10, 0));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, a));
    blocks.push(mk_block(1, outer_then));
    blocks.push(mk_block(2, outer_else));
    blocks.push(mk_block(3, inner_then));
    blocks.push(mk_block(4, inner_else));
    let cs: VcClaims = vc_claims(mk_function(1, String::from("nest"), mk_params1(), ITY_I64(), blocks));
    if cs.kinds.len() != 1 { return 140; }
    let q: String = query(cs, 0);
    if count_of(q, String::from("() Bool (and v2 (not v3)))\n")) != 1 { return 141; }
    if q.contains(String::from("() Bool (not v3))")) { return 142; }
    0
}

fn main() -> i32 {
    let mut r: i64 = check_divide_with_requires();
    if r == 0 { r = check_rem_has_only_zero_claim(); }
    if r == 0 { r = check_ensures_claim_golden(); }
    if r == 0 { r = check_requires_only_has_no_claims(); }
    if r == 0 { r = check_second_division_assumes_first(); }
    if r == 0 { r = check_division_in_requires_is_positional(); }
    if r == 0 { r = check_names_are_internal(); }
    if r == 0 { r = check_bool_operators(); }
    if r == 0 { r = check_diamond_phi_is_ite(); }
    if r == 0 { r = check_early_return_claims_carry_path_condition(); }
    if r == 0 { r = check_constant_guard_prunes_dead_arm(); }
    if r == 0 { r = check_repeated_guard_prunes_inner_else(); }
    if r == 0 { r = check_arm_division_assumption_is_guarded(); }
    if r == 0 { r = check_query_size_is_linear_in_nesting(); }
    if r == 0 { r = check_nested_else_edge_is_one_name(); }
    i64_to_i32_wrap(r)
}
