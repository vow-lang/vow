module TestVcExec

use ir
use vc_term
use vc_smt
use vc_gate
use vc_exec
use vc_ops
use vc_unroll
use vc_native
use tests.builders

fn args1(a: i64) -> Vec<i64> {
    let v: Vec<i64> = Vec::new();
    v.push(a);
    v
}

fn args2(a: i64, b: i64) -> Vec<i64> {
    let v: Vec<i64> = Vec::new();
    v.push(a);
    v.push(b);
    v
}

fn params2() -> Vec<i64> {
    let p: Vec<i64> = Vec::new();
    p.push(ITY_I64());
    p.push(ITY_I64());
    p
}

fn mk_vow(id: i64, op: i64, pred: i64, vow_id: i64) -> IrInst {
    ir_inst_new(id, op, ITY_UNIT(), args1(pred), IDATA_VOW_ID(), vow_id, 0, String::from(""))
}

fn one_block(name: String, params: Vec<i64>, ret: i64, insts: Vec<IrInst>) -> IrFunction {
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, insts));
    mk_function(1, name, params, ret, blocks)
}

fn query(cs: VcClaims, k: u64) -> String {
    vc_smt_render(cs.arena, vc_claim_script(cs, k))
}

fn count_of(hay: String, needle: String) -> i64 {
    let mut n: i64 = 0;
    let mut i: u64 = 0;
    while i + needle.len() <= hay.len() {
        if hay.substring(i, i + needle.len()) == needle {
            n = n + 1;
        }
        i = i + 1;
    }
    n
}

// divide(x, y) requires y > 0, body x / y
fn divide_with_requires(op: i64) -> IrFunction {
    let i: Vec<IrInst> = Vec::new();
    i.push(mk_inst_arg(0, ITY_I64(), 0));
    i.push(mk_inst_arg(1, ITY_I64(), 1));
    i.push(mk_inst_const_i64(2, 0));
    i.push(mk_inst(3, IOP_GT(), ITY_BOOL(), args2(1, 2)));
    i.push(mk_vow(4, IOP_VOW_REQ(), 3, 0));
    i.push(mk_inst(5, op, ITY_I64(), args2(0, 1)));
    i.push(mk_inst_return(6, 5));
    one_block(String::from("divide"), params2(), ITY_I64(), i)
}

fn check_divide_with_requires() -> i64 {
    let f: IrFunction = divide_with_requires(IOP_WDIV());
    if vc_skip_reason(f).len() != 0 { return 1; }
    let cs: VcClaims = vc_claims(f);
    if cs.kinds.len() != 2 { return 2; }
    if cs.kinds[0] != VC_CLAIM_DIV_ZERO() { return 3; }
    if cs.kinds[1] != VC_CLAIM_DIV_OVERFLOW() { return 4; }
    if cs.vow_ids[0] != -1 { return 5; }
    if cs.labels[0] != String::from("division by zero") { return 6; }
    if cs.labels[1] != String::from("division overflow") { return 7; }
    let q0: String = query(cs, 0);
    if !q0.contains(String::from("(assert v3)\n(assert (not (distinct p1 #x0000000000000000)))\n(check-sat)")) { return 8; }
    let q1: String = query(cs, 1);
    if !q1.contains(String::from("(assert v3)\n(assert (distinct p1 #x0000000000000000))\n(assert (and (= p0 #x8000000000000000) (= p1 #xffffffffffffffff)))\n")) { return 9; }
    0
}

fn check_rem_has_only_zero_claim() -> i64 {
    let cs: VcClaims = vc_claims(divide_with_requires(IOP_WREM()));
    if cs.kinds.len() != 1 { return 10; }
    if cs.kinds[0] != VC_CLAIM_DIV_ZERO() { return 11; }
    0
}

// twice(x) requires x > 0 ensures result > x, body x + x
fn check_ensures_claim_golden() -> i64 {
    let i: Vec<IrInst> = Vec::new();
    i.push(mk_inst_arg(0, ITY_I64(), 0));
    i.push(mk_inst_const_i64(1, 0));
    i.push(mk_inst(2, IOP_GT(), ITY_BOOL(), args2(0, 1)));
    i.push(mk_vow(3, IOP_VOW_REQ(), 2, 0));
    i.push(mk_inst_add(4, 0, 0));
    i.push(mk_inst(5, IOP_GT(), ITY_BOOL(), args2(4, 0)));
    i.push(mk_vow(6, IOP_VOW_ENS(), 5, 1));
    i.push(mk_inst_return(7, 4));
    let p: Vec<i64> = Vec::new();
    p.push(ITY_I64());
    let f: IrFunction = one_block(String::from("twice"), p, ITY_I64(), i);
    let cs: VcClaims = vc_claims(f);
    if cs.kinds.len() != 1 { return 20; }
    if cs.kinds[0] != VC_CLAIM_ENSURES() { return 21; }
    if cs.vow_ids[0] != 1 { return 22; }
    let want: String = String::from("(set-logic QF_BV)\n");
    want.push_str(String::from("(set-option :produce-models true)\n"));
    want.push_str(String::from("(declare-const p0 (_ BitVec 64))\n"));
    want.push_str(String::from("(define-fun v2 () Bool (bvsgt p0 #x0000000000000000))\n"));
    want.push_str(String::from("(define-fun v4 () (_ BitVec 64) (bvadd p0 p0))\n"));
    want.push_str(String::from("(define-fun v5 () Bool (bvsgt v4 p0))\n"));
    want.push_str(String::from("(assert v2)\n"));
    want.push_str(String::from("(assert (not v5))\n"));
    want.push_str(String::from("(check-sat)\n"));
    want.push_str(String::from("(get-value (p0))\n"));
    if query(cs, 0) != want { return 23; }
    0
}

fn check_requires_only_has_no_claims() -> i64 {
    let i: Vec<IrInst> = Vec::new();
    i.push(mk_inst_arg(0, ITY_I64(), 0));
    i.push(mk_inst_const_i64(1, 0));
    i.push(mk_inst(2, IOP_GE(), ITY_BOOL(), args2(0, 1)));
    i.push(mk_vow(3, IOP_VOW_REQ(), 2, 0));
    i.push(mk_inst_return(4, 0));
    let p: Vec<i64> = Vec::new();
    p.push(ITY_I64());
    let cs: VcClaims = vc_claims(one_block(String::from("r"), p, ITY_I64(), i));
    if cs.kinds.len() != 0 { return 30; }
    0
}

fn check_second_division_assumes_first() -> i64 {
    let i: Vec<IrInst> = Vec::new();
    i.push(mk_inst_arg(0, ITY_I64(), 0));
    i.push(mk_inst_arg(1, ITY_I64(), 1));
    i.push(mk_inst(2, IOP_WDIV(), ITY_I64(), args2(0, 1)));
    i.push(mk_inst(3, IOP_WDIV(), ITY_I64(), args2(0, 2)));
    i.push(mk_inst_return(4, 3));
    let cs: VcClaims = vc_claims(one_block(String::from("dd"), params2(), ITY_I64(), i));
    if cs.kinds.len() != 4 { return 40; }
    if cs.kinds[2] != VC_CLAIM_DIV_ZERO() { return 41; }
    let q: String = query(cs, 2);
    if count_of(q, String::from("(assert (distinct p1 #x0000000000000000))")) != 1 { return 42; }
    if !q.contains(String::from("(assert (not (and (= p0 ")) { return 43; }
    let first: String = query(cs, 0);
    if first.contains(String::from("(assert (distinct p1")) { return 44; }
    if first.contains(String::from("(define-fun v2 ")) { return 45; }
    if !query(cs, 2).contains(String::from("(define-fun v2 ")) { return 46; }
    0
}

// A guard already assumed on the path is not asked again.
fn check_duplicate_guard_claim_elided() -> i64 {
    let i: Vec<IrInst> = Vec::new();
    i.push(mk_inst_arg(0, ITY_I64(), 0));
    i.push(mk_inst_arg(1, ITY_I64(), 1));
    i.push(mk_inst(2, IOP_WDIV(), ITY_I64(), args2(0, 1)));
    i.push(mk_inst(3, IOP_WREM(), ITY_I64(), args2(2, 1)));
    i.push(mk_inst_return(4, 3));
    let cs: VcClaims = vc_claims(one_block(String::from("dd"), params2(), ITY_I64(), i));
    if cs.kinds.len() != 2 { return 47; }
    if cs.kinds[0] != VC_CLAIM_DIV_ZERO() || cs.kinds[1] != VC_CLAIM_DIV_OVERFLOW() { return 48; }
    0
}

// A division inside a requires clause is a claim that must not assume that requires.
fn check_division_in_requires_is_positional() -> i64 {
    let i: Vec<IrInst> = Vec::new();
    i.push(mk_inst_arg(0, ITY_I64(), 0));
    i.push(mk_inst_arg(1, ITY_I64(), 1));
    i.push(mk_inst(2, IOP_WREM(), ITY_I64(), args2(0, 1)));
    i.push(mk_inst_const_i64(3, 0));
    i.push(mk_inst(4, IOP_EQ(), ITY_BOOL(), args2(2, 3)));
    i.push(mk_vow(5, IOP_VOW_REQ(), 4, 0));
    i.push(mk_inst_return(6, 0));
    let cs: VcClaims = vc_claims(one_block(String::from("rq"), params2(), ITY_I64(), i));
    if cs.kinds.len() != 1 { return 50; }
    if query(cs, 0).contains(String::from("(assert v4)")) { return 51; }
    0
}

fn check_names_are_internal() -> i64 {
    let i: Vec<IrInst> = Vec::new();
    i.push(mk_inst_arg(0, ITY_I64(), 0));
    i.push(mk_inst_const_i64(1, 5));
    i.push(mk_inst(2, IOP_LT(), ITY_BOOL(), args2(0, 1)));
    i.push(mk_vow(3, IOP_VOW_ENS(), 2, 0));
    i.push(mk_inst_return(4, 0));
    let p: Vec<i64> = Vec::new();
    p.push(ITY_I64());
    let f: IrFunction = one_block(String::from("evil"), p, ITY_I64(), i);
    f.param_names[0] = String::from("x\"; (assert false)");
    let cs: VcClaims = vc_claims(f);
    if cs.kinds.len() != 1 { return 60; }
    let q: String = query(cs, 0);
    if q.contains(String::from("assert false")) { return 61; }
    if q.contains(String::from("evil")) { return 62; }
    if cs.model_names.len() != 1 || cs.model_names[0] != String::from("p0") { return 63; }
    0
}

fn check_bool_operators() -> i64 {
    let i: Vec<IrInst> = Vec::new();
    i.push(mk_inst_arg(0, ITY_I64(), 0));
    i.push(mk_inst_const_i64(1, 0));
    i.push(mk_inst(2, IOP_EQ(), ITY_BOOL(), args2(0, 1)));
    i.push(mk_inst(3, IOP_NOT(), ITY_BOOL(), args1(2)));
    i.push(mk_inst(4, IOP_LT(), ITY_BOOL(), args2(0, 1)));
    i.push(mk_inst(5, IOP_OR(), ITY_BOOL(), args2(3, 4)));
    i.push(mk_inst(6, IOP_AND(), ITY_BOOL(), args2(5, 2)));
    i.push(mk_vow(7, IOP_VOW_ENS(), 6, 0));
    i.push(mk_inst_return(8, 0));
    let f: IrFunction = one_block(String::from("b"), mk_params1(), ITY_I64(), i);
    let cs: VcClaims = vc_claims(f);
    if cs.kinds.len() != 1 { return 69; }
    let q: String = query(cs, 0);
    if !q.contains(String::from("(define-fun v2 () Bool (= p0 #x0000000000000000))\n")) { return 70; }
    if !q.contains(String::from("(define-fun v3 () Bool (not v2))\n")) { return 71; }
    if !q.contains(String::from("(define-fun v5 () Bool (or v3 v4))\n")) { return 72; }
    if !q.contains(String::from("(define-fun v6 () Bool (and v5 v2))\n")) { return 73; }
    0
}

// Constants and Bool laws fold: no definition and no claim is left.
fn check_constant_bool_logic_folds_away() -> i64 {
    let i: Vec<IrInst> = Vec::new();
    i.push(mk_inst_const_i64(0, 1));
    i.push(mk_inst(1, IOP_EQ(), ITY_BOOL(), args2(0, 0)));
    i.push(mk_inst(2, IOP_NOT(), ITY_BOOL(), args1(1)));
    i.push(mk_inst(3, IOP_OR(), ITY_BOOL(), args2(1, 2)));
    i.push(mk_inst(4, IOP_AND(), ITY_BOOL(), args2(3, 1)));
    i.push(mk_vow(5, IOP_VOW_ENS(), 4, 0));
    i.push(mk_inst_return(6, 0));
    let f: IrFunction = one_block(String::from("b"), Vec::new(), ITY_I64(), i);
    let cs: VcClaims = vc_claims(f);
    if cs.kinds.len() != 0 { return 74; }
    if cs.header.kinds.len() != 2 { return 75; }
    0
}

// pick(x): ensures result >= 0 over `if x > 0 { x } else { 0 }`.
fn pick_function() -> IrFunction {
    let a: Vec<IrInst> = Vec::new();
    a.push(mk_inst_arg(0, ITY_I64(), 0));
    a.push(mk_inst_const_i64(1, 0));
    a.push(mk_inst(2, IOP_GT(), ITY_BOOL(), args2(0, 1)));
    a.push(mk_inst_branch(3, 2, 1, 2));
    let t: Vec<IrInst> = Vec::new();
    t.push(mk_inst_upsilon(4, 0, 9));
    t.push(mk_inst_jump(5, 3));
    let e: Vec<IrInst> = Vec::new();
    e.push(mk_inst_const_i64(6, 0));
    e.push(mk_inst_upsilon(7, 6, 9));
    e.push(mk_inst_jump(8, 3));
    let m: Vec<IrInst> = Vec::new();
    m.push(mk_inst_phi(9, ITY_I64()));
    m.push(mk_inst_const_i64(10, 0));
    m.push(mk_inst(11, IOP_GE(), ITY_BOOL(), args2(9, 10)));
    m.push(mk_vow(12, IOP_VOW_ENS(), 11, 0));
    m.push(mk_inst_return(13, 9));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, a));
    blocks.push(mk_block(1, t));
    blocks.push(mk_block(2, e));
    blocks.push(mk_block(3, m));
    mk_function(1, String::from("pick"), mk_params1(), ITY_I64(), blocks)
}

fn check_diamond_phi_is_ite() -> i64 {
    let f: IrFunction = pick_function();
    if vc_skip_reason(f).len() != 0 { return 80; }
    let cs: VcClaims = vc_claims(f);
    if cs.kinds.len() != 1 { return 81; }
    let q: String = query(cs, 0);
    if !q.contains(String::from("(define-fun g0 () Bool (not v2))\n")) { return 82; }
    if q.contains(String::from("(or v2 g0)")) { return 83; }
    if !q.contains(String::from("(define-fun v9 () (_ BitVec 64) (ite g0 #x0000000000000000 p0))\n")) { return 84; }
    if !q.contains(String::from("(assert (not v11))\n")) { return 85; }
    0
}

// Two returning arms, each with its own ensures: a claim holds only under its
// own path condition.
fn check_early_return_claims_carry_path_condition() -> i64 {
    let a: Vec<IrInst> = Vec::new();
    a.push(mk_inst_arg(0, ITY_I64(), 0));
    a.push(mk_inst_const_i64(1, 0));
    a.push(mk_inst(2, IOP_LT(), ITY_BOOL(), args2(0, 1)));
    a.push(mk_inst_branch(3, 2, 1, 2));
    let neg: Vec<IrInst> = Vec::new();
    neg.push(mk_inst(4, IOP_GE(), ITY_BOOL(), args2(0, 1)));
    neg.push(mk_vow(5, IOP_VOW_ENS(), 4, 0));
    neg.push(mk_inst_return(6, 0));
    let pos: Vec<IrInst> = Vec::new();
    pos.push(mk_inst(7, IOP_GE(), ITY_BOOL(), args2(0, 1)));
    pos.push(mk_vow(8, IOP_VOW_ENS(), 7, 1));
    pos.push(mk_inst_return(9, 0));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, a));
    blocks.push(mk_block(1, neg));
    blocks.push(mk_block(2, pos));
    let f: IrFunction = mk_function(1, String::from("early"), mk_params1(), ITY_I64(), blocks);
    if vc_skip_reason(f).len() != 0 { return 90; }
    let cs: VcClaims = vc_claims(f);
    if cs.kinds.len() != 2 { return 91; }
    let mut neg_k: u64 = 0;
    if cs.vow_ids[1] == 0 { neg_k = 1; }
    let pos_k: u64 = 1 - neg_k;
    if cs.vow_ids[neg_k] != 0 || cs.vow_ids[pos_k] != 1 { return 92; }
    if !query(cs, neg_k).contains(String::from("(assert (and v2 (not v7)))\n")) { return 93; }
    if !query(cs, pos_k).contains(String::from("(assert (and g0 (not v7)))\n")) { return 94; }
    0
}

// A guard the path already decided leaves the other arm unexecuted.
fn check_constant_guard_prunes_dead_arm() -> i64 {
    let a: Vec<IrInst> = Vec::new();
    a.push(mk_inst_arg(0, ITY_I64(), 0));
    a.push(mk_inst_const_bool(1, 1));
    a.push(mk_inst_branch(2, 1, 1, 2));
    let t: Vec<IrInst> = Vec::new();
    t.push(mk_inst_const_i64(3, 0));
    t.push(mk_inst(4, IOP_GT(), ITY_BOOL(), args2(0, 3)));
    t.push(mk_vow(5, IOP_VOW_ENS(), 4, 0));
    t.push(mk_inst_return(6, 0));
    let e: Vec<IrInst> = Vec::new();
    e.push(mk_inst_const_i64(7, 0));
    e.push(mk_inst(8, IOP_LT(), ITY_BOOL(), args2(0, 7)));
    e.push(mk_vow(9, IOP_VOW_ENS(), 8, 1));
    e.push(mk_inst_return(10, 0));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, a));
    blocks.push(mk_block(1, t));
    blocks.push(mk_block(2, e));
    let cs: VcClaims = vc_claims(mk_function(1, String::from("k"), mk_params1(), ITY_I64(), blocks));
    if cs.kinds.len() != 1 { return 100; }
    if cs.vow_ids[0] != 0 { return 101; }
    0
}

fn check_repeated_guard_prunes_inner_else() -> i64 {
    let a: Vec<IrInst> = Vec::new();
    a.push(mk_inst_arg(0, ITY_I64(), 0));
    a.push(mk_inst_const_i64(1, 0));
    a.push(mk_inst(2, IOP_GT(), ITY_BOOL(), args2(0, 1)));
    a.push(mk_inst_branch(3, 2, 1, 2));
    let outer_then: Vec<IrInst> = Vec::new();
    outer_then.push(mk_inst_branch(4, 2, 3, 4));
    let outer_else: Vec<IrInst> = Vec::new();
    outer_else.push(mk_inst_return(5, 0));
    let inner_then: Vec<IrInst> = Vec::new();
    inner_then.push(mk_inst(11, IOP_GE(), ITY_BOOL(), args2(0, 1)));
    inner_then.push(mk_vow(6, IOP_VOW_ENS(), 11, 0));
    inner_then.push(mk_inst_return(7, 0));
    let inner_else: Vec<IrInst> = Vec::new();
    inner_else.push(mk_inst_const_bool(8, 0));
    inner_else.push(mk_vow(9, IOP_VOW_ENS(), 8, 1));
    inner_else.push(mk_inst_return(10, 0));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, a));
    blocks.push(mk_block(1, outer_then));
    blocks.push(mk_block(2, outer_else));
    blocks.push(mk_block(3, inner_then));
    blocks.push(mk_block(4, inner_else));
    let cs: VcClaims = vc_claims(mk_function(1, String::from("rep"), mk_params1(), ITY_I64(), blocks));
    if cs.kinds.len() != 1 { return 110; }
    if cs.vow_ids[0] != 0 { return 111; }
    0
}

// A division in one arm is guarded only on that arm: the other arm, and the
// code after the merge, are not constrained by it beyond the implication.
fn check_arm_division_assumption_is_guarded() -> i64 {
    let a: Vec<IrInst> = Vec::new();
    a.push(mk_inst_arg(0, ITY_I64(), 0));
    a.push(mk_inst_arg(1, ITY_I64(), 1));
    a.push(mk_inst_const_i64(2, 0));
    a.push(mk_inst(3, IOP_GT(), ITY_BOOL(), args2(0, 2)));
    a.push(mk_inst_branch(4, 3, 1, 2));
    let t: Vec<IrInst> = Vec::new();
    t.push(mk_inst(5, IOP_WDIV(), ITY_I64(), args2(0, 1)));
    t.push(mk_inst_upsilon(6, 5, 9));
    t.push(mk_inst_jump(7, 3));
    let e: Vec<IrInst> = Vec::new();
    e.push(mk_inst_upsilon(8, 2, 9));
    e.push(mk_inst_jump(10, 3));
    let m: Vec<IrInst> = Vec::new();
    m.push(mk_inst_phi(9, ITY_I64()));
    m.push(mk_inst_return(11, 9));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, a));
    blocks.push(mk_block(1, t));
    blocks.push(mk_block(2, e));
    blocks.push(mk_block(3, m));
    let cs: VcClaims = vc_claims(mk_function(1, String::from("armdiv"), params2(), ITY_I64(), blocks));
    if cs.kinds.len() != 2 { return 120; }
    if !query(cs, 0).contains(String::from("(assert (and v3 (not (distinct p1 #x0000000000000000))))\n")) { return 121; }
    if !query(cs, 1).contains(String::from("(assert (or (not v3) (distinct p1 #x0000000000000000)))\n")) { return 122; }
    0
}

// `n` sequential `if x > 0 { acc = acc + x }` joined by Phis; ends with an
// ensures on the final accumulator.
fn stress_function(n: i64) -> IrFunction {
    let blocks: Vec<IrBlock> = Vec::new();
    let mut id: i64 = 3;
    let mut acc: i64 = 2;
    let mut cur: Vec<IrInst> = Vec::new();
    cur.push(mk_inst_arg(0, ITY_I64(), 0));
    cur.push(mk_inst_const_i64(1, 0));
    cur.push(mk_inst_const_i64(2, 0));
    let mut i: i64 = 0;
    while i < n {
        let cond: i64 = id;
        let br: i64 = id + 1;
        let sum: i64 = id + 2;
        let up_t: i64 = id + 3;
        let jt: i64 = id + 4;
        let up_e: i64 = id + 5;
        let je: i64 = id + 6;
        let phi: i64 = id + 7;
        id = id + 8;
        cur.push(mk_inst(cond, IOP_GT(), ITY_BOOL(), args2(0, 1)));
        cur.push(mk_inst_branch(br, cond, 3 * i + 1, 3 * i + 2));
        blocks.push(mk_block(3 * i, cur));
        let t: Vec<IrInst> = Vec::new();
        t.push(mk_inst_add(sum, acc, 0));
        t.push(mk_inst_upsilon(up_t, sum, phi));
        t.push(mk_inst_jump(jt, 3 * i + 3));
        blocks.push(mk_block(3 * i + 1, t));
        let e: Vec<IrInst> = Vec::new();
        e.push(mk_inst_upsilon(up_e, acc, phi));
        e.push(mk_inst_jump(je, 3 * i + 3));
        blocks.push(mk_block(3 * i + 2, e));
        cur = Vec::new();
        cur.push(mk_inst_phi(phi, ITY_I64()));
        acc = phi;
        i = i + 1;
    }
    cur.push(mk_inst(id, IOP_GE(), ITY_BOOL(), args2(acc, 1)));
    cur.push(mk_vow(id + 1, IOP_VOW_ENS(), id, 0));
    cur.push(mk_inst_return(id + 2, acc));
    blocks.push(mk_block(3 * n, cur));
    mk_function(1, String::from("stress"), mk_params1(), ITY_I64(), blocks)
}

// The query grows with the number of changed names and edges, not with the
// number of paths (2^n here).
fn check_query_size_is_linear_in_nesting() -> i64 {
    let f8: IrFunction = stress_function(8);
    let f16: IrFunction = stress_function(16);
    if vc_skip_reason(f8).len() != 0 { return 130; }
    if vc_skip_reason(f16).len() != 0 { return 131; }
    let c8: VcClaims = vc_claims(f8);
    let c16: VcClaims = vc_claims(f16);
    if c8.kinds.len() != 1 || c16.kinds.len() != 1 { return 132; }
    let s8: i64 = query(c8, 0).len() as i64;
    let s16: i64 = query(c16, 0).len() as i64;
    if s16 > 3 * s8 { return 133; }
    if count_of(query(c16, 0), String::from("(define-fun v")) < 2 * count_of(query(c8, 0), String::from("(define-fun v")) - 4 { return 134; }
    0
}

// Under a non-trivial path condition the else-edge is one name, `(and pc (not c))`.
fn check_nested_else_edge_is_one_name() -> i64 {
    let a: Vec<IrInst> = Vec::new();
    a.push(mk_inst_arg(0, ITY_I64(), 0));
    a.push(mk_inst_const_i64(1, 0));
    a.push(mk_inst(2, IOP_GT(), ITY_BOOL(), args2(0, 1)));
    a.push(mk_inst(3, IOP_LT(), ITY_BOOL(), args2(0, 1)));
    a.push(mk_inst_branch(4, 2, 1, 2));
    let outer_then: Vec<IrInst> = Vec::new();
    outer_then.push(mk_inst_branch(5, 3, 3, 4));
    let outer_else: Vec<IrInst> = Vec::new();
    outer_else.push(mk_inst_return(6, 0));
    let inner_then: Vec<IrInst> = Vec::new();
    inner_then.push(mk_inst_return(7, 0));
    let inner_else: Vec<IrInst> = Vec::new();
    inner_else.push(mk_inst(8, IOP_GE(), ITY_BOOL(), args2(0, 1)));
    inner_else.push(mk_vow(9, IOP_VOW_ENS(), 8, 0));
    inner_else.push(mk_inst_return(10, 0));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, a));
    blocks.push(mk_block(1, outer_then));
    blocks.push(mk_block(2, outer_else));
    blocks.push(mk_block(3, inner_then));
    blocks.push(mk_block(4, inner_else));
    let cs: VcClaims = vc_claims(mk_function(1, String::from("nest"), mk_params1(), ITY_I64(), blocks));
    if cs.kinds.len() != 1 { return 140; }
    let q: String = query(cs, 0);
    if count_of(q, String::from("() Bool (and v2 (not v3)))\n")) != 1 { return 141; }
    if q.contains(String::from("() Bool (not v3))")) { return 142; }
    0
}

fn two_param_fn(ty: i64, insts: Vec<IrInst>, ret: i64) -> IrFunction {
    let p: Vec<i64> = Vec::new();
    p.push(ty);
    p.push(ty);
    one_block(String::from("w"), p, ret, insts)
}

fn binop_fn(op: i64, ty: i64) -> IrFunction {
    let i: Vec<IrInst> = Vec::new();
    i.push(mk_inst_arg(0, ty, 0));
    i.push(mk_inst_arg(1, ty, 1));
    i.push(mk_inst(2, op, ty, args2(0, 1)));
    i.push(mk_inst_return(3, 2));
    two_param_fn(ty, i, ty)
}

fn check_unsigned_division() -> i64 {
    let cs: VcClaims = vc_claims(binop_fn(IOP_WDIV(), ITY_U32()));
    if cs.kinds.len() != 1 { return 100; }
    if cs.kinds[0] != VC_CLAIM_DIV_ZERO() { return 101; }
    let q: String = query(cs, 0);
    if !q.contains(String::from("(declare-const p0 (_ BitVec 32))")) { return 102; }
    if !vc_smt_render(cs.arena, cs.header).contains(String::from("(define-fun v2 () (_ BitVec 32) (bvudiv p0 p1))")) { return 103; }
    if !q.contains(String::from("(assert (not (distinct p1 #x00000000)))")) { return 104; }
    if cs.model_tys[0] != ITY_U32() { return 105; }
    let cs2: VcClaims = vc_claims(binop_fn(IOP_WREM(), ITY_U8()));
    if !vc_smt_render(cs2.arena, cs2.header).contains(String::from("(bvurem p0 p1)")) { return 106; }
    0
}

fn check_signed_division_widths() -> i64 {
    let cs: VcClaims = vc_claims(binop_fn(IOP_WDIV(), ITY_I8()));
    if cs.kinds.len() != 2 { return 110; }
    if !query(cs, 1).contains(String::from("(= p0 #x80) (= p1 #xff)")) { return 111; }
    let w: VcClaims = vc_claims(binop_fn(IOP_WDIV(), ITY_I128()));
    if !query(w, 1).contains(String::from("(= p0 #x80000000000000000000000000000000) (= p1 #xffffffffffffffffffffffffffffffff)")) { return 112; }
    if !query(w, 1).contains(String::from("(declare-const p1 (_ BitVec 128))")) { return 113; }
    0
}

fn check_checked_arith_is_a_soft_claim() -> i64 {
    let cs: VcClaims = vc_claims(binop_fn(IOP_CADD(), ITY_U8()));
    if cs.kinds.len() != 1 { return 120; }
    if cs.kinds[0] != VC_CLAIM_ARITH() { return 121; }
    if cs.labels[0] != String::from("add") { return 122; }
    if !query(cs, 0).contains(String::from("(assert (bvuaddo p0 p1))\n(check-sat)")) { return 123; }
    let s: VcClaims = vc_claims(binop_fn(IOP_CMUL(), ITY_I16()));
    if !query(s, 0).contains(String::from("(assert (bvsmulo p0 p1))")) { return 124; }
    if s.labels[0] != String::from("mul") { return 125; }
    let sub: VcClaims = vc_claims(binop_fn(IOP_CSUB(), ITY_U64()));
    if !query(sub, 0).contains(String::from("(bvusubo p0 p1)")) { return 126; }
    0
}

fn check_checked_div_claims() -> i64 {
    let cs: VcClaims = vc_claims(binop_fn(IOP_CDIV(), ITY_I64()));
    if cs.kinds.len() != 2 { return 130; }
    if cs.labels[0] != String::from("div-zero") { return 131; }
    if cs.labels[1] != String::from("div-overflow") { return 132; }
    if cs.kinds[1] != VC_CLAIM_ARITH() { return 133; }
    let r: VcClaims = vc_claims(binop_fn(IOP_CREM(), ITY_I64()));
    if r.kinds.len() != 1 { return 134; }
    let u: VcClaims = vc_claims(binop_fn(IOP_CDIV(), ITY_U64()));
    if u.kinds.len() != 1 { return 135; }
    0
}

// A checked guard is assumed by every later claim: the aborting run never gets there.
fn check_checked_guard_is_assumed_later() -> i64 {
    let i: Vec<IrInst> = Vec::new();
    i.push(mk_inst_arg(0, ITY_I64(), 0));
    i.push(mk_inst_arg(1, ITY_I64(), 1));
    i.push(mk_inst(2, IOP_CADD(), ITY_I64(), args2(0, 1)));
    i.push(mk_inst(3, IOP_GE(), ITY_BOOL(), args2(2, 0)));
    i.push(mk_vow(4, IOP_VOW_ENS(), 3, 0));
    i.push(mk_inst_return(5, 2));
    let cs: VcClaims = vc_claims(two_param_fn(ITY_I64(), i, ITY_I64()));
    if cs.kinds.len() != 2 { return 140; }
    if cs.kinds[1] != VC_CLAIM_ENSURES() { return 141; }
    if !query(cs, 1).contains(String::from("(assert (not (bvsaddo p0 p1)))\n")) { return 142; }
    if query(cs, 0).contains(String::from("(assert (not (bvsaddo")) { return 143; }
    0
}

fn shift_claims(op: i64, lhs: i64, count: i64) -> VcClaims {
    let i: Vec<IrInst> = Vec::new();
    i.push(mk_inst_arg(0, lhs, 0));
    i.push(mk_inst_arg(1, count, 1));
    i.push(ir_inst_new(2, op, lhs, args2(0, 1), IDATA_INTEGER(), lhs, 0, String::from("")));
    i.push(mk_inst_return(3, 2));
    let p: Vec<i64> = Vec::new();
    p.push(lhs);
    p.push(count);
    vc_claims(one_block(String::from("sh"), p, lhs, i))
}

fn check_shift_claims() -> i64 {
    let a: VcClaims = shift_claims(IOP_SHL(), ITY_I64(), ITY_U32());
    if a.kinds.len() != 1 { return 150; }
    if a.kinds[0] != VC_CLAIM_SHIFT_COUNT() { return 151; }
    if a.labels[0] != String::from("integer shift count") { return 152; }
    if a.vow_ids[0] != -1 { return 153; }
    let qa: String = query(a, 0);
    if !qa.contains(String::from("(declare-const p1 (_ BitVec 32))")) { return 154; }
    if !vc_smt_render(a.arena, a.header).contains(String::from("(define-fun v2 () (_ BitVec 64) (bvshl p0 ((_ zero_extend 32) p1)))")) { return 155; }
    if !qa.contains(String::from("(assert (not (bvult p1 #x00000040)))")) { return 156; }
    let b: VcClaims = shift_claims(IOP_SHR(), ITY_I64(), ITY_I64());
    let qb: String = query(b, 0);
    if !vc_smt_render(b.arena, b.header).contains(String::from("(bvashr p0 p1)")) { return 157; }
    if !qb.contains(String::from("(assert (not (and (bvsge p1 #x0000000000000000) (bvslt p1 #x0000000000000040))))")) { return 158; }
    let c: VcClaims = shift_claims(IOP_SHR(), ITY_U8(), ITY_U32());
    let qc: String = query(c, 0);
    if !vc_smt_render(c.arena, c.header).contains(String::from("(bvlshr p0 ((_ extract 7 0) p1))")) { return 159; }
    if !qc.contains(String::from("(bvult p1 #x00000008)")) { return 160; }
    let d: VcClaims = shift_claims(IOP_SHL(), ITY_U128(), ITY_U128());
    if !query(d, 0).contains(String::from("(bvult p1 #x00000000000000000000000000000080)")) { return 161; }
    0
}

fn cast_query(src: i64, dst: i64) -> String {
    let i: Vec<IrInst> = Vec::new();
    i.push(mk_inst_arg(0, src, 0));
    i.push(ir_inst_new(1, IOP_INT_CAST(), dst, args1(0), IDATA_INTEGER_CAST(), src, dst, String::from("")));
    i.push(mk_inst(2, IOP_EQ(), ITY_BOOL(), args2(1, 1)));
    i.push(mk_vow(3, IOP_VOW_ENS(), 2, 0));
    i.push(mk_inst_return(4, 1));
    let p: Vec<i64> = Vec::new();
    p.push(src);
    let cs: VcClaims = vc_claims(one_block(String::from("c"), p, dst, i));
    vc_smt_render(cs.arena, cs.header)
}

fn check_casts() -> i64 {
    if !cast_query(ITY_I32(), ITY_I64()).contains(String::from("((_ sign_extend 32) p0)")) { return 170; }
    if !cast_query(ITY_U8(), ITY_U64()).contains(String::from("((_ zero_extend 56) p0)")) { return 171; }
    if !cast_query(ITY_U32(), ITY_I128()).contains(String::from("((_ zero_extend 96) p0)")) { return 172; }
    if !cast_query(ITY_I64(), ITY_U128()).contains(String::from("((_ sign_extend 64) p0)")) { return 173; }
    if cast_query(ITY_I64(), ITY_U64()).contains(String::from("(define-fun v1 ")) { return 174; }
    if !cast_query(ITY_I128(), ITY_U8()).contains(String::from("((_ extract 7 0) p0)")) { return 175; }
    0
}

fn const_query(op: i64, ty: i64, lo: i64, hi: i64) -> String {
    let i: Vec<IrInst> = Vec::new();
    i.push(mk_inst_arg(0, ty, 0));
    i.push(ir_inst_new(1, op, ty, Vec::new(), IDATA_CONST_I64(), lo, hi, String::from("")));
    i.push(mk_inst(2, IOP_EQ(), ITY_BOOL(), args2(0, 1)));
    i.push(mk_vow(3, IOP_VOW_ENS(), 2, 0));
    i.push(mk_inst_return(4, 0));
    let p: Vec<i64> = Vec::new();
    p.push(ty);
    query(vc_claims(one_block(String::from("k"), p, ty, i)), 0)
}

fn check_constants_are_masked_to_their_width() -> i64 {
    if !const_query(IOP_CONST_I32(), ITY_U32(), -1, 0).contains(String::from("(= p0 #xffffffff)")) { return 180; }
    if !const_query(IOP_CONST_I32(), ITY_I16(), -32768, 0).contains(String::from("(= p0 #x8000)")) { return 181; }
    if !const_query(IOP_CONST_U8(), ITY_I8(), 255, 0).contains(String::from("(= p0 #xff)")) { return 182; }
    if !const_query(IOP_CONST_U128(), ITY_U128(), 1, -1).contains(String::from("(= p0 #xffffffffffffffff0000000000000001)")) { return 183; }
    if !const_query(IOP_CONST_I128(), ITY_I128(), -1, -1).contains(String::from("(= p0 #xffffffffffffffffffffffffffffffff)")) { return 184; }
    0
}

fn literal_cmp_query(ty: i64, lit: i64) -> String {
    let i: Vec<IrInst> = Vec::new();
    i.push(mk_inst_arg(0, ty, 0));
    i.push(mk_inst_const_i64(1, lit));
    i.push(mk_inst(2, IOP_LE(), ITY_BOOL(), args2(0, 1)));
    i.push(mk_vow(3, IOP_VOW_ENS(), 2, 0));
    i.push(mk_inst_return(4, 0));
    let p: Vec<i64> = Vec::new();
    p.push(ty);
    let f: IrFunction = one_block(String::from("lit"), p, ty, i);
    if vc_skip_reason(f).len() != 0 { return String::from("skipped"); }
    let cs: VcClaims = vc_claims(f);
    vc_smt_render(cs.arena, cs.header)
}

// An i64 literal read at another integer type: sign-extended for a signed type,
// zero-extended for an unsigned one.
fn check_literal_operands() -> i64 {
    let min: i64 = -9223372036854775807 - 1;
    if !literal_cmp_query(ITY_U128(), min).contains(String::from("#x00000000000000008000000000000000")) { return 190; }
    if !literal_cmp_query(ITY_I128(), min).contains(String::from("#xffffffffffffffff8000000000000000")) { return 191; }
    if !literal_cmp_query(ITY_U64(), min).contains(String::from("(bvule p0 #x8000000000000000)")) { return 192; }
    if !literal_cmp_query(ITY_I8(), -5).contains(String::from("(bvsle p0 #xfb)")) { return 193; }
    if !literal_cmp_query(ITY_U8(), 200).contains(String::from("(bvule p0 #xc8)")) { return 194; }
    0
}

// while i < bound { i = i + 1 } with an invariant, as the lowerer shapes it.
// The bound is the literal 8 (invariant `i <= 8`) or, when `symbolic`, the
// parameter `n` (invariant `i <= n`). `with_req` adds a parameter `n` and
// `requires n > 0`.
fn counted_loop(symbolic: bool, with_req: bool) -> IrFunction {
    let has_param: bool = symbolic || with_req;
    let e: Vec<IrInst> = Vec::new();
    e.push(mk_inst_const_i64(0, 0));
    if has_param { e.push(mk_inst_arg(13, ITY_I64(), 0)); }
    if with_req {
        e.push(mk_inst(14, IOP_GT(), ITY_BOOL(), args2(13, 0)));
        e.push(mk_vow(15, IOP_VOW_REQ(), 14, 3));
    }
    e.push(mk_inst_upsilon(1, 0, 3));
    e.push(mk_inst_jump(2, 1));
    let h: Vec<IrInst> = Vec::new();
    h.push(mk_inst_phi(3, ITY_I64()));
    if symbolic {
        h.push(mk_inst(5, IOP_LT(), ITY_BOOL(), args2(3, 13)));
        h.push(mk_inst(16, IOP_LE(), ITY_BOOL(), args2(3, 13)));
    } else {
        h.push(mk_inst_const_i64(4, 8));
        h.push(mk_inst(5, IOP_LT(), ITY_BOOL(), args2(3, 4)));
        h.push(mk_inst(16, IOP_LE(), ITY_BOOL(), args2(3, 4)));
    }
    h.push(mk_vow(6, IOP_VOW_INV(), 16, 7));
    h.push(mk_inst_upsilon(7, 3, 20));
    h.push(mk_inst_branch(8, 5, 2, 3));
    let b: Vec<IrInst> = Vec::new();
    b.push(mk_inst_const_i64(9, 1));
    b.push(mk_inst_add(10, 3, 9));
    b.push(mk_inst_upsilon(11, 10, 3));
    b.push(mk_inst_jump(12, 1));
    let x: Vec<IrInst> = Vec::new();
    x.push(mk_inst_phi(20, ITY_I64()));
    x.push(mk_inst_return(21, 20));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, e));
    blocks.push(mk_block(1, h));
    blocks.push(mk_block(2, b));
    blocks.push(mk_block(3, x));
    let p: Vec<i64> = Vec::new();
    if has_param { p.push(ITY_I64()); }
    mk_function(1, String::from("count_up"), p, ITY_I64(), blocks)
}

fn kind_count(cs: VcClaims, kind: i64) -> i64 {
    let mut n: i64 = 0;
    let mut k: u64 = 0;
    while k < cs.kinds.len() {
        if cs.kinds[k] == kind { n = n + 1; }
        k = k + 1;
    }
    n
}

fn unwind_claim(cs: VcClaims) -> u64 {
    let mut u: u64 = 0;
    while u < cs.kinds.len() && cs.kinds[u] != VC_CLAIM_UNWIND() { u = u + 1; }
    u
}

fn define_count(cs: VcClaims) -> i64 {
    count_of(vc_smt_render(cs.arena, cs.header), String::from("(define-fun "))
}

fn check_unrolled_loop_claims() -> i64 {
    let cs: VcClaims = vc_claims(vc_unroll(counted_loop(true, false), 2).f);
    // one invariant claim per header copy, each with the original vow id
    if kind_count(cs, VC_CLAIM_ENSURES()) != 3 { return 800; }
    let mut k: u64 = 0;
    while k < cs.kinds.len() {
        if cs.kinds[k] == VC_CLAIM_ENSURES() && cs.vow_ids[k] != 7 { return 801; }
        k = k + 1;
    }
    // exactly one unwinding claim, and nothing is assumed after it
    if kind_count(cs, VC_CLAIM_UNWIND()) != 1 { return 802; }
    if cs.assumed.len() != 0 { return 803; }
    let u: u64 = unwind_claim(cs);
    if cs.vow_ids[u] != -1 || cs.labels[u] != VC_LABEL_UNWIND() { return 804; }
    // a loop-free function has no unwinding claim
    let plain: VcClaims = vc_claims(vc_unroll(one_block(String::from("k"), Vec::new(), ITY_I64(), divide_free()), 4).f);
    if kind_count(plain, VC_CLAIM_UNWIND()) != 0 { return 805; }
    0
}

// With a literal bound every copy of the invariant and of the loop test is a
// constant: the invariants are decided, and only the unwinding claim is left,
// its negated query the constant `true` under no assumptions.
fn check_literal_loop_decides_its_invariants() -> i64 {
    let cs: VcClaims = vc_claims(vc_unroll(counted_loop(false, false), 2).f);
    if cs.kinds.len() != 1 { return 806; }
    let u: u64 = unwind_claim(cs);
    if u != 0 { return 807; }
    if !vc_tm_is_true(cs.arena, cs.negated_goals[0]) { return 808; }
    if cs.assumed_lens[0] != 0 { return 809; }
    if define_count(cs) != 0 { return 810; }
    0
}

// At a bound that covers the loop nothing is left to ask.
fn check_covered_literal_loop_has_no_claims() -> i64 {
    let cs: VcClaims = vc_claims(vc_unroll(counted_loop(false, false), 8).f);
    if cs.kinds.len() != 0 { return 811; }
    if define_count(cs) != 0 { return 812; }
    0
}

// 16 iterations of a loop against a symbolic bound: every header copy keeps its
// test and its invariant, but the counter and its sum fold to constants. The
// unfolded executor needed 122 definitions and 18 claims for this function.
fn check_symbolic_loop_names_only_composites() -> i64 {
    let cs: VcClaims = vc_claims(vc_unroll(counted_loop(true, false), 16).f);
    if cs.kinds.len() > 18 { return 813; }
    if define_count(cs) * 10 > 122 * 7 { return 814; }
    0
}

// Static satisfiability needs an empty assumption prefix: behind a `requires`
// the claim keeps its place for the solver, which may find the assumptions
// contradictory.
fn check_static_sat_needs_no_assumptions() -> i64 {
    let free: VcClaims = vc_claims(vc_unroll(counted_loop(false, false), 2).f);
    if !vc_claim_is_static_sat(free, 0) { return 815; }
    let guarded: VcClaims = vc_claims(vc_unroll(counted_loop(false, true), 2).f);
    if guarded.kinds.len() != 1 { return 816; }
    if !vc_tm_is_true(guarded.arena, guarded.negated_goals[0]) { return 817; }
    if guarded.assumed_lens[0] != 1 { return 818; }
    if vc_claim_is_static_sat(guarded, 0) { return 819; }
    0
}

fn divide_free() -> Vec<IrInst> {
    let i: Vec<IrInst> = Vec::new();
    i.push(mk_inst_const_i64(0, 3));
    i.push(mk_inst_return(1, 0));
    i
}

// A bound too small for the loop leaves the unwinding claim satisfiable; at a
// bound that covers it the claim is the constant-false path.
fn check_unwinding_claim_query() -> i64 {
    let g: IrFunction = vc_unroll(counted_loop(false, false), 1).f;
    let cs: VcClaims = vc_claims(g);
    let mut u: u64 = 0;
    while cs.kinds[u] != VC_CLAIM_UNWIND() { u = u + 1; }
    let q: String = query(cs, u);
    if !q.contains(String::from("check-sat")) { return 810; }
    if count_of(q, String::from("(assert")) != 1 { return 811; }
    0
}

// Inlined callee clauses: a `requires` in a frame is a claim blamed on the
// caller and an `ensures` in a frame one blamed on the callee, both assumed
// once asked; the target's own `ensures` stays a claim. Its predicate differs
// from the callee's, since a claim equal to an earlier assumption is elided.
fn framed(i: IrInst, frame: i64) -> IrInst {
    i.ds = vc_frame_mark(frame);
    i
}

fn callee_clause_function() -> IrFunction {
    let i: Vec<IrInst> = Vec::new();
    i.push(mk_inst_arg(0, ITY_I64(), 0));
    i.push(mk_inst_arg(1, ITY_I64(), 1));
    i.push(mk_inst_const_i64(2, 0));
    i.push(mk_inst(3, IOP_GT(), ITY_BOOL(), args2(1, 2)));
    i.push(framed(mk_vow(4, IOP_VOW_REQ(), 3, 4), 0));
    i.push(mk_inst(5, IOP_WDIV(), ITY_I64(), args2(0, 1)));
    i.push(mk_inst(6, IOP_GE(), ITY_BOOL(), args2(5, 2)));
    i.push(framed(mk_vow(7, IOP_VOW_ENS(), 6, 5), 0));
    i.push(mk_inst(8, IOP_GT(), ITY_BOOL(), args2(5, 2)));
    i.push(mk_vow(9, IOP_VOW_ENS(), 8, 2));
    i.push(mk_inst_return(10, 5));
    one_block(String::from("flat"), params2(), ITY_I64(), i)
}

fn one_frame() -> VcFrames {
    let fr: VcFrames = vc_frames_new();
    fr.func_ids.push(9);
    fr.call_starts.push(10);
    fr.call_lens.push(3);
    fr.parents.push(-1);
    fr
}

fn check_callee_clauses_are_claims() -> i64 {
    let f: IrFunction = callee_clause_function();
    if vc_skip_reason(f).len() != 0 { return 1; }
    let cs: VcClaims = vc_claims_mode(f, one_frame(), false);
    if cs.kinds.len() != 5 { return 2; }
    if cs.kinds[0] != VC_CLAIM_CALLER_PRE() || cs.vow_ids[0] != 4 || cs.frames[0] != 0 { return 3; }
    if cs.kinds[1] != VC_CLAIM_DIV_ZERO() || cs.kinds[2] != VC_CLAIM_DIV_OVERFLOW() { return 4; }
    if cs.kinds[3] != VC_CLAIM_CALLEE_POST() || cs.vow_ids[3] != 5 || cs.frames[3] != 0 { return 5; }
    if cs.kinds[4] != VC_CLAIM_ENSURES() || cs.vow_ids[4] != 2 || cs.frames[4] != -1 { return 6; }
    // The callee's `requires` is claimed first and assumed for everything after it.
    if cs.assumed_lens[0] != 0 || cs.assumed_lens[1] != 1 { return 7; }
    // The callee's `ensures` is assumed once claimed; the target's own is not.
    if cs.assumed_lens[3] != 3 || cs.assumed_lens[4] != 4 { return 8; }
    if cs.assumed.len() != 4 { return 9; }
    0
}

fn check_frame_free_clauses_are_unchanged() -> i64 {
    let f: IrFunction = divide_with_requires(IOP_WDIV());
    let a: VcClaims = vc_claims(f);
    let b: VcClaims = vc_claims_mode(f, vc_frames_new(), false);
    if a.kinds.len() != b.kinds.len() || a.kinds.len() != 2 { return 1; }
    if a.frames[0] != -1 || a.frames[1] != -1 { return 2; }
    0
}

// A function without a `vow` block is held only to its callees' preconditions:
// every other claim is assumed instead, so a later claim still sees its guard.
fn check_caller_precondition_role() -> i64 {
    let f: IrFunction = callee_clause_function();
    let cs: VcClaims = vc_claims_mode(f, one_frame(), true);
    if cs.kinds.len() != 1 { return 1; }
    if cs.kinds[0] != VC_CLAIM_CALLER_PRE() || cs.vow_ids[0] != 4 { return 2; }
    // `requires` and the two division guards are assumed, plus the callee's
    // and the target's `ensures`.
    if cs.assumed.len() != 4 { return 3; }
    0
}

// counted_loop(true, false) with `100 / i` in the body: a hard claim `i != 0` per
// copy of the body.
fn div_loop() -> IrFunction {
    let f: IrFunction = counted_loop(true, false);
    let b: IrBlock = f.blocks[2];
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_const_i64(30, 100));
    insts.push(mk_inst(31, IOP_WDIV(), ITY_I64(), args2(30, 3)));
    let mut i: u64 = 0;
    while i < b.insts.len() {
        insts.push(b.insts[i]);
        i = i + 1;
    }
    f.blocks[2] = mk_block(2, insts);
    f
}

fn first_of_kind(cs: VcClaims, kind: i64) -> u64 {
    let mut k: u64 = 0;
    while k < cs.kinds.len() && cs.kinds[k] != kind { k = k + 1; }
    k
}

// In the step function the iteration copies below k are hypotheses: their claims
// are not asked, their goals (guards and the invariant) are assumed, and the
// copy at k asks its own claims and then assumes its invariant.
fn check_step_hypotheses_are_assumed() -> i64 {
    let u: VcUnrolled = vc_unroll_step(div_loop(), 2);
    if u.status != VC_UNROLL_OK() { return 900; }
    let every: VcClaims = vc_claims_step(u.f, vc_frames_new(), false, Vec::new());
    if kind_count(every, VC_CLAIM_DIV_ZERO()) != 3 { return 901; }
    if kind_count(every, VC_CLAIM_ENSURES()) != 3 { return 902; }
    let cs: VcClaims = vc_claims_step(u.f, vc_frames_new(), false, u.hyp);
    if kind_count(cs, VC_CLAIM_DIV_ZERO()) != 1 { return 903; }
    if kind_count(cs, VC_CLAIM_ENSURES()) != 1 { return 904; }
    if kind_count(cs, VC_CLAIM_UNWIND()) != 0 { return 905; }
    // inv0, div0, inv1, div1, inv2 before the claim at copy 2
    let d: u64 = first_of_kind(cs, VC_CLAIM_DIV_ZERO());
    if cs.assumed_lens[d] != 5 { return 906; }
    // the invariant at copy k is assumed after it is asked, then the division guard
    let assumed: Vec<i64> = cs.assumed;
    if assumed.len() != 6 { return 907; }
    0
}

fn main() -> i32 {
    let mut r: i64 = check_divide_with_requires();
    if r == 0 { r = check_rem_has_only_zero_claim(); }
    if r == 0 { r = check_ensures_claim_golden(); }
    if r == 0 { r = check_requires_only_has_no_claims(); }
    if r == 0 { r = check_second_division_assumes_first(); }
    if r == 0 { r = check_duplicate_guard_claim_elided(); }
    if r == 0 { r = check_division_in_requires_is_positional(); }
    if r == 0 { r = check_names_are_internal(); }
    if r == 0 { r = check_bool_operators(); }
    if r == 0 { r = check_constant_bool_logic_folds_away(); }
    if r == 0 { r = check_diamond_phi_is_ite(); }
    if r == 0 { r = check_early_return_claims_carry_path_condition(); }
    if r == 0 { r = check_constant_guard_prunes_dead_arm(); }
    if r == 0 { r = check_repeated_guard_prunes_inner_else(); }
    if r == 0 { r = check_arm_division_assumption_is_guarded(); }
    if r == 0 { r = check_query_size_is_linear_in_nesting(); }
    if r == 0 { r = check_nested_else_edge_is_one_name(); }

    if r == 0 { r = check_unsigned_division(); }
    if r == 0 { r = check_signed_division_widths(); }
    if r == 0 { r = check_checked_arith_is_a_soft_claim(); }
    if r == 0 { r = check_checked_div_claims(); }
    if r == 0 { r = check_checked_guard_is_assumed_later(); }
    if r == 0 { r = check_shift_claims(); }
    if r == 0 { r = check_casts(); }
    if r == 0 { r = check_constants_are_masked_to_their_width(); }
    if r == 0 { r = check_literal_operands(); }
    if r == 0 { r = check_unrolled_loop_claims(); }
    if r == 0 { r = check_literal_loop_decides_its_invariants(); }
    if r == 0 { r = check_covered_literal_loop_has_no_claims(); }
    if r == 0 { r = check_symbolic_loop_names_only_composites(); }
    if r == 0 { r = check_static_sat_needs_no_assumptions(); }
    if r == 0 { r = check_unwinding_claim_query(); }
    if r == 0 { r = check_callee_clauses_are_claims(); }
    if r == 0 { r = check_frame_free_clauses_are_unchanged(); }
    if r == 0 { r = check_caller_precondition_role(); }
    if r == 0 { r = check_step_hypotheses_are_assumed(); }
    i64_to_i32_wrap(r)
}
