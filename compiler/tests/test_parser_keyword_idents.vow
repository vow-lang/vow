module TestParserKeywordIdents

use lexer
use ast
use diag
use parser

// A keyword where an identifier is required (#1777) must be reported at the
// keyword and the parser must terminate. Failures return a distinct exit code:
// 1000 * template number + 1 + keyword index, 1 for a keyword that was accepted.

fn keywords() -> Vec<String> {
    let kws: Vec<String> = Vec::new();
    let names: String = String::from("fn let mut struct enum match if else while loop break continue return pub use module vow requires ensures invariant where region linear extern impl trait type for in as read write io panic unsafe const");
    let mut start: u64 = 0;
    let mut i: u64 = 0;
    let n: u64 = names.len();
    while i <= n {
        if i == n || names.byte_at(i) == 32 {
            kws.push(names.substring(start, i));
            start = i + 1;
        }
        i = i + 1;
    }
    kws
}

fn first_error_offset(src: String) -> i64 {
    let arena: AstArena = arena_new();
    let dctx: DiagCtx = diag_ctx_new();
    let _parsed: Module = parse_module_into(lex(src), arena, dctx, String::from("kw.vow"));
    if dctx.error_count == 0 {
        return -1;
    }
    let d: Diagnostic = dctx.diags[0];
    d.span_start
}

fn probe(prefix: String, suffix: String, skip_mut: bool, base: i64) -> i64 {
    let kws: Vec<String> = keywords();
    let mut k: u64 = 0;
    while k < kws.len() {
        let kw: String = kws[k];
        if !(skip_mut && kw == String::from("mut")) {
            let src: String = String::from("");
            src.push_str(prefix);
            src.push_str(kw);
            src.push_str(suffix);
            if first_error_offset(src) != prefix.len() as i64 {
                return base + 1 + k as i64;
            }
        }
        k = k + 1;
    }
    0
}

fn main() -> i32 {
    let prefixes: Vec<String> = Vec::new();
    let suffixes: Vec<String> = Vec::new();
    let skip: Vec<bool> = Vec::new();

    prefixes.push(String::from("module M\nstruct S {\n    "));
    suffixes.push(String::from(": i64,\n}\n"));
    skip.push(false);

    prefixes.push(String::from("module M\nstruct S {\n    a: i64,\n    "));
    suffixes.push(String::from(": i64,\n}\n"));
    skip.push(false);

    prefixes.push(String::from("module M\nstruct "));
    suffixes.push(String::from(" {\n}\n"));
    skip.push(false);

    prefixes.push(String::from("module M\nenum E {\n    A,\n    "));
    suffixes.push(String::from(",\n}\n"));
    skip.push(false);

    prefixes.push(String::from("module M\nenum E {\n    A("));
    suffixes.push(String::from("),\n}\n"));
    skip.push(false);

    prefixes.push(String::from("module M\nenum E {\n    A { "));
    suffixes.push(String::from(": i64 },\n}\n"));
    skip.push(false);

    prefixes.push(String::from("module M\nfn "));
    suffixes.push(String::from("() -> i64 {\n    0\n}\n"));
    skip.push(false);

    prefixes.push(String::from("module M\nfn f() -> i64 {\n    for "));
    suffixes.push(String::from(" in v { }\n    0\n}\n"));
    skip.push(false);

    prefixes.push(String::from("module M\nfn f("));
    suffixes.push(String::from(": i64) -> i64 {\n    0\n}\n"));
    skip.push(false);

    prefixes.push(String::from("module M\nfn f(a: "));
    suffixes.push(String::from(") -> i64 {\n    0\n}\n"));
    skip.push(false);

    prefixes.push(String::from("module M\nfn f() -> i64 {\n    let "));
    suffixes.push(String::from(" = 1;\n    0\n}\n"));
    skip.push(true);

    prefixes.push(String::from("module M\nfn f(e: E) -> i64 {\n    match e {\n        E::A("));
    suffixes.push(String::from(") => 0,\n    }\n}\n"));
    skip.push(true);

    prefixes.push(String::from("module M\nfn f(e: E) -> i64 {\n    match e {\n        E::A(x, "));
    suffixes.push(String::from(") => 0,\n    }\n}\n"));
    skip.push(true);

    prefixes.push(String::from("module M\nfn f(e: E) -> i64 {\n    match e {\n        S { "));
    suffixes.push(String::from(": x } => 0,\n    }\n}\n"));
    skip.push(false);

    prefixes.push(String::from("module M\nfn f(e: E) -> i64 {\n    match e {\n        (a, "));
    suffixes.push(String::from(") => 0,\n    }\n}\n"));
    skip.push(true);

    let mut t: u64 = 0;
    while t < prefixes.len() {
        let r: i64 = probe(prefixes[t], suffixes[t], skip[t], 1000 * (t as i64 + 1));
        if r != 0 {
            return i64_to_i32_wrap(r);
        }
        t = t + 1;
    }
    0
}
