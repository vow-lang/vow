fn int_tys() -> Vec<i64> {
    let t: Vec<i64> = Vec::new();
    t.push(ITY_I8());
    t.push(ITY_U8());
    t.push(ITY_I16());
    t.push(ITY_U16());
    t.push(ITY_I32());
    t.push(ITY_U32());
    t.push(ITY_I64());
    t.push(ITY_U64());
    t.push(ITY_I128());
    t.push(ITY_U128());
    t
}

fn ops_under_test() -> Vec<i64> {
    let o: Vec<i64> = Vec::new();
    o.push(IOP_WADD());
    o.push(IOP_WDIV());
    o.push(IOP_WREM());
    o.push(IOP_CADD());
    o.push(IOP_CSUB());
    o.push(IOP_CMUL());
    o.push(IOP_CDIV());
    o.push(IOP_CREM());
    o.push(IOP_BITXOR());
    o
}

// a <op> b on every integer width, then a < b, are inside the subset.
fn check_every_width_accepted() -> i64 {
    let tys: Vec<i64> = int_tys();
    let ops: Vec<i64> = ops_under_test();
    let mut ti: u64 = 0;
    while ti < tys.len() {
        let ty: i64 = tys[ti];
        let mut oi: u64 = 0;
        while oi < ops.len() {
            let i: Vec<IrInst> = Vec::new();
            i.push(mk_inst_arg(0, ty, 0));
            i.push(mk_inst_arg(1, ty, 1));
            i.push(mk_inst(2, ops[oi], ty, args2(0, 1)));
            i.push(mk_inst(3, IOP_LT(), ITY_BOOL(), args2(0, 2)));
            i.push(mk_vow(4, IOP_VOW_ENS(), 3, 0));
            i.push(mk_inst_return(5, 2));
            let p: Vec<i64> = Vec::new();
            p.push(ty);
            p.push(ty);
            let r: String = vc_skip_reason(one_block(String::from("w"), p, ty, i));
            if r.len() != 0 { return 100 + (ti as i64) * 10 + oi as i64; }
            oi = oi + 1;
        }
        ti = ti + 1;
    }
    0
}

fn shift_fn(op: i64, lhs_ty: i64, count_ty: i64, dk: i64, dv: i64) -> IrFunction {
    let i: Vec<IrInst> = Vec::new();
    i.push(mk_inst_arg(0, lhs_ty, 0));
    i.push(mk_inst_arg(1, count_ty, 1));
    i.push(ir_inst_new(2, op, lhs_ty, args2(0, 1), dk, dv, 0, String::from("")));
    i.push(mk_inst_return(3, 2));
    let p: Vec<i64> = Vec::new();
    p.push(lhs_ty);
    p.push(count_ty);
    one_block(String::from("sh"), p, lhs_ty, i)
}

fn check_shifts() -> i64 {
    if vc_skip_reason(shift_fn(IOP_SHL(), ITY_I64(), ITY_U32(), IDATA_INTEGER(), ITY_I64())).len() != 0 { return 200; }
    if vc_skip_reason(shift_fn(IOP_SHR(), ITY_U8(), ITY_U32(), IDATA_INTEGER(), ITY_U8())).len() != 0 { return 201; }
    if vc_skip_reason(shift_fn(IOP_SHR(), ITY_I128(), ITY_I128(), IDATA_INTEGER(), ITY_I128())).len() != 0 { return 202; }
    let plain: String = vc_skip_reason(shift_fn(IOP_SHL(), ITY_I64(), ITY_U32(), IDATA_NONE(), 0));
    if plain != String::from("unsupported-opcode: Shl[i64]") { return 203; }
    let wrong_ty: String = vc_skip_reason(shift_fn(IOP_SHL(), ITY_I64(), ITY_U32(), IDATA_INTEGER(), ITY_U64()));
    if !wrong_ty.contains(String::from("unsupported-opcode")) { return 204; }
    let bool_count: String = vc_skip_reason(shift_fn(IOP_SHL(), ITY_I64(), ITY_BOOL(), IDATA_INTEGER(), ITY_I64()));
    if !bool_count.contains(String::from("unsupported-opcode")) { return 205; }
    0
}

fn cast_fn(src: i64, dst: i64, dk: i64, dv: i64, dv2: i64) -> IrFunction {
    let i: Vec<IrInst> = Vec::new();
    i.push(mk_inst_arg(0, src, 0));
    i.push(ir_inst_new(1, IOP_INT_CAST(), dst, args1(0), dk, dv, dv2, String::from("")));
    i.push(mk_inst_return(2, 1));
    let p: Vec<i64> = Vec::new();
    p.push(src);
    one_block(String::from("cast"), p, dst, i)
}

fn check_casts() -> i64 {
    if vc_skip_reason(cast_fn(ITY_U8(), ITY_I128(), IDATA_INTEGER_CAST(), ITY_U8(), ITY_I128())).len() != 0 { return 210; }
    if vc_skip_reason(cast_fn(ITY_I64(), ITY_U64(), IDATA_INTEGER_CAST(), ITY_I64(), ITY_U64())).len() != 0 { return 211; }
    if vc_skip_reason(cast_fn(ITY_I64(), ITY_U64(), IDATA_NONE(), 0, 0)).len() == 0 { return 212; }
    if vc_skip_reason(cast_fn(ITY_I64(), ITY_U64(), IDATA_INTEGER_CAST(), ITY_I32(), ITY_U64())).len() == 0 { return 213; }
    if vc_skip_reason(cast_fn(ITY_I64(), ITY_PTR(), IDATA_INTEGER_CAST(), ITY_I64(), ITY_PTR())).len() == 0 { return 214; }
    0
}

fn const_fn(op: i64, ty: i64) -> IrFunction {
    let i: Vec<IrInst> = Vec::new();
    i.push(ir_inst_new(0, op, ty, Vec::new(), IDATA_CONST_I64(), 1, 0, String::from("")));
    i.push(mk_inst_return(1, 0));
    one_block(String::from("k"), Vec::new(), ty, i)
}

fn check_constant_opcode_matches_type() -> i64 {
    if vc_skip_reason(const_fn(IOP_CONST_I32(), ITY_U16())).len() != 0 { return 220; }
    if vc_skip_reason(const_fn(IOP_CONST_U8(), ITY_I8())).len() != 0 { return 221; }
    if vc_skip_reason(const_fn(IOP_CONST_U128(), ITY_U128())).len() != 0 { return 222; }
    if vc_skip_reason(const_fn(IOP_CONST_U8(), ITY_I64())).len() == 0 { return 223; }
    if vc_skip_reason(const_fn(IOP_CONST_I128(), ITY_U128())).len() == 0 { return 224; }
    if vc_skip_reason(const_fn(IOP_CONST_I32(), ITY_BOOL())).len() == 0 { return 225; }
    0
}

fn check_non_dominating_read() -> i64 {
    let i: Vec<IrInst> = Vec::new();
    i.push(mk_inst_return(1, 7));
    let r: String = vc_skip_reason(one_block(String::from("bad"), Vec::new(), ITY_I64(), i));
    if !r.contains(String::from("ir-non-dominating-read")) { return 60; }
    0
}

fn check_shape() -> i64 {
    let none: Vec<IrInst> = Vec::new();
    let r: String = vc_skip_reason(one_block(String::from("e"), Vec::new(), ITY_I64(), none));
    if !r.contains(String::from("unsupported-opcode")) { return 70; }
    let nr: Vec<IrInst> = Vec::new();
    nr.push(mk_inst_const_i64(0, 1));
    let r2: String = vc_skip_reason(one_block(String::from("nr"), Vec::new(), ITY_I64(), nr));
    if !r2.contains(String::from("unsupported-opcode")) { return 71; }
    let bad_ret: Vec<IrInst> = Vec::new();
    bad_ret.push(mk_inst_const_i64(0, 1));
    bad_ret.push(mk_inst(1, IOP_EQ(), ITY_BOOL(), args2(0, 0)));
    bad_ret.push(mk_inst_return(2, 1));
    let r3: String = vc_skip_reason(one_block(String::from("br"), Vec::new(), ITY_I64(), bad_ret));
    if !r3.contains(String::from("Return")) { return 72; }
    0
}

// A contract clause `result == x + 1` on a u64 adds an i64 literal to a u64.
fn check_literal_operands() -> i64 {
    let i: Vec<IrInst> = Vec::new();
    i.push(mk_inst_arg(0, ITY_U64(), 0));
    i.push(mk_inst_const_i64(1, 1));
    i.push(mk_inst(2, IOP_WADD(), ITY_U64(), args2(0, 1)));
    i.push(mk_inst(3, IOP_LT(), ITY_BOOL(), args2(0, 1)));
    i.push(mk_vow(4, IOP_VOW_ENS(), 3, 0));
    i.push(mk_inst_return(5, 2));
    let p: Vec<i64> = Vec::new();
    p.push(ITY_U64());
    if vc_skip_reason(one_block(String::from("lit"), p, ITY_U64(), i)).len() != 0 { return 230; }

    let m: Vec<IrInst> = Vec::new();
    m.push(mk_inst_arg(0, ITY_U64(), 0));
    m.push(mk_inst_arg(1, ITY_I32(), 1));
    m.push(mk_inst(2, IOP_WADD(), ITY_U64(), args2(0, 1)));
    m.push(mk_inst_return(3, 2));
    let pm: Vec<i64> = Vec::new();
    pm.push(ITY_U64());
    pm.push(ITY_I32());
    if vc_skip_reason(one_block(String::from("mix"), pm, ITY_U64(), m)).len() == 0 { return 231; }
    0
}

// Every code the gate emits is on the closed ADR list.
fn check_emitted_codes_are_closed() -> i64 {
    let ops: Vec<IrInst> = Vec::new();
    ops.push(mk_inst_call_extern(0, ITY_I64(), Vec::new(), String::from("__vow_fs_exists")));
    ops.push(mk_inst_return(1, 0));
    if !vc_skip_code_valid(vc_reason_code(vc_skip_reason(one_block(String::from("a"), Vec::new(), ITY_I64(), ops)))) { return 90; }
    let eff: Vec<IrInst> = Vec::new();
    eff.push(mk_inst_const_i64(0, 1));
    eff.push(mk_inst_return(1, 0));
    let fe: IrFunction = one_block(String::from("e"), Vec::new(), ITY_I64(), eff);
    fe.effects = 1;
    if !vc_skip_code_valid(vc_reason_code(vc_skip_reason(fe))) { return 91; }
    let dom: Vec<IrInst> = Vec::new();
    dom.push(mk_inst_return(1, 7));
    if !vc_skip_code_valid(vc_reason_code(vc_skip_reason(one_block(String::from("d"), Vec::new(), ITY_I64(), dom)))) { return 92; }
    0
}

fn reserved_probe(name: String) -> IrFunction {
    let i: Vec<IrInst> = Vec::new();
    i.push(mk_inst_const_i64(0, 1));
    i.push(mk_inst_return(1, 0));
    one_block(name, Vec::new(), ITY_I64(), i)
}

fn check_reserved_symbol() -> i64 {
    let r: String = vc_skip_reason(reserved_probe(String::from("__ESBMC_assume")));
    if r != String::from("reserved-verifier-symbol: __ESBMC_assume") { return 100; }
    let v: String = vc_skip_reason(reserved_probe(String::from("__VERIFIER_nondet_int")));
    if v != String::from("reserved-verifier-symbol: __VERIFIER_nondet_int") { return 101; }
    if !vc_skip_code_valid(vc_reason_code(r)) { return 102; }
    // Only the two checker prefixes are reserved; ordinary and near-miss names are not.
    if vc_skip_reason(reserved_probe(String::from("abs"))).len() != 0 { return 103; }
    if vc_skip_reason(reserved_probe(String::from("_ESBMC_x"))).len() != 0 { return 104; }
    if vc_skip_reason(reserved_probe(String::from("my__VERIFIER_x"))).len() != 0 { return 105; }
    if vc_skip_reason(reserved_probe(String::from("__ESBMC"))).len() != 0 { return 106; }
    // The reserved name wins over an effect, as in the ESBMC model.
    let fe: IrFunction = reserved_probe(String::from("__VERIFIER_x"));
    fe.effects = 1;
    if vc_reason_code(vc_skip_reason(fe)) != String::from("reserved-verifier-symbol") { return 107; }
    0
}

fn check_reason_codes() -> i64 {
    let fr: Vec<IrInst> = Vec::new();
    fr.push(mk_inst(0, IOP_CONST_F64(), ITY_F64(), Vec::new()));
    fr.push(mk_inst(1, IOP_REM_F64(), ITY_F64(), args2(0, 0)));
    fr.push(mk_inst_return(2, 1));
    let rf: String = vc_skip_reason(one_block(String::from("fr"), Vec::new(), ITY_F64(), fr));
    if !rf.contains(String::from("float-rem-unsupported: ")) { return 80; }

    let pure_ext: Vec<IrInst> = Vec::new();
    pure_ext.push(mk_inst_call_extern(0, ITY_I64(), Vec::new(), String::from("__vow_vec_reserve_in_arena")));
    pure_ext.push(mk_inst_return(1, 0));
    let rb: String = vc_skip_reason(one_block(String::from("b"), Vec::new(), ITY_I64(), pure_ext));
    if rb != String::from("unmodeled-builtin: __vow_vec_reserve_in_arena") { return 81; }

    let cat: Vec<IrInst> = Vec::new();
    cat.push(mk_inst_call_extern(0, ITY_I64(), Vec::new(), String::from("__vow_fs_exists")));
    cat.push(mk_inst_return(1, 0));
    let rc: String = vc_skip_reason(one_block(String::from("c"), Vec::new(), ITY_I64(), cat));
    if rc != String::from("unmodeled-builtin: __vow_fs_exists") { return 82; }

    let ng: Vec<IrInst> = Vec::new();
    ng.push(mk_inst_const_bool(0, 1));
    ng.push(ir_inst_new(1, IOP_FIELD_GET(), ITY_I64(), args1(0), IDATA_FIELD(), 0, 0, String::from("")));
    ng.push(mk_inst_return(2, 1));
    let rn: String = vc_skip_reason(one_block(String::from("n"), Vec::new(), ITY_I64(), ng));
    if !rn.contains(String::from("unsupported-opcode: FieldGet")) { return 84; }
    0
}

// A call of a user function is accepted only when its arguments and result are
// scalars or objects (pointers), and only by the check that inlines it afterwards.
fn check_scalar_calls() -> i64 {
    let ok: Vec<IrInst> = Vec::new();
    ok.push(mk_inst_arg(0, ITY_I64(), 0));
    ok.push(mk_inst_call_target(1, ITY_I64(), args1(0), 7));
    ok.push(mk_inst_return(2, 1));
    let p: Vec<i64> = Vec::new();
    p.push(ITY_I64());
    let f: IrFunction = one_block(String::from("c"), p, ITY_I64(), ok);
    if vc_skip_reason(f) != String::from("unsupported-opcode: Call[i64]") { return 1; }
    if vc_skip_reason_calls(f).len() != 0 { return 2; }

    let unit: Vec<IrInst> = Vec::new();
    unit.push(mk_inst_arg(0, ITY_I64(), 0));
    unit.push(mk_inst_call_target(1, ITY_UNIT(), args1(0), 7));
    unit.push(mk_inst_return(2, 0));
    if vc_skip_reason_calls(one_block(String::from("u"), p, ITY_I64(), unit)).len() != 0 { return 3; }

    let agg: Vec<IrInst> = Vec::new();
    agg.push(mk_inst_alloc(0, 16));
    agg.push(mk_inst_call_target(1, ITY_I64(), args1(0), 7));
    agg.push(mk_inst_return(2, 1));
    if vc_skip_reason(one_block(String::from("a"), Vec::new(), ITY_I64(), agg)).len() == 0 { return 4; }
    if vc_skip_reason_calls(one_block(String::from("a"), Vec::new(), ITY_I64(), agg)).len() != 0 { return 7; }

    let ptr_result: Vec<IrInst> = Vec::new();
    ptr_result.push(mk_inst_arg(0, ITY_I64(), 0));
    ptr_result.push(mk_inst_call_target(1, ITY_PTR(), args1(0), 7));
    ptr_result.push(mk_inst_return(2, 0));
    if vc_skip_reason(one_block(String::from("r"), p, ITY_I64(), ptr_result)).len() == 0 { return 5; }
    if vc_skip_reason_calls(one_block(String::from("r"), p, ITY_I64(), ptr_result)).len() != 0 { return 8; }

    let ext: Vec<IrInst> = Vec::new();
    ext.push(mk_inst_arg(0, ITY_I64(), 0));
    ext.push(mk_inst_call_extern(1, ITY_I64(), args1(0), String::from("__vow_abs_i64")));
    ext.push(mk_inst_return(2, 1));
    if vc_skip_reason_calls(one_block(String::from("e"), p, ITY_I64(), ext)).len() == 0 { return 6; }
    0
}

fn args3(a: i64, b: i64, c: i64) -> Vec<i64> {
    let v: Vec<i64> = args2(a, b);
    v.push(c);
    v
}

fn vec_new_insts() -> Vec<IrInst> {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_const_i64(0, 8));
    insts.push(mk_inst_const_i64(1, 8));
    insts.push(mk_inst_call_extern(2, ITY_PTR(), args2(0, 1), String::from("__vow_vec_new")));
    insts
}

// let v = Vec::new(); v.push(7); v[0] = 9; let x = v[0]; v.pop(); let n = v.len(); v.truncate(0); v.clear(); return n
fn check_vec_ops_accepted() -> i64 {
    let insts: Vec<IrInst> = vec_new_insts();
    insts.push(mk_inst_const_i64(3, 7));
    insts.push(mk_inst_call_extern(4, ITY_UNIT(), args2(2, 3), String::from("__vow_vec_push_val")));
    insts.push(mk_inst_const_i64(5, 0));
    insts.push(mk_inst_call_extern(6, ITY_UNIT(), args3(2, 5, 3), String::from("__vow_vec_set_val")));
    insts.push(mk_inst_call_extern(7, ITY_I64(), args2(2, 5), String::from("__vow_vec_get_val")));
    insts.push(mk_inst_call_extern(8, ITY_UNIT(), args1(2), String::from("__vow_vec_pop")));
    insts.push(mk_inst_call_extern(9, ITY_U64(), args1(2), String::from("__vow_vec_len")));
    insts.push(mk_inst_call_extern(11, ITY_UNIT(), args2(2, 5), String::from("__vow_vec_truncate")));
    insts.push(mk_inst_call_extern(12, ITY_UNIT(), args1(2), String::from("__vow_vec_clear")));
    insts.push(mk_inst_return(10, 9));
    let f: IrFunction = one_block(String::from("v"), Vec::new(), ITY_U64(), insts);
    let why: String = vc_skip_reason(f);
    if why.len() != 0 { return 1; }
    0
}

fn vec_fn_with(sym: String, ty: i64, args: Vec<i64>, extra: Vec<IrInst>) -> IrFunction {
    let insts: Vec<IrInst> = vec_new_insts();
    let mut k: u64 = 0;
    while k < extra.len() {
        insts.push(extra[k]);
        k = k + 1;
    }
    insts.push(mk_inst_call_extern(20, ty, args, sym));
    insts.push(mk_inst_const_i64(21, 0));
    insts.push(mk_inst_return(22, 21));
    one_block(String::from("v"), Vec::new(), ITY_I64(), insts)
}

fn check_vec_ops_rejected() -> i64 {
    let none: Vec<IrInst> = Vec::new();
    // `clear` takes only the Vec and yields unit.
    let clear_ret: IrFunction = vec_fn_with(String::from("__vow_vec_clear"), ITY_I64(), args1(2), none);
    if vc_reason_code(vc_skip_reason(clear_ret)) != VC_SKIP_UNSUPPORTED_OPCODE() { return 16; }
    let clear_arity: IrFunction = vec_fn_with(String::from("__vow_vec_clear"), ITY_UNIT(), args2(2, 0), none);
    if vc_reason_code(vc_skip_reason(clear_arity)) != VC_SKIP_UNSUPPORTED_OPCODE() { return 17; }
    // `truncate` takes a 64-bit count; a 32-bit one is not read as such.
    let narrow_n: Vec<IrInst> = Vec::new();
    narrow_n.push(mk_inst(30, IOP_CONST_I32(), ITY_I32(), Vec::new()));
    let trunc32: IrFunction = vec_fn_with(String::from("__vow_vec_truncate"), ITY_UNIT(), args2(2, 30), narrow_n);
    if vc_reason_code(vc_skip_reason(trunc32)) != VC_SKIP_UNSUPPORTED_OPCODE() { return 18; }
    let trunc_arity: IrFunction = vec_fn_with(String::from("__vow_vec_truncate"), ITY_UNIT(), args1(2), none);
    if vc_reason_code(vc_skip_reason(trunc_arity)) != VC_SKIP_UNSUPPORTED_OPCODE() { return 19; }
    // A symbol outside the Vec table stays an unmodelled builtin.
    let arena: IrFunction = vec_fn_with(String::from("__vow_vec_from_raw_parts_copy_val_in_arena"), ITY_PTR(), args2(2, 2), none);
    if vc_reason_code(vc_skip_reason(arena)) != VC_SKIP_UNMODELED_BUILTIN() { return 11; }
    // An element narrower than 64 bits is still one slot, widened.
    let narrow_elem: Vec<IrInst> = Vec::new();
    narrow_elem.push(mk_inst(31, IOP_CONST_I32(), ITY_I32(), Vec::new()));
    let i32_push: IrFunction = vec_fn_with(String::from("__vow_vec_push_val"), ITY_UNIT(), args2(2, 31), narrow_elem);
    if vc_skip_reason(i32_push).len() != 0 { return 12; }
    // A unit value is no element.
    let unit_elem: Vec<IrInst> = Vec::new();
    unit_elem.push(mk_inst(31, IOP_CONST_UNIT(), ITY_UNIT(), Vec::new()));
    let unit_push: IrFunction = vec_fn_with(String::from("__vow_vec_push_val"), ITY_UNIT(), args2(2, 31), unit_elem);
    if vc_reason_code(vc_skip_reason(unit_push)) != VC_SKIP_UNSUPPORTED_OPCODE() { return 15; }
    // A 32-bit index is not read as a 64-bit one.
    let narrow: Vec<IrInst> = Vec::new();
    narrow.push(mk_inst(30, IOP_CONST_I32(), ITY_I32(), Vec::new()));
    let idx32: IrFunction = vec_fn_with(String::from("__vow_vec_get_val"), ITY_I64(), args2(2, 30), narrow);
    if vc_reason_code(vc_skip_reason(idx32)) != VC_SKIP_UNSUPPORTED_OPCODE() { return 13; }
    // `len` yields u64.
    let bad_len: IrFunction = vec_fn_with(String::from("__vow_vec_len"), ITY_I64(), args1(2), none);
    if vc_reason_code(vc_skip_reason(bad_len)) != VC_SKIP_UNSUPPORTED_OPCODE() { return 14; }
    0
}

// A pointer pushed or stored is a fresh constant when nothing looks at the slot again, and the
// address of its object when the function reads an element of a `Vec` it built; a read of a
// `Vec` it was given, or a copy, is not in the subset.
fn check_pointer_elements() -> i64 {
    let none: Vec<IrInst> = Vec::new();
    // let outer = Vec::new(); outer.push(outer)
    let ptr_push: IrFunction = vec_fn_with(String::from("__vow_vec_push_val"), ITY_UNIT(), args2(2, 2), none);
    if vc_skip_reason(ptr_push).len() != 0 { return 1; }
    // outer.set(0, outer)
    let zero: Vec<IrInst> = Vec::new();
    zero.push(mk_inst_const_i64(30, 0));
    let ptr_set: IrFunction = vec_fn_with(String::from("__vow_vec_set_val"), ITY_UNIT(), args3(2, 30, 2), zero);
    if vc_skip_reason(ptr_set).len() != 0 { return 2; }
    // outer.push(outer); let h = outer[0]
    let get_insts: Vec<IrInst> = Vec::new();
    get_insts.push(mk_inst_call_extern(30, ITY_UNIT(), args2(2, 2), String::from("__vow_vec_push_val")));
    get_insts.push(mk_inst_const_i64(31, 0));
    let get: IrFunction = vec_fn_with(String::from("__vow_vec_get_val"), ITY_I64(), args2(2, 31), get_insts);
    // the Vec is built by the function and the pointer is an object it names: the slot holds
    // its address, so the read is of that object
    if vc_skip_reason(get).len() != 0 { return 3; }
    let got: VcPtrStores = vc_ptr_store_analyze(get, vc_ty_table(get), false);
    if !got.addr { return 8; }
    // a store nothing reads back keeps the constant
    if vc_ptr_store_analyze(ptr_push, vc_ty_table(ptr_push), false).addr { return 9; }
    // the same with a Vec parameter: the elements it already holds are memory the caller gave
    let gp: Vec<IrInst> = Vec::new();
    gp.push(mk_inst_arg(40, ITY_PTR(), 0));
    gp.push(mk_inst_call_extern(30, ITY_UNIT(), args2(40, 40), String::from("__vow_vec_push_val")));
    gp.push(mk_inst_const_i64(31, 0));
    let gpf: IrFunction = vec_fn_with(String::from("__vow_vec_get_val"), ITY_I64(), args2(40, 31), gp);
    let gpp: Vec<i64> = Vec::new();
    gpp.push(ITY_PTR());
    gpf.params = gpp;
    if vc_skip_reason(gpf) != String::from("unsupported-opcode: a pointer element is read back") { return 7; }
    // a copy carries the slot along
    let copy: Vec<IrInst> = Vec::new();
    copy.push(mk_inst_call_extern(30, ITY_UNIT(), args2(2, 2), String::from("__vow_vec_push_val")));
    let sorted: IrFunction = vec_fn_with(String::from("__vow_vec_sort"), ITY_PTR(), args1(2), copy);
    if vc_skip_reason(sorted) != String::from("unsupported-opcode: a Vec of pointer elements is copied") { return 4; }
    // a handle read in the same function
    let handle: Vec<IrInst> = Vec::new();
    handle.push(mk_inst_call_extern(30, ITY_UNIT(), args2(2, 2), String::from("__vow_vec_push_val")));
    handle.push(mk_inst_arg(31, ITY_I64(), 0));
    let hf: IrFunction = vec_fn_with(String::from("__vow_vec_len"), ITY_U64(), args1(31), handle);
    let ps: Vec<i64> = Vec::new();
    ps.push(ITY_I64());
    hf.params = ps;
    // the Vec the pointer is stored into is built by the function: no handle can name it
    if vc_skip_reason(hf).len() != 0 { return 5; }
    // the same with a parameter Vec: a handle may be that parameter
    let pv: Vec<IrInst> = Vec::new();
    pv.push(mk_inst_arg(40, ITY_PTR(), 0));
    pv.push(mk_inst_arg(41, ITY_I64(), 1));
    pv.push(mk_inst_call_extern(30, ITY_UNIT(), args2(40, 40), String::from("__vow_vec_push_val")));
    pv.push(mk_inst_call_extern(31, ITY_U64(), args1(41), String::from("__vow_vec_len")));
    pv.push(mk_inst_const_i64(32, 0));
    pv.push(mk_inst_return(33, 32));
    let pp: Vec<i64> = Vec::new();
    pp.push(ITY_PTR());
    pp.push(ITY_I64());
    let pf: IrFunction = one_block(String::from("v"), pp, ITY_I64(), pv);
    if vc_skip_reason(pf) != String::from("unsupported-opcode: a pointer element is stored in a function that reads memory through a handle") { return 6; }
    0
}

// The class an overlay entry of a parameter is declared under comes from the head of its type.
fn check_param_class() -> i64 {
    let f: IrFunction = ir_function_new(0, String::from("p"), ITY_UNIT(), 0, String::from(""));
    f.param_keys.push(String::from("Vec"));
    f.param_keys.push(String::from("String"));
    f.param_keys.push(String::from("Person"));
    f.param_keys.push(String::from("HashMap"));
    f.param_keys.push(String::from(""));
    if vc_overlay_param_class(f, 0) != VC_OV_VEC() { return 1; }
    if vc_overlay_param_class(f, 1) != VC_OV_STRING() { return 2; }
    if vc_overlay_param_class(f, 2) != VC_OV_STRUCT() { return 3; }
    if vc_overlay_param_class(f, 3) != 0 { return 4; }
    if vc_overlay_param_class(f, 4) != 0 { return 5; }
    if vc_overlay_param_class(f, 5) != 0 { return 6; }
    if vc_overlay_param_class(f, -1) != 0 { return 7; }
    0
}

// A pointer-typed `Return` may carry a handle (`i64`); every other type pair is a mismatch.
fn check_handle_for_object() -> i64 {
    if !vc_handle_for_object(ITY_PTR(), ITY_I64()) { return 1; }
    if vc_handle_for_object(ITY_PTR(), ITY_PTR()) { return 2; }
    if vc_handle_for_object(ITY_I64(), ITY_PTR()) { return 3; }
    if vc_handle_for_object(ITY_PTR(), ITY_U64()) { return 4; }
    // fn f(h: i64) -> ptr { h }
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_arg(0, ITY_I64(), 0));
    insts.push(mk_inst_return(1, 0));
    let ps: Vec<i64> = Vec::new();
    ps.push(ITY_I64());
    let f: IrFunction = one_block(String::from("h"), ps, ITY_PTR(), insts);
    if vc_skip_reason(f).len() != 0 { return 5; }
    // fn g(h: u64) -> ptr { h }
    let bad: Vec<IrInst> = Vec::new();
    bad.push(mk_inst_arg(0, ITY_U64(), 0));
    bad.push(mk_inst_return(1, 0));
    let qs: Vec<i64> = Vec::new();
    qs.push(ITY_U64());
    let g: IrFunction = one_block(String::from("g"), qs, ITY_PTR(), bad);
    if vc_reason_code(vc_skip_reason(g)) != VC_SKIP_UNSUPPORTED_OPCODE() { return 6; }
    0
}

// let s = vec_sort(v); s.len(): a Vec in, a new Vec out.
fn check_vec_sort() -> i64 {
    let insts: Vec<IrInst> = vec_new_insts();
    insts.push(mk_inst_call_extern(3, ITY_PTR(), args1(2), String::from("__vow_vec_sort")));
    insts.push(mk_inst_call_extern(4, ITY_U64(), args1(3), String::from("__vow_vec_len")));
    insts.push(mk_inst_return(5, 4));
    let f: IrFunction = one_block(String::from("s"), Vec::new(), ITY_U64(), insts);
    if vc_skip_reason(f).len() != 0 { return 40; }
    let bad: Vec<IrInst> = vec_new_insts();
    bad.push(mk_inst_call_extern(3, ITY_I64(), args1(2), String::from("__vow_vec_sort")));
    bad.push(mk_inst_const_i64(4, 0));
    bad.push(mk_inst_return(5, 4));
    let g: IrFunction = one_block(String::from("g"), Vec::new(), ITY_I64(), bad);
    if vc_reason_code(vc_skip_reason(g)) != VC_SKIP_UNSUPPORTED_OPCODE() { return 41; }
    0
}

// Vec::from_raw_parts_copy(ptr, len) and pin_to_root(v) are the `String` operations of the same
// shape: an i64 source and a u64 length, a Vec operand.
fn check_vec_copy_ops() -> i64 {
    let extra: Vec<IrInst> = Vec::new();
    extra.push(mk_inst_arg(30, ITY_I64(), 0));
    extra.push(mk_inst(31, IOP_CONST_U64(), ITY_U64(), Vec::new()));
    let ps: Vec<i64> = Vec::new();
    ps.push(ITY_I64());
    let insts: Vec<IrInst> = vec_new_insts();
    let mut k: u64 = 0;
    while k < extra.len() {
        insts.push(extra[k]);
        k = k + 1;
    }
    insts.push(mk_inst_call_extern(32, ITY_PTR(), args2(30, 31), String::from("__vow_vec_from_raw_parts_copy_val")));
    insts.push(mk_inst_call_extern(33, ITY_PTR(), args1(32), String::from("__vow_vec_pin_to_root_val")));
    insts.push(mk_inst_call_extern(34, ITY_U64(), args1(33), String::from("__vow_vec_len")));
    insts.push(mk_inst_return(35, 34));
    let f: IrFunction = one_block(String::from("c"), ps, ITY_U64(), insts);
    if vc_skip_reason(f).len() != 0 { return 30; }
    let bad: Vec<IrInst> = vec_new_insts();
    bad.push(mk_inst_call_extern(32, ITY_PTR(), args1(2), String::from("__vow_vec_from_raw_parts_copy_val")));
    bad.push(mk_inst_const_i64(33, 0));
    bad.push(mk_inst_return(34, 33));
    let g: IrFunction = one_block(String::from("g"), Vec::new(), ITY_I64(), bad);
    if vc_reason_code(vc_skip_reason(g)) != VC_SKIP_UNSUPPORTED_OPCODE() { return 31; }
    0
}

// let v = Vec::new(); v.push(x) as two slots; v[0] = x; return v[0], for x: i128 or u128.
fn wide_vec_fn(ty: i64, tail: Vec<IrInst>, ret: i64) -> IrFunction {
    let insts: Vec<IrInst> = vec_new_insts();
    insts.push(mk_inst_arg(3, ty, 0));
    insts.push(mk_inst_call_extern(4, ITY_PTR(), args1(2), String::from("__vow_vec_push_wide_ptr")));
    insts.push(mk_inst_field_set_wide(5, 4, 0, 3));
    insts.push(mk_inst_const_i64(6, 0));
    insts.push(mk_inst_call_extern(7, ITY_PTR(), args2(2, 6), String::from("__vow_vec_set_wide_ptr")));
    insts.push(mk_inst_field_set_wide(8, 7, 0, 3));
    insts.push(mk_inst_call_extern(9, ITY_PTR(), args2(2, 6), String::from("__vow_vec_get_wide_ptr")));
    insts.push(mk_inst_field_get_wide(10, ty, 9, 0));
    let mut k: u64 = 0;
    while k < tail.len() {
        insts.push(tail[k]);
        k = k + 1;
    }
    let ps: Vec<i64> = Vec::new();
    ps.push(ty);
    one_block(String::from("w"), ps, ret, insts)
}

fn check_wide_vec_ops() -> i64 {
    let ok_tail: Vec<IrInst> = Vec::new();
    ok_tail.push(mk_inst_return(11, 10));
    if vc_skip_reason(wide_vec_fn(ITY_I128(), ok_tail, ITY_I128())).len() != 0 { return 20; }
    if vc_skip_reason(wide_vec_fn(ITY_U128(), ok_tail, ITY_U128())).len() != 0 { return 21; }
    // An element address is a target for a `WideSlot` access, not a value.
    let leak: Vec<IrInst> = Vec::new();
    leak.push(mk_inst_return(11, 9));
    let leaked: String = vc_skip_reason(wide_vec_fn(ITY_I128(), leak, ITY_PTR()));
    if leaked != String::from("unsupported-opcode: wide Vec element address used as a value") { return 22; }
    // A one-slot access (`dv != 0`) of the address is not the first limb pair.
    let second: Vec<IrInst> = Vec::new();
    second.push(mk_inst_field_get_wide(11, ITY_I128(), 9, 1));
    second.push(mk_inst_return(12, 11));
    if vc_reason_code(vc_skip_reason(wide_vec_fn(ITY_I128(), second, ITY_I128()))) != VC_SKIP_UNSUPPORTED_OPCODE() { return 23; }
    0
}

fn parse_hook_fn(arg_ty: i64, call_ty: i64) -> IrFunction {
    let ps: Vec<i64> = Vec::new();
    ps.push(arg_ty);
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_arg(0, arg_ty, 0));
    insts.push(mk_inst_call_extern(1, call_ty, args1(0), String::from("__vow_parse_f64_bits")));
    insts.push(mk_inst_return(2, 1));
    one_block(String::from("p"), ps, call_ty, insts)
}

fn format_hook_fn(arg_ty: i64, call_ty: i64) -> IrFunction {
    let ps: Vec<i64> = Vec::new();
    ps.push(arg_ty);
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_arg(0, arg_ty, 0));
    insts.push(mk_inst_call_extern(1, call_ty, args1(0), String::from("__vow_format_f64_bits")));
    insts.push(mk_inst_call_extern(2, ITY_U64(), args1(1), String::from("__vow_vec_len")));
    insts.push(mk_inst_return(3, 2));
    one_block(String::from("f"), ps, ITY_U64(), insts)
}

// `parse_f64_bits(String) -> u64` and `format_f64_bits(u64) -> String` are modelled;
// every other operand or result type is not.
fn check_float_bits_hooks() -> i64 {
    if vc_skip_reason(parse_hook_fn(ITY_PTR(), ITY_U64())).len() != 0 { return 20; }
    if vc_skip_reason(format_hook_fn(ITY_U64(), ITY_PTR())).len() != 0 { return 21; }
    if vc_reason_code(vc_skip_reason(parse_hook_fn(ITY_U64(), ITY_U64()))) != VC_SKIP_UNSUPPORTED_OPCODE() { return 22; }
    if vc_reason_code(vc_skip_reason(parse_hook_fn(ITY_PTR(), ITY_I64()))) != VC_SKIP_UNSUPPORTED_OPCODE() { return 23; }
    if vc_reason_code(vc_skip_reason(format_hook_fn(ITY_PTR(), ITY_PTR()))) != VC_SKIP_UNSUPPORTED_OPCODE() { return 24; }
    if vc_reason_code(vc_skip_reason(format_hook_fn(ITY_U32(), ITY_PTR()))) != VC_SKIP_UNSUPPORTED_OPCODE() { return 25; }
    if vc_skip_reason(format_hook_fn(ITY_I64(), ITY_PTR())).len() != 0 { return 26; }
    0
}

fn main() -> i32 {
    let mut r: i64 = check_accepted();
    if r == 0 { r = check_vec_ops_accepted(); }
    if r == 0 { r = check_vec_ops_rejected(); }
    if r == 0 { r = check_pointer_elements(); }
    if r == 0 { let c: i64 = check_param_class(); if c != 0 { r = 200 + c; } }
    if r == 0 { r = check_handle_for_object(); }
    if r == 0 { r = check_vec_sort(); }
    if r == 0 { r = check_vec_copy_ops(); }
    if r == 0 { r = check_wide_vec_ops(); }
    if r == 0 { r = check_scalar_calls(); }
    if r == 0 { r = check_effects(); }
    if r == 0 { r = check_branches_accepted(); }
    if r == 0 { r = check_phi_input_missing(); }
    if r == 0 { r = check_phi_after_region_markers(); }
    if r == 0 { r = check_entry_loop_rejected(); }
    if r == 0 { r = check_loop_accepted(); }
    if r == 0 { r = check_loop_value_escape_closed(); }
    if r == 0 { r = check_void_return_accepted(); }
    if r == 0 { r = check_branch_to_unknown_block(); }
    if r == 0 { r = check_unreachable_terminator(); }
    if r == 0 { r = check_op_details(); }
    if r == 0 { r = check_bool_param(); }
    if r == 0 { r = check_get_arg_must_match_param_type(); }
    if r == 0 { r = check_every_width_accepted(); }
    if r == 0 { r = check_shifts(); }
    if r == 0 { r = check_casts(); }
    if r == 0 { r = check_constant_opcode_matches_type(); }
    if r == 0 { r = check_literal_operands(); }
    if r == 0 { r = check_non_dominating_read(); }
    if r == 0 { r = check_shape(); }
    if r == 0 { r = check_reason_codes(); }
    if r == 0 { r = check_emitted_codes_are_closed(); }
    if r == 0 { r = check_reserved_symbol(); }
    if r == 0 { r = check_float_bits_hooks(); }
    i64_to_i32_wrap(r)
}
