module TestVcCallgraph

use ir
use vc_callgraph
use tests.builders

fn args1(a: i64) -> Vec<i64> {
    let v: Vec<i64> = Vec::new();
    v.push(a);
    v
}

fn mk_vow(id: i64, op: i64, pred: i64, vow_id: i64) -> IrInst {
    ir_inst_new(id, op, ITY_UNIT(), args1(pred), IDATA_VOW_ID(), vow_id, 0, String::from(""))
}

fn fn_of(id: i64, name: String, ret: i64, blocks: Vec<IrBlock>) -> IrFunction {
    mk_function(id, name, mk_params1(), ret, blocks)
}

fn one(b: IrBlock) -> Vec<IrBlock> {
    let v: Vec<IrBlock> = Vec::new();
    v.push(b);
    v
}

// name(x) = other(x)
fn forwarder(id: i64, name: String, other: i64) -> IrFunction {
    let i: Vec<IrInst> = Vec::new();
    i.push(mk_inst_arg(0, ITY_I64(), 0));
    i.push(mk_inst_call_target(1, ITY_I64(), args1(0), other));
    i.push(mk_inst_return(2, 1));
    fn_of(id, name, ITY_I64(), one(mk_block(0, i)))
}

fn leaf(id: i64, name: String) -> IrFunction {
    let i: Vec<IrInst> = Vec::new();
    i.push(mk_inst_arg(0, ITY_I64(), 0));
    i.push(mk_inst_return(1, 0));
    fn_of(id, name, ITY_I64(), one(mk_block(0, i)))
}

fn module3(a: IrFunction, b: IrFunction, c: IrFunction) -> IrModule {
    let fs: Vec<IrFunction> = Vec::new();
    fs.push(a);
    fs.push(b);
    fs.push(c);
    mk_module(fs)
}

fn check_cycles() -> i64 {
    let self_rec: IrModule = module3(forwarder(0, String::from("a"), 0), leaf(1, String::from("l")), leaf(2, String::from("m")));
    let idx: VcCallGraph = vc_calls_new(self_rec.functions, 100);
    if vc_calls_reach(idx, 0).cycle != String::from("a -> a") { return 1; }

    let mutual: IrModule = module3(forwarder(0, String::from("a"), 1), forwarder(1, String::from("b"), 0), leaf(2, String::from("m")));
    let midx: VcCallGraph = vc_calls_new(mutual.functions, 100);
    if vc_calls_reach(midx, 0).cycle != String::from("a -> b -> a") { return 2; }
    if vc_calls_reach(midx, 1).cycle != String::from("b -> a -> b") { return 3; }

    let indirect: IrModule = module3(forwarder(0, String::from("a"), 1), forwarder(1, String::from("b"), 2), forwarder(2, String::from("c"), 1));
    let iidx: VcCallGraph = vc_calls_new(indirect.functions, 100);
    if vc_calls_reach(iidx, 0).cycle != String::from("b -> c -> b") { return 4; }

    let chain: IrModule = module3(forwarder(0, String::from("a"), 1), forwarder(1, String::from("b"), 2), leaf(2, String::from("c")));
    let cidx: VcCallGraph = vc_calls_new(chain.functions, 100);
    if vc_calls_reach(cidx, 0).cycle.len() != 0 { return 5; }

    // A cycle that the root does not reach is not the root's problem.
    let aside: IrModule = module3(forwarder(0, String::from("a"), 1), leaf(1, String::from("b")), forwarder(2, String::from("c"), 2));
    let aidx: VcCallGraph = vc_calls_new(aside.functions, 100);
    if vc_calls_reach(aidx, 0).cycle.len() != 0 { return 6; }
    0
}

// a calls b twice, b calls c: a diamond without a cycle.
fn check_diamond_is_acyclic() -> i64 {
    let top_i: Vec<IrInst> = Vec::new();
    top_i.push(mk_inst_arg(0, ITY_I64(), 0));
    top_i.push(mk_inst_call_target(1, ITY_I64(), args1(0), 1));
    top_i.push(mk_inst_call_target(2, ITY_I64(), args1(1), 2));
    top_i.push(mk_inst_return(3, 2));
    let top: IrFunction = fn_of(0, String::from("top"), ITY_I64(), one(mk_block(0, top_i)));
    let m: IrModule = module3(top, forwarder(1, String::from("left"), 2), leaf(2, String::from("base")));
    let idx: VcCallGraph = vc_calls_new(m.functions, 100);
    if vc_calls_reach(idx, 0).cycle.len() != 0 { return 1; }
    let reach: VcCallReach = vc_calls_reach(idx, 0);
    let order: Vec<i64> = reach.callees;
    if order.len() != 2 || order[0] != 2 || order[1] != 1 { return 2; }
    0
}


// Sparse ids, first duplicate resolution, unresolved edges and repeated expansion.
fn check_lookup_and_sizes() -> i64 {
    let fs: Vec<IrFunction> = Vec::new();
    fs.push(forwarder(7, String::from("top"), 42));
    fs.push(leaf(42, String::from("first")));
    fs.push(forwarder(42, String::from("duplicate"), 42));
    fs.push(leaf(-2, String::from("negative")));
    let idx: VcCallGraph = vc_calls_new(fs, 100);
    if vc_calls_resolve(idx, 42) != 1 || vc_calls_resolve(idx, 7) != 0 { return 1; }
    if vc_calls_resolve(idx, -2) != -1 || vc_calls_resolve(idx, 43) != -1 { return 2; }
    if vc_calls_reach(idx, 0).cycle.len() > 0 { return 3; }
    if vc_calls_size(idx, 0) != 5 { return 4; }
    if vc_calls_size(vc_calls_new(fs, 3), 0) != 4 { return 5; }
    // Sizing a supplied body must not substitute the indexed body with the same id.
    let other: IrFunction = leaf(7, String::from("other"));
    if vc_calls_body_size(idx, other) != 2 { return 6; }
    let missing: IrFunction = forwarder(9, String::from("missing"), 43);
    if vc_calls_body_size(idx, missing) != 3 { return 7; }
    let empty: Vec<IrFunction> = Vec::new();
    if vc_calls_resolve(vc_calls_new(empty, 100), 0) != -1 { return 8; }
    0
}

fn check_repeated_and_snapshots() -> i64 {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_arg(0, ITY_I64(), 0));
    insts.push(mk_inst_call_target(1, ITY_I64(), args1(0), 2));
    insts.push(mk_inst_call_target(2, ITY_I64(), args1(1), 2));
    insts.push(mk_inst_return(3, 2));
    let root: IrFunction = fn_of(0, String::from("root"), ITY_I64(), one(mk_block(0, insts)));
    let fs: Vec<IrFunction> = Vec::new();
    fs.push(root);
    fs.push(forwarder(2, String::from("middle"), 8));
    fs.push(leaf(8, String::from("base")));
    let idx: VcCallGraph = vc_calls_new(fs, 100);
    if vc_calls_size(idx, 0) != 14 { return 1; }
    if vc_calls_size(idx, 1) != 5 { return 2; }
    let copies: Vec<i64> = vc_calls_copies(vc_calls_reach(idx, 0));
    if copies.len() != 3 || copies[0] != 1 || copies[1] != 2 || copies[2] != 2 { return 7; }
    let small: VcCallGraph = vc_calls_new(fs, 4);
    if vc_calls_size(small, 0) != 5 { return 3; }
    if vc_calls_size(idx, 0) != 14 { return 4; }
    // A summary changes the topology: replace middle by a leaf in a new list.
    let cur: Vec<IrFunction> = Vec::new();
    cur.push(root);
    cur.push(leaf(2, String::from("summary")));
    cur.push(fs[2]);
    let changed: VcCallGraph = vc_calls_new(cur, 100);
    let reach: VcCallReach = vc_calls_reach(changed, 0);
    let order: Vec<i64> = reach.callees;
    if order.len() != 1 || order[0] != 1 { return 5; }
    if vc_calls_size(changed, 0) != 8 { return 6; }
    0
}

fn check_absent_and_leaf_reaches() -> i64 {
    let empty: VcCallGraph = vc_calls_new(Vec::new(), 100);
    let absent: VcCallReach = vc_calls_reach(empty, vc_calls_resolve(empty, 0));
    if absent.cycle.len() != 0 || absent.callees.len() != 0 { return 1; }
    if vc_calls_copies(absent).len() != 0 { return 2; }
    let fs: Vec<IrFunction> = Vec::new();
    fs.push(forwarder(7, String::from("caller"), 42));
    fs.push(leaf(42, String::from("leaf")));
    let graph: VcCallGraph = vc_calls_new(fs, 100);
    let missing: VcCallReach = vc_calls_reach(graph, vc_calls_resolve(graph, 99));
    if missing.cycle.len() != 0 || missing.callees.len() != 0 { return 3; }
    let none: Vec<i64> = vc_calls_copies(missing);
    if none.len() != 2 || none[0] != 0 || none[1] != 0 { return 4; }
    let leaf_reach: VcCallReach = vc_calls_reach(graph, 1);
    if leaf_reach.cycle.len() != 0 || leaf_reach.callees.len() != 0 { return 5; }
    let copies: Vec<i64> = vc_calls_copies(leaf_reach);
    if copies.len() != 2 || copies[0] != 0 || copies[1] != 1 { return 6; }
    0
}

// A supplied root uses its own instructions, but calls still resolve to module
// bodies, even when a call names the supplied root's own id.
fn check_supplied_root_bodies() -> i64 {
    let fs: Vec<IrFunction> = Vec::new();
    fs.push(leaf(0, String::from("indexed")));
    fs.push(forwarder(1, String::from("middle"), 0));
    let graph: VcCallGraph = vc_calls_new(fs, 100);
    if vc_calls_size(graph, 0) != 2 || vc_calls_size(graph, 1) != 5 { return 1; }
    let other: IrFunction = forwarder(0, String::from("other"), 1);
    if vc_calls_body_size(graph, other) != 8 { return 2; }
    if vc_calls_body_size(graph, other) != 8 || vc_calls_size(graph, 0) != 2 { return 3; }
    if vc_calls_reach(graph, 0).callees.len() != 0 { return 4; }
    let self_named: IrFunction = forwarder(0, String::from("self_named"), 0);
    if vc_calls_body_size(graph, self_named) != 5 { return 5; }

    let cyclic: Vec<IrFunction> = Vec::new();
    cyclic.push(forwarder(0, String::from("cycle"), 0));
    cyclic.push(leaf(1, String::from("base")));
    let recursive: VcCallGraph = vc_calls_new(cyclic, 20);
    let walk: VcCallReach = vc_calls_reach(recursive, 0);
    if walk.cycle != String::from("cycle -> cycle") || walk.callees.len() != 0 { return 6; }
    // The indexed root is recursive; a supplied leaf with that id is not.
    if vc_calls_body_size(recursive, leaf(0, String::from("replacement"))) != 2 { return 7; }
    if vc_calls_size(recursive, 0) != 21 || vc_calls_size(recursive, 0) != 21 { return 8; }
    if vc_calls_body_size(recursive, forwarder(0, String::from("to_base"), 1)) != 5 { return 9; }
    if vc_calls_body_size(recursive, forwarder(9, String::from("to_cycle"), 0)) != 21 { return 10; }
    0
}

// Unresolved user calls contribute their own instruction, while an extern call
// with dv=0 must not become an edge to the function with id 0.
fn check_unresolved_and_extern_calls() -> i64 {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_arg(0, ITY_I64(), 0));
    insts.push(mk_inst_call_target(1, ITY_I64(), args1(0), -7));
    insts.push(mk_inst_call_target(2, ITY_I64(), args1(1), 99));
    insts.push(mk_inst_call_extern(3, ITY_I64(), args1(2), String::from("external")));
    insts.push(mk_inst_call_target(4, ITY_I64(), args1(3), 42));
    insts.push(mk_inst_return(5, 4));
    let fs: Vec<IrFunction> = Vec::new();
    fs.push(fn_of(0, String::from("root"), ITY_I64(), one(mk_block(0, insts))));
    fs.push(leaf(42, String::from("base")));
    fs.push(forwarder(-7, String::from("negative"), 0));
    let graph: VcCallGraph = vc_calls_new(fs, 100);
    if vc_calls_resolve(graph, -7) != -1 || vc_calls_resolve(graph, 99) != -1 { return 1; }
    let walk: VcCallReach = vc_calls_reach(graph, 0);
    if walk.cycle.len() != 0 || walk.callees.len() != 1 || walk.callees[0] != 1 { return 2; }
    if vc_calls_size(graph, 0) != 8 || vc_calls_body_size(graph, fs[0]) != 8 { return 3; }
    let copies: Vec<i64> = vc_calls_copies(walk);
    if copies.len() != 3 || copies[0] != 1 || copies[1] != 1 || copies[2] != 0 { return 4; }
    0
}

// Interleave memoised queries at exact and saturated caps over the same list.
fn check_independent_caps_and_recursion() -> i64 {
    let fs: Vec<IrFunction> = Vec::new();
    fs.push(forwarder(0, String::from("top"), 1));
    fs.push(forwarder(1, String::from("middle"), 2));
    fs.push(leaf(2, String::from("base")));
    let exact: VcCallGraph = vc_calls_new(fs, 8);
    let small: VcCallGraph = vc_calls_new(fs, 2);
    let zero: VcCallGraph = vc_calls_new(fs, 0);
    if vc_calls_size(small, 0) != 3 || vc_calls_size(exact, 0) != 8 { return 1; }
    if vc_calls_size(small, 2) != 2 || vc_calls_size(exact, 1) != 5 { return 2; }
    if vc_calls_size(zero, 2) != 1 || vc_calls_size(exact, 2) != 2 { return 3; }
    if vc_calls_size(small, 1) != 3 || vc_calls_size(exact, 0) != 8 { return 4; }
    let recursive: Vec<IrFunction> = Vec::new();
    recursive.push(forwarder(0, String::from("a"), 1));
    recursive.push(forwarder(1, String::from("b"), 0));
    let cycle: VcCallGraph = vc_calls_new(recursive, 50);
    if vc_calls_size(cycle, 0) != 51 || vc_calls_size(cycle, 1) != 51 { return 5; }
    if vc_calls_size(cycle, 0) != 51 || vc_calls_body_size(cycle, recursive[0]) != 51 { return 6; }
    let walk: VcCallReach = vc_calls_reach(cycle, 0);
    if walk.cycle != String::from("a -> b -> a") || walk.callees.len() != 0 { return 7; }
    0
}

fn main() -> i32 {
    let mut r: i64 = check_cycles();
    if r == 0 { let d: i64 = check_diamond_is_acyclic(); if d != 0 { r = 100 + d; } }
    if r == 0 { let d: i64 = check_lookup_and_sizes(); if d != 0 { r = 200 + d; } }
    if r == 0 { let d: i64 = check_repeated_and_snapshots(); if d != 0 { r = 300 + d; } }
    if r == 0 { let d: i64 = check_absent_and_leaf_reaches(); if d != 0 { r = 400 + d; } }
    if r == 0 { let d: i64 = check_supplied_root_bodies(); if d != 0 { r = 500 + d; } }
    if r == 0 { let d: i64 = check_unresolved_and_extern_calls(); if d != 0 { r = 600 + d; } }
    if r == 0 { let d: i64 = check_independent_caps_and_recursion(); if d != 0 { r = 700 + d; } }
    i64_to_i32_wrap(r)
}
