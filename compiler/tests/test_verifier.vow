module TestVerifier

use ir
use verifier
use verifier_harness
use verifier_ids

fn check_known_nondet_calls() -> i64 {
    if esbmc_nondet_call(ITY_I8()) != String::from("__VERIFIER_nondet_char()") { return 10; }
    if esbmc_nondet_call(ITY_U8()) != String::from("__VERIFIER_nondet_unsigned_char()") { return 11; }
    if esbmc_nondet_call(ITY_I16()) != String::from("__VERIFIER_nondet_short()") { return 12; }
    if esbmc_nondet_call(ITY_U16()) != String::from("__VERIFIER_nondet_unsigned_short()") { return 13; }
    if esbmc_nondet_call(ITY_I32()) != String::from("__VERIFIER_nondet_int()") { return 1; }
    if esbmc_nondet_call(ITY_U32()) != String::from("__VERIFIER_nondet_unsigned_int()") { return 14; }
    if esbmc_nondet_call(ITY_I64()) != String::from("__VERIFIER_nondet_long()") { return 2; }
    if esbmc_nondet_call(ITY_U64()) != String::from("__VERIFIER_nondet_unsigned_long()") { return 3; }
    if esbmc_nondet_call(ITY_I128()) != String::from("__VERIFIER_nondet_int128()") { return 15; }
    if esbmc_nondet_call(ITY_U128()) != String::from("__VERIFIER_nondet_uint128()") { return 16; }
    if esbmc_nondet_call(ITY_F32()) != String::from("__VERIFIER_nondet_float()") { return 4; }
    if esbmc_nondet_call(ITY_F64()) != String::from("__VERIFIER_nondet_double()") { return 5; }
    if esbmc_nondet_call(ITY_BOOL()) != String::from("__VERIFIER_nondet_bool()") { return 6; }
    if esbmc_nondet_call(ITY_UNIT()) != String::from("0") { return 7; }
    if esbmc_nondet_call(ITY_PTR()) != String::from("0") { return 8; }
    if esbmc_nondet_call(ITY_LPTR()) != String::from("0") { return 9; }
    0
}

fn check_unknown_type_fails_loud() -> i64 {
    let call: String = esbmc_nondet_call(9999);
    if call == String::from("0") { return 10; }
    let expected: String = verifier_harness_str3(
        String::from("__ESBMC_assert(0, \"vow:"),
        verifier_unsupported_op_vow_id_str(),
        String::from("\"")
    );
    if !call.contains(expected) { return 11; }
    0
}

fn check_caller_precondition_sentinel() -> i64 {
    if verifier_caller_precondition_vow_id() != 4294967294 { return 12; }
    if verifier_caller_precondition_vow_id_str() != String::from("4294967294") { return 13; }
    if verifier_caller_precondition_vow_id() != verifier_unsupported_op_vow_id() - 1 { return 14; }
    0
}

fn check_memory_limit_classifier_ignores_echoed_memlimit_option() -> i64 {
    let combined: String = String::from(
        "wrapper: esbmc test.c --memlimit 4096m\nVERIFICATION UNKNOWN\n"
    );
    if output_has_memory_limit(combined) { return 17; }
    0
}

fn check_counterexample_value_names() -> i64 {
    let c_names: Vec<String> = Vec::new();
    c_names.push(String::from("v1"));
    c_names.push(String::from("v2"));
    let c_values: Vec<String> = Vec::new();
    c_values.push(String::from("1"));
    c_values.push(String::from("2"));
    let map_keys: Vec<String> = Vec::new();
    map_keys.push(String::from("v1"));
    let map_vals: Vec<String> = Vec::new();
    map_vals.push(String::from("_esbmc_x"));
    let out_names: Vec<String> = Vec::new();
    let out_values: Vec<String> = Vec::new();

    map_ce_values(c_names, c_values, map_keys, map_vals, out_names, out_values);

    if out_names.len() != 2 { return 18; }
    if out_names[0] != String::from("_esbmc_x") { return 19; }
    if out_names[1] != String::from("$esbmc$v2") { return 20; }
    if out_values[0] != String::from("1") { return 21; }
    if out_values[1] != String::from("2") { return 22; }
    0
}

fn assert_label_output(label: String) -> String {
    let output: String = String::from(
        "[Counterexample]\n\nViolated property:\n  file f.c line 1 column 1 function f\n  "
    );
    output.push_str(label);
    output.push_str(String::from("\n  condition\n\nVERIFICATION FAILED"));
    output
}

fn check_parse_assert_label_maps_known_labels() -> i64 {
    if parse_assert_label(assert_label_output(String::from("vec bounds"))) != String::from("index out of bounds") { return 23; }
    if parse_assert_label(assert_label_output(String::from("string bounds"))) != String::from("index out of bounds") { return 24; }
    if parse_assert_label(assert_label_output(String::from("vec capacity"))) != String::from("vec exceeded the verifier's internal capacity limit") { return 25; }
    if parse_assert_label(assert_label_output(String::from("string capacity"))) != String::from("string exceeded the verifier's internal capacity limit") { return 26; }
    if parse_assert_label(assert_label_output(String::from("hashmap capacity"))) != String::from("hashmap exceeded the verifier's internal capacity limit") { return 27; }
    if parse_assert_label(assert_label_output(String::from("btreemap capacity"))) != String::from("btreemap exceeded the verifier's internal capacity limit") { return 28; }
    if parse_assert_label(assert_label_output(String::from("integer shift count"))) != String::from("shift amount exceeds the operand's bit width") { return 29; }
    if parse_assert_label(assert_label_output(String::from("unwrap-none"))) != String::from("unwrap() called on None") { return 30; }
    0
}

fn check_parse_assert_label_ignores_vow_and_arith() -> i64 {
    if parse_assert_label(assert_label_output(String::from("vow:0"))).len() != 0 { return 31; }
    if parse_assert_label(assert_label_output(String::from("arith:add:0:0:0"))).len() != 0 { return 32; }
    0
}

fn check_parse_assert_label_unknown_label_returns_empty() -> i64 {
    if parse_assert_label(assert_label_output(String::from("some future guard"))).len() != 0 { return 33; }
    0
}

fn check_parse_assert_label_maps_division_by_zero() -> i64 {
    if parse_assert_label(assert_label_output(String::from("division by zero"))) != String::from("division or remainder by zero") { return 34; }
    0
}

fn check_unattributed_sentinel() -> i64 {
    if verifier_unattributed_vow_id() != 4294967293 { return 35; }
    if verifier_unattributed_vow_id() != verifier_caller_precondition_vow_id() - 1 { return 36; }
    0
}

fn main() -> i32 {
    let r1: i64 = check_known_nondet_calls();
    if r1 != 0 { return i64_to_i32_wrap(r1); }
    let r2: i64 = check_unknown_type_fails_loud();
    if r2 != 0 { return i64_to_i32_wrap(r2); }
    let r3: i64 = check_caller_precondition_sentinel();
    if r3 != 0 { return i64_to_i32_wrap(r3); }
    let r4: i64 = check_memory_limit_classifier_ignores_echoed_memlimit_option();
    if r4 != 0 { return i64_to_i32_wrap(r4); }
    let r5: i64 = check_counterexample_value_names();
    if r5 != 0 { return i64_to_i32_wrap(r5); }
    let r6: i64 = check_parse_assert_label_maps_known_labels();
    if r6 != 0 { return i64_to_i32_wrap(r6); }
    let r7: i64 = check_parse_assert_label_ignores_vow_and_arith();
    if r7 != 0 { return i64_to_i32_wrap(r7); }
    let r8: i64 = check_parse_assert_label_unknown_label_returns_empty();
    if r8 != 0 { return i64_to_i32_wrap(r8); }
    let r9: i64 = check_parse_assert_label_maps_division_by_zero();
    if r9 != 0 { return i64_to_i32_wrap(r9); }
    let r10: i64 = check_unattributed_sentinel();
    if r10 != 0 { return i64_to_i32_wrap(r10); }
    0
}
