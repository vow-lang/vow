module TestVcSmt

use vc_term
use vc_smt

fn check_golden_script() -> i64 {
    let ar: VcArena = vc_arena_new();
    let s: SmtScript = vc_script_new();
    vc_script_set_logic(s, String::from("QF_BV"));
    vc_script_set_option(s, String::from(":produce-models"), String::from("true"));
    vc_script_declare_const(s, String::from("p0"), 64);
    vc_script_declare_const(s, String::from("p1"), 64);
    let p0: i64 = vc_tm_var(ar, String::from("p0"));
    let p1: i64 = vc_tm_var(ar, String::from("p1"));
    let sum: i64 = vc_tm_app2(ar, VC_OP_BVADD(), p0, p1);
    vc_script_define_fun(s, String::from("v2"), 64, sum);
    let v2: i64 = vc_tm_var(ar, String::from("v2"));
    let q: i64 = vc_tm_app2(ar, VC_OP_BVSDIV(), v2, p1);
    vc_script_define_fun(s, String::from("v3"), 64, q);
    let v3: i64 = vc_tm_var(ar, String::from("v3"));
    let lt: i64 = vc_tm_app2(ar, VC_OP_BVSLT(), v3, p0);
    vc_script_define_fun(s, String::from("v4"), VC_SORT_BOOL(), lt);
    let v4: i64 = vc_tm_var(ar, String::from("v4"));
    vc_script_assert(s, vc_tm_app1(ar, VC_OP_NOT(), v4));
    vc_script_check_sat(s);
    let names: Vec<String> = Vec::new();
    names.push(String::from("p0"));
    names.push(String::from("p1"));
    vc_script_get_value(s, names);

    let want: String = String::from("(set-logic QF_BV)\n");
    want.push_str(String::from("(set-option :produce-models true)\n"));
    want.push_str(String::from("(declare-const p0 (_ BitVec 64))\n"));
    want.push_str(String::from("(declare-const p1 (_ BitVec 64))\n"));
    want.push_str(String::from("(define-fun v2 () (_ BitVec 64) (bvadd p0 p1))\n"));
    want.push_str(String::from("(define-fun v3 () (_ BitVec 64) (bvsdiv v2 p1))\n"));
    want.push_str(String::from("(define-fun v4 () Bool (bvslt v3 p0))\n"));
    want.push_str(String::from("(assert (not v4))\n"));
    want.push_str(String::from("(check-sat)\n"));
    want.push_str(String::from("(get-value (p0 p1))\n"));
    let got: String = vc_smt_render(ar, s);
    if got != want { return 1; }
    0
}

fn check_constants() -> i64 {
    let ar: VcArena = vc_arena_new();
    let s: SmtScript = vc_script_new();
    // Raw nodes: the writer is under test, not the simplifier that would fold these.
    vc_script_assert(s, vc_arena_push(ar, VC_T_APP(), vc_tm_bv(ar, 64, -1, 0), vc_tm_bv(ar, 64, 7, 0), -1, VC_OP_EQ()));
    vc_script_assert(s, vc_arena_push(ar, VC_T_APP(), vc_tm_bv(ar, 64, -9223372036854775807 - 1, 0), vc_tm_bv(ar, 64, 9223372036854775807, 0), -1, VC_OP_EQ()));
    vc_script_assert(s, vc_tm_bool_const(ar, true));
    vc_script_assert(s, vc_tm_bool_const(ar, false));
    let want: String = String::from("(assert (= #xffffffffffffffff #x0000000000000007))\n");
    want.push_str(String::from("(assert (= #x8000000000000000 #x7fffffffffffffff))\n"));
    want.push_str(String::from("(assert true)\n"));
    want.push_str(String::from("(assert false)\n"));
    if vc_smt_render(ar, s) != want { return 10; }
    0
}

fn check_every_operator_has_a_symbol() -> i64 {
    let ar: VcArena = vc_arena_new();
    let x: i64 = vc_tm_var(ar, String::from("x"));
    let y: i64 = vc_tm_var(ar, String::from("y"));
    let ops: Vec<i64> = Vec::new();
    ops.push(VC_OP_BVSUB());
    ops.push(VC_OP_BVMUL());
    ops.push(VC_OP_BVSREM());
    ops.push(VC_OP_BVAND());
    ops.push(VC_OP_BVOR());
    ops.push(VC_OP_BVXOR());
    ops.push(VC_OP_DISTINCT());
    ops.push(VC_OP_BVSLE());
    ops.push(VC_OP_BVSGT());
    ops.push(VC_OP_BVSGE());
    ops.push(VC_OP_AND());
    ops.push(VC_OP_OR());
    ops.push(VC_OP_BVUDIV());
    ops.push(VC_OP_BVUREM());
    ops.push(VC_OP_BVULT());
    ops.push(VC_OP_BVULE());
    ops.push(VC_OP_BVUGT());
    ops.push(VC_OP_BVUGE());
    ops.push(VC_OP_BVSHL());
    ops.push(VC_OP_BVLSHR());
    ops.push(VC_OP_BVASHR());
    ops.push(VC_OP_BVSADDO());
    ops.push(VC_OP_BVUADDO());
    ops.push(VC_OP_BVSSUBO());
    ops.push(VC_OP_BVUSUBO());
    ops.push(VC_OP_BVSMULO());
    ops.push(VC_OP_BVUMULO());
    let syms: Vec<String> = Vec::new();
    syms.push(String::from("bvsub"));
    syms.push(String::from("bvmul"));
    syms.push(String::from("bvsrem"));
    syms.push(String::from("bvand"));
    syms.push(String::from("bvor"));
    syms.push(String::from("bvxor"));
    syms.push(String::from("distinct"));
    syms.push(String::from("bvsle"));
    syms.push(String::from("bvsgt"));
    syms.push(String::from("bvsge"));
    syms.push(String::from("and"));
    syms.push(String::from("or"));
    syms.push(String::from("bvudiv"));
    syms.push(String::from("bvurem"));
    syms.push(String::from("bvult"));
    syms.push(String::from("bvule"));
    syms.push(String::from("bvugt"));
    syms.push(String::from("bvuge"));
    syms.push(String::from("bvshl"));
    syms.push(String::from("bvlshr"));
    syms.push(String::from("bvashr"));
    syms.push(String::from("bvsaddo"));
    syms.push(String::from("bvuaddo"));
    syms.push(String::from("bvssubo"));
    syms.push(String::from("bvusubo"));
    syms.push(String::from("bvsmulo"));
    syms.push(String::from("bvumulo"));
    let mut i: u64 = 0;
    while i < ops.len() {
        let s: SmtScript = vc_script_new();
        vc_script_assert(s, vc_tm_app2(ar, ops[i], x, y));
        let want: String = String::from("(assert (");
        want.push_str(syms[i]);
        want.push_str(String::from(" x y))\n"));
        if vc_smt_render(ar, s) != want { return 20 + i as i64; }
        i = i + 1;
    }
    0
}

fn check_prefix_is_independent() -> i64 {
    let ar: VcArena = vc_arena_new();
    let s: SmtScript = vc_script_new();
    vc_script_check_sat(s);
    vc_script_set_logic(s, String::from("QF_BV"));
    let c: SmtScript = vc_script_prefix(s, 1);
    vc_script_check_sat(c);
    if vc_smt_render(ar, s) != String::from("(check-sat)\n(set-logic QF_BV)\n") { return 40; }
    if vc_smt_render(ar, c) != String::from("(check-sat)\n(check-sat)\n") { return 41; }
    if vc_smt_render(ar, vc_script_prefix(s, 99)) != vc_smt_render(ar, s) { return 42; }
    let empty: SmtScript = vc_script_prefix(s, 0);
    if empty.kinds.len() != 0 { return 43; }
    0
}

fn check_get_value_without_names_is_omitted() -> i64 {
    let ar: VcArena = vc_arena_new();
    let s: SmtScript = vc_script_new();
    vc_script_check_sat(s);
    vc_script_get_value(s, Vec::new());
    if vc_smt_render(ar, s) != String::from("(check-sat)\n") { return 50; }
    0
}

fn check_unmapped_operator_is_not_a_known_symbol() -> i64 {
    let ar: VcArena = vc_arena_new();
    let x: i64 = vc_tm_var(ar, String::from("x"));
    let s: SmtScript = vc_script_new();
    vc_script_assert(s, vc_tm_app2(ar, -1, x, x));
    let got: String = vc_smt_render(ar, s);
    if got.contains(String::from("(or ")) || got.contains(String::from("(and ")) { return 60; }
    if !got.contains(String::from("vc-unmapped-operator")) { return 61; }
    0
}

fn check_widths_and_extensions() -> i64 {
    let ar: VcArena = vc_arena_new();
    let s: SmtScript = vc_script_new();
    vc_script_declare_const(s, String::from("p0"), 8);
    vc_script_declare_const(s, String::from("p1"), 128);
    let x8: i64 = vc_tm_var(ar, String::from("p0"));
    let x128: i64 = vc_tm_var(ar, String::from("p1"));
    vc_script_assert(s, vc_tm_app2(ar, VC_OP_EQ(), x8, vc_tm_bv(ar, 8, -2, 0)));
    vc_script_assert(s, vc_tm_app2(ar, VC_OP_BVULT(), x128, vc_tm_bv(ar, 128, 1, -9223372036854775807 - 1)));
    vc_script_assert(s, vc_tm_app2(ar, VC_OP_BVULE(), vc_tm_ext(ar, VC_EXT_SIGN(), 120, x8), x128));
    vc_script_assert(s, vc_tm_app2(ar, VC_OP_EQ(), vc_tm_ext(ar, VC_EXT_ZERO(), 24, x8), vc_tm_bv(ar, 32, 255, 0)));
    vc_script_assert(s, vc_tm_app2(ar, VC_OP_EQ(), vc_tm_ext(ar, VC_EXT_LOW(), 16, x128), vc_tm_bv(ar, 16, 65535, 0)));
    vc_script_assert(s, vc_tm_app2(ar, VC_OP_BVASHR(), x8, x8));
    vc_script_assert(s, vc_tm_app1(ar, VC_OP_NOT(), vc_tm_app2(ar, VC_OP_BVSMULO(), x8, x8)));
    let want: String = String::from("(declare-const p0 (_ BitVec 8))\n");
    want.push_str(String::from("(declare-const p1 (_ BitVec 128))\n"));
    want.push_str(String::from("(assert (= p0 #xfe))\n"));
    want.push_str(String::from("(assert (bvult p1 #x80000000000000000000000000000001))\n"));
    want.push_str(String::from("(assert (bvule ((_ sign_extend 120) p0) p1))\n"));
    want.push_str(String::from("(assert (= ((_ zero_extend 24) p0) #x000000ff))\n"));
    want.push_str(String::from("(assert (= ((_ extract 15 0) p1) #xffff))\n"));
    want.push_str(String::from("(assert (bvashr p0 p0))\n"));
    want.push_str(String::from("(assert (not (bvsmulo p0 p0)))\n"));
    if vc_smt_render(ar, s) != want { return 90; }
    0
}

fn check_array_vocabulary() -> i64 {
    let ar: VcArena = vc_arena_new();
    let s: SmtScript = vc_script_new();
    vc_script_declare_const(s, String::from("a"), VC_SORT_ARRAY64());
    vc_script_declare_const(s, String::from("i"), 64);
    vc_script_declare_const(s, String::from("c"), VC_SORT_BOOL());
    let a: i64 = vc_tm_var(ar, String::from("a"));
    let i: i64 = vc_tm_var(ar, String::from("i"));
    let c: i64 = vc_tm_var(ar, String::from("c"));
    let st: i64 = vc_tm_app3(ar, VC_OP_STORE(), a, i, vc_tm_bv(ar, 64, 2, 0));
    vc_script_define_fun(s, String::from("g0"), VC_SORT_ARRAY64(), st);
    let g0: i64 = vc_tm_var(ar, String::from("g0"));
    let merged: i64 = vc_tm_app3(ar, VC_OP_ITE(), c, g0, a);
    vc_script_define_fun(s, String::from("g1"), VC_SORT_ARRAY64(), merged);
    vc_script_assert(s, vc_tm_app2(ar, VC_OP_EQ(), vc_tm_app2(ar, VC_OP_SELECT(), vc_tm_var(ar, String::from("g1")), i), vc_tm_bv(ar, 64, 2, 0)));
    let want: String = String::from("(declare-const a (Array (_ BitVec 64) (_ BitVec 64)))\n");
    want.push_str(String::from("(declare-const i (_ BitVec 64))\n"));
    want.push_str(String::from("(declare-const c Bool)\n"));
    want.push_str(String::from("(define-fun g0 () (Array (_ BitVec 64) (_ BitVec 64)) (store a i #x0000000000000002))\n"));
    want.push_str(String::from("(define-fun g1 () (Array (_ BitVec 64) (_ BitVec 64)) (ite c g0 a))\n"));
    want.push_str(String::from("(assert (= (select g1 i) #x0000000000000002))\n"));
    if vc_smt_render(ar, s) != want { return 100; }
    0
}

fn main() -> i32 {
    let mut r: i64 = check_golden_script();
    if r == 0 { r = check_constants(); }
    if r == 0 { r = check_widths_and_extensions(); }
    if r == 0 { r = check_every_operator_has_a_symbol(); }
    if r == 0 { r = check_array_vocabulary(); }
    if r == 0 { r = check_prefix_is_independent(); }
    if r == 0 { r = check_get_value_without_names_is_omitted(); }
    if r == 0 { r = check_unmapped_operator_is_not_a_known_symbol(); }
    i64_to_i32_wrap(r)
}
