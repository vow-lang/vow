module TestCEmitterArgLayout

use c_emitter

fn main() -> i32 {
    if model_arg_index(String::from("__vow_vec_push_val"), CARG_RECEIVER()) != 0 { return 1; }
    if model_arg_index(String::from("__vow_vec_push_val_in_arena"), CARG_RECEIVER()) != 1 { return 2; }
    if model_arg_index(String::from("__vow_vec_push_val_in_arena"), CARG_VEC_VALUE()) != 2 { return 3; }
    if model_arg_index(String::from("__vow_vec_set_val"), CARG_VEC_VALUE()) != 2 { return 4; }
    if model_arg_index(String::from("__vow_vec_get_val"), CARG_VEC_VALUE()) != -1 { return 5; }
    if model_arg_index(String::from("__vow_string_push_str"), CARG_SECOND_STRING()) != 1 { return 6; }
    if model_arg_index(String::from("__vow_string_push_str_in_arena"), CARG_SECOND_STRING()) != 2 { return 7; }
    if model_arg_index(String::from("__vow_string_substr_in_arena"), CARG_OPERAND(2)) != 3 { return 8; }
    if model_arg_index(String::from("__vow_map_insert_in_arena"), CARG_RECEIVER()) != 1 { return 9; }
    if model_arg_index(String::from("__vow_map_insert_in_arena"), CARG_OPERAND(2)) != 3 { return 10; }
    if model_arg_index(String::from("__vow_map_new_in_arena"), CARG_RECEIVER()) != -1 { return 11; }
    if model_arg_index(String::from("__vow_unknown_in_arena"), CARG_OPERAND(0)) != -1 { return 12; }
    if model_arg_index(String::from("__vow_map_insert"), CARG_MAP_KEY()) != 1 { return 13; }
    if model_arg_index(String::from("__vow_map_insert"), CARG_MAP_VALUE()) != 2 { return 14; }
    if model_arg_index(String::from("__vow_map_insert_in_arena"), CARG_MAP_VALUE()) != 3 { return 15; }
    if model_arg_index(String::from("__vow_map_get_in_arena"), CARG_MAP_KEY()) != 2 { return 16; }
    if model_arg_index(String::from("__vow_map_get"), CARG_MAP_VALUE()) != -1 { return 17; }
    if model_arg_index(String::from("__vow_btreemap_insert"), CARG_MAP_KEY()) != 1 { return 18; }
    if model_arg_index(String::from("__vow_btreemap_insert"), CARG_MAP_VALUE()) != 2 { return 19; }
    if model_arg_index(String::from("__vow_btreemap_get"), CARG_MAP_VALUE()) != -1 { return 20; }
    if model_arg_index(String::from("__vow_btreemap_insert"), CARG_RECEIVER()) != -1 { return 21; }
    0
}
