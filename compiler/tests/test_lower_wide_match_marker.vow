module TestLowerWideMatchMarker

use lexer
use ast
use diag
use parser
use ir
use lower

// Twin of match_arm_marker_renarrows_to_wide_payload_width in
// vow-ir/src/lower/mod.rs: a literal-marker match arm merging with a genuinely
// 128-bit-typed payload arm must re-narrow its Upsilon to the merge width.

fn wide_pick_source() -> String {
    String::from("module WideMatchMarkerLowering\nfn pick(opt: Option<i128>) -> i128 {\n    match opt {\n        Option::Some(v) => v,\n        Option::None => -1,\n    }\n}\n")
}

fn lower_pick() -> IrModule {
    let source: String = wide_pick_source();
    let arena: AstArena = arena_new();
    let parsed: Module = parse_module_into(
        lex(source), arena, diag_ctx_new(), String::from("wide_match_marker.vow")
    );
    let item_files: Vec<String> = Vec::new();
    item_files.push(String::from("wide_match_marker.vow"));
    lower_module_vow(
        parsed, Vec::new(), Vec::new(), Vec::new(), Vec::new(), Vec::new(),
        Vec::new(), Vec::new(), Vec::new(), Vec::new(), Vec::new(), Vec::new(),
        Vec::new(), Vec::new(), Vec::new(), Vec::new(), item_files
    )
}

fn count_phis(m: IrModule, want_ty: i64) -> i64 {
    let function: IrFunction = m.functions[0];
    let mut count: i64 = 0;
    let mut block_index: u64 = 0;
    while block_index < function.blocks.len() {
        let block: IrBlock = function.blocks[block_index];
        let mut inst_index: u64 = 0;
        while inst_index < block.insts.len() {
            let inst: IrInst = block.insts[inst_index];
            if inst.op == IOP_PHI() {
                if inst.ty != want_ty { return -count - 10; }
                count = count + 1;
            }
            inst_index = inst_index + 1;
        }
        block_index = block_index + 1;
    }
    count
}

fn producer_has_ty(m: IrModule, producer_id: i64, want_ty: i64) -> bool {
    let function: IrFunction = m.functions[0];
    let mut block_index: u64 = 0;
    while block_index < function.blocks.len() {
        let block: IrBlock = function.blocks[block_index];
        let mut inst_index: u64 = 0;
        while inst_index < block.insts.len() {
            let inst: IrInst = block.insts[inst_index];
            if inst.id == producer_id {
                return inst.ty == want_ty;
            }
            inst_index = inst_index + 1;
        }
        block_index = block_index + 1;
    }
    false
}

fn upsilon_args_match_phi(m: IrModule) -> bool {
    let function: IrFunction = m.functions[0];
    let phi_ids: Vec<i64> = Vec::new();
    let mut block_index: u64 = 0;
    while block_index < function.blocks.len() {
        let block: IrBlock = function.blocks[block_index];
        let mut inst_index: u64 = 0;
        while inst_index < block.insts.len() {
            let inst: IrInst = block.insts[inst_index];
            if inst.op == IOP_PHI() && inst.ty == ITY_I128() {
                phi_ids.push(inst.id);
            }
            inst_index = inst_index + 1;
        }
        block_index = block_index + 1;
    }
    if phi_ids.len() != 1 { return false; }
    let phi_id: i64 = phi_ids[0];
    let mut upsilon_count: i64 = 0;
    block_index = 0;
    while block_index < function.blocks.len() {
        let block: IrBlock = function.blocks[block_index];
        let mut inst_index: u64 = 0;
        while inst_index < block.insts.len() {
            let inst: IrInst = block.insts[inst_index];
            if inst.op == IOP_UPSILON() && inst.dk == IDATA_PHI_TARGET() && inst.dv == phi_id {
                upsilon_count = upsilon_count + 1;
                let producer_id: i64 = inst.args[0];
                if !producer_has_ty(m, producer_id, ITY_I128()) { return false; }
            }
            inst_index = inst_index + 1;
        }
        block_index = block_index + 1;
    }
    upsilon_count == 2
}

fn module_has_const_i128(m: IrModule) -> bool {
    let function: IrFunction = m.functions[0];
    let mut block_index: u64 = 0;
    while block_index < function.blocks.len() {
        let block: IrBlock = function.blocks[block_index];
        let mut inst_index: u64 = 0;
        while inst_index < block.insts.len() {
            if block.insts[inst_index].op == IOP_CONST_I128() { return true; }
            inst_index = inst_index + 1;
        }
        block_index = block_index + 1;
    }
    false
}

fn main() -> i32 {
    let m: IrModule = lower_pick();
    if m.functions.len() != 1 { return 1; }
    if count_phis(m, ITY_I128()) != 1 { return 2; }
    if !upsilon_args_match_phi(m) { return 3; }
    if !module_has_const_i128(m) { return 4; }
    0
}
