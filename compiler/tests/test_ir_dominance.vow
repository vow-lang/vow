module TestIrDominance

use lexer
use ast
use diag
use parser
use ir
use lower
use ir_dominance
use tests.builders

fn fn_of(blocks: Vec<IrBlock>) -> IrFunction {
    mk_function(0, String::from("f"), Vec::new(), ITY_I64(), blocks)
}

fn insts() -> Vec<IrInst> { Vec::new() }

// Returns 0 when the verdict matches `want_bad`, otherwise `code`.
fn verdict_code(f: IrFunction, want_bad: bool, code: i64) -> i64 {
    let msg: String = ir_non_dominating_read(f);
    let is_bad: bool = msg.len() > 0;
    if is_bad != want_bad {
        return code;
    }
    if is_bad && !msg.contains(SKIP_IR_NON_DOMINATING_READ()) {
        return code + 500;
    }
    0
}

// entry(0): %0=const, branch %0 -> 1, 2 ; 1: then ; 2: else ; 3: merge
fn diamond(then_extra: Vec<IrInst>, else_extra: Vec<IrInst>, merge_extra: Vec<IrInst>) -> IrFunction {
    let b0: Vec<IrInst> = insts();
    b0.push(mk_inst_const_i64(0, 1));
    b0.push(mk_inst_branch(1, 0, 1, 2));
    let b1: Vec<IrInst> = then_extra;
    b1.push(mk_inst_jump(20, 3));
    let b2: Vec<IrInst> = else_extra;
    b2.push(mk_inst_jump(30, 3));
    let b3: Vec<IrInst> = merge_extra;
    b3.push(mk_inst_return(40, 0));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, b0));
    blocks.push(mk_block(1, b1));
    blocks.push(mk_block(2, b2));
    blocks.push(mk_block(3, b3));
    fn_of(blocks)
}

fn check_straight_line() -> i64 {
    let b: Vec<IrInst> = insts();
    b.push(mk_inst_const_i64(0, 1));
    b.push(mk_inst_add(1, 0, 0));
    b.push(mk_inst_return(2, 1));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, b));
    verdict_code(fn_of(blocks), false, 1)
}

fn check_use_before_def() -> i64 {
    let b: Vec<IrInst> = insts();
    b.push(mk_inst_add(1, 0, 0));
    b.push(mk_inst_const_i64(0, 1));
    b.push(mk_inst_return(2, 1));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, b));
    verdict_code(fn_of(blocks), true, 2)
}

fn check_undefined_operand() -> i64 {
    let b: Vec<IrInst> = insts();
    b.push(mk_inst_return(1, 7));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, b));
    let r: i64 = verdict_code(fn_of(blocks), true, 3);
    if r != 0 { return r; }
    let b2: Vec<IrInst> = insts();
    b2.push(mk_inst_return(1, -1));
    let blocks2: Vec<IrBlock> = Vec::new();
    blocks2.push(mk_block(0, b2));
    verdict_code(fn_of(blocks2), true, 4)
}

fn check_empty_function() -> i64 {
    verdict_code(fn_of(Vec::new()), false, 5)
}

fn check_diamond_good() -> i64 {
    let then_i: Vec<IrInst> = insts();
    then_i.push(mk_inst_const_i64(10, 5));
    then_i.push(mk_inst_upsilon(11, 10, 40));
    let else_i: Vec<IrInst> = insts();
    else_i.push(mk_inst_const_i64(12, 6));
    else_i.push(mk_inst_upsilon(13, 12, 40));
    let merge_i: Vec<IrInst> = insts();
    merge_i.push(mk_inst_phi(41, ITY_I64()));
    merge_i.push(mk_inst_add(42, 0, 41));
    let f: IrFunction = diamond(then_i, else_i, merge_i);
    verdict_code(f, false, 10)
}

fn check_sibling_read() -> i64 {
    let then_i: Vec<IrInst> = insts();
    then_i.push(mk_inst_const_i64(10, 5));
    let else_i: Vec<IrInst> = insts();
    else_i.push(mk_inst_add(12, 10, 0));
    verdict_code(diamond(then_i, else_i, insts()), true, 11)
}

fn check_merge_reads_branch_only_def() -> i64 {
    let then_i: Vec<IrInst> = insts();
    then_i.push(mk_inst_const_i64(10, 5));
    let merge_i: Vec<IrInst> = insts();
    merge_i.push(mk_inst_add(42, 10, 0));
    verdict_code(diamond(then_i, insts(), merge_i), true, 12)
}

// else arm returns, so the then-arm def dominates the merge-like block.
fn check_returning_arm_keeps_dominance() -> i64 {
    let b0: Vec<IrInst> = insts();
    b0.push(mk_inst_const_i64(0, 1));
    b0.push(mk_inst_branch(1, 0, 1, 2));
    let b1: Vec<IrInst> = insts();
    b1.push(mk_inst_const_i64(10, 5));
    b1.push(mk_inst_jump(11, 3));
    let b2: Vec<IrInst> = insts();
    b2.push(mk_inst_return(20, 0));
    let b3: Vec<IrInst> = insts();
    b3.push(mk_inst_return(30, 10));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, b0));
    blocks.push(mk_block(1, b1));
    blocks.push(mk_block(2, b2));
    blocks.push(mk_block(3, b3));
    verdict_code(fn_of(blocks), false, 13)
}

// preheader(0) -> header(1) <-> body(2); header -> exit(3)
fn loop_fn(body_extra: Vec<IrInst>, header_extra: Vec<IrInst>, exit_extra: Vec<IrInst>) -> IrFunction {
    let b0: Vec<IrInst> = insts();
    b0.push(mk_inst_const_i64(0, 1));
    b0.push(mk_inst_upsilon(1, 0, 10));
    b0.push(mk_inst_jump(2, 1));
    let b1: Vec<IrInst> = insts();
    b1.push(mk_inst_phi(10, ITY_I64()));
    for_each_push(b1, header_extra);
    b1.push(mk_inst_branch(11, 0, 2, 3));
    let b2: Vec<IrInst> = insts();
    b2.push(mk_inst_add(20, 10, 0));
    for_each_push(b2, body_extra);
    b2.push(mk_inst_upsilon(21, 20, 10));
    b2.push(mk_inst_jump(22, 1));
    let b3: Vec<IrInst> = exit_extra;
    b3.push(mk_inst_return(30, 10));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, b0));
    blocks.push(mk_block(1, b1));
    blocks.push(mk_block(2, b2));
    blocks.push(mk_block(3, b3));
    fn_of(blocks)
}

fn for_each_push(dst: Vec<IrInst>, src: Vec<IrInst>) {
    let mut i: u64 = 0;
    while i < src.len() {
        dst.push(src[i]);
        i = i + 1;
    }
}

fn check_loop_good() -> i64 {
    verdict_code(loop_fn(insts(), insts(), insts()), false, 20)
}

fn check_loop_body_def_read_in_exit() -> i64 {
    let exit_i: Vec<IrInst> = insts();
    exit_i.push(mk_inst_add(31, 20, 0));
    verdict_code(loop_fn(insts(), insts(), exit_i), true, 21)
}

fn check_loop_body_def_read_in_header() -> i64 {
    let header_i: Vec<IrInst> = insts();
    header_i.push(mk_inst_add(12, 20, 0));
    verdict_code(loop_fn(insts(), header_i, insts()), true, 22)
}

// Short-circuit shape: entry branch -> rhs / short -> merge(phi)
fn short_circuit(merge_reads: i64) -> IrFunction {
    let b0: Vec<IrInst> = insts();
    b0.push(mk_inst_const_i64(0, 1));
    b0.push(mk_inst_branch(1, 0, 1, 2));
    let b1: Vec<IrInst> = insts();
    b1.push(mk_inst_const_i64(10, 1));
    b1.push(mk_inst_upsilon(11, 10, 40));
    b1.push(mk_inst_jump(12, 3));
    let b2: Vec<IrInst> = insts();
    b2.push(mk_inst_const_i64(20, 0));
    b2.push(mk_inst_upsilon(21, 20, 40));
    b2.push(mk_inst_jump(22, 3));
    let b3: Vec<IrInst> = insts();
    b3.push(mk_inst_phi(40, ITY_BOOL()));
    b3.push(mk_inst_return(41, merge_reads));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, b0));
    blocks.push(mk_block(1, b1));
    blocks.push(mk_block(2, b2));
    blocks.push(mk_block(3, b3));
    fn_of(blocks)
}

fn check_short_circuit() -> i64 {
    let r: i64 = verdict_code(short_circuit(40), false, 30);
    if r != 0 { return r; }
    verdict_code(short_circuit(10), true, 31)
}

// Match chain: test0 -> arm0 | test1 -> arm1 | arm2 ; arms jump to merge.
fn match_fn(arm1_reads: i64, merge_reads: i64) -> IrFunction {
    let b0: Vec<IrInst> = insts();
    b0.push(mk_inst_const_i64(0, 1));
    b0.push(mk_inst_branch(1, 0, 1, 2));
    let b1: Vec<IrInst> = insts();
    b1.push(mk_inst_const_i64(10, 1));
    b1.push(mk_inst_jump(11, 4));
    let b2: Vec<IrInst> = insts();
    b2.push(mk_inst_branch(20, 0, 3, 4));
    let b3: Vec<IrInst> = insts();
    b3.push(mk_inst_add(30, arm1_reads, 0));
    b3.push(mk_inst_jump(31, 4));
    let b4: Vec<IrInst> = insts();
    b4.push(mk_inst_return(40, merge_reads));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, b0));
    blocks.push(mk_block(1, b1));
    blocks.push(mk_block(2, b2));
    blocks.push(mk_block(3, b3));
    blocks.push(mk_block(4, b4));
    fn_of(blocks)
}

fn check_match() -> i64 {
    let r: i64 = verdict_code(match_fn(0, 0), false, 40);
    if r != 0 { return r; }
    let r2: i64 = verdict_code(match_fn(10, 0), true, 41);
    if r2 != 0 { return r2; }
    verdict_code(match_fn(0, 10), true, 42)
}

fn check_unreachable_blocks() -> i64 {
    let b0: Vec<IrInst> = insts();
    b0.push(mk_inst_const_i64(0, 1));
    b0.push(mk_inst_return(1, 0));
    let dead: Vec<IrInst> = insts();
    dead.push(mk_inst_add(10, 99, 0));
    dead.push(mk_inst_return(11, 10));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, b0));
    blocks.push(mk_block(1, dead));
    let r: i64 = verdict_code(fn_of(blocks), false, 50);
    if r != 0 { return r; }
    let c0: Vec<IrInst> = insts();
    c0.push(mk_inst_jump(1, 2));
    let dead2: Vec<IrInst> = insts();
    dead2.push(mk_inst_const_i64(10, 1));
    dead2.push(mk_inst_return(11, 10));
    let c2: Vec<IrInst> = insts();
    c2.push(mk_inst_return(20, 10));
    let blocks2: Vec<IrBlock> = Vec::new();
    blocks2.push(mk_block(0, c0));
    blocks2.push(mk_block(1, dead2));
    blocks2.push(mk_block(2, c2));
    verdict_code(fn_of(blocks2), true, 51)
}

fn check_vow_and_upsilon_operands() -> i64 {
    let b0: Vec<IrInst> = insts();
    let req_args: Vec<i64> = Vec::new();
    req_args.push(5);
    b0.push(ir_inst_new(1, IOP_VOW_REQ(), ITY_UNIT(), req_args, IDATA_NONE(), 0, 0, String::from("")));
    b0.push(mk_inst_return(2, 1));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, b0));
    let r: i64 = verdict_code(fn_of(blocks), true, 60);
    if r != 0 { return r; }
    let c0: Vec<IrInst> = insts();
    c0.push(mk_inst_upsilon(1, 9, 3));
    c0.push(mk_inst_return(2, 1));
    let blocks2: Vec<IrBlock> = Vec::new();
    blocks2.push(mk_block(0, c0));
    verdict_code(fn_of(blocks2), true, 61)
}

fn check_dangling_branch_target() -> i64 {
    let b0: Vec<IrInst> = insts();
    b0.push(mk_inst_const_i64(0, 1));
    b0.push(mk_inst_branch(1, 0, 7, 99));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, b0));
    verdict_code(fn_of(blocks), false, 70)
}

fn check_non_contiguous_block_ids() -> i64 {
    let b0: Vec<IrInst> = insts();
    b0.push(mk_inst_const_i64(0, 1));
    b0.push(mk_inst_jump(1, 50));
    let b1: Vec<IrInst> = insts();
    b1.push(mk_inst_return(10, 0));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(7, b0));
    blocks.push(mk_block(50, b1));
    verdict_code(fn_of(blocks), false, 71)
}

fn lower_fixture(source: String, file: String) -> IrModule {
    let arena: AstArena = arena_new();
    let parsed: Module = parse_module_into(lex(source), arena, diag_ctx_new(), file);
    let item_files: Vec<String> = Vec::new();
    let mut fi: u64 = 0;
    while fi < parsed.items.len() {
        item_files.push(file);
        fi = fi + 1;
    }
    lower_module_vow(
        parsed, Vec::new(), Vec::new(), Vec::new(), Vec::new(), Vec::new(),
        Vec::new(), Vec::new(), Vec::new(), Vec::new(), Vec::new(), Vec::new(),
        Vec::new(), Vec::new(), Vec::new(), Vec::new(), item_files
    )
}

// 0 when every lowered function is well-formed; otherwise `code` plus the
// offending message on stderr.
fn expect_lowered_clean(source: String, code: i64) -> i64 [io] {
    let m: IrModule = lower_fixture(source, String::from("dom.vow"));
    let mut i: u64 = 0;
    while i < m.functions.len() {
        let f: IrFunction = m.functions[i];
        let msg: String = ir_non_dominating_read(f);
        if msg.len() > 0 {
            print_str(f.name);
            print_str(String::from(": "));
            print_str(msg);
            print_str(String::from("\n"));
            return code;
        }
        i = i + 1;
    }
    0
}

fn check_lowered_if_else() -> i64 [io] {
    let src: String = String::from("fn f(a: i64, b: i64) -> i64 { let mut x: i64 = 0; if a > b { x = a; } else { x = b; } x }\nfn g(a: i64) -> i64 { if a > 0 { 1 } else { 2 } }\nfn main() -> i32 { 0 }\n");
    expect_lowered_clean(src, 80)
}

fn check_lowered_loops() -> i64 [io] {
    let src: String = String::from("fn w(n: i64) -> i64 { let mut i: i64 = 0; let mut s: i64 = 0; while i < n { s = s + i; i = i + 1; } s }\nfn r(n: i64) -> i64 { let mut s: i64 = 0; for i in 0..n { s = s + i; } s }\nfn main() -> i32 { 0 }\n");
    expect_lowered_clean(src, 81)
}

fn check_lowered_short_circuit() -> i64 [io] {
    let src: String = String::from("fn a(x: i64, y: i64) -> bool { x > 0 && y > 0 }\nfn o(x: i64, y: i64) -> bool { x > 0 || y > 0 }\nfn c(x: i64, y: i64) -> i64 { if x > 0 && (y > 0 || x > 5) { 1 } else { 0 } }\nfn main() -> i32 { 0 }\n");
    expect_lowered_clean(src, 82)
}

fn check_lowered_match() -> i64 [io] {
    let src: String = String::from("enum E { A, B, C }\nfn m(e: E) -> i64 { match e { E::A => 1, E::B => 2, E::C => 3 } }\nfn main() -> i32 { 0 }\n");
    expect_lowered_clean(src, 83)
}

fn main() -> i32 [io] {
    let mut r: i64 = check_straight_line();
    if r == 0 { r = check_use_before_def(); }
    if r == 0 { r = check_undefined_operand(); }
    if r == 0 { r = check_empty_function(); }
    if r == 0 { r = check_diamond_good(); }
    if r == 0 { r = check_sibling_read(); }
    if r == 0 { r = check_merge_reads_branch_only_def(); }
    if r == 0 { r = check_returning_arm_keeps_dominance(); }
    if r == 0 { r = check_loop_good(); }
    if r == 0 { r = check_loop_body_def_read_in_exit(); }
    if r == 0 { r = check_loop_body_def_read_in_header(); }
    if r == 0 { r = check_short_circuit(); }
    if r == 0 { r = check_match(); }
    if r == 0 { r = check_unreachable_blocks(); }
    if r == 0 { r = check_vow_and_upsilon_operands(); }
    if r == 0 { r = check_dangling_branch_target(); }
    if r == 0 { r = check_non_contiguous_block_ids(); }
    if r == 0 { r = check_lowered_if_else(); }
    if r == 0 { r = check_lowered_loops(); }
    if r == 0 { r = check_lowered_short_circuit(); }
    if r == 0 { r = check_lowered_match(); }
    i64_to_i32_wrap(r)
}
