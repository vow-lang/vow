module TestVcSolver

use vc_solver

fn names2() -> Vec<String> {
    let v: Vec<String> = Vec::new();
    v.push(String::from("p0"));
    v.push(String::from("p1"));
    v
}

fn w2() -> Vec<i64> {
    let v: Vec<i64> = Vec::new();
    v.push(64);
    v.push(64);
    v
}

fn w1(w: i64) -> Vec<i64> {
    let v: Vec<i64> = Vec::new();
    v.push(w);
    v
}

fn bits(n: u64, one_at: u64) -> String {
    let s: String = String::from("#b");
    let mut i: u64 = 0;
    while i < n {
        if i == one_at { s.push_str(String::from("1")); } else { s.push_str(String::from("0")); }
        i = i + 1;
    }
    s
}

fn check_verdicts() -> i64 {
    if vc_parse_check_sat(String::from("sat\n(\n  (p0 (_ bv1 64))\n)\n")) != VC_ANS_SAT() { return 1; }
    if vc_parse_check_sat(String::from("unsat\n")) != VC_ANS_UNSAT() { return 2; }
    if vc_parse_check_sat(String::from("unknown\n")) != VC_ANS_UNKNOWN() { return 3; }
    if vc_parse_check_sat(String::from("")) != VC_ANS_ERROR() { return 4; }
    if vc_parse_check_sat(String::from("[error] boom\n")) != VC_ANS_ERROR() { return 5; }
    if vc_parse_check_sat(String::from("satisfiable\n")) != VC_ANS_ERROR() { return 6; }
    if vc_parse_check_sat(String::from("garbage\nunsat\n")) != VC_ANS_ERROR() { return 7; }
    if vc_parse_check_sat(String::from("  unsat  \r\n")) != VC_ANS_UNSAT() { return 8; }
    0
}

fn check_multiline_model() -> i64 {
    let out: String = String::from("sat\n(\n  (p0 (_ bv1 64))\n  (p1 (_ bv18446744073709551615 64))\n)\n");
    let m: VcModel = vc_parse_model(out, names2(), w2());
    if m.ok != 1 { return 10; }
    if m.values[0] != 1 { return 11; }
    if m.values[1] != -1 { return 12; }
    0
}

fn check_single_line_model() -> i64 {
    let one: Vec<String> = Vec::new();
    one.push(String::from("p1"));
    let m: VcModel = vc_parse_model(String::from("sat\n((p1 (_ bv9223372036854775808 64)))\n"), one, w1(64));
    if m.ok != 1 { return 20; }
    if m.values[0] != -9223372036854775807 - 1 { return 21; }
    0
}

fn check_binary_and_hex() -> i64 {
    let out: String = String::from("sat\n((p0 ");
    out.push_str(bits(64, 63));
    out.push_str(String::from(") (p1 #xffffffffffffffff))\n"));
    let m: VcModel = vc_parse_model(out, names2(), w2());
    if m.ok != 1 { return 30; }
    if m.values[0] != 1 { return 31; }
    if m.values[1] != -1 { return 32; }
    let top: String = String::from("sat\n((p0 ");
    top.push_str(bits(64, 0));
    top.push_str(String::from(") (p1 #x7fffffffffffffff))\n"));
    let t: VcModel = vc_parse_model(top, names2(), w2());
    if t.ok != 1 { return 33; }
    if t.values[0] != -9223372036854775807 - 1 { return 34; }
    if t.values[1] != 9223372036854775807 { return 35; }
    0
}

fn check_name_prefix_is_not_confused() -> i64 {
    let ns: Vec<String> = Vec::new();
    ns.push(String::from("p1"));
    let m: VcModel = vc_parse_model(String::from("sat\n((p10 (_ bv5 64)))\n"), ns, w1(64));
    if m.ok != 0 { return 40; }
    0
}

fn check_incomplete_or_malformed_is_not_ok() -> i64 {
    let missing: VcModel = vc_parse_model(String::from("sat\n((p0 (_ bv1 64)))\n"), names2(), w2());
    if missing.ok != 0 { return 50; }
    let ns: Vec<String> = Vec::new();
    ns.push(String::from("p0"));
    if vc_parse_model(String::from("sat\n((p0 (_ bv1 32)))\n"), ns, w1(64)).ok != 0 { return 51; }
    if vc_parse_model(String::from("sat\n((p0 (_ bv99999999999999999999 64)))\n"), ns, w1(64)).ok != 0 { return 52; }
    if vc_parse_model(String::from("sat\n((p0 #b101))\n"), ns, w1(64)).ok != 0 { return 53; }
    if vc_parse_model(String::from("sat\n((p0 #xff))\n"), ns, w1(64)).ok != 0 { return 54; }
    if vc_parse_model(String::from("sat\n((p0 true))\n"), ns, w1(64)).ok != 0 { return 55; }
    if vc_parse_model(String::from("sat\n((p0 (_ bv 64)))\n"), ns, w1(64)).ok != 0 { return 56; }
    if vc_parse_model(String::from("sat\n"), ns, w1(64)).ok != 0 { return 57; }
    if vc_parse_model(String::from(""), ns, w1(64)).ok != 0 { return 58; }
    0
}

fn none_w() -> Vec<i64> {
    Vec::new()
}

fn check_classify_run() -> i64 {
    let none: Vec<String> = Vec::new();
    let ns: Vec<String> = Vec::new();
    ns.push(String::from("p0"));
    let sat: String = String::from("sat\n((p0 (_ bv5 64)))\n");
    let a: VcSolverAnswer = vc_classify_run(0, sat, String::from(""), ns, w1(64));
    if a.verdict != VC_ANS_SAT() { return 80; }
    if a.values[0] != 5 { return 81; }
    if vc_classify_run(0, String::from("unsat\n"), String::from(""), none, none_w()).verdict != VC_ANS_UNSAT() { return 82; }
    if vc_classify_run(0, String::from("unknown\n"), String::from(""), none, none_w()).verdict != VC_ANS_UNKNOWN() { return 83; }
    if vc_classify_run(-2, String::from(""), String::from(""), none, none_w()).verdict != VC_ANS_TIMEOUT() { return 84; }
    if vc_classify_run(1, String::from("unsat\n"), String::from(""), none, none_w()).verdict != VC_ANS_ERROR() { return 85; }
    if vc_classify_run(-1, String::from("unsat\n"), String::from(""), none, none_w()).verdict != VC_ANS_ERROR() { return 86; }
    if vc_classify_run(0, String::from("unsat\n"), String::from("[error] boom\n"), none, none_w()).verdict != VC_ANS_ERROR() { return 87; }
    if vc_classify_run(0, String::from("sat\n"), String::from(""), ns, w1(64)).verdict != VC_ANS_ERROR() { return 88; }
    if vc_classify_run(0, String::from("gibberish"), String::from(""), none, none_w()).verdict != VC_ANS_ERROR() { return 89; }
    if vc_classify_run(1, String::from(""), String::from("(error) Out of memory\n"), none, none_w()).verdict != VC_ANS_MEMORY() { return 90; }
    if vc_classify_run(-1, String::from(""), String::from("terminate: std::bad_alloc\n"), none, none_w()).verdict != VC_ANS_MEMORY() { return 91; }
    if vc_classify_run(0, String::from("unsat\n"), String::from("Out of memory\n"), none, none_w()).verdict != VC_ANS_UNSAT() { return 92; }
    0
}

fn check_wide_and_narrow_widths() -> i64 {
    let ns: Vec<String> = Vec::new();
    ns.push(String::from("p0"));
    let wide: VcModel = vc_parse_model(String::from("sat\n((p0 #x80000000000000000000000000000001))\n"), ns, w1(128));
    if wide.ok != 1 { return 100; }
    if wide.values[0] != 1 { return 101; }
    if wide.highs[0] != -9223372036854775807 - 1 { return 102; }
    let n8: VcModel = vc_parse_model(String::from("sat\n((p0 #xfe))\n"), ns, w1(8));
    if n8.ok != 1 { return 103; }
    if n8.values[0] != 254 { return 104; }
    let b8: VcModel = vc_parse_model(String::from("sat\n((p0 #b10000001))\n"), ns, w1(8));
    if b8.ok != 1 { return 105; }
    if b8.values[0] != 129 { return 106; }
    let b128: String = String::from("sat\n((p0 #b1");
    let mut i: u64 = 0;
    while i < 127 { b128.push_str(String::from("0")); i = i + 1; }
    b128.push_str(String::from("))\n"));
    let bm: VcModel = vc_parse_model(b128, ns, w1(128));
    if bm.ok != 1 { return 107; }
    if bm.values[0] != 0 { return 108; }
    if bm.highs[0] != -9223372036854775807 - 1 { return 109; }
    if vc_parse_model(String::from("sat\n((p0 #xfe))\n"), ns, w1(16)).ok != 0 { return 110; }
    if vc_parse_model(String::from("sat\n((p0 #xffffffffffffffff))\n"), ns, w1(128)).ok != 0 { return 111; }
    if vc_parse_model(String::from("sat\n((p0 (_ bv5 8)))\n"), ns, w1(8)).values[0] != 5 { return 112; }
    if vc_parse_model(String::from("sat\n((p0 (_ bv5 128)))\n"), ns, w1(128)).ok != 0 { return 113; }
    0
}

fn check_bool_literals() -> i64 {
    let ns: Vec<String> = Vec::new();
    ns.push(String::from("p0f1s0"));
    let t: VcModel = vc_parse_model(String::from("sat\n((p0f1s0 true))\n"), ns, w1(0));
    if t.ok != 1 { return 120; }
    if t.values[0] != 1 { return 121; }
    let f: VcModel = vc_parse_model(String::from("sat\n((p0f1s0 false))\n"), ns, w1(0));
    if f.ok != 1 { return 122; }
    if f.values[0] != 0 { return 123; }
    if vc_parse_model(String::from("sat\n((p0f1s0 #b1))\n"), ns, w1(0)).ok != 0 { return 124; }
    if vc_parse_model(String::from("sat\n((p0f1s0 (_ bv1 1)))\n"), ns, w1(0)).ok != 0 { return 125; }
    if vc_parse_model(String::from("sat\n((p0f1s0 truex))\n"), ns, w1(0)).ok != 0 { return 126; }
    if vc_parse_model(String::from("sat\n((p0f1s0 true))\n"), ns, w1(8)).ok != 0 { return 127; }
    if vc_parse_model(String::from("sat\n((p0f1s0 #b00000001))\n"), ns, w1(8)).values[0] != 1 { return 128; }
    let two: Vec<String> = Vec::new();
    two.push(String::from("p0f0s64"));
    two.push(String::from("p0f1s0"));
    let ws: Vec<i64> = Vec::new();
    ws.push(64);
    ws.push(0);
    let m: VcModel = vc_parse_model(String::from("sat\n(\n  (p0f0s64 (_ bv7 64))\n  (p0f1s0 true)\n)\n"), two, ws);
    if m.ok != 1 { return 129; }
    if m.values[0] != 7 { return 130; }
    if m.values[1] != 1 { return 131; }
    0
}

fn fp_model(text: String, sort: i64) -> VcModel {
    let ns: Vec<String> = Vec::new();
    ns.push(String::from("p0"));
    let out: String = String::from("sat\n((p0 ");
    out.push_str(text);
    out.push_str(String::from("))\n"));
    vc_parse_model(out, ns, w1(sort))
}

fn check_float_literals() -> i64 {
    let f64: i64 = VC_SORT_F64();
    let f32: i64 = VC_SORT_F32();
    let one: VcModel = fp_model(String::from("(fp #b0 #b01111111111 #b0000000000000000000000000000000000000000000000000000)"), f64);
    if one.ok != 1 || one.values[0] != 4607182418800017408 || one.highs[0] != 0 { return 1; }
    let neg_zero: VcModel = fp_model(String::from("(fp #b1 #b00000000000 #b0000000000000000000000000000000000000000000000000000)"), f64);
    if neg_zero.ok != 1 || neg_zero.values[0] != -9223372036854775807 - 1 { return 2; }
    let nan: VcModel = fp_model(String::from("(fp #b0 #b11111111111 #b1000000000000000000000000000000000000000000000000000)"), f64);
    if nan.ok != 1 || nan.values[0] != 9221120237041090560 { return 3; }
    let ninf: VcModel = fp_model(String::from("(fp #b1 #b11111111111 #b0000000000000000000000000000000000000000000000000000)"), f64);
    if ninf.ok != 1 || ninf.values[0] != -4503599627370496 { return 4; }
    let sub: VcModel = fp_model(String::from("(fp #b0 #b00000000000 #b0000000000000000000000000000000000000000000000000001)"), f64);
    if sub.ok != 1 || sub.values[0] != 1 { return 5; }
    let half: VcModel = fp_model(String::from("(fp #b0 #b01111110 #b00000000000000000000000)"), f32);
    if half.ok != 1 || half.values[0] != 1056964608 { return 6; }
    let f32nan: VcModel = fp_model(String::from("(fp #b0 #b11111111 #b10000000000000000000000)"), f32);
    if f32nan.ok != 1 || f32nan.values[0] != 2143289344 { return 7; }
    let f32neg: VcModel = fp_model(String::from("(fp #b1 #b00000000 #b00000000000000000000000)"), f32);
    if f32neg.ok != 1 || f32neg.values[0] != 2147483648 { return 8; }
    // Spaced as the solver prints a model: a literal ends at whitespace or `)`.
    let multi: VcModel = vc_parse_model(String::from("sat\n(\n  (p0 (fp #b0 #b10000000 #b00000000000000000000000))\n)\n"), ns1(), w1(f32));
    if multi.ok != 1 || multi.values[0] != 1073741824 { return 9; }
    0
}

fn ns1() -> Vec<String> {
    let ns: Vec<String> = Vec::new();
    ns.push(String::from("p0"));
    ns
}

// A malformed float literal is an error (fail closed), never a value.
fn check_float_literals_fail_closed() -> i64 {
    let f64: i64 = VC_SORT_F64();
    let f32: i64 = VC_SORT_F32();
    // Wrong field widths: a f32 literal for an f64 symbol and the reverse.
    if fp_model(String::from("(fp #b0 #b01111110 #b00000000000000000000000)"), f64).ok != 0 { return 20; }
    if fp_model(String::from("(fp #b0 #b01111111111 #b0000000000000000000000000000000000000000000000000000)"), f32).ok != 0 { return 21; }
    // A bit-vector literal, the special-value spellings, hex digits, truncation.
    if fp_model(String::from("#x3f800000"), f32).ok != 0 { return 22; }
    if fp_model(String::from("(_ NaN 8 24)"), f32).ok != 0 { return 23; }
    if fp_model(String::from("(_ +zero 11 53)"), f64).ok != 0 { return 24; }
    if fp_model(String::from("(fp #x0 #b01111110 #b00000000000000000000000)"), f32).ok != 0 { return 25; }
    if fp_model(String::from("(fp #b0 #b01111110"), f32).ok != 0 { return 26; }
    if fp_model(String::from("(fp #b0 #b01111110 #b00000000000000000000000 #b0)"), f32).ok != 0 { return 27; }
    if fp_model(String::from("(fp #b0 #b01111110 #b000000000000000000000002)"), f32).ok != 0 { return 28; }
    if fp_model(String::from("(fpx #b0 #b01111110 #b00000000000000000000000)"), f32).ok != 0 { return 29; }
    0
}

fn main() -> i32 {
    let mut r: i64 = check_verdicts();
    if r == 0 { r = check_float_literals(); }
    if r == 0 { r = check_float_literals_fail_closed(); }
    if r == 0 { r = check_multiline_model(); }
    if r == 0 { r = check_single_line_model(); }
    if r == 0 { r = check_binary_and_hex(); }
    if r == 0 { r = check_name_prefix_is_not_confused(); }
    if r == 0 { r = check_incomplete_or_malformed_is_not_ok(); }
    if r == 0 { r = check_classify_run(); }
    if r == 0 { r = check_wide_and_narrow_widths(); }
    if r == 0 { r = check_bool_literals(); }
    i64_to_i32_wrap(r)
}
