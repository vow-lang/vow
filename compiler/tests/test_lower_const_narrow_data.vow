module TestLowerConstNarrowData

use lexer
use ast
use diag
use parser
use ir
use lower

// Twin of const_idents_lower_to_their_declared_width in vow-ir/src/lower/mod.rs:
// the stored constant data must be normalised identically by both compilers.

fn check_narrow_const_bits() -> i64 {
    if narrow_const_bits(4294967295, ITY_U32()) != -1 { return 1; }
    if narrow_const_bits(3000000000, ITY_U32()) != -1294967296 { return 2; }
    if narrow_const_bits(2147483647, ITY_I32()) != 2147483647 { return 3; }
    if narrow_const_bits(2147483648, ITY_U32()) != -2147483648 { return 4; }
    if narrow_const_bits(65535, ITY_U16()) != 65535 { return 5; }
    if narrow_const_bits(-2, ITY_I16()) != -2 { return 6; }
    if narrow_const_bits(-1, ITY_I8()) != 255 { return 7; }
    if narrow_const_bits(255, ITY_U8()) != 255 { return 8; }
    if narrow_const_bits(-128, ITY_I8()) != 128 { return 9; }
    if narrow_const_bits(256, ITY_U8()) != 0 { return 10; }
    0
}

fn expect_const_fn(m: IrModule, fi: u64, ty: i64, dk: i64, dv: i64, dv2: i64, code: i64) -> i64 {
    let function: IrFunction = m.functions[fi];
    if function.blocks.len() != 1 { return code; }
    let block: IrBlock = function.blocks[0];
    if block.insts.len() != 2 { return code + 1; }
    let inst: IrInst = block.insts[0];
    if inst.ty != ty { return code + 2; }
    if inst.dk != dk { return code + 3; }
    if inst.dv != dv { return code + 4; }
    if inst.dv2 != dv2 { return code + 5; }
    0
}

fn check_lowered_const_data() -> i64 {
    let source: String = String::from("");
    source.push_str("module ConstData\n");
    source.push_str("const A: u64 = 18446744073709551615;\n");
    source.push_str("const B: i8 = -1;\n");
    source.push_str("const C: u32 = 4294967295;\n");
    source.push_str("const D: i128 = -18446744073709551625;\n");
    source.push_str("const E: u128 = 55340232221128654855;\n");
    source.push_str("const F: i16 = -2;\n");
    source.push_str("const G: u16 = 65535;\n");
    source.push_str("const H: u8 = 255;\n");
    source.push_str("fn a() -> u64 { A }\n");
    source.push_str("fn b() -> i8 { B }\n");
    source.push_str("fn c() -> u32 { C }\n");
    source.push_str("fn d() -> i128 { D }\n");
    source.push_str("fn e() -> u128 { E }\n");
    source.push_str("fn f() -> i16 { F }\n");
    source.push_str("fn g() -> u16 { G }\n");
    source.push_str("fn h() -> u8 { H }\n");
    source.push_str("fn lc() -> u32 { let x: u32 = 4294967295; x }\n");
    source.push_str("fn lg() -> u16 { let x: u16 = 65535; x }\n");
    let arena: AstArena = arena_new();
    let parsed: Module = parse_module_into(
        lex(source), arena, diag_ctx_new(), String::from("const_data.vow")
    );
    let item_files: Vec<String> = Vec::new();
    let mut item_i: u64 = 0;
    while item_i < parsed.items.len() {
        item_files.push(String::from("const_data.vow"));
        item_i = item_i + 1;
    }
    let lowered: IrModule = lower_module_vow(
        parsed, Vec::new(), Vec::new(), Vec::new(), Vec::new(), Vec::new(),
        Vec::new(), Vec::new(), Vec::new(), Vec::new(), Vec::new(), Vec::new(),
        Vec::new(), Vec::new(), Vec::new(), Vec::new(), item_files
    );
    if lowered.functions.len() != 10 { return 20; }

    let mut r: i64 = expect_const_fn(lowered, 0, ITY_U64(), IDATA_CONST_U64(), -1, 0, 30);
    if r == 0 { r = expect_const_fn(lowered, 1, ITY_I8(), IDATA_CONST_U8(), 255, 0, 40); }
    if r == 0 { r = expect_const_fn(lowered, 2, ITY_U32(), IDATA_CONST_I32(), -1, 0, 50); }
    if r == 0 { r = expect_const_fn(lowered, 3, ITY_I128(), IDATA_CONST_I128(), -9, -2, 60); }
    if r == 0 { r = expect_const_fn(lowered, 4, ITY_U128(), IDATA_CONST_U128(), 7, 3, 70); }
    if r == 0 { r = expect_const_fn(lowered, 5, ITY_I16(), IDATA_CONST_I32(), -2, 0, 80); }
    if r == 0 { r = expect_const_fn(lowered, 6, ITY_U16(), IDATA_CONST_I32(), 65535, 0, 90); }
    if r == 0 { r = expect_const_fn(lowered, 7, ITY_U8(), IDATA_CONST_U8(), 255, 0, 100); }
    if r == 0 { r = expect_const_fn(lowered, 8, ITY_U32(), IDATA_CONST_I32(), -1, 0, 110); }
    if r == 0 { r = expect_const_fn(lowered, 9, ITY_U16(), IDATA_CONST_I32(), 65535, 0, 120); }
    r
}

fn main() -> i32 {
    let r1: i64 = check_narrow_const_bits();
    if r1 != 0 { return i64_to_i32_wrap(r1); }
    let r2: i64 = check_lowered_const_data();
    if r2 != 0 { return i64_to_i32_wrap(r2); }
    0
}
