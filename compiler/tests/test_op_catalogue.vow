module TestOpCatalogue

use ast
use ir
use lower

fn expect_extern(name: String, want: String, code: i64) -> i64 {
    if builtin_to_extern(name) != want { return code; }
    0
}

fn expect_ret_ty(name: String, want: i64, code: i64) -> i64 {
    if builtin_ret_ty(name) != want { return code; }
    0
}

fn check_print_ops() -> i64 {
    let mut r: i64 = expect_extern(String::from("print_str"), String::from("__vow_string_print"), 1);
    if r == 0 { r = expect_extern(String::from("print_i64"), String::from("__vow_print_i64"), 2); }
    if r == 0 { r = expect_extern(String::from("print_u64"), String::from("__vow_print_u64"), 3); }
    if r == 0 { r = expect_ret_ty(String::from("print_str"), ITY_UNIT(), 4); }
    if r == 0 { r = expect_ret_ty(String::from("print_i64"), ITY_UNIT(), 5); }
    if r == 0 { r = expect_ret_ty(String::from("print_u64"), ITY_UNIT(), 6); }
    r
}

fn check_process_externs() -> i64 {
    let mut r: i64 = expect_extern(String::from("process_exit"), String::from("__vow_process_exit"), 10);
    if r == 0 { r = expect_extern(String::from("process_run"), String::from("__vow_process_run"), 11); }
    if r == 0 { r = expect_extern(String::from("process_get_stdout"), String::from("__vow_process_get_stdout"), 12); }
    if r == 0 { r = expect_extern(String::from("process_get_stderr"), String::from("__vow_process_get_stderr"), 13); }
    if r == 0 { r = expect_extern(String::from("process_start"), String::from("__vow_process_start"), 14); }
    if r == 0 { r = expect_extern(String::from("process_wait"), String::from("__vow_process_wait"), 15); }
    if r == 0 { r = expect_extern(String::from("process_wait_timeout"), String::from("__vow_process_wait_timeout"), 16); }
    if r == 0 { r = expect_extern(String::from("process_poll_wait"), String::from("__vow_process_poll_wait"), 17); }
    if r == 0 { r = expect_extern(String::from("process_kill"), String::from("__vow_process_kill"), 18); }
    if r == 0 { r = expect_extern(String::from("process_stdout_for"), String::from("__vow_process_stdout_for"), 19); }
    if r == 0 { r = expect_extern(String::from("process_stderr_for"), String::from("__vow_process_stderr_for"), 20); }
    if r == 0 { r = expect_extern(String::from("process_start_piped"), String::from("__vow_process_start_piped"), 21); }
    if r == 0 { r = expect_extern(String::from("process_write_stdin"), String::from("__vow_process_write_stdin"), 22); }
    if r == 0 { r = expect_extern(String::from("process_close_stdin"), String::from("__vow_process_close_stdin"), 23); }
    if r == 0 { r = expect_extern(String::from("process_read_line"), String::from("__vow_process_read_line"), 24); }
    if r == 0 { r = expect_extern(String::from("process_read_status"), String::from("__vow_process_read_status"), 25); }
    r
}

fn check_process_ret_tys() -> i64 {
    let mut r: i64 = expect_ret_ty(String::from("process_exit"), ITY_UNIT(), 30);
    if r == 0 { r = expect_ret_ty(String::from("process_run"), ITY_I64(), 31); }
    if r == 0 { r = expect_ret_ty(String::from("process_get_stdout"), ITY_PTR(), 32); }
    if r == 0 { r = expect_ret_ty(String::from("process_get_stderr"), ITY_PTR(), 33); }
    if r == 0 { r = expect_ret_ty(String::from("process_start"), ITY_I64(), 34); }
    if r == 0 { r = expect_ret_ty(String::from("process_wait"), ITY_I64(), 35); }
    if r == 0 { r = expect_ret_ty(String::from("process_wait_timeout"), ITY_I64(), 36); }
    if r == 0 { r = expect_ret_ty(String::from("process_poll_wait"), ITY_I64(), 37); }
    if r == 0 { r = expect_ret_ty(String::from("process_kill"), ITY_I64(), 38); }
    if r == 0 { r = expect_ret_ty(String::from("process_stdout_for"), ITY_PTR(), 39); }
    if r == 0 { r = expect_ret_ty(String::from("process_stderr_for"), ITY_PTR(), 40); }
    if r == 0 { r = expect_ret_ty(String::from("process_start_piped"), ITY_I64(), 41); }
    if r == 0 { r = expect_ret_ty(String::from("process_write_stdin"), ITY_I64(), 42); }
    if r == 0 { r = expect_ret_ty(String::from("process_close_stdin"), ITY_I64(), 43); }
    if r == 0 { r = expect_ret_ty(String::from("process_read_line"), ITY_PTR(), 44); }
    if r == 0 { r = expect_ret_ty(String::from("process_read_status"), ITY_I64(), 45); }
    r
}

fn check_hash_ops() -> i64 {
    let mut r: i64 = expect_extern(String::from("hash_u64"), String::from("__vow_hash_u64"), 60);
    if r == 0 { r = expect_extern(String::from("hash_str"), String::from("__vow_hash_str"), 61); }
    if r == 0 { r = expect_ret_ty(String::from("hash_u64"), ITY_U64(), 62); }
    if r == 0 { r = expect_ret_ty(String::from("hash_str"), ITY_U64(), 63); }
    if r == 0 && builtin_result_tag(String::from("hash_str")) != BRT_NONE() { r = 64; }
    r
}

fn check_env_ops() -> i64 {
    let mut r: i64 = expect_extern(String::from("fs_read_status"), String::from("__vow_fs_read_status"), 70);
    if r == 0 { r = expect_extern(String::from("getenv"), String::from("__vow_getenv"), 71); }
    if r == 0 { r = expect_extern(String::from("path_lookup"), String::from("__vow_path_lookup"), 72); }
    if r == 0 { r = expect_extern(String::from("mktemp_dir"), String::from("__vow_mktemp_dir"), 73); }
    if r == 0 { r = expect_ret_ty(String::from("fs_read_status"), ITY_I64(), 74); }
    if r == 0 { r = expect_ret_ty(String::from("getenv"), ITY_PTR(), 75); }
    if r == 0 { r = expect_ret_ty(String::from("path_lookup"), ITY_PTR(), 76); }
    if r == 0 { r = expect_ret_ty(String::from("mktemp_dir"), ITY_PTR(), 77); }
    if r == 0 && builtin_result_tag(String::from("fs_read_status")) != BRT_NONE() { r = 78; }
    r
}

// The StringHeap-tagged process_* names are already pinned by
// check_string_rows in test_lower_builtin_result_tag.vow; this only covers
// the untagged ones, which aren't asserted anywhere else.
fn check_process_result_tags() -> i64 {
    let mut r: i64 = 0;
    if builtin_result_tag(String::from("process_exit")) != BRT_NONE() { r = 54; }
    if r == 0 && builtin_result_tag(String::from("process_run")) != BRT_NONE() { r = 55; }
    r
}

// The query and utility builtins (#1271) resolve through the generated
// catalogue lookups: the extern symbol and the IR return type of each come from
// docs/spec/operations.json, not from a hand-written table in lower.vow.
fn expect_catalogued(name: String, sym: String, ret: i64, code: i64) -> i64 {
    if catalogue_builtin_to_extern(name) != sym { return code; }
    if catalogue_builtin_ret_ty(name) != ret { return code + 1; }
    if builtin_to_extern(name) != sym { return code + 2; }
    if builtin_ret_ty(name) != ret { return code + 3; }
    0
}

fn check_query_utility_rows_0() -> i64 {
    let mut r: i64 = 0;
    if r == 0 { r = expect_catalogued(String::from("memory_root_arena_bytes"), String::from("__vow_memory_root_arena_bytes"), ITY_U64(), 200); }
    if r == 0 { r = expect_catalogued(String::from("memory_peak_bytes"), String::from("__vow_memory_peak_bytes"), ITY_U64(), 204); }
    if r == 0 { r = expect_catalogued(String::from("memory_alloc_count_since_start"), String::from("__vow_memory_alloc_count_since_start"), ITY_U64(), 208); }
    if r == 0 { r = expect_catalogued(String::from("time_unix"), String::from("__vow_time_unix"), ITY_I64(), 212); }
    if r == 0 { r = expect_catalogued(String::from("time_unix_ms"), String::from("__vow_time_unix_ms"), ITY_I64(), 216); }
    if r == 0 { r = expect_catalogued(String::from("time_micros"), String::from("__vow_time_micros"), ITY_I64(), 220); }
    if r == 0 { r = expect_catalogued(String::from("num_cpus"), String::from("__vow_num_cpus"), ITY_I64(), 224); }
    if r == 0 { r = expect_catalogued(String::from("proc_sample"), String::from("__vow_proc_sample"), ITY_PTR(), 228); }
    if r == 0 { r = expect_catalogued(String::from("gzip_write_file"), String::from("__vow_gzip_write_file"), ITY_I64(), 232); }
    r
}

