    let mut r: i64 = 0;
    if r == 0 { r = expect_catalogued(String::from("hex_encode"), String::from("__vow_hex_encode"), ITY_PTR(), 236); }
    if r == 0 { r = expect_catalogued(String::from("hex_decode"), String::from("__vow_hex_decode"), ITY_PTR(), 240); }
    if r == 0 { r = expect_catalogued(String::from("parse_i64"), String::from("__vow_string_parse_i64_opt"), ITY_PTR(), 244); }
    if r == 0 { r = expect_catalogued(String::from("parse_i8"), String::from("__vow_string_parse_i8_opt"), ITY_PTR(), 248); }
    if r == 0 { r = expect_catalogued(String::from("parse_i16"), String::from("__vow_string_parse_i16_opt"), ITY_PTR(), 252); }
    if r == 0 { r = expect_catalogued(String::from("parse_i32"), String::from("__vow_string_parse_i32_opt"), ITY_PTR(), 256); }
    if r == 0 { r = expect_catalogued(String::from("parse_i128"), String::from("__vow_string_parse_i128_opt"), ITY_PTR(), 260); }
