fn main() -> i32 {
    let mut r: i64 = check_print_ops();
    if r == 0 { r = check_process_externs(); }
    if r == 0 { r = check_process_ret_tys(); }
    if r == 0 { r = check_process_result_tags(); }
    if r == 0 { r = check_hash_ops(); }
    if r == 0 { r = check_env_ops(); }
    if r == 0 { r = check_query_utility_rows_0(); }
    if r == 0 { r = check_query_utility_rows_1(); }
    if r == 0 { r = check_query_utility_rows_2(); }
    if r == 0 { r = check_query_utility_rows_3(); }
    if r == 0 { r = check_i64_to_string_alias(); }
    if r == 0 { r = check_query_utility_result_tags(); }
    i64_to_i32_wrap(r)
}
