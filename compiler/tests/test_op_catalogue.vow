module TestOpCatalogue

use ast
use ir
use lower
use tests.catalogue_facts

// Ties the Operation Catalogue (docs/spec/operations.json, via the generated
// compiler/tests/catalogue_facts.vow) to the self-hosted lowering lookups:
// for every catalogued op, builtin_to_extern / builtin_ret_ty and their
// generated catalogue_* halves must return the catalogued runtime symbol and
// return type. Result tags are covered the same way by
// test_lower_catalogue_result_tags.vow. The Rust twin is
// `every_catalogue_op_lowers_to_its_runtime_symbol_and_return_type` in
// vow-ir/src/lower/mod.rs; both read the same generated columns.

// ITY code of a catalogue return token, -2 for an unknown token.
fn ret_token_ity(token: String) -> i64 {
    if token == String::from("unit") { return ITY_UNIT(); }
    if token == String::from("i64") { return ITY_I64(); }
    if token == String::from("u64") { return ITY_U64(); }
    if token == String::from("ptr") { return ITY_PTR(); }
    if token == String::from("bool") { return ITY_BOOL(); }
    -2
}

fn lowering_problem(out: Vec<String>, name: String, what: String) {
    let line: String = String::from("'");
    line.push_str(name);
    line.push_str(String::from("': "));
    line.push_str(what);
    out.push(line);
}

fn fact_lowering_problems(f: OpFact, out: Vec<String>) {
    let name: String = f.name;
    let symbol: String = f.symbol;
    let want_ret: i64 = ret_token_ity(f.ret);
    if want_ret == -2 { lowering_problem(out, name, String::from("unknown return token in the fact table")); }
    if catalogue_builtin_to_extern(name) != symbol {
        lowering_problem(out, name, String::from("catalogue_builtin_to_extern differs from the catalogue runtime symbol"));
    }
    if builtin_to_extern(name) != symbol {
        lowering_problem(out, name, String::from("builtin_to_extern differs from the catalogue runtime symbol"));
    }
    if catalogue_builtin_ret_ty(name) != want_ret {
        lowering_problem(out, name, String::from("catalogue_builtin_ret_ty differs from the catalogue return type"));
    }
    if builtin_ret_ty(name) != want_ret {
        lowering_problem(out, name, String::from("builtin_ret_ty differs from the catalogue return type"));
    }
}

fn lowering_problems(facts: Vec<OpFact>) -> Vec<String> {
    let out: Vec<String> = Vec::new();
    let mut i: u64 = 0u64;
    while i < facts.len() {
        fact_lowering_problems(facts[i], out);
        i = i + 1u64;
    }
    out
}

fn problems_mention(problems: Vec<String>, needle: String) -> bool {
    let mut i: u64 = 0u64;
    while i < problems.len() {
        if facts_str_contains(problems[i], needle) { return true; }
        i = i + 1u64;
    }
    false
}

fn check_every_catalogue_op_lowers_as_catalogued() -> i32 [io] {
    let facts: Vec<OpFact> = op_facts_all();
    if facts.len() == 0u64 { return 1; }
    let problems: Vec<String> = lowering_problems(facts);
    let mut i: u64 = 0u64;
    while i < problems.len() {
        eprintln_str(problems[i]);
        i = i + 1u64;
    }
    if problems.len() != 0u64 { return 2; }
    0
}

fn fact_named(facts: Vec<OpFact>, name: String) -> OpFact {
    let mut i: u64 = 0u64;
    while i < facts.len() {
        let f: OpFact = facts[i];
        let fname: String = f.name;
        if fname == name { return f; }
        i = i + 1u64;
    }
    facts[0u64]
}

// The same facts with `name`'s symbol and return token replaced.
fn facts_with(facts: Vec<OpFact>, name: String, symbol: String, ret: String) -> Vec<OpFact> {
    let out: Vec<OpFact> = Vec::new();
    let mut i: u64 = 0u64;
    while i < facts.len() {
        let f: OpFact = facts[i];
        let fname: String = f.name;
        if fname == name {
            out.push(op_fact(fname, f.effects, f.params, ret, f.doc_params, f.doc_ret, symbol, f.result_tag));
        } else {
            out.push(f);
        }
        i = i + 1u64;
    }
    out
}

// Controls: a one-column drift in any fact row must be reported against that
// op alone, so the green run above is not vacuous.
fn check_a_drifted_symbol_names_the_op() -> i32 {
    let facts: Vec<OpFact> = op_facts_all();
    let f: OpFact = fact_named(facts, String::from("fs_status"));
    let mutated: Vec<OpFact> = facts_with(facts, String::from("fs_status"), String::from("__vow_fs_status_X"), f.ret);
    let problems: Vec<String> = lowering_problems(mutated);
    if problems.len() != 2u64 { return 10; }
    if !problems_mention(problems, String::from("'fs_status': catalogue_builtin_to_extern")) { return 11; }
    if !problems_mention(problems, String::from("'fs_status': builtin_to_extern")) { return 12; }
    0
}

fn check_a_drifted_return_type_names_the_op() -> i32 {
    let facts: Vec<OpFact> = op_facts_all();
    let f: OpFact = fact_named(facts, String::from("fs_status"));
    let mutated: Vec<OpFact> = facts_with(facts, String::from("fs_status"), f.symbol, String::from("u64"));
    let problems: Vec<String> = lowering_problems(mutated);
    if problems.len() != 2u64 { return 20; }
    if !problems_mention(problems, String::from("'fs_status': catalogue_builtin_ret_ty")) { return 21; }
    if !problems_mention(problems, String::from("'fs_status': builtin_ret_ty")) { return 22; }
    0
}

fn check_an_unlowered_row_names_the_op() -> i32 {
    let facts: Vec<OpFact> = op_facts_all();
    facts.push(op_fact(String::from("brand_new_builtin"), String::from("[]"), String::from(""), String::from("i64"), String::from(""), String::from("i64"), String::from("__vow_brand_new_builtin"), String::from("none")));
    let problems: Vec<String> = lowering_problems(facts);
    if !problems_mention(problems, String::from("'brand_new_builtin': catalogue_builtin_to_extern")) { return 30; }
    0
}

fn any_fact_named(facts: Vec<OpFact>, name: String) -> bool {
    let mut i: u64 = 0u64;
    while i < facts.len() {
        let f: OpFact = facts[i];
        let fname: String = f.name;
        if fname == name { return true; }
        i = i + 1u64;
    }
    false
}

// `i64_to_string` shares `int_to_string`'s runtime symbol, so the catalogue does
// not list it (it is an `excluded` entry); the alias stays a hand-written arm
// next to the lookups, with the same symbol and type as `int_to_string`.
fn check_i64_to_string_alias() -> i32 {
    if any_fact_named(op_facts_all(), String::from("i64_to_string")) { return 40; }
    if catalogue_builtin_to_extern(String::from("i64_to_string")) != String::from("") { return 41; }
    if catalogue_builtin_ret_ty(String::from("i64_to_string")) != -1 { return 42; }
    if builtin_to_extern(String::from("i64_to_string")) != String::from("__vow_string_from_i64") { return 43; }
    if builtin_ret_ty(String::from("i64_to_string")) != ITY_PTR() { return 44; }
    0
}

fn main() -> i32 [io] {
    let mut r: i32 = check_every_catalogue_op_lowers_as_catalogued();
    if r == 0 { r = check_a_drifted_symbol_names_the_op(); }
    if r == 0 { r = check_a_drifted_return_type_names_the_op(); }
    if r == 0 { r = check_an_unlowered_row_names_the_op(); }
    if r == 0 { r = check_i64_to_string_alias(); }
    r
}
