// `i64_to_string` shares `int_to_string`'s runtime symbol, so the catalogue does
// not list it; the alias stays a one-line hand-written arm next to the lookup.
fn check_i64_to_string_alias() -> i64 {
    if catalogue_builtin_to_extern(String::from("i64_to_string")) != String::from("") { return 500; }
    if builtin_to_extern(String::from("i64_to_string")) != String::from("__vow_string_from_i64") { return 501; }
    if builtin_ret_ty(String::from("i64_to_string")) != ITY_PTR() { return 502; }
    if builtin_result_tag(String::from("i64_to_string")) != BRT_STRING() { return 503; }
    0
}

