fn agg_avoiding(fname: String, pi: i64, kv: String, avoid: Vec<i64>) -> ReplayArg [io] {
    let m: Module = parse_src(agg_src());
    let objs: ReplayObjs = replay_param_objects(m, fname, kv_part(kv, false), kv_part(kv, true));
    replay_agg_arg(m, fname, pi, kv_part(kv, false), kv_part(kv, true), avoid, objs)
}

fn agg(fname: String, pi: i64, kv: String) -> ReplayArg [io] {
    let all: Vec<i64> = Vec::new();
    all.push(0);
    all.push(1);
    all.push(2);
    agg_avoiding(fname, pi, kv, all)
}

fn lit_of(fname: String, kv: String) -> String [io] {
    let r: ReplayArg = agg(fname, 0, kv);
    if r.reason.len() > 0 { return str2s(String::from("<skip: "), r.reason); }
    r.lit
}

fn str2s(a: String, b: String) -> String {
    let out: String = String::from(a);
    out.push_str(b);
    out
}

fn check_struct_arg() -> i32 [io] {
    if lit_of(String::from("fp"), String::from("p.0=3,p.1=-4")) != String::from("Pair { lo: 3, hi: -4 }") { return 101; }
    if agg(String::from("fp"), 0, String::from("p.0=3")).ty_text != String::from("Pair") { return 102; }
    if lit_of(String::from("fp"), String::from("")) != String::from("Pair { lo: 0, hi: 0 }") { return 103; }
    if lit_of(String::from("ff"), String::from("f.0=true,f.1=255")) != String::from("Flags { on: true, n: 255 }") { return 104; }
    if lit_of(String::from("fp"), String::from("p.0=-9223372036854775808")) != String::from("Pair { lo: (-9223372036854775807 - 1), hi: 0 }") { return 105; }
    let second: ReplayArg = agg(String::from("fq"), 1, String::from("p.0=1,p.1=2"));
    if second.lit != String::from("Pair { lo: 1, hi: 2 }") { return 106; }
    0
}

fn check_enum_arg() -> i32 [io] {
    if lit_of(String::from("fs"), String::from("s.0=1,s.1=5,s.2=6")) != String::from("Shape::Rect(5, 6)") { return 111; }
    if lit_of(String::from("fs"), String::from("s.0=2")) != String::from("Shape::Empty") { return 112; }
    if lit_of(String::from("fs"), String::from("s.1=9")) != String::from("Shape::Circle(9)") { return 113; }
    if lit_of(String::from("fs"), String::from("")) != String::from("Shape::Circle(0)") { return 114; }
    let bad: ReplayArg = agg(String::from("fs"), 0, String::from("s.0=7"));
    if bad.lit.len() != 0 { return 115; }
    if index_of(bad.reason, String::from("discriminant 7 outside Shape (3 variants)")) < 0 { return 116; }
    if agg(String::from("fs"), 0, String::from("s.0=-1")).reason.len() == 0 { return 117; }
    0
}

fn check_option_result_arg() -> i32 [io] {
    if lit_of(String::from("fo"), String::from("o.0=0")) != String::from("Option::None") { return 121; }
    if lit_of(String::from("fo"), String::from("o.0=1,o.1=9")) != String::from("Option::Some(9)") { return 122; }
    if agg(String::from("fo"), 0, String::from("o.0=0")).ty_text != String::from("Option<i64>") { return 123; }
    if lit_of(String::from("fr"), String::from("r.0=0,r.1=4")) != String::from("Result::Ok(4)") { return 124; }
    if lit_of(String::from("fr"), String::from("r.0=1,r.1=false")) != String::from("Result::Err(false)") { return 125; }
    if agg(String::from("fr"), 0, String::from("r.0=0")).ty_text != String::from("Result<i64, bool>") { return 126; }
    if lit_of(String::from("fe"), String::from("r.0=0")) != String::from("Result::Ok(())") { return 129; }
    if lit_of(String::from("fe"), String::from("r.0=1,r.1=true")) != String::from("Result::Err(true)") { return 130; }
    // One slot read at two sorts: each variant's payload takes its own view.
    let both: String = String::from("r.0=1,r.1:64=4,r.1:bool=true");
    if lit_of(String::from("fr"), both) != String::from("Result::Err(true)") { return 127; }
    let ok_side: String = String::from("r.0=0,r.1:64=4,r.1:bool=true");
    if lit_of(String::from("fr"), ok_side) != String::from("Result::Ok(4)") { return 128; }
    0
}

fn check_unsupported_args_are_skipped_with_a_reason() -> i32 [io] {
    if agg(String::from("ffl32"), 0, String::from("g.0=1")).reason.len() == 0 { return 147; }
    if lit_of(String::from("fop"), String::from("o.0=0")) != String::from("Option::None") { return 146; }
    if agg(String::from("fvs"), 0, String::from("v.len=1")).reason.len() == 0 { return 134; }
    if agg(String::from("fvf"), 0, String::from("v.len=1,v[0]=0")).reason.len() == 0 { return 148; }
    if agg(String::from("fref"), 0, String::from("")).reason.len() == 0 { return 135; }
    if agg(String::from("fa"), 0, String::from("")).reason.len() != 0 { return 136; }
    if agg(String::from("fu"), 0, String::from("")).reason.len() == 0 { return 137; }
    if agg(String::from("missing"), 0, String::from("")).reason.len() == 0 { return 138; }
    if agg(String::from("fp"), 5, String::from("")).reason.len() == 0 { return 139; }
    0
}

// A struct, enum, `Option` or `Result` held in a field or a payload is an object of its own: slot
// `j` of what slot `k` of `p` holds is the entry `p.k.j`, and a slot never read takes zero.
// A tag the model chose outside the enum takes the arm no test selects: replay builds the
// smallest variant the program never tests, or skips when every variant is tested.
fn check_tag_outside_the_enum() -> i32 [io] {
    let one: Vec<i64> = Vec::new();
    one.push(1);
    let none: Vec<i64> = Vec::new();
    let r: ReplayArg = agg_avoiding(String::from("fop"), 0, String::from("o.0=-1,o.1=9"), one);
    if r.lit != String::from("Option::None") { return 321; }
    let big: ReplayArg = agg_avoiding(String::from("fs"), 0, String::from("s.0=7"), none);
    if big.lit != String::from("Shape::Circle(0)") { return 322; }
    let two: Vec<i64> = Vec::new();
    two.push(0);
    two.push(2);
    let mid: ReplayArg = agg_avoiding(String::from("fs"), 0, String::from("s.0=-9223372036854775808"), two);
    if mid.lit != String::from("Shape::Rect(0, 0)") { return 323; }
    let tested: ReplayArg = agg(String::from("fo"), 0, String::from("o.0=-1"));
    if index_of(tested.reason, String::from("discriminant -1 outside Option")) < 0 { return 324; }
    let nested: Vec<i64> = Vec::new();
    nested.push(1);
    let inner: ReplayArg = agg_avoiding(String::from("fop"), 0, String::from("o.0=1,o.1.0=3"), nested);
    if inner.lit != String::from("Option::Some(Pair { lo: 3, hi: 0 })") { return 325; }
    0
}

fn check_nested_aggregates() -> i32 [io] {
    let h: String = String::from("Holder { p: Pair { lo: 3, hi: -4 } }");
    if lit_of(String::from("fh"), String::from("h.0.0=3,h.0.1=-4")) != h { return 301; }
    if lit_of(String::from("fh"), String::from("")) != String::from("Holder { p: Pair { lo: 0, hi: 0 } }") { return 302; }
    if lit_of(String::from("fnest"), String::from("n.0.0=1,n.0.1=-5")) != String::from("Nest { w: Wide { a: 1, w: -5i128 } }") { return 303; }
    if lit_of(String::from("fop"), String::from("o.0=1,o.1.0=7,o.1.1=8")) != String::from("Option::Some(Pair { lo: 7, hi: 8 })") { return 304; }
    if lit_of(String::from("fop"), String::from("o.0=1")) != String::from("Option::Some(Pair { lo: 0, hi: 0 })") { return 305; }
    if agg(String::from("fop"), 0, String::from("o.0=1")).ty_text != String::from("Option<Pair>") { return 306; }
    if lit_of(String::from("fboth"), String::from("b.0.0=1,b.0.1.0=2,b.0.1.1=3,b.1.0=1,b.1.1=6,b.1.2=7")) != String::from("Both { a: Option::Some(Pair { lo: 2, hi: 3 }), b: Shape::Rect(6, 7) }") { return 307; }
    let out: ReplayArg = agg(String::from("fboth"), 0, String::from("b.1.0=9"));
    if index_of(out.reason, String::from("discriminant 9 outside Shape")) < 0 { return 311; }
    let deep: String = String::from("");
    let mut p: String = String::from("r.0");
    let mut i: i64 = 0;
    while i < 12 {
        deep.push_str(p);
        deep.push_str(String::from(".0=1,"));
        p = str2s(p, String::from(".1.0"));
        i = i + 1;
    }
    let too_deep: ReplayArg = agg(String::from("frec"), 0, deep);
    if index_of(too_deep.reason, String::from("nested too deep")) < 0 { return 312; }
    0
}

fn check_held_collections() -> i32 [io] {
    let empty: String = String::from("HasVec { v: { let __replay_v: Vec<i64> = Vec::new(); __replay_v } }");
    if lit_of(String::from("fhv"), String::from("")) != empty { return 331; }
    let one: String = String::from("HasVec { v: __replay_h0 }");
    if lit_of(String::from("fhv"), String::from("h.0=0,h.0.len=1,h.0[0]=1")) != one { return 332; }
    let no_len: ReplayArg = agg(String::from("fhv"), 0, String::from("h.0=0"));
    if index_of(no_len.reason, String::from("does not list its length")) < 0 { return 333; }
    let alias: ReplayArg = agg(String::from("faliasp"), 1, String::from("v.addr=-2,h.addr=-1,v.len=0,h.0=-2,h.0.len=0"));
    if alias.lit != String::from("HasVec { v: __replay_a0 }") || alias.deps != String::from("__replay_a0 ") { return 334; }
    let owned: String = String::from("v.addr=-2,h.addr=-1,v.len=0,h.0=5,h.0.len=0");
    if agg(String::from("faliasp"), 1, owned).reason.len() != 0 { return 335; }
    let text: String = String::from("HasStr { s: __replay_h0, n: 3 }");
    if lit_of(String::from("fstrf"), String::from("h.0=0,h.0.len=1,h.0[0]=97,h.1=3")) != text { return 336; }
    let blank: String = String::from("HasStr { s: { let __replay_s: String = String::from(\"\"); __replay_s }, n: 0 }");
    if lit_of(String::from("fstrf"), String::from("")) != blank { return 337; }
    let vs_empty: String = String::from("HasVs { v: __replay_h0 }");
    if lit_of(String::from("fvsf"), String::from("h.0=0,h.0.len=0")) != vs_empty { return 338; }
    if agg(String::from("fvsf"), 0, String::from("h.0=0,h.0.len=1,h.0[0]=0")).reason.len() == 0 { return 339; }
    if lit_of(String::from("fwidef"), String::from("h.0=0,h.0.len=1,h.0[0]=5")) != String::from("HasWide { v: __replay_h0 }") { return 340; }
    if agg(String::from("ffloatf"), 0, String::from("h.0=0,h.0.len=1,h.0[0]=5")).reason.len() == 0 { return 341; }
    if agg(String::from("fwidef"), 0, String::from("h.0=0,h.0.len=0")).reason.len() != 0 { return 342; }
    if agg(String::from("fhv"), 0, String::from("h.0=0,h.0.len=9999")).reason.len() == 0 { return 343; }
    let pair: ReplayArg = agg(String::from("fpairf"), 0, String::from("h.0=0,h.1=4"));
    if index_of(pair.reason, String::from("is read through memory")) < 0 { return 344; }
    if lit_of(String::from("fpairf"), String::from("h.0.0=1,h.0.1=2,h.1=4")) != String::from("HasPair { inner: Pair { lo: 1, hi: 2 }, n: 4 }") { return 345; }
    if index_of(agg(String::from("foptf"), 0, String::from("h.0=0")).reason, String::from("is read through memory")) < 0 { return 346; }
    if lit_of(String::from("foptf"), String::from("h.0.0=1,h.0.1=6,h.1=2")) != String::from("HasOpt { o: Option::Some(6), n: 2 }") { return 347; }
    let no_addr: ReplayArg = agg(String::from("fhv"), 0, String::from("h.0.len=1,h.0[0]=1"));
    if index_of(no_addr.reason, String::from("lists its length but not its address")) < 0 { return 349; }
    let both: String = String::from("b.0=1,b.0.0=1,b.0.1.0=2,b.0.1.1=3,b.1.0=1,b.1.1=6,b.1.2=7");
    if agg(String::from("fboth"), 0, both).reason.len() != 0 { return 350; }
    let two: String = String::from("t.0=0,t.0.0=0,t.0.0.len=1,t.0.0[0]=7");
    if agg(String::from("ftwo"), 0, two).reason.len() != 0 { return 348; }
    0
}

// A field holding the address another parameter lists as `<param>.addr` is that parameter's
// object: the harness names its binding instead of building a second value, and the literal
// reports the binding so the `let` of that parameter comes first.
fn check_field_holds_a_parameter() -> i32 [io] {
    let one: String = String::from("out.addr=-1,b.addr=-2,b.0=-1,out.len=0");
    let b: ReplayArg = agg(String::from("fpush"), 1, one);
    if b.lit != String::from("Bag { items: __replay_a0, tag: 0 }") { return 501; }
    if b.deps != String::from("__replay_a0 ") { return 502; }
    if b.ty_text != String::from("Bag") { return 503; }
    let late: ReplayArg = agg(String::from("fbagfirst"), 0, one);
    if late.lit != String::from("Bag { items: __replay_a1, tag: 0 }") { return 504; }
    if late.deps != String::from("__replay_a1 ") { return 505; }
    let out: ReplayArg = agg(String::from("fpush"), 0, one);
    if out.deps.len() != 0 { return 506; }
    let text: ReplayArg = agg(String::from("fwipe"), 1, String::from("out.addr=-1,l.addr=-2,l.0=-1,out.len=1,out[0]=0"));
    if text.lit != String::from("Label { text: __replay_a0, n: 0 }") { return 507; }
    let holder: ReplayArg = agg(String::from("fholds"), 1, String::from("p.addr=-1,h.addr=-2,h.0=-1,p.0=4"));
    if holder.lit != String::from("Holder { p: __replay_a0 }") { return 508; }
    if holder.deps != String::from("__replay_a0 ") { return 509; }
    let plain: ReplayArg = agg(String::from("fpush"), 1, String::from("out.addr=-1,b.addr=-2,b.0=-3"));
    if index_of(plain.reason, String::from("does not list its length")) < 0 { return 510; }
    let tag: ReplayArg = agg(String::from("fpush"), 1, String::from("out.addr=-1,b.addr=-2,b.0=-1,b.1=-1"));
    if tag.lit != String::from("Bag { items: __replay_a0, tag: -1 }") { return 511; }
    let unlisted: ReplayArg = agg(String::from("fpush"), 1, String::from("b.addr=-2,b.0=-1"));
    if index_of(unlisted.reason, String::from("does not list its length")) < 0 { return 512; }
    let lin: ReplayArg = agg(String::from("flin"), 1, String::from("l.addr=-1,h.addr=-2,h.0=-1,l.0=3"));
    if index_of(lin.reason, String::from("is read through memory")) < 0 { return 514; }
    let other: ReplayArg = agg(String::from("fmix"), 1, one);
    if index_of(other.reason, String::from("holds the object of a parameter of type `Vec<u8>`")) < 0 { return 513; }
    0
}

// A struct whose field holds the struct itself has no finite value: the field needs a value of the
// type before the value exists. The same holds for two structs that hold each other.
fn check_self_referential_field() -> i32 [io] {
    let node: ReplayArg = agg(String::from("fnode"), 0, String::from("p.addr=0,p.1=0,p.0=0"));
    if node.lit.len() != 0 { return 521; }
    if index_of(node.reason, String::from("holds the very value that holds it")) < 0 { return 522; }
    let away: ReplayArg = agg(String::from("fnode"), 0, String::from("p.addr=0,p.1=7,p.0=0"));
    if index_of(away.reason, String::from("holds the very value")) >= 0 { return 523; }
    let ring: ReplayArg = agg(String::from("fring"), 0, String::from("x.addr=-1,y.addr=-2,x.0=-2,y.0=-1"));
    if ring.lit != String::from("Ring { peer: __replay_a1 }") { return 524; }
    let link: ReplayArg = agg(String::from("fring"), 1, String::from("x.addr=-1,y.addr=-2,x.0=-2,y.0=-1"));
    if link.lit != String::from("Link { back: __replay_a0 }") { return 525; }
    let defs: Vec<String> = Vec::new();
    defs.push(String::from("__replay_a0"));
    defs.push(String::from("__replay_a1"));
    let uses: Vec<String> = Vec::new();
    uses.push(ring.deps);
    uses.push(link.deps);
    if replay_let_order(defs, uses).len() != 0 { return 526; }
    0
}

// The `let` of a parameter comes after the `let` of every parameter its value names; a parameter
// that declares nothing (the twin of an earlier one) is left out.
fn check_let_order() -> i32 {
    let defs: Vec<String> = Vec::new();
    defs.push(String::from("__replay_a0"));
    defs.push(String::from("__replay_a1"));
    defs.push(String::from(""));
    defs.push(String::from("__replay_a3"));
    let uses: Vec<String> = Vec::new();
    uses.push(String::from("__replay_a1 __replay_a3 "));
    uses.push(String::from(""));
    uses.push(String::from(""));
    uses.push(String::from("__replay_a1 "));
    let order: Vec<i64> = replay_let_order(defs, uses);
    if order.len() != 3 { return 531; }
    if order[0] != 1 || order[1] != 3 || order[2] != 0 { return 532; }
    if replay_count_defs(defs) != 3 { return 533; }
    let missing: Vec<String> = Vec::new();
    missing.push(String::from("__replay_a9 "));
    missing.push(String::from(""));
    let two: Vec<String> = Vec::new();
    two.push(String::from("__replay_a0"));
    two.push(String::from("__replay_a1"));
    if replay_let_order(two, missing).len() != 1 { return 534; }
    0
}

// Parameters with one `.alias` identity share the binding of the first, and an index outside the
// source signature falls back to its own.
fn check_param_objects() -> i32 [io] {
    let m: Module = parse_src(agg_src());
    let kv: String = String::from("a.alias=3,b.alias=3,a.addr=-1,b.addr=-1,c.addr=-4");
    let o: ReplayObjs = replay_param_objects(m, String::from("ftwins"), kv_part(kv, false), kv_part(kv, true));
    if replay_obj_bind(o, 0) != String::from("__replay_a0") { return 541; }
    if replay_obj_bind(o, 1) != String::from("__replay_a0") { return 542; }
    if replay_obj_bind(o, 2) != String::from("__replay_a2") { return 543; }
    if replay_obj_owner(o, 1) != 0 || replay_obj_owner(o, 2) != 2 { return 544; }
    if replay_obj_ty(o, 1) != String::from("Pair") { return 545; }
    if replay_param_at(String::from("Bag"), 18446744073709551612u64, o) != 2 { return 546; }
    if replay_param_at(String::from("Pair"), 18446744073709551615u64, o) != 0 { return 547; }
    if replay_param_at(String::from("Pair"), 7u64, o) != -1 { return 548; }
    if replay_obj_bind(o, 9) != String::from("__replay_a9") { return 549; }
    0
}

// A map is built with `new` and one `insert` per present key of the listed state, then keys the
// claim did not ask about until the length is met.
fn check_map_params() -> i32 [io] {
    let head: String = String::from("{ let __replay_m: HashMap<i64, i64> = HashMap::new();");
    if lit_of(String::from("fmap"), String::from("m.len=0")) != str2s(head, String::from(" __replay_m }")) { return 601; }
    if lit_of(String::from("fmap"), String::from("")) != str2s(head, String::from(" __replay_m }")) { return 602; }
    let two: String = str2s(head, String::from(" __replay_m.insert(5, 7); __replay_m.insert(0, 0); __replay_m }"));
    if lit_of(String::from("fmap"), String::from("m.len=2,m[5]=7,m[-1]=absent")) != two { return 603; }
    let skip0: String = str2s(head, String::from(" __replay_m.insert(-1, 0); __replay_m }"));
    if lit_of(String::from("fmap"), String::from("m.len=1,m[0]=absent")) != skip0 { return 604; }
    if agg(String::from("fmap"), 0, String::from("m.len=1,m[0]=absent")).ty_text != String::from("HashMap<i64, i64>") { return 605; }
    let flags: String = String::from("{ let __replay_m: BTreeMap<bool, bool> = BTreeMap::new(); __replay_m.insert(false, false); __replay_m }");
    if lit_of(String::from("fmapb"), String::from("m.len=1,m[true]=absent")) != flags { return 606; }
    let full: ReplayArg = agg(String::from("fmapb"), 0, String::from("m.len=2,m[false]=absent"));
    if index_of(full.reason, String::from("too few keys")) < 0 { return 607; }
    let units: String = String::from("{ let __replay_m: HashMap<u8, ()> = HashMap::new(); __replay_m.insert(3, ()); __replay_m }");
    if lit_of(String::from("fmapu"), String::from("m.len=1,m[3]=()")) != units { return 608; }
    let narrow: ReplayArg = agg(String::from("fmapu"), 0, String::from("m.len=300"));
    if index_of(narrow.reason, String::from("too few keys")) < 0 { return 609; }
    if index_of(agg(String::from("fmapu"), 0, String::from("m.len=9999")).reason, String::from("not a length")) < 0 { return 610; }
    if index_of(agg(String::from("fmapw"), 0, String::from("m.len=0")).reason, String::from("is not rebuilt")) < 0 { return 611; }
    if agg(String::from("fmap"), 0, String::from("m.len=1,m[1]=x")).reason.len() == 0 { return 612; }
    let twice: ReplayArg = agg(String::from("fmaps"), 0, String::from("m.len=2,m[1]=true,m[1]=false"));
    if index_of(twice.reason, String::from("are one key")) < 0 { return 613; }
    let signed: String = String::from("{ let __replay_m: HashMap<i8, bool> = HashMap::new(); __replay_m.insert(0, false); __replay_m.insert(-1, false); __replay_m.insert(1, false); __replay_m }");
    if lit_of(String::from("fmaps"), String::from("m.len=3")) != signed { return 614; }
    if agg(String::from("fmaps"), 0, String::from("m.len=256")).reason.len() != 0 { return 615; }
    if agg(String::from("fmaps"), 0, String::from("m.len=257")).reason.len() == 0 { return 616; }
    0
}

// A call whose result is linear is wrapped in `drop`, the language's way to discharge it.
fn check_call_stmt() -> i32 {
    if replay_call_stmt(String::from("f"), String::from("__replay_a0, 3"), false) != String::from("    f(__replay_a0, 3);\n") { return 701; }
    if replay_call_stmt(String::from("make"), String::from("0"), true) != String::from("    drop(make(0));\n") { return 702; }
    if replay_call_stmt(String::from("g"), String::from(""), true) != String::from("    drop(g());\n") { return 703; }
    0
}

fn check_value_text_is_validated() -> i32 [io] {
    if agg(String::from("ff"), 0, String::from("f.1=-1")).reason.len() == 0 { return 141; }
    if agg(String::from("fp"), 0, String::from("p.0=abc")).reason.len() == 0 { return 142; }
    if agg(String::from("ff"), 0, String::from("f.1=18446744073709551615")).reason.len() == 0 { return 143; }
    if lit_of(String::from("fp"), String::from("p.1=9223372036854775807")) != String::from("Pair { lo: 0, hi: 9223372036854775807 }") { return 145; }
    if agg(String::from("ff"), 0, String::from("f.1=300")).reason.len() == 0 { return 144; }
    0
}

fn check_alias_identities() -> i32 {
    let names: Vec<String> = kv_part(String::from("a.alias=3,b.alias=3,c.alias=4,a.0=1"), false);
    let vals: Vec<String> = kv_part(String::from("a.alias=3,b.alias=3,c.alias=4,a.0=1"), true);
    if replay_alias_id(names, vals, String::from("b")) != String::from("3") { return 150; }
    if replay_alias_id(names, vals, String::from("z")).len() != 0 { return 151; }
    let seen: Vec<String> = Vec::new();
    seen.push(String::from("3"));
    seen.push(String::from("4"));
    if replay_alias_find(seen, String::from("4")) != 1 { return 152; }
    if replay_alias_find(seen, String::from("9")) != -1 { return 153; }
    if replay_alias_find(seen, String::from("")) != -1 { return 154; }
    0
}

fn scalar_lit(name: String, raw: String) -> String {
    let r: ReplayArg = replay_scalar_literal(name, raw);
    if r.reason.len() > 0 { return str2s(String::from("<skip: "), r.reason); }
    r.lit
}

fn is_skip(name: String, raw: String) -> bool {
    replay_scalar_literal(name, raw).reason.len() > 0
}

fn check_wide_and_float_fields() -> i32 [io] {
    if lit_of(String::from("fw"), String::from("w.0=1,w.1=-5")) != String::from("Wide { a: 1, w: -5i128 }") { return 151; }
    if lit_of(String::from("fw"), String::from("w.1=170141183460469231731687303715884105727")) != String::from("Wide { a: 0, w: 170141183460469231731687303715884105727i128 }") { return 152; }
    if lit_of(String::from("fw"), String::from("w.1:128=7")) != String::from("Wide { a: 0, w: 7i128 }") { return 153; }
    if lit_of(String::from("ffl"), String::from("f.0=2.5,f.1=-3")) != String::from("Fl { x: 2.5, n: -3 }") { return 154; }
    if lit_of(String::from("ffl"), String::from("f.0:f64=-0.5")) != String::from("Fl { x: (0.0 - 0.5), n: 0 }") { return 155; }
    if lit_of(String::from("ffl"), String::from("")) != String::from("Fl { x: 0.0, n: 0 }") { return 156; }
    // A 128-bit field takes two slots, so the field after it is read three on.
    if lit_of(String::from("fmid"), String::from("m.0=1,m.1=5,m.3=7")) != String::from("Mid { a: 1, w: 5u128, b: 7 }") { return 157; }
    if lit_of(String::from("fmid"), String::from("m.2=9")) != String::from("Mid { a: 0, w: 0u128, b: 0 }") { return 158; }
    if lit_of(String::from("fpw"), String::from("p.0=0,p.1=5,p.3=7")) != String::from("Pw::P(5u128, 7)") { return 159; }
    0
}

fn check_scalar_literals() -> i32 {
    if scalar_lit(String::from("i32"), String::from("-2147483648")) != String::from("(-2147483647 - 1)") { return 161; }
    if scalar_lit(String::from("u8"), String::from("255")) != String::from("255") { return 162; }
    if !is_skip(String::from("u8"), String::from("256")) { return 163; }
    if !is_skip(String::from("i8"), String::from("-129")) { return 164; }
    if scalar_lit(String::from("u64"), String::from("18446744073709551615")) != String::from("18446744073709551615u64") { return 165; }
    if scalar_lit(String::from("bool"), String::from("true")) != String::from("true") { return 166; }
    if !is_skip(String::from("bool"), String::from("1")) { return 167; }
    if scalar_lit(String::from("u128"), String::from("340282366920938463463374607431768211455")) != String::from("340282366920938463463374607431768211455u128") { return 168; }
    if scalar_lit(String::from("i128"), String::from("-5")) != String::from("-5i128") { return 169; }
    if scalar_lit(String::from("i128"), String::from("-170141183460469231731687303715884105728")) != String::from("(-170141183460469231731687303715884105727i128 - 1i128)") { return 170; }
    if !is_skip(String::from("u128"), String::from("-1")) { return 171; }
    if !is_skip(String::from("i128"), String::from("12x")) { return 172; }
    if !is_skip(String::from("u128"), String::from("3402823669209384634633746074317682114550")) { return 173; }
    0
}

fn check_float_literals() -> i32 {
    if scalar_lit(String::from("f64"), String::from("2.5")) != String::from("2.5") { return 181; }
    if scalar_lit(String::from("f64"), String::from("100")) != String::from("100.0") { return 182; }
    if scalar_lit(String::from("f64"), String::from("-2.5")) != String::from("(0.0 - 2.5)") { return 183; }
    if scalar_lit(String::from("f64"), String::from("-0")) != String::from("(0.0 * (0.0 - 1.0))") { return 184; }
    if scalar_lit(String::from("f64"), String::from("NaN")) != String::from("(0.0 / 0.0)") { return 185; }
    if scalar_lit(String::from("f64"), String::from("inf")) != String::from("(1.0 / 0.0)") { return 186; }
    if scalar_lit(String::from("f64"), String::from("-inf")) != String::from("(0.0 - (1.0 / 0.0))") { return 187; }
    if !is_skip(String::from("f64"), String::from("1e300")) { return 188; }
    if !is_skip(String::from("f64"), String::from(".5")) { return 189; }
    if !is_skip(String::from("f64"), String::from("1.")) { return 190; }
    if !is_skip(String::from("f64"), String::from("1.2.3")) { return 191; }
    if !is_skip(String::from("f64"), String::from("")) { return 192; }
    if !is_skip(String::from("f32"), String::from("1.5")) { return 193; }
    0
}


fn vec_lit(fname: String, kv: String) -> String [io] {
    lit_of(fname, kv)
}

fn vec_head(ty: String) -> String {
    str2s(String::from("{ let __replay_v: "), str2s(ty, String::from(" = Vec::new();")))
}

fn check_vec_arg() -> i32 [io] {
    let empty: String = str2s(vec_head(String::from("Vec<i64>")), String::from(" __replay_v }"));
    if vec_lit(String::from("fv"), String::from("")) != empty { return 201; }
    if vec_lit(String::from("fv"), String::from("v.len=0")) != empty { return 202; }
    let two: String = str2s(vec_head(String::from("Vec<i64>")), String::from(" __replay_v.push(5); __replay_v.push(-1); __replay_v }"));
    if vec_lit(String::from("fv"), String::from("v.len=2,v[0]=5,v[1]=18446744073709551615")) != two { return 203; }
    if agg(String::from("fv"), 0, String::from("v.len=0")).ty_text != String::from("Vec<i64>") { return 204; }
    if agg(String::from("fv"), 0, String::from("v.len=2,v[0]=5")).reason.len() == 0 { return 205; }
    if agg(String::from("fv"), 0, String::from("v.len=513")).reason.len() == 0 { return 206; }
    if agg(String::from("fv"), 0, String::from("v.len=x")).reason.len() == 0 { return 207; }
    let min: String = str2s(vec_head(String::from("Vec<i64>")), String::from(" __replay_v.push((-9223372036854775807 - 1)); __replay_v }"));
    if vec_lit(String::from("fv"), String::from("v.len=1,v[0]=9223372036854775808")) != min { return 208; }
    0
}

fn check_vec_elements_follow_the_element_type() -> i32 [io] {
    let b: String = str2s(vec_head(String::from("Vec<bool>")), String::from(" __replay_v.push(true); __replay_v.push(false); __replay_v }"));
    if vec_lit(String::from("fvb"), String::from("v.len=2,v[0]=1,v[1]=0")) != b { return 211; }
    let wide_true: String = str2s(vec_head(String::from("Vec<bool>")), String::from(" __replay_v.push(true); __replay_v.push(true); __replay_v }"));
    if vec_lit(String::from("fvb"), String::from("v.len=2,v[0]=2,v[1]=18446744073709551615")) != wide_true { return 212; }
    let i8s: String = str2s(vec_head(String::from("Vec<i8>")), String::from(" __replay_v.push(-1); __replay_v.push(127); __replay_v }"));
    if vec_lit(String::from("fvi8"), String::from("v.len=2,v[0]=255,v[1]=383")) != i8s { return 213; }
    let u8s: String = str2s(vec_head(String::from("Vec<u8>")), String::from(" __replay_v.push(255); __replay_v.push(1); __replay_v }"));
    if vec_lit(String::from("fvu8"), String::from("v.len=2,v[0]=18446744073709551615,v[1]=257")) != u8s { return 214; }
    let i32s: String = str2s(vec_head(String::from("Vec<i32>")), String::from(" __replay_v.push(-1); __replay_v.push((-2147483647 - 1)); __replay_v }"));
    if vec_lit(String::from("fvi32"), String::from("v.len=2,v[0]=4294967295,v[1]=2147483648")) != i32s { return 215; }
    let u64s: String = str2s(vec_head(String::from("Vec<u64>")), String::from(" __replay_v.push(18446744073709551615u64); __replay_v }"));
    if vec_lit(String::from("fvu64"), String::from("v.len=1,v[0]=18446744073709551615")) != u64s { return 216; }
    0
}

// A wide element is listed as one decimal value, which replay spells with the
// literal suffix of its type.
fn check_wide_vec_elements() -> i32 [io] {
    let two: String = vec_lit(String::from("fvi128"), String::from("v.len=2,v[0]=-5,v[1]=170141183460469231731687303715884105727"));
    let want: String = str2s(vec_head(String::from("Vec<i128>")), String::from(" __replay_v.push(-5i128); __replay_v.push(170141183460469231731687303715884105727i128); __replay_v }"));
    if two != want { return 232; }
    let big: String = vec_lit(String::from("fvu128"), String::from("v.len=1,v[0]=340282366920938463463374607431768211455"));
    let want_big: String = str2s(vec_head(String::from("Vec<u128>")), String::from(" __replay_v.push(340282366920938463463374607431768211455u128); __replay_v }"));
    if big != want_big { return 233; }
    if agg(String::from("fvi128"), 0, String::from("v.len=1")).reason.len() == 0 { return 234; }
    if agg(String::from("fvu128"), 0, String::from("v.len=1,v[0]=-1")).reason.len() == 0 { return 235; }
    0
}

// A `Vec<f64>` whose elements the function reads as floats is marked `<param>.elem=f64` and
// lists each element as the float's decimal text, an integer-valued one included; without the
// mark an element is a raw slot, which replay cannot tell from a float, so it is skipped.
fn check_float_vec_elements() -> i32 [io] {
    let kv: String = String::from("v.len=3,v.elem=f64,v[0]=3,v[1]=-2.5,v[2]=NaN");
    let want: String = str2s(vec_head(String::from("Vec<f64>")), String::from(" __replay_v.push(3.0); __replay_v.push((0.0 - 2.5)); __replay_v.push((0.0 / 0.0)); __replay_v }"));
    if vec_lit(String::from("fvf"), kv) != want { return 241; }
    if agg(String::from("fvf"), 0, String::from("v.len=1,v[0]=3")).reason.len() == 0 { return 242; }
    if agg(String::from("fvf"), 0, String::from("v.len=1,v.elem=f32,v[0]=3")).reason.len() == 0 { return 243; }
    if agg(String::from("fvf"), 0, String::from("v.len=2,v.elem=f64,v[0]=3")).reason.len() == 0 { return 244; }
    if agg(String::from("fvf"), 0, String::from("v.len=1,v.elem=f64,v[0]=x")).reason.len() == 0 { return 245; }
    if agg(String::from("fvf32"), 0, String::from("v.len=1,v.elem=f32,v[0]=2.5")).reason.len() == 0 { return 246; }
    if vec_lit(String::from("fvf"), String::from("v.len=0,v.elem=f64")) != str2s(vec_head(String::from("Vec<f64>")), String::from(" __replay_v }")) { return 247; }
    0
}

fn check_string_arg() -> i32 [io] {
    let head: String = String::from("{ let __replay_s: String = String::from(\"\");");
    if lit_of(String::from("fstr"), String::from("")) != str2s(head, String::from(" __replay_s }")) { return 221; }
    let bytes: String = str2s(head, String::from(" __replay_s.push_byte(104); __replay_s.push_byte(1); __replay_s.push_byte(0); __replay_s }"));
    if lit_of(String::from("fstr"), String::from("s.len=3,s[0]=104,s[1]=257,s[2]=0")) != bytes { return 222; }
    if agg(String::from("fstr"), 0, String::from("s.len=1")).reason.len() == 0 { return 223; }
    if agg(String::from("fstr"), 0, String::from("s.len=1,s[0]=x")).reason.len() == 0 { return 224; }
    if agg(String::from("fstr"), 0, String::from("s.len=2,s[0]=1")).reason.len() == 0 { return 225; }
    if agg(String::from("fstr"), 0, String::from("s.len=1,s[0]=65")).ty_text != String::from("String") { return 226; }
    0
}

fn main() -> i32 [io] {
    let rw: i32 = check_wide_and_float_fields();
    if rw != 0 { return rw; }
    let rs: i32 = check_scalar_literals();
    if rs != 0 { return rs; }
    let rf: i32 = check_float_literals();
    if rf != 0 { return rf; }
    let r16: i32 = check_vec_arg();
    if r16 != 0 { return r16; }
    let r23: i32 = check_wide_vec_elements();
    if r23 != 0 { return r23; }
