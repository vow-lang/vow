module TestVcVecModel

use ir
use verifier
use vc_solver
use vc_exec
use vc_smt
use vc_term
use vc_vecmodel

// Two `Vec`/`String` parameters: `p0`'s length constant is declared at header
// position 2 and `p3`'s at 20, and claim 0's query holds the first 10 commands,
// so only the first is in its prefix.
fn two_vec_claims() -> VcClaims {
    let cs: VcClaims = VcClaims {
        arena: vc_arena_new(),
        header: vc_script_new(),
        assumed: Vec::new(),
        kinds: Vec::new(),
        frames: Vec::new(),
        fr: vc_frames_new(),
        pre_only: false,
        step: false,
        hyp_now: false,
        vow_ids: Vec::new(),
        labels: Vec::new(),
        ostarts: Vec::new(),
        olens: Vec::new(),
        negated_goals: Vec::new(),
        header_lens: Vec::new(),
        assumed_lens: Vec::new(),
        model_names: Vec::new(),
        model_params: Vec::new(),
        model_paths: Vec::new(),
        model_tys: Vec::new(),
        model_widths: Vec::new(),
        model_slots: Vec::new(),
        model_hdr: Vec::new(),
        model_ambig: Vec::new(),
        hook_vars: Vec::new(),
        map_vars: Vec::new(),
        vec_param: Vec::new(),
        vec_arr: Vec::new(),
        vec_len: Vec::new(),
        vec_hdr: Vec::new(),
        vec_wide: Vec::new(),
        vec_path: Vec::new(),
        vec_handle: Vec::new(),
    };
    cs.header_lens.push(10);
    cs.model_names.push(String::from("p0_vlen"));
    cs.model_params.push(0);
    cs.model_paths.push(String::from(""));
    cs.model_tys.push(ITY_U64());
    cs.model_widths.push(64);
    cs.model_slots.push(VC_SLOT_VEC_LEN());
    cs.model_hdr.push(2);
    cs.model_names.push(String::from("p3_vlen"));
    cs.model_params.push(3);
    cs.model_paths.push(String::from(""));
    cs.model_tys.push(ITY_U64());
    cs.model_widths.push(64);
    cs.model_slots.push(VC_SLOT_VEC_LEN());
    cs.model_hdr.push(20);
    cs.vec_param.push(0);
    cs.vec_arr.push(String::from("p0_varr"));
    cs.vec_len.push(String::from("p0_vlen"));
    cs.vec_hdr.push(2);
    cs.vec_wide.push(-1);
    cs.vec_param.push(3);
    cs.vec_arr.push(String::from("p3_varr"));
    cs.vec_len.push(String::from("p3_vlen"));
    cs.vec_hdr.push(20);
    cs.vec_wide.push(-1);
    cs
}

fn check_only_declared_vecs_are_read() -> i64 {
    let cs: VcClaims = two_vec_claims();
    let vecs: Vec<i64> = vc_cex_vecs(cs, 0);
    if vecs.len() != 1 || vecs[0] != 0 { return 1; }
    let names: Vec<String> = Vec::new();
    let widths: Vec<i64> = Vec::new();
    vc_append_vec_projection(cs, vecs, 8, vc_script_new(), names, widths);
    if names.len() != 8 { return 2; }
    if names[0] != String::from("p0_varr_e0") { return 3; }
    if names[7] != String::from("p0_varr_e7") { return 4; }
    cs.header_lens[0] = 21;
    if vc_cex_vecs(cs, 0).len() != 2 { return 5; }
    let both: Vec<String> = Vec::new();
    let both_widths: Vec<i64> = Vec::new();
    vc_append_vec_projection(cs, vc_cex_vecs(cs, 0), 8, vc_script_new(), both, both_widths);
    if both.len() != 16 { return 6; }
    if both[8] != String::from("p3_varr_e0") { return 7; }
    0
}

fn answer_with(count: u64) -> VcSolverAnswer {
    let values: Vec<i64> = Vec::new();
    let highs: Vec<i64> = Vec::new();
    let mut i: u64 = 0;
    while i < count {
        values.push(0);
        highs.push(0);
        i = i + 1;
    }
    VcSolverAnswer { verdict: VC_ANS_SAT(), values: values, highs: highs, raw: String::from("") }
}

fn check_regular_count() -> i64 {
    let cs: VcClaims = two_vec_claims();
    let n: u64 = vc_claim_model_count(cs, 0);
    if n != 1 { return 10; }
    if vc_answer_regular_count(cs, 0, answer_with(n)) != n { return 11; }
    if vc_answer_elems_per_vec(cs, 0, answer_with(n)) != 0 { return 12; }
    if vc_answer_regular_count(cs, 0, answer_with(n + 8)) != n { return 13; }
    if vc_answer_elems_per_vec(cs, 0, answer_with(n + 8)) != 8 { return 14; }
    cs.header_lens[0] = 21;
    let n2: u64 = vc_claim_model_count(cs, 0);
    if vc_answer_elems_per_vec(cs, 0, answer_with(n2 + 128)) != 64 { return 15; }
    if vc_answer_regular_count(cs, 0, answer_with(n2)) != n2 { return 16; }
    0
}

fn check_bounds_grow() -> i64 {
    if vc_next_vec_bound(2) != 8 { return 20; }
    if vc_next_vec_bound(8) != 64 { return 21; }
    if vc_next_vec_bound(64) != VC_CEX_VEC_MAX() { return 22; }
    if vc_next_vec_bound(VC_CEX_VEC_MAX()) <= VC_CEX_VEC_MAX() { return 23; }
    0
}

// The element definitions are `define-fun`s of a `select` of the array, so the
// solver answers them under a plain name.
fn check_elements_are_defined_from_the_array() -> i64 {
    let cs: VcClaims = two_vec_claims();
    let s: SmtScript = vc_script_new();
    let names: Vec<String> = Vec::new();
    let widths: Vec<i64> = Vec::new();
    vc_append_vec_projection(cs, vc_cex_vecs(cs, 0), 4, s, names, widths);
    if s.kinds.len() != 4 { return 30; }
    let text: String = vc_command_text(cs.arena, s, 1);
    if text != String::from("(define-fun p0_varr_e1 () (_ BitVec 64) (select p0_varr #x0000000000000001))") { return 31; }
    0
}

// An element of a wide `Vec` is one 128-bit entry: the two limbs of the array joined.
fn check_wide_elements_are_128_bit() -> i64 {
    let cs: VcClaims = two_vec_claims();
    cs.vec_wide[0] = ITY_I128();
    let names: Vec<String> = Vec::new();
    let widths: Vec<i64> = Vec::new();
    vc_append_vec_projection(cs, vc_cex_vecs(cs, 0), 3, vc_script_new(), names, widths);
    if widths.len() != 3 || widths[0] != 128 || widths[2] != 128 { return 60; }
    let s: SmtScript = vc_script_new();
    vc_append_vec_projection(cs, vc_cex_vecs(cs, 0), 2, s, Vec::new(), Vec::new());
    if s.kinds.len() != 2 { return 61; }
    let text: String = vc_command_text(cs.arena, s, 1);
    let want: String = String::from("(define-fun p0_varr_e1 () (_ BitVec 128) (concat (select p0_varr #x0000000000000003) (select p0_varr #x0000000000000002)))");
    if text != want { return 62; }
    let narrow: VcClaims = two_vec_claims();
    let nw: Vec<i64> = Vec::new();
    vc_append_vec_projection(narrow, vc_cex_vecs(narrow, 0), 2, vc_script_new(), Vec::new(), nw);
    if nw[0] != 64 || nw[1] != 64 { return 63; }
    0
}

// The projection appends one coordinated request to existing script/name/width
// prefixes. Raw and float slots stay 64-bit; signed and unsigned wide elements
// each join two slots. The late parameter is absent from every output.
fn add_projection_vec(cs: VcClaims, p: i64, arr: String, ty: i64, hdr: i64) {
    cs.vec_param.push(p);
    cs.vec_arr.push(arr);
    cs.vec_len.push(String::from("unused_len"));
    cs.vec_hdr.push(hdr);
    cs.vec_wide.push(ty);
}

fn check_mixed_projection_stays_aligned() -> i64 {
    let cs: VcClaims = two_vec_claims();
    cs.vec_hdr[1] = 3;
    cs.vec_wide[1] = ITY_I128();
    add_projection_vec(cs, 6, String::from("p6_varr"), ITY_U128(), 4);
    add_projection_vec(cs, 7, String::from("p7_varr"), ITY_F32(), 5);
    add_projection_vec(cs, 8, String::from("p8_varr"), ITY_F64(), 6);
    add_projection_vec(cs, 9, String::from("late_varr"), ITY_U128(), 20);
    let s: SmtScript = vc_script_new();
    vc_script_check_sat(s);
    let names: Vec<String> = Vec::new();
    names.push(String::from("regular"));
    let widths: Vec<i64> = Vec::new();
    widths.push(16);
    vc_append_vec_projection(cs, vc_cex_vecs(cs, 0), 2, s, names, widths);
    if names.len() != 11 || widths.len() != 11 || s.kinds.len() != 11 { return 70; }
    if names[0] != String::from("regular") || widths[0] != 16 { return 71; }
    if vc_command_text(cs.arena, s, 0) != String::from("(check-sat)") { return 72; }
    let expected_names: Vec<String> = Vec::new();
    expected_names.push(String::from("p0_varr_e0"));
    expected_names.push(String::from("p0_varr_e1"));
    expected_names.push(String::from("p3_varr_e0"));
    expected_names.push(String::from("p3_varr_e1"));
    expected_names.push(String::from("p6_varr_e0"));
    expected_names.push(String::from("p6_varr_e1"));
    expected_names.push(String::from("p7_varr_e0"));
    expected_names.push(String::from("p7_varr_e1"));
    expected_names.push(String::from("p8_varr_e0"));
    expected_names.push(String::from("p8_varr_e1"));
    let expected_widths: Vec<i64> = Vec::new();
    expected_widths.push(64);
    expected_widths.push(64);
    expected_widths.push(128);
    expected_widths.push(128);
    expected_widths.push(128);
    expected_widths.push(128);
    expected_widths.push(64);
    expected_widths.push(64);
    expected_widths.push(64);
    expected_widths.push(64);
    let expected_defs: Vec<String> = Vec::new();
    expected_defs.push(String::from("(define-fun p0_varr_e0 () (_ BitVec 64) (select p0_varr #x0000000000000000))"));
    expected_defs.push(String::from("(define-fun p0_varr_e1 () (_ BitVec 64) (select p0_varr #x0000000000000001))"));
    expected_defs.push(String::from("(define-fun p3_varr_e0 () (_ BitVec 128) (concat (select p3_varr #x0000000000000001) (select p3_varr #x0000000000000000)))"));
    expected_defs.push(String::from("(define-fun p3_varr_e1 () (_ BitVec 128) (concat (select p3_varr #x0000000000000003) (select p3_varr #x0000000000000002)))"));
    expected_defs.push(String::from("(define-fun p6_varr_e0 () (_ BitVec 128) (concat (select p6_varr #x0000000000000001) (select p6_varr #x0000000000000000)))"));
    expected_defs.push(String::from("(define-fun p6_varr_e1 () (_ BitVec 128) (concat (select p6_varr #x0000000000000003) (select p6_varr #x0000000000000002)))"));
    expected_defs.push(String::from("(define-fun p7_varr_e0 () (_ BitVec 64) (select p7_varr #x0000000000000000))"));
    expected_defs.push(String::from("(define-fun p7_varr_e1 () (_ BitVec 64) (select p7_varr #x0000000000000001))"));
    expected_defs.push(String::from("(define-fun p8_varr_e0 () (_ BitVec 64) (select p8_varr #x0000000000000000))"));
    expected_defs.push(String::from("(define-fun p8_varr_e1 () (_ BitVec 64) (select p8_varr #x0000000000000001))"));
    let mut i: u64 = 0;
    while i < expected_names.len() {
        if names[i + 1] != expected_names[i] { return 73; }
        if widths[i + 1] != expected_widths[i] { return 74; }
        if vc_command_text(cs.arena, s, i + 1) != expected_defs[i] { return 75; }
        i = i + 1;
    }
    0
}

fn check_empty_projection_keeps_prefixes() -> i64 {
    let cs: VcClaims = two_vec_claims();
    let s: SmtScript = vc_script_new();
    vc_script_check_sat(s);
    let names: Vec<String> = Vec::new();
    names.push(String::from("regular"));
    let widths: Vec<i64> = Vec::new();
    widths.push(64);
    vc_append_vec_projection(cs, vc_cex_vecs(cs, 0), 0, s, names, widths);
    if names.len() != 1 || names[0] != String::from("regular") { return 80; }
    if widths.len() != 1 || widths[0] != 64 { return 81; }
    if s.kinds.len() != 1 || vc_command_text(cs.arena, s, 0) != String::from("(check-sat)") { return 82; }
    vc_append_vec_projection(cs, Vec::new(), 8, s, names, widths);
    if names.len() != 1 || widths.len() != 1 || s.kinds.len() != 1 { return 83; }
    0
}

fn check_max_vec_len() -> i64 {
    let cs: VcClaims = two_vec_claims();
    cs.header_lens[0] = 21;
    let a: VcSolverAnswer = answer_with(2 + 4);
    a.values[0] = 3;
    a.values[1] = 7;
    if vc_answer_max_vec_len(cs, 0, a) != 7 { return 40; }
    let bare: VcSolverAnswer = answer_with(2);
    bare.values[0] = 9;
    bare.values[1] = 1;
    if vc_answer_max_vec_len(cs, 0, bare) != 9 { return 41; }
    0
}

// A counterexample's length is the model's to choose, so the recheck that pins
// the scalars of a hook-reaching claim leaves it free.
fn check_pin_leaves_lengths_free() -> i64 {
    let cs: VcClaims = two_vec_claims();
    cs.header_lens[0] = 21;
    let a: VcSolverAnswer = answer_with(2);
    a.values[0] = 3;
    a.values[1] = 4;
    let s: SmtScript = vc_script_new();
    vc_pin_model(cs, a, s);
    if s.kinds.len() != 0 { return 50; }
    0
}

// A collection a struct parameter holds in a field (`vc_held`) is read through its handle:
// its elements are `select`s of the shared element array at the handle joined with the index,
// and they are named after the handle, so two held collections never share a name.
fn held_vec_claims() -> VcClaims {
    let cs: VcClaims = two_vec_claims();
    cs.model_names[1] = String::from("p0f0s64_hl");
    cs.model_params[1] = 0;
    cs.model_paths[1] = String::from(".0");
    cs.model_hdr[1] = 5;
    cs.model_names.push(String::from("p3_vlen"));
    cs.model_params.push(3);
    cs.model_paths.push(String::from(""));
    cs.model_tys.push(ITY_U64());
    cs.model_widths.push(64);
    cs.model_slots.push(VC_SLOT_VEC_LEN());
    cs.model_hdr.push(20);
    cs.vec_path.push(String::from(""));
    cs.vec_path.push(String::from(""));
    cs.vec_handle.push(String::from(""));
    cs.vec_handle.push(String::from(""));
    cs.vec_param.push(0);
    cs.vec_arr.push(String::from("helem"));
    cs.vec_len.push(String::from("p0f0s64_hl"));
    cs.vec_hdr.push(5);
    cs.vec_wide.push(-1);
    cs.vec_path.push(String::from(".0"));
    cs.vec_handle.push(String::from("p0f0s64"));
    cs
}

fn check_held_collections_are_read_through_the_handle() -> i64 {
    let cs: VcClaims = held_vec_claims();
    let vecs: Vec<i64> = vc_cex_vecs(cs, 0);
    if vecs.len() != 2 || vecs[0] != 0 || vecs[1] != 2 { return 90; }
    if vc_claim_model_count(cs, 0) != 2 { return 91; }
    let s: SmtScript = vc_script_new();
    let names: Vec<String> = Vec::new();
    let widths: Vec<i64> = Vec::new();
    vc_append_vec_projection(cs, vecs, 2, s, names, widths);
    if names.len() != 4 || names[2] != String::from("p0f0s64_e0") || names[3] != String::from("p0f0s64_e1") { return 92; }
    let want: String = String::from("(define-fun p0f0s64_e1 () (_ BitVec 64) (select helem (concat p0f0s64 #x0000000000000001)))");
    if vc_command_text(cs.arena, s, 3) != want { return 93; }
    if vc_command_text(cs.arena, s, 1) != String::from("(define-fun p0_varr_e1 () (_ BitVec 64) (select p0_varr #x0000000000000001))") { return 94; }
    // two regular entries and two collections: the answer lists the elements of both
    if vc_answer_elems_per_vec(cs, 0, answer_with(2 + 8)) != 4 { return 95; }
    if vc_answer_regular_count(cs, 0, answer_with(2 + 8)) != 2 { return 96; }
    0
}

// A held collection's length is a model entry like a parameter's, so the bisection that
// shrinks the lengths sees it.
fn check_held_length_counts_for_the_shrink() -> i64 {
    let cs: VcClaims = held_vec_claims();
    let a: VcSolverAnswer = answer_with(2);
    a.values[0] = 3;
    a.values[1] = 9;
    if vc_answer_max_vec_len(cs, 0, a) != 9 { return 100; }
    let s: SmtScript = vc_script_new();
    vc_pin_model(cs, a, s);
    if s.kinds.len() != 0 { return 101; }
    0
}

fn main() -> i32 {
    let mut r: i64 = check_only_declared_vecs_are_read();
    if r == 0 { r = check_regular_count(); }
    if r == 0 { r = check_bounds_grow(); }
    if r == 0 { r = check_elements_are_defined_from_the_array(); }
    if r == 0 { r = check_wide_elements_are_128_bit(); }
    if r == 0 { r = check_mixed_projection_stays_aligned(); }
    if r == 0 { r = check_empty_projection_keeps_prefixes(); }
    if r == 0 { r = check_max_vec_len(); }
    if r == 0 { r = check_pin_leaves_lengths_free(); }
    if r == 0 { r = check_held_collections_are_read_through_the_handle(); }
    if r == 0 { r = check_held_length_counts_for_the_shrink(); }
    i64_to_i32_wrap(r)
}
