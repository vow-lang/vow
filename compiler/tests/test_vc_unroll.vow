module TestVcUnroll

use ir
use ir_printer
use ir_dominance
use vc_ops
use vc_gate
use vc_cfg
use vc_unroll
use tests.builders

fn pair(a: i64, b: i64) -> Vec<i64> {
    let v: Vec<i64> = Vec::new();
    v.push(a);
    v.push(b);
    v
}

// while i < 8 { i = i + 1 } with an invariant, as the lowerer shapes it.
fn count_up() -> IrFunction {
    let e: Vec<IrInst> = Vec::new();
    e.push(mk_inst_const_i64(0, 0));
    e.push(mk_inst_upsilon(1, 0, 3));
    e.push(mk_inst_jump(2, 1));
    let h: Vec<IrInst> = Vec::new();
    h.push(mk_inst_phi(3, ITY_I64()));
    h.push(mk_inst_const_i64(4, 8));
    h.push(mk_inst(5, IOP_LT(), ITY_BOOL(), pair(3, 4)));
    let one: Vec<i64> = Vec::new();
    one.push(5);
    h.push(ir_inst_new(6, IOP_VOW_INV(), ITY_UNIT(), one, IDATA_VOW_ID(), 7, 0, String::from("")));
    h.push(mk_inst_upsilon(7, 3, 20));
    h.push(mk_inst_branch(8, 5, 2, 3));
    let b: Vec<IrInst> = Vec::new();
    b.push(mk_inst_const_i64(9, 1));
    b.push(mk_inst_add(10, 3, 9));
    b.push(mk_inst_upsilon(11, 10, 3));
    b.push(mk_inst_jump(12, 1));
    let x: Vec<IrInst> = Vec::new();
    x.push(mk_inst_phi(20, ITY_I64()));
    x.push(mk_inst_return(21, 20));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, e));
    blocks.push(mk_block(1, h));
    blocks.push(mk_block(2, b));
    blocks.push(mk_block(3, x));
    mk_function(1, String::from("count_up"), Vec::new(), ITY_I64(), blocks)
}

fn inst_count(f: IrFunction) -> i64 {
    let mut n: i64 = 0;
    let mut b: u64 = 0;
    while b < f.blocks.len() {
        let blk: IrBlock = f.blocks[b];
        n = n + blk.insts.len() as i64;
        b = b + 1;
    }
    n
}

fn sink_count(f: IrFunction) -> i64 {
    let mut n: i64 = 0;
    let mut b: u64 = 0;
    while b < f.blocks.len() {
        let blk: IrBlock = f.blocks[b];
        let last: IrInst = blk.insts[blk.insts.len() - 1];
        if vc_is_unwind_sink(last) {
            n = n + 1;
        }
        b = b + 1;
    }
    n
}

fn upsilon_count(f: IrFunction) -> i64 {
    let mut n: i64 = 0;
    let mut b: u64 = 0;
    while b < f.blocks.len() {
        let blk: IrBlock = f.blocks[b];
        let mut i: u64 = 0;
        while i < blk.insts.len() {
            let inst: IrInst = blk.insts[i];
            if inst.op == IOP_UPSILON() {
                n = n + 1;
            }
            i = i + 1;
        }
        b = b + 1;
    }
    n
}

fn check_structure() -> i64 {
    let f: IrFunction = count_up();
    if vc_cfg_detail(f, vc_ty_table(f)).len() != 0 { return 1; }
    if vc_unrolled_detail(f, vc_ty_table(f)).len() == 0 { return 2; }

    let u: VcUnrolled = vc_unroll(f, 2);
    if u.status != VC_UNROLL_OK() || !u.looped { return 3; }
    let g: IrFunction = u.f;
    // entry + 3 header + 3 body + exit + sink
    if g.blocks.len() != 9 { return 4; }
    let first: IrBlock = g.blocks[0];
    let head: IrInst = first.insts[0];
    if first.id != 0 || head.op != IOP_CONST_I64() { return 5; }
    if sink_count(g) != 1 { return 6; }
    let tys: Vec<i64> = vc_ty_table(g);
    let d: String = vc_unrolled_detail(g, tys);
    if d.len() != 0 { return 7; }
    if ir_non_dominating_read(g).len() != 0 { return 8; }
    // the cut copy of the body drops its back-edge Upsilon
    if upsilon_count(g) != 1 + 3 + 2 { return 9; }
    // 3 + 3*6 + (4 + 4 + 3) + 2 + 1
    if inst_count(g) != 35 { return 10; }
    0
}

fn check_bounds_grow() -> i64 {
    let f: IrFunction = count_up();
    let mut k: i64 = 0;
    let mut prev: i64 = 0;
    while k < 6 {
        let g: IrFunction = vc_unroll(f, k).f;
        let n: i64 = g.blocks.len() as i64;
        if n != 3 + 2 * (k + 1) { return 20; }
        if n <= prev { return 21; }
        prev = n;
        k = k + 1;
    }
    0
}

fn check_deterministic() -> i64 {
    let a: String = print_function(vc_unroll(count_up(), 3).f);
    let b: String = print_function(vc_unroll(count_up(), 3).f);
    if a != b { return 30; }
    if a.len() == 0 { return 31; }
    0
}

fn check_too_large() -> i64 {
    let f: IrFunction = count_up();
    if vc_unroll_capped(f, 4, 10).status != VC_UNROLL_TOO_LARGE() { return 40; }
    if vc_unroll_capped(f, 0, 100000).status != VC_UNROLL_OK() { return 41; }
    0
}

fn check_loop_free_unchanged() -> i64 {
    let i: Vec<IrInst> = Vec::new();
    i.push(mk_inst_const_i64(0, 5));
    i.push(mk_inst_return(1, 0));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, i));
    let f: IrFunction = mk_function(1, String::from("k"), Vec::new(), ITY_I64(), blocks);
    let u: VcUnrolled = vc_unroll(f, 8);
    if u.status != VC_UNROLL_OK() || u.looped { return 50; }
    if print_function(u.f) != print_function(f) { return 51; }
    0
}

// block 0: branch(c, 1, 5); 1: outer header branch(c, 2, 5); 2 -> 3;
// 3: inner header branch(c, 4, 6); 4 -> 3; 6 -> 1; 5: return.
fn nested() -> IrFunction {
    let edges: Vec<i64> = Vec::new();
    edges.push(1); edges.push(-2);
    edges.push(2); edges.push(5);
    edges.push(3); edges.push(-2);
    edges.push(4); edges.push(6);
    edges.push(3); edges.push(-2);
    edges.push(-1); edges.push(-1);
    edges.push(1); edges.push(-2);
    let blocks: Vec<IrBlock> = Vec::new();
    let mut k: u64 = 0;
    while k < 7 {
        let insts: Vec<IrInst> = Vec::new();
        let a: i64 = edges[k * 2];
        let b: i64 = edges[k * 2 + 1];
        let base: i64 = (k as i64) * 3 + 1;
        if k == 0 {
            insts.push(mk_inst_const_bool(0, 1));
        }
        if a < 0 {
            insts.push(mk_inst_const_i64(base, 0));
            insts.push(mk_inst_return(base + 1, base));
        } else if b == -2 {
            insts.push(mk_inst_jump(base, a));
        } else {
            insts.push(mk_inst_branch(base, 0, a, b));
        }
        blocks.push(mk_block(k as i64, insts));
        k = k + 1;
    }
    mk_function(2, String::from("nested"), Vec::new(), ITY_I64(), blocks)
}

fn check_nested() -> i64 {
    let f: IrFunction = nested();
    if vc_cfg_detail(f, vc_ty_table(f)).len() != 0 { return 60; }
    let u: VcUnrolled = vc_unroll(f, 1);
    if u.status != VC_UNROLL_OK() { return 61; }
    let g: IrFunction = u.f;
    // 1 + 2 + 2 + 4 + 4 + 2 + 1 instances, one sink
    if g.blocks.len() != 17 { return 62; }
    if sink_count(g) != 1 { return 63; }
    if vc_unrolled_detail(g, vc_ty_table(g)).len() != 0 { return 64; }
    0
}

fn main() -> i32 {
    let mut r: i64 = check_structure();
    if r == 0 { r = check_bounds_grow(); }
    if r == 0 { r = check_deterministic(); }
    if r == 0 { r = check_too_large(); }
    if r == 0 { r = check_loop_free_unchanged(); }
    if r == 0 { r = check_nested(); }
    i64_to_i32_wrap(r)
}
