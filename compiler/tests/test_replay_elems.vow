module TestReplayElems

use lexer
use ast
use diag
use parser
use replay_main
use replay_elems
use replay_listed

fn parse_src(source: String) -> Module [io] {
    let dctx: DiagCtx = diag_ctx_new();
    let arena: AstArena = arena_new();
    parse_module_into(lex(source), arena, dctx, String::from("entry.vow"))
}

fn elems_src() -> String {
    let s: String = String::from("");
    s.push_str(String::from("module T\n"));
    s.push_str(String::from("type Who = Person;\n"));
    s.push_str(String::from("struct Person { age: i64 }\n"));
    s.push_str(String::from("struct Other { age: i64 }\n"));
    s.push_str(String::from("linear struct Tok { n: i64 }\n"));
    s.push_str(String::from("fn fone(p: Person, people: Vec<Person>) -> i64 { 0 }\n"));
    s.push_str(String::from("fn ftwo(p: Person, q: Person, people: Vec<Person>) -> i64 { 0 }\n"));
    s.push_str(String::from("fn fother(o: Other, people: Vec<Person>) -> i64 { 0 }\n"));
    s.push_str(String::from("fn falias(p: Who, people: Vec<Who>) -> i64 { 0 }\n"));
    s.push_str(String::from("fn fgrid(p: Person, grid: Vec<Vec<i64>>) -> i64 { 0 }\n"));
    s.push_str(String::from("fn ftok(people: Vec<Tok>) -> i64 { 0 }\n"));
    s.push_str(String::from("fn fstrs(strs: Vec<String>) -> i64 { 0 }\n"));
    s
}

fn value_lets(fname: String, pi: i64, kv: String, lets: Vec<String>) -> ReplayArg [io] {
    let m: Module = parse_src(elems_src());
    let names: Vec<String> = Vec::new();
    let vals: Vec<String> = Vec::new();
    let mut start: u64 = 0u64;
    let mut i: u64 = 0u64;
    while i <= kv.len() {
        if i == kv.len() || kv.byte_at(i) == 44 {
            if i > start {
                let pair: String = kv.substring(start, i);
                let mut at: u64 = 0u64;
                while pair.byte_at(at) != 61 { at = at + 1u64; }
                names.push(pair.substring(0u64, at));
                vals.push(pair.substring(at + 1u64, pair.len()));
            }
            start = i + 1u64;
        }
        i = i + 1u64;
    }
    let objs: ReplayObjs = replay_param_objects(m, fname, names, vals);
    let avoid: Vec<i64> = Vec::new();
    let r: ReplayArg = replay_param_value(m, fname, pi, names, vals, avoid, objs);
    let mut i: u64 = 0u64;
    while i < objs.hlets.len() {
        lets.push(objs.hlets[i]);
        i = i + 1u64;
    }
    r
}

fn value(fname: String, pi: i64, kv: String) -> ReplayArg [io] {
    value_lets(fname, pi, kv, Vec::new())
}

fn joined(lets: Vec<String>) -> String {
    let out: String = String::from("");
    let mut i: u64 = 0u64;
    while i < lets.len() {
        out.push_str(lets[i]);
        i = i + 1u64;
    }
    out
}

fn check_addresses() -> i32 {
    match replay_addr_bits(String::from("-1")) {
        Option::Some(b) => { if b != 18446744073709551615u64 { return 1; } },
        Option::None => { return 2; },
    }
    match replay_addr_bits(String::from("18446744073709551614")) {
        Option::Some(b) => { if b != 18446744073709551614u64 { return 3; } },
        Option::None => { return 4; },
    }
    match replay_addr_bits(String::from("x")) {
        Option::Some(b) => { return 5; },
        Option::None => {},
    }
    0
}

// An element is the object of the parameter whose `.addr` is its address, compared as bits: the
// element prints unsigned and the address signed.
fn check_element_is_parameter() -> i32 [io] {
    let kv: String = String::from("p.addr=-1,p.0=4,people.addr=-2,people.len=2,people[0]=18446744073709551615,people[1]=18446744073709551615");
    let r: ReplayArg = value(String::from("fone"), 1, kv);
    if r.reason.len() != 0 { return 11; }
    if r.ty_text != String::from("Vec<Person>") { return 12; }
    if r.lit != String::from("{ let __replay_v: Vec<Person> = Vec::new(); __replay_v.push(__replay_a0); __replay_v.push(__replay_a0); __replay_v }") { return 13; }
    if r.deps != String::from("__replay_a0 __replay_a0 ") { return 14; }
    let two: String = String::from("p.addr=-1,q.addr=-2,p.alias=1,q.alias=2,people.len=1,people[0]=18446744073709551614");
    let t: ReplayArg = value(String::from("ftwo"), 2, two);
    if t.reason.len() != 0 || t.deps != String::from("__replay_a1 ") { return 15; }
    let resolved: ReplayArg = value(String::from("falias"), 1, String::from("p.addr=7,people.len=1,people[0]=7"));
    if resolved.reason.len() != 0 || resolved.ty_text != String::from("Vec<Person>") || resolved.deps != String::from("__replay_a0 ") { return 16; }
    0
}

// An element that names no parameter of its type is an object whose fields the counterexample does not
// list, so there is nothing to rebuild; the Vec itself and a parameter of another type are no such object.
fn check_element_is_unknown() -> i32 [io] {
    let own: ReplayArg = value(String::from("fone"), 1, String::from("p.addr=-1,people.addr=0,people.len=1,people[0]=0"));
    if own.reason.len() == 0 { return 21; }
    let other: ReplayArg = value(String::from("fother"), 1, String::from("o.addr=5,people.len=1,people[0]=5"));
    if other.reason.len() == 0 { return 22; }
    let unlisted: ReplayArg = value(String::from("fone"), 1, String::from("p.addr=-1,people.len=2,people[0]=18446744073709551615"));
    if unlisted.reason.len() == 0 { return 23; }
    let mixed: ReplayArg = value(String::from("fone"), 1, String::from("p.addr=-1,people.len=2,people[0]=18446744073709551615,people[1]=4"));
    if mixed.reason.len() == 0 { return 26; }
    let shared: ReplayArg = value(String::from("ftwo"), 2, String::from("p.addr=3,q.addr=3,p.alias=1,q.alias=2,people.len=1,people[0]=3"));
    if shared.reason.len() == 0 { return 24; }
    let lin: ReplayArg = value(String::from("ftok"), 0, String::from("people.len=1,people[0]=0"));
    if lin.reason.len() == 0 { return 25; }
    0
}

// An element whose fields the counterexample lists (`people[0].0`) is rebuilt from them; elements with
// one address are one binding pushed twice, and elements with two addresses are two.
fn check_element_listed() -> i32 [io] {
    let l1: Vec<String> = Vec::new();
    let one: ReplayArg = value_lets(String::from("fone"), 1, String::from("p.addr=-1,people.addr=0,people.len=1,people[0]=0,people[0].0=4"), l1);
    if one.reason.len() != 0 { return 41; }
    if one.lit != String::from("{ let __replay_v: Vec<Person> = Vec::new(); __replay_v.push(__replay_h0); __replay_v }") { return 42; }
    if joined(l1) != String::from("    let __replay_h0: Person = Person { age: 4 };\n") || one.deps != String::from("__replay_h0 ") { return 51; }
    let l2: Vec<String> = Vec::new();
    let same: ReplayArg = value_lets(String::from("fone"), 1, String::from("p.addr=-1,people.len=2,people[0]=0,people[1]=0,people[0].0=4,people[1].0=4"), l2);
    if same.reason.len() != 0 { return 43; }
    if same.lit != String::from("{ let __replay_v: Vec<Person> = Vec::new(); __replay_v.push(__replay_h0); __replay_v.push(__replay_h0); __replay_v }") { return 44; }
    if l2.len() != 1u64 { return 52; }
    let l3: Vec<String> = Vec::new();
    let apart: ReplayArg = value_lets(String::from("fone"), 1, String::from("p.addr=-1,people.len=2,people[0]=0,people[1]=1,people[0].0=4,people[1].0=-5"), l3);
    if apart.reason.len() != 0 { return 45; }
    if apart.lit != String::from("{ let __replay_v: Vec<Person> = Vec::new(); __replay_v.push(__replay_h0); __replay_v.push(__replay_h1); __replay_v }") { return 46; }
    if joined(l3) != String::from("    let __replay_h0: Person = Person { age: 4 };\n    let __replay_h1: Person = Person { age: -5 };\n") { return 53; }
    let partial: ReplayArg = value(String::from("fone"), 1, String::from("p.addr=-1,people.len=2,people[0]=0,people[1]=1,people[0].0=4"));
    if partial.reason.len() == 0 { return 47; }
    let other: ReplayArg = value(String::from("fother"), 1, String::from("o.addr=5,people.len=1,people[0]=5,people[0].0=4"));
    if other.reason.len() == 0 { return 49; }
    let vec_addr: ReplayArg = value(String::from("fone"), 1, String::from("p.addr=-1,people.addr=0,people.len=1,people[0]=0,people[0].0=4"));
    if vec_addr.reason.len() != 0 { return 50; }
    let named: ReplayArg = value(String::from("fone"), 1, String::from("p.addr=0,people.len=1,people[0]=0,people[0].0=4"));
    if named.reason.len() != 0 || named.deps != String::from("__replay_a0 ") { return 48; }
    0
}

// A Vec the model never read, an empty Vec and a Vec of collections keep their existing handling.
fn check_other_vectors() -> i32 [io] {
    let empty: ReplayArg = value(String::from("fone"), 1, String::from("people.len=0"));
    if empty.reason.len() != 0 || empty.deps.len() != 0 { return 31; }
    let grid: ReplayArg = value(String::from("fgrid"), 1, String::from("grid.len=1,grid[0]=5"));
    if grid.reason.len() == 0 { return 32; }
    0
}

// A parameter that is a `Vec` of collections is built from the contents listed behind each element: a
// marked element is free, an unlisted one is not rebuilt, and elements with one address share a binding.
fn check_vec_parameters_of_collections() -> i32 [io] {
    let l1: Vec<String> = Vec::new();
    let rows: ReplayArg = value_lets(String::from("fgrid"), 1, String::from("grid.len=2,grid[0]=-1,grid[1]=-2,grid[0].contents=unconstrained,grid[1].len=1,grid[1][0]=5"), l1);
    if rows.reason.len() != 0 { return 61; }
    if rows.lit != String::from("{ let __replay_v: Vec<Vec<i64>> = Vec::new(); __replay_v.push(__replay_h0); __replay_v.push(__replay_h1); __replay_v }") { return 62; }
    if joined(l1) != String::from("    let __replay_h0: Vec<i64> = { let __replay_e: Vec<i64> = Vec::new(); __replay_e };\n    let __replay_h1: Vec<i64> = { let __replay_v: Vec<i64> = Vec::new(); __replay_v.push(5); __replay_v };\n") { return 63; }
    let l2: Vec<String> = Vec::new();
    let strs: ReplayArg = value_lets(String::from("fstrs"), 0, String::from("strs.len=2,strs[0]=5,strs[1]=5,strs[0].len=1,strs[0][0]=97"), l2);
    if strs.reason.len() != 0 || strs.lit != String::from("{ let __replay_v: Vec<String> = Vec::new(); __replay_v.push(__replay_h0); __replay_v.push(__replay_h0); __replay_v }") { return 64; }
    if joined(l2) != String::from("    let __replay_h0: String = { let __replay_s: String = String::from(\"\"); __replay_s.push_byte(97); __replay_s };\n") { return 65; }
    if value(String::from("fgrid"), 1, String::from("grid.len=1,grid[0]=-1,grid[0].contents=unlisted")).reason.len() == 0 { return 66; }
    let named: ReplayArg = value(String::from("fgrid"), 1, String::from("grid.len=1,grid[0]=-1"));
    if named.reason.len() == 0 { return 67; }
    let clash: ReplayArg = value(String::from("fgrid"), 1, String::from("grid.addr=-1,grid.len=1,grid[0]=-1,grid[0].len=0"));
    if clash.reason.len() == 0 { return 68; }
    let free_clash: ReplayArg = value(String::from("fgrid"), 1, String::from("grid.addr=-1,grid.len=1,grid[0]=-1,grid[0].contents=unconstrained"));
    if free_clash.reason.len() != 0 { return 69; }
    0
}

fn main() -> i32 [io] {
    let r1: i32 = check_addresses();
    if r1 != 0 { return r1; }
    let r2: i32 = check_element_is_parameter();
    if r2 != 0 { return r2; }
    let r3: i32 = check_element_is_unknown();
    if r3 != 0 { return r3; }
    let r4: i32 = check_element_listed();
    if r4 != 0 { return r4; }
    let r5: i32 = check_other_vectors();
    if r5 != 0 { return r5; }
    check_vec_parameters_of_collections()
}
