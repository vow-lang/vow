module TestVcInduct

use ir
use ir_printer
use ir_dominance
use vc_ops
use vc_gate
use vc_cfg
use vc_loops
use vc_exec
use vc_induct
use tests.builders

fn pair(a: i64, b: i64) -> Vec<i64> {
    let v: Vec<i64> = Vec::new();
    v.push(a);
    v.push(b);
    v
}

fn mk_inv(id: i64, cond: i64, vow_id: i64) -> IrInst {
    let one: Vec<i64> = Vec::new();
    one.push(cond);
    ir_inst_new(id, IOP_VOW_INV(), ITY_UNIT(), one, IDATA_VOW_ID(), vow_id, 0, String::from(""))
}

// while i < 8 { i = i + 1 } with an invariant in the header block, as the
// lowerer shapes it (same IR as test_vc_unroll.vow).
fn count_up() -> IrFunction {
    let e: Vec<IrInst> = Vec::new();
    e.push(mk_inst_const_i64(0, 0));
    e.push(mk_inst_upsilon(1, 0, 3));
    e.push(mk_inst_jump(2, 1));
    let h: Vec<IrInst> = Vec::new();
    h.push(mk_inst_phi(3, ITY_I64()));
    h.push(mk_inst_const_i64(4, 8));
    h.push(mk_inst(5, IOP_LT(), ITY_BOOL(), pair(3, 4)));
    h.push(mk_inv(6, 5, 7));
    h.push(mk_inst_upsilon(7, 3, 20));
    h.push(mk_inst_branch(8, 5, 2, 3));
    let b: Vec<IrInst> = Vec::new();
    b.push(mk_inst_const_i64(9, 1));
    b.push(mk_inst_add(10, 3, 9));
    b.push(mk_inst_upsilon(11, 10, 3));
    b.push(mk_inst_jump(12, 1));
    let x: Vec<IrInst> = Vec::new();
    x.push(mk_inst_phi(20, ITY_I64()));
    x.push(mk_inst_return(21, 20));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, e));
    blocks.push(mk_block(1, h));
    blocks.push(mk_block(2, b));
    blocks.push(mk_block(3, x));
    mk_function(1, String::from("count_up"), Vec::new(), ITY_I64(), blocks)
}

// The same loop with `invariant: i <= 8 && i >= 0`: the clause lowers to a
// header, a right-hand block, a short-circuit block and a merge block holding
// the `VowInv`, followed by the loop condition.
fn count_up_and() -> IrFunction {
    let e: Vec<IrInst> = Vec::new();
    e.push(mk_inst_const_i64(0, 0));
    e.push(mk_inst_upsilon(1, 0, 3));
    e.push(mk_inst_jump(2, 1));
    let h: Vec<IrInst> = Vec::new();
    h.push(mk_inst_phi(3, ITY_I64()));
    h.push(mk_inst_const_i64(4, 8));
    h.push(mk_inst(5, IOP_LE(), ITY_BOOL(), pair(3, 4)));
    h.push(mk_inst_branch(6, 5, 4, 5));
    let rhs: Vec<IrInst> = Vec::new();
    rhs.push(mk_inst_const_i64(7, 0));
    rhs.push(mk_inst(8, IOP_GE(), ITY_BOOL(), pair(3, 7)));
    rhs.push(mk_inst_upsilon(9, 8, 11));
    rhs.push(mk_inst_jump(10, 6));
    let short: Vec<IrInst> = Vec::new();
    short.push(mk_inst_const_bool(30, 0));
    short.push(mk_inst_upsilon(31, 30, 11));
    short.push(mk_inst_jump(32, 6));
    let m: Vec<IrInst> = Vec::new();
    m.push(mk_inst_phi(11, ITY_BOOL()));
    m.push(mk_inv(12, 11, 9));
    m.push(mk_inst(13, IOP_LT(), ITY_BOOL(), pair(3, 4)));
    m.push(mk_inst_upsilon(14, 3, 20));
    m.push(mk_inst_branch(15, 13, 2, 3));
    let b: Vec<IrInst> = Vec::new();
    b.push(mk_inst_const_i64(16, 1));
    b.push(mk_inst_add(17, 3, 16));
    b.push(mk_inst_upsilon(18, 17, 3));
    b.push(mk_inst_jump(19, 1));
    let x: Vec<IrInst> = Vec::new();
    x.push(mk_inst_phi(20, ITY_I64()));
    x.push(mk_inst_return(21, 20));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, e));
    blocks.push(mk_block(1, h));
    blocks.push(mk_block(2, b));
    blocks.push(mk_block(3, x));
    blocks.push(mk_block(4, rhs));
    blocks.push(mk_block(5, short));
    blocks.push(mk_block(6, m));
    mk_function(1, String::from("count_up_and"), Vec::new(), ITY_I64(), blocks)
}

// `count_up` with the header invariant deleted.
fn count_up_no_invariant() -> IrFunction {
    let f: IrFunction = count_up();
    let h: IrBlock = f.blocks[1];
    let kept: Vec<IrInst> = Vec::new();
    let mut i: u64 = 0;
    while i < h.insts.len() {
        let inst: IrInst = h.insts[i];
        if inst.op != IOP_VOW_INV() {
            kept.push(inst);
        }
        i = i + 1;
    }
    f.blocks[1] = mk_block(1, kept);
    f
}

fn count_op(f: IrFunction, op: i64) -> i64 {
    let mut n: i64 = 0;
    let mut b: u64 = 0;
    while b < f.blocks.len() {
        let blk: IrBlock = f.blocks[b];
        let mut i: u64 = 0;
        while i < blk.insts.len() {
            let inst: IrInst = blk.insts[i];
            if inst.op == op {
                n = n + 1;
            }
            i = i + 1;
        }
        b = b + 1;
    }
    n
}

fn count_marker(f: IrFunction, marker: String) -> i64 {
    let mut n: i64 = 0;
    let mut b: u64 = 0;
    while b < f.blocks.len() {
        let blk: IrBlock = f.blocks[b];
        let mut i: u64 = 0;
        while i < blk.insts.len() {
            let inst: IrInst = blk.insts[i];
            if inst.ds == marker {
                n = n + 1;
            }
            i = i + 1;
        }
        b = b + 1;
    }
    n
}

fn count_upsilons_to(f: IrFunction, phi: i64) -> i64 {
    let mut n: i64 = 0;
    let mut b: u64 = 0;
    while b < f.blocks.len() {
        let blk: IrBlock = f.blocks[b];
        let mut i: u64 = 0;
        while i < blk.insts.len() {
            let inst: IrInst = blk.insts[i];
            if inst.op == IOP_UPSILON() && inst.dv == phi {
                n = n + 1;
            }
            i = i + 1;
        }
        b = b + 1;
    }
    n
}

fn block_by_id(f: IrFunction, id: i64) -> IrBlock {
    let mut b: u64 = 0;
    while b < f.blocks.len() {
        let blk: IrBlock = f.blocks[b];
        if blk.id == id {
            return blk;
        }
        b = b + 1;
    }
    ir_block_new(-1)
}

fn terminator(blk: IrBlock) -> IrInst {
    blk.insts[blk.insts.len() - 1]
}

// The acyclic function is well formed: the executor's shape, and no read that
// the definition does not dominate.
fn well_formed(g: IrFunction) -> bool {
    vc_unrolled_detail(g, vc_ty_table(g)).len() == 0 && ir_non_dominating_read(g).len() == 0
}

fn check_structure() -> i64 {
    let f: IrFunction = count_up();
    let c: VcInduct = vc_induct_cut(f);
    if c.status != VC_INDUCT_OK() { return 1; }
    let g: IrFunction = c.f;
    // 4 original blocks, one entry copy and one back copy of the header
    if g.blocks.len() != 6 { return 2; }
    if !well_formed(g) { return 3; }
    if vc_unrolled_detail(f, vc_ty_table(f)).len() == 0 { return 4; }
    // the header proper: the Phi is a havoc constant of its id and type, the
    // invariant an assumption without a frame marker
    let h: IrBlock = block_by_id(g, 1);
    let phi: IrInst = h.insts[0];
    if !vc_is_havoc(phi) || phi.id != 3 || phi.ty != ITY_I64() { return 5; }
    let inv: IrInst = h.insts[3];
    if inv.op != IOP_VOW_REQ() || inv.dv != 7 || inv.ds.len() != 0 || inv.args[0] != 5 { return 6; }
    // two claims (entry and preservation), one assumption
    if count_op(g, IOP_VOW_INV()) != 2 || count_op(g, IOP_VOW_REQ()) != 1 { return 7; }
    if count_marker(g, VC_INTERNAL_CUT_END()) != 1 || count_marker(g, VC_INTERNAL_HAVOC()) != 1 { return 8; }
    // the preheader enters through the entry copy, the latch returns to the back
    // copy; neither feeds the havoc constant any more
    let pre: IrBlock = block_by_id(g, 0);
    let pre_up: IrInst = pre.insts[1];
    let pre_jump: IrInst = terminator(pre);
    let latch: IrBlock = block_by_id(g, 2);
    let latch_up: IrInst = latch.insts[2];
    let latch_jump: IrInst = terminator(latch);
    if pre_jump.dv == 1 || latch_jump.dv == 1 || pre_jump.dv == latch_jump.dv { return 9; }
    if pre_up.dv == 3 || latch_up.dv == 3 || pre_up.dv == latch_up.dv { return 10; }
    if count_upsilons_to(g, 3) != 0 { return 11; }
    // the entry copy claims the invariant on its own Phi and continues into the
    // header proper
    let ent: IrBlock = block_by_id(g, pre_jump.dv);
    let ent_phi: IrInst = ent.insts[0];
    let ent_inv: IrInst = ent.insts[ent.insts.len() - 2];
    let ent_end: IrInst = terminator(ent);
    if ent_phi.op != IOP_PHI() || ent_phi.id != pre_up.dv { return 12; }
    if ent_inv.op != IOP_VOW_INV() || ent_inv.dv != 7 || ent_inv.args[0] == 5 { return 13; }
    if ent_end.op != IOP_JUMP() || ent_end.dv != 1 { return 14; }
    // the back copy ends where control would return to the header
    let back_copy: IrBlock = block_by_id(g, latch_jump.dv);
    let back_end: IrInst = terminator(back_copy);
    if !vc_is_cut_end(back_end) || back_copy.insts[0].id != latch_up.dv { return 15; }
    0
}

fn check_and_region() -> i64 {
    let f: IrFunction = count_up_and();
    if vc_unrolled_detail(f, vc_ty_table(f)).len() == 0 { return 1; }
    let c: VcInduct = vc_induct_cut(f);
    if c.status != VC_INDUCT_OK() { return 2; }
    let g: IrFunction = c.f;
    // 7 original blocks, a 4-block region copied twice
    if g.blocks.len() != 15 { return 3; }
    if !well_formed(g) { return 4; }
    if count_op(g, IOP_VOW_INV()) != 2 || count_op(g, IOP_VOW_REQ()) != 1 { return 5; }
    if count_marker(g, VC_INTERNAL_CUT_END()) != 1 { return 6; }
    // the loop condition is code of the header proper only
    if count_op(g, IOP_LT()) != 1 { return 7; }
    // the copies of the region hold the right-hand side and the merge Phi twice
    if count_op(g, IOP_GE()) != 3 { return 8; }
    // the header Phi is a havoc constant; left are the original merge Phi, the
    // exit Phi and the header and merge Phis of each copy
    if count_op(g, IOP_PHI()) != 1 + 1 + 2 + 2 { return 9; }
    // the original merge block is the havoc copy: its `VowInv` is an assumption
    let m: IrBlock = block_by_id(g, 6);
    if m.insts[1].op != IOP_VOW_REQ() { return 10; }
    0
}

// The executor reads the cut function as claims only: no unwinding claim, and
// the havoc constant is not a model input. The invariant's entry copy folds to
// `0 < 8`, which the simplifier decides, so only the back-edge copy is left.
fn check_claims() -> i64 {
    let c: VcInduct = vc_induct_cut(count_up());
    if c.status != VC_INDUCT_OK() { return 1; }
    let cs: VcClaims = vc_claims(c.f);
    if cs.kinds.len() != 1 { return 2; }
    if cs.kinds[0] != VC_CLAIM_ENSURES() { return 3; }
    if cs.model_names.len() != 0 { return 4; }
    0
}

fn check_deterministic() -> i64 {
    let a: VcInduct = vc_induct_cut(count_up_and());
    let b: VcInduct = vc_induct_cut(count_up_and());
    if a.status != VC_INDUCT_OK() || b.status != VC_INDUCT_OK() { return 1; }
    if print_function(a.f) != print_function(b.f) { return 2; }
    0
}

fn check_not_applicable() -> i64 {
    let none: VcInduct = vc_induct_cut(count_up_no_invariant());
    if none.status != VC_INDUCT_NA() { return 1; }
    // a loop-free function has nothing to cut
    let e: Vec<IrInst> = Vec::new();
    e.push(mk_inst_const_i64(0, 1));
    e.push(mk_inst_return(1, 0));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, e));
    let flat: IrFunction = mk_function(1, String::from("flat"), Vec::new(), ITY_I64(), blocks);
    if vc_induct_cut(flat).status != VC_INDUCT_NA() { return 2; }
    // an invariant that is not in the loop's region is not seen by the cut
    let f: IrFunction = count_up();
    let body: IrBlock = f.blocks[2];
    let moved: Vec<IrInst> = Vec::new();
    moved.push(mk_inv(40, 5, 8));
    let mut i: u64 = 0;
    while i < body.insts.len() {
        moved.push(body.insts[i]);
        i = i + 1;
    }
    f.blocks[2] = mk_block(2, moved);
    if vc_induct_cut(f).status != VC_INDUCT_NA() { return 3; }
    0
}

fn check_ptr_phi() -> i64 {
    let f: IrFunction = count_up();
    let e: IrBlock = f.blocks[0];
    e.insts[0] = mk_inst_alloc(0, 8);
    let h: IrBlock = f.blocks[1];
    h.insts[0] = mk_inst_phi(3, ITY_PTR());
    if vc_induct_cut(f).status != VC_INDUCT_NA() { return 1; }
    0
}

fn one(a: i64) -> Vec<i64> {
    let v: Vec<i64> = Vec::new();
    v.push(a);
    v
}

// `count_up` with `pre` ahead of the preheader's code and `body` ahead of the
// loop body's.
fn count_up_with(pre: Vec<IrInst>, body: Vec<IrInst>) -> IrFunction {
    let f: IrFunction = count_up();
    let e: IrBlock = f.blocks[0];
    let mut i: u64 = 0;
    while i < e.insts.len() {
        pre.push(e.insts[i]);
        i = i + 1;
    }
    f.blocks[0] = mk_block(0, pre);
    let lb: IrBlock = f.blocks[2];
    let mut j: u64 = 0;
    while j < lb.insts.len() {
        body.push(lb.insts[j]);
        j = j + 1;
    }
    f.blocks[2] = mk_block(2, body);
    f
}

fn vec_new_inst(id: i64) -> IrInst {
    mk_inst_call_extern(id, ITY_PTR(), Vec::new(), String::from("__vow_vec_new"))
}

// A Vec allocated before the loop and written in its body is not a header Phi:
// the header proper havocs its `(array, length)` with one marker, after the Phis
// and nowhere else.
fn check_vec_written_in_loop() -> i64 {
    let pre: Vec<IrInst> = Vec::new();
    pre.push(vec_new_inst(40));
    let body: Vec<IrInst> = Vec::new();
    body.push(mk_inst_call_extern(50, ITY_UNIT(), pair(40, 0), String::from("__vow_vec_push_val")));
    let f: IrFunction = count_up_with(pre, body);
    let c: VcInduct = vc_induct_cut(f);
    if c.status != VC_INDUCT_OK() { return 1; }
    let g: IrFunction = c.f;
    if count_marker(g, VC_INTERNAL_HAVOC_VEC()) != 1 { return 2; }
    let h: IrBlock = block_by_id(g, 1);
    let m: IrInst = h.insts[1];
    if !vc_is_havoc_vec(m) || m.args.len() != 1 || m.args[0] != 40 || m.ty != ITY_UNIT() { return 3; }
    if !vc_is_havoc(h.insts[0]) || vc_is_havoc_vec(h.insts[0]) { return 4; }
    if m.id <= dom_max_inst_id(f) || vc_is_havoc_vec(h.insts[2]) { return 5; }
    if !well_formed(g) { return 6; }
    let again: VcInduct = vc_induct_cut(f);
    if print_function(again.f) != print_function(g) { return 7; }
    0
}

// A loop header that opens a region starts with its marker, ahead of the Phis:
// the havoc of a written Vec lands after the Phis, behind that marker.
fn check_vec_written_in_region_header() -> i64 {
    let pre: Vec<IrInst> = Vec::new();
    pre.push(vec_new_inst(40));
    let body: Vec<IrInst> = Vec::new();
    body.push(mk_inst_call_extern(50, ITY_UNIT(), pair(40, 0), String::from("__vow_vec_push_val")));
    let f: IrFunction = count_up_with(pre, body);
    let mut bi: u64 = 0;
    while bi < f.blocks.len() {
        if f.blocks[bi].id == 1 {
            let head: Vec<IrInst> = Vec::new();
            head.push(mk_inst(60, IOP_REGION_OPEN(), ITY_UNIT(), Vec::new()));
            let hb: IrBlock = f.blocks[bi];
            let mut k: u64 = 0;
            while k < hb.insts.len() {
                head.push(hb.insts[k]);
                k = k + 1;
            }
            f.blocks[bi] = mk_block(1, head);
        }
        bi = bi + 1;
    }
    let c: VcInduct = vc_induct_cut(f);
    if c.status != VC_INDUCT_OK() { return 1; }
    if count_marker(c.f, VC_INTERNAL_HAVOC_VEC()) != 1 { return 2; }
    if !well_formed(c.f) { return 3; }
    let h: IrBlock = block_by_id(c.f, 1);
    if h.insts.len() < 3 || h.insts[0].op != IOP_REGION_OPEN() || !vc_is_havoc_vec(h.insts[2]) { return 4; }
    0
}

// A Vec only read in the loop keeps its state: no marker.
fn check_vec_read_in_loop() -> i64 {
    let pre: Vec<IrInst> = Vec::new();
    pre.push(vec_new_inst(40));
    let body: Vec<IrInst> = Vec::new();
    body.push(mk_inst_call_extern(50, ITY_I64(), one(40), String::from("__vow_vec_len")));
    let c: VcInduct = vc_induct_cut(count_up_with(pre, body));
    if c.status != VC_INDUCT_OK() { return 1; }
    if count_marker(c.f, VC_INTERNAL_HAVOC_VEC()) != 0 { return 2; }
    0
}

// A Vec born in the loop that writes it, a String written in a loop and a
// receiver the model cannot name leave the function uncut.
fn check_vec_havoc_refused() -> i64 {
    let born: Vec<IrInst> = Vec::new();
    born.push(vec_new_inst(41));
    born.push(mk_inst_call_extern(42, ITY_UNIT(), pair(41, 0), String::from("__vow_vec_push_val")));
    if vc_induct_cut(count_up_with(Vec::new(), born)).status != VC_INDUCT_NA() { return 1; }

    let pre: Vec<IrInst> = Vec::new();
    pre.push(mk_inst_call_extern(40, ITY_PTR(), Vec::new(), String::from("__vow_string_new")));
    let body: Vec<IrInst> = Vec::new();
    body.push(mk_inst_call_extern(50, ITY_UNIT(), pair(40, 40), String::from("__vow_string_push_str")));
    if vc_induct_cut(count_up_with(pre, body)).status != VC_INDUCT_NA() { return 2; }

    let anon: Vec<IrInst> = Vec::new();
    anon.push(mk_inst_call_extern(50, ITY_UNIT(), Vec::new(), String::from("__vow_vec_push_val")));
    if vc_induct_cut(count_up_with(Vec::new(), anon)).status != VC_INDUCT_NA() { return 3; }

    let neg: Vec<IrInst> = Vec::new();
    neg.push(mk_inst_call_extern(50, ITY_UNIT(), pair(0 - 1, 0), String::from("__vow_vec_push_val")));
    if vc_induct_cut(count_up_with(Vec::new(), neg)).status != VC_INDUCT_NA() { return 4; }

    let far: Vec<IrInst> = Vec::new();
    far.push(mk_inst_call_extern(50, ITY_UNIT(), pair(9999, 0), String::from("__vow_vec_push_val")));
    if vc_induct_cut(count_up_with(Vec::new(), far)).status != VC_INDUCT_NA() { return 5; }
    0
}

// An indexed assignment and a pop mutate a Vec as a push does: each gets the
// havoc marker, once per loop however many writes the body holds.
fn check_vec_set_pop_in_loop() -> i64 {
    let pre: Vec<IrInst> = Vec::new();
    pre.push(vec_new_inst(40));
    let body: Vec<IrInst> = Vec::new();
    let set_args: Vec<i64> = pair(40, 0);
    set_args.push(0);
    body.push(mk_inst_call_extern(50, ITY_UNIT(), set_args, String::from("__vow_vec_set_val")));
    body.push(mk_inst_call_extern(51, ITY_PTR(), one(40), String::from("__vow_vec_pop")));
    let c: VcInduct = vc_induct_cut(count_up_with(pre, body));
    if c.status != VC_INDUCT_OK() { return 1; }
    if count_marker(c.f, VC_INTERNAL_HAVOC_VEC()) != 1 { return 2; }
    0
}

// A field written in the loop body on an object allocated before the loop is
// not a header Phi either, so the function is not cut. An object allocated and
// written inside the body is fresh each iteration and keeps the cut.
fn check_agg_written_in_loop() -> i64 {
    let f: IrFunction = count_up();
    let e: IrBlock = f.blocks[0];
    let pre: Vec<IrInst> = Vec::new();
    pre.push(mk_inst_alloc(30, 8));
    let mut i: u64 = 0;
    while i < e.insts.len() {
        pre.push(e.insts[i]);
        i = i + 1;
    }
    f.blocks[0] = mk_block(0, pre);
    let body: IrBlock = f.blocks[2];
    let w: Vec<IrInst> = Vec::new();
    w.push(body.insts[0]);
    w.push(mk_inst_field_set(31, 30, 0, 9));
    let mut j: u64 = 1;
    while j < body.insts.len() {
        w.push(body.insts[j]);
        j = j + 1;
    }
    f.blocks[2] = mk_block(2, w);
    if vc_induct_cut(f).status != VC_INDUCT_NA() { return 1; }

    let g: IrFunction = count_up();
    let gb: IrBlock = g.blocks[2];
    let loc: Vec<IrInst> = Vec::new();
    loc.push(mk_inst_alloc(32, 8));
    loc.push(gb.insts[0]);
    loc.push(mk_inst_field_set(33, 32, 0, 9));
    let mut k: u64 = 1;
    while k < gb.insts.len() {
        loc.push(gb.insts[k]);
        k = k + 1;
    }
    g.blocks[2] = mk_block(2, loc);
    if vc_induct_cut(g).status != VC_INDUCT_OK() { return 2; }
    0
}

fn main() -> i32 {
    let mut r: i64 = check_structure();
    if r == 0 { r = check_and_region() + 100; if r == 100 { r = 0; } }
    if r == 0 { r = check_claims() + 150; if r == 150 { r = 0; } }
    if r == 0 { r = check_deterministic() + 200; if r == 200 { r = 0; } }
    if r == 0 { r = check_not_applicable() + 300; if r == 300 { r = 0; } }
    if r == 0 { r = check_ptr_phi() + 400; if r == 400 { r = 0; } }
    if r == 0 { r = check_vec_written_in_loop() + 500; if r == 500 { r = 0; } }
    if r == 0 { r = check_vec_written_in_region_header() + 540; if r == 540 { r = 0; } }
    if r == 0 { r = check_vec_read_in_loop() + 550; if r == 550 { r = 0; } }
    if r == 0 { r = check_vec_havoc_refused() + 570; if r == 570 { r = 0; } }
    if r == 0 { r = check_vec_set_pop_in_loop() + 590; if r == 590 { r = 0; } }
    if r == 0 { r = check_agg_written_in_loop() + 600; if r == 600 { r = 0; } }
    i64_to_i32_wrap(r)
}
