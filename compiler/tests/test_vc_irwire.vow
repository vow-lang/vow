module TestVcIrwire

use ir
use vc_irwire

fn ints3(a: i64, b: i64, c: i64) -> Vec<i64> {
    let v: Vec<i64> = Vec::new();
    v.push(a);
    v.push(b);
    v.push(c);
    v
}

// Every record kind, with values that stress the integer coding: both extremes,
// negatives, zero, and a string holding a NUL, a high byte and a newline.
fn sample_module() -> IrModule {
    let m: IrModule = ir_module_new(String::from("sample"));
    let f: IrFunction = ir_function_new(7, String::from("f"), ITY_I64(), 5, String::from("src/f.vow"));
    f.params.push(ITY_I64());
    f.params.push(ITY_PTR());
    f.param_names.push(String::from("x"));
    f.param_names.push(String::from("p"));
    let entry: IrVowEntry = IrVowEntry {
        id: 3,
        description: String::from("x > 0"),
        blame: 1,
        binding_ids: ints3(0, 4, 9),
        binding_names: Vec::new(),
        file: String::from("src/f.vow"),
        offset: 123456,
    };
    entry.binding_names.push(String::from("x"));
    f.vows.push(entry);
    let b: IrBlock = ir_block_new(0);
    let a: IrInst = ir_inst_new(0, 1, ITY_I64(), Vec::new(), 2, 9223372036854775807, -9223372036854775807 - 1, String::from(""));
    b.insts.push(a);
    let odd: String = String::from("a");
    odd.push_byte(0);
    odd.push_byte(255);
    odd.push_byte(10);
    let c: IrInst = ir_inst_new(1, 3, ITY_PTR(), ints3(0, -1, 300), 4, -5, 70000, odd);
    c.ostart = 4294967295;
    c.olen = 12;
    c.rgn = 6;
    b.insts.push(c);
    f.blocks.push(b);
    f.blocks.push(ir_block_new(1));
    f.local_names_ids = ints3(0, 1, 2);
    f.local_names_strs.push(String::from("a"));
    f.local_names_strs.push(String::from("b"));
    f.rsum_return_kind = RSUM_KIND_ALIAS_OF();
    f.rsum_return_aux = 2;
    f.rsum_return_aliases = ints3(1, 2, 3);
    f.rsum_store_effects = ints3(0, 0, 1);
    f.rsum_param_regions = ints3(4, 5, 6);
    m.functions.push(f);
    m.functions.push(ir_function_new(8, String::from("g"), ITY_UNIT(), 0, String::from("")));
    m.strings.push(String::from("__vow_args"));
    m.strings.push(String::from(""));
    let fields: Vec<IrFieldLayout> = Vec::new();
    fields.push(IrFieldLayout { name: String::from("len"), ty: ITY_I64() });
    m.struct_layouts.push(IrStructLayout { name: String::from("S"), fields: fields, is_linear: 1 });
    let variants: Vec<IrVariantLayout> = Vec::new();
    let payload: Vec<IrFieldLayout> = Vec::new();
    payload.push(IrFieldLayout { name: String::from("v"), ty: ITY_PTR() });
    variants.push(IrVariantLayout { name: String::from("Some"), tag: 1, payload: payload });
    variants.push(IrVariantLayout { name: String::from("None"), tag: 0, payload: Vec::new() });
    m.enum_layouts.push(IrEnumLayout { name: String::from("Option"), variants: variants });
    m.warnings.push(String::from("unused"));
    m
}

fn check_round_trip() -> i64 {
    let text: String = vc_irw_encode(sample_module());
    match vc_irw_decode(text) {
        Option::Some(m) => {
            if vc_irw_encode(m) != text { return 1; }
            if m.name != String::from("sample") || m.functions.len() != 2 { return 2; }
            let fns: Vec<IrFunction> = m.functions;
            let f: IrFunction = fns[0];
            if f.id != 7 || f.name != String::from("f") || f.effects != 5 || f.source_file != String::from("src/f.vow") { return 3; }
            if f.vows.len() != 1 || f.vows[0].offset != 123456 || f.vows[0].binding_ids[2] != 9 { return 4; }
            let blocks: Vec<IrBlock> = f.blocks;
            let b: IrBlock = blocks[0];
            let first: IrInst = b.insts[0];
            if first.dv != 9223372036854775807 || first.dv2 != -9223372036854775807 - 1 { return 5; }
            let second: IrInst = b.insts[1];
            if second.args[1] != -1 || second.args[2] != 300 || second.dv != -5 || second.dv2 != 70000 { return 6; }
            if second.ostart != 4294967295 || second.olen != 12 || second.rgn != 6 { return 7; }
            if second.ds.len() != 4 || second.ds.byte_at(1) != 0 || second.ds.byte_at(2) != 255 { return 8; }
            if f.rsum_return_kind != RSUM_KIND_ALIAS_OF() || f.rsum_param_regions[2] != 6 { return 9; }
            if m.struct_layouts.len() != 1 || m.enum_layouts[0].variants[1].tag != 0 { return 10; }
            if m.warnings.len() != 1 || m.strings.len() != 2 { return 11; }
            0
        },
        Option::None => { 12 },
    }
}

fn check_empty_module() -> i64 {
    let text: String = vc_irw_encode(ir_module_new(String::from("")));
    match vc_irw_decode(text) {
        Option::Some(m) => {
            if m.functions.len() != 0 || m.strings.len() != 0 || vc_irw_encode(m) != text { return 1; }
            0
        },
        Option::None => { 2 },
    }
}

fn decodes(text: String) -> bool {
    match vc_irw_decode(text) {
        Option::Some(m) => { true },
        Option::None => { false },
    }
}

// A cut-short encoding, a stray byte, a wrong tag and a count that promises more
// than the bytes left are all refused, never a partial module.
fn check_damage_refused() -> i64 {
    let text: String = vc_irw_encode(sample_module());
    if !decodes(text) { return 1; }
    let mut cut: u64 = 0;
    while cut < text.len() {
        if decodes(text.substring(0, cut)) { return 2; }
        cut = cut + 1;
    }
    let longer: String = String::from(text);
    longer.push_byte(0);
    if decodes(longer) { return 3; }
    if decodes(String::from("")) { return 4; }
    if decodes(String::from("VOWIR2\n")) { return 5; }
    let huge: String = vc_irw_tag();
    huge.push_byte(0);
    huge.push_byte(200);
    huge.push_byte(200);
    huge.push_byte(1);
    if decodes(huge) { return 6; }
    0
}

fn main() -> i32 {
    let mut r: i64 = check_round_trip();
    if r == 0 { r = check_empty_module(); }
    if r == 0 { r = check_damage_refused(); }
    i64_to_i32_wrap(r)
}
