module TestLowerContractText

use lexer
use ast
use diag
use parser
use ir
use ir_printer
use lower

// Unit-level checks for what the CLI-driven contract-text/parity fixtures
// (tests/fixtures/contracts/contract_text_*.vow) cannot reach: the 128-bit limb
// printer and the IR dump of ConstU64. One clause keeps the lowering path under
// test here as a smoke check.

fn lower_source(source: String) -> IrModule {
    let arena: AstArena = arena_new();
    let parsed: Module = parse_module_into(
        lex(source), arena, diag_ctx_new(), String::from("contract_text.vow")
    );
    let item_files: Vec<String> = Vec::new();
    let mut item_i: u64 = 0;
    while item_i < parsed.items.len() {
        item_files.push(String::from("contract_text.vow"));
        item_i = item_i + 1;
    }
    lower_module_vow(
        parsed, Vec::new(), Vec::new(), Vec::new(), Vec::new(), Vec::new(),
        Vec::new(), Vec::new(), Vec::new(), Vec::new(), Vec::new(), Vec::new(),
        Vec::new(), Vec::new(), item_files
    )
}

fn expect_descriptions(source: String, expected: Vec<String>, code: i64) -> i64 {
    let m: IrModule = lower_source(source);
    let got: Vec<String> = Vec::new();
    let mut fi: u64 = 0;
    while fi < m.functions.len() {
        let f: IrFunction = m.functions[fi];
        let mut vi: u64 = 0;
        while vi < f.vows.len() {
            let v: IrVowEntry = f.vows[vi];
            got.push(v.description);
            vi = vi + 1;
        }
        fi = fi + 1;
    }
    if got.len() != expected.len() { return code; }
    let mut i: u64 = 0;
    while i < expected.len() {
        if got[i] != expected[i] { return code + 1 + (i as i64); }
        i = i + 1;
    }
    0
}

fn check_unsigned_literals() -> i64 {
    let source: String = String::from("");
    source.push_str("module T\n");
    source.push_str("fn f(x: u64) -> u64 vow {\n");
    source.push_str("  requires: x != 18446744073709551615\n");
    source.push_str("  requires: x != 9223372036854775808\n");
    source.push_str("  requires: x != 9223372036854775807\n");
    source.push_str("  requires: x != 18446744073709551615u64\n");
    source.push_str("  requires: x != 0\n");
    source.push_str("  ensures: result == 18446744073709551614\n");
    source.push_str("} { x }\n");
    let expected: Vec<String> = Vec::new();
    expected.push(String::from("requires x != 18446744073709551615"));
    expected.push(String::from("requires x != 9223372036854775808"));
    expected.push(String::from("requires x != 9223372036854775807"));
    expected.push(String::from("requires x != 18446744073709551615 as u64"));
    expected.push(String::from("requires x != 0"));
    expected.push(String::from("ensures result == 18446744073709551614"));
    expect_descriptions(source, expected, 100)
}

fn check_u128_limbs_to_text() -> i64 {
    if u128_limbs_to_text(0u64, 0u64) != String::from("0") { return 600; }
    if u128_limbs_to_text(7u64, 0u64) != String::from("7") { return 601; }
    if u128_limbs_to_text(10u64, 0u64) != String::from("10") { return 602; }
    if u128_limbs_to_text(18446744073709551615u64, 0u64) != String::from("18446744073709551615") { return 603; }
    if u128_limbs_to_text(0u64, 1u64) != String::from("18446744073709551616") { return 604; }
    if u128_limbs_to_text(4294967296u64, 0u64) != String::from("4294967296") { return 605; }
    if u128_limbs_to_text(18446744073709551615u64, 18446744073709551615u64)
        != String::from("340282366920938463463374607431768211455") { return 606; }
    if u128_limbs_to_text(0u64, 9223372036854775808u64)
        != String::from("170141183460469231731687303715884105728") { return 607; }
    0
}

fn check_ir_const_u64_printing() -> i64 {
    let max_bits: i64 = -1;
    let inst: IrInst = ir_inst_new(
        0, IOP_CONST_U64(), ITY_U64(), Vec::new(),
        IDATA_CONST_U64(), max_bits, 0, String::from("")
    );
    if format_data(inst) != String::from("18446744073709551615u64") { return 700; }
    0
}

fn main() -> i32 {
    let r1: i64 = check_u128_limbs_to_text();
    if r1 != 0 { return i64_to_i32_wrap(r1); }
    let r2: i64 = check_unsigned_literals();
    if r2 != 0 { return i64_to_i32_wrap(r2); }
    let r3: i64 = check_ir_const_u64_printing();
    if r3 != 0 { return i64_to_i32_wrap(r3); }
    0
}
