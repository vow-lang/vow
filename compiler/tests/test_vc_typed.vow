module TestVcTyped

use lexer
use ast
use diag
use parser
use ir
use lower
use verifier
use vc_ops
use vc_solver
use vc_exec
use vc_smt
use vc_term
use vc_vecmodel
use vc_heap
use vc_reads
use vc_typekeys
use vc_typed

fn lowered(source: String) -> IrModule {
    let arena: AstArena = arena_new();
    let parsed: Module = parse_module_into(lex(source), arena, diag_ctx_new(), String::from("typed.vow"));
    let item_files: Vec<String> = Vec::new();
    let mut fi: u64 = 0;
    while fi < parsed.items.len() {
        item_files.push(String::from("typed.vow"));
        fi = fi + 1;
    }
    let m: IrModule = lower_module_vow(
        parsed, Vec::new(), Vec::new(), Vec::new(), Vec::new(), Vec::new(),
        Vec::new(), Vec::new(), Vec::new(), Vec::new(), Vec::new(), Vec::new(),
        Vec::new(), Vec::new(), Vec::new(), Vec::new(), item_files
    );
    vc_annotate_field_keys(m, parsed);
    m
}

fn source() -> String {
    let s: String = String::from("module Typed\n");
    s.push_str(String::from("struct Pair { lo: i64 }\n"));
    s.push_str(String::from("struct Wide { w: i128, p: Pair }\n"));
    s.push_str(String::from("type Alias = Pair;\n"));
    s.push_str(String::from("struct Node { p: Pair, v: Vec<Pair>, a: Alias, n: i64 }\n"));
    s.push_str(String::from("fn main() -> i32 { 0 }\n"));
    s
}

fn target(k0: String, k1: String) -> IrFunction {
    let f: IrFunction = ir_function_new(0, String::from("f"), ITY_I64(), 0, String::from(""));
    f.param_keys.push(k0);
    f.param_keys.push(k1);
    f
}

fn same(got: Vec<String>, want: String) -> bool {
    let mut i: u64 = 0;
    let text: String = String::from("");
    while i < got.len() {
        text.push_str(got[i]);
        text.push_str(String::from(","));
        i = i + 1;
    }
    text == want
}

// The annotation records the key of the declared type of each slot, an alias resolved and a 128-bit
// field taking two.
fn check_annotation() -> i64 {
    let m: IrModule = lowered(source());
    if m.field_keys.len() != m.struct_layouts.len() { return 1; }
    let t: VcTypes = vc_types_of(target(String::from("Node"), String::from("Pair")), m);
    if t.structs.len() != 3 { return 2; }
    if vc_key_slot(t, String::from("Node"), 0) != String::from("Pair") { return 3; }
    if vc_key_slot(t, String::from("Node"), 1) != String::from("Vec<Pair>") { return 4; }
    if vc_key_slot(t, String::from("Node"), 2) != String::from("Pair") { return 5; }
    if vc_key_slot(t, String::from("Node"), 3) != String::from("i64") { return 6; }
    if vc_key_slot(t, String::from("Node"), 4).len() != 0 || vc_key_slot(t, String::from("Node"), -1).len() != 0 { return 7; }
    if vc_key_slot(t, String::from("Wide"), 0) != String::from("i128") || vc_key_slot(t, String::from("Wide"), 1).len() != 0 { return 8; }
    if vc_key_slot(t, String::from("Wide"), 2) != String::from("Pair") { return 9; }
    if vc_key_slot(t, String::from("Missing"), 0).len() != 0 { return 10; }
    0
}

fn check_keys() -> i64 {
    let m: IrModule = lowered(source());
    let t: VcTypes = vc_types_of(target(String::from("Node"), String::from("Pair")), m);
    if vc_key_class(t, String::from("Node")) != VC_READ_OBJ() || vc_key_class(t, String::from("Pair")) != VC_READ_OBJ() { return 20; }
    if vc_key_class(t, String::from("Vec<Node>")) != VC_READ_VEC() || vc_key_class(t, String::from("Vec")) != VC_READ_VEC() { return 21; }
    if vc_key_class(t, String::from("String")) != VC_READ_STR() { return 22; }
    if vc_key_class(t, String::from("i64")) != 0 || vc_key_class(t, String::from("Option")) != 0 || vc_key_class(t, String::from("")) != 0 { return 23; }
    if vc_key_elem(String::from("Vec<Node>")) != String::from("Node") { return 24; }
    if vc_key_elem(String::from("Vec")).len() != 0 || vc_key_elem(String::from("HashMap<i64,u8>")).len() != 0 || vc_key_elem(String::from("Vec<Vec<i64>>")).len() != 0 { return 25; }
    if vc_key_walk(t, String::from("Node"), String::from("")) != String::from("Node") { return 26; }
    if vc_key_walk(t, String::from("Node"), String::from(".2")) != String::from("Pair") { return 27; }
    if vc_key_walk(t, String::from("Wide"), String::from(".2.0")) != String::from("i64") { return 28; }
    if vc_key_walk(t, String::from("Node"), String::from(".3.0")).len() != 0 || vc_key_walk(t, String::from("Node"), String::from(".x")).len() != 0 { return 29; }
    0
}

fn claims() -> VcClaims {
    let cs: VcClaims = VcClaims {
        arena: vc_arena_new(),
        header: vc_script_new(),
        assumed: Vec::new(),
        kinds: Vec::new(),
        frames: Vec::new(),
        fr: vc_frames_new(),
        pre_only: false,
        step: false,
        hyp_now: false,
        vow_ids: Vec::new(),
        labels: Vec::new(),
        ostarts: Vec::new(),
        olens: Vec::new(),
        negated_goals: Vec::new(),
        header_lens: Vec::new(),
        assumed_lens: Vec::new(),
        model_names: Vec::new(),
        model_params: Vec::new(),
        model_paths: Vec::new(),
        model_tys: Vec::new(),
        model_widths: Vec::new(),
        model_slots: Vec::new(),
        model_hdr: Vec::new(),
        model_ambig: Vec::new(),
        hook_vars: Vec::new(),
        map_vars: Vec::new(),
        vec_param: Vec::new(),
        vec_arr: Vec::new(),
        vec_len: Vec::new(),
        vec_hdr: Vec::new(),
        vec_wide: Vec::new(),
        vec_path: Vec::new(),
        vec_handle: Vec::new(),
        map_len: Vec::new(),
        map_len_hdr: Vec::new(),
        listed: vc_heap_listed_new(),
    };
    cs.header_lens.push(10);
    cs
}

fn entry(cs: VcClaims, name: String, param: i64, path: String, slot: i64, hdr: i64) {
    cs.model_names.push(name);
    cs.model_params.push(param);
    cs.model_paths.push(path);
    cs.model_tys.push(ITY_I64());
    cs.model_widths.push(64);
    cs.model_slots.push(slot);
    cs.model_hdr.push(hdr);
}

fn read_of(cs: VcClaims, cls: i64) {
    let ls: VcHeapListed = cs.listed;
    ls.rd_ok = true;
    ls.rd_cls.push(cls);
    ls.rd_term.push(vc_tm_var(cs.arena, String::from("h")));
    ls.rd_hdr.push(3);
}

fn answer(vals: Vec<i64>) -> VcSolverAnswer {
    let highs: Vec<i64> = Vec::new();
    let mut i: u64 = 0;
    while i < vals.len() {
        highs.push(0);
        i = i + 1;
    }
    VcSolverAnswer { verdict: VC_ANS_SAT(), values: vals, highs: highs, raw: String::from("") }
}

fn ints(a: i64, b: i64, c: i64, d: i64) -> Vec<i64> {
    let v: Vec<i64> = Vec::new();
    v.push(a);
    v.push(b);
    v.push(c);
    v.push(d);
    v
}

// `q: Node` and `r: Pair`: the model puts `q.p` (a `Pair`) at the address of `q`, which the function
// reads through.
fn scalar_claims() -> VcClaims {
    let cs: VcClaims = claims();
    entry(cs, String::from("p0_addr"), 0, String::from(""), VC_SLOT_ADDR(), 1);
    entry(cs, String::from("p0_s0"), 0, String::from(""), 0, 2);
    entry(cs, String::from("p1_addr"), 1, String::from(""), VC_SLOT_ADDR(), 3);
    read_of(cs, VC_READ_OBJ());
    cs
}

fn check_pairs() -> i64 {
    let m: IrModule = lowered(source());
    let t: VcTypes = vc_types_of(target(String::from("Node"), String::from("Pair")), m);
    let cs: VcClaims = scalar_claims();
    let apart: Vec<String> = Vec::new();
    if !vc_typed_pairs(t, cs, 0, answer(ints(-1, -1, 5, -1)), apart) { return 40; }
    if !same(apart, String::from("p0_addr,p0_s0,")) { return 41; }
    if vc_typed_pairs(t, cs, 0, answer(ints(-1, -1, 5, -1)), apart) { return 42; }
    let none: Vec<String> = Vec::new();
    if vc_typed_pairs(t, cs, 0, answer(ints(-1, 2, 5, -1)), none) { return 43; }
    if vc_typed_pairs(t, cs, 0, answer(ints(-1, -1, 5, 6)), none) { return 44; }
    if vc_typed_pairs(vc_types_none(), cs, 0, answer(ints(-1, -1, 5, -1)), none) { return 45; }
    let three: Vec<String> = Vec::new();
    if !vc_typed_pairs(t, cs, 0, answer(ints(-1, -1, -1, -1)), three) { return 46; }
    if !same(three, String::from("p0_addr,p0_s0,p0_addr,p1_addr,")) { return 47; }
    0
}

// Objects of one declared type at one address are one object, whatever the function reads.
fn check_same_type_is_one_object() -> i64 {
    let m: IrModule = lowered(source());
    let t: VcTypes = vc_types_of(target(String::from("Node"), String::from("Node")), m);
    let cs: VcClaims = scalar_claims();
    let apart: Vec<String> = Vec::new();
    if vc_typed_pairs(t, cs, 0, answer(ints(-1, 7, -1, -1)), apart) { return 50; }
    0
}

// An element of a `Vec<Node>` parameter is a `Node`: a `Pair` parameter at its address is not.
fn check_element_pairs() -> i64 {
    let m: IrModule = lowered(source());
    let t: VcTypes = vc_types_of(target(String::from("Vec<Node>"), String::from("Pair")), m);
    let cs: VcClaims = claims();
    entry(cs, String::from("p0_vlen"), 0, String::from(""), VC_SLOT_VEC_LEN(), 1);
    entry(cs, String::from("p1_addr"), 1, String::from(""), VC_SLOT_ADDR(), 2);
    cs.vec_param.push(0);
    cs.vec_arr.push(String::from("p0_varr"));
    cs.vec_len.push(String::from("p0_vlen"));
    cs.vec_hdr.push(1);
    cs.vec_wide.push(-1);
    read_of(cs, VC_READ_OBJ());
    let vals: Vec<i64> = Vec::new();
    vals.push(1);
    vals.push(-3);
    vals.push(-3);
    vals.push(-3);
    vals.push(0);
    let apart: Vec<String> = Vec::new();
    if !vc_typed_pairs(t, cs, 0, answer(vals), apart) { return 60; }
    if !same(apart, String::from("p1_addr,p0_varr_e0,")) { return 61; }
    0
}

// A pair whose symbols the ask defines is kept apart; one it does not define is left out.
fn check_assert_apart() -> i64 {
    let ar: VcArena = vc_arena_new();
    let s: SmtScript = vc_script_new();
    let names: Vec<String> = Vec::new();
    names.push(String::from("a"));
    names.push(String::from("b"));
    let apart: Vec<String> = Vec::new();
    apart.push(String::from("a"));
    apart.push(String::from("b"));
    apart.push(String::from("a"));
    apart.push(String::from("zzz"));
    vc_assert_apart(ar, s, names, apart);
    let text: String = vc_smt_render(ar, s);
    if str_find_str(text, String::from("(not (= a b))")) < 0 { return 70; }
    if str_find_str(text, String::from("zzz")) >= 0 { return 71; }
    0
}

fn main() -> i32 {
    let mut r: i64 = check_annotation();
    if r == 0 { r = check_keys(); }
    if r == 0 { r = check_pairs(); }
    if r == 0 { r = check_same_type_is_one_object(); }
    if r == 0 { r = check_element_pairs(); }
    if r == 0 { r = check_assert_apart(); }
    i64_to_i32_wrap(r)
}
