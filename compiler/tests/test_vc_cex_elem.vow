module TestVcCexElem

use lexer
use ast
use diag
use parser
use vc_cex_elem

fn check_elem_text() -> i64 {
    if vc_cex_elem_text(String::from("i64"), 18446744073709551609u64) != String::from("-7") { return 1; }
    if vc_cex_elem_text(String::from("i64"), 9223372036854775807u64) != String::from("9223372036854775807") { return 2; }
    if vc_cex_elem_text(String::from("u64"), 18446744073709551609u64) != String::from("18446744073709551609") { return 3; }
    // A narrow element is the slot's low bits: the model's high bits are arbitrary.
    if vc_cex_elem_text(String::from("i32"), 4294967291u64) != String::from("-5") { return 4; }
    if vc_cex_elem_text(String::from("i32"), 18446744069414584315u64) != String::from("-5") { return 5; }
    if vc_cex_elem_text(String::from("i32"), 2147483647u64) != String::from("2147483647") { return 6; }
    if vc_cex_elem_text(String::from("i8"), 128u64) != String::from("-128") { return 7; }
    if vc_cex_elem_text(String::from("u8"), 353u64) != String::from("97") { return 8; }
    if vc_cex_elem_text(String::from("u8"), 18446744073709551457u64) != String::from("97") { return 9; }
    if vc_cex_elem_text(String::from("u32"), 4294967296u64 + 7u64) != String::from("7") { return 10; }
    if vc_cex_elem_text(String::from("bool"), 0u64) != String::from("false") { return 11; }
    if vc_cex_elem_text(String::from("bool"), 2u64) != String::from("true") { return 12; }
    // A type it does not know keeps the slot.
    if vc_cex_elem_text(String::from("Handle"), 18446744073709551609u64) != String::from("18446744073709551609") { return 13; }
    0
}

fn check_elem_open() -> i64 {
    if vc_cex_elem_open(String::from("v[0]")) != 1 { return 20; }
    if vc_cex_elem_open(String::from("data[123]")) != 4 { return 21; }
    if vc_cex_elem_open(String::from("v.len")) != -1 { return 22; }
    if vc_cex_elem_open(String::from("v[]")) != -1 { return 23; }
    if vc_cex_elem_open(String::from("[1]")) != -1 { return 24; }
    if vc_cex_elem_open(String::from("o.1.0")) != -1 { return 25; }
    if vc_cex_elem_open(String::from("v[a]")) != -1 { return 26; }
    0
}

fn parse_src(source: String) -> Module [io] {
    let dctx: DiagCtx = diag_ctx_new();
    let arena: AstArena = arena_new();
    parse_module_into(lex(source), arena, dctx, String::from("entry.vow"))
}

// The element type of a held collection follows the slots of the structs down to its field: a
// 128-bit field takes two slots, so the slot of the field after it is two more.
fn check_held_element_types() -> i32 [io] {
    let m: Module = parse_src(String::from("module T\nstruct Inner { n: i64, w: i128, items: Vec<i32> }\nstruct Outer { tag: u8, inner: Inner, text: String, o: Option<i64> }\nfn f(o: Outer, v: Vec<u8>, x: i64) -> i64 { 0 }\n"));
    if vc_cex_param_elem_type(m, String::from("f"), String::from("v")) != String::from("u8") { return 30; }
    if vc_cex_param_elem_type(m, String::from("f"), String::from("o.2")) != String::from("u8") { return 31; }
    if vc_cex_param_elem_type(m, String::from("f"), String::from("o.1.3")) != String::from("i32") { return 32; }
    if vc_cex_param_elem_type(m, String::from("f"), String::from("o.1.2")).len() != 0 { return 33; }
    if vc_cex_param_elem_type(m, String::from("f"), String::from("o.0")).len() != 0 { return 34; }
    if vc_cex_param_elem_type(m, String::from("f"), String::from("o.9")).len() != 0 { return 35; }
    if vc_cex_param_elem_type(m, String::from("f"), String::from("o.3.0")).len() != 0 { return 36; }
    if vc_cex_param_elem_type(m, String::from("f"), String::from("x.0")).len() != 0 { return 37; }
    if vc_cex_param_elem_type(m, String::from("f"), String::from("o.1.x")).len() != 0 { return 38; }
    if vc_cex_param_elem_type(m, String::from("g"), String::from("v")).len() != 0 { return 39; }
    if vc_cex_param_elem_type(m, String::from("f"), String::from("o.1.")).len() != 0 { return 42; }
    if vc_cex_param_elem_type(m, String::from("f"), String::from("o..3")).len() != 0 { return 43; }
    let names: Vec<String> = Vec::new();
    let vals: Vec<String> = Vec::new();
    names.push(String::from("o.1.3.len"));
    vals.push(String::from("1"));
    names.push(String::from("o.1.3[0]"));
    vals.push(String::from("4294967289"));
    names.push(String::from("o.2[0]"));
    vals.push(String::from("353"));
    names.push(String::from("o.0"));
    vals.push(String::from("7"));
    vc_cex_retype_elements(m, String::from("f"), names, vals);
    if vals[0] != String::from("1") || vals[1] != String::from("-7") { return 40; }
    if vals[2] != String::from("97") || vals[3] != String::from("7") { return 41; }
    0
}

fn main() -> i32 [io] {
    let mut r: i64 = check_elem_text();
    if r == 0 { r = check_elem_open(); }
    if r == 0 { r = check_held_element_types() as i64; }
    i64_to_i32_wrap(r)
}
