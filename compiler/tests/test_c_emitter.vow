fn check_unsigned_formatter_models() -> i64 {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(ir_inst_new(0, IOP_CONST_U64(), ITY_U64(), Vec::new(), IDATA_CONST_U64(), 42, 0, String::from("")));
    let root_args: Vec<i64> = Vec::new();
    root_args.push(0);
    insts.push(mk_inst_call_extern(1, ITY_PTR(), root_args, String::from("__vow_string_from_u64")));
    insts.push(mk_inst_const_i64(2, 0));
    let arena_args: Vec<i64> = Vec::new();
    arena_args.push(2);
    arena_args.push(0);
    insts.push(mk_inst_call_extern(3, ITY_PTR(), arena_args, String::from("__vow_string_from_u64_in_arena")));
    insts.push(mk_inst_return(4, 1));

    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, insts));
    let f: IrFunction = mk_function(13, String::from("format_unsigned"), Vec::new(), ITY_PTR(), blocks);
    let funcs: Vec<IrFunction> = Vec::new();
    funcs.push(f);
    let m: IrModule = mk_module(funcs);
    if non_modelable_reason(f, m, Vec::new()) != String::from("") {
        return 47;
    }

    let c: String = emit_c_module(m, 16, 16, 16, 16);
    if !c.contains(String::from("__vow_string_t v1;")) { return 48; }
    if !c.contains(String::from("__vow_string_t v3;")) { return 49; }
    if !c.contains(String::from("v1.len = __VERIFIER_nondet_unsigned_long();")) { return 50; }
    if !c.contains(String::from("v3.len = __VERIFIER_nondet_unsigned_long();")) { return 51; }
    if !c.contains(String::from("__ESBMC_assume(v1.len < 16);")) { return 52; }
    if !c.contains(String::from("__ESBMC_assume(v3.len < 16);")) { return 53; }
    0
}

fn check_expanding_string_helper_falls_back(name: String, argc: i64, base_code: i64) -> i64 {
    let args: Vec<i64> = Vec::new();
    let insts: Vec<IrInst> = Vec::new();
    let mut i: i64 = 0;
    while i < argc {
        args.push(i);
        insts.push(mk_inst_const_i64(i, 0));
        i = i + 1;
    }

    let call_id: i64 = 40;
    insts.push(mk_inst_call_extern(call_id, ITY_PTR(), args, name));
    insts.push(mk_inst_return(call_id + 1, call_id));

    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, insts));
    let f: IrFunction = mk_function(
        base_code,
        String::from("expanding_helper"),
        Vec::new(),
        ITY_PTR(),
        blocks
    );
    let funcs: Vec<IrFunction> = Vec::new();
    funcs.push(f);
    let m: IrModule = mk_module(funcs);
    let const_fn_indices: Vec<i64> = Vec::new();

    let reason: String = non_modelable_reason(f, m, const_fn_indices);
    if !reason.contains(name) {
        return base_code;
    }

    let c: String = String::from("");
    let modelable_fi_set: Vec<i64> = Vec::new();
    emit_c_function(
        c,
        f,
        const_fn_indices,
        modelable_fi_set,
        m,
        16,
        16,
        16,
        16,
        false,
        false,
        0
    );
    if !c.contains(String::from("/* opcode Call not modelled */")) {
        return base_code + 1;
    }
    0
}

fn check_wide_constants_are_non_modelable() -> i64 {
    let i128_insts: Vec<IrInst> = Vec::new();
    i128_insts.push(ir_inst_new(
        0, IOP_CONST_I128(), ITY_I128(), Vec::new(),
        IDATA_CONST_I128(), 0, 0, String::from("")
    ));
    i128_insts.push(mk_inst_return(1, 0));
    let i128_blocks: Vec<IrBlock> = Vec::new();
    i128_blocks.push(mk_block(0, i128_insts));
    let i128_fn: IrFunction = mk_function(
        14, String::from("wide_i128"), Vec::new(), ITY_I128(), i128_blocks
    );
    let i128_functions: Vec<IrFunction> = Vec::new();
    i128_functions.push(i128_fn);
    let i128_module: IrModule = mk_module(i128_functions);
    if !non_modelable_reason(i128_fn, i128_module, Vec::new()).contains(
        String::from("ConstI128")
    ) { return 64; }

    let u128_insts: Vec<IrInst> = Vec::new();
    u128_insts.push(ir_inst_new(
        0, IOP_CONST_U128(), ITY_U128(), Vec::new(),
        IDATA_CONST_U128(), 0, 0, String::from("")
    ));
    u128_insts.push(mk_inst_return(1, 0));
    let u128_blocks: Vec<IrBlock> = Vec::new();
    u128_blocks.push(mk_block(0, u128_insts));
    let u128_fn: IrFunction = mk_function(
        15, String::from("wide_u128"), Vec::new(), ITY_U128(), u128_blocks
    );
    let u128_functions: Vec<IrFunction> = Vec::new();
    u128_functions.push(u128_fn);
    let u128_module: IrModule = mk_module(u128_functions);
    if !non_modelable_reason(u128_fn, u128_module, Vec::new()).contains(
        String::from("ConstU128")
    ) { return 65; }
    0
}

// `bits` is the i64 reinterpretation of an f64's IEEE-754 bit pattern (i.e.
// `<value>.to_bits() as i64`). ConstF64 stays opcode-level modelable (unlike
// ConstI128/ConstU128 above), so the guard only shows up in the rendered C,
// not in `non_modelable_reason`.
fn check_nonfinite_f64_const(id: i64, name: String, bits: i64, base_code: i64) -> i64 {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(ir_inst_new(
        0, IOP_CONST_F64(), ITY_F64(), Vec::new(),
        IDATA_CONST_F64(), bits, 0, String::from("")
    ));
    insts.push(mk_inst_return(1, 0));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, insts));
    let f: IrFunction = mk_function(id, name, Vec::new(), ITY_F64(), blocks);
    let functions: Vec<IrFunction> = Vec::new();
    functions.push(f);
    let m: IrModule = mk_module(functions);
    let const_fn_indices: Vec<i64> = Vec::new();

    let c: String = String::from("");
    let modelable_fi_set: Vec<i64> = Vec::new();
    emit_c_function(c, f, const_fn_indices, modelable_fi_set, m, 16, 16, 16, 16, false, false, 0);

    let expected: String = str3(
        String::from("__ESBMC_assert(0, \"vow:"),
        unsupported_op_vow_id_str(),
        String::from("\"")
    );
    if !c.contains(expected) { return base_code; }
    let leaked_literal: bool = c.contains(String::from("= inf;"))
        || c.contains(String::from("= -inf;"))
        || c.contains(String::from("= NaN;"));
    if leaked_literal { return base_code + 1; }
    0
}

fn check_nonfinite_f64_consts_fail_closed() -> i64 {
    let r1: i64 = check_nonfinite_f64_const(20, String::from("f64_pos_inf"), 9218868437227405312, 70);
    if r1 != 0 { return r1; }
    let r2: i64 = check_nonfinite_f64_const(21, String::from("f64_neg_inf"), -4503599627370496, 80);
    if r2 != 0 { return r2; }
    let r3: i64 = check_nonfinite_f64_const(22, String::from("f64_nan"), 9221120237041090560, 90);
    if r3 != 0 { return r3; }
    0
}

// f64::MAX (largest finite value, exponent bits not all-ones) must still
// render as a normal literal, not trip the guard.
fn check_finite_f64_max_const_still_renders() -> i64 {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(ir_inst_new(
        0, IOP_CONST_F64(), ITY_F64(), Vec::new(),
        IDATA_CONST_F64(), 9218868437227405311, 0, String::from("")
    ));
    insts.push(mk_inst_return(1, 0));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, insts));
    let f: IrFunction = mk_function(23, String::from("f64_max"), Vec::new(), ITY_F64(), blocks);
    let functions: Vec<IrFunction> = Vec::new();
    functions.push(f);
    let m: IrModule = mk_module(functions);
    let const_fn_indices: Vec<i64> = Vec::new();

    let c: String = String::from("");
    let modelable_fi_set: Vec<i64> = Vec::new();
    emit_c_function(c, f, const_fn_indices, modelable_fi_set, m, 16, 16, 16, 16, false, false, 0);

    if c.contains(String::from("__ESBMC_assert(0")) { return 100; }
    0
}

// Push the get/set call for an indexed container access (id `base_id`,
// consuming `base_id` itself for the stored value in the set case) followed
// by its return. Shared by the single-block and cross-block indexed-container
// fixtures below.
fn push_index_op_insts(insts: Vec<IrInst>, base_id: i64, index_extern: String) {
    if index_extern == String::from("__vow_vec_set_val") {
        insts.push(mk_inst_const_i64(base_id, 7));
        let set_args: Vec<i64> = Vec::new();
        set_args.push(0);
        set_args.push(2);
        set_args.push(base_id);
        insts.push(mk_inst_call_extern(base_id + 1, ITY_UNIT(), set_args, index_extern));
        insts.push(mk_inst_return(base_id + 2, 1));
    } else {
        let get_args: Vec<i64> = Vec::new();
        get_args.push(0);
        get_args.push(2);
        insts.push(mk_inst_call_extern(base_id, ITY_I64(), get_args, index_extern));
        insts.push(mk_inst_return(base_id + 1, 1));
    }
}

// Build a one-block function that indexes a container parameter, marking the
// container with `len_extern` so the emitter classifies it, and indexing it
// with `idx_ty` via `index_extern`. Mirrors `indexed_container_fn` in
// vow-verify/src/c_emitter.rs's test module (#1113).
fn indexed_container_function(len_extern: String, index_extern: String, idx_ty: i64) -> IrFunction {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_arg(0, ITY_PTR(), 0));

    let len_args: Vec<i64> = Vec::new();
    len_args.push(0);
    insts.push(mk_inst_call_extern(1, ITY_I64(), len_args, len_extern));

    insts.push(mk_inst_arg(2, idx_ty, 1));
    push_index_op_insts(insts, 3, index_extern);

    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, insts));
    let params: Vec<i64> = Vec::new();
    params.push(ITY_PTR());
    params.push(idx_ty);
    mk_function(0, String::from("indexed"), params, ITY_I64(), blocks)
}

fn emit_indexed_container_c(len_extern: String, index_extern: String, idx_ty: i64) -> String {
    let funcs: Vec<IrFunction> = Vec::new();
    funcs.push(indexed_container_function(len_extern, index_extern, idx_ty));
    emit_c_module(mk_module(funcs), 16, 16, 16, 16)
}

fn indexed_container_cross_block_function(len_extern: String, index_extern: String,
                                           idx_ty: i64) -> IrFunction {
    let entry_insts: Vec<IrInst> = Vec::new();
    entry_insts.push(mk_inst_arg(0, ITY_PTR(), 0));

    let len_args: Vec<i64> = Vec::new();
    len_args.push(0);
    entry_insts.push(mk_inst_call_extern(1, ITY_I64(), len_args, len_extern));
    entry_insts.push(mk_inst_arg(2, idx_ty, 1));
    entry_insts.push(ir_inst_new(
        3,
        IOP_JUMP(),
        ITY_UNIT(),
        Vec::new(),
        IDATA_JUMP_TARGET(),
        1,
        0,
        String::from("")
    ));

    let body_insts: Vec<IrInst> = Vec::new();
    push_index_op_insts(body_insts, 4, index_extern);

    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, entry_insts));
    blocks.push(mk_block(1, body_insts));
    let params: Vec<i64> = Vec::new();
    params.push(ITY_PTR());
    params.push(idx_ty);
    mk_function(0, String::from("indexed_cross_block"), params, ITY_I64(), blocks)
}

fn emit_indexed_container_cross_block_c(len_extern: String, index_extern: String,
                                        idx_ty: i64) -> String {
    let funcs: Vec<IrFunction> = Vec::new();
    funcs.push(indexed_container_cross_block_function(len_extern, index_extern, idx_ty));
    emit_c_module(mk_module(funcs), 16, 16, 16, 16)
}

// An unsigned index drops the vacuous `>= 0` conjunct and compares directly
// against the uint64_t `.len` field, so the emitted C carries no
// mixed-signedness comparison (#1113 Half A).
fn check_bounds_assert_unsigned(len_extern: String, index_extern: String, label: String,
                                idx_ty: i64, base_code: i64) -> i64 {
    let c: String = emit_indexed_container_c(len_extern, index_extern, idx_ty);
    let expected: String = str3(String::from("  __ESBMC_assert(v2 < v0.len, \""),
        label, String::from("\");\n"));
    if !c.contains(expected) { return base_code; }
    if c.contains(String::from("v2 >= 0"))
        || c.contains(String::from("(uint64_t)"))
        || c.contains(String::from("(int64_t)v0.len")) {
        return base_code + 1;
    }
    0
}

// A signed index keeps its `>= 0` guard and converts `.len` to int64_t
// explicitly, so a negative index is still caught without a mixed-signedness
// comparison (#1113 Half A).
fn check_bounds_assert_signed(len_extern: String, index_extern: String, label: String,
                              idx_ty: i64, base_code: i64) -> i64 {
    let c: String = emit_indexed_container_c(len_extern, index_extern, idx_ty);
    let expected: String = str3(String::from("  __ESBMC_assert(v2 >= 0 && v2 < (int64_t)v0.len, \""),
        label, String::from("\");\n"));
    if !c.contains(expected) { return base_code; }
    if c.contains(String::from("(uint64_t)")) { return base_code + 1; }
    0
}

fn check_bounds_assert_signedness() -> i64 {
    let vec_len: String = String::from("__vow_vec_len");
    let str_len: String = String::from("__vow_string_len");
    let get: String = String::from("__vow_vec_get_val");
    let set: String = String::from("__vow_vec_set_val");
    let byte_at: String = String::from("__vow_string_byte_at");
    let vec_label: String = String::from("vec bounds");
    let str_label: String = String::from("string bounds");

    let unsigned_tys: Vec<i64> = Vec::new();
    unsigned_tys.push(ITY_U8());
    unsigned_tys.push(ITY_U16());
    unsigned_tys.push(ITY_U32());
    unsigned_tys.push(ITY_U64());

    let signed_tys: Vec<i64> = Vec::new();
    signed_tys.push(ITY_I8());
    signed_tys.push(ITY_I16());
    signed_tys.push(ITY_I32());
    signed_tys.push(ITY_I64());

    let mut i: i64 = 0;
    while i < unsigned_tys.len() as i64 {
        let ty: i64 = unsigned_tys[i as u64];
        let base: i64 = 70 + i * 10;
        let a: i64 = check_bounds_assert_unsigned(vec_len, get, vec_label, ty, base);
        if a != 0 { return a; }
        let b: i64 = check_bounds_assert_unsigned(vec_len, set, vec_label, ty, base + 2);
        if b != 0 { return b; }
        let c: i64 = check_bounds_assert_unsigned(str_len, byte_at, str_label, ty, base + 4);
        if c != 0 { return c; }
        i = i + 1;
    }

    let mut j: i64 = 0;
    while j < signed_tys.len() as i64 {
        let ty: i64 = signed_tys[j as u64];
        let base: i64 = 110 + j * 10;
        let a: i64 = check_bounds_assert_signed(vec_len, get, vec_label, ty, base);
        if a != 0 { return a; }
        let b: i64 = check_bounds_assert_signed(vec_len, set, vec_label, ty, base + 2);
        if b != 0 { return b; }
        let c: i64 = check_bounds_assert_signed(str_len, byte_at, str_label, ty, base + 4);
        if c != 0 { return c; }
        j = j + 1;
    }
    0
}

// from_raw_parts_copy's length assumption follows the argument's signedness: a
// u64 length drops the vacuous `>= 0` conjunct, a signed (literal) one keeps
// it. Mirrors raw_parts_copy_len_assumption_follows_argument_signedness in
// vow-verify/src/c_emitter.rs.
fn emit_raw_parts_copy_c(extern_name: String, len_ty: i64) -> String {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_arg(0, ITY_I64(), 0));
    insts.push(mk_inst_arg(1, len_ty, 1));
    let call_args: Vec<i64> = Vec::new();
    call_args.push(0);
    call_args.push(1);
    insts.push(mk_inst_call_extern(2, ITY_PTR(), call_args, extern_name));
    insts.push(mk_inst_return(3, 2));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, insts));
    let params: Vec<i64> = Vec::new();
    params.push(ITY_I64());
    params.push(len_ty);
    let funcs: Vec<IrFunction> = Vec::new();
    funcs.push(mk_function(0, String::from("raw_parts"), params, ITY_PTR(), blocks));
    emit_c_module(mk_module(funcs), 16, 16, 16, 16)
}

fn check_raw_parts_copy_len_assumption(extern_name: String, kind: String, base_code: i64) -> i64 {
    let marker: String = str3(String::from(" /* vow:model-bound "), kind, String::from(" 16 */\n  v2.len = v0 == 0 ? 0 : v1;\n"));
    let unsigned_c: String = emit_raw_parts_copy_c(extern_name, ITY_U64());
    if !unsigned_c.contains(cemit_str2(String::from("  __ESBMC_assume(v0 == 0 || (v1 < 16));"), marker)) { return base_code; }
    if unsigned_c.contains(String::from("v1 >= 0")) { return base_code + 1; }
    let signed_c: String = emit_raw_parts_copy_c(extern_name, ITY_I64());
    if !signed_c.contains(cemit_str2(String::from("  __ESBMC_assume(v0 == 0 || (v1 >= 0 && v1 < 16));"), marker)) { return base_code + 2; }
    0
}

// A constant length outside the model capacity fails closed with the capacity
// label instead of an unsatisfiable assumption. Mirrors
// raw_parts_copy_constant_len_beyond_model_fails_closed in
// vow-verify/src/c_emitter.rs.
fn emit_raw_parts_copy_const_len_c(extern_name: String, op: i64, ty: i64, value: i64) -> String {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_arg(0, ITY_I64(), 0));
    insts.push(ir_inst_new(1, op, ty, Vec::new(), IDATA_CONST_U64(), value, 0, String::from("")));
    let call_args: Vec<i64> = Vec::new();
    call_args.push(0);
    call_args.push(1);
    insts.push(mk_inst_call_extern(2, ITY_PTR(), call_args, extern_name));
    insts.push(mk_inst_return(3, 2));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, insts));
    let params: Vec<i64> = Vec::new();
    params.push(ITY_I64());
    let funcs: Vec<IrFunction> = Vec::new();
    funcs.push(mk_function(0, String::from("raw_parts"), params, ITY_PTR(), blocks));
    emit_c_module(mk_module(funcs), 16, 16, 16, 16)
}

fn check_raw_parts_copy_const_len(extern_name: String, label: String, base_code: i64) -> i64 {
    let fail_closed: String = String::from("  __ESBMC_assert(v0 == 0, \"");
    fail_closed.push_str(label);
    fail_closed.push_str(String::from("\");\n  v2.len = 0;\n"));
    let at_cap: String = emit_raw_parts_copy_const_len_c(extern_name, IOP_CONST_U64(), ITY_U64(), 16);
    if !at_cap.contains(fail_closed) { return base_code; }
    if at_cap.contains(String::from("__ESBMC_assume(v0 == 0")) { return base_code + 1; }
    let above_i64_max: String = emit_raw_parts_copy_const_len_c(extern_name, IOP_CONST_U64(), ITY_U64(), 0 - 1);
    if !above_i64_max.contains(fail_closed) { return base_code + 2; }
    let negative: String = emit_raw_parts_copy_const_len_c(extern_name, IOP_CONST_I64(), ITY_I64(), 0 - 1);
    if !negative.contains(fail_closed) { return base_code + 3; }
    let in_range: String = emit_raw_parts_copy_const_len_c(extern_name, IOP_CONST_U64(), ITY_U64(), 15);
    if !in_range.contains(String::from("  __ESBMC_assume(v0 == 0 || (v1 < 16));\n  v2.len = v0 == 0 ? 0 : v1;\n")) { return base_code + 4; }
    if in_range.contains(fail_closed) { return base_code + 5; }
    if in_range.contains(String::from("vow:model-bound")) { return base_code + 6; }
    0
}

// `from_raw_parts_copy(p, <len>)` where `body` computes the length, the value
// named by `len_id`. The call is value 100.
fn emit_raw_parts_body_c(extern_name: String, body: Vec<IrInst>, len_id: i64) -> String {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_arg(0, ITY_I64(), 0));
    let mut bi: u64 = 0u64;
    while bi < body.len() {
        insts.push(body[bi]);
        bi = bi + 1u64;
    }
    let call_args: Vec<i64> = Vec::new();
    call_args.push(0);
    call_args.push(len_id);
    insts.push(mk_inst_call_extern(100, ITY_PTR(), call_args, extern_name));
    insts.push(mk_inst_return(101, 100));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, insts));
    let params: Vec<i64> = Vec::new();
    params.push(ITY_I64());
    let funcs: Vec<IrFunction> = Vec::new();
    funcs.push(mk_function(0, String::from("raw_parts"), params, ITY_PTR(), blocks));
    emit_c_module(mk_module(funcs), 16, 16, 16, 16)
}

fn fold_const_u64(id: i64, value: i64) -> IrInst {
    ir_inst_new(id, IOP_CONST_U64(), ITY_U64(), Vec::new(), IDATA_CONST_U64(), value, 0, String::from(""))
}

fn fold_u64_op(id: i64, op: i64, a: i64, b: i64) -> IrInst {
    let args: Vec<i64> = Vec::new();
    args.push(a);
    args.push(b);
    ir_inst_new(id, op, ITY_U64(), args, IDATA_NONE(), 0, 0, String::from(""))
}

fn fold_phi_of_two_typed(a: i64, b: i64, phi_ty: i64) -> Vec<IrInst> {
    let body: Vec<IrInst> = Vec::new();
    body.push(fold_const_u64(1, a));
    body.push(fold_const_u64(2, b));
    body.push(ir_inst_new(3, IOP_PHI(), phi_ty, Vec::new(), IDATA_NONE(), 0, 0, String::from("")));
    let a1: Vec<i64> = Vec::new();
    a1.push(1);
    body.push(ir_inst_new(4, IOP_UPSILON(), ITY_UNIT(), a1, IDATA_PHI_TARGET(), 3, 0, String::from("")));
    let a2: Vec<i64> = Vec::new();
    a2.push(2);
    body.push(ir_inst_new(5, IOP_UPSILON(), ITY_UNIT(), a2, IDATA_PHI_TARGET(), 3, 0, String::from("")));
    body
}

fn fold_phi_of_two(a: i64, b: i64) -> Vec<IrInst> {
    fold_phi_of_two_typed(a, b, ITY_U64())
}

fn fails_closed(c: String, label: String) -> bool {
    let fail_closed: String = String::from("  __ESBMC_assert(v0 == 0, \"");
    fail_closed.push_str(label);
    fail_closed.push_str(String::from("\");\n  v100.len = 0;\n"));
    c.contains(fail_closed) && !c.contains(String::from("__ESBMC_assume(v0 == 0 ||"))
}

fn keeps_assumption(c: String) -> bool {
    c.contains(String::from("__ESBMC_assume(v0 == 0 || (v")) && !c.contains(String::from("__ESBMC_assert(v0 == 0"))
}

// A provably-constant length reaches the capacity check through constant
// arithmetic, a cast, or a phi of identical constants exactly as a literal
// does; what is not provably constant keeps the assumption. Mirrors
// raw_parts_copy_folded_constant_len_fails_closed and
// raw_parts_copy_unfoldable_len_keeps_assumption in
// vow-verify/src/c_emitter.rs.
fn check_raw_parts_folded_len(extern_name: String, label: String, base_code: i64) -> i64 {
    let sum: Vec<IrInst> = Vec::new();
    sum.push(fold_const_u64(1, 1));
    sum.push(fold_const_u64(2, 116));
    sum.push(fold_u64_op(3, IOP_WADD(), 1, 2));
    if !fails_closed(emit_raw_parts_body_c(extern_name, sum, 3), label) { return base_code; }

    let cmul: Vec<IrInst> = Vec::new();
    cmul.push(fold_const_u64(1, 16));
    cmul.push(fold_const_u64(2, 2));
    cmul.push(fold_u64_op(3, IOP_CMUL(), 1, 2));
    if !fails_closed(emit_raw_parts_body_c(extern_name, cmul, 3), label) { return base_code + 1; }

    let wrapped: Vec<IrInst> = Vec::new();
    wrapped.push(fold_const_u64(1, 0));
    wrapped.push(fold_const_u64(2, 1));
    wrapped.push(fold_u64_op(3, IOP_WSUB(), 1, 2));
    if !fails_closed(emit_raw_parts_body_c(extern_name, wrapped, 3), label) { return base_code + 2; }

    let widened: Vec<IrInst> = Vec::new();
    widened.push(ir_inst_new(1, IOP_CONST_I32(), ITY_I32(), Vec::new(), IDATA_CONST_I32(), 0 - 1, 0, String::from("")));
    let cast_args: Vec<i64> = Vec::new();
    cast_args.push(1);
    widened.push(ir_inst_new(2, IOP_INT_CAST(), ITY_U64(), cast_args, IDATA_INTEGER_CAST(), 0, 0, String::from("")));
    if !fails_closed(emit_raw_parts_body_c(extern_name, widened, 2), label) { return base_code + 3; }

    if !fails_closed(emit_raw_parts_body_c(extern_name, fold_phi_of_two(23, 23), 3), label) { return base_code + 4; }

    if !keeps_assumption(emit_raw_parts_body_c(extern_name, fold_phi_of_two(1, 17), 3)) { return base_code + 5; }

    let overflow: Vec<IrInst> = Vec::new();
    overflow.push(fold_const_u64(1, 0 - 1));
    overflow.push(fold_const_u64(2, 2));
    overflow.push(fold_u64_op(3, IOP_CADD(), 1, 2));
    if !keeps_assumption(emit_raw_parts_body_c(extern_name, overflow, 3)) { return base_code + 6; }

    let small: Vec<IrInst> = Vec::new();
    small.push(fold_const_u64(1, 1));
    small.push(fold_const_u64(2, 2));
    small.push(fold_u64_op(3, IOP_WADD(), 1, 2));
    let small_c: String = emit_raw_parts_body_c(extern_name, small, 3);
    if !keeps_assumption(small_c) { return base_code + 7; }
    if small_c.contains(String::from("vow:model-bound")) { return base_code + 8; }
    0
}

// `extern_name(ptr, len)` over the instructions `ptr` (id 1) and `len` (id 2),
// with a leading arena argument (id 0) when `in_arena`. The call is value 3.
fn emit_ctor_c(extern_name: String, in_arena: bool, ptr: IrInst, len: IrInst) -> String {
    let ptr_ty: i64 = ptr.ty;
    let len_ty: i64 = len.ty;
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_arg(0, ITY_PTR(), 0));
    insts.push(ptr);
    insts.push(len);
    let call_args: Vec<i64> = Vec::new();
    if in_arena { call_args.push(0); }
    call_args.push(1);
    call_args.push(2);
    insts.push(mk_inst_call_extern(3, ITY_PTR(), call_args, extern_name));
    insts.push(mk_inst_return(4, 3));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, insts));
    let params: Vec<i64> = Vec::new();
    params.push(ITY_PTR());
    params.push(ptr_ty);
    params.push(len_ty);
    let funcs: Vec<IrFunction> = Vec::new();
    funcs.push(mk_function(0, String::from("ctor"), params, ITY_PTR(), blocks));
    emit_c_module(mk_module(funcs), 16, 16, 16, 16)
}

// A null pointer constant (id 1) in each form the IR can give it: typed as an
// integer or as a pointer.
fn null_ptr_inst(form: i64) -> IrInst {
    if form == 0 {
        return ir_inst_new(1, IOP_CONST_I64(), ITY_I64(), Vec::new(), IDATA_CONST_I64(), 0, 0, String::from(""));
    }
    if form == 1 {
        return ir_inst_new(1, IOP_CONST_I64(), ITY_PTR(), Vec::new(), IDATA_CONST_I64(), 0, 0, String::from(""));
    }
    if form == 2 {
        return ir_inst_new(1, IOP_CONST_U64(), ITY_PTR(), Vec::new(), IDATA_CONST_U64(), 0, 0, String::from(""));
    }
    ir_inst_new(1, IOP_CONST_I64(), ITY_LPTR(), Vec::new(), IDATA_CONST_I64(), 0, 0, String::from(""))
}

fn len_inst_form(form: i64) -> IrInst {
    if form == 0 { return mk_inst_arg(2, ITY_U64(), 2); }
    if form == 1 {
        return ir_inst_new(2, IOP_CONST_U64(), ITY_U64(), Vec::new(), IDATA_CONST_U64(), 3, 0, String::from(""));
    }
    ir_inst_new(2, IOP_CONST_U64(), ITY_U64(), Vec::new(), IDATA_CONST_U64(), 21, 0, String::from(""))
}

// A provably null source is empty whatever the length, so no capacity
// assumption is emitted at all and the proof is not reported as bounded. A null
// literal is recognised whether the IR types it as an integer or as a pointer.
// Mirrors raw_parts_copy_literal_null_source_is_empty_without_a_bound in
// vow-verify/src/c_emitter.rs.
fn check_raw_parts_literal_null_is_empty(extern_name: String, base_code: i64) -> i64 {
    let mut form: i64 = 0;
    while form < 4 {
        let mut lf: i64 = 0;
        while lf < 3 {
            let c: String = emit_ctor_c(extern_name, false, null_ptr_inst(form), len_inst_form(lf));
            let code: i64 = base_code + form * 3 + lf;
            if !c.contains(String::from("  v3.len = 0;\n")) { return code; }
            if c.contains(String::from("__ESBMC_assume(v1 == 0")) { return code; }
            if c.contains(String::from("__ESBMC_assert(v1 == 0")) { return code; }
            if c.contains(String::from("vow:model-bound")) { return code; }
            lf = lf + 1;
        }
        form = form + 1;
    }
    0
}

// A phi of null constants is a null source too, whatever type it carries.
// Mirrors raw_parts_copy_phi_of_null_constants_is_empty in
// vow-verify/src/c_emitter.rs.
fn check_raw_parts_phi_of_null_is_empty(extern_name: String, base_code: i64) -> i64 {
    let mut which: i64 = 0;
    while which < 2 {
        let phi_ty: i64 = { if which == 0 { ITY_U64() } else { ITY_PTR() } };
        let insts: Vec<IrInst> = Vec::new();
        insts.push(mk_inst_arg(0, ITY_U64(), 0));
        let phi_body: Vec<IrInst> = fold_phi_of_two_typed(0, 0, phi_ty);
        let mut pi: u64 = 0u64;
        while pi < phi_body.len() {
            insts.push(phi_body[pi]);
            pi = pi + 1u64;
        }
        let call_args: Vec<i64> = Vec::new();
        call_args.push(3);
        call_args.push(0);
        insts.push(mk_inst_call_extern(100, ITY_PTR(), call_args, extern_name));
        insts.push(mk_inst_return(101, 100));
        let blocks: Vec<IrBlock> = Vec::new();
        blocks.push(mk_block(0, insts));
        let params: Vec<i64> = Vec::new();
        params.push(ITY_U64());
        let funcs: Vec<IrFunction> = Vec::new();
        funcs.push(mk_function(0, String::from("raw_parts"), params, ITY_PTR(), blocks));
        let c: String = emit_c_module(mk_module(funcs), 16, 16, 16, 16);
        if !c.contains(String::from("  v100.len = 0;\n")) { return base_code + which; }
        if c.contains(String::from("vow:model-bound")) { return base_code + which; }
        if c.contains(String::from("__ESBMC_assume(v3 == 0")) { return base_code + which; }
        which = which + 1;
    }
    0
}

fn string_new_beyond_len_inst(form: i64) -> IrInst {
    if form == 0 {
        return ir_inst_new(2, IOP_CONST_I64(), ITY_I64(), Vec::new(), IDATA_CONST_I64(), 16, 0, String::from(""));
    }
    if form == 1 {
        return ir_inst_new(2, IOP_CONST_I64(), ITY_I64(), Vec::new(), IDATA_CONST_I64(), 0 - 1, 0, String::from(""));
    }
    ir_inst_new(2, IOP_CONST_U64(), ITY_U64(), Vec::new(), IDATA_CONST_U64(), 0 - 1, 0, String::from(""))
}

// String::new(ptr, len) shares the raw-parts model: a constant length outside
// the model capacity fails closed for a non-null source, a null source is
// empty, and a non-constant length is a tagged capacity assumption. Mirrors
// string_new_follows_the_raw_parts_model in vow-verify/src/c_emitter.rs.
fn check_string_new_model(extern_name: String, in_arena: bool, base_code: i64) -> i64 {
    let fail_closed: String = String::from("  __ESBMC_assert(v1 == 0, \"string capacity\");\n  v3.len = 0;\n");
    let mut form: i64 = 0;
    while form < 3 {
        let c: String = emit_ctor_c(extern_name, in_arena, mk_inst_arg(1, ITY_I64(), 1), string_new_beyond_len_inst(form));
        if !c.contains(fail_closed) { return base_code + form; }
        if c.contains(String::from("__ESBMC_assume(v1 == 0")) { return base_code + form; }
        if c.contains(String::from("vow:model-bound")) { return base_code + form; }
        form = form + 1;
    }
    let zero_len: IrInst = ir_inst_new(2, IOP_CONST_I64(), ITY_I64(), Vec::new(), IDATA_CONST_I64(), 0, 0, String::from(""));
    let in_range: String = emit_ctor_c(extern_name, in_arena, mk_inst_arg(1, ITY_I64(), 1), zero_len);
    if !in_range.contains(String::from("__ESBMC_assume(v1 == 0 || (v2 >= 0 && v2 < 16));\n")) { return base_code + 3; }
    if in_range.contains(String::from("vow:model-bound")) { return base_code + 4; }

    let variable: String = emit_ctor_c(extern_name, in_arena, mk_inst_arg(1, ITY_I64(), 1), mk_inst_arg(2, ITY_U64(), 2));
    if !variable.contains(String::from("__ESBMC_assume(v1 == 0 || (v2 < 16)); /* vow:model-bound String 16 */\n  v3.len = v1 == 0 ? 0 : v2;")) { return base_code + 5; }

    let empty_len: IrInst = ir_inst_new(2, IOP_CONST_I64(), ITY_I64(), Vec::new(), IDATA_CONST_I64(), 0, 0, String::from(""));
    let empty: String = emit_ctor_c(extern_name, in_arena, null_ptr_inst(0), empty_len);
    if !empty.contains(String::from("  v3.len = 0;\n")) { return base_code + 6; }
    if empty.contains(String::from("__ESBMC_assume(v")) { return base_code + 7; }
    0
}

// `len_extern(c)` over a collection that is parameter 0 (a GetArg), or, when
// via_field_get, a FieldGet of a constant base. The caps are all 16.
fn collection_len_c(len_extern: String, via_field_get: bool) -> String {
    let insts: Vec<IrInst> = Vec::new();
    let params: Vec<i64> = Vec::new();
    let mut coll: i64 = 0;
    if via_field_get {
        insts.push(ir_inst_new(0, IOP_CONST_I64(), ITY_I64(), Vec::new(), IDATA_CONST_I64(), 0, 0, String::from("")));
        let fargs: Vec<i64> = Vec::new();
        fargs.push(0);
        insts.push(ir_inst_new(1, IOP_FIELD_GET(), ITY_PTR(), fargs, IDATA_FIELD(), 0, 0, String::from("")));
        coll = 1;
    } else {
        insts.push(mk_inst_arg(0, ITY_PTR(), 0));
        params.push(ITY_PTR());
    }
    let call_args: Vec<i64> = Vec::new();
    call_args.push(coll);
    insts.push(mk_inst_call_extern(10, ITY_I64(), call_args, len_extern));
    insts.push(mk_inst_return(11, 10));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, insts));
    let funcs: Vec<IrFunction> = Vec::new();
    funcs.push(mk_function(0, String::from("collection_len"), params, ITY_I64(), blocks));
    emit_c_module(mk_module(funcs), 16, 16, 16, 16)
}

// Every site that restricts a collection length to the model capacity carries a
// marker, for every kind and on both the parameter and the struct-field path.
// Mirrors collection_lengths_carry_model_bound_markers in
// vow-verify/src/c_emitter.rs.
fn check_collection_length_markers(len_extern: String, name: String, slug: String, base_code: i64) -> i64 {
    let mut which: i64 = 0;
    while which < 2 {
        let via_field_get: bool = which == 1;
        let c: String = collection_len_c(len_extern, via_field_get);
        let ids: String = { if via_field_get { String::from("1") } else { String::from("0") } };
        let lead: String = { if via_field_get { str3(String::from("  /* FieldGet -> "), slug, String::from(" */ ")) } else { str3(String::from("  __vow_"), slug, String::from("_t v0;\n  ")) } };
        let want: String = str5(lead, String::from("v"), ids, String::from(".len = __VERIFIER_nondet_unsigned_long();\n  __ESBMC_assume(v"),
            str5(ids, String::from(".len <= 16); /* vow:model-bound "), name, String::from(" 16 */\n"), String::new()));
        if !c.contains(want) { return base_code + which; }
        let sorted: String = str3(String::from("  for (uint64_t __si = 0; __si + 1 < v"), ids, String::from(".len; __si++)\n    __ESBMC_assume(v"));
        let is_btree: bool = name == String::from("BTreeMap");
        if is_btree && !c.contains(sorted) { return base_code + 2 + which; }
        if !is_btree && c.contains(String::from("__si")) { return base_code + 4 + which; }
        which = which + 1;
    }
    0
}

fn check_const_value_by_id_table() -> i64 {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_arg(0, ITY_I64(), 0));
    insts.push(ir_inst_new(1, IOP_CONST_U64(), ITY_U64(), Vec::new(), IDATA_CONST_U64(), 15, 0, String::from("")));
    insts.push(ir_inst_new(3, IOP_CONST_U64(), ITY_U64(), Vec::new(), IDATA_CONST_U64(), 0 - 1, 0, String::from("")));
    insts.push(ir_inst_new(4, IOP_CONST_I64(), ITY_I64(), Vec::new(), IDATA_CONST_U64(), 0 - 7, 0, String::from("")));
    insts.push(ir_inst_new(5, IOP_CONST_I64(), ITY_I64(), Vec::new(), IDATA_CONST_U64(), 16, 0, String::from("")));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, insts));
    let f: IrFunction = mk_function(30, String::from("const_lens"), Vec::new(), ITY_UNIT(), blocks);

    let table: Vec<i64> = build_const_value_by_id(f, mk_module(Vec::new()), Vec::new());
    if table.len() != 6 { return 260; }
    if raw_parts_const_len_exceeds_model(table, 0, 16) { return 261; }
    if raw_parts_const_len_exceeds_model(table, 1, 16) { return 262; }
    if !raw_parts_const_len_exceeds_model(table, 1, 15) { return 263; }
    if raw_parts_const_len_exceeds_model(table, 2, 16) { return 264; }
    if !raw_parts_const_len_exceeds_model(table, 3, 16) { return 265; }
    if !raw_parts_const_len_exceeds_model(table, 4, 16) { return 266; }
    if !raw_parts_const_len_exceeds_model(table, 5, 16) { return 267; }
    if raw_parts_const_len_exceeds_model(table, 5, 17) { return 268; }
    if raw_parts_const_len_exceeds_model(table, 6, 16) { return 269; }
    if raw_parts_const_len_exceeds_model(table, 0 - 1, 16) { return 270; }

    let empty: IrFunction = mk_function(31, String::from("empty_lens"), Vec::new(), ITY_UNIT(), Vec::new());
    if build_const_value_by_id(empty, mk_module(Vec::new()), Vec::new()).len() != 0 { return 271; }
    0
}

fn check_inst_ty_by_id_table() -> i64 {
    let first_insts: Vec<IrInst> = Vec::new();
    first_insts.push(mk_inst_arg(0, ITY_I32(), 0));
    first_insts.push(mk_inst_arg(4, ITY_U64(), 1));

    let second_insts: Vec<IrInst> = Vec::new();
    second_insts.push(mk_inst_arg(-1, ITY_U16(), 2));
    second_insts.push(mk_inst_arg(2, ITY_U8(), 3));

    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, first_insts));
    blocks.push(mk_block(1, second_insts));
    let f: IrFunction = mk_function(
        20,
        String::from("sparse_types"),
        Vec::new(),
        ITY_UNIT(),
        blocks
    );

    let table: Vec<i64> = build_inst_ty_by_id(f);
    if table.len() != 5 { return 200; }
    if table[0] != ITY_I32() { return 201; }
    if table[2] != ITY_U8() { return 202; }
    if table[4] != ITY_U64() { return 203; }
    if table[1] != ITY_I64() { return 204; }
    if inst_ty_of(table, 2) != ITY_U8() { return 205; }
    if inst_ty_of(table, 1) != ITY_I64() { return 206; }
    if inst_ty_of(table, -1) != ITY_I64() { return 207; }
    if inst_ty_of(table, table.len() as i64) != ITY_I64() { return 208; }
    if inst_ty_of(table, table.len() as i64 + 10) != ITY_I64() { return 209; }

    let empty: IrFunction = mk_function(
        21,
        String::from("empty_types"),
        Vec::new(),
        ITY_UNIT(),
        Vec::new()
    );
    if build_inst_ty_by_id(empty).len() != 0 { return 210; }
    0
}

fn check_len_fields_are_unsigned() -> i64 {
    let funcs: Vec<IrFunction> = Vec::new();
    let c: String = emit_c_module(mk_module(funcs), 16, 16, 16, 16);
    if !c.contains(String::from("typedef struct { uint64_t len; int64_t data[16]; } __vow_vec_t;")) { return 230; }
    if !c.contains(String::from("typedef struct { uint64_t len; int8_t data[16]; } __vow_string_t;")) { return 231; }
    if !c.contains(String::from("typedef struct { uint64_t len; int64_t keys[16]; int64_t vals[16]; } __vow_hashmap_t;")) { return 232; }
    if !c.contains(String::from("typedef struct { uint64_t len; int64_t keys[16]; int64_t vals[16]; } __vow_btreemap_t;")) { return 233; }
    0
}

fn check_bounds_assert_cross_block() -> i64 {
    let get_c: String = emit_indexed_container_cross_block_c(
        String::from("__vow_vec_len"),
        String::from("__vow_vec_get_val"),
        ITY_U16()
    );
    if !get_c.contains(String::from(
        "  __ESBMC_assert(v2 < v0.len, \"vec bounds\");\n"
    )) { return 220; }

    let set_c: String = emit_indexed_container_cross_block_c(
        String::from("__vow_vec_len"),
        String::from("__vow_vec_set_val"),
        ITY_I32()
    );
    if !set_c.contains(String::from(
        "  __ESBMC_assert(v2 >= 0 && v2 < (int64_t)v0.len, \"vec bounds\");\n"
    )) { return 221; }

    let byte_at_c: String = emit_indexed_container_cross_block_c(
        String::from("__vow_string_len"),
        String::from("__vow_string_byte_at"),
        ITY_U64()
    );
    if !byte_at_c.contains(String::from(
        "  __ESBMC_assert(v2 < v0.len, \"string bounds\");\n"
    )) { return 222; }
    0
}

// process_* Builtin Operations are all [Effect::IO]-tagged, so
// is_modelable's effect-emptiness gate already excludes them from the C
// model. This pins that invariant with evidence (issue #1273 AC #6).
fn check_process_builtins_are_not_known_to_verifier() -> i64 {
    if is_known_builtin(String::from("__vow_process_exit")) { return 300; }
    if is_known_builtin(String::from("__vow_process_run")) { return 301; }
    if is_known_builtin(String::from("__vow_process_get_stdout")) { return 302; }
    if is_known_builtin(String::from("__vow_process_wait")) { return 303; }
    0
}

fn check_str_starts_with() -> i64 {
    if str_starts_with(String::from("xbc"), String::from("abc")) { return 400; }
    if !str_starts_with(String::from("abc"), String::from("abc")) { return 401; }
    if !str_starts_with(String::from("abcdef"), String::from("abc")) { return 402; }
    if !str_starts_with(String::from("abc"), String::from("")) { return 403; }
    if str_starts_with(String::from("ab"), String::from("abc")) { return 404; }
    if str_starts_with(String::from("abz"), String::from("abc")) { return 405; }
    0
}

// Mirrors the `shift_function` parameterize-the-differing-operand pattern.
fn field_set_test_function(id: i64, name: String, params: Vec<i64>, value_inst: IrInst) -> IrFunction {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_arg(0, ITY_PTR(), 0));
    insts.push(value_inst);
    let fs_args: Vec<i64> = Vec::new();
    fs_args.push(0);
    fs_args.push(1);
    insts.push(ir_inst_new(2, IOP_FIELD_SET(), ITY_UNIT(), fs_args, IDATA_FIELD(), 0, 0, String::from("")));
    insts.push(mk_inst_return(3, 1));

    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, insts));
    mk_function(id, name, params, ITY_I64(), blocks)
}

fn check_wide_field_set_is_non_modelable() -> i64 {
    let wide_params: Vec<i64> = Vec::new();
    wide_params.push(ITY_PTR());
    wide_params.push(ITY_I128());
    let f: IrFunction = field_set_test_function(410, String::from("store_wide"), wide_params, mk_inst_arg(1, ITY_I128(), 1));
    let funcs: Vec<IrFunction> = Vec::new();
    funcs.push(f);
    let m: IrModule = mk_module(funcs);
    let const_fn_indices: Vec<i64> = Vec::new();

    let reason: String = non_modelable_reason(f, m, const_fn_indices);
    if reason == String::from("") { return 410; }
    if !reason.contains(String::from("FieldSet at 128-bit width")) { return 411; }

    // Companion: the gate must reject only the wide FieldSet, not every FieldSet.
    let narrow_params: Vec<i64> = Vec::new();
    narrow_params.push(ITY_PTR());
    let narrow_f: IrFunction = field_set_test_function(411, String::from("store_narrow"), narrow_params, mk_inst_const_i64(1, 0));
    let narrow_funcs: Vec<IrFunction> = Vec::new();
    narrow_funcs.push(narrow_f);
    let narrow_m: IrModule = mk_module(narrow_funcs);
    if non_modelable_reason(narrow_f, narrow_m, const_fn_indices) != String::from("") { return 412; }
    0
}

// Parameterizes only the string-pool index the IOP_CONST_STR() literal points at.
fn matches_literal_test_function(id: i64, name: String, literal_idx: i64) -> IrFunction {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_const_i64(0, 0));
    insts.push(mk_inst_const_i64(1, 0));
    insts.push(ir_inst_new(2, IOP_CONST_STR(), ITY_PTR(), Vec::new(), IDATA_CONST_STR(), literal_idx, 0, String::from("")));
    let call_args: Vec<i64> = Vec::new();
    call_args.push(0);
    call_args.push(1);
    call_args.push(2);
    insts.push(mk_inst_call_extern(3, ITY_I64(), call_args, String::from("__vow_string_matches_literal_at")));
    insts.push(mk_inst_return(4, 3));

    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, insts));
    mk_function(id, name, Vec::new(), ITY_I64(), blocks)
}

fn check_string_matches_literal_at_oob_index_falls_back() -> i64 {
    let f: IrFunction = matches_literal_test_function(420, String::from("matches_literal_oob"), 1);
    let funcs: Vec<IrFunction> = Vec::new();
    funcs.push(f);
    let m: IrModule = mk_module(funcs);
    m.strings.push(String::from("ab"));

    let c: String = String::from("");
    let const_fn_indices: Vec<i64> = Vec::new();
    let modelable_fi_set: Vec<i64> = Vec::new();
    emit_c_function(c, f, const_fn_indices, modelable_fi_set, m, 16, 16, 16, 16, false, false, 0);
    if !c.contains(String::from("/* opcode Call not modelled */")) { return 420; }

    // Companion: an in-range index on the same shape must NOT fall back.
    let in_range_f: IrFunction = matches_literal_test_function(421, String::from("matches_literal_in_range"), 0);
    let in_range_funcs: Vec<IrFunction> = Vec::new();
    in_range_funcs.push(in_range_f);
    let in_range_m: IrModule = mk_module(in_range_funcs);
    in_range_m.strings.push(String::from("ab"));
    let c_in_range: String = String::from("");
    emit_c_function(c_in_range, in_range_f, const_fn_indices, modelable_fi_set, in_range_m, 16, 16, 16, 16, false, false, 0);
    if c_in_range.contains(String::from("/* opcode Call not modelled */")) { return 421; }
    0
}

fn first_index(hay: String, needle: String) -> i64 {
    let n: u64 = needle.len();
    let h: u64 = hay.len();
    if n > h { return 0 - 1; }
    let mut i: u64 = 0u64;
    while i + n <= h {
        if hay.substring(i, i + n) == needle { return i as i64; }
        i = i + 1u64;
    }
    0 - 1
}

// Shift and checked-arithmetic helpers are emitted width ascending, signed
// before unsigned, `shl` before `shr` -- the order `ModelHelpers` in
// vow-verify/src/c_emitter.rs keys its sets by -- so both emitters print the
// same preamble for the same module.
fn check_model_helpers_use_canonical_order() -> i64 {
    let funcs: Vec<IrFunction> = Vec::new();
    funcs.push(shift_function(60, String::from("shr_u8"), ITY_U8(), IOP_SHR()));
    funcs.push(shift_function(61, String::from("shl_u16"), ITY_U16(), IOP_SHL()));
    funcs.push(shift_function(62, String::from("shr_i8"), ITY_I8(), IOP_SHR()));
    funcs.push(shift_function(63, String::from("shl_i8"), ITY_I8(), IOP_SHL()));
    funcs.push(shift_function(64, String::from("shl_i64"), ITY_I64(), IOP_SHL()));
    let c: String = emit_c_module(mk_module(funcs), 16, 16, 16, 16);
    let a: i64 = first_index(c, String::from("static inline int8_t __vow_shl_i8("));
    let b: i64 = first_index(c, String::from("static inline int8_t __vow_shr_i8("));
    let d: i64 = first_index(c, String::from("static inline uint8_t __vow_shr_u8("));
    let e: i64 = first_index(c, String::from("static inline uint16_t __vow_shl_u16("));
    let g: i64 = first_index(c, String::from("static inline int64_t __vow_shl_i64("));
    if a < 0 || b < 0 || d < 0 || e < 0 || g < 0 { return 600; }
    if !(a < b) { return 601; }
    if !(b < d) { return 602; }
    if !(d < e) { return 603; }
    if !(e < g) { return 604; }
    if c.contains(String::from("& 63ULL")) { return 605; }
    0
}

fn substring_function(id: i64, read_bytes: bool) -> IrFunction {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_arg(0, ITY_PTR(), 0));
    insts.push(mk_inst_arg(1, ITY_U64(), 1));
    insts.push(mk_inst_arg(2, ITY_U64(), 2));
    let sub_args: Vec<i64> = Vec::new();
    sub_args.push(0);
    sub_args.push(1);
    sub_args.push(2);
    insts.push(mk_inst_call_extern(3, ITY_PTR(), sub_args, String::from("__vow_string_substring")));
    let use_args: Vec<i64> = Vec::new();
    use_args.push(3);
    if read_bytes {
        insts.push(mk_inst_const_i64(4, 0));
        use_args.push(4);
        insts.push(mk_inst_call_extern(5, ITY_I64(), use_args, String::from("__vow_string_byte_at")));
        insts.push(mk_inst_return(6, 5));
    } else {
        insts.push(mk_inst_call_extern(4, ITY_U64(), use_args, String::from("__vow_string_len")));
        insts.push(mk_inst_return(5, 4));
    }
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, insts));
    let params: Vec<i64> = Vec::new();
    params.push(ITY_PTR());
    params.push(ITY_U64());
    params.push(ITY_U64());
    mk_function(id, String::from("sub"), params, { if read_bytes { ITY_I64() } else { ITY_U64() } }, blocks)
}

// The substring's length is exact before the copy; the byte-copy loop is only
// emitted when an instruction reads the result's bytes. Mirrors
// substring_copy_loop_follows_byte_reads in vow-verify/src/c_emitter.rs.
fn check_substring_copy_loop_follows_byte_reads() -> i64 {
    let len_funcs: Vec<IrFunction> = Vec::new();
    len_funcs.push(substring_function(0, false));
    let len_c: String = emit_c_module(mk_module(len_funcs), 16, 16, 16, 16);
    if !len_c.contains(String::from("/* length-only substring: bytes never read, copy loop elided */")) { return 610; }
    if len_c.contains(String::from("for (uint64_t __i = 0; __i < v3.len")) { return 611; }
    if !len_c.contains(String::from("v3.len = __substring_end_3 - __substring_start_3;")) { return 612; }

    let byte_funcs: Vec<IrFunction> = Vec::new();
    byte_funcs.push(substring_function(0, true));
    let byte_c: String = emit_c_module(mk_module(byte_funcs), 16, 16, 16, 16);
    if !byte_c.contains(String::from("for (uint64_t __i = 0; __i < v3.len && __i < 16; __i++) {")) { return 613; }
    if !byte_c.contains(String::from("v3.data[__i] = v0.data[__substring_start_3 + __i];")) { return 614; }
    if byte_c.contains(String::from("copy loop elided")) { return 615; }
    0
}

// A length that is the result of calling a constant-returning function is
// folded like a literal: a constant beyond the capacity fails closed, one
// inside it stays an exact length. Mirrors
// raw_parts_copy_const_fn_len_folds_like_a_literal in
// vow-verify/src/c_emitter.rs.
fn const_fn_len_module(value: i64, extern_name: String) -> String {
    let cap_insts: Vec<IrInst> = Vec::new();
    cap_insts.push(fold_const_u64(0, value));
    cap_insts.push(mk_inst_return(1, 0));
    let cap_blocks: Vec<IrBlock> = Vec::new();
    cap_blocks.push(mk_block(0, cap_insts));

    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_arg(0, ITY_I64(), 0));
    insts.push(mk_inst_call_target(1, ITY_U64(), Vec::new(), 0));
    let call_args: Vec<i64> = Vec::new();
    call_args.push(0);
    call_args.push(1);
    insts.push(mk_inst_call_extern(100, ITY_PTR(), call_args, extern_name));
    insts.push(mk_inst_return(101, 100));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, insts));
    let params: Vec<i64> = Vec::new();
    params.push(ITY_I64());

    let funcs: Vec<IrFunction> = Vec::new();
    funcs.push(mk_function(0, String::from("capacity"), Vec::new(), ITY_U64(), cap_blocks));
    funcs.push(mk_function(1, String::from("raw_parts"), params, ITY_PTR(), blocks));
    emit_c_module(mk_module(funcs), 16, 16, 16, 16)
}

fn check_const_fn_len_folds_like_a_literal(extern_name: String, label: String, base_code: i64) -> i64 {
    let beyond: String = const_fn_len_module(500, extern_name);
    if !beyond.contains(String::from("v1 = 500ULL;")) { return base_code; }
    if !fails_closed(beyond, label) { return base_code + 1; }
    let inside: String = const_fn_len_module(3, extern_name);
    if !keeps_assumption(inside) { return base_code + 2; }
    if inside.contains(String::from("vow:model-bound")) { return base_code + 3; }
    0
}

fn check_u64_literals_print_as_unsigned() -> i64 {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(fold_const_u64(0, 0 - 1));
    insts.push(fold_const_u64(1, 0 - 8446744073709551616));
    insts.push(ir_inst_new(2, IOP_CONST_I32(), ITY_U32(), Vec::new(), IDATA_CONST_I32(), 0 - 1, 0, String::from("")));
    insts.push(ir_inst_new(3, IOP_CONST_U8(), ITY_I8(), Vec::new(), IDATA_CONST_U8(), 0 - 5, 0, String::from("")));
    insts.push(mk_inst_return(4, 0));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, insts));
    let funcs: Vec<IrFunction> = Vec::new();
    funcs.push(mk_function(0, String::from("consts"), Vec::new(), ITY_U64(), blocks));
    let c: String = emit_c_module(mk_module(funcs), 16, 16, 16, 16);
    if !c.contains(String::from("v0 = 18446744073709551615ULL;")) { return 620; }
    if !c.contains(String::from("v1 = 10000000000000000000ULL;")) { return 621; }
    if !c.contains(String::from("v2 = 4294967295;")) { return 622; }
    if !c.contains(String::from("v3 = UINT8_C(251);")) { return 623; }
    0
}

