module TestCEmitter

use ir
use c_emitter
use tests.builders

fn identity_function(id: i64, name: String) -> IrFunction {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_arg(0, ITY_I64(), 0));
    insts.push(mk_inst_return(1, 0));

    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, insts));

    let params: Vec<i64> = Vec::new();
    params.push(ITY_I64());
    mk_function(id, name, params, ITY_I64(), blocks)
}

fn raw_i64_signature(name: String) -> String {
    let s: String = String::from("int64_t ");
    s.push_str(name);
    s.push_str(String::from("("));
    s
}

fn mangled_i64_signature(id: i64) -> String {
    let s: String = String::from("int64_t vow_user_fn_");
    s.push_str(i64_to_string(id));
    s.push_str(String::from("("));
    s
}

fn check_name_modelable_and_mangled(name: String, id: i64, base_code: i64) -> i64 {
    let f: IrFunction = identity_function(id, name);
    let funcs: Vec<IrFunction> = Vec::new();
    funcs.push(f);
    let m: IrModule = mk_module(funcs);
    let const_fn_indices: Vec<i64> = Vec::new();

    let reason: String = non_modelable_reason(f, m, const_fn_indices);
    if reason != String::from("") {
        return base_code;
    }

    let c: String = emit_c_module(m, 16, 16, 16, 16);
    if !c.contains(mangled_i64_signature(id)) {
        return base_code + 1;
    }
    if c.contains(raw_i64_signature(name)) {
        return base_code + 2;
    }
    0
}

fn check_modelable_call_target_is_mangled() -> i64 {
    let callee: IrFunction = identity_function(5, String::from("ldiv"));

    let target_insts: Vec<IrInst> = Vec::new();
    target_insts.push(mk_inst_arg(0, ITY_I64(), 0));
    let call_args: Vec<i64> = Vec::new();
    call_args.push(0);
    target_insts.push(mk_inst_call_target(1, ITY_I64(), call_args, 5));
    target_insts.push(mk_inst_return(2, 1));

    let target_blocks: Vec<IrBlock> = Vec::new();
    target_blocks.push(mk_block(0, target_insts));
    let target_params: Vec<i64> = Vec::new();
    target_params.push(ITY_I64());
    let target: IrFunction = mk_function(2, String::from("labs"), target_params, ITY_I64(), target_blocks);

    let funcs: Vec<IrFunction> = Vec::new();
    funcs.push(target);
    funcs.push(callee);
    let m: IrModule = mk_module(funcs);

    let const_fn_indices: Vec<i64> = Vec::new();
    let reason: String = non_modelable_reason(target, m, const_fn_indices);
    if reason != String::from("") {
        return 20;
    }

    let callee_fis: Vec<i64> = Vec::new();
    callee_fis.push(5);
    let modelable_fis: Vec<i64> = Vec::new();
    modelable_fis.push(5);
    let c: String = emit_c_module_with_callees(m, 2, callee_fis, modelable_fis, 16, 16, 16, 16, false, false);

    if !c.contains(String::from("int64_t vow_user_fn_5(int64_t p0);")) {
        return 21;
    }
    if !c.contains(String::from("int64_t vow_user_fn_5(int64_t p0) {")) {
        return 22;
    }
    if !c.contains(String::from("v1 = vow_user_fn_5(v0);")) {
        return 23;
    }
    if c.contains(String::from("int64_t ldiv(")) {
        return 24;
    }
    if c.contains(String::from(" ldiv(v0)")) {
        return 25;
    }
    if c.contains(String::from("int64_t labs(")) {
        return 26;
    }
    0
}

fn check_complexity_descriptor_routing() -> i64 {
    let descriptor_only_insts: Vec<IrInst> = Vec::new();
    descriptor_only_insts.push(mk_inst_arg(0, ITY_I64(), 0));
    descriptor_only_insts.push(mk_inst(1, IOP_COMPLEXITY_DESCRIPTOR(), ITY_UNIT(), Vec::new()));
    descriptor_only_insts.push(mk_inst_return(2, 0));
    let descriptor_only_blocks: Vec<IrBlock> = Vec::new();
    descriptor_only_blocks.push(mk_block(0, descriptor_only_insts));
    let descriptor_only_params: Vec<i64> = Vec::new();
    descriptor_only_params.push(ITY_I64());
    let descriptor_only: IrFunction = mk_function(
        11,
        String::from("linear_identity"),
        descriptor_only_params,
        ITY_I64(),
        descriptor_only_blocks
    );

    let descriptor_only_funcs: Vec<IrFunction> = Vec::new();
    descriptor_only_funcs.push(descriptor_only);
    let descriptor_only_module: IrModule = mk_module(descriptor_only_funcs);
    let const_fn_indices: Vec<i64> = Vec::new();
    if non_modelable_reason(descriptor_only, descriptor_only_module, const_fn_indices) != String::from("") {
        return 27;
    }
    let descriptor_only_c: String = emit_c_module(descriptor_only_module, 16, 16, 16, 16);
    if descriptor_only_c.contains(String::from("  __ESBMC_assume("))
       || descriptor_only_c.contains(String::from("  __ESBMC_assert(")) {
        return 28;
    }

    let ensured_insts: Vec<IrInst> = Vec::new();
    ensured_insts.push(mk_inst_arg(0, ITY_I64(), 0));
    ensured_insts.push(mk_inst(1, IOP_COMPLEXITY_DESCRIPTOR(), ITY_UNIT(), Vec::new()));
    let eq_args: Vec<i64> = Vec::new();
    eq_args.push(0);
    eq_args.push(0);
    ensured_insts.push(ir_inst_new(
        2,
        IOP_EQ(),
        ITY_BOOL(),
        eq_args,
        IDATA_INTEGER(),
        ITY_I64(),
        0,
        String::from("")
    ));
    let ensures_args: Vec<i64> = Vec::new();
    ensures_args.push(2);
    ensured_insts.push(ir_inst_new(
        3,
        IOP_VOW_ENS(),
        ITY_UNIT(),
        ensures_args,
        IDATA_VOW_ID(),
        0,
        0,
        String::from("")
    ));
    ensured_insts.push(mk_inst_return(4, 0));
    let ensured_blocks: Vec<IrBlock> = Vec::new();
    ensured_blocks.push(mk_block(0, ensured_insts));
    let ensured_params: Vec<i64> = Vec::new();
    ensured_params.push(ITY_I64());
    let ensured: IrFunction = mk_function(
        12,
        String::from("identity_with_ensures"),
        ensured_params,
        ITY_I64(),
        ensured_blocks
    );
    let ensured_funcs: Vec<IrFunction> = Vec::new();
    ensured_funcs.push(ensured);
    let ensured_c: String = emit_c_module(mk_module(ensured_funcs), 16, 16, 16, 16);
    if !ensured_c.contains(String::from("  __ESBMC_assert(v2, \"vow:0\");")) {
        return 29;
    }
    0
}

fn shift_function(id: i64, name: String, ty: i64, op: i64) -> IrFunction {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_arg(0, ty, 0));
    insts.push(mk_inst_arg(1, ITY_U32(), 1));
    let shift_args: Vec<i64> = Vec::new();
    shift_args.push(0);
    shift_args.push(1);
    insts.push(ir_inst_new(
        2,
        op,
        ty,
        shift_args,
        IDATA_INTEGER(),
        ty,
        0,
        String::from("")
    ));
    insts.push(mk_inst_return(3, 2));

    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, insts));
    let params: Vec<i64> = Vec::new();
    params.push(ty);
    params.push(ITY_U32());
    mk_function(id, name, params, ty, blocks)
}

fn check_narrow_shifts_use_helpers() -> i64 {
    let funcs: Vec<IrFunction> = Vec::new();
    funcs.push(shift_function(30, String::from("shl_i8"), ITY_I8(), IOP_SHL()));
    funcs.push(shift_function(31, String::from("shr_u8"), ITY_U8(), IOP_SHR()));
    funcs.push(shift_function(32, String::from("shl_i16"), ITY_I16(), IOP_SHL()));
    funcs.push(shift_function(33, String::from("shr_u16"), ITY_U16(), IOP_SHR()));
    funcs.push(shift_function(34, String::from("shl_u32"), ITY_U32(), IOP_SHL()));
    funcs.push(shift_function(40, String::from("shl_i32"), ITY_I32(), IOP_SHL()));

    let c: String = emit_c_module(mk_module(funcs), 16, 16, 16, 16);
    if !c.contains(String::from("static inline int8_t __vow_shl_i8")) { return 30; }
    if !c.contains(String::from("static inline uint8_t __vow_shr_u8")) { return 31; }
    if !c.contains(String::from("static inline int16_t __vow_shl_i16")) { return 32; }
    if !c.contains(String::from("static inline uint16_t __vow_shr_u16")) { return 33; }
    if !c.contains(String::from("static inline uint32_t __vow_shl_u32")) { return 34; }
    if !c.contains(String::from("__vow_shl_i8(v0, v1)")) { return 35; }
    if !c.contains(String::from("__vow_shr_u8(v0, v1)")) { return 36; }
    if !c.contains(String::from("__vow_shl_i16(v0, v1)")) { return 37; }
    if !c.contains(String::from("__vow_shr_u16(v0, v1)")) { return 38; }
    if !c.contains(String::from("__vow_shl_u32(v0, v1)")) { return 39; }
    if !c.contains(String::from("__vow_shl_i32(v0, v1)")) { return 41; }
    // The i32 shift-count assert must share the same "integer shift count"
    // label the other widths use, so counterexample parsing (#1144) maps it
    // to the same description on both compilers instead of falling through.
    if !c.contains(String::from(" < 32, \"integer shift count\");")) { return 42; }
    if c.contains(String::from("\"i32 shift count\"")) { return 43; }
    0
}

fn check_wide_shifts_use_helpers() -> i64 {
    let funcs: Vec<IrFunction> = Vec::new();
    funcs.push(shift_function(50, String::from("shl_i64"), ITY_I64(), IOP_SHL()));
    funcs.push(shift_function(51, String::from("shr_u64"), ITY_U64(), IOP_SHR()));
    funcs.push(shift_function(52, String::from("shl_i128"), ITY_I128(), IOP_SHL()));
    funcs.push(shift_function(53, String::from("shr_u128"), ITY_U128(), IOP_SHR()));

    let c: String = emit_c_module(mk_module(funcs), 16, 16, 16, 16);
    if !c.contains(String::from("__vow_shl_i64(v0, v1)")) { return 50; }
    if !c.contains(String::from("__vow_shr_u64(v0, v1)")) { return 51; }
    if !c.contains(String::from("static inline __int128 __vow_shl_i128")) { return 52; }
    if !c.contains(String::from("static inline unsigned __int128 __vow_shr_u128")) { return 53; }
    if !c.contains(String::from("__vow_shl_i128(v0, v1)")) { return 54; }
    if !c.contains(String::from("__vow_shr_u128(v0, v1)")) { return 55; }
    // i64/u64 use the dedicated branch's helper, not the dynamic_shift
    // helper family, but must still get the same bounds assert.
    if !c.contains(String::from(" < 64, \"integer shift count\");")) { return 56; }
    // i128/u128 go through the dynamic_shift helper family, which emits
    // the assert inline with each helper call rather than once per width.
    if !c.contains(String::from(" < 128, \"integer shift count\");")) { return 57; }
    0
}

fn check_arena_parse_i64_option_model() -> i64 {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_arg(0, ITY_I64(), 0));
    insts.push(mk_inst_arg(1, ITY_PTR(), 1));
    let parse_args: Vec<i64> = Vec::new();
    parse_args.push(0);
    parse_args.push(1);
    insts.push(mk_inst_call_extern(
        2,
        ITY_PTR(),
        parse_args,
        String::from("__vow_string_parse_i64_opt_in_arena")
    ));
    let field_args: Vec<i64> = Vec::new();
    field_args.push(2);
    insts.push(ir_inst_new(
        3,
        IOP_FIELD_GET(),
        ITY_I64(),
        field_args,
        IDATA_FIELD(),
        0,
        0,
        String::from("")
    ));
    insts.push(mk_inst_return(4, 3));

    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, insts));
    let params: Vec<i64> = Vec::new();
    params.push(ITY_I64());
    params.push(ITY_PTR());
    let funcs: Vec<IrFunction> = Vec::new();
    funcs.push(mk_function(0, String::from("parse"), params, ITY_I64(), blocks));
    let m: IrModule = mk_module(funcs);
    let const_fn_indices: Vec<i64> = Vec::new();
    if non_modelable_reason(m.functions[0], m, const_fn_indices) != String::from("") {
        return 42;
    }

    let c: String = emit_c_module(m, 16, 16, 16, 16);
    if !c.contains(String::from("__vow_option_t v2;")) {
        return 43;
    }
    if !c.contains(String::from("v2.tag = __VERIFIER_nondet_long();")) {
        return 44;
    }
    if !c.contains(String::from("v3 = v2.tag;")) {
        return 45;
    }
    if c.contains(String::from("/* opcode Call not modelled */")) {
        return 46;
    }
    0
}

