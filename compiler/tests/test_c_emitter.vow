fn check_unsigned_formatter_models() -> i64 {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(ir_inst_new(0, IOP_CONST_U64(), ITY_U64(), Vec::new(), IDATA_CONST_U64(), 42, 0, String::from("")));
    let root_args: Vec<i64> = Vec::new();
    root_args.push(0);
    insts.push(mk_inst_call_extern(1, ITY_PTR(), root_args, String::from("__vow_string_from_u64")));
    insts.push(mk_inst_const_i64(2, 0));
    let arena_args: Vec<i64> = Vec::new();
    arena_args.push(2);
    arena_args.push(0);
    insts.push(mk_inst_call_extern(3, ITY_PTR(), arena_args, String::from("__vow_string_from_u64_in_arena")));
    insts.push(mk_inst_return(4, 1));

    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, insts));
    let f: IrFunction = mk_function(13, String::from("format_unsigned"), Vec::new(), ITY_PTR(), blocks);
    let funcs: Vec<IrFunction> = Vec::new();
    funcs.push(f);
    let m: IrModule = mk_module(funcs);
    if non_modelable_reason(f, m, Vec::new()) != String::from("") {
        return 47;
    }

    let c: String = emit_c_module(m, 16, 16, 16, 16);
    if !c.contains(String::from("__vow_string_t v1;")) { return 48; }
    if !c.contains(String::from("__vow_string_t v3;")) { return 49; }
    if !c.contains(String::from("v1.len = __VERIFIER_nondet_unsigned_long();")) { return 50; }
    if !c.contains(String::from("v3.len = __VERIFIER_nondet_unsigned_long();")) { return 51; }
    if !c.contains(String::from("__ESBMC_assume(v1.len < 16);")) { return 52; }
    if !c.contains(String::from("__ESBMC_assume(v3.len < 16);")) { return 53; }
    0
}

fn check_expanding_string_helper_falls_back(name: String, argc: i64, base_code: i64) -> i64 {
    let args: Vec<i64> = Vec::new();
    let insts: Vec<IrInst> = Vec::new();
    let mut i: i64 = 0;
    while i < argc {
        args.push(i);
        insts.push(mk_inst_const_i64(i, 0));
        i = i + 1;
    }

    let call_id: i64 = 40;
    insts.push(mk_inst_call_extern(call_id, ITY_PTR(), args, name));
    insts.push(mk_inst_return(call_id + 1, call_id));

    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, insts));
    let f: IrFunction = mk_function(
        base_code,
        String::from("expanding_helper"),
        Vec::new(),
        ITY_PTR(),
        blocks
    );
    let funcs: Vec<IrFunction> = Vec::new();
    funcs.push(f);
    let m: IrModule = mk_module(funcs);
    let const_fn_indices: Vec<i64> = Vec::new();

    let reason: String = non_modelable_reason(f, m, const_fn_indices);
    if !reason.contains(name) {
        return base_code;
    }

    let c: String = String::from("");
    let modelable_fi_set: Vec<i64> = Vec::new();
    emit_c_function(
        c,
        f,
        const_fn_indices,
        modelable_fi_set,
        m,
        16,
        16,
        16,
        16,
        false,
        false,
        0
    );
    if !c.contains(String::from("/* opcode Call not modelled */")) {
        return base_code + 1;
    }
    0
}

fn check_wide_constants_are_non_modelable() -> i64 {
    let i128_insts: Vec<IrInst> = Vec::new();
    i128_insts.push(ir_inst_new(
        0, IOP_CONST_I128(), ITY_I128(), Vec::new(),
        IDATA_CONST_I128(), 0, 0, String::from("")
    ));
    i128_insts.push(mk_inst_return(1, 0));
    let i128_blocks: Vec<IrBlock> = Vec::new();
    i128_blocks.push(mk_block(0, i128_insts));
    let i128_fn: IrFunction = mk_function(
        14, String::from("wide_i128"), Vec::new(), ITY_I128(), i128_blocks
    );
    let i128_functions: Vec<IrFunction> = Vec::new();
    i128_functions.push(i128_fn);
    let i128_module: IrModule = mk_module(i128_functions);
    if !non_modelable_reason(i128_fn, i128_module, Vec::new()).contains(
        String::from("ConstI128")
    ) { return 64; }

    let u128_insts: Vec<IrInst> = Vec::new();
    u128_insts.push(ir_inst_new(
        0, IOP_CONST_U128(), ITY_U128(), Vec::new(),
        IDATA_CONST_U128(), 0, 0, String::from("")
    ));
    u128_insts.push(mk_inst_return(1, 0));
    let u128_blocks: Vec<IrBlock> = Vec::new();
    u128_blocks.push(mk_block(0, u128_insts));
    let u128_fn: IrFunction = mk_function(
        15, String::from("wide_u128"), Vec::new(), ITY_U128(), u128_blocks
    );
    let u128_functions: Vec<IrFunction> = Vec::new();
    u128_functions.push(u128_fn);
    let u128_module: IrModule = mk_module(u128_functions);
    if !non_modelable_reason(u128_fn, u128_module, Vec::new()).contains(
        String::from("ConstU128")
    ) { return 65; }
    0
}

// `bits` is the i64 reinterpretation of an f64's IEEE-754 bit pattern (i.e.
// `<value>.to_bits() as i64`). ConstF64 stays opcode-level modelable (unlike
// ConstI128/ConstU128 above), so the guard only shows up in the rendered C,
// not in `non_modelable_reason`.
fn check_nonfinite_f64_const(id: i64, name: String, bits: i64, base_code: i64) -> i64 {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(ir_inst_new(
        0, IOP_CONST_F64(), ITY_F64(), Vec::new(),
        IDATA_CONST_F64(), bits, 0, String::from("")
    ));
    insts.push(mk_inst_return(1, 0));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, insts));
    let f: IrFunction = mk_function(id, name, Vec::new(), ITY_F64(), blocks);
    let functions: Vec<IrFunction> = Vec::new();
    functions.push(f);
    let m: IrModule = mk_module(functions);
    let const_fn_indices: Vec<i64> = Vec::new();

    let c: String = String::from("");
    let modelable_fi_set: Vec<i64> = Vec::new();
    emit_c_function(c, f, const_fn_indices, modelable_fi_set, m, 16, 16, 16, 16, false, false, 0);

    let expected: String = str3(
        String::from("__ESBMC_assert(0, \"vow:"),
        unsupported_op_vow_id_str(),
        String::from("\"")
    );
    if !c.contains(expected) { return base_code; }
    let leaked_literal: bool = c.contains(String::from("= inf;"))
        || c.contains(String::from("= -inf;"))
        || c.contains(String::from("= NaN;"));
    if leaked_literal { return base_code + 1; }
    0
}

fn check_nonfinite_f64_consts_fail_closed() -> i64 {
    let r1: i64 = check_nonfinite_f64_const(20, String::from("f64_pos_inf"), 9218868437227405312, 70);
    if r1 != 0 { return r1; }
    let r2: i64 = check_nonfinite_f64_const(21, String::from("f64_neg_inf"), -4503599627370496, 80);
    if r2 != 0 { return r2; }
    let r3: i64 = check_nonfinite_f64_const(22, String::from("f64_nan"), 9221120237041090560, 90);
    if r3 != 0 { return r3; }
    0
}

// f64::MAX (largest finite value, exponent bits not all-ones) must still
// render as a normal literal, not trip the guard.
fn check_finite_f64_max_const_still_renders() -> i64 {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(ir_inst_new(
        0, IOP_CONST_F64(), ITY_F64(), Vec::new(),
        IDATA_CONST_F64(), 9218868437227405311, 0, String::from("")
    ));
    insts.push(mk_inst_return(1, 0));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, insts));
    let f: IrFunction = mk_function(23, String::from("f64_max"), Vec::new(), ITY_F64(), blocks);
    let functions: Vec<IrFunction> = Vec::new();
    functions.push(f);
    let m: IrModule = mk_module(functions);
    let const_fn_indices: Vec<i64> = Vec::new();

    let c: String = String::from("");
    let modelable_fi_set: Vec<i64> = Vec::new();
    emit_c_function(c, f, const_fn_indices, modelable_fi_set, m, 16, 16, 16, 16, false, false, 0);

    if c.contains(String::from("__ESBMC_assert(0")) { return 100; }
    0
}

// Push the get/set call for an indexed container access (id `base_id`,
// consuming `base_id` itself for the stored value in the set case) followed
// by its return. Shared by the single-block and cross-block indexed-container
// fixtures below.
fn push_index_op_insts(insts: Vec<IrInst>, base_id: i64, index_extern: String) {
    if index_extern == String::from("__vow_vec_set_val") {
        insts.push(mk_inst_const_i64(base_id, 7));
        let set_args: Vec<i64> = Vec::new();
        set_args.push(0);
        set_args.push(2);
        set_args.push(base_id);
        insts.push(mk_inst_call_extern(base_id + 1, ITY_UNIT(), set_args, index_extern));
        insts.push(mk_inst_return(base_id + 2, 1));
    } else {
        let get_args: Vec<i64> = Vec::new();
        get_args.push(0);
        get_args.push(2);
        insts.push(mk_inst_call_extern(base_id, ITY_I64(), get_args, index_extern));
        insts.push(mk_inst_return(base_id + 1, 1));
    }
}

// Build a one-block function that indexes a container parameter, marking the
// container with `len_extern` so the emitter classifies it, and indexing it
// with `idx_ty` via `index_extern`. Mirrors `indexed_container_fn` in
// vow-verify/src/c_emitter.rs's test module (#1113).
fn indexed_container_function(len_extern: String, index_extern: String, idx_ty: i64) -> IrFunction {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_arg(0, ITY_PTR(), 0));

    let len_args: Vec<i64> = Vec::new();
    len_args.push(0);
    insts.push(mk_inst_call_extern(1, ITY_I64(), len_args, len_extern));

    insts.push(mk_inst_arg(2, idx_ty, 1));
    push_index_op_insts(insts, 3, index_extern);

    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, insts));
    let params: Vec<i64> = Vec::new();
    params.push(ITY_PTR());
    params.push(idx_ty);
    mk_function(0, String::from("indexed"), params, ITY_I64(), blocks)
}

fn emit_indexed_container_c(len_extern: String, index_extern: String, idx_ty: i64) -> String {
    let funcs: Vec<IrFunction> = Vec::new();
    funcs.push(indexed_container_function(len_extern, index_extern, idx_ty));
    emit_c_module(mk_module(funcs), 16, 16, 16, 16)
}

fn indexed_container_cross_block_function(len_extern: String, index_extern: String,
                                           idx_ty: i64) -> IrFunction {
    let entry_insts: Vec<IrInst> = Vec::new();
    entry_insts.push(mk_inst_arg(0, ITY_PTR(), 0));

    let len_args: Vec<i64> = Vec::new();
    len_args.push(0);
    entry_insts.push(mk_inst_call_extern(1, ITY_I64(), len_args, len_extern));
    entry_insts.push(mk_inst_arg(2, idx_ty, 1));
    entry_insts.push(ir_inst_new(
        3,
        IOP_JUMP(),
        ITY_UNIT(),
        Vec::new(),
        IDATA_JUMP_TARGET(),
        1,
        0,
        String::from("")
    ));

    let body_insts: Vec<IrInst> = Vec::new();
    push_index_op_insts(body_insts, 4, index_extern);

    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, entry_insts));
    blocks.push(mk_block(1, body_insts));
    let params: Vec<i64> = Vec::new();
    params.push(ITY_PTR());
    params.push(idx_ty);
    mk_function(0, String::from("indexed_cross_block"), params, ITY_I64(), blocks)
}

fn emit_indexed_container_cross_block_c(len_extern: String, index_extern: String,
                                        idx_ty: i64) -> String {
    let funcs: Vec<IrFunction> = Vec::new();
    funcs.push(indexed_container_cross_block_function(len_extern, index_extern, idx_ty));
    emit_c_module(mk_module(funcs), 16, 16, 16, 16)
}

// An unsigned index drops the vacuous `>= 0` conjunct and compares directly
// against the uint64_t `.len` field, so the emitted C carries no
// mixed-signedness comparison (#1113 Half A).
fn check_bounds_assert_unsigned(len_extern: String, index_extern: String, label: String,
                                idx_ty: i64, base_code: i64) -> i64 {
    let c: String = emit_indexed_container_c(len_extern, index_extern, idx_ty);
    let expected: String = str3(String::from("  __ESBMC_assert(v2 < v0.len, \""),
        label, String::from("\");\n"));
    if !c.contains(expected) { return base_code; }
    if c.contains(String::from("v2 >= 0"))
        || c.contains(String::from("(uint64_t)"))
        || c.contains(String::from("(int64_t)v0.len")) {
        return base_code + 1;
    }
    0
}

// A signed index keeps its `>= 0` guard and converts `.len` to int64_t
// explicitly, so a negative index is still caught without a mixed-signedness
// comparison (#1113 Half A).
fn check_bounds_assert_signed(len_extern: String, index_extern: String, label: String,
                              idx_ty: i64, base_code: i64) -> i64 {
    let c: String = emit_indexed_container_c(len_extern, index_extern, idx_ty);
    let expected: String = str3(String::from("  __ESBMC_assert(v2 >= 0 && v2 < (int64_t)v0.len, \""),
        label, String::from("\");\n"));
    if !c.contains(expected) { return base_code; }
    if c.contains(String::from("(uint64_t)")) { return base_code + 1; }
    0
}

fn check_bounds_assert_signedness() -> i64 {
    let vec_len: String = String::from("__vow_vec_len");
    let str_len: String = String::from("__vow_string_len");
    let get: String = String::from("__vow_vec_get_val");
    let set: String = String::from("__vow_vec_set_val");
    let byte_at: String = String::from("__vow_string_byte_at");
    let vec_label: String = String::from("vec bounds");
    let str_label: String = String::from("string bounds");

    let unsigned_tys: Vec<i64> = Vec::new();
    unsigned_tys.push(ITY_U8());
    unsigned_tys.push(ITY_U16());
    unsigned_tys.push(ITY_U32());
    unsigned_tys.push(ITY_U64());

    let signed_tys: Vec<i64> = Vec::new();
    signed_tys.push(ITY_I8());
    signed_tys.push(ITY_I16());
    signed_tys.push(ITY_I32());
    signed_tys.push(ITY_I64());

    let mut i: i64 = 0;
    while i < unsigned_tys.len() as i64 {
        let ty: i64 = unsigned_tys[i as u64];
        let base: i64 = 70 + i * 10;
        let a: i64 = check_bounds_assert_unsigned(vec_len, get, vec_label, ty, base);
        if a != 0 { return a; }
        let b: i64 = check_bounds_assert_unsigned(vec_len, set, vec_label, ty, base + 2);
        if b != 0 { return b; }
        let c: i64 = check_bounds_assert_unsigned(str_len, byte_at, str_label, ty, base + 4);
        if c != 0 { return c; }
        i = i + 1;
    }

    let mut j: i64 = 0;
    while j < signed_tys.len() as i64 {
        let ty: i64 = signed_tys[j as u64];
        let base: i64 = 110 + j * 10;
        let a: i64 = check_bounds_assert_signed(vec_len, get, vec_label, ty, base);
        if a != 0 { return a; }
        let b: i64 = check_bounds_assert_signed(vec_len, set, vec_label, ty, base + 2);
        if b != 0 { return b; }
        let c: i64 = check_bounds_assert_signed(str_len, byte_at, str_label, ty, base + 4);
        if c != 0 { return c; }
        j = j + 1;
    }
    0
}

// from_raw_parts_copy's length assumption follows the argument's signedness: a
// u64 length drops the vacuous `>= 0` conjunct, a signed (literal) one keeps
// it. Mirrors raw_parts_copy_len_assumption_follows_argument_signedness in
// vow-verify/src/c_emitter.rs.
fn emit_raw_parts_copy_c(extern_name: String, len_ty: i64) -> String {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_arg(0, ITY_I64(), 0));
    insts.push(mk_inst_arg(1, len_ty, 1));
    let call_args: Vec<i64> = Vec::new();
    call_args.push(0);
    call_args.push(1);
    insts.push(mk_inst_call_extern(2, ITY_PTR(), call_args, extern_name));
    insts.push(mk_inst_return(3, 2));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, insts));
    let params: Vec<i64> = Vec::new();
    params.push(ITY_I64());
    params.push(len_ty);
    let funcs: Vec<IrFunction> = Vec::new();
    funcs.push(mk_function(0, String::from("raw_parts"), params, ITY_PTR(), blocks));
    emit_c_module(mk_module(funcs), 16, 16, 16, 16)
}

fn check_raw_parts_copy_len_assumption(extern_name: String, base_code: i64) -> i64 {
    let unsigned_c: String = emit_raw_parts_copy_c(extern_name, ITY_U64());
    if !unsigned_c.contains(String::from("  __ESBMC_assume(v1 < 16);\n  v2.len = v1;\n")) { return base_code; }
    if unsigned_c.contains(String::from("v1 >= 0")) { return base_code + 1; }
    let signed_c: String = emit_raw_parts_copy_c(extern_name, ITY_I64());
    if !signed_c.contains(String::from("  __ESBMC_assume(v1 >= 0 && v1 < 16);\n  v2.len = v1;\n")) { return base_code + 2; }
    0
}

// A constant length outside the model capacity fails closed with the capacity
// label instead of an unsatisfiable assumption. Mirrors
// raw_parts_copy_constant_len_beyond_model_fails_closed in
// vow-verify/src/c_emitter.rs.
fn emit_raw_parts_copy_const_len_c(extern_name: String, op: i64, ty: i64, value: i64) -> String {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_arg(0, ITY_I64(), 0));
    insts.push(ir_inst_new(1, op, ty, Vec::new(), IDATA_CONST_U64(), value, 0, String::from("")));
    let call_args: Vec<i64> = Vec::new();
    call_args.push(0);
    call_args.push(1);
    insts.push(mk_inst_call_extern(2, ITY_PTR(), call_args, extern_name));
    insts.push(mk_inst_return(3, 2));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, insts));
    let params: Vec<i64> = Vec::new();
    params.push(ITY_I64());
    let funcs: Vec<IrFunction> = Vec::new();
    funcs.push(mk_function(0, String::from("raw_parts"), params, ITY_PTR(), blocks));
    emit_c_module(mk_module(funcs), 16, 16, 16, 16)
}

fn check_raw_parts_copy_const_len(extern_name: String, label: String, base_code: i64) -> i64 {
    let fail_closed: String = String::from("  __ESBMC_assert(0, \"");
    fail_closed.push_str(label);
    fail_closed.push_str(String::from("\");\n  v2.len = 0;\n"));
    let at_cap: String = emit_raw_parts_copy_const_len_c(extern_name, IOP_CONST_U64(), ITY_U64(), 16);
    if !at_cap.contains(fail_closed) { return base_code; }
    if at_cap.contains(String::from("__ESBMC_assume(v1")) { return base_code + 1; }
    let above_i64_max: String = emit_raw_parts_copy_const_len_c(extern_name, IOP_CONST_U64(), ITY_U64(), 0 - 1);
    if !above_i64_max.contains(fail_closed) { return base_code + 2; }
    let negative: String = emit_raw_parts_copy_const_len_c(extern_name, IOP_CONST_I64(), ITY_I64(), 0 - 1);
    if !negative.contains(fail_closed) { return base_code + 3; }
    let in_range: String = emit_raw_parts_copy_const_len_c(extern_name, IOP_CONST_U64(), ITY_U64(), 15);
    if !in_range.contains(String::from("  __ESBMC_assume(v1 < 16);\n  v2.len = v1;\n")) { return base_code + 4; }
    if in_range.contains(fail_closed) { return base_code + 5; }
    0
}

fn check_const_len_by_id_table() -> i64 {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_arg(0, ITY_I64(), 0));
    insts.push(ir_inst_new(1, IOP_CONST_U64(), ITY_U64(), Vec::new(), IDATA_CONST_U64(), 15, 0, String::from("")));
    insts.push(ir_inst_new(3, IOP_CONST_U64(), ITY_U64(), Vec::new(), IDATA_CONST_U64(), 0 - 1, 0, String::from("")));
    insts.push(ir_inst_new(4, IOP_CONST_I64(), ITY_I64(), Vec::new(), IDATA_CONST_U64(), 0 - 7, 0, String::from("")));
    insts.push(ir_inst_new(5, IOP_CONST_I64(), ITY_I64(), Vec::new(), IDATA_CONST_U64(), 16, 0, String::from("")));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, insts));
    let f: IrFunction = mk_function(30, String::from("const_lens"), Vec::new(), ITY_UNIT(), blocks);

    let table: Vec<i64> = build_const_len_by_id(f);
    if table.len() != 6 { return 260; }
    if raw_parts_const_len_exceeds_model(table, 0, 16) { return 261; }
    if raw_parts_const_len_exceeds_model(table, 1, 16) { return 262; }
    if !raw_parts_const_len_exceeds_model(table, 1, 15) { return 263; }
    if raw_parts_const_len_exceeds_model(table, 2, 16) { return 264; }
    if !raw_parts_const_len_exceeds_model(table, 3, 16) { return 265; }
    if !raw_parts_const_len_exceeds_model(table, 4, 16) { return 266; }
    if !raw_parts_const_len_exceeds_model(table, 5, 16) { return 267; }
    if raw_parts_const_len_exceeds_model(table, 5, 17) { return 268; }
    if raw_parts_const_len_exceeds_model(table, 6, 16) { return 269; }
    if raw_parts_const_len_exceeds_model(table, 0 - 1, 16) { return 270; }

    let empty: IrFunction = mk_function(31, String::from("empty_lens"), Vec::new(), ITY_UNIT(), Vec::new());
    if build_const_len_by_id(empty).len() != 0 { return 271; }
    0
}

fn check_inst_ty_by_id_table() -> i64 {
    let first_insts: Vec<IrInst> = Vec::new();
    first_insts.push(mk_inst_arg(0, ITY_I32(), 0));
    first_insts.push(mk_inst_arg(4, ITY_U64(), 1));

    let second_insts: Vec<IrInst> = Vec::new();
    second_insts.push(mk_inst_arg(-1, ITY_U16(), 2));
    second_insts.push(mk_inst_arg(2, ITY_U8(), 3));

    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, first_insts));
    blocks.push(mk_block(1, second_insts));
    let f: IrFunction = mk_function(
        20,
        String::from("sparse_types"),
        Vec::new(),
        ITY_UNIT(),
        blocks
    );

    let table: Vec<i64> = build_inst_ty_by_id(f);
    if table.len() != 5 { return 200; }
    if table[0] != ITY_I32() { return 201; }
    if table[2] != ITY_U8() { return 202; }
    if table[4] != ITY_U64() { return 203; }
    if table[1] != ITY_I64() { return 204; }
    if inst_ty_of(table, 2) != ITY_U8() { return 205; }
    if inst_ty_of(table, 1) != ITY_I64() { return 206; }
    if inst_ty_of(table, -1) != ITY_I64() { return 207; }
    if inst_ty_of(table, table.len() as i64) != ITY_I64() { return 208; }
    if inst_ty_of(table, table.len() as i64 + 10) != ITY_I64() { return 209; }

    let empty: IrFunction = mk_function(
        21,
        String::from("empty_types"),
        Vec::new(),
        ITY_UNIT(),
        Vec::new()
    );
    if build_inst_ty_by_id(empty).len() != 0 { return 210; }
    0
}

fn check_len_fields_are_unsigned() -> i64 {
    let funcs: Vec<IrFunction> = Vec::new();
    let c: String = emit_c_module(mk_module(funcs), 16, 16, 16, 16);
    if !c.contains(String::from("typedef struct { uint64_t len; int64_t data[16]; } __vow_vec_t;")) { return 230; }
    if !c.contains(String::from("typedef struct { uint64_t len; int8_t data[16]; } __vow_string_t;")) { return 231; }
    if !c.contains(String::from("typedef struct { uint64_t len; int64_t keys[16]; int64_t vals[16]; } __vow_hashmap_t;")) { return 232; }
    if !c.contains(String::from("typedef struct { uint64_t len; int64_t keys[16]; int64_t vals[16]; } __vow_btreemap_t;")) { return 233; }
    0
}

fn check_bounds_assert_cross_block() -> i64 {
    let get_c: String = emit_indexed_container_cross_block_c(
        String::from("__vow_vec_len"),
        String::from("__vow_vec_get_val"),
        ITY_U16()
    );
    if !get_c.contains(String::from(
        "  __ESBMC_assert(v2 < v0.len, \"vec bounds\");\n"
    )) { return 220; }

    let set_c: String = emit_indexed_container_cross_block_c(
        String::from("__vow_vec_len"),
        String::from("__vow_vec_set_val"),
        ITY_I32()
    );
    if !set_c.contains(String::from(
        "  __ESBMC_assert(v2 >= 0 && v2 < (int64_t)v0.len, \"vec bounds\");\n"
    )) { return 221; }

    let byte_at_c: String = emit_indexed_container_cross_block_c(
        String::from("__vow_string_len"),
        String::from("__vow_string_byte_at"),
        ITY_U64()
    );
    if !byte_at_c.contains(String::from(
        "  __ESBMC_assert(v2 < v0.len, \"string bounds\");\n"
    )) { return 222; }
    0
}

// process_* Builtin Operations are all [Effect::IO]-tagged, so
// is_modelable's effect-emptiness gate already excludes them from the C
// model. This pins that invariant with evidence (issue #1273 AC #6).
fn check_process_builtins_are_not_known_to_verifier() -> i64 {
    if is_known_builtin(String::from("__vow_process_exit")) { return 300; }
    if is_known_builtin(String::from("__vow_process_run")) { return 301; }
    if is_known_builtin(String::from("__vow_process_get_stdout")) { return 302; }
    if is_known_builtin(String::from("__vow_process_wait")) { return 303; }
    0
}

fn main() -> i32 {
    let r1: i64 = check_name_modelable_and_mangled(String::from("abs"), 7, 1);
    if r1 != 0 { return i64_to_i32_wrap(r1); }
    let r2: i64 = check_name_modelable_and_mangled(String::from("labs"), 8, 4);
    if r2 != 0 { return i64_to_i32_wrap(r2); }
    let r3: i64 = check_name_modelable_and_mangled(String::from("div"), 9, 7);
    if r3 != 0 { return i64_to_i32_wrap(r3); }
    let r4: i64 = check_name_modelable_and_mangled(String::from("ldiv"), 10, 10);
    if r4 != 0 { return i64_to_i32_wrap(r4); }
    let r5: i64 = check_modelable_call_target_is_mangled();
    if r5 != 0 { return i64_to_i32_wrap(r5); }
    let r6: i64 = check_complexity_descriptor_routing();
    if r6 != 0 { return i64_to_i32_wrap(r6); }
    let r7: i64 = check_narrow_shifts_use_helpers();
    if r7 != 0 { return i64_to_i32_wrap(r7); }
    let r8: i64 = check_expanding_string_helper_falls_back(String::from("__vow_string_replace"), 3, 40);
    if r8 != 0 { return i64_to_i32_wrap(r8); }
    let r9: i64 = check_arena_parse_i64_option_model();
    if r9 != 0 { return i64_to_i32_wrap(r9); }
    let r10: i64 = check_unsigned_formatter_models();
    if r10 != 0 { return i64_to_i32_wrap(r10); }
    let r11: i64 = check_expanding_string_helper_falls_back(String::from("__vow_string_replace_in_arena"), 4, 54);
    if r11 != 0 { return i64_to_i32_wrap(r11); }
    let r12: i64 = check_expanding_string_helper_falls_back(String::from("__vow_string_join"), 2, 56);
    if r12 != 0 { return i64_to_i32_wrap(r12); }
    let r13: i64 = check_expanding_string_helper_falls_back(String::from("__vow_string_join_in_arena"), 3, 58);
    if r13 != 0 { return i64_to_i32_wrap(r13); }
    let r14: i64 = check_expanding_string_helper_falls_back(String::from("__vow_string_split"), 2, 60);
    if r14 != 0 { return i64_to_i32_wrap(r14); }
    let r15: i64 = check_expanding_string_helper_falls_back(String::from("__vow_string_split_in_arena"), 3, 62);
    if r15 != 0 { return i64_to_i32_wrap(r15); }
    let r16: i64 = check_wide_constants_are_non_modelable();
    if r16 != 0 { return i64_to_i32_wrap(r16); }
    let r16a: i64 = check_nonfinite_f64_consts_fail_closed();
    if r16a != 0 { return i64_to_i32_wrap(r16a); }
    let r16b: i64 = check_finite_f64_max_const_still_renders();
    if r16b != 0 { return i64_to_i32_wrap(r16b); }
    let r17: i64 = check_bounds_assert_signedness();
    if r17 != 0 { return i64_to_i32_wrap(r17); }
    let r18: i64 = check_inst_ty_by_id_table();
    if r18 != 0 { return i64_to_i32_wrap(r18); }
    let r19: i64 = check_bounds_assert_cross_block();
    if r19 != 0 { return i64_to_i32_wrap(r19); }
    let r19a: i64 = check_len_fields_are_unsigned();
    if r19a != 0 { return i64_to_i32_wrap(r19a); }
    let r20: i64 = check_parse_u64_option_model();
    if r20 != 0 { return i64_to_i32_wrap(r20); }
    let r21: i64 = check_process_builtins_are_not_known_to_verifier();
    if r21 != 0 { return i64_to_i32_wrap(r21); }
    let r22: i64 = check_wide_shifts_use_helpers();
    if r22 != 0 { return i64_to_i32_wrap(r22); }
    let r23: i64 = check_raw_parts_copy_len_assumption(String::from("__vow_vec_from_raw_parts_copy_val"), 230);
    if r23 != 0 { return i64_to_i32_wrap(r23); }
    let r24: i64 = check_raw_parts_copy_len_assumption(String::from("__vow_string_from_raw_parts_copy"), 235);
    if r24 != 0 { return i64_to_i32_wrap(r24); }
    let r25: i64 = check_raw_parts_copy_const_len(String::from("__vow_vec_from_raw_parts_copy_val"), String::from("vec capacity"), 240);
    if r25 != 0 { return i64_to_i32_wrap(r25); }
    let r26: i64 = check_raw_parts_copy_const_len(String::from("__vow_string_from_raw_parts_copy"), String::from("string capacity"), 250);
