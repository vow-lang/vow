module TestVcHeapList

use ir
use vc_term
use vc_smt
use vc_ops
use vc_heap
use vc_query
use vc_exec
use tests.builders

fn args1(a: i64) -> Vec<i64> {
    let v: Vec<i64> = Vec::new();
    v.push(a);
    v
}

fn args2(a: i64, b: i64) -> Vec<i64> {
    let v: Vec<i64> = Vec::new();
    v.push(a);
    v.push(b);
    v
}

fn ptr_param() -> Vec<i64> {
    let p: Vec<i64> = Vec::new();
    p.push(ITY_PTR());
    p
}

fn one_block(name: String, params: Vec<i64>, ret: i64, insts: Vec<IrInst>) -> IrFunction {
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, insts));
    mk_function(1, name, params, ret, blocks)
}

// `o.0` is the address of a struct whose slot `at` is then read, and whose slot `at + 1` is read at
// another type when `twice`; a read of a read (`deeper`) names no field symbol.
fn read_fn(at: i64, twice: bool, deeper: bool) -> IrFunction {
    let i: Vec<IrInst> = Vec::new();
    i.push(mk_inst_arg(0, ITY_PTR(), 0));
    i.push(mk_inst_field_get(1, ITY_I64(), 0, 0));
    i.push(mk_inst_field_get(2, ITY_I64(), 1, at));
    if twice { i.push(mk_inst_field_get(3, ITY_BOOL(), 1, at + 1)); }
    if deeper { i.push(mk_inst_field_get(4, ITY_I64(), 2, 0)); }
    i.push(mk_inst_const_i64(5, 5));
    i.push(mk_inst(6, IOP_EQ(), ITY_BOOL(), args2(2, 5)));
    i.push(ir_inst_new(7, IOP_VOW_ENS(), ITY_UNIT(), args1(6), IDATA_VOW_ID(), 0, 0, String::from("")));
    i.push(mk_inst_return(8, 2));
    one_block(String::from("t"), ptr_param(), ITY_I64(), i)
}

fn row_of(cs: VcClaims, name: String) -> i64 {
    let mut j: u64 = 0;
    while j < cs.model_names.len() {
        if cs.model_names[j] == name { return j as i64; }
        j = j + 1;
    }
    -1
}

// The slot a function reads through the address `o.0` is a row of the model: `o.0.1`, defined as the
// slot of the array the function was given and typed as it was read.
fn check_field_rows() -> i64 {
    let cs: VcClaims = vc_claims(read_fn(1, false, false));
    if cs.listed.bad || cs.listed.names.len() != 1 { return 1; }
    if cs.listed.path[0] != String::from(".0") || cs.listed.slot[0] != 1 || cs.listed.handle[0] != String::from("p0f0s64") { return 2; }
    let j: i64 = row_of(cs, String::from("hread0"));
    if j < 0 || cs.model_paths[j as u64] != String::from(".0") || cs.model_slots[j as u64] != 1 || cs.model_params[j as u64] != 0 { return 3; }
    if cs.model_tys[j as u64] != ITY_I64() || cs.model_widths[j as u64] != 64 { return 4; }
    let head: String = vc_smt_render(cs.arena, cs.header);
    if !head.contains(String::from("(define-fun hread0 () (_ BitVec 64) (select hf1 p0f0s64))")) { return 5; }
    if cs.model_names.len() != 2 || cs.model_ambig[j as u64] != 0 { return 6; }
    0
}

// A slot read at two sorts is two rows of one name and carries the sort in the counterexample.
fn check_two_sorts() -> i64 {
    let cs: VcClaims = vc_claims(read_fn(1, true, false));
    if cs.listed.names.len() != 2 || cs.listed.slot[1] != 2 { return 11; }
    let same: VcClaims = vc_claims(read_fn(0, false, false));
    if same.listed.names.len() != 1 || same.listed.slot[0] != 0 { return 12; }
    0
}

// A handle that is the value of another read names no row: nothing is listed, and the model is the
// one without a listing.
fn check_unnameable_handle() -> i64 {
    let cs: VcClaims = vc_claims(read_fn(1, false, true));
    if !cs.listed.bad { return 21; }
    if row_of(cs, String::from("hread0")) >= 0 { return 22; }
    0
}

fn main() -> i32 {
    let mut r: i64 = check_field_rows();
    if r == 0 { r = check_two_sorts(); }
    if r == 0 { r = check_unnameable_handle(); }
    i64_to_i32_wrap(r)
}
