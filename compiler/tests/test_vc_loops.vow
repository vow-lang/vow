module TestVcLoops

use ir
use ir_dominance
use ir_printer
use vc_loops
use tests.builders

// while i < 8 { i = i + 1 } as the lowerer shapes it: entry, header (Phi,
// invariant, exit-Phi Upsilon), body, exit (Phi, return).
fn count_up() -> IrFunction {
    let e: Vec<IrInst> = Vec::new();
    e.push(mk_inst_const_i64(0, 0));
    e.push(mk_inst_upsilon(1, 0, 3));
    e.push(mk_inst_jump(2, 1));
    let h: Vec<IrInst> = Vec::new();
    h.push(mk_inst_phi(3, ITY_I64()));
    h.push(mk_inst_const_i64(4, 8));
    h.push(mk_inst(5, IOP_LT(), ITY_BOOL(), pair(3, 4)));
    h.push(mk_inst_upsilon(7, 3, 20));
    h.push(mk_inst_branch(8, 5, 2, 3));
    let b: Vec<IrInst> = Vec::new();
    b.push(mk_inst_const_i64(9, 1));
    b.push(mk_inst_add(10, 3, 9));
    b.push(mk_inst_upsilon(11, 10, 3));
    b.push(mk_inst_jump(12, 1));
    let x: Vec<IrInst> = Vec::new();
    x.push(mk_inst_phi(20, ITY_I64()));
    x.push(mk_inst_return(21, 20));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, e));
    blocks.push(mk_block(1, h));
    blocks.push(mk_block(2, b));
    blocks.push(mk_block(3, x));
    mk_function(1, String::from("count_up"), Vec::new(), ITY_I64(), blocks)
}

fn pair(a: i64, b: i64) -> Vec<i64> {
    let v: Vec<i64> = Vec::new();
    v.push(a);
    v.push(b);
    v
}

// A CFG of branches on one Bool constant: block `k` is `edges[k]`, a pair of
// targets (-1 for a return, a single target when the second is -2).
fn cfg(edges: Vec<i64>) -> IrFunction {
    let blocks: Vec<IrBlock> = Vec::new();
    let n: u64 = edges.len() / 2;
    let mut k: u64 = 0;
    while k < n {
        let insts: Vec<IrInst> = Vec::new();
        let a: i64 = edges[k * 2];
        let b: i64 = edges[k * 2 + 1];
        let base: i64 = (k as i64) * 3;
        if k == 0 {
            insts.push(mk_inst_const_bool(1000, 1));
        }
        if a < 0 {
            insts.push(mk_inst_const_i64(base + 1, 0));
            insts.push(mk_inst_return(base + 2, base + 1));
        } else if b == -2 {
            insts.push(mk_inst_jump(base + 1, a));
        } else {
            insts.push(mk_inst_branch(base + 1, 1000, a, b));
        }
        blocks.push(mk_block(k as i64, insts));
        k = k + 1;
    }
    mk_function(1, String::from("g"), Vec::new(), ITY_I64(), blocks)
}

fn analyse(f: IrFunction) -> VcLoopInfo {
    let nb: u64 = f.blocks.len();
    let succ: Vec<i64> = dom_successors(f, dom_block_id_table(f));
    vc_loop_analysis(nb, succ, dom_rpo_numbers(nb, succ))
}

fn shape(f: IrFunction) -> String {
    let nb: u64 = f.blocks.len();
    let succ: Vec<i64> = dom_successors(f, dom_block_id_table(f));
    vc_loop_shape_detail(f, succ, dom_rpo_numbers(nb, succ))
}

fn check_while() -> i64 {
    let f: IrFunction = count_up();
    let li: VcLoopInfo = analyse(f);
    if li.irreducible { return 1; }
    if li.n_loops != 1 { return 2; }
    if li.headers[0] != 1 { return 3; }
    if vc_chain_len(li, 0) != 0 { return 4; }
    if vc_chain_len(li, 1) != 1 || vc_chain_len(li, 2) != 1 { return 5; }
    if vc_chain_len(li, 3) != 0 { return 6; }
    if vc_chain_at(li, 2, 0) != 0 { return 7; }
    if li.max_depth != 1 { return 8; }
    if shape(f).len() != 0 { return 9; }
    0
}

// outer header 1 { inner header 3 { 4 } 6 }, exit 5.
fn nested() -> IrFunction {
    let e: Vec<i64> = Vec::new();
    e.push(1); e.push(-2);
    e.push(2); e.push(5);
    e.push(3); e.push(-2);
    e.push(4); e.push(6);
    e.push(3); e.push(-2);
    e.push(-1); e.push(-1);
    e.push(1); e.push(-2);
    cfg(e)
}

fn check_nested() -> i64 {
    let li: VcLoopInfo = analyse(nested());
    if li.irreducible { return 10; }
    if li.n_loops != 2 { return 11; }
    if li.max_depth != 2 { return 12; }
    if vc_chain_len(li, 3) != 2 || vc_chain_len(li, 4) != 2 { return 13; }
    if vc_chain_len(li, 1) != 1 || vc_chain_len(li, 2) != 1 || vc_chain_len(li, 6) != 1 { return 14; }
    if vc_chain_len(li, 5) != 0 || vc_chain_len(li, 0) != 0 { return 15; }
    let outer: i64 = li.loop_of_header[1];
    let inner: i64 = li.loop_of_header[3];
    if outer < 0 || inner < 0 || outer == inner { return 16; }
    if vc_chain_at(li, 3, 0) != outer || vc_chain_at(li, 3, 1) != inner { return 17; }
    if vc_chain_common(li, 4, 6) != 1 || vc_chain_common(li, 4, 5) != 0 { return 18; }
    if shape(nested()).len() != 0 { return 19; }
    0
}

// Two back edges (a `continue`) share header 1.
fn check_shared_header() -> i64 {
    let e: Vec<i64> = Vec::new();
    e.push(1); e.push(-2);
    e.push(2); e.push(4);
    e.push(1); e.push(3);
    e.push(1); e.push(-2);
    e.push(-1); e.push(-1);
    let li: VcLoopInfo = analyse(cfg(e));
    if li.n_loops != 1 { return 20; }
    if vc_chain_len(li, 1) != 1 || vc_chain_len(li, 2) != 1 || vc_chain_len(li, 3) != 1 { return 21; }
    if vc_chain_len(li, 4) != 0 { return 22; }
    0
}

fn check_irreducible() -> i64 {
    let e: Vec<i64> = Vec::new();
    e.push(1); e.push(2);
    e.push(2); e.push(3);
    e.push(1); e.push(3);
    e.push(-1); e.push(-1);
    let f: IrFunction = cfg(e);
    if !analyse(f).irreducible { return 30; }
    let d: String = shape(f);
    if !d.contains(String::from("irreducible loop")) { return 31; }
    0
}

fn check_entry_header() -> i64 {
    let e: Vec<i64> = Vec::new();
    e.push(0); e.push(1);
    e.push(-1); e.push(-1);
    let d: String = shape(cfg(e));
    if d != String::from("entry block is a loop header") { return 40; }
    0
}

// The header value %5 read in the exit block without an exit Phi.
fn check_escaping_read() -> i64 {
    let f: IrFunction = count_up();
    let x: IrBlock = f.blocks[3];
    let ret: IrInst = x.insts[1];
    ret.args[0] = 5;
    if shape(f) != String::from("loop value used outside its loop") { return 50; }
    let ok: IrFunction = count_up();
    if shape(ok).len() != 0 { return 51; }
    0
}

fn check_acyclic_has_no_loops() -> i64 {
    let e: Vec<i64> = Vec::new();
    e.push(1); e.push(2);
    e.push(3); e.push(-2);
    e.push(3); e.push(-2);
    e.push(-1); e.push(-1);
    let li: VcLoopInfo = analyse(cfg(e));
    if li.irreducible || li.n_loops != 0 || li.max_depth != 0 { return 60; }
    0
}

// The exit block reads the header's value directly (a `break` arm does).
fn escaping_exit() -> IrFunction {
    let f: IrFunction = count_up();
    let x: IrBlock = f.blocks[3];
    let ret: IrInst = x.insts[1];
    ret.args[0] = 5;
    f
}

fn check_closing() -> i64 {
    let f: IrFunction = escaping_exit();
    let closed: IrFunction = vc_close_loops(f);
    if shape(closed).len() != 0 { return 70; }
    // one new Phi in the exit block, one new Upsilon in the header
    let x: IrBlock = closed.blocks[3];
    let h: IrBlock = closed.blocks[1];
    let old_x: IrBlock = f.blocks[3];
    let old_h: IrBlock = f.blocks[1];
    if x.insts.len() != old_x.insts.len() + 1 { return 71; }
    if h.insts.len() != old_h.insts.len() + 1 { return 72; }
    let first: IrInst = x.insts[0];
    if first.op != IOP_PHI() || first.ty != ITY_BOOL() { return 73; }
    // the return now reads the new Phi
    let ret: IrInst = x.insts[x.insts.len() - 1];
    if ret.args[0] != first.id { return 74; }
    // a loop-closed function is returned as it is
    let ok: IrFunction = count_up();
    if print_function(vc_close_loops(ok)) != print_function(count_up()) { return 75; }
    // and closing is idempotent
    if print_function(vc_close_loops(closed)) != print_function(closed) { return 76; }
    0
}

// The exit block is also entered from outside the loop: it cannot be closed.
fn check_unclosable() -> i64 {
    let f: IrFunction = escaping_exit();
    let e: IrBlock = f.blocks[0];
    let term: IrInst = e.insts[2];
    e.insts[2] = mk_inst_branch(2, 0, 1, 3);
    if shape(vc_close_loops(f)) != String::from("loop value used outside its loop") { return 80; }
    0
}

fn main() -> i32 {
    let mut r: i64 = check_while();
    if r == 0 { r = check_nested(); }
    if r == 0 { r = check_shared_header(); }
    if r == 0 { r = check_irreducible(); }
    if r == 0 { r = check_entry_header(); }
    if r == 0 { r = check_escaping_read(); }
    if r == 0 { r = check_acyclic_has_no_loops(); }
    if r == 0 { r = check_closing(); }
    if r == 0 { r = check_unclosable(); }
    i64_to_i32_wrap(r)
}
