module TestVcMemory

use ir
use vc_inline
use vc_summary
use vc_waves
use tests.builders

// The native driver decides every target of a module in one process. What a decision builds
// (the flattened body, the summarised module) is scratch and has to be freed when the decision
// returns: kept in the arena of the caller's result it grows with the number of targets, and
// pinned in the root region it is never freed. These tests run a decision many times with the
// answers kept in one container, as the planner does, and check the arenas did not grow.

// name(x) = callee(x) after `pad` unused constants; a leaf (callee -1) returns x.
fn padded(id: i64, name: String, pad: i64, callee: i64) -> IrFunction {
    let i: Vec<IrInst> = Vec::new();
    i.push(mk_inst_arg(0, ITY_I64(), 0));
    let mut n: i64 = 1;
    while n <= pad {
        i.push(mk_inst_const_i64(n, 1));
        n = n + 1;
    }
    let mut result: i64 = 0;
    if callee >= 0 {
        let call_args: Vec<i64> = Vec::new();
        call_args.push(0);
        i.push(mk_inst_call_target(n, ITY_I64(), call_args, callee));
        result = n;
        n = n + 1;
    }
    i.push(mk_inst_return(n, result));
    let b: Vec<IrBlock> = Vec::new();
    b.push(mk_block(0, i));
    mk_function(id, name, mk_params1(), ITY_I64(), b)
}

// leaf <- mid <- top, `pad` constants each, so top flattens to 3 * pad instructions.
fn chain(pad: i64) -> IrModule {
    let fs: Vec<IrFunction> = Vec::new();
    fs.push(padded(1, String::from("leaf"), pad, -1));
    fs.push(padded(2, String::from("mid"), pad, 1));
    fs.push(padded(3, String::from("top"), pad, 2));
    mk_module(fs)
}

fn RUNS() -> i64 { 20 }

// Slack for the answers themselves and for the allocator's rounding. The flattened `top` below
// has over 4000 instructions, far above it, so a decision that kept its scratch exceeds it after
// one run.
fn SLACK_BYTES() -> u64 { 262144 }

fn check_decision_is_scratch() -> i64 [io, read] {
    let m: IrModule = chain(1500);
    let top: IrFunction = m.functions[2];
    if vc_inst_count(vc_inline(top, m, VC_INLINE_INST_CAP()).f) < 4000 { return 4; }
    let kept: Vec<String> = Vec::new();
    kept.push(vc_module_skip_reason(top, m));
    let root0: u64 = memory_root_arena_bytes();
    let peak0: u64 = memory_peak_bytes();
    let mut r: i64 = 0;
    while r < RUNS() {
        kept.push(vc_module_skip_reason(top, m));
        r = r + 1;
    }
    if memory_root_arena_bytes() > root0 + SLACK_BYTES() { return 1; }
    if memory_peak_bytes() > peak0 + SLACK_BYTES() { return 2; }
    if kept[0].len() != 0 || kept[RUNS() as u64].len() != 0 { return 3; }
    0
}

fn check_trusted_decision_is_scratch() -> i64 [io, read] {
    let m: IrModule = chain(1500);
    let top: IrFunction = m.functions[2];
    if !vc_summary_module(top, m, vc_trust_all(), 1000).used { return 3; }
    let kept: Vec<String> = Vec::new();
    kept.push(vc_module_skip_reason_trusted(top, m, vc_trust_all(), 1000));
    let root0: u64 = memory_root_arena_bytes();
    let peak0: u64 = memory_peak_bytes();
    let mut r: i64 = 0;
    while r < RUNS() {
        kept.push(vc_module_skip_reason_trusted(top, m, vc_trust_all(), 1000));
        r = r + 1;
    }
    if memory_root_arena_bytes() > root0 + SLACK_BYTES() { return 1; }
    if memory_peak_bytes() > peak0 + SLACK_BYTES() { return 2; }
    0
}

fn check_wave_needs_is_scratch() -> i64 [io, read] {
    let m: IrModule = chain(1500);
    let warm: VcWaveCtx = vc_wave_ctx(m, 1000);
    if vc_waves_needs(warm, 2).len() == 0 { return 1; }
    let root0: u64 = memory_root_arena_bytes();
    let peak0: u64 = memory_peak_bytes();
    let kept: Vec<VcWaveCtx> = Vec::new();
    let mut r: i64 = 0;
    while r < 5 {
        let c: VcWaveCtx = vc_wave_ctx(m, 1000);
        vc_waves_needs(c, 2);
        kept.push(c);
        r = r + 1;
    }
    if memory_root_arena_bytes() > root0 + SLACK_BYTES() { return 2; }
    if memory_peak_bytes() > peak0 + SLACK_BYTES() { return 3; }
    0
}

fn main() -> i32 [io, read] {
    let mut r: i64 = check_decision_is_scratch();
    if r == 0 { let d: i64 = check_trusted_decision_is_scratch(); if d != 0 { r = 100 + d; } }
    if r == 0 { let w: i64 = check_wave_needs_is_scratch(); if w != 0 { r = 200 + w; } }
    i64_to_i32_wrap(r)
}
