module CatalogueFacts

use tests.catalogue_facts_gen

// Test-only view of the Operation Catalogue (docs/spec/operations.json): each
// op's name, effects and ABI tokens, plus the `excluded` entries naming the
// builtins the catalogue deliberately does not list. The fact functions live in
// catalogue_facts_gen.vow, generated by scripts/generate_operations.py; everything
// here is hand-written. Lives in compiler/tests/ so it is not pulled into the
// main self-hosted compiler build.

// `params` is the comma-joined parameter tokens ("" for none); `ret` the return
// token; `doc_params` the `|`-joined parameter types and `doc_ret` the return
// type, both as the docs spell them. `symbol` is the runtime symbol and
// `result_tag` is `none`, `string`, `vec` or `option:<elem>`.
struct OpFact {
    name: String,
    effects: String,
    params: String,
    ret: String,
    doc_params: String,
    doc_ret: String,
    symbol: String,
    result_tag: String,
}

// `value` is the comma-joined names (OPX_NAMES), the prefix (OPX_PREFIX) or the
// needle (OPX_CONTAINS); `suffixes` is the comma-joined suffix set of OPX_CONTAINS.
struct OpExcluded {
    kind: i64,
    value: String,
    suffixes: String,
}

fn OPX_NAMES() -> i64 { 0 }
fn OPX_PREFIX() -> i64 { 1 }
fn OPX_CONTAINS() -> i64 { 2 }

fn op_fact(name: String, effects: String, params: String, ret: String, doc_params: String, doc_ret: String, symbol: String, result_tag: String) -> OpFact {
    OpFact { name: name, effects: effects, params: params, ret: ret, doc_params: doc_params, doc_ret: doc_ret, symbol: symbol, result_tag: result_tag }
}

fn op_excluded(kind: i64, value: String, suffixes: String) -> OpExcluded {
    OpExcluded { kind: kind, value: value, suffixes: suffixes }
}

fn facts_str_contains(s: String, needle: String) -> bool {
    let n: u64 = needle.len();
    if n > s.len() { return false; }
    let last: u64 = s.len() - n;
    let mut i: u64 = 0u64;
    while i <= last {
        if string_substr(s, i, n) == needle { return true; }
        i = i + 1u64;
    }
    false
}

fn facts_has_prefix(s: String, prefix: String) -> bool {
    string_starts_with(s, prefix) == 1
}

fn facts_has_any_suffix(s: String, suffixes: String) -> bool {
    let parts: Vec<String> = string_split(suffixes, String::from(","));
    let mut i: u64 = 0u64;
    while i < parts.len() {
        if string_ends_with(s, parts[i]) == 1 { return true; }
        i = i + 1u64;
    }
    false
}

fn facts_list_has(list: String, name: String) -> bool {
    let parts: Vec<String> = string_split(list, String::from(","));
    let mut i: u64 = 0u64;
    while i < parts.len() {
        if parts[i] == name { return true; }
        i = i + 1u64;
    }
    false
}

// Mirrors `excluded_matches` in scripts/generate_operations.py: explicit names,
// a prefix, or a substring plus a suffix set.
fn op_excluded_matches(x: OpExcluded, name: String) -> bool {
    if x.kind == OPX_NAMES() { return facts_list_has(x.value, name); }
    if x.kind == OPX_PREFIX() { return facts_has_prefix(name, x.value); }
    facts_str_contains(name, x.value) && facts_has_any_suffix(name, x.suffixes)
}

fn op_excluded_describe(x: OpExcluded) -> String {
    let out: String = String::from("excluded entry ");
    if x.kind == OPX_NAMES() { out.push_str(String::from("names [")); }
    if x.kind == OPX_PREFIX() { out.push_str(String::from("prefix [")); }
    if x.kind == OPX_CONTAINS() { out.push_str(String::from("contains [")); }
    out.push_str(x.value);
    out.push_str(String::from("]"));
    out
}

fn any_fact_named(facts: Vec<OpFact>, name: String) -> bool {
    let mut i: u64 = 0u64;
    while i < facts.len() {
        let f: OpFact = facts[i];
        let fname: String = f.name;
        if fname == name { return true; }
        i = i + 1u64;
    }
    false
}

fn fact_problem(out: Vec<String>, name: String, what: String) {
    let line: String = String::from("'");
    line.push_str(name);
    line.push_str(String::from("': "));
    line.push_str(what);
    out.push(line);
}

fn problems_mention(problems: Vec<String>, needle: String) -> bool {
    let mut i: u64 = 0u64;
    while i < problems.len() {
        if facts_str_contains(problems[i], needle) { return true; }
        i = i + 1u64;
    }
    false
}

fn problems_all_mention(problems: Vec<String>, needle: String) -> bool {
    let mut i: u64 = 0u64;
    while i < problems.len() {
        if !facts_str_contains(problems[i], needle) { return false; }
        i = i + 1u64;
    }
    true
}

fn report_problems(problems: Vec<String>) -> u64 [io] {
    let mut i: u64 = 0u64;
    while i < problems.len() {
        eprintln_str(problems[i]);
        i = i + 1u64;
    }
    problems.len()
}

fn fact_named(facts: Vec<OpFact>, name: String) -> OpFact {
    let mut i: u64 = 0u64;
    while i < facts.len() {
        let f: OpFact = facts[i];
        let fname: String = f.name;
        if fname == name { return f; }
        i = i + 1u64;
    }
    facts[0u64]
}

// The same facts with `name`'s symbol, return token and result tag replaced.
fn facts_with(facts: Vec<OpFact>, name: String, symbol: String, ret: String, tag: String) -> Vec<OpFact> {
    let out: Vec<OpFact> = Vec::new();
    let mut i: u64 = 0u64;
    while i < facts.len() {
        let f: OpFact = facts[i];
        let fname: String = f.name;
        if fname == name {
            out.push(op_fact(fname, f.effects, f.params, ret, f.doc_params, f.doc_ret, symbol, tag));
        } else {
            out.push(f);
        }
        i = i + 1u64;
    }
    out
}
