fn op_facts_excluded() -> Vec<OpExcluded> {
    let v: Vec<OpExcluded> = Vec::new();
    v.push(op_excluded(OPX_PREFIX(), String::from("__vow_clif_"), String::from("")));
    v.push(op_excluded(OPX_NAMES(), String::from("debug_str,debug_i64,debug_u64"), String::from("")));
    v.push(op_excluded(OPX_NAMES(), String::from("string_matches_literal_at"), String::from("")));
    v.push(op_excluded(OPX_NAMES(), String::from("i64_to_string"), String::from("")));
    v.push(op_excluded(OPX_CONTAINS(), String::from("_to_"), String::from("_try,_wrap,_sat")));
    v.push(op_excluded(OPX_NAMES(), String::from("add_sat_u8,sub_sat_u8,mul_sat_u8"), String::from("")));
    v
}
// GENERATE:OPERATION_FACTS:END

fn facts_str_contains(s: String, needle: String) -> bool {
    let n: u64 = needle.len();
    if n > s.len() { return false; }
    let last: u64 = s.len() - n;
    let mut i: u64 = 0u64;
    while i <= last {
        if string_substr(s, i, n) == needle { return true; }
        i = i + 1u64;
    }
    false
}

fn facts_has_prefix(s: String, prefix: String) -> bool {
    string_starts_with(s, prefix) == 1
}

fn facts_has_any_suffix(s: String, suffixes: String) -> bool {
    let parts: Vec<String> = string_split(suffixes, String::from(","));
    let mut i: u64 = 0u64;
    while i < parts.len() {
        if string_ends_with(s, parts[i]) == 1 { return true; }
        i = i + 1u64;
    }
    false
}

fn facts_list_has(list: String, name: String) -> bool {
    let parts: Vec<String> = string_split(list, String::from(","));
    let mut i: u64 = 0u64;
    while i < parts.len() {
        if parts[i] == name { return true; }
        i = i + 1u64;
    }
    false
}

// Mirrors `excluded_matches` in scripts/generate_operations.py: explicit names,
// a prefix, or a substring plus a suffix set.
fn op_excluded_matches(x: OpExcluded, name: String) -> bool {
    if x.kind == OPX_NAMES() { return facts_list_has(x.value, name); }
    if x.kind == OPX_PREFIX() { return facts_has_prefix(name, x.value); }
    facts_str_contains(name, x.value) && facts_has_any_suffix(name, x.suffixes)
}

fn op_excluded_describe(x: OpExcluded) -> String {
    let out: String = String::from("excluded entry ");
    if x.kind == OPX_NAMES() { out.push_str(String::from("names [")); }
    if x.kind == OPX_PREFIX() { out.push_str(String::from("prefix [")); }
    if x.kind == OPX_CONTAINS() { out.push_str(String::from("contains [")); }
    out.push_str(x.value);
    out.push_str(String::from("]"));
    out
}
