module TestParserExprForms

use lexer
use ast
use diag
use parser
use ir
use lower

// Parse -> print parity for parenthesised block-like operands, cast chains and
// scalar cast targets, plus the clean rejections the grammar promises. The
// cross-compiler table lives in tests/fixtures/contracts/contract_text_postfix.vow
// and the Rust parser's twin of this table is in vow-syntax/src/parser/expr.rs.
// Failures return a distinct exit code: 1xx accepted forms, 2xx idempotence,
// 3xx borrow rejection, 4xx unparenthesised block-like rejection, 5xx
// error-recovery termination, 6xx statement terminators.

fn lower_source(source: String) -> IrModule {
    let arena: AstArena = arena_new();
    let parsed: Module = parse_module_into(
        lex(source), arena, diag_ctx_new(), String::from("forms.vow")
    );
    let item_files: Vec<String> = Vec::new();
    let mut item_i: u64 = 0;
    while item_i < parsed.items.len() {
        item_files.push(String::from("forms.vow"));
        item_i = item_i + 1;
    }
    lower_module_vow(
        parsed, Vec::new(), Vec::new(), Vec::new(), Vec::new(), Vec::new(),
        Vec::new(), Vec::new(), Vec::new(), Vec::new(), Vec::new(), Vec::new(),
        Vec::new(), Vec::new(), Vec::new(), Vec::new(), item_files
    )
}

fn description_of(clause: String) -> String {
    let source: String = String::from("module T\nfn f(x: i64, c: bool) -> i64 vow {\n  requires: ");
    source.push_str(clause);
    source.push_str(String::from("\n} { x }\n"));
    let m: IrModule = lower_source(source);
    let f: IrFunction = m.functions[0];
    let v: IrVowEntry = f.vows[0];
    v.description
}

fn expected_text(canonical: String) -> String {
    let t: String = String::from("requires ");
    t.push_str(canonical);
    t
}

fn check_pair(src: String, canonical: String, code: i64) -> i64 {
    if description_of(src) != expected_text(canonical) { return code; }
    if description_of(canonical) != expected_text(canonical) { return code + 100; }
    0
}

fn check_accepted() -> i64 {
    let r: i64 = check_pair(
        String::from("(if c { 1 } else { 2 }) as u64 == 1"),
        String::from("(if c {\n    1\n} else {\n    2\n}) as u64 == 1"), 101);
    if r != 0 { return r; }
    let r2: i64 = check_pair(
        String::from("((if c { 1 } else { 2 }) as u64) as i64 == 1"),
        String::from("(if c {\n    1\n} else {\n    2\n}) as u64 as i64 == 1"), 102);
    if r2 != 0 { return r2; }
    let r3: i64 = check_pair(
        String::from("({ x }) as u64 == 1"),
        String::from("({\n    x\n}) as u64 == 1"), 103);
    if r3 != 0 { return r3; }
    let r4: i64 = check_pair(
        String::from("(if c { 1 } else { 2 }) + 1 == 2"),
        String::from("(if c {\n    1\n} else {\n    2\n}) + 1 == 2"), 104);
    if r4 != 0 { return r4; }
    let r5: i64 = check_pair(
        String::from("3 * (if c { 1 } else { 2 }) == 3"),
        String::from("3 * if c {\n    1\n} else {\n    2\n} == 3"), 105);
    if r5 != 0 { return r5; }
    let r6: i64 = check_pair(
        String::from("-(if c { 1 } else { 2 }) == 1"),
        String::from("-if c {\n    1\n} else {\n    2\n} == 1"), 106);
    if r6 != 0 { return r6; }
    let r7: i64 = check_pair(
        String::from("(x as u64) < 5"), String::from("x as u64 < 5"), 107);
    if r7 != 0 { return r7; }
    let r8: i64 = check_pair(
        String::from("x as u64 < 5"), String::from("x as u64 < 5"), 108);
    if r8 != 0 { return r8; }
    let r9: i64 = check_pair(
        String::from("x as u64 << 1 == 2"), String::from("x as u64 << 1 == 2"), 109);
    if r9 != 0 { return r9; }
    let r10: i64 = check_pair(
        String::from("(((x))) as u64 == 1"), String::from("x as u64 == 1"), 110);
    if r10 != 0 { return r10; }
    let r11: i64 = check_pair(
        String::from("(-x) as u64 == 1"), String::from("(-x) as u64 == 1"), 111);
    if r11 != 0 { return r11; }
    let r12: i64 = check_pair(
        String::from("(if c { true } else { false }) && c"),
        String::from("(if c {\n    true\n} else {\n    false\n}) && c"), 112);
    if r12 != 0 { return r12; }
    0
}

fn parse_errors(src: String) -> DiagCtx {
    let arena: AstArena = arena_new();
    let dctx: DiagCtx = diag_ctx_new();
    let _parsed: Module = parse_module_into(lex(src), arena, dctx, String::from("bad.vow"));
    dctx
}

fn check_borrow_rejected(src: String, offset: i64, len: i64, code: i64) -> i64 {
    let arena: AstArena = arena_new();
    let dctx: DiagCtx = diag_ctx_new();
    let _parsed: Module = parse_module_into(lex(src), arena, dctx, String::from("bad.vow"));
    if dctx.error_count != 1 { return code; }
    let ds: Vec<Diagnostic> = dctx.diags;
    let d: Diagnostic = ds[0];
    if d.code != EC_UNSUPPORTED_FEATURE() { return code + 1; }
    if d.span_start != offset { return code + 2; }
    if d.span_len != len { return code + 3; }
    let hints: Vec<String> = d.hints;
    if hints.len() != 1 { return code + 4; }
    let want: String = String::from("Vow has no borrow expressions: pass the value itself; `&` is only the binary bitwise AND operator");
    if hints[0] != want { return code + 5; }
    0
}

fn check_borrow() -> i64 {
    let r: i64 = check_borrow_rejected(
        String::from("module T\nfn f(x: i64) -> i64 { let r: i64 = &x; r }\n"), 44, 1, 300);
    if r != 0 { return r; }
    let r2: i64 = check_borrow_rejected(
        String::from("module T\nfn f(x: i64, y: i64) -> i64 { x & &y }\n"), 43, 1, 310);
    if r2 != 0 { return r2; }
    let r3: i64 = check_borrow_rejected(
        String::from("module T\nfn f(x: i64) -> i64 { g(-&x) }\n"), 34, 1, 320);
    if r3 != 0 { return r3; }
    let r4: i64 = check_borrow_rejected(
        String::from("module T\nfn f(x: i64) -> i64 { let r: i64 = &mut x; r }\n"), 44, 1, 330);
    if r4 != 0 { return r4; }
    let r5: i64 = check_borrow_rejected(
        String::from("module T\nfn f(x: i64) -> i64 { let r: i64 = &&x; r }\n"), 44, 2, 340);
    if r5 != 0 { return r5; }
    0
}

fn check_unparenthesised_block() -> i64 {
    let a: DiagCtx = parse_errors(String::from("module T\nfn f(c: bool) -> u64 { let y: u64 = if c { 1 } else { 2 } as u64; y }\n"));
    if a.error_count == 0 { return 400; }
    let b: DiagCtx = parse_errors(String::from("module T\nfn f(v: Vec<i64>, c: bool) -> u64 { { v }.len() }\n"));
    if b.error_count == 0 { return 410; }
    let c: DiagCtx = parse_errors(String::from("module T\nfn f(c: bool) -> u64 { let y: u64 = 3 * if c { 1 } else { 2 } as u64; y }\n"));
    if c.error_count == 0 { return 420; }
    let d: DiagCtx = parse_errors(String::from("module T\nfn f(c: bool) -> u64 { let y: u64 = -if c { 1 } else { 2 } as u64; y }\n"));
    if d.error_count == 0 { return 430; }
    0
}

fn check_statement_terminators() -> i64 {
    let a: DiagCtx = parse_errors(String::from("module T\nfn f(x: i64) -> i64 {\n    x\n    x\n}\n"));
    if a.error_count != 1 { return 600; }
    let b: DiagCtx = parse_errors(String::from("module T\nfn f(c: bool, x: i64) -> i64 {\n    (if c { 1 } else { 2 })\n    x\n}\n"));
    if b.error_count != 1 { return 610; }
    let c: DiagCtx = parse_errors(String::from("module T\nfn f(c: bool, x: i64) -> i64 {\n    if c { 1 } else { 2 }\n    x\n}\n"));
    if c.error_count != 0 { return 620; }
    let d: DiagCtx = parse_errors(String::from("module T\nfn f(c: bool) -> i64 {\n    while c { }\n    if c { }\n    0\n}\n"));
    if d.error_count != 0 { return 630; }
    0
}

fn check_recovery_terminates() -> i64 {
    let a: DiagCtx = parse_errors(String::from("module T\nfn f(v: Vec<5>) -> i64 { 0 }\n"));
    if a.error_count != 3 { return 500; }
    let c: DiagCtx = parse_errors(String::from("module T\nfn f(a: i64 b: i64) -> i64 { a }\n"));
    if c.error_count != 1 { return 520; }
    let b: DiagCtx = parse_errors(String::from("module T\nfn f(x: i64) -> i64 { let y: Vec<i64 = x; y }\n"));
    if b.error_count == 0 { return 510; }
    0
}

fn main() -> i32 {
    let r1: i64 = check_accepted();
    if r1 != 0 { return i64_to_i32_wrap(r1); }
    let r2: i64 = check_borrow();
    if r2 != 0 { return i64_to_i32_wrap(r2); }
    let r3: i64 = check_unparenthesised_block();
    if r3 != 0 { return i64_to_i32_wrap(r3); }
    let r4: i64 = check_recovery_terminates();
    if r4 != 0 { return i64_to_i32_wrap(r4); }
    let r5: i64 = check_statement_terminators();
    if r5 != 0 { return i64_to_i32_wrap(r5); }
    0
}
