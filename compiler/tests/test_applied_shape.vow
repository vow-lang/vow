module TestAppliedShape

use types

fn test_shape() -> i64 {
    let ts: TyStore = ty_store_new();
    let args: Vec<i64> = Vec::new();
    args.push(CTY_I64());
    let s: i64 = ts_make_applied(ts, ts_make_struct(ts, String::from("Vec")), args);
    let e: i64 = ts_make_applied(ts, ts_make_enum(ts, String::from("Vec")), args);
    let empty: Vec<i64> = Vec::new();
    let o: i64 = ts_make_applied(ts, ts_make_enum(ts, String::from("Option")), empty);
    let sl: i64 = ty_applied_args(ts, s, CTY_STRUCT(), String::from("Vec"));
    if sl < 0 || ts_arg_len(ts, sl) != 1 || ts_arg_get(ts, sl, 0) != CTY_I64() { return 1; }
    let el: i64 = ty_applied_args(ts, e, CTY_ENUM(), String::from("Vec"));
    if el < 0 || ts_arg_len(ts, el) != 1 || ts_arg_get(ts, el, 0) != CTY_I64() { return 2; }
    if ty_applied_args(ts, s, -1, String::from("Vec")) != sl { return 3; }
    if ty_applied_args(ts, e, -1, String::from("Vec")) != el { return 4; }
    if ty_applied_args(ts, s, CTY_ENUM(), String::from("Vec")) != -1 { return 5; }
    if ty_applied_args(ts, e, CTY_STRUCT(), String::from("Vec")) != -1 { return 6; }
    if ty_applied_args(ts, s, -1, String::from("Option")) != -1 { return 7; }
    let ol: i64 = ty_applied_args(ts, o, CTY_ENUM(), String::from("Option"));
    if ol < 0 || ts_arg_len(ts, ol) != 0 { return 8; }
    if ty_applied_args(ts, CTY_I64(), -1, String::from("Vec")) != -1 { return 9; }
    let reference: i64 = ty_add(ts, CTY_REF(), s, 0);
    if ty_applied_args(ts, reference, -1, String::from("Vec")) != -1 { return 10; }
    let nested: i64 = ts_make_applied(ts, s, args);
    if ty_applied_args(ts, nested, -1, String::from("Vec")) != -1 { return 11; }
    0
}

fn main() -> i32 {
    i64_to_i32_wrap(test_shape())
}
