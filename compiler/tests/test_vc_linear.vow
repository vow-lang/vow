module TestVcLinear

use ir
use vc_gate
use vc_linear
use tests.builders

fn args1(a: i64) -> Vec<i64> {
    let v: Vec<i64> = Vec::new();
    v.push(a);
    v
}

fn args2(a: i64, b: i64) -> Vec<i64> {
    let v: Vec<i64> = Vec::new();
    v.push(a);
    v.push(b);
    v
}

fn lptr_params() -> Vec<i64> {
    let p: Vec<i64> = Vec::new();
    p.push(ITY_LPTR());
    p
}

// fn take(h: Handle) -> i64 vow { ensures: result >= 0 } { let fd = h.fd; drop(h); fd }
fn take_fn() -> IrFunction {
    let i: Vec<IrInst> = Vec::new();
    i.push(mk_inst_arg(0, ITY_LPTR(), 0));
    i.push(mk_inst_field_get(1, ITY_I64(), 0, 0));
    i.push(mk_inst(2, IOP_LINEAR_CONSUME(), ITY_UNIT(), args1(0)));
    i.push(mk_inst_const_i64(3, 0));
    i.push(mk_inst(4, IOP_GE(), ITY_BOOL(), args2(1, 3)));
    i.push(ir_inst_new(5, IOP_VOW_ENS(), ITY_UNIT(), args1(4), IDATA_VOW_ID(), 0, 0, String::from("")));
    i.push(mk_inst_return(6, 1));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, i));
    mk_function(1, String::from("take"), lptr_params(), ITY_I64(), blocks)
}

// fn make() -> Handle { Handle { fd: 1 } }
fn make_fn() -> IrFunction {
    let i: Vec<IrInst> = Vec::new();
    i.push(ir_inst_new(0, IOP_REGION_ALLOC(), ITY_LPTR(), Vec::new(), IDATA_ALLOC_SIZE(), 16, 8, String::from("")));
    i.push(mk_inst_const_i64(1, 1));
    i.push(mk_inst_field_set(2, 0, 0, 1));
    i.push(mk_inst_return(3, 0));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, i));
    mk_function(2, String::from("make"), Vec::new(), ITY_LPTR(), blocks)
}

fn check_gate_reads_linear_as_plain() -> i64 {
    let f: IrFunction = take_fn();
    if vc_skip_reason(f).len() == 0 { return 1; }
    let g: IrFunction = vc_erase_linear_fn(f);
    if vc_skip_reason(g).len() != 0 { return 2; }
    let m: IrFunction = make_fn();
    if vc_skip_reason(m).len() == 0 { return 3; }
    if vc_skip_reason(vc_erase_linear_fn(m)).len() != 0 { return 4; }
    0
}

fn check_erasure_leaves_source_alone() -> i64 {
    let f: IrFunction = take_fn();
    let g: IrFunction = vc_erase_linear_fn(f);
    if f.params[0] != ITY_LPTR() { return 1; }
    let b0: IrBlock = f.blocks[0];
    if b0.insts[0].ty != ITY_LPTR() { return 2; }
    if g.params[0] != ITY_PTR() { return 3; }
    let g0: IrBlock = g.blocks[0];
    if g0.insts[0].ty != ITY_PTR() { return 4; }
    if g0.insts[0].dv != 0 || g0.insts[0].op != IOP_GET_ARG() { return 5; }
    if g.vows.len() != f.vows.len() || g.name != f.name { return 6; }
    let h: IrFunction = make_fn();
    if vc_erase_linear_fn(h).return_ty != ITY_PTR() { return 7; }
    0
}

fn check_plain_function_is_shared() -> i64 {
    let i: Vec<IrInst> = Vec::new();
    i.push(mk_inst_const_i64(0, 1));
    i.push(mk_inst_return(1, 0));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, i));
    let f: IrFunction = mk_function(3, String::from("one"), Vec::new(), ITY_I64(), blocks);
    let g: IrFunction = vc_erase_linear_fn(f);
    if g.id != f.id || g.blocks.len() != 1 { return 1; }
    if vc_has_linear_ty(f) { return 2; }
    0
}

fn check_module_keeps_order() -> i64 {
    let fs: Vec<IrFunction> = Vec::new();
    fs.push(make_fn());
    fs.push(take_fn());
    let m: IrModule = mk_module(fs);
    m.strings.push(String::from("s"));
    let e: IrModule = vc_erase_linear(m);
    if e.functions.len() != 2 { return 1; }
    if e.functions[0].name != String::from("make") || e.functions[1].name != String::from("take") { return 2; }
    if e.functions[0].return_ty != ITY_PTR() || e.functions[1].params[0] != ITY_PTR() { return 3; }
    if e.strings.len() != 1 || e.name != m.name { return 4; }
    if m.functions[0].return_ty != ITY_LPTR() { return 5; }
    0
}

fn lptr_pick_params() -> Vec<i64> {
    let p: Vec<i64> = Vec::new();
    p.push(ITY_I64());
    p.push(ITY_LPTR());
    p.push(ITY_LPTR());
    p
}

// fn pick(c: i64, a: Handle, b: Handle) -> Handle { if c > 0 { a } else { b } }
fn pick_fn() -> IrFunction {
    let blocks: Vec<IrBlock> = Vec::new();
    let b0: Vec<IrInst> = Vec::new();
    b0.push(mk_inst_arg(0, ITY_I64(), 0));
    b0.push(mk_inst_arg(1, ITY_LPTR(), 1));
    b0.push(mk_inst_arg(2, ITY_LPTR(), 2));
    b0.push(mk_inst_const_i64(3, 0));
    b0.push(mk_inst(4, IOP_GT(), ITY_BOOL(), args2(0, 3)));
    b0.push(mk_inst_branch(5, 4, 1, 2));
    blocks.push(mk_block(0, b0));
    let b1: Vec<IrInst> = Vec::new();
    b1.push(mk_inst_upsilon(6, 1, 10));
    b1.push(mk_inst_jump(7, 3));
    blocks.push(mk_block(1, b1));
    let b2: Vec<IrInst> = Vec::new();
    b2.push(mk_inst_upsilon(8, 2, 10));
    b2.push(mk_inst_jump(9, 3));
    blocks.push(mk_block(2, b2));
    let b3: Vec<IrInst> = Vec::new();
    b3.push(mk_inst_phi(10, ITY_LPTR()));
    b3.push(mk_inst_return(11, 10));
    blocks.push(mk_block(3, b3));
    mk_function(4, String::from("pick"), lptr_pick_params(), ITY_LPTR(), blocks)
}

fn check_phi_of_linear_values() -> i64 {
    let f: IrFunction = pick_fn();
    if vc_skip_reason(f).len() == 0 { return 1; }
    let g: IrFunction = vc_erase_linear_fn(f);
    if vc_skip_reason(g).len() != 0 { return 2; }
    let b3: IrBlock = g.blocks[3];
    if b3.insts[0].ty != ITY_PTR() || g.return_ty != ITY_PTR() { return 3; }
    let o3: IrBlock = f.blocks[3];
    if o3.insts[0].ty != ITY_LPTR() { return 4; }
    0
}

fn check_erasure_keeps_metadata() -> i64 {
    let f: IrFunction = take_fn();
    f.local_names_ids.push(1);
    f.local_names_strs.push(String::from("fd"));
    f.rsum_param_regions.push(7);
    let g: IrFunction = vc_erase_linear_fn(f);
    if g.local_names_ids.len() != 1 || g.local_names_strs[0] != String::from("fd") { return 1; }
    if g.rsum_param_regions.len() != 1 || g.source_file != f.source_file { return 2; }
    if g.param_names.len() != f.param_names.len() { return 3; }
    0
}

fn main() -> i32 {
    let mut r: i64 = check_gate_reads_linear_as_plain();
    if r == 0 { r = check_erasure_leaves_source_alone(); }
    if r == 0 { r = check_plain_function_is_shared(); }
    if r == 0 { r = check_module_keeps_order(); }
    if r == 0 { r = check_phi_of_linear_values(); }
    if r == 0 { r = check_erasure_keeps_metadata(); }
    i64_to_i32_wrap(r)
}
