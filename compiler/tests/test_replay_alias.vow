module TestReplayAlias

use lexer
use ast
use diag
use parser
use replay_main
use replay_alias

fn parse_src(source: String) -> Module [io] {
    let dctx: DiagCtx = diag_ctx_new();
    let arena: AstArena = arena_new();
    parse_module_into(lex(source), arena, dctx, String::from("entry.vow"))
}

fn alias_src() -> String {
    let s: String = String::from("");
    s.push_str(String::from("module T\n"));
    s.push_str(String::from("type Id = i64;\n"));
    s.push_str(String::from("type Ids = Vec<Id>;\n"));
    s.push_str(String::from("type Reg = HashMap<i64, i64>;\n"));
    s.push_str(String::from("type Loop = Loop;\n"));
    s.push_str(String::from("struct Pair { lo: i64, hi: i64 }\n"));
    s.push_str(String::from("fn fvec(a: Vec<Id>, b: Vec<i64>) -> i64 { 0 }\n"));
    s.push_str(String::from("fn fids(v: Ids) -> i64 { 0 }\n"));
    s.push_str(String::from("fn fmap(p: Reg, q: HashMap<Id, i64>) -> i64 { 0 }\n"));
    s.push_str(String::from("fn floop(x: Loop) -> i64 { 0 }\n"));
    s.push_str(String::from("fn fpair(p: Pair) -> i64 { 0 }\n"));
    s.push_str(String::from("type PairAlias = Pair;\n"));
    s.push_str(String::from("type Small = i8;\n"));
    s.push_str(String::from("struct HasId { x: Id }\n"));
    s.push_str(String::from("fn fsmall(v: Vec<Small>) -> i64 { 0 }\n"));
    s.push_str(String::from("fn fhasid(h: HasId) -> i64 { 0 }\n"));
    s.push_str(String::from("fn falias(p: PairAlias) -> i64 { 0 }\n"));
    s
}

fn index_of_push(text: String) -> i64 {
    let needle: String = String::from("push(-1)");
    let mut i: u64 = 0u64;
    while i + needle.len() <= text.len() {
        if text.substring(i, i + needle.len()) == needle { return i as i64; }
        i = i + 1u64;
    }
    -1
}

fn param_type(m: Module, fname: String, pi: i64) -> i64 {
    let a: AstArena = m.arena;
    let lid: i64 = fn_params_lid(a, replay_find_fn_item(m, fname));
    list_get(a, lid, pi * 4 + 1)
}

fn resolved_text(fname: String, pi: i64) -> String [io] {
    let m: Module = parse_src(alias_src());
    print_type_text(m.arena, replay_resolve_type(m, param_type(m, fname, pi), 0))
}

fn check_resolution() -> i32 [io] {
    if resolved_text(String::from("fvec"), 0) != String::from("Vec<i64>") { return 1; }
    if resolved_text(String::from("fvec"), 1) != String::from("Vec<i64>") { return 2; }
    if resolved_text(String::from("fids"), 0) != String::from("Vec<i64>") { return 3; }
    if resolved_text(String::from("fmap"), 0) != String::from("HashMap<i64, i64>") { return 4; }
    if resolved_text(String::from("fmap"), 1) != String::from("HashMap<i64, i64>") { return 5; }
    if resolved_text(String::from("fpair"), 0) != String::from("Pair") { return 6; }
    if resolved_text(String::from("floop"), 0) != String::from("Loop") { return 7; }
    let m: Module = parse_src(alias_src());
    let plain: i64 = param_type(m, String::from("fvec"), 1);
    if replay_resolve_type(m, plain, 0) != plain { return 8; }
    0
}

fn agg(fname: String, pi: i64, kv: String) -> ReplayArg [io] {
    let m: Module = parse_src(alias_src());
    let names: Vec<String> = Vec::new();
    let vals: Vec<String> = Vec::new();
    let mut start: u64 = 0u64;
    let mut i: u64 = 0u64;
    while i <= kv.len() {
        if i == kv.len() || kv.byte_at(i) == 44 {
            if i > start {
                let pair: String = kv.substring(start, i);
                let mut at: u64 = 0u64;
                while pair.byte_at(at) != 61 { at = at + 1u64; }
                names.push(pair.substring(0u64, at));
                vals.push(pair.substring(at + 1u64, pair.len()));
            }
            start = i + 1u64;
        }
        i = i + 1u64;
    }
    let objs: ReplayObjs = replay_param_objects(m, fname, names, vals);
    let avoid: Vec<i64> = Vec::new();
    replay_agg_arg(m, fname, pi, names, vals, avoid, objs)
}

// A parameter whose type is an alias is built as its target, and two parameters the model gives one
// identity agree on a type only after both are resolved.
fn check_alias_parameters() -> i32 [io] {
    let one: String = String::from("a.alias=0,b.alias=0,a.len=1,a[0]=7");
    let first: ReplayArg = agg(String::from("fvec"), 0, one);
    if first.reason.len() != 0 || first.ty_text != String::from("Vec<i64>") { return 11; }
    let second: ReplayArg = agg(String::from("fvec"), 1, one);
    if second.reason.len() != 0 || second.ty_text != String::from("Vec<i64>") { return 12; }
    let ids: ReplayArg = agg(String::from("fids"), 0, String::from("v.len=1,v[0]=3"));
    if ids.reason.len() != 0 || ids.ty_text != String::from("Vec<i64>") { return 13; }
    let reg: ReplayArg = agg(String::from("fmap"), 0, String::from("p.len=0"));
    if reg.reason.len() != 0 || reg.ty_text != String::from("HashMap<i64, i64>") { return 14; }
    let pair: ReplayArg = agg(String::from("falias"), 0, String::from("p.0=1,p.1=2"));
    if pair.lit != String::from("Pair { lo: 1, hi: 2 }") { return 17; }
    let small: ReplayArg = agg(String::from("fsmall"), 0, String::from("v.len=1,v[0]=18446744073709551615"));
    if small.reason.len() != 0 || small.ty_text != String::from("Vec<i8>") || index_of_push(small.lit) < 0 { return 18; }
    if agg(String::from("fhasid"), 0, String::from("h.0=1")).reason.len() == 0 { return 19; }
    let looped: ReplayArg = agg(String::from("floop"), 0, String::from(""));
    if looped.reason.len() == 0 { return 15; }
    let objs: ReplayObjs = replay_param_objects(parse_src(alias_src()), String::from("fvec"), Vec::new(), Vec::new());
    if replay_obj_ty(objs, 0) != String::from("Vec<i64>") || replay_obj_ty(objs, 1) != String::from("Vec<i64>") { return 16; }
    0
}

fn main() -> i32 [io] {
    let r1: i32 = check_resolution();
    if r1 != 0 { return r1; }
    check_alias_parameters()
}
