module TestVcPtrParam

use ir
use vc_ops
use vc_gate
use vc_overlay
use vc_ptrhandle
use vc_ptrparam
use tests.builders

fn two(a: i64, b: i64) -> Vec<i64> {
    let v: Vec<i64> = Vec::new();
    v.push(a);
    v.push(b);
    v
}

// ids 0: the `Vec<Vec<i64>>` parameter `outer`, 1: a parameter of key `inner_key`, 2: an index, 3: the
// push of `stored` (1, or the `get` 4 when 0, which also pushes 1 as id 8) into `outer`, 4: the `get` of `outer`.
fn receiver(inner_key: String, stored: i64) -> IrFunction {
    let params: Vec<i64> = Vec::new();
    params.push(ITY_PTR());
    params.push(ITY_PTR());
    let i: Vec<IrInst> = Vec::new();
    i.push(mk_inst_arg(0, ITY_PTR(), 0));
    i.push(mk_inst_arg(1, ITY_PTR(), 1));
    i.push(mk_inst_const_i64(2, 0));
    i.push(mk_inst_call_extern(4, ITY_I64(), two(0, 2), String::from("__vow_vec_get_val")));
    i.push(mk_inst_call_extern(3, ITY_UNIT(), two(0, { if stored == 0 { 4 } else { stored } }), String::from("__vow_vec_push_val")));
    if stored == 0 { i.push(mk_inst_call_extern(8, ITY_UNIT(), two(0, 1), String::from("__vow_vec_push_val"))); }
    i.push(mk_inst(5, IOP_RETURN(), ITY_UNIT(), Vec::new()));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, i));
    let f: IrFunction = mk_function(1, String::from("f"), params, ITY_UNIT(), blocks);
    f.param_keys.push(String::from("Vec<Vec<i64>>"));
    f.param_keys.push(inner_key);
    f
}

// A `Vec` parameter that receives a pointer is marked, the parameter stored into it is not, and the
// function is admitted.
fn check_marked() -> i64 {
    let f: IrFunction = receiver(String::from("Vec<i64>"), 1);
    let tys: Vec<i64> = vc_ty_table(f);
    let held: Vec<i64> = vc_ptr_store_held(f, tys);
    let params: Vec<i64> = vc_ptr_param_held(f, held, tys);
    if params[0] != 1 || params[1] != 0 || !vc_ptr_param_any(params) { return 1; }
    if vc_ptr_param_merged(f, params) { return 2; }
    if vc_skip_reason(f) != String::from("") { return 3; }
    0
}

// `VcOverlay.tagged` is 2 for the receiver and 0 for every other id: the parameter is not noted as
// plain given memory, and the parameter stored into it is not tagged either.
fn check_tags() -> i64 {
    let f: IrFunction = receiver(String::from("Vec<i64>"), 1);
    let tys: Vec<i64> = vc_ty_table(f);
    let tags: Vec<i64> = vc_ptr_handle_tags(f, vc_ptr_store_held(f, tys), tys);
    if tags.len() != tys.len() || tags[0] != VC_PP_HELD() || tags[1] != 0 || tags[4] != 0 { return 1; }
    0
}

// A parameter of another class is no `Vec` receiver: it is not marked, and the function keeps the
// reason it had.
fn check_class() -> i64 {
    let f: IrFunction = receiver(String::from("Person"), 1);
    f.param_keys[0] = String::from("Person");
    let tys: Vec<i64> = vc_ty_table(f);
    let held: Vec<i64> = vc_ptr_store_held(f, tys);
    if vc_ptr_param_any(vc_ptr_param_held(f, held, tys)) { return 1; }
    0
}

// An element of the receiver stored back into it is a word that may be either kind: the function is
// refused.
fn check_handle_stored() -> i64 {
    let f: IrFunction = receiver(String::from("Vec<i64>"), 0);
    if vc_skip_reason(f) == String::from("") { return 1; }
    0
}

// A receiver that a Phi merges is refused by `vc_ptr_param_merged`.
fn check_merged() -> i64 {
    let f: IrFunction = receiver(String::from("Vec<i64>"), 1);
    f.blocks[0].insts.push(mk_inst_phi(6, ITY_PTR()));
    f.blocks[0].insts.push(mk_inst_upsilon(7, 0, 6));
    let params: Vec<i64> = dom_fill(8, 0);
    params[0] = 1;
    if !vc_ptr_param_merged(f, params) { return 1; }
    params[0] = 0;
    if vc_ptr_param_merged(f, params) { return 2; }
    0
}

fn main() -> i32 {
    let mut r: i64 = check_marked();
    if r == 0 { r = check_tags() + 10; if r == 10 { r = 0; } }
    if r == 0 { r = check_class() + 20; if r == 20 { r = 0; } }
    if r == 0 { r = check_handle_stored() + 30; if r == 30 { r = 0; } }
    if r == 0 { r = check_merged() + 40; if r == 40 { r = 0; } }
    i64_to_i32_wrap(r)
}
