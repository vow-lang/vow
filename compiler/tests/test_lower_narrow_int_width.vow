module TestLowerNarrowIntWidth

use ast
use ir
use lower

// Twin of narrow_int_width_and_divergence_are_exhaustive_over_ty and its two
// siblings in vow-ir/src/lower/mod.rs.

// The admission gates lower.vow spelled inline before the seam, verbatim.
fn niw_legacy_eight(ty: i64) -> bool {
    ty == ITY_I8() || ty == ITY_U8() || ty == ITY_I16() ||
    ty == ITY_U16() || ty == ITY_I32() || ty == ITY_U32() ||
    ty == ITY_I128() || ty == ITY_U128()
}

fn niw_legacy_nine(ty: i64) -> bool {
    niw_legacy_eight(ty) || ty == ITY_U64()
}

fn niw_same(x: bool, y: bool) -> bool {
    (x && y) || (!x && !y)
}

fn niw_expect_row(ty: i64, bits: i64, narrow: i64, diverges: bool, code: i64) -> i64 {
    if ity_int_width_bits(ty) != bits { return code; }
    if narrow_int_width(ty) != narrow { return code + 1; }
    if !niw_same(diverges_from_speculative_int(ty), diverges) { return code + 2; }
    0
}

fn check_exhaustive_over_ity() -> i64 {
    let mut r: i64 = niw_expect_row(ITY_I8(), 8, 8, true, 1);
    if r == 0 { r = niw_expect_row(ITY_U8(), 8, 8, true, 4); }
    if r == 0 { r = niw_expect_row(ITY_I16(), 16, 16, true, 7); }
    if r == 0 { r = niw_expect_row(ITY_U16(), 16, 16, true, 10); }
    if r == 0 { r = niw_expect_row(ITY_I32(), 32, 32, true, 13); }
    if r == 0 { r = niw_expect_row(ITY_U32(), 32, 32, true, 16); }
    // The speculative default itself: nothing to re-lower.
    if r == 0 { r = niw_expect_row(ITY_I64(), 64, 0, false, 19); }
    // Same width as i64, different signedness: the one code the predicates disagree on.
    if r == 0 { r = niw_expect_row(ITY_U64(), 64, 0, true, 22); }
    if r == 0 { r = niw_expect_row(ITY_I128(), 128, 128, true, 25); }
    if r == 0 { r = niw_expect_row(ITY_U128(), 128, 128, true, 28); }
    if r == 0 { r = niw_expect_row(ITY_F32(), 0, 0, false, 31); }
    if r == 0 { r = niw_expect_row(ITY_F64(), 0, 0, false, 34); }
    if r == 0 { r = niw_expect_row(ITY_BOOL(), 0, 0, false, 37); }
    if r == 0 { r = niw_expect_row(ITY_UNIT(), 0, 0, false, 40); }
    if r == 0 { r = niw_expect_row(ITY_PTR(), 0, 0, false, 43); }
    if r == 0 { r = niw_expect_row(ITY_LPTR(), 0, 0, false, 46); }
    if r == 0 { r = niw_expect_row(-1, 0, 0, false, 49); }
    if r == 0 { r = niw_expect_row(ITY_U128() + 1, 0, 0, false, 52); }
    r
}

fn check_reproduces_legacy_gates() -> i64 {
    let mut ty: i64 = -2;
    while ty <= ITY_U128() + 2 {
        if !niw_same(narrow_int_width(ty) != 0, niw_legacy_eight(ty)) { return 60; }
        if !niw_same(diverges_from_speculative_int(ty), niw_legacy_nine(ty)) { return 61; }
        if !niw_same(ity_int_width_bits(ty) != 0, ir_ty_is_integer(ty)) { return 62; }
        ty = ty + 1;
    }
    0
}

// The ITY code the let-annotation site re-lowers `name` at, or -1 where the old
// eight-`if` name chain left the value alone.
fn niw_let_admission(name: String) -> i64 {
    let annotated: i64 = ity_for_scalar_type_name(name);
    if narrow_int_width(annotated) != 0 { return annotated; }
    -1
}

fn niw_expect_let(name: String, want: i64, code: i64) -> i64 {
    if niw_let_admission(name) != want { return code; }
    0
}

fn check_let_annotation_composition() -> i64 {
    let mut r: i64 = niw_expect_let(String::from("i8"), ITY_I8(), 70);
    if r == 0 { r = niw_expect_let(String::from("u8"), ITY_U8(), 71); }
    if r == 0 { r = niw_expect_let(String::from("i16"), ITY_I16(), 72); }
    if r == 0 { r = niw_expect_let(String::from("u16"), ITY_U16(), 73); }
    if r == 0 { r = niw_expect_let(String::from("i32"), ITY_I32(), 74); }
    if r == 0 { r = niw_expect_let(String::from("u32"), ITY_U32(), 75); }
    if r == 0 { r = niw_expect_let(String::from("i128"), ITY_I128(), 76); }
    if r == 0 { r = niw_expect_let(String::from("u128"), ITY_U128(), 77); }
    // u64 is reduced by the IntCast after the chain; admitting it would delete that cast.
    if r == 0 { r = niw_expect_let(String::from("u64"), -1, 78); }
    if r == 0 { r = niw_expect_let(String::from("i64"), -1, 79); }
    if r == 0 { r = niw_expect_let(String::from("f32"), -1, 80); }
    if r == 0 { r = niw_expect_let(String::from("f64"), -1, 81); }
    if r == 0 { r = niw_expect_let(String::from("bool"), -1, 82); }
    // Unknown names fall back to ITY_I64, which the width predicate rejects.
    if r == 0 { r = niw_expect_let(String::from("Point"), -1, 83); }
    if r == 0 { r = niw_expect_let(String::from("T"), -1, 84); }
    if r == 0 { r = niw_expect_let(String::from(""), -1, 85); }
    r
}

fn main() -> i32 {
    let r1: i64 = check_exhaustive_over_ity();
    if r1 != 0 { return i64_to_i32_wrap(r1); }
    let r2: i64 = check_reproduces_legacy_gates();
    if r2 != 0 { return i64_to_i32_wrap(r2); }
    let r3: i64 = check_let_annotation_composition();
    if r3 != 0 { return i64_to_i32_wrap(r3); }
    0
}
