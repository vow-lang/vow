module TestMutantsBaseline

use mutants_oracle

fn main() -> i32 {
    if baseline_failure_reason(0) != String::from("") { return 1; }
    if baseline_failure_reason(-1) != String::from("could not spawn the oracle command") { return 2; }
    if baseline_failure_reason(-2) != String::from("timed out") { return 3; }
    if baseline_failure_reason(1) != String::from("exit code 1") { return 4; }
    if baseline_failure_reason(124) != String::from("exit code 124") { return 5; }
    0
}
