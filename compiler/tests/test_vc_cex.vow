module TestVcCex

use ir
use verifier
use vc_solver
use vc_exec
use vc_smt
use vc_term
use vc_cex
use tests.builders

fn claims_with(kind: i64, vow_id: i64, label: String) -> VcClaims {
    let cs: VcClaims = VcClaims {
        arena: vc_arena_new(),
        header: vc_script_new(),
        assumed: Vec::new(),
        kinds: Vec::new(),
        frames: Vec::new(),
        fr: vc_frames_new(),
        pre_only: false,
        step: false,
        hyp_now: false,
        vow_ids: Vec::new(),
        labels: Vec::new(),
        ostarts: Vec::new(),
        olens: Vec::new(),
        negated_goals: Vec::new(),
        header_lens: Vec::new(),
        assumed_lens: Vec::new(),
        model_names: Vec::new(),
        model_params: Vec::new(),
        model_tys: Vec::new(),
        model_widths: Vec::new(),
        model_slots: Vec::new(),
        model_hdr: Vec::new(),
        model_ambig: Vec::new(),
        hook_vars: Vec::new(),
        vec_param: Vec::new(),
        vec_arr: Vec::new(),
        vec_len: Vec::new(),
        vec_hdr: Vec::new(),
        vec_wide: Vec::new(),
    };
    cs.kinds.push(kind);
    cs.frames.push(-1);
    cs.vow_ids.push(vow_id);
    cs.labels.push(label);
    cs.model_names.push(String::from("p0"));
    cs.model_names.push(String::from("p1"));
    cs.model_params.push(0);
    cs.model_params.push(1);
    cs.model_tys.push(ITY_I64());
    cs.model_tys.push(ITY_I64());
    cs.model_widths.push(64);
    cs.model_widths.push(64);
    cs.model_slots.push(-1);
    cs.model_slots.push(-1);
    cs.model_ambig.push(0);
    cs.model_ambig.push(0);
    cs
}

fn push_field(cs: VcClaims, param: i64, slot: i64, ty: i64, width: i64, ambig: i64) {
    cs.model_names.push(String::from("f"));
    cs.model_params.push(param);
    cs.model_tys.push(ty);
    cs.model_widths.push(width);
    cs.model_slots.push(slot);
    cs.model_ambig.push(ambig);
}

fn answer(verdict: i64, a: i64, b: i64) -> VcSolverAnswer {
    let values: Vec<i64> = Vec::new();
    values.push(a);
    values.push(b);
    let highs: Vec<i64> = Vec::new();
    highs.push(0);
    highs.push(0);
    VcSolverAnswer { verdict: verdict, values: values, highs: highs, raw: String::from("raw text") }
}

fn fn_xy() -> IrFunction {
    let p: Vec<i64> = Vec::new();
    p.push(ITY_I64());
    p.push(ITY_I64());
    let f: IrFunction = mk_function(1, String::from("f"), p, ITY_I64(), Vec::new());
    f.param_names[0] = String::from("x");
    f.param_names[1] = String::from("y");
    f
}

fn check_sat_ensures() -> i64 {
    let f: IrFunction = fn_xy();
    let cs: VcClaims = claims_with(VC_CLAIM_ENSURES(), 3, String::from(""));
    let r: VerifyResult = vc_claim_result(f, cs, 0, answer(VC_ANS_SAT(), -5, 9223372036854775807));
    if r.status != VERIFY_FAILED() { return 1; }
    if r.vow_id != 3 { return 2; }
    if r.var_names[0] != String::from("x") || r.var_names[1] != String::from("y") { return 3; }
    if r.var_values[0] != String::from("-5") { return 4; }
    if r.var_values[1] != String::from("9223372036854775807") { return 5; }
    if r.raw_output.len() != 0 { return 6; }
    if r.callee_precondition_func_id != -1 { return 7; }
    0
}

fn check_sat_abort_claims() -> i64 {
    let f: IrFunction = fn_xy();
    let z: VcClaims = claims_with(VC_CLAIM_DIV_ZERO(), -1, String::from("division by zero"));
    let r: VerifyResult = vc_claim_result(f, z, 0, answer(VC_ANS_SAT(), 1, 0));
    if r.status != VERIFY_FAILED() { return 10; }
    if r.vow_id != -1 { return 11; }
    if parse_assert_label(r.raw_output) != String::from("division or remainder by zero") { return 12; }
    let o: VcClaims = claims_with(VC_CLAIM_DIV_OVERFLOW(), -1, String::from("division overflow"));
    let r2: VerifyResult = vc_claim_result(f, o, 0, answer(VC_ANS_SAT(), -9223372036854775807 - 1, -1));
    if parse_assert_label(r2.raw_output) != String::from("signed division overflow (MIN / -1)") { return 13; }
    if r2.var_values[0] != String::from("-9223372036854775808") { return 14; }
    0
}

fn check_non_sat_verdicts() -> i64 {
    let f: IrFunction = fn_xy();
    let cs: VcClaims = claims_with(VC_CLAIM_ENSURES(), 0, String::from(""));
    if vc_claim_result(f, cs, 0, answer(VC_ANS_UNKNOWN(), 0, 0)).status != VERIFY_UNKNOWN() { return 20; }
    if vc_claim_result(f, cs, 0, answer(VC_ANS_TIMEOUT(), 0, 0)).status != VERIFY_TIMEOUT() { return 21; }
    if vc_claim_result(f, cs, 0, answer(VC_ANS_NOT_FOUND(), 0, 0)).status != VERIFY_NOT_FOUND() { return 22; }
    let e: VerifyResult = vc_claim_result(f, cs, 0, answer(VC_ANS_ERROR(), 0, 0));
    if e.status != VERIFY_ERROR() { return 23; }
    if e.raw_output != String::from("raw text") { return 24; }
    if vc_claim_result(f, cs, 0, answer(VC_ANS_UNSAT(), 0, 0)).status == VERIFY_PROVEN() { return 25; }
    if vc_proven_result().status != VERIFY_PROVEN() { return 26; }
    0
}

fn typed_fn(a: i64, b: i64) -> IrFunction {
    let p: Vec<i64> = Vec::new();
    p.push(a);
    p.push(b);
    let f: IrFunction = mk_function(1, String::from("g"), p, ITY_I64(), Vec::new());
    f.param_names[0] = String::from("x");
    f.param_names[1] = String::from("y");
    f
}

fn typed_answer(lo0: i64, hi0: i64, lo1: i64, hi1: i64) -> VcSolverAnswer {
    let values: Vec<i64> = Vec::new();
    values.push(lo0);
    values.push(lo1);
    let highs: Vec<i64> = Vec::new();
    highs.push(hi0);
    highs.push(hi1);
    VcSolverAnswer { verdict: VC_ANS_SAT(), values: values, highs: highs, raw: String::from("") }
}

fn check_values_follow_declared_types() -> i64 {
    let f: IrFunction = typed_fn(ITY_U8(), ITY_I8());
    let cs: VcClaims = claims_with(VC_CLAIM_ENSURES(), 0, String::from(""));
    cs.model_tys[0] = ITY_U8();
    cs.model_tys[1] = ITY_I8();
    let r: VerifyResult = vc_claim_result(f, cs, 0, typed_answer(255, 0, 255, 0));
    if r.var_values[0] != String::from("255") { return 30; }
    if r.var_values[1] != String::from("-1") { return 31; }
    let g: IrFunction = typed_fn(ITY_U64(), ITY_U128());
    let cs2: VcClaims = claims_with(VC_CLAIM_ENSURES(), 0, String::from(""));
    cs2.model_tys[0] = ITY_U64();
    cs2.model_tys[1] = ITY_U128();
    let r2: VerifyResult = vc_claim_result(g, cs2, 0, typed_answer(-1, 0, -1, -1));
    if r2.var_values[0] != String::from("18446744073709551615") { return 32; }
    if r2.var_values[1] != String::from("340282366920938463463374607431768211455") { return 33; }
    0
}

fn check_shift_and_arith_labels() -> i64 {
    let f: IrFunction = fn_xy();
    let s: VcClaims = claims_with(VC_CLAIM_SHIFT_COUNT(), -1, String::from("integer shift count"));
    let r: VerifyResult = vc_claim_result(f, s, 0, answer(VC_ANS_SAT(), 1, 64));
    if r.status != VERIFY_FAILED() { return 40; }
    if r.vow_id != -1 { return 41; }
    if parse_assert_label(r.raw_output) != String::from("shift amount exceeds the operand's bit width") { return 42; }
    0
}

// A claim of an inlined callee reports the callee's own vow id and names the
// callee's function; neither carries an assertion label (the callee clause
// text is resolved from the function's vows).
fn check_callee_clauses() -> i64 {
    let f: IrFunction = fn_xy();
    let pre: VcClaims = claims_with(VC_CLAIM_CALLER_PRE(), 4, String::from(""));
    pre.frames[0] = 1;
    pre.fr.func_ids.push(30);
    pre.fr.func_ids.push(31);
    pre.fr.call_starts.push(0);
    pre.fr.call_starts.push(0);
    pre.fr.call_lens.push(0);
    pre.fr.call_lens.push(0);
    pre.fr.parents.push(-1);
    pre.fr.parents.push(0);
    let r: VerifyResult = vc_claim_result(f, pre, 0, answer(VC_ANS_SAT(), 1, 2));
    if r.status != VERIFY_FAILED() { return 50; }
    if r.vow_id != 4 { return 51; }
    if r.callee_precondition_func_id != 31 || r.callee_precondition_vow_id != 4 { return 52; }
    if r.callee_postcondition_func_id != -1 || r.callee_postcondition_vow_id != -1 { return 53; }
    if r.raw_output.len() != 0 { return 54; }
    let post: VcClaims = claims_with(VC_CLAIM_CALLEE_POST(), 6, String::from(""));
    post.frames[0] = 0;
    post.fr.func_ids.push(30);
    post.fr.call_starts.push(0);
    post.fr.call_lens.push(0);
    post.fr.parents.push(-1);
    let q: VerifyResult = vc_claim_result(f, post, 0, answer(VC_ANS_SAT(), 1, 2));
    if q.vow_id != 6 { return 55; }
    if q.callee_postcondition_func_id != 30 || q.callee_postcondition_vow_id != 6 { return 56; }
    if q.callee_precondition_func_id != -1 { return 57; }
    if q.raw_output.len() != 0 { return 58; }
    0
}

fn check_aggregate_fields() -> i64 {
    let p: Vec<i64> = Vec::new();
    p.push(ITY_I64());
    p.push(ITY_PTR());
    let f: IrFunction = mk_function(1, String::from("f"), p, ITY_I64(), Vec::new());
    f.param_names[0] = String::from("x");
    f.param_names[1] = String::from("o");
    let fresh: VcClaims = claims_with(VC_CLAIM_ENSURES(), 0, String::from(""));
    fresh.model_names.pop();
    fresh.model_params.pop();
    fresh.model_tys.pop();
    fresh.model_widths.pop();
    fresh.model_slots.pop();
    fresh.model_ambig.pop();
    push_field(fresh, 1, 0, ITY_I64(), 64, 0);
    push_field(fresh, 1, 1, ITY_BOOL(), 0, 0);
    let values: Vec<i64> = Vec::new();
    values.push(7);
    values.push(1);
    values.push(1);
    let highs: Vec<i64> = Vec::new();
    highs.push(0);
    highs.push(0);
    highs.push(0);
    let ans: VcSolverAnswer = VcSolverAnswer { verdict: VC_ANS_SAT(), values: values, highs: highs, raw: String::from("") };
    let r: VerifyResult = vc_claim_result(f, fresh, 0, ans);
    if r.var_names.len() != 3 { return 60; }
    if r.var_names[0] != String::from("x") { return 61; }
    if r.var_names[1] != String::from("o.0") { return 62; }
    if r.var_names[2] != String::from("o.1") { return 63; }
    if r.var_values[0] != String::from("7") { return 64; }
    if r.var_values[1] != String::from("1") { return 65; }
    if r.var_values[2] != String::from("true") { return 66; }
    // A slot read at two sorts: the suffix says which view each symbol is.
    let amb: VcClaims = claims_with(VC_CLAIM_ENSURES(), 0, String::from(""));
    amb.model_names.pop();
    amb.model_params.pop();
    amb.model_tys.pop();
    amb.model_widths.pop();
    amb.model_slots.pop();
    amb.model_ambig.pop();
    push_field(amb, 1, 1, ITY_I64(), 64, 1);
    push_field(amb, 1, 1, ITY_BOOL(), 0, 1);
    let r2: VerifyResult = vc_claim_result(f, amb, 0, ans);
    if r2.var_names[1] != String::from("o.1:64") { return 67; }
    if r2.var_names[2] != String::from("o.1:bool") { return 68; }
    let fl: VcClaims = claims_with(VC_CLAIM_ENSURES(), 0, String::from(""));
    fl.model_names.pop();
    fl.model_params.pop();
    fl.model_tys.pop();
    fl.model_widths.pop();
    fl.model_slots.pop();
    fl.model_ambig.pop();
    push_field(fl, 1, 1, ITY_F64(), VC_SORT_F64(), 1);
    push_field(fl, 1, 1, ITY_F32(), VC_SORT_F32(), 1);
    let r4: VerifyResult = vc_claim_result(f, fl, 0, ans);
    if r4.var_names[1] != String::from("o.1:f64") { return 71; }
    if r4.var_names[2] != String::from("o.1:f32") { return 72; }
    // The identity of an aggregate parameter reads `<param>.alias`.
    let al: VcClaims = claims_with(VC_CLAIM_ENSURES(), 0, String::from(""));
    al.model_names.pop();
    al.model_params.pop();
    al.model_tys.pop();
    al.model_widths.pop();
    al.model_slots.pop();
    al.model_ambig.pop();
    push_field(al, 1, VC_ALIAS_SLOT(), ITY_U8(), 8, 0);
    push_field(al, 1, 0, ITY_I64(), 64, 0);
    let r5: VerifyResult = vc_claim_result(f, al, 0, ans);
    if r5.var_names[1] != String::from("o.alias") { return 73; }
    if r5.var_names[2] != String::from("o.0") { return 74; }
    // A parameter that is the same object as an earlier one shows that one's
    // field, not the value the solver left on its own symbol; a distinct one
    // keeps its own.
    let eq: VcClaims = claims_with(VC_CLAIM_ENSURES(), 0, String::from(""));
    eq.model_names.pop();
    eq.model_params.pop();
    eq.model_tys.pop();
    eq.model_widths.pop();
    eq.model_slots.pop();
    eq.model_ambig.pop();
    push_field(eq, 1, VC_ALIAS_SLOT(), ITY_U8(), 8, 0);
    push_field(eq, 2, VC_ALIAS_SLOT(), ITY_U8(), 8, 0);
    push_field(eq, 3, VC_ALIAS_SLOT(), ITY_U8(), 8, 0);
    push_field(eq, 1, 0, ITY_I64(), 64, 0);
    push_field(eq, 2, 0, ITY_I64(), 64, 0);
    push_field(eq, 3, 0, ITY_I64(), 64, 0);
    let av: Vec<i64> = Vec::new();
    av.push(9);
    av.push(3);
    av.push(3);
    av.push(4);
    av.push(10);
    av.push(99);
    av.push(55);
    let ah: Vec<i64> = Vec::new();
    ah.push(0);
    ah.push(0);
    ah.push(0);
    ah.push(0);
    ah.push(0);
    ah.push(0);
    ah.push(0);
    let aans: VcSolverAnswer = VcSolverAnswer { verdict: VC_ANS_SAT(), values: av, highs: ah, raw: String::from("") };
    let r6: VerifyResult = vc_claim_result(f, eq, 0, aans);
    if r6.var_values[4] != String::from("10") { return 75; }
    if r6.var_values[5] != String::from("10") { return 76; }
    if r6.var_values[6] != String::from("55") { return 77; }
    // The answer of an earlier claim carries only the symbols it declared.
    let short_values: Vec<i64> = Vec::new();
    short_values.push(9);
    let short_highs: Vec<i64> = Vec::new();
    short_highs.push(0);
    let early: VcSolverAnswer = VcSolverAnswer { verdict: VC_ANS_SAT(), values: short_values, highs: short_highs, raw: String::from("") };
    let r3: VerifyResult = vc_claim_result(f, fresh, 0, early);
    if r3.var_names.len() != 1 { return 69; }
    if r3.var_values[0] != String::from("9") { return 70; }
    0
}


fn vec_fn() -> IrFunction {
    let p: Vec<i64> = Vec::new();
    p.push(ITY_I64());
    p.push(ITY_PTR());
    let f: IrFunction = mk_function(1, String::from("h"), p, ITY_I64(), Vec::new());
    f.param_names[0] = String::from("x");
    f.param_names[1] = String::from("v");
    f
}

// `x` is a scalar parameter and `v` a `Vec` whose length constant sits at header
// position 3, declared before claim 0's prefix of 10 commands.
fn vec_claims() -> VcClaims {
    let cs: VcClaims = claims_with(VC_CLAIM_ENSURES(), 0, String::from(""));
    cs.model_names[1] = String::from("p1_vlen");
    cs.model_tys[1] = ITY_U64();
    cs.model_slots[1] = VC_SLOT_VEC_LEN();
    cs.model_hdr.push(0);
    cs.model_hdr.push(3);
    cs.header_lens.push(10);
    cs.vec_param.push(1);
    cs.vec_arr.push(String::from("p1_varr"));
    cs.vec_len.push(String::from("p1_vlen"));
    cs.vec_hdr.push(3);
    cs.vec_wide.push(-1);
    cs
}

fn vec_answer(x: i64, len: i64, e0: i64, e1: i64, with_contents: bool) -> VcSolverAnswer {
    let values: Vec<i64> = Vec::new();
    let highs: Vec<i64> = Vec::new();
    values.push(x);
    values.push(len);
    if with_contents {
        let mut i: i64 = 0;
        while i < 8 {
            if i == 0 { values.push(e0); } else if i == 1 { values.push(e1); } else { values.push(99); }
            i = i + 1;
        }
    }
    let mut h: u64 = 0;
    while h < values.len() {
        highs.push(0);
        h = h + 1;
    }
    VcSolverAnswer { verdict: VC_ANS_SAT(), values: values, highs: highs, raw: String::from("") }
}

fn check_vec_contents() -> i64 {
    let f: IrFunction = vec_fn();
    let cs: VcClaims = vec_claims();
    let r: VerifyResult = vc_claim_result(f, cs, 0, vec_answer(5, 2, 7, -1, true));
    if r.var_names.len() != 4 { return 80; }
    if r.var_names[0] != String::from("x") || r.var_values[0] != String::from("5") { return 81; }
    if r.var_names[1] != String::from("v.len") || r.var_values[1] != String::from("2") { return 82; }
    if r.var_names[2] != String::from("v[0]") || r.var_values[2] != String::from("7") { return 83; }
    if r.var_names[3] != String::from("v[1]") || r.var_values[3] != String::from("18446744073709551615") { return 84; }
    let bare: VerifyResult = vc_claim_result(f, vec_claims(), 0, vec_answer(5, 2, 0, 0, false));
    if bare.var_names.len() != 2 || bare.var_names[1] != String::from("v.len") { return 85; }
    let none: VerifyResult = vc_claim_result(f, vec_claims(), 0, vec_answer(5, 0, 0, 0, true));
    if none.var_names.len() != 2 || none.var_values[1] != String::from("0") { return 86; }
    let big: VerifyResult = vc_claim_result(f, vec_claims(), 0, vec_answer(5, 100, 0, 0, true));
    if big.var_names.len() != 2 || big.var_values[1] != String::from("100") { return 87; }
    0
}

// The elements of a wide `Vec` are 128-bit entries printed in their own type, from
// both limbs of the answer.
fn check_wide_vec_contents() -> i64 {
    let f: IrFunction = vec_fn();
    let cs: VcClaims = vec_claims();
    cs.vec_wide[0] = ITY_I128();
    let values: Vec<i64> = Vec::new();
    let highs: Vec<i64> = Vec::new();
    values.push(5);
    highs.push(0);
    values.push(2);
    highs.push(0);
    values.push(7);
    highs.push(0);
    values.push(0);
    highs.push(-9223372036854775808);
    let ans: VcSolverAnswer = VcSolverAnswer { verdict: VC_ANS_SAT(), values: values, highs: highs, raw: String::from("") };
    let r: VerifyResult = vc_claim_result(f, cs, 0, ans);
    if r.var_names.len() != 4 { return 90; }
    if r.var_names[2] != String::from("v[0]") || r.var_values[2] != String::from("7") { return 91; }
    if r.var_names[3] != String::from("v[1]") || r.var_values[3] != String::from("-170141183460469231731687303715884105728") { return 92; }
    let cu: VcClaims = vec_claims();
    cu.vec_wide[0] = ITY_U128();
    let ru: VerifyResult = vc_claim_result(f, cu, 0, ans);
    if ru.var_values[3] != String::from("170141183460469231731687303715884105728") { return 93; }
    0
}

fn main() -> i32 {
    let mut r: i64 = check_sat_ensures();
    if r == 0 { r = check_sat_abort_claims(); }
    if r == 0 { r = check_non_sat_verdicts(); }
    if r == 0 { r = check_values_follow_declared_types(); }
    if r == 0 { r = check_shift_and_arith_labels(); }
    if r == 0 { r = check_callee_clauses(); }
    if r == 0 { r = check_aggregate_fields(); }
    if r == 0 { r = check_vec_contents(); }
    if r == 0 { r = check_wide_vec_contents(); }
    i64_to_i32_wrap(r)
}
