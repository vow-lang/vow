module TestVcQuery

use ir
use vc_term
use vc_smt
use vc_ops
use vc_query
use tests.builders

fn empty_claims() -> VcClaims {
    vc_claims_new(vc_frames_new(), false, false)
}

// Two recorded prefixes followed by later declarations and assumptions. Query
// construction must use the recorded prefix, including for model requests.
fn query_claims() -> VcClaims {
    let cs: VcClaims = empty_claims();
    let ar: VcArena = cs.arena;
    let hdr: SmtScript = cs.header;
    let a: i64 = vc_tm_var(ar, String::from("a"));
    cs.model_hdr.push(hdr.kinds.len() as i64);
    cs.model_names.push(String::from("a"));
    cs.model_widths.push(VC_SORT_BOOL());
    vc_script_declare_const(hdr, String::from("a"), VC_SORT_BOOL());
    cs.assumed.push(a);
    cs.header_lens.push(hdr.kinds.len() as i64);
    cs.assumed_lens.push(cs.assumed.len() as i64);
    cs.negated_goals.push(vc_tm_app1(ar, VC_OP_NOT(), a));

    let b: i64 = vc_tm_var(ar, String::from("b"));
    cs.model_hdr.push(hdr.kinds.len() as i64);
    cs.model_names.push(String::from("b"));
    cs.model_widths.push(VC_SORT_BOOL());
    vc_script_declare_const(hdr, String::from("b"), VC_SORT_BOOL());
    vc_script_define_fun(hdr, String::from("x"), VC_SORT_BOOL(), vc_tm_app1(ar, VC_OP_NOT(), b));
    cs.assumed.push(b);
    cs.header_lens.push(hdr.kinds.len() as i64);
    cs.assumed_lens.push(cs.assumed.len() as i64);
    cs.negated_goals.push(vc_tm_app1(ar, VC_OP_NOT(), vc_tm_var(ar, String::from("x"))));

    cs.model_hdr.push(hdr.kinds.len() as i64);
    cs.model_names.push(String::from("later"));
    cs.model_widths.push(VC_SORT_BOOL());
    vc_script_declare_const(hdr, String::from("later"), VC_SORT_BOOL());
    cs.assumed.push(vc_tm_bool_const(ar, false));
    cs
}

fn early_header() -> String {
    String::from("(set-logic QF_BV)\n(set-option :produce-models true)\n(declare-const a Bool)\n")
}

fn late_header() -> String {
    let out: String = early_header();
    out.push_str(String::from("(declare-const b Bool)\n(define-fun x () Bool (not b))\n"));
    out
}

fn check_full_and_context() -> i64 {
    let cs: VcClaims = query_claims();
    let early: String = early_header();
    early.push_str(String::from("(assert a)\n"));
    if vc_smt_render(cs.arena, vc_claim_context_script(cs, 0)) != early { return 1; }
    early.push_str(String::from("(assert (not a))\n(check-sat)\n(get-value (a))\n"));
    if vc_claim_query(cs, 0) != early { return 2; }
    let late: String = late_header();
    late.push_str(String::from("(assert a)\n(assert b)\n"));
    if vc_smt_render(cs.arena, vc_claim_context_script(cs, 1)) != late { return 3; }
    late.push_str(String::from("(assert (not x))\n(check-sat)\n(get-value (a b))\n"));
    if vc_claim_query(cs, 1) != late { return 4; }
    if vc_claim_model_count(cs, 0) != 1 || vc_claim_model_count(cs, 1) != 2 { return 5; }
    let widths: Vec<i64> = vc_claim_model_widths(cs, 1);
    if widths.len() != 2 || widths[0] != VC_SORT_BOOL() || widths[1] != VC_SORT_BOOL() { return 6; }
    // Appending another command or assumption cannot change an earlier query.
    vc_script_declare_const(cs.header, String::from("last"), 64);
    cs.assumed.push(vc_tm_bool_const(cs.arena, true));
    if vc_claim_query(cs, 0) != early || vc_claim_query(cs, 1) != late { return 7; }
    0
}

fn check_header_and_delta() -> i64 {
    let cs: VcClaims = query_claims();
    if vc_claim_header_text(cs, 0) != early_header() { return 10; }
    if vc_claim_header_text(cs, 1) != late_header() { return 11; }
    let want: String = early_header();
    want.push_str(String::from("(assert a)\n"));
    if vc_claim_context_delta(cs, 0, 0, 0) != want { return 12; }
    if vc_claim_context_delta(cs, 1, 3, 1) != String::from("(declare-const b Bool)\n(define-fun x () Bool (not b))\n(assert b)\n") { return 13; }
    if vc_claim_context_delta(cs, 1, 5, 2) != String::from("") { return 14; }
    if vc_claim_context_delta(cs, 1, 5, 1) != String::from("(assert b)\n") { return 15; }
    if vc_claim_context_delta(cs, 0, 3, 0) != String::from("(assert a)\n") { return 16; }
    0
}

fn check_selected_and_independent_script() -> i64 {
    let cs: VcClaims = query_claims();
    let commands: Vec<i64> = Vec::new();
    commands.push(0);
    commands.push(1);
    commands.push(2);
    commands.push(3);
    commands.push(4);
    let assumptions: Vec<i64> = Vec::new();
    assumptions.push(1);
    let want: String = late_header();
    want.push_str(String::from("(assert b)\n(assert (not x))\n(check-sat)\n(get-value (a b))\n"));
    if vc_smt_render(cs.arena, vc_claim_script_selected(cs, 1, commands, assumptions)) != want { return 20; }
    let before: String = vc_claim_query(cs, 0);
    let context: SmtScript = vc_claim_context_script(cs, 0);
    vc_script_assert(context, vc_tm_bool_const(cs.arena, false));
    vc_script_check_sat(context);
    let hook: String = early_header();
    hook.push_str(String::from("(assert a)\n(assert false)\n(check-sat)\n"));
    if vc_smt_render(cs.arena, context) != hook { return 21; }
    if vc_claim_query(cs, 0) != before { return 22; }
    0
}

fn check_empty_model() -> i64 {
    let cs: VcClaims = empty_claims();
    let hdr: SmtScript = cs.header;
    cs.header_lens.push(hdr.kinds.len() as i64);
    cs.assumed_lens.push(0);
    cs.negated_goals.push(vc_tm_bool_const(cs.arena, false));
    if vc_claim_query(cs, 0) != String::from("(set-logic QF_BV)\n(set-option :produce-models true)\n(assert false)\n(check-sat)\n") { return 30; }
    0
}

// Recording captures both context prefixes and the diagnostic identity. Later
// appends must not turn a failing earlier obligation into a vacuous proof.
fn check_recorded_prefix() -> i64 {
    let cs: VcClaims = empty_claims();
    let ar: VcArena = cs.arena;
    let yes: i64 = vc_tm_bool_const(ar, true);
    let a: i64 = vc_tm_var(ar, String::from("a"));
    let b: i64 = vc_tm_var(ar, String::from("b"));
    vc_script_declare_const(cs.header, String::from("a"), VC_SORT_BOOL());
    vc_script_declare_const(cs.header, String::from("b"), VC_SORT_BOOL());
    vc_assume(cs, yes, a);
    vc_add_claim(cs, VC_CLAIM_ENSURES(), 41, String::from("post"), yes, b, 12, 8, 3);
    if cs.kinds.len() != 1 || cs.kinds[0] != VC_CLAIM_ENSURES() { return 40; }
    if cs.vow_ids[0] != 41 || cs.labels[0] != String::from("post") || cs.frames[0] != 3 { return 41; }
    if cs.ostarts[0] != 12 || cs.olens[0] != 8 { return 42; }
    let want: String = String::from("(set-logic QF_BV)\n(set-option :produce-models true)\n(declare-const a Bool)\n(declare-const b Bool)\n(assert a)\n(assert (not b))\n(check-sat)\n");
    if vc_claim_query(cs, 0) != want { return 43; }
    vc_script_declare_const(cs.header, String::from("later"), VC_SORT_BOOL());
    vc_assume(cs, yes, vc_tm_bool_const(ar, false));
    if vc_claim_query(cs, 0) != want { return 44; }
    0
}

// A guard is asked before it is assumed, and its assumption is conditional on
// the path reaching the instruction. Repeating that guard needs no new query.
fn check_guard_recording() -> i64 {
    let cs: VcClaims = empty_claims();
    let ar: VcArena = cs.arena;
    let pc: i64 = vc_tm_var(ar, String::from("path"));
    let goal: i64 = vc_tm_var(ar, String::from("safe"));
    vc_script_declare_const(cs.header, String::from("path"), VC_SORT_BOOL());
    vc_script_declare_const(cs.header, String::from("safe"), VC_SORT_BOOL());
    let inst: IrInst = mk_inst_const_i64(0, 0);
    inst.ostart = 17;
    inst.olen = 4;
    inst.ds = vc_frame_mark(2);
    vc_guard(cs, VC_CLAIM_DIV_ZERO(), String::from("guard"), pc, goal, inst);
    let want: String = String::from("(set-logic QF_BV)\n(set-option :produce-models true)\n(declare-const path Bool)\n(declare-const safe Bool)\n(assert (and path (not safe)))\n(check-sat)\n");
    if cs.kinds.len() != 1 || vc_claim_query(cs, 0) != want { return 50; }
    if cs.vow_ids[0] != -1 || cs.frames[0] != 2 || cs.ostarts[0] != 17 || cs.olens[0] != 4 { return 51; }
    if cs.assumed.len() != 1 { return 52; }
    vc_guard(cs, VC_CLAIM_DIV_ZERO(), String::from("again"), pc, goal, inst);
    if cs.kinds.len() != 1 || cs.assumed.len() != 2 { return 53; }
    let assumption: String = String::from("(or (not path) safe)");
    if vc_term_text(ar, cs.assumed[0]) != assumption || vc_term_text(ar, cs.assumed[1]) != assumption { return 54; }
    // An unconditional fact cannot be inferred from a guard on one path.
    vc_add_claim(cs, VC_CLAIM_ENSURES(), 9, String::from(""), vc_tm_bool_const(ar, true), goal, 0, 0, -1);
    if cs.kinds.len() != 2 || cs.assumed_lens[1] != 2 { return 55; }
    if vc_claim_query(cs, 0) != want { return 56; }
    0
}

fn check_recording_filters() -> i64 {
    let cs: VcClaims = empty_claims();
    let ar: VcArena = cs.arena;
    let yes: i64 = vc_tm_bool_const(ar, true);
    let no: i64 = vc_tm_bool_const(ar, false);
    let goal: i64 = vc_tm_var(ar, String::from("g"));
    vc_add_claim(cs, VC_CLAIM_ENSURES(), 1, String::from(""), yes, yes, 0, 0, -1);
    vc_add_claim(cs, VC_CLAIM_ENSURES(), 2, String::from(""), no, goal, 0, 0, -1);
    vc_assume(cs, yes, yes);
    if cs.kinds.len() != 0 || cs.assumed.len() != 0 { return 60; }
    cs.pre_only = true;
    let mut kind: i64 = 0;
    while kind <= VC_CLAIM_VEC_BOUNDS() {
        vc_add_claim(cs, kind, kind, String::from(""), yes, goal, 0, 0, -1);
        kind = kind + 1;
    }
    if cs.kinds.len() != 2 || cs.kinds[0] != VC_CLAIM_UNWIND() || cs.kinds[1] != VC_CLAIM_CALLER_PRE() { return 61; }
    // A claim alone adds no assumption, including an unwinding claim.
    if cs.assumed.len() != 0 { return 62; }
    cs.hyp_now = true;
    let inst: IrInst = mk_inst_const_i64(0, 0);
    vc_guard(cs, VC_CLAIM_CALLER_PRE(), String::from("hypothesis"), yes, goal, inst);
    if cs.kinds.len() != 2 || cs.assumed.len() != 1 { return 63; }
    cs.hyp_now = false;
    cs.pre_only = false;
    vc_add_claim(cs, VC_CLAIM_ENSURES(), 3, String::from(""), yes, goal, 0, 0, -1);
    if cs.kinds.len() != 2 { return 64; }
    // Demoting a guard still assumes it, just as a hypothesis guard does.
    cs.pre_only = true;
    vc_guard(cs, VC_CLAIM_ARITH(), String::from("demoted"), yes, no, inst);
    if cs.kinds.len() != 2 || cs.assumed.len() != 2 { return 65; }
    if !vc_tm_is_false(ar, cs.assumed[1]) { return 66; }
    0
}

fn check_recording_creation() -> i64 {
    let fr: VcFrames = vc_frames_new();
    fr.func_ids.push(17);
    let cs: VcClaims = vc_claims_new(fr, true, true);
    if !cs.pre_only || !cs.step || cs.hyp_now { return 70; }
    let kept: VcFrames = cs.fr;
    if kept.func_ids.len() != 1 || kept.func_ids[0] != 17 { return 71; }
    if vc_smt_render(cs.arena, cs.header) != String::from("(set-logic QF_BV)\n(set-option :produce-models true)\n") { return 72; }
    let raw: VcClaims = vc_claims_empty();
    if raw.header.kinds.len() != 0 || raw.pre_only || raw.step || raw.hyp_now { return 73; }
    vc_assume(cs, vc_tm_bool_const(cs.arena, true), vc_tm_bool_const(cs.arena, false));
    vc_script_declare_const(cs.header, String::from("only_this_store"), VC_SORT_BOOL());
    if raw.assumed.len() != 0 || raw.header.kinds.len() != 0 { return 74; }
    0
}

fn main() -> i32 {
    let mut r: i64 = check_full_and_context();
    if r == 0 { r = check_header_and_delta(); }
    if r == 0 { r = check_selected_and_independent_script(); }
    if r == 0 { r = check_empty_model(); }
    if r == 0 { r = check_recorded_prefix(); }
    if r == 0 { r = check_guard_recording(); }
    if r == 0 { r = check_recording_filters(); }
    if r == 0 { r = check_recording_creation(); }
    i64_to_i32_wrap(r)
}
