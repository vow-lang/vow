module TestRegion

use ir
use diag
use region
use tests.builders

// Per-function unit tests for `compiler/region.vow:infer_regions_module`.
// Mirror selected public-API tests from `vow-ir/src/region.rs`. Each test
// returns 0 on pass and a non-zero error code on failure. `main` runs them
// in order and exits with the first non-zero code; the harness reports the
// exit code in its JSON output. Check helpers return `i64` (not `i32`) to
// dodge a latent Cranelift codegen bug where `if call_returning_i32 == lit
// { i32_lit } else { i32_lit }` fails IR verification — irrelevant to the
// behaviour under test and easier to work around than fix here.

// Scan the flat store_effects encoding for an entry matching
// (target, AliasOf(aux)). Mirrors the cursor logic in
// `check_store_effects_at_call`. The encoding is variable-length: each
// effect starts with target, then constraint_kind; if AliasOf, an aux
// value follows; if AliasOfAny, a count + aux list follows.
fn has_alias_of_effect(flat: Vec<i64>, target: i64, aux: i64) -> bool {
    let mut i: u64 = 0;
    while i < flat.len() {
        let t: i64 = flat[i];
        i = i + 1;
        if i >= flat.len() { return false; }
        let kind: i64 = flat[i];
        i = i + 1;
        if kind == RSUM_KIND_ALIAS_OF() {
            if i >= flat.len() { return false; }
            let a: i64 = flat[i];
            i = i + 1;
            if t == target && a == aux {
                return true;
            }
        } else if kind == RSUM_KIND_ALIAS_OF_ANY() {
            if i >= flat.len() { return false; }
            let n: i64 = flat[i];
            i = i + 1;
            let mut ai: i64 = 0;
            while ai < n && i < flat.len() {
                i = i + 1;
                ai = ai + 1;
            }
        }
    }
    false
}

// Mirrors `returning_element_from_fresh_string_split_lifts_split_to_caller_region`
// (vow-ir/src/region.rs:6388). A function returning a Vec element reached via
// `__vow_vec_get_val` from a fresh `__vow_string_split` result must lift the
// split allocation to caller region and publish `FreshInCaller`.
fn check_split_element_lifts_to_caller() -> i64 {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_arg(0, ITY_PTR(), 0));
    insts.push(mk_inst_arg(1, ITY_PTR(), 1));
    let split_args: Vec<i64> = Vec::new();
    split_args.push(0);
    split_args.push(1);
    insts.push(mk_inst_call_extern(2, ITY_PTR(), split_args, String::from("__vow_string_split")));
    insts.push(mk_inst_const_i64(3, 0));
    let get_args: Vec<i64> = Vec::new();
    get_args.push(2);
    get_args.push(3);
    insts.push(mk_inst_call_extern(4, ITY_I64(), get_args, String::from("__vow_vec_get_val")));
    insts.push(mk_inst_return(5, 4));

    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, insts));
    let params: Vec<i64> = Vec::new();
    params.push(ITY_PTR());
    params.push(ITY_PTR());
    let funcs: Vec<IrFunction> = Vec::new();
    funcs.push(mk_function(0, String::from("first_split_part"), params, ITY_PTR(), blocks));

    let m: IrModule = mk_module(funcs);
    let dctx: DiagCtx = diag_ctx_new();
    let result: IrModule = infer_regions_module(m, dctx);

    let expected_region: i64 = region_pack(REGION_KIND_CALLER(), 0);
    let got_region: i64 = result.functions[0].blocks[0].insts[2].rgn;
    if got_region != expected_region {
        return 1;
    }
    if result.functions[0].rsum_return_kind != RSUM_KIND_FRESH_IN_CALLER() {
        return 2;
    }
    0
}

// Mirrors `string_substring_return_allocates_in_caller_region`
// (vow-ir/src/region.rs:6432). A returned `__vow_string_substring` result
// must be caller-region allocated; the summary must publish `FreshInCaller`.
fn check_substring_returns_in_caller_region() -> i64 {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_arg(0, ITY_PTR(), 0));
    insts.push(mk_inst_const_i64(1, 0));
    insts.push(mk_inst_const_i64(2, 1));
    let sub_args: Vec<i64> = Vec::new();
    sub_args.push(0);
    sub_args.push(1);
    sub_args.push(2);
    insts.push(mk_inst_call_extern(3, ITY_PTR(), sub_args, String::from("__vow_string_substring")));
    insts.push(mk_inst_return(4, 3));

    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, insts));
    let params: Vec<i64> = Vec::new();
    params.push(ITY_PTR());
    let funcs: Vec<IrFunction> = Vec::new();
    funcs.push(mk_function(0, String::from("slice_string"), params, ITY_PTR(), blocks));

    let m: IrModule = mk_module(funcs);
    let dctx: DiagCtx = diag_ctx_new();
    let result: IrModule = infer_regions_module(m, dctx);

    let expected_region: i64 = region_pack(REGION_KIND_CALLER(), 0);
    let got_region: i64 = result.functions[0].blocks[0].insts[3].rgn;
    if got_region != expected_region {
        return 3;
    }
    if result.functions[0].rsum_return_kind != RSUM_KIND_FRESH_IN_CALLER() {
        return 4;
    }
    0
}

fn check_parse_i64_option_returns_in_caller_region() -> i64 {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_arg(0, ITY_PTR(), 0));
    let parse_args: Vec<i64> = Vec::new();
    parse_args.push(0);
    insts.push(mk_inst_call_extern(1, ITY_PTR(), parse_args, String::from("__vow_string_parse_i64_opt")));
    insts.push(mk_inst_return(2, 1));

    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, insts));
    let params: Vec<i64> = Vec::new();
    params.push(ITY_PTR());
    let funcs: Vec<IrFunction> = Vec::new();
    funcs.push(mk_function(0, String::from("parse"), params, ITY_PTR(), blocks));

    let dctx: DiagCtx = diag_ctx_new();
    let result: IrModule = infer_regions_module(mk_module(funcs), dctx);
    let expected_region: i64 = region_pack(REGION_KIND_CALLER(), 0);
    if result.functions[0].blocks[0].insts[1].rgn != expected_region {
        return 6;
    }
    if result.functions[0].rsum_return_kind != RSUM_KIND_FRESH_IN_CALLER() {
        return 7;
    }
    0
}

// Mirrors `returned_try_conversion_option_allocates_in_caller_region`
// (vow-ir/src/region.rs). `_try` narrowing conversions build a fresh Option
// cell, so a returned one is heap-producing and outlives the callee.
fn check_try_conversion_option_returns_in_caller_region() -> i64 {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_arg(0, ITY_I64(), 0));
    let try_args: Vec<i64> = Vec::new();
    try_args.push(0);
    insts.push(mk_inst_call_extern(1, ITY_PTR(), try_args, String::from("__vow_i64_to_u8_try")));
    insts.push(mk_inst_return(2, 1));

    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, insts));
    let params: Vec<i64> = Vec::new();
    params.push(ITY_I64());
    let funcs: Vec<IrFunction> = Vec::new();
    funcs.push(mk_function(0, String::from("narrow"), params, ITY_PTR(), blocks));

    let dctx: DiagCtx = diag_ctx_new();
    let result: IrModule = infer_regions_module(mk_module(funcs), dctx);
    if result.functions[0].blocks[0].insts[1].rgn != region_pack(REGION_KIND_CALLER(), 0) {
        return 1;
    }
    if result.functions[0].rsum_return_kind != RSUM_KIND_FRESH_IN_CALLER() {
        return 2;
    }
    0
}

// Mirrors `btreemap_lookup_options_split_by_escape` (vow-ir/src/region.rs):
// the returned lookup result belongs to the caller; the map, the insert result
// and an unused lookup result die with the block.
fn check_btreemap_lookup_options_split_by_escape() -> i64 {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_arg(0, ITY_I64(), 0));
    insts.push(mk_inst_call_extern(1, ITY_PTR(), Vec::new(), String::from("__vow_btreemap_new")));
    let insert_args: Vec<i64> = Vec::new();
    insert_args.push(1);
    insert_args.push(0);
    insert_args.push(0);
    insts.push(mk_inst_call_extern(2, ITY_PTR(), insert_args, String::from("__vow_btreemap_insert")));
    let get_args: Vec<i64> = Vec::new();
    get_args.push(1);
    get_args.push(0);
    insts.push(mk_inst_call_extern(3, ITY_PTR(), get_args, String::from("__vow_btreemap_get")));
    let get_args2: Vec<i64> = Vec::new();
    get_args2.push(1);
    get_args2.push(0);
    insts.push(mk_inst_call_extern(4, ITY_PTR(), get_args2, String::from("__vow_btreemap_get")));
    insts.push(mk_inst_return(5, 3));

    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, insts));
    let params: Vec<i64> = Vec::new();
    params.push(ITY_I64());
    let funcs: Vec<IrFunction> = Vec::new();
    funcs.push(mk_function(0, String::from("lookup"), params, ITY_PTR(), blocks));

    let dctx: DiagCtx = diag_ctx_new();
    let result: IrModule = infer_regions_module(mk_module(funcs), dctx);
    let rinsts: Vec<IrInst> = result.functions[0].blocks[0].insts;
    if rinsts[3].rgn != region_pack(REGION_KIND_CALLER(), 0) {
        return 1;
    }
    if region_kind(rinsts[1].rgn) != REGION_KIND_BLOCK() {
        return 2;
    }
    if region_kind(rinsts[2].rgn) != REGION_KIND_BLOCK() {
        return 3;
    }
    if region_kind(rinsts[4].rgn) != REGION_KIND_BLOCK() {
        return 4;
    }
    0
}

// Mirrors `returned_fresh_runtime_aggregates_allocate_in_caller_region` and
// `unescaped_fresh_runtime_aggregates_are_block_owned` (vow-ir/src/region.rs)
// for one String-, one Vec- and one zero-argument builtin each.
fn fresh_call_region(sym: String, arity: i64, returned: bool) -> i64 {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_arg(0, ITY_PTR(), 0));
    let args: Vec<i64> = Vec::new();
    let mut ai: i64 = 0;
    while ai < arity {
        args.push(ai);
        ai = ai + 1;
    }
    insts.push(mk_inst_call_extern(1, ITY_PTR(), args, sym));
    if returned {
        insts.push(mk_inst_return(2, 1));
    } else {
        insts.push(mk_inst_return(2, 0));
    }
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, insts));
    let params: Vec<i64> = Vec::new();
    params.push(ITY_PTR());
    let funcs: Vec<IrFunction> = Vec::new();
    funcs.push(mk_function(0, String::from("fresh"), params, ITY_PTR(), blocks));
    let dctx: DiagCtx = diag_ctx_new();
    let result: IrModule = infer_regions_module(mk_module(funcs), dctx);
    result.functions[0].blocks[0].insts[1].rgn
}

fn check_fresh_runtime_aggregates_follow_escape() -> i64 {
    let caller: i64 = region_pack(REGION_KIND_CALLER(), 0);
    if fresh_call_region(String::from("__vow_fs_read"), 1, true) != caller { return 1; }
    if fresh_call_region(String::from("__vow_vec_sort"), 1, true) != caller { return 2; }
    if fresh_call_region(String::from("__vow_args"), 0, true) != caller { return 3; }
    if fresh_call_region(String::from("__vow_fs_listdir"), 1, true) != caller { return 4; }
    if region_kind(fresh_call_region(String::from("__vow_fs_read"), 1, false)) != REGION_KIND_BLOCK() { return 5; }
    if region_kind(fresh_call_region(String::from("__vow_hex_encode"), 1, false)) != REGION_KIND_BLOCK() { return 6; }
    0
}

// Mirrors `internal_call_republishes_callee_store_effect_for_parameter_target`
// (vow-ir/src/region.rs:6469). A wrapper that forwards its parameters to an
// internal callee (which pushes arg1 into arg0 via `__vow_vec_push_val`)
// must republish the callee's store effect — emitting `AliasOf(1)` source
// for target 0 in the wrapper's own summary.
fn check_wrapper_republishes_callee_store_effect() -> i64 {
    let callee_insts: Vec<IrInst> = Vec::new();
    callee_insts.push(mk_inst_arg(0, ITY_PTR(), 0));
    callee_insts.push(mk_inst_arg(1, ITY_PTR(), 1));
    let push_args: Vec<i64> = Vec::new();
    push_args.push(0);
    push_args.push(1);
    callee_insts.push(mk_inst_call_extern(2, ITY_UNIT(), push_args, String::from("__vow_vec_push_val")));
    let ret_args: Vec<i64> = Vec::new();
    callee_insts.push(ir_inst_new(3, IOP_RETURN(), ITY_UNIT(), ret_args, IDATA_NONE(), 0, 0, String::from("")));

    let callee_blocks: Vec<IrBlock> = Vec::new();
    callee_blocks.push(mk_block(0, callee_insts));
    let callee_params: Vec<i64> = Vec::new();
    callee_params.push(ITY_PTR());
    callee_params.push(ITY_PTR());
    let callee: IrFunction = mk_function(0, String::from("push_arg"), callee_params, ITY_UNIT(), callee_blocks);

    let wrapper_insts: Vec<IrInst> = Vec::new();
    wrapper_insts.push(mk_inst_arg(10, ITY_PTR(), 0));
    wrapper_insts.push(mk_inst_arg(11, ITY_PTR(), 1));
    let call_args: Vec<i64> = Vec::new();
    call_args.push(10);
    call_args.push(11);
    wrapper_insts.push(mk_inst_call_target(12, ITY_UNIT(), call_args, 0));
    let wret_args: Vec<i64> = Vec::new();
    wrapper_insts.push(ir_inst_new(13, IOP_RETURN(), ITY_UNIT(), wret_args, IDATA_NONE(), 0, 0, String::from("")));

    let wrapper_blocks: Vec<IrBlock> = Vec::new();
    wrapper_blocks.push(mk_block(0, wrapper_insts));
    let wrapper_params: Vec<i64> = Vec::new();
    wrapper_params.push(ITY_PTR());
    wrapper_params.push(ITY_PTR());
    let wrapper: IrFunction = mk_function(1, String::from("wrapper"), wrapper_params, ITY_UNIT(), wrapper_blocks);

    let funcs: Vec<IrFunction> = Vec::new();
    funcs.push(callee);
    funcs.push(wrapper);

    let m: IrModule = mk_module(funcs);
    let dctx: DiagCtx = diag_ctx_new();
    let result: IrModule = infer_regions_module(m, dctx);

    let flat: Vec<i64> = result.functions[1].rsum_store_effects;
    if !has_alias_of_effect(flat, 0, 1) {
        return 5;
    }
    0
}

// `push_fresh(s)`: pushes a fresh Vec into the container `s.items`, a
// projection of its parameter. Its summary stores FreshInCaller into param 0.
fn mk_push_fresh_callee() -> IrFunction {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_arg(0, ITY_PTR(), 0));
    let fg_args: Vec<i64> = Vec::new();
    fg_args.push(0);
    insts.push(ir_inst_new(1, IOP_FIELD_GET(), ITY_I64(), fg_args, IDATA_FIELD(), 0, 0, String::from("")));
    insts.push(mk_inst_call_extern(2, ITY_PTR(), Vec::new(), String::from("__vow_vec_new_val")));
    let push_args: Vec<i64> = Vec::new();
    push_args.push(1);
    push_args.push(2);
    insts.push(mk_inst_call_extern(3, ITY_UNIT(), push_args, String::from("__vow_vec_push_val")));
    insts.push(ir_inst_new(4, IOP_RETURN(), ITY_UNIT(), Vec::new(), IDATA_NONE(), 0, 0, String::from("")));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, insts));
    let params: Vec<i64> = Vec::new();
    params.push(ITY_PTR());
    mk_function(0, String::from("push_fresh"), params, ITY_UNIT(), blocks)
}

fn mk_region_alloc(id: i64) -> IrInst {
    ir_inst_new(id, IOP_REGION_ALLOC(), ITY_PTR(), Vec::new(), IDATA_ALLOC_SIZE(), 16, 8, String::from(""))
}

fn mk_field_set(id: i64, target: i64, source: i64) -> IrInst {
    let args: Vec<i64> = Vec::new();
    args.push(target);
    args.push(source);
    ir_inst_new(id, IOP_FIELD_SET(), ITY_UNIT(), args, IDATA_FIELD(), 0, 0, String::from(""))
}

fn mk_field_get(id: i64, base: i64) -> IrInst {
    let args: Vec<i64> = Vec::new();
    args.push(base);
    ir_inst_new(id, IOP_FIELD_GET(), ITY_I64(), args, IDATA_FIELD(), 0, 0, String::from(""))
}

fn mk_jump(id: i64, target: i64) -> IrInst {
    ir_inst_new(id, IOP_JUMP(), ITY_UNIT(), Vec::new(), IDATA_JUMP_TARGET(), target, 0, String::from(""))
}

fn mk_return_unit(id: i64) -> IrInst {
    ir_inst_new(id, IOP_RETURN(), ITY_UNIT(), Vec::new(), IDATA_NONE(), 0, 0, String::from(""))
}

fn mk_vec_push_val(id: i64, vec_id: i64, value_id: i64) -> IrInst {
    let args: Vec<i64> = Vec::new();
    args.push(vec_id);
    args.push(value_id);
    mk_inst_call_extern(id, ITY_UNIT(), args, String::from("__vow_vec_push_val"))
}

fn infer_one(funcs: Vec<IrFunction>) -> IrModule {
    let dctx: DiagCtx = diag_ctx_new();
    infer_regions_module(mk_module(funcs), dctx)
}

// `x = Vec::new(); { s = Sink { items: x }; push_fresh(s); } [return x]` with
// `s` declared in a nested block. Returns the region inferred for `s`.
fn holder_around_outer_container(returns_outer: bool) -> i64 {
    let b0: Vec<IrInst> = Vec::new();
    b0.push(mk_inst_call_extern(10, ITY_PTR(), Vec::new(), String::from("__vow_vec_new_val")));
    b0.push(mk_jump(20, 1));
    let b1: Vec<IrInst> = Vec::new();
    b1.push(mk_region_alloc(11));
    b1.push(mk_field_set(12, 11, 10));
    let call_args: Vec<i64> = Vec::new();
    call_args.push(11);
    b1.push(mk_inst_call_target(13, ITY_UNIT(), call_args, 0));
    if returns_outer {
        b1.push(mk_inst_return(14, 10));
    } else {
        b1.push(mk_return_unit(14));
    }
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, b0));
    blocks.push(mk_block(1, b1));
    let funcs: Vec<IrFunction> = Vec::new();
    funcs.push(mk_push_fresh_callee());
    funcs.push(mk_function(1, String::from("caller"), Vec::new(), if returns_outer { ITY_PTR() } else { ITY_UNIT() }, blocks));
    let result: IrModule = infer_one(funcs);
    result.functions[1].blocks[1].insts[0].rgn
}

// Mirrors `effect_target_holder_outlives_the_container_it_wraps`: the callee
// stores into the returned container through the holder, so the holder (whose
// arena the callee receives) must outlive that container.
fn check_effect_target_holder_outlives_wrapped_container() -> i64 {
    if holder_around_outer_container(true) != region_pack(REGION_KIND_CALLER(), 0) { return 1; }
    0
}

// Mirrors `effect_target_holder_widens_to_the_wrapped_container_region`.
fn check_effect_target_holder_widens_to_container_region() -> i64 {
    if holder_around_outer_container(false) != region_pack(REGION_KIND_BLOCK(), 0) { return 1; }
    0
}

// Mirrors `holder_without_store_effect_call_stays_block_local`.
fn check_holder_without_store_effect_stays_block_local() -> i64 {
    let b0: Vec<IrInst> = Vec::new();
    b0.push(mk_inst_call_extern(10, ITY_PTR(), Vec::new(), String::from("__vow_vec_new_val")));
    b0.push(mk_jump(20, 1));
    let b1: Vec<IrInst> = Vec::new();
    b1.push(mk_region_alloc(11));
    b1.push(mk_field_set(12, 11, 10));
    b1.push(mk_return_unit(13));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, b0));
    blocks.push(mk_block(1, b1));
    let funcs: Vec<IrFunction> = Vec::new();
    funcs.push(mk_function(0, String::from("caller"), Vec::new(), ITY_UNIT(), blocks));
    let result: IrModule = infer_one(funcs);
    if result.functions[0].blocks[1].insts[0].rgn != region_pack(REGION_KIND_BLOCK(), 1) { return 1; }
    0
}

// Mirrors `effect_target_projection_widens_its_base_not_the_projection`.
fn check_effect_target_projection_widens_its_base() -> i64 {
    let b0: Vec<IrInst> = Vec::new();
    b0.push(mk_inst_call_extern(10, ITY_PTR(), Vec::new(), String::from("__vow_vec_new_val")));
    b0.push(mk_jump(20, 1));
    let b1: Vec<IrInst> = Vec::new();
    b1.push(mk_region_alloc(11));
    b1.push(mk_field_set(12, 11, 10));
    b1.push(mk_field_get(13, 11));
    let call_args: Vec<i64> = Vec::new();
    call_args.push(13);
    b1.push(mk_inst_call_target(14, ITY_UNIT(), call_args, 0));
    b1.push(mk_inst_return(15, 10));
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, b0));
    blocks.push(mk_block(1, b1));
    let funcs: Vec<IrFunction> = Vec::new();
    funcs.push(mk_push_fresh_callee());
    funcs.push(mk_function(1, String::from("caller"), Vec::new(), ITY_PTR(), blocks));
    let result: IrModule = infer_one(funcs);
    if result.functions[1].blocks[1].insts[0].rgn != region_pack(REGION_KIND_CALLER(), 0) { return 1; }
    0
}

// `x = Vec::new(); s = Sink { items: x }; s.items.push(fresh) [; return x]`.
// Returns the region inferred for the pushed value.
fn push_through_local_projection(returns_outer: bool) -> i64 {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_call_extern(0, ITY_PTR(), Vec::new(), String::from("__vow_vec_new_val")));
    insts.push(mk_region_alloc(1));
    insts.push(mk_field_set(2, 1, 0));
    insts.push(mk_field_get(3, 1));
    insts.push(mk_inst_call_extern(4, ITY_PTR(), Vec::new(), String::from("__vow_vec_new_val")));
    insts.push(mk_vec_push_val(5, 3, 4));
    if returns_outer {
        insts.push(mk_inst_return(6, 0));
    } else {
        insts.push(mk_return_unit(6));
    }
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, insts));
    let funcs: Vec<IrFunction> = Vec::new();
    funcs.push(mk_function(0, String::from("local_push"), Vec::new(), if returns_outer { ITY_PTR() } else { ITY_UNIT() }, blocks));
    let result: IrModule = infer_one(funcs);
    result.functions[0].blocks[0].insts[4].rgn
}

// Mirrors `push_through_local_projection_is_owned_by_the_base_not_root` and
// `push_through_local_projection_of_a_dying_holder_is_block_local`.
fn check_push_through_local_projection_is_owned_by_base() -> i64 {
    if push_through_local_projection(true) != region_pack(REGION_KIND_CALLER(), 0) { return 1; }
    if region_kind(push_through_local_projection(false)) != REGION_KIND_BLOCK() { return 2; }
    0
}

// Mirrors `push_through_alias_returning_accessor_is_a_store_into_the_argument`:
// `items(s)` returns an alias of its argument, so `items(s).push(fresh)` stores
// into parameter 0 and the pushed value lives in that parameter's hidden arena.
fn check_push_through_alias_accessor_targets_the_argument() -> i64 {
    let a_insts: Vec<IrInst> = Vec::new();
    a_insts.push(mk_inst_arg(0, ITY_PTR(), 0));
    a_insts.push(mk_field_get(1, 0));
    a_insts.push(mk_inst_return(2, 1));
    let a_blocks: Vec<IrBlock> = Vec::new();
    a_blocks.push(mk_block(0, a_insts));
    let a_params: Vec<i64> = Vec::new();
    a_params.push(ITY_PTR());
    let accessor: IrFunction = mk_function(0, String::from("items"), a_params, ITY_PTR(), a_blocks);

    let f_insts: Vec<IrInst> = Vec::new();
    f_insts.push(mk_inst_arg(10, ITY_PTR(), 0));
    let call_args: Vec<i64> = Vec::new();
    call_args.push(10);
    f_insts.push(mk_inst_call_target(11, ITY_I64(), call_args, 0));
    f_insts.push(mk_inst_call_extern(12, ITY_PTR(), Vec::new(), String::from("__vow_vec_new_val")));
    f_insts.push(mk_vec_push_val(13, 11, 12));
    f_insts.push(mk_return_unit(14));
    let f_blocks: Vec<IrBlock> = Vec::new();
    f_blocks.push(mk_block(0, f_insts));
    let f_params: Vec<i64> = Vec::new();
    f_params.push(ITY_PTR());
    let pusher: IrFunction = mk_function(1, String::from("f"), f_params, ITY_UNIT(), f_blocks);

    let funcs: Vec<IrFunction> = Vec::new();
    funcs.push(accessor);
    funcs.push(pusher);
    let result: IrModule = infer_one(funcs);
    if result.functions[1].blocks[0].insts[2].rgn != region_pack(REGION_KIND_CALLER(), 0) { return 1; }
    0
}

// `f(x) { s = Sink { items: x }; push_fresh(s); [return s] }`: the region
// inferred for `s`.
fn holder_of_parameter_container(returns_holder: bool) -> i64 {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_arg(10, ITY_PTR(), 0));
    insts.push(mk_region_alloc(11));
    insts.push(mk_field_set(12, 11, 10));
    let call_args: Vec<i64> = Vec::new();
    call_args.push(11);
    insts.push(mk_inst_call_target(13, ITY_UNIT(), call_args, 0));
    if returns_holder {
        insts.push(mk_inst_return(14, 11));
    } else {
        insts.push(mk_return_unit(14));
    }
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, insts));
    let params: Vec<i64> = Vec::new();
    params.push(ITY_PTR());
    let funcs: Vec<IrFunction> = Vec::new();
    funcs.push(mk_push_fresh_callee());
    funcs.push(mk_function(1, String::from("f"), params, if returns_holder { ITY_PTR() } else { ITY_UNIT() }, blocks));
    let result: IrModule = infer_one(funcs);
    result.functions[1].blocks[0].insts[1].rgn
}

// Mirrors `block_local_holder_of_a_parameter_container_goes_to_the_root_arena`
// and `escaping_holder_of_a_parameter_container_keeps_its_caller_region`.
fn check_holder_of_parameter_container() -> i64 {
    if holder_of_parameter_container(false) != region_root() { return 1; }
    if holder_of_parameter_container(true) != region_pack(REGION_KIND_CALLER(), 0) { return 2; }
    0
}

fn main() -> i32 {
    let r1: i64 = check_split_element_lifts_to_caller();
    if r1 != 0 { return i64_to_i32_wrap(r1); }
    let r2: i64 = check_substring_returns_in_caller_region();
    if r2 != 0 { return i64_to_i32_wrap(r2); }
    let r3: i64 = check_wrapper_republishes_callee_store_effect();
    if r3 != 0 { return i64_to_i32_wrap(r3); }
    let r4: i64 = check_parse_i64_option_returns_in_caller_region();
    if r4 != 0 { return i64_to_i32_wrap(r4); }
    let r5: i64 = check_try_conversion_option_returns_in_caller_region();
    if r5 != 0 { return i64_to_i32_wrap(100 + r5); }
    let r6: i64 = check_btreemap_lookup_options_split_by_escape();
    if r6 != 0 { return i64_to_i32_wrap(200 + r6); }
    let r7: i64 = check_fresh_runtime_aggregates_follow_escape();
    if r7 != 0 { return i64_to_i32_wrap(300 + r7); }
    let r8: i64 = check_effect_target_holder_outlives_wrapped_container();
    if r8 != 0 { return i64_to_i32_wrap(400 + r8); }
    let r9: i64 = check_effect_target_holder_widens_to_container_region();
    if r9 != 0 { return i64_to_i32_wrap(500 + r9); }
    let r10: i64 = check_holder_without_store_effect_stays_block_local();
    if r10 != 0 { return i64_to_i32_wrap(600 + r10); }
    let r11: i64 = check_effect_target_projection_widens_its_base();
    if r11 != 0 { return i64_to_i32_wrap(700 + r11); }
    let r12: i64 = check_push_through_local_projection_is_owned_by_base();
    if r12 != 0 { return i64_to_i32_wrap(800 + r12); }
    let r13: i64 = check_push_through_alias_accessor_targets_the_argument();
    if r13 != 0 { return i64_to_i32_wrap(900 + r13); }
    let r14: i64 = check_holder_of_parameter_container();
    if r14 != 0 { return i64_to_i32_wrap(1000 + r14); }
    0
}
