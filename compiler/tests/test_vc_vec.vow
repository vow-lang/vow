module TestVcVec

use ir
use vc_ops
use vc_term
use vc_smt
use vc_gate
use vc_exec
use verifier
use tests.builders

fn args1(a: i64) -> Vec<i64> {
    let v: Vec<i64> = Vec::new();
    v.push(a);
    v
}

fn args2(a: i64, b: i64) -> Vec<i64> {
    let v: Vec<i64> = args1(a);
    v.push(b);
    v
}

fn args3(a: i64, b: i64, c: i64) -> Vec<i64> {
    let v: Vec<i64> = args2(a, b);
    v.push(c);
    v
}

fn ptr_u64_params() -> Vec<i64> {
    let p: Vec<i64> = Vec::new();
    p.push(ITY_PTR());
    p.push(ITY_U64());
    p
}

fn one_block(params: Vec<i64>, ret: i64, insts: Vec<IrInst>) -> IrFunction {
    let blocks: Vec<IrBlock> = Vec::new();
    blocks.push(mk_block(0, insts));
    mk_function(1, String::from("f"), params, ret, blocks)
}

fn contains(hay: String, needle: String) -> bool {
    str_find_str(hay, needle) >= 0
}

fn render(cs: VcClaims, k: u64) -> String {
    vc_smt_render(cs.arena, vc_claim_script(cs, k))
}

// fn f(v: Vec<i64>, i: u64) -> i64 { v[i] }
fn param_get() -> IrFunction {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_arg(0, ITY_PTR(), 0));
    insts.push(mk_inst_arg(1, ITY_U64(), 1));
    insts.push(mk_inst_call_extern(2, ITY_I64(), args2(0, 1), String::from("__vow_vec_get_val")));
    insts.push(mk_inst_return(3, 2));
    one_block(ptr_u64_params(), ITY_I64(), insts)
}

// fn f(v: Vec<i64>, i: u64) -> i64 { v.push(1); v[i] }
fn param_push_get() -> IrFunction {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_arg(0, ITY_PTR(), 0));
    insts.push(mk_inst_arg(1, ITY_U64(), 1));
    insts.push(mk_inst_const_i64(2, 1));
    insts.push(mk_inst_call_extern(3, ITY_UNIT(), args2(0, 2), String::from("__vow_vec_push_val")));
    insts.push(mk_inst_call_extern(4, ITY_I64(), args2(0, 1), String::from("__vow_vec_get_val")));
    insts.push(mk_inst_return(5, 4));
    one_block(ptr_u64_params(), ITY_I64(), insts)
}

// A parameter's length has no capacity: its one assumption is the runtime's
// representation invariant (below `VOW_CAP_VALUE_MASK`), and the bounds claim
// compares the index against the length symbol itself.
fn check_param_length_is_unconstrained() -> i64 {
    let f: IrFunction = param_get();
    if vc_skip_reason(f).len() != 0 { return 1; }
    let cs: VcClaims = vc_claims(f);
    if cs.kinds.len() != 1 { return 2; }
    if cs.kinds[0] != VC_CLAIM_VEC_BOUNDS() { return 3; }
    if cs.labels[0] != VC_LABEL_VEC_BOUNDS() { return 4; }
    if cs.assumed_lens[0] != 1 { return 5; }
    if vc_term_text(cs.arena, cs.assumed[0]) != String::from("(bvult p0_vlen #x7fffffffffffffff)") { return 11; }
    let hdr: SmtScript = cs.header;
    if hdr.names[0] != String::from("QF_ABV") { return 6; }
    let q: String = render(cs, 0);
    if !contains(q, String::from("(declare-const p0_vlen (_ BitVec 64))")) { return 7; }
    if !contains(q, String::from("(declare-const p0_varr (Array (_ BitVec 64) (_ BitVec 64)))")) { return 8; }
    if !contains(q, String::from("(bvult p1 p0_vlen)")) { return 9; }
    if contains(q, String::from("bvule")) { return 10; }
    0
}

// A push assumes only that the new length stays within the representation
// invariant: besides the invariant of the parameter itself, no bound on the
// length is introduced.
fn check_push_assumes_only_the_invariant() -> i64 {
    let f: IrFunction = param_push_get();
    if vc_skip_reason(f).len() != 0 { return 20; }
    let cs: VcClaims = vc_claims(f);
    if cs.kinds.len() != 1 { return 21; }
    if cs.assumed_lens[0] != 2 { return 22; }
    let got: String = vc_term_text(cs.arena, cs.assumed[1]);
    if got != String::from("(bvult p0_vlen #x7ffffffffffffffe)") { return 23; }
    let q: String = render(cs, 0);
    if !contains(q, String::from("(store p0_varr p0_vlen")) { return 24; }
    if !contains(q, String::from("(bvadd p0_vlen #x0000000000000001)")) { return 25; }
    0
}

// let v = Vec::new(); v.push(1); v.push(2); return v.len()
fn local_two_pushes() -> IrFunction {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_const_i64(0, 8));
    insts.push(mk_inst_const_i64(1, 8));
    insts.push(mk_inst_call_extern(2, ITY_PTR(), args2(0, 1), String::from("__vow_vec_new")));
    insts.push(mk_inst_const_i64(3, 1));
    insts.push(mk_inst_call_extern(4, ITY_UNIT(), args2(2, 3), String::from("__vow_vec_push_val")));
    insts.push(mk_inst_call_extern(5, ITY_UNIT(), args2(2, 3), String::from("__vow_vec_push_val")));
    insts.push(mk_inst_call_extern(6, ITY_U64(), args1(2), String::from("__vow_vec_len")));
    insts.push(mk_inst_return(7, 6));
    one_block(Vec::new(), ITY_U64(), insts)
}

// A new Vec starts empty and only the pushes change its length; the two push
// guards compare a concrete length, so they fold away: no claim and no
// assumption.
fn check_local_vec_length() -> i64 {
    let f: IrFunction = local_two_pushes();
    if vc_skip_reason(f).len() != 0 { return 30; }
    let cs: VcClaims = vc_claims(f);
    if cs.kinds.len() != 0 { return 31; }
    if cs.assumed.len() != 0 { return 32; }
    let hdr: SmtScript = cs.header;
    if hdr.names[0] != String::from("QF_ABV") { return 33; }
    0
}

// let v = Vec::new(); <havoc v>; return v[0]
fn havoc_then_get() -> IrFunction {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_const_i64(0, 8));
    insts.push(mk_inst_const_i64(1, 8));
    insts.push(mk_inst_call_extern(2, ITY_PTR(), args2(0, 1), String::from("__vow_vec_new")));
    insts.push(mk_inst_call_extern(3, ITY_UNIT(), args1(2), VC_INTERNAL_HAVOC_VEC()));
    insts.push(mk_inst_const_i64(4, 0));
    insts.push(mk_inst_call_extern(5, ITY_I64(), args2(2, 4), String::from("__vow_vec_get_val")));
    insts.push(mk_inst_return(6, 5));
    one_block(Vec::new(), ITY_I64(), insts)
}

// A havoc marker forgets the empty length of a new Vec: the bounds claim of the
// read at 0 is no longer a constant failure but depends on a fresh length symbol
// that is only known to sit below the representation mask.
fn check_havoc_forgets_length() -> i64 {
    let f: IrFunction = havoc_then_get();
    let cs: VcClaims = vc_claims(f);
    if cs.kinds.len() != 1 || cs.kinds[0] != VC_CLAIM_VEC_BOUNDS() { return 40; }
    let q: String = render(cs, 0);
    if !contains(q, String::from("(declare-const vh1_vlen (_ BitVec 64))")) { return 41; }
    if !contains(q, String::from("(declare-const vh1_varr (Array (_ BitVec 64) (_ BitVec 64)))")) { return 42; }
    if !contains(q, String::from("(bvult #x0000000000000000 vh1_vlen)")) { return 43; }
    if !contains(q, String::from("(bvult vh1_vlen #x7fffffffffffffff)")) { return 44; }
    0
}

// A function without a Vec keeps the plain bit-vector logic.
fn check_no_vec_stays_bit_vector() -> i64 {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_arg(0, ITY_I64(), 0));
    insts.push(mk_inst_return(1, 0));
    let p: Vec<i64> = Vec::new();
    p.push(ITY_I64());
    let cs: VcClaims = vc_claims(one_block(p, ITY_I64(), insts));
    let hdr: SmtScript = cs.header;
    if hdr.names[0] != String::from("QF_BV") { return 40; }
    0
}

// A Vec call spliced from a callee carries its frame in `dv2`, like the unwrap
// abort, so its bounds claim is attributed to that frame.
fn check_frame_travels_in_dv2() -> i64 {
    let get: IrInst = mk_inst_call_extern(2, ITY_I64(), args2(0, 1), String::from("__vow_vec_get_val"));
    if vc_frame_of(get) != -1 { return 50; }
    get.dv2 = 4;
    if vc_frame_of(get) != 3 { return 51; }
    let len: IrInst = mk_inst_call_extern(3, ITY_U64(), args1(0), String::from("__vow_vec_len"));
    len.dv2 = 4;
    if vc_frame_of(len) != -1 { return 52; }
    0
}

fn two_ptr_params() -> Vec<i64> {
    let p: Vec<i64> = Vec::new();
    p.push(ITY_PTR());
    p.push(ITY_PTR());
    p
}

// The shape rule is called on IR the instruction gate would already have
// refused, so each rejection class is checked on its own: a Vec pointer that is
// read as a struct or handed to a call; a Phi that merges two Vecs, or always
// supplies one, is accepted (the model reads and writes a merge through the Vecs
// it stands for).
fn check_shape_rejections() -> i64 {
    let used: Vec<IrInst> = Vec::new();
    used.push(mk_inst_arg(0, ITY_PTR(), 0));
    used.push(mk_inst_const_i64(1, 1));
    used.push(mk_inst_call_extern(2, ITY_UNIT(), args2(0, 1), String::from("__vow_vec_push_val")));
    used.push(mk_inst_field_get(3, ITY_I64(), 0, 0));
    used.push(mk_inst_return(4, 3));
    let as_struct: IrFunction = one_block(ptr_u64_params(), ITY_I64(), used);
    if vc_vec_shape_detail(as_struct, 8, false) != String::from("Vec used as a struct") { return 60; }

    let called: Vec<IrInst> = Vec::new();
    called.push(mk_inst_arg(0, ITY_PTR(), 0));
    called.push(mk_inst_call_extern(1, ITY_U64(), args1(0), String::from("__vow_vec_len")));
    called.push(mk_inst_call_target(2, ITY_U64(), args1(0), 7));
    called.push(mk_inst_return(3, 2));
    let to_call: IrFunction = one_block(ptr_u64_params(), ITY_U64(), called);
    if vc_vec_shape_detail(to_call, 8, false) != String::from("Vec passed to a call") { return 61; }
    if vc_vec_shape_detail(to_call, 8, true).len() != 0 { return 65; }

    let builtin: Vec<IrInst> = Vec::new();
    builtin.push(mk_inst_arg(0, ITY_PTR(), 0));
    builtin.push(mk_inst_call_extern(1, ITY_U64(), args1(0), String::from("__vow_vec_len")));
    builtin.push(mk_inst_call_extern(2, ITY_U64(), args1(0), String::from("__vow_vec_reserve_in_arena")));
    builtin.push(mk_inst_return(3, 2));
    let to_builtin: IrFunction = one_block(ptr_u64_params(), ITY_U64(), builtin);
    if vc_vec_shape_detail(to_builtin, 8, false) != String::from("Vec passed to an unmodelled builtin") { return 62; }

    let merged: Vec<IrInst> = Vec::new();
    merged.push(mk_inst_arg(0, ITY_PTR(), 0));
    merged.push(mk_inst_arg(1, ITY_PTR(), 1));
    merged.push(mk_inst_phi(2, ITY_PTR()));
    merged.push(mk_inst_upsilon(3, 0, 2));
    merged.push(mk_inst_upsilon(4, 1, 2));
    merged.push(mk_inst_call_extern(5, ITY_U64(), args1(2), String::from("__vow_vec_len")));
    merged.push(mk_inst_return(6, 5));
    let by_phi: IrFunction = one_block(two_ptr_params(), ITY_U64(), merged);
    if vc_vec_shape_detail(by_phi, 8, false).len() != 0 { return 63; }

    let same: Vec<IrInst> = Vec::new();
    same.push(mk_inst_arg(0, ITY_PTR(), 0));
    same.push(mk_inst_phi(1, ITY_PTR()));
    same.push(mk_inst_upsilon(2, 0, 1));
    same.push(mk_inst_upsilon(3, 0, 1));
    same.push(mk_inst_call_extern(4, ITY_U64(), args1(1), String::from("__vow_vec_len")));
    same.push(mk_inst_return(5, 4));
    let one_value: IrFunction = one_block(ptr_u64_params(), ITY_U64(), same);
    if vc_vec_shape_detail(one_value, 8, false).len() != 0 { return 64; }
    0
}

// fn f(v: Vec<f64>, i: u64) -> f64 { v[i] }, with the slot read through `BitsToF64`.
fn param_float_get() -> IrFunction {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_arg(0, ITY_PTR(), 0));
    insts.push(mk_inst_arg(1, ITY_U64(), 1));
    insts.push(mk_inst_call_extern(2, ITY_I64(), args2(0, 1), String::from("__vow_vec_get_val")));
    insts.push(mk_inst(3, IOP_BITS_TO_F64(), ITY_F64(), args1(2)));
    insts.push(mk_inst_return(4, 3));
    one_block(ptr_u64_params(), ITY_F64(), insts)
}

// fn f(v: Vec<f32>, x: f32) { v.push(x); v[0] = x }, the stores going through `F32ToBits`.
fn param_float_stores() -> IrFunction {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_arg(0, ITY_PTR(), 0));
    insts.push(mk_inst_arg(1, ITY_F32(), 1));
    insts.push(mk_inst(2, IOP_F32_TO_BITS(), ITY_I64(), args1(1)));
    insts.push(mk_inst_call_extern(3, ITY_UNIT(), args2(0, 2), String::from("__vow_vec_push_val")));
    insts.push(mk_inst_const_i64(4, 0));
    insts.push(mk_inst_call_extern(5, ITY_UNIT(), args3(0, 4, 2), String::from("__vow_vec_set_val")));
    insts.push(mk_inst_return(6, 5));
    let p: Vec<i64> = Vec::new();
    p.push(ITY_PTR());
    p.push(ITY_F32());
    one_block(p, ITY_UNIT(), insts)
}

// A float read from, or stored into, the slot of a parameter `Vec` makes its counterexample
// elements floats; a plain slot read leaves them raw, and the slot stays a 64-bit element.
fn check_float_elements_of_a_parameter() -> i64 {
    let rd: IrFunction = param_float_get();
    if vc_skip_reason(rd).len() != 0 { return 40; }
    let cs: VcClaims = vc_claims(rd);
    if cs.vec_wide.len() != 1 || cs.vec_wide[0] != ITY_F64() { return 41; }
    let q: String = render(cs, 0);
    if !contains(q, String::from("(declare-const p0_varr (Array (_ BitVec 64) (_ BitVec 64)))")) { return 42; }
    if !contains(vc_smt_render(cs.arena, cs.header), String::from("(define-fun v3 () (_ FloatingPoint 11 53) ((_ to_fp 11 53) v2))")) { return 43; }
    if !contains(q, String::from("(set-logic QF_ABVFP)")) { return 44; }
    let st: IrFunction = param_float_stores();
    if vc_skip_reason(st).len() != 0 { return 45; }
    let cst: VcClaims = vc_claims(st);
    if cst.vec_wide.len() != 1 || cst.vec_wide[0] != ITY_F32() { return 46; }
    let raw: VcClaims = vc_claims(param_get());
    if raw.vec_wide.len() != 1 || raw.vec_wide[0] != -1 { return 47; }
    0
}

// let v = Vec::new(); let w = Vec::new(); v.push(w); v[0] = w; v.push(w); return v.len()
fn local_pointer_pushes() -> IrFunction {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_const_i64(0, 8));
    insts.push(mk_inst_const_i64(1, 8));
    insts.push(mk_inst_call_extern(2, ITY_PTR(), args2(0, 1), String::from("__vow_vec_new")));
    insts.push(mk_inst_call_extern(3, ITY_PTR(), args2(0, 1), String::from("__vow_vec_new")));
    insts.push(mk_inst_call_extern(4, ITY_UNIT(), args2(2, 3), String::from("__vow_vec_push_val")));
    insts.push(mk_inst_const_i64(5, 0));
    insts.push(mk_inst_call_extern(6, ITY_UNIT(), args3(2, 5, 3), String::from("__vow_vec_set_val")));
    insts.push(mk_inst_call_extern(7, ITY_UNIT(), args2(2, 3), String::from("__vow_vec_push_val")));
    insts.push(mk_inst_call_extern(8, ITY_U64(), args1(2), String::from("__vow_vec_len")));
    insts.push(mk_inst_return(9, 8));
    one_block(Vec::new(), ITY_U64(), insts)
}

// A pointer pushed or stored is a fresh 64-bit slot constant: the length is exact (two pushes
// fold away like scalar ones), and each stored address is its own declared constant.
fn check_pointer_elements_are_fresh_slots() -> i64 {
    let f: IrFunction = local_pointer_pushes();
    if vc_skip_reason(f).len() != 0 { return 40; }
    let cs: VcClaims = vc_claims(f);
    if cs.kinds.len() != 0 || cs.assumed.len() != 0 { return 41; }
    let mut slots: i64 = 0;
    let hdr: SmtScript = cs.header;
    let mut i: u64 = 0;
    while i < hdr.names.len() {
        if contains(hdr.names[i], String::from("pe")) { slots = slots + 1; }
        i = i + 1;
    }
    if slots != 3 { return 42; }
    0
}

// fn f(i: u64) -> i64 { let v = Vec::new(); v.push(1) x pushes; <tail>; v[i] }
// `tail` is 0 for nothing, 1 for `v.clear()`, 2 for `v.truncate(n)`. Ids are
// positions, so they are handed out in order.
fn local_pushes_then(pushes: i64, tail: i64, n: i64) -> IrFunction {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_arg(0, ITY_U64(), 0));
    insts.push(mk_inst_const_i64(1, 8));
    insts.push(mk_inst_const_i64(2, 8));
    insts.push(mk_inst_call_extern(3, ITY_PTR(), args2(1, 2), String::from("__vow_vec_new")));
    insts.push(mk_inst_const_i64(4, 1));
    let mut id: i64 = 5;
    let mut k: i64 = 0;
    while k < pushes {
        insts.push(mk_inst_call_extern(id, ITY_UNIT(), args2(3, 4), String::from("__vow_vec_push_val")));
        id = id + 1;
        k = k + 1;
    }
    if tail == 1 {
        insts.push(mk_inst_call_extern(id, ITY_UNIT(), args1(3), String::from("__vow_vec_clear")));
        id = id + 1;
    } else if tail == 2 {
        insts.push(mk_inst_const_i64(id, n));
        insts.push(mk_inst_call_extern(id + 1, ITY_UNIT(), args2(3, id), String::from("__vow_vec_truncate")));
        id = id + 2;
    }
    insts.push(mk_inst_call_extern(id, ITY_I64(), args2(3, 0), String::from("__vow_vec_get_val")));
    insts.push(mk_inst_return(id + 1, id));
    let p: Vec<i64> = Vec::new();
    p.push(ITY_U64());
    one_block(p, ITY_I64(), insts)
}

// The bounds claim of the final read, rendered: it compares the index with the
// length the preceding operations left.
fn read_query(f: IrFunction) -> String {
    let cs: VcClaims = vc_claims(f);
    if cs.kinds.len() != 1 { return String::from("no single claim"); }
    render(cs, 0)
}

fn check_clear_resets_length() -> i64 {
    let f: IrFunction = local_pushes_then(2, 1, 0);
    if vc_skip_reason(f).len() != 0 { return 70; }
    let q: String = read_query(f);
    if !contains(q, String::from("(bvult p0 #x0000000000000000)")) { return 71; }
    let before: String = read_query(local_pushes_then(2, 0, 0));
    if !contains(before, String::from("(bvult p0 #x0000000000000002)")) { return 72; }
    0
}

fn check_truncate_shortens() -> i64 {
    let f: IrFunction = local_pushes_then(3, 2, 2);
    if vc_skip_reason(f).len() != 0 { return 80; }
    if !contains(read_query(f), String::from("(bvult p0 #x0000000000000002)")) { return 81; }
    0
}

fn check_truncate_is_noop_at_or_past_length() -> i64 {
    if !contains(read_query(local_pushes_then(3, 2, 10)), String::from("(bvult p0 #x0000000000000003)")) { return 82; }
    if !contains(read_query(local_pushes_then(3, 2, 3)), String::from("(bvult p0 #x0000000000000003)")) { return 83; }
    // 2^64 - 1 is an unsigned count: it must not be read as a negative one.
    if !contains(read_query(local_pushes_then(3, 2, -1)), String::from("(bvult p0 #x0000000000000003)")) { return 84; }
    0
}

// fn f(v: Vec<i64>, n: u64, i: u64) -> i64 { v.truncate(n); v[i] }
fn check_param_truncate_is_unsigned() -> i64 {
    let insts: Vec<IrInst> = Vec::new();
    insts.push(mk_inst_arg(0, ITY_PTR(), 0));
    insts.push(mk_inst_arg(1, ITY_U64(), 1));
    insts.push(mk_inst_arg(2, ITY_U64(), 2));
    insts.push(mk_inst_call_extern(3, ITY_UNIT(), args2(0, 1), String::from("__vow_vec_truncate")));
    insts.push(mk_inst_call_extern(4, ITY_I64(), args2(0, 2), String::from("__vow_vec_get_val")));
    insts.push(mk_inst_return(5, 4));
    let p: Vec<i64> = ptr_u64_params();
    p.push(ITY_U64());
    let f: IrFunction = one_block(p, ITY_I64(), insts);
    if vc_skip_reason(f).len() != 0 { return 90; }
    let q: String = read_query(f);
    if !contains(q, String::from("bvuge p1 p0_vlen")) { return 91; }
    if contains(q, String::from("bvsge")) { return 92; }
    0
}

fn main() -> i32 {
    let mut r: i64 = check_param_length_is_unconstrained();
    if r == 0 { r = check_pointer_elements_are_fresh_slots(); }
    if r == 0 { r = check_push_assumes_only_the_invariant(); }
    if r == 0 { r = check_local_vec_length(); }
    if r == 0 { r = check_havoc_forgets_length(); }
    if r == 0 { r = check_no_vec_stays_bit_vector(); }
    if r == 0 { r = check_frame_travels_in_dv2(); }
    if r == 0 { r = check_shape_rejections(); }
    if r == 0 { r = check_clear_resets_length(); }
    if r == 0 { r = check_truncate_shortens(); }
    if r == 0 { r = check_truncate_is_noop_at_or_past_length(); }
    if r == 0 { r = check_param_truncate_is_unsigned(); }
    if r == 0 { r = check_float_elements_of_a_parameter(); }
    i64_to_i32_wrap(r)
}
