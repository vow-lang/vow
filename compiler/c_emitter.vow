module CEmitter

use ir
use ir_dominance
use const_fold
use ir_printer
use verifier_ids

// Internal verifier-model bounds for bounded model checking. ESBMC models
// Vec/String/HashMap/BTreeMap as fixed-size C arrays, so the model needs a
// finite capacity per collection. These are safe defaults that are a fact about
// the prover, not about Vow — not language properties and not user-tunable.
// Swap in an unbounded checker and the same source verifies unchanged.
// See docs/design/verifier-model-bounds.md.
fn VOW_VEC_MAX() -> i64 { 128 }
fn VOW_STRING_MAX() -> i64 { 256 }
fn VOW_HASHMAP_MAX() -> i64 { 64 }
fn VOW_BTREEMAP_MAX() -> i64 { 64 }
fn VOW_HEAP_MAX() -> i64 { 1024 }

fn cemit_str2(a: String, b: String) -> String {
    let r: String = String::from("");
    r.push_str(a);
    r.push_str(b);
    r
}

fn str3(a: String, b: String, c: String) -> String {
    let r: String = String::from("");
    r.push_str(a);
    r.push_str(b);
    r.push_str(c);
    r
}

fn str4(a: String, b: String, c: String, d: String) -> String {
    let r: String = String::from("");
    r.push_str(a);
    r.push_str(b);
    r.push_str(c);
    r.push_str(d);
    r
}

fn str5(a: String, b: String, c: String, d: String, e: String) -> String {
    let r: String = String::from("");
    r.push_str(a);
    r.push_str(b);
    r.push_str(c);
    r.push_str(d);
    r.push_str(e);
    r
}

fn str6(a: String, b: String, c: String, d: String, e: String, f: String) -> String {
    let r: String = String::from("");
    r.push_str(a);
    r.push_str(b);
    r.push_str(c);
    r.push_str(d);
    r.push_str(e);
    r.push_str(f);
    r
}

fn str7(a: String, b: String, c: String, d: String, e: String, f: String, g: String) -> String {
    let r: String = String::from("");
    r.push_str(a);
    r.push_str(b);
    r.push_str(c);
    r.push_str(d);
    r.push_str(e);
    r.push_str(f);
    r.push_str(g);
    r
}

fn vid(id: i64) -> String {
    cemit_str2(String::from("v"), i64_to_string(id))
}

fn str_starts_with(s: String, prefix: String) -> bool {
    let plen: u64 = prefix.len();
    if s.len() < plen { return false; }
    let mut i: u64 = 0u64;
    while i < plen {
        if s.byte_at(i) != prefix.byte_at(i) { return false; }
        i = i + 1;
    }
    true
}

fn str_ends_with(s: String, suffix: String) -> bool {
    let slen: u64 = s.len();
    let n: u64 = suffix.len();
    if slen < n { return false; }
    let mut i: u64 = 0u64;
    while i < n {
        if s.byte_at(slen - n + i) != suffix.byte_at(i) { return false; }
        i = i + 1;
    }
    true
}

fn is_u8_narrow_intrinsic(name: String) -> bool {
    str_starts_with(name, String::from("__vow_i16_to_u8_"))
    || str_starts_with(name, String::from("__vow_i32_to_u8_"))
    || str_starts_with(name, String::from("__vow_i64_to_u8_"))
    || str_starts_with(name, String::from("__vow_i128_to_u8_"))
    || str_starts_with(name, String::from("__vow_u16_to_u8_"))
    || str_starts_with(name, String::from("__vow_u32_to_u8_"))
    || str_starts_with(name, String::from("__vow_u64_to_u8_"))
    || str_starts_with(name, String::from("__vow_u128_to_u8_"))
}

fn is_u8_numeric_intrinsic(name: String) -> bool {
    is_u8_narrow_intrinsic(name)
    || name == String::from("__vow_add_sat_u8")
    || name == String::from("__vow_sub_sat_u8")
    || name == String::from("__vow_mul_sat_u8")
}

fn is_i32_narrow_intrinsic(name: String) -> bool {
    str_starts_with(name, String::from("__vow_i64_to_i32_"))
    || str_starts_with(name, String::from("__vow_u32_to_i32_"))
    || str_starts_with(name, String::from("__vow_u64_to_i32_"))
    || str_starts_with(name, String::from("__vow_i128_to_i32_"))
    || str_starts_with(name, String::from("__vow_u128_to_i32_"))
}

fn is_i32_numeric_intrinsic(name: String) -> bool {
    is_i32_narrow_intrinsic(name)
}

fn cemit_narrow_intrinsic_target(name: String) -> i64 {
    let valid: bool = str_starts_with(name, String::from("__vow_")) &&
        (str_ends_with(name, String::from("_try")) ||
         str_ends_with(name, String::from("_wrap")) ||
         str_ends_with(name, String::from("_sat")));
    if !valid { return -1; }
    if name.contains(String::from("_to_i8_")) { return ITY_I8(); }
    if name.contains(String::from("_to_i16_")) { return ITY_I16(); }
    if name.contains(String::from("_to_u16_")) { return ITY_U16(); }
    if name.contains(String::from("_to_u32_")) { return ITY_U32(); }
    -1
}

fn vec_contains_i64(v: Vec<i64>, val: i64) -> bool {
    let n: u64 = v.len();
    let mut i: u64 = 0u64;
    while i < n {
        if v[i] == val { return true; }
        i = i + 1;
    }
    false
}

fn vec_insert_i64(v: Vec<i64>, val: i64) -> bool {
    if vec_contains_i64(v, val) { return false; }
    v.push(val);
    true
}

fn is_string_fresh_helper(name: String) -> bool {
    name == String::from("__vow_string_trim")
    || name == String::from("__vow_string_trim_in_arena")
    || name == String::from("__vow_string_to_upper")
    || name == String::from("__vow_string_to_upper_in_arena")
    || name == String::from("__vow_string_to_lower")
    || name == String::from("__vow_string_to_lower_in_arena")
}

fn is_known_builtin(name: String) -> bool {
    if is_string_fresh_helper(name) || is_u8_numeric_intrinsic(name) ||
       is_i32_numeric_intrinsic(name) || cemit_narrow_intrinsic_target(name) != -1 { return true; }
    name == String::from("__vow_unwrap_panic")
    || name == String::from("__vow_vec_new")
    || name == String::from("__vow_vec_new_val")
    || name == String::from("__vow_vec_new_in_arena")
    || name == String::from("__vow_vec_new_val_in_arena")
    || name == String::from("__vow_vec_from_raw_parts_copy_val")
    || name == String::from("__vow_vec_pin_to_root_val")
    || name == String::from("__vow_vec_push_val")
    || name == String::from("__vow_vec_push_in_arena")
    || name == String::from("__vow_vec_push_val_in_arena")
    || name == String::from("__vow_vec_reserve_in_arena")
    || name == String::from("__vow_vec_get_val")
    || name == String::from("__vow_vec_len")
    || name == String::from("__vow_vec_pop")
    || name == String::from("__vow_vec_set_val")
    || name == String::from("__vow_string_new")
    || name == String::from("__vow_string_new_in_arena")
    || name == String::from("__vow_string_literal")
    || name == String::from("__vow_string_from_cstr")
    || name == String::from("__vow_string_from_cstr_in_arena")
    || name == String::from("__vow_string_clone")
    || name == String::from("__vow_string_clone_in_arena")
    || name == String::from("__vow_string_from_raw_parts_copy")
    || name == String::from("__vow_string_pin_to_root")
    || name == String::from("__vow_string_len")
    || name == String::from("__vow_string_push_str")
    || name == String::from("__vow_string_push_str_in_arena")
    || name == String::from("__vow_string_push_byte")
    || name == String::from("__vow_string_push_byte_in_arena")
    || name == String::from("__vow_string_clear")
    || name == String::from("__vow_string_byte_at")
    || name == String::from("__vow_string_eq")
    || name == String::from("__vow_string_contains")
    || name == String::from("__vow_string_matches_literal_at")
    || name == String::from("__vow_string_substr")
    || name == String::from("__vow_string_substr_in_arena")
    || name == String::from("__vow_string_substring")
    || name == String::from("__vow_string_substring_in_arena")
    || name == String::from("__vow_string_from_i64")
    || name == String::from("__vow_string_from_i64_in_arena")
    || name == String::from("__vow_string_from_u64")
    || name == String::from("__vow_string_from_u64_in_arena")
    || name == String::from("__vow_string_parse_i64_opt")
    || name == String::from("__vow_string_parse_i64_opt_in_arena")
    || name == String::from("__vow_string_parse_u64_opt")
    || name == String::from("__vow_string_parse_i8_opt")
    || name == String::from("__vow_string_parse_u8_opt")
    || name == String::from("__vow_string_parse_i16_opt")
    || name == String::from("__vow_string_parse_u16_opt")
    || name == String::from("__vow_string_parse_u32_opt")
    || name == String::from("__vow_string_parse_i32_opt")
    || name == String::from("__vow_string_print")
    || name == String::from("__vow_map_new")
    || name == String::from("__vow_map_new_in_arena")
    || name == String::from("__vow_map_len")
    || name == String::from("__vow_map_insert")
    || name == String::from("__vow_map_insert_in_arena")
    || name == String::from("__vow_map_get")
    || name == String::from("__vow_map_get_in_arena")
    || name == String::from("__vow_map_contains")
    || name == String::from("__vow_map_remove")
    || name == String::from("__vow_map_remove_in_arena")
    || name == String::from("__vow_btreemap_new")
    || name == String::from("__vow_btreemap_len")
    || name == String::from("__vow_btreemap_insert")
    || name == String::from("__vow_btreemap_get")
    || name == String::from("__vow_btreemap_contains")
}

fn is_reserved_verifier_symbol(name: String) -> bool {
    // User functions are namespaced to `vow_user_fn_<id>` in the emitted C, so a
    // user symbol named after a libc function (e.g. `abs`) cannot collide with the
    // stdlib declaration; only the verifier's own intrinsics are truly reserved.
    str_starts_with(name, String::from("__ESBMC_"))
    || str_starts_with(name, String::from("__VERIFIER_"))
}

fn verifier_c_func_name(f: IrFunction) -> String {
    cemit_str2(String::from("vow_user_fn_"), i64_to_string(f.id))
}

fn CARG_RECEIVER() -> i64 { 0 }
fn CARG_SECOND_STRING() -> i64 { 1 }
fn CARG_VEC_VALUE() -> i64 { 2 }
fn CARG_OPERAND(index: i64) -> i64 { 3 + index }
fn CARG_MAP_KEY() -> i64 { 7 }
fn CARG_MAP_VALUE() -> i64 { 8 }

// Positions in the runtime call's IR arguments. Logical operands exclude the
// opaque arena pointer. Only known collection operations have a layout.
fn model_arg_index(name: String, role: i64) -> i64 {
    if !is_known_builtin(name)
        || !(str_starts_with(name, String::from("__vow_vec_"))
            || str_starts_with(name, String::from("__vow_string_"))
            || str_starts_with(name, String::from("__vow_map_"))
            || str_starts_with(name, String::from("__vow_btreemap_"))) {
        return -1;
    }
    let offset: i64 = if str_ends_with(name, String::from("_in_arena")) { 1 } else { 0 };
    if role >= CARG_OPERAND(0) && role <= CARG_OPERAND(3) {
        return offset + role - CARG_OPERAND(0);
    }
    if role == CARG_VEC_VALUE() {
        if name == String::from("__vow_vec_push_val")
            || name == String::from("__vow_vec_push_val_in_arena") { return offset + 1; }
        if name == String::from("__vow_vec_set_val") { return 2; }
        return -1;
    }
    if role == CARG_MAP_KEY() {
        if name == String::from("__vow_map_insert")
            || name == String::from("__vow_map_insert_in_arena")
            || name == String::from("__vow_map_get")
            || name == String::from("__vow_map_get_in_arena")
            || name == String::from("__vow_map_contains")
            || name == String::from("__vow_map_remove")
            || name == String::from("__vow_map_remove_in_arena")
            || name == String::from("__vow_btreemap_insert")
            || name == String::from("__vow_btreemap_get")
            || name == String::from("__vow_btreemap_contains") { return offset + 1; }
        return -1;
    }
    if role == CARG_MAP_VALUE() {
        if name == String::from("__vow_map_insert")
            || name == String::from("__vow_map_insert_in_arena")
            || name == String::from("__vow_btreemap_insert") { return offset + 2; }
        return -1;
    }
    if role == CARG_SECOND_STRING() {
        if name == String::from("__vow_string_push_str_in_arena")
            || name == String::from("__vow_string_push_str")
            || name == String::from("__vow_string_eq")
            || name == String::from("__vow_string_contains") { return offset + 1; }
        return -1;
    }
    if role == CARG_RECEIVER() {
        if name == String::from("__vow_vec_push_val")
            || name == String::from("__vow_vec_get_val")
            || name == String::from("__vow_vec_len")
            || name == String::from("__vow_vec_pop")
            || name == String::from("__vow_vec_set_val")
            || name == String::from("__vow_vec_push_in_arena")
            || name == String::from("__vow_vec_push_val_in_arena")
            || name == String::from("__vow_vec_reserve_in_arena")
            || name == String::from("__vow_string_push_str_in_arena")
            || name == String::from("__vow_string_push_byte_in_arena")
            || name == String::from("__vow_string_substr_in_arena")
            || name == String::from("__vow_string_substring_in_arena")
            || name == String::from("__vow_string_push_str")
            || name == String::from("__vow_string_push_byte")
            || name == String::from("__vow_string_substr")
            || name == String::from("__vow_string_substring")
            || name == String::from("__vow_string_clone")
            || name == String::from("__vow_string_clone_in_arena")
            || name == String::from("__vow_string_pin_to_root")
            || name == String::from("__vow_string_len")
            || name == String::from("__vow_string_clear")
            || name == String::from("__vow_string_byte_at")
            || name == String::from("__vow_string_eq")
            || name == String::from("__vow_string_contains")
            || name == String::from("__vow_string_matches_literal_at")
            || name == String::from("__vow_string_print")
            || name == String::from("__vow_map_insert_in_arena")
            || name == String::from("__vow_map_remove_in_arena")
            || name == String::from("__vow_map_get_in_arena")
            || name == String::from("__vow_map_insert")
            || name == String::from("__vow_map_remove")
            || name == String::from("__vow_map_get")
            || name == String::from("__vow_map_contains")
            || name == String::from("__vow_map_len") { return offset; }
    }
    -1
}

// True when id represents a model struct value (__vow_vec_t, __vow_string_t,
// etc.) rather than an int64_t.
fn is_structured_value_id(id: i64, vec_vars: Vec<i64>, string_vars: Vec<i64>, hashmap_vars: Vec<i64>, btreemap_vars: Vec<i64>, option_vars: Vec<i64>) -> bool {
    vec_contains_i64(vec_vars, id)
    || vec_contains_i64(string_vars, id)
    || vec_contains_i64(hashmap_vars, id)
    || vec_contains_i64(btreemap_vars, id)
    || vec_contains_i64(option_vars, id)
}

// True when a user-function call passes a collection (Vec/String/map/Option
// model struct) as an argument. Mirrors `passes_structured_arg` in
// vow-verify/src/c_emitter.rs.
fn passes_structured_arg(inst: IrInst, vec_vars: Vec<i64>, string_vars: Vec<i64>, hashmap_vars: Vec<i64>, btreemap_vars: Vec<i64>, option_vars: Vec<i64>) -> bool {
    let iargs: Vec<i64> = inst.args;
    let mut ai: u64 = 0u64;
    while ai < iargs.len() {
        if is_structured_value_id(iargs[ai], vec_vars, string_vars, hashmap_vars, btreemap_vars, option_vars) {
            return true;
        }
        ai = ai + 1;
    }
    false
}

// True when inst is a vec store/load or map/btreemap key/value op whose stored
// side is a model struct or a Ptr-typed handle rather than a scalar — produces
// `int64_t = __vow_vec_t` in the emitted C model (issue #505). A vec load's
// result is always i64 in the IR, so only classification can flag it. Mirrors
// `collection_op_carries_non_scalar` in vow-verify/src/c_emitter.rs.
fn operand_carries_non_scalar(inst: IrInst, role: i64, name: String, facts: ModelFacts) -> bool {
    let arg_idx: i64 = model_arg_index(name, role);
    if arg_idx < 0 {
        return false;
    }
    let iargs: Vec<i64> = inst.args;
    if arg_idx >= iargs.len() as i64 {
        return false;
    }
    let id: i64 = iargs[arg_idx as u64];
    is_structured_value_id(id, facts.vec_vars, facts.string_vars, facts.hashmap_vars, facts.btreemap_vars, facts.option_vars)
        || vec_contains_i64(facts.ptr_vars, id)
}

fn collection_op_carries_non_scalar(name: String, inst: IrInst, facts: ModelFacts) -> bool {
    if name == String::from("__vow_vec_get_val") {
        return is_structured_value_id(inst.id, facts.vec_vars, facts.string_vars, facts.hashmap_vars, facts.btreemap_vars, facts.option_vars);
    }
    operand_carries_non_scalar(inst, CARG_VEC_VALUE(), name, facts)
        || operand_carries_non_scalar(inst, CARG_MAP_KEY(), name, facts)
        || operand_carries_non_scalar(inst, CARG_MAP_VALUE(), name, facts)
}

struct ModelFacts {
    vec_vars: Vec<i64>,
    string_vars: Vec<i64>,
    hashmap_vars: Vec<i64>,
    btreemap_vars: Vec<i64>,
    option_vars: Vec<i64>,
    wide_vars: Vec<i64>,
    ptr_vars: Vec<i64>,
}

fn model_facts(f: IrFunction) -> ModelFacts {
    ModelFacts {
        vec_vars: collect_vec_vars(f),
        string_vars: collect_string_vars(f),
        hashmap_vars: collect_hashmap_vars(f),
        btreemap_vars: collect_btreemap_vars(f),
        option_vars: collect_option_vars(f),
        wide_vars: collect_wide_vars(f),
        ptr_vars: collect_ptr_vars(f),
    }
}

fn MCI_OK() -> i64 { 0 }
fn MCI_UNSUPPORTED() -> i64 { 1 }
fn MCI_WIDE() -> i64 { 2 }
fn MCI_EXTERN() -> i64 { 3 }
fn MCI_NONSCALAR_EXTERN() -> i64 { 4 }
fn MCI_STRUCTURED_TARGET() -> i64 { 5 }
fn MCI_TARGET() -> i64 { 6 }
fn MCI_BAD_CALL() -> i64 { 7 }

// The modelability gate and the skip diagnostic share this instruction policy.
// Strings are rendered only for an issue, never on the successful scan path.
fn modelability_issue(inst: IrInst, facts: ModelFacts, m: IrModule, const_fn_indices: Vec<i64>,
                      cache_ids: Vec<i64>, cache_vals: Vec<i64>) -> i64 {
    let op: i64 = inst.op;
    if is_checked_arith_op(op) {
        if checked_arith_ty(inst) == ITY_UNIT() { return MCI_WIDE(); }
        return MCI_OK();
    }
    if op == IOP_CONST_I32() || op == IOP_CONST_I64() || op == IOP_CONST_F32()
       || op == IOP_CONST_F64() || op == IOP_CONST_BOOL() || op == IOP_CONST_UNIT()
       || op == IOP_CONST_STR() || op == IOP_CONST_U8() || op == IOP_GET_ARG()
       || op == IOP_WADD() || op == IOP_WSUB() || op == IOP_WMUL() || op == IOP_WDIV() || op == IOP_WREM()
       || op == IOP_EQ() || op == IOP_NE() || op == IOP_LT() || op == IOP_LE() || op == IOP_GT() || op == IOP_GE()
       || op == IOP_BITAND() || op == IOP_BITOR() || op == IOP_BITXOR() || op == IOP_SHL() || op == IOP_SHR()
       || op == IOP_INT_CAST()
       || op == IOP_ADD_F32() || op == IOP_ADD_F64() || op == IOP_SUB_F32() || op == IOP_SUB_F64()
       || op == IOP_MUL_F32() || op == IOP_MUL_F64() || op == IOP_DIV_F32() || op == IOP_DIV_F64()
       || op == IOP_EQ_F32() || op == IOP_EQ_F64()
       || op == IOP_NE_F32() || op == IOP_NE_F64()
       || op == IOP_LT_F32() || op == IOP_LT_F64()
       || op == IOP_LE_F32() || op == IOP_LE_F64()
       || op == IOP_GT_F32() || op == IOP_GT_F64()
       || op == IOP_GE_F32() || op == IOP_GE_F64()
       || op == IOP_NOT() || op == IOP_AND() || op == IOP_OR()
       || op == IOP_CONST_U64() || op == IOP_CONST_I128() || op == IOP_CONST_U128()
       || op == IOP_VOW_REQ() || op == IOP_VOW_ENS() || op == IOP_VOW_INV()
       || op == IOP_COMPLEXITY_DESCRIPTOR()
       || op == IOP_BRANCH() || op == IOP_JUMP() || op == IOP_RETURN() || op == IOP_UNREACHABLE()
       || op == IOP_PHI() || op == IOP_UPSILON()
       || op == IOP_REGION_OPEN() || op == IOP_REGION_CLOSE()
       || op == IOP_REGION_ALLOC() || op == IOP_LINEAR_CONSUME() || op == IOP_DEBUG_CALL() {
        return MCI_OK();
    }
    if op == IOP_CALL() {
        if inst.dk == IDATA_CALL_EXTERN() {
            if !is_known_builtin(inst.ds) { return MCI_EXTERN(); }
            if collection_op_carries_non_scalar(inst.ds, inst, facts) {
                return MCI_NONSCALAR_EXTERN();
            }
            return MCI_OK();
        }
        if inst.dk == IDATA_CALL_TARGET() {
            if passes_structured_arg(inst, facts.vec_vars, facts.string_vars, facts.hashmap_vars,
                                     facts.btreemap_vars, facts.option_vars) {
                return MCI_STRUCTURED_TARGET();
            }
            let target_fi: i64 = inst.dv;
            if vec_contains_i64(const_fn_indices, target_fi) { return MCI_OK(); }
            let fns: Vec<IrFunction> = m.functions;
            let mut fi: u64 = 0u64;
            while fi < fns.len() {
                let callee: IrFunction = fns[fi];
                if callee.id == target_fi {
                    if is_modelable(callee, m, const_fn_indices, cache_ids, cache_vals) {
                        return MCI_OK();
                    }
                    return MCI_TARGET();
                }
                fi = fi + 1;
            }
            return MCI_TARGET();
        }
        return MCI_BAD_CALL();
    }
    if op == IOP_FIELD_GET() || op == IOP_FIELD_SET() {
        if field_access_is_wide(inst, facts.wide_vars) { return MCI_WIDE(); }
        return MCI_OK();
    }
    MCI_UNSUPPORTED()
}

fn is_modelable(f: IrFunction, m: IrModule, const_fn_indices: Vec<i64>, modelable_cache_ids: Vec<i64>, modelable_cache_vals: Vec<i64>) -> bool {
    if is_reserved_verifier_symbol(f.name) {
        return false;
    }

    let fid: i64 = f.id;
    let nc: u64 = modelable_cache_ids.len();
    let mut ci: u64 = 0u64;
    while ci < nc {
        if modelable_cache_ids[ci] == fid {
            return modelable_cache_vals[ci] != 0;
        }
        ci = ci + 1;
    }
    modelable_cache_ids.push(fid);
    modelable_cache_vals.push(0);

    if f.effects != 0 {
        return false;
    }
    if ir_non_dominating_read(f).len() > 0 {
        return false;
    }

    let facts: ModelFacts = model_facts(f);
    let blocks: Vec<IrBlock> = f.blocks;
    let mut bi: u64 = 0u64;
    while bi < blocks.len() {
        let insts: Vec<IrInst> = blocks[bi].insts;
        let mut ii: u64 = 0u64;
        while ii < insts.len() {
            if modelability_issue(insts[ii], facts, m, const_fn_indices,
                                  modelable_cache_ids, modelable_cache_vals) != MCI_OK() {
                return false;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }

    let nc2: u64 = modelable_cache_ids.len();
    let mut ci2: u64 = 0u64;
    while ci2 < nc2 {
        if modelable_cache_ids[ci2] == fid {
            modelable_cache_vals[ci2] = 1;
        }
        ci2 = ci2 + 1;
    }
    true
}

// Mirror of `vow_verify::c_emitter::non_modelable_reason`. Returns a
// human-readable explanation for why the verifier cannot model this
// function (used as a Warning diagnostic + skip-the-function gate).
// Empty string means the function IS modelable.
fn iop_unsupported_name(op: i64) -> String {
    if op == IOP_CONST_I128() { return String::from("ConstI128"); }
    if op == IOP_CONST_U128() { return String::from("ConstU128"); }
    if op == IOP_REM_F32() { return String::from("RemF32"); }
    if op == IOP_REM_F64() { return String::from("RemF64"); }
    if op == IOP_LOAD() { return String::from("Load"); }
    if op == IOP_STORE() { return String::from("Store"); }
    if op == IOP_LINEAR_BORROW() { return String::from("LinearBorrow"); }
    String::from("")
}

fn model_issue_name(issue: i64, inst: IrInst, m: IrModule) -> String {
    if issue == MCI_UNSUPPORTED() {
        let known: String = iop_unsupported_name(inst.op);
        if known.len() > 0 { return known; }
        return opcode_name(inst.op);
    }
    if issue == MCI_WIDE() {
        return cemit_str2(opcode_name(inst.op), String::from(" at 128-bit width"));
    }
    if issue == MCI_EXTERN() {
        return str3(String::from("Call extern `"), inst.ds, String::from("`"));
    }
    if issue == MCI_NONSCALAR_EXTERN() {
        return str3(String::from("Call extern `"), inst.ds, String::from("` with non-scalar element"));
    }
    if issue == MCI_STRUCTURED_TARGET() {
        return String::from("Call target with a collection argument");
    }
    if issue == MCI_TARGET() {
        let fns: Vec<IrFunction> = m.functions;
        let mut fi: u64 = 0u64;
        while fi < fns.len() {
            let callee: IrFunction = fns[fi];
            if callee.id == inst.dv {
                return str3(String::from("Call target `"), callee.name, String::from("`"));
            }
            fi = fi + 1;
        }
        return str3(String::from("Call target `FuncId("), i64_to_string(inst.dv), String::from(")`"));
    }
    str3(String::from("Call (dk="), i64_to_string(inst.dk), String::from(")"))
}

fn first_unsupported_opcode_name(f: IrFunction, m: IrModule, const_fn_indices: Vec<i64>) -> String {
    let facts: ModelFacts = model_facts(f);
    let cache_ids: Vec<i64> = Vec::new();
    let cache_vals: Vec<i64> = Vec::new();
    let blocks: Vec<IrBlock> = f.blocks;
    let mut bi: u64 = 0u64;
    while bi < blocks.len() {
        let insts: Vec<IrInst> = blocks[bi].insts;
        let mut ii: u64 = 0u64;
        while ii < insts.len() {
            let inst: IrInst = insts[ii];
            let issue: i64 = modelability_issue(inst, facts, m, const_fn_indices, cache_ids, cache_vals);
            if issue != MCI_OK() {
                return model_issue_name(issue, inst, m);
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    String::from("")
}

fn non_modelable_reason(f: IrFunction, m: IrModule, const_fn_indices: Vec<i64>) -> String {
    if is_reserved_verifier_symbol(f.name) {
        return str3(String::from("function `"), f.name, String::from("` shadows a reserved verifier symbol"));
    }
    if f.effects != 0 {
        return str3(
            String::from("function `"),
            f.name,
            String::from("` has effects; the verifier model is restricted to pure functions"),
        );
    }
    let cache_ids: Vec<i64> = Vec::new();
    let cache_vals: Vec<i64> = Vec::new();
    if is_modelable(f, m, const_fn_indices, cache_ids, cache_vals) {
        return String::from("");
    }
    let dominance: String = ir_non_dominating_read(f);
    if dominance.len() > 0 {
        return str5(
            String::from("function `"),
            f.name,
            String::from("` is not modelable in the verifier ("),
            dominance,
            String::from(")"),
        );
    }
    let offender: String = first_unsupported_opcode_name(f, m, const_fn_indices);
    let detail: String = {
        if offender.len() > 0 {
            str3(String::from("contains unsupported opcode `"), offender, String::from("`"))
        } else {
            String::from("calls a non-modelable callee")
        }
    };
    str5(
        String::from("function `"),
        f.name,
        String::from("` is not modelable in the verifier ("),
        detail,
        String::from(")"),
    )
}

fn collect_callees_dfs(f: IrFunction, m: IrModule, const_fn_indices: Vec<i64>,
                       modelable_cache_ids: Vec<i64>, modelable_cache_vals: Vec<i64>,
                       visited: Vec<i64>, order: Vec<i64>) {
    let blocks: Vec<IrBlock> = f.blocks;
    let mut bi: u64 = 0u64;
    while bi < blocks.len() {
        let blk: IrBlock = blocks[bi];
        let insts: Vec<IrInst> = blk.insts;
        let mut ii: u64 = 0u64;
        while ii < insts.len() {
            let inst: IrInst = insts[ii];
            if inst.op == IOP_CALL() && inst.dk == IDATA_CALL_TARGET() {
                let target_fi: i64 = inst.dv;
                if !vec_contains_i64(const_fn_indices, target_fi) && !vec_contains_i64(visited, target_fi) {
                    let fns: Vec<IrFunction> = m.functions;
                    let mut fi: u64 = 0u64;
                    while fi < fns.len() {
                        let callee: IrFunction = fns[fi];
                        if callee.id == target_fi {
                            if is_modelable(callee, m, const_fn_indices, modelable_cache_ids, modelable_cache_vals) {
                                visited.push(target_fi);
                                collect_callees_dfs(callee, m, const_fn_indices, modelable_cache_ids, modelable_cache_vals, visited, order);
                                order.push(target_fi);
                            }
                            fi = fns.len();
                        }
                        fi = fi + 1;
                    }
                }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
}

fn collect_modelable_callees(f: IrFunction, m: IrModule, const_fn_indices: Vec<i64>) -> Vec<i64> {
    let modelable_cache_ids: Vec<i64> = Vec::new();
    let modelable_cache_vals: Vec<i64> = Vec::new();
    let visited: Vec<i64> = Vec::new();
    let order: Vec<i64> = Vec::new();
    collect_callees_dfs(f, m, const_fn_indices, modelable_cache_ids, modelable_cache_vals, visited, order);
    order
}

fn ity_is_wide(ty: i64) -> bool {
    ty == ITY_I128() || ty == ITY_U128()
}

fn build_inst_ty_by_id(f: IrFunction) -> Vec<i64> {
    let inst_ty_by_id: Vec<i64> = Vec::new();
    let blocks: Vec<IrBlock> = f.blocks;
    let mut bi: u64 = 0u64;
    while bi < blocks.len() {
        let blk: IrBlock = blocks[bi];
        let insts: Vec<IrInst> = blk.insts;
        let mut ii: u64 = 0u64;
        while ii < insts.len() {
            let inst: IrInst = insts[ii];
            if inst.id >= 0 {
                while inst_ty_by_id.len() as i64 <= inst.id {
                    inst_ty_by_id.push(ITY_I64());
                }
                inst_ty_by_id[inst.id as u64] = inst.ty;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    inst_ty_by_id
}

// IR type of the instruction producing `id`, defaulting to the signed form
// when the operand cannot be resolved.
fn inst_ty_of(inst_ty_by_id: Vec<i64>, id: i64) -> i64 {
    if id < 0 || id >= inst_ty_by_id.len() as i64 {
        return ITY_I64();
    }
    inst_ty_by_id[id as u64]
}

// Emit the bounds assert for an indexed container access (Vec or String).
//
// `.len` is uint64_t, so the comparison is keyed off the index instruction's
// IR type to avoid leaving signed/unsigned conversion to C's usual arithmetic
// conversions. An unsigned index is compared directly, and `v{idx} >= 0` would
// be vacuous. A signed index keeps its `>= 0` guard so a negative index is
// still caught, and compares against `.len` converted to int64_t, which is
// lossless because every `.len` is bounded by the model capacity.
fn emit_bounds_assert(out: String, idx: i64, container: i64, idx_ty: i64, label: String) {
    let is: String = i64_to_string(idx);
    let cs: String = i64_to_string(container);
    if ity_is_unsigned(idx_ty) {
        out.push_str(str6(String::from("  __ESBMC_assert(v"), is,
            String::from(" < v"), cs, String::from(".len, \""),
            cemit_str2(label, String::from("\");\n"))));
        return;
    }
    out.push_str(str7(String::from("  __ESBMC_assert(v"), is,
        String::from(" >= 0 && v"), is,
        String::from(" < (int64_t)v"), cs,
        cemit_str2(String::from(".len, \""), cemit_str2(label, String::from("\");\n")))));
}

// The model-bound kinds, in the fixed order the note reports them: the four
// collections, then the user-struct heap. Mirrors `ModelBoundKind` in
// vow-verify/src/model_bounds.rs.
fn MB_VEC() -> i64 { 0 }
fn MB_STRING() -> i64 { 1 }
fn MB_HASHMAP() -> i64 { 2 }
fn MB_BTREEMAP() -> i64 { 3 }
fn MB_HEAP() -> i64 { 4 }
fn MB_KIND_COUNT() -> i64 { 5 }

// The name in the marker wire format.
fn model_bound_kind_name(k: i64) -> String {
    if k == MB_VEC() { return String::from("Vec"); }
    if k == MB_STRING() { return String::from("String"); }
    if k == MB_HASHMAP() { return String::from("HashMap"); }
    if k == MB_BTREEMAP() { return String::from("BTreeMap"); }
    String::from("Heap")
}

fn model_bound_slug(k: i64) -> String {
    if k == MB_VEC() { return String::from("vec"); }
    if k == MB_STRING() { return String::from("string"); }
    if k == MB_HASHMAP() { return String::from("hashmap"); }
    if k == MB_BTREEMAP() { return String::from("btreemap"); }
    String::from("heap")
}

// The label of the assertion that fires when a value outgrows the capacity.
fn model_bound_capacity_label(k: i64) -> String {
    cemit_str2(model_bound_slug(k), String::from(" capacity"))
}

// Wire format of a capacity marker, `/* vow:model-bound <Kind> <digits> */`,
// shared with vow-verify's `model_bound_marker` and read back by verifier.vow.
fn model_bound_prefix() -> String { String::from("/* vow:model-bound ") }
fn model_bound_suffix() -> String { String::from(" */") }

// The marker text appended to an emitted capacity assumption.
fn model_bound_marker(kind: i64, cap: i64) -> String {
    str5(String::from(" "), model_bound_prefix(), model_bound_kind_name(kind), String::from(" "),
        cemit_str2(i64_to_string(cap), model_bound_suffix()))
}

fn model_bound_cap(kind: i64, vec_max: i64, string_max: i64, hashmap_max: i64, btreemap_max: i64) -> i64 {
    if kind == MB_VEC() { return vec_max; }
    if kind == MB_STRING() { return string_max; }
    if kind == MB_HASHMAP() { return hashmap_max; }
    if kind == MB_BTREEMAP() { return btreemap_max; }
    VOW_HEAP_MAX()
}

// `v<id>.len` assumed within the capacity of `kind` under comparison `cmp`,
// tagged with its bound marker.
fn emit_len_assume(out: String, id: i64, kind: i64, cap: i64, cmp: String) {
    out.push_str(str5(String::from("  __ESBMC_assume(v"), i64_to_string(id), String::from(".len "), cmp, String::from(" ")));
    out.push_str(i64_to_string(cap));
    out.push_str(String::from(");"));
    out.push_str(model_bound_marker(kind, cap));
    out.push_str(String::from("\n"));
}

// The kind of the collection value `id` was inferred to be, or -1.
fn typed_collection_kind(id: i64, vec_vars: Vec<i64>, string_vars: Vec<i64>, hashmap_vars: Vec<i64>, btreemap_vars: Vec<i64>) -> i64 {
    if vec_contains_i64(vec_vars, id) { return MB_VEC(); }
    if vec_contains_i64(string_vars, id) { return MB_STRING(); }
    if vec_contains_i64(hashmap_vars, id) { return MB_HASHMAP(); }
    if vec_contains_i64(btreemap_vars, id) { return MB_BTREEMAP(); }
    -1
}

// A collection value of unknown length: `lead` precedes the nondeterministic
// length on its first line, and the length is assumed within the capacity of
// `kind`. A BTreeMap additionally assumes ascending keys, which the
// get/contains/insert C model requires.
fn emit_nondet_collection_len(out: String, id: i64, kind: i64, cap: i64, lead: String) {
    let ids: String = i64_to_string(id);
    out.push_str(lead);
    out.push_str(str3(String::from("v"), ids, String::from(".len = __VERIFIER_nondet_unsigned_long();\n")));
    emit_len_assume(out, id, kind, cap, String::from("<="));
    if kind == MB_BTREEMAP() {
        out.push_str(str3(String::from("  for (uint64_t __si = 0; __si + 1 < v"), ids, String::from(".len; __si++)\n")));
        out.push_str(str3(String::from("    __ESBMC_assume(v"), ids, String::from(".keys[__si] < v")));
        out.push_str(str3(ids, String::from(".keys[__si + 1]);\n"), String::from("")));
    }
}

// A constant length >= max (or a negative / >= 2^63 one) is outside the model
// capacity.
fn raw_parts_const_len_exceeds_model(const_value_by_id: Vec<i64>, len_arg: i64, max: i64) -> bool {
    if len_arg < 0 || len_arg >= const_value_by_id.len() as i64 {
        return false;
    }
    let v: i64 = const_value_by_id[len_arg as u64];
    v >= 0 && v >= max
}

fn len_is_const(const_value_by_id: Vec<i64>, len_arg: i64) -> bool {
    if len_arg < 0 || len_arg >= const_value_by_id.len() as i64 {
        return false;
    }
    const_value_by_id[len_arg as u64] >= 0
}

// True when the source pointer is provably the null constant, so the model's
// capacity assumption restricts nothing.
fn raw_parts_null_source(const_value_by_id: Vec<i64>, ptr_arg: i64) -> bool {
    if ptr_arg < 0 || ptr_arg >= const_value_by_id.len() as i64 {
        return false;
    }
    const_value_by_id[ptr_arg as u64] == 0
}

// Model for a constructor copying len elements from ptr (from_raw_parts_copy,
// String::new): `inst` is the call and `ptr_pos` the position of its
// source-pointer argument, followed by the length. The runtime returns an empty
// value for a null ptr whatever len is, so the model does too: a provably null
// source is empty, and otherwise the capacity restriction only applies to a
// non-null source. A length that is provably constant and outside the model
// capacity cannot be assumed (the assumption would be unsatisfiable and prove
// everything after it), so a non-null source fails closed with the capacity
// label. A u64 length drops the vacuous >= 0 lower bound.
fn emit_raw_parts_len(out: String, inst: IrInst, ptr_pos: i64, kind: i64, max: i64, inst_ty_by_id: Vec<i64>, const_value_by_id: Vec<i64>) {
    let iargs: Vec<i64> = inst.args;
    let ptr_arg: i64 = iargs[ptr_pos as u64];
    let len_arg: i64 = iargs[(ptr_pos + 1) as u64];
    let ids: String = i64_to_string(inst.id);
    if raw_parts_null_source(const_value_by_id, ptr_arg) {
        out.push_str(str3(String::from("  v"), ids, String::from(".len = 0;\n")));
        return;
    }
    let ps: String = i64_to_string(ptr_arg);
    if raw_parts_const_len_exceeds_model(const_value_by_id, len_arg, max) {
        out.push_str(str5(String::from("  __ESBMC_assert(v"), ps, String::from(" == 0, \""), model_bound_capacity_label(kind), String::from("\");\n")));
        out.push_str(str3(String::from("  v"), ids, String::from(".len = 0;\n")));
        return;
    }
    let ls: String = i64_to_string(len_arg);
    let lower: String = { if ity_is_unsigned(inst_ty_of(inst_ty_by_id, len_arg)) { String::new() } else { str3(String::from("v"), ls, String::from(" >= 0 && ")) } };
    let marker: String = { if len_is_const(const_value_by_id, len_arg) { String::new() } else { model_bound_marker(kind, max) } };
    out.push_str(str5(String::from("  __ESBMC_assume(v"), ps,
        String::from(" == 0 || ("), lower,
        str5(String::from("v"), ls, String::from(" < "), i64_to_string(max), str3(String::from("));"), marker, String::from("\n")))));
    out.push_str(str5(String::from("  v"), ids, String::from(".len = v"), ps,
        str3(String::from(" == 0 ? 0 : v"), ls, String::from(";\n"))));
}

fn ir_ty_to_c(ty: i64) -> String {
    if ty == ITY_I8() { return String::from("int8_t"); }
    if ty == ITY_U8() { return String::from("uint8_t"); }
    if ty == ITY_I16() { return String::from("int16_t"); }
    if ty == ITY_U16() { return String::from("uint16_t"); }
    if ty == ITY_I32() { return String::from("int32_t"); }
    if ty == ITY_U32() { return String::from("uint32_t"); }
    if ty == ITY_I64() { return String::from("int64_t"); }
    if ty == ITY_F32() { return String::from("float"); }
    if ty == ITY_F64() { return String::from("double"); }
    if ty == ITY_BOOL() { return String::from("_Bool"); }
    if ty == ITY_UNIT() { return String::from("int32_t"); }
    if ty == ITY_PTR() { return String::from("void*"); }
    if ty == ITY_LPTR() { return String::from("void*"); }
    if ty == ITY_U64() { return String::from("uint64_t"); }
    if ty == ITY_I128() { return String::from("__int128"); }
    if ty == ITY_U128() { return String::from("unsigned __int128"); }
    String::from("int64_t")
}

fn c_nondet_suffix(ty: i64) -> String {
    if ty == ITY_I8() { return String::from("char"); }
    if ty == ITY_U8() { return String::from("unsigned_char"); }
    if ty == ITY_I16() { return String::from("short"); }
    if ty == ITY_U16() { return String::from("unsigned_short"); }
    if ty == ITY_I32() { return String::from("int"); }
    if ty == ITY_I64() { return String::from("long"); }
    if ty == ITY_F32() { return String::from("float"); }
    if ty == ITY_F64() { return String::from("double"); }
    if ty == ITY_BOOL() { return String::from("bool"); }
    if ty == ITY_PTR() { return String::from("long"); }
    if ty == ITY_LPTR() { return String::from("long"); }
    if ty == ITY_U64() { return String::from("unsigned_long"); }
    if ty == ITY_U32() { return String::from("unsigned_int"); }
    String::from("int")
}

fn is_vec_model_constructor(name: String) -> bool {
    name == String::from("__vow_vec_new")
    || name == String::from("__vow_vec_new_val")
    || name == String::from("__vow_vec_new_in_arena")
    || name == String::from("__vow_vec_new_val_in_arena")
    || name == String::from("__vow_vec_from_raw_parts_copy_val")
    || name == String::from("__vow_vec_pin_to_root_val")
}

fn is_string_model_constructor(name: String) -> bool {
    if is_string_fresh_helper(name) { return true; }
    name == String::from("__vow_string_new")
    || name == String::from("__vow_string_new_in_arena")
    || name == String::from("__vow_string_literal")
    || name == String::from("__vow_string_from_cstr")
    || name == String::from("__vow_string_from_cstr_in_arena")
    || name == String::from("__vow_string_clone")
    || name == String::from("__vow_string_clone_in_arena")
    || name == String::from("__vow_string_from_raw_parts_copy")
    || name == String::from("__vow_string_pin_to_root")
    || name == String::from("__vow_string_substr")
    || name == String::from("__vow_string_substr_in_arena")
    || name == String::from("__vow_string_substring")
    || name == String::from("__vow_string_substring_in_arena")
    || name == String::from("__vow_string_from_i64")
    || name == String::from("__vow_string_from_i64_in_arena")
    || name == String::from("__vow_string_from_u64")
    || name == String::from("__vow_string_from_u64_in_arena")
}

fn is_map_model_constructor(name: String) -> bool {
    name == String::from("__vow_map_new")
    || name == String::from("__vow_map_new_in_arena")
}

fn detect_const_fns(m: IrModule) -> Vec<i64> {
    let result: Vec<i64> = Vec::new();
    let fns: Vec<IrFunction> = m.functions;
    let mut fi: u64 = 0u64;
    while fi < fns.len() {
        let f: IrFunction = fns[fi];
        let blocks: Vec<IrBlock> = f.blocks;
        if blocks.len() == 1 {
            let blk: IrBlock = blocks[0];
            let insts: Vec<IrInst> = blk.insts;
            let non_arg: Vec<i64> = Vec::new();
            let mut ii: u64 = 0u64;
            while ii < insts.len() {
                let inst: IrInst = insts[ii];
                if inst.op != IOP_GET_ARG() {
                    non_arg.push(ii as i64);
                }
                ii = ii + 1;
            }
            if non_arg.len() == 2 {
                let ci: IrInst = insts[non_arg[0] as u64];
                let ri: IrInst = insts[non_arg[1] as u64];
                if ri.op == IOP_RETURN() {
                    let ri_args: Vec<i64> = ri.args;
                    if ri_args.len() > 0 {
                        if ri_args[0] == ci.id {
                            if ci.op == IOP_CONST_I32() || ci.op == IOP_CONST_I64() || ci.op == IOP_CONST_U64() || ci.op == IOP_CONST_BOOL() {
                                result.push(fi as i64);
                            }
                        }
                    }
                }
            }
        }
        fi = fi + 1;
    }
    result
}

// A 32-bit constant spelled as the value of its IR type, whichever sign
// extension the lowering stored it with: u32 as 0..2^32-1, everything else as i32.
fn cemit_i32_const_text(dv: i64, ty: i64) -> String {
    let low: i64 = dv & 4294967295;
    if ty != ITY_U32() && low >= 2147483648 {
        return i64_to_string(low - 4294967296);
    }
    i64_to_string(low)
}

fn const_fn_value_str(m: IrModule, fi: i64) -> String {
    let f: IrFunction = m.functions[fi as u64];
    let blk: IrBlock = f.blocks[0];
    let insts: Vec<IrInst> = blk.insts;
    let mut ii: u64 = 0u64;
    while ii < insts.len() {
        let inst: IrInst = insts[ii];
        if inst.op == IOP_CONST_I32() {
            return cemit_i32_const_text(inst.dv, inst.ty);
        }
        if inst.op == IOP_CONST_I64() {
            return cemit_str2(i64_to_string(inst.dv), String::from("LL"));
        }
        if inst.op == IOP_CONST_U64() {
            return cemit_str2(uint_to_string(inst.dv as u64), String::from("ULL"));
        }
        if inst.op == IOP_CONST_BOOL() {
            if inst.dv != 0 { return String::from("1"); }
            return String::from("0");
        }
        ii = ii + 1;
    }
    String::from("0")
}

fn const_fn_type_str(m: IrModule, fi: i64) -> String {
    let f: IrFunction = m.functions[fi as u64];
    let blk: IrBlock = f.blocks[0];
    let insts: Vec<IrInst> = blk.insts;
    let mut ii: u64 = 0u64;
    while ii < insts.len() {
        let inst: IrInst = insts[ii];
        if inst.op == IOP_CONST_I32() { return String::from("int32_t"); }
        if inst.op == IOP_CONST_I64() { return String::from("int64_t"); }
        if inst.op == IOP_CONST_U64() { return String::from("uint64_t"); }
        if inst.op == IOP_CONST_BOOL() { return String::from("_Bool"); }
        ii = ii + 1;
    }
    String::from("int64_t")
}

fn collect_modelled_vars(f: IrFunction, constructor: String, prefix: String) -> Vec<i64> {
    let vars: Vec<i64> = Vec::new();
    let blocks: Vec<IrBlock> = f.blocks;
    let mut bi: u64 = 0u64;
    while bi < blocks.len() {
        let blk: IrBlock = blocks[bi];
        let insts: Vec<IrInst> = blk.insts;
        let mut ii: u64 = 0u64;
        while ii < insts.len() {
            let inst: IrInst = insts[ii];
            if inst.op == IOP_CALL() && inst.dk == IDATA_CALL_EXTERN() {
                let ds: String = inst.ds;
                let alt_creator: bool = (prefix == String::from("__vow_vec_")
                    && is_vec_model_constructor(ds))
                    || (prefix == String::from("__vow_string_")
                        && is_string_model_constructor(ds))
                    || (prefix == String::from("__vow_map_")
                        && is_map_model_constructor(ds));
                let is_creator: bool = ds == constructor || alt_creator;
                if is_creator {
                    vec_insert_i64(vars, inst.id);
                }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    bi = 0u64;
    while bi < blocks.len() {
        let blk: IrBlock = blocks[bi];
        let insts: Vec<IrInst> = blk.insts;
        let mut ii: u64 = 0u64;
        while ii < insts.len() {
            let inst: IrInst = insts[ii];
            if inst.op == IOP_CALL() && inst.dk == IDATA_CALL_EXTERN() {
                let ds: String = inst.ds;
                if str_starts_with(ds, prefix) {
                    let iargs: Vec<i64> = inst.args;
                    let receiver_arg: i64 = {
                        if prefix == String::from("__vow_vec_")
                            || prefix == String::from("__vow_string_")
                            || prefix == String::from("__vow_map_") {
                            model_arg_index(ds, CARG_RECEIVER())
                        } else { 0 }
                    };
                    if receiver_arg >= 0 && iargs.len() as i64 > receiver_arg {
                        vec_insert_i64(vars, iargs[receiver_arg as u64]);
                    }
                    if prefix == String::from("__vow_string_") {
                        let extra_arg: i64 = model_arg_index(ds, CARG_SECOND_STRING());
                        if extra_arg >= 0 && iargs.len() as i64 > extra_arg {
                            vec_insert_i64(vars, iargs[extra_arg as u64]);
                        }
                    }
                }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    let mut changed: bool = true;
    while changed {
        changed = false;
        bi = 0u64;
        while bi < blocks.len() {
            let blk: IrBlock = blocks[bi];
            let insts: Vec<IrInst> = blk.insts;
            let mut ii: u64 = 0u64;
            while ii < insts.len() {
                let inst: IrInst = insts[ii];
                if inst.op == IOP_UPSILON() && inst.dk == IDATA_PHI_TARGET() {
                    let iargs: Vec<i64> = inst.args;
                    if iargs.len() > 0 {
                        let phi_id: i64 = inst.dv;
                        let src_id: i64 = iargs[0];
                        if vec_contains_i64(vars, src_id) {
                            if vec_insert_i64(vars, phi_id) { changed = true; }
                        }
                        if vec_contains_i64(vars, phi_id) {
                            if vec_insert_i64(vars, src_id) { changed = true; }
                        }
                    }
                }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
    }
    vars
}

fn collect_vec_vars(f: IrFunction) -> Vec<i64> {
    collect_modelled_vars(f, String::from("__vow_vec_new"), String::from("__vow_vec_"))
}

fn collect_string_vars(f: IrFunction) -> Vec<i64> {
    collect_modelled_vars(f, String::from("__vow_string_new"), String::from("__vow_string_"))
}

fn collect_hashmap_vars(f: IrFunction) -> Vec<i64> {
    collect_modelled_vars(f, String::from("__vow_map_new"), String::from("__vow_map_"))
}

fn collect_btreemap_vars(f: IrFunction) -> Vec<i64> {
    collect_modelled_vars(f, String::from("__vow_btreemap_new"), String::from("__vow_btreemap_"))
}

fn is_option_returning_extern(name: String) -> bool {
    name == String::from("__vow_string_parse_i64_opt")
    || name == String::from("__vow_string_parse_i64_opt_in_arena")
    || name == String::from("__vow_string_parse_u64_opt")
    || name == String::from("__vow_string_parse_i8_opt")
    || name == String::from("__vow_string_parse_u8_opt")
    || name == String::from("__vow_string_parse_i16_opt")
    || name == String::from("__vow_string_parse_u16_opt")
    || name == String::from("__vow_string_parse_u32_opt")
    || name == String::from("__vow_string_parse_i32_opt")
    || (is_u8_narrow_intrinsic(name) && str_ends_with(name, String::from("_try")))
    || (is_i32_narrow_intrinsic(name) && str_ends_with(name, String::from("_try")))
    || (cemit_narrow_intrinsic_target(name) != -1 && str_ends_with(name, String::from("_try")))
    || name == String::from("__vow_btreemap_insert")
    || name == String::from("__vow_btreemap_get")
    || name == String::from("__vow_map_get")
    || name == String::from("__vow_map_get_in_arena")
}

fn collect_option_vars(f: IrFunction) -> Vec<i64> {
    let result: Vec<i64> = Vec::new();
    let blocks: Vec<IrBlock> = f.blocks;
    let mut bi: u64 = 0u64;
    while bi < blocks.len() {
        let blk: IrBlock = blocks[bi];
        let insts: Vec<IrInst> = blk.insts;
        let mut ii: u64 = 0u64;
        while ii < insts.len() {
            let inst: IrInst = insts[ii];
            if inst.op == IOP_CALL() && inst.dk == IDATA_CALL_EXTERN() && is_option_returning_extern(inst.ds) {
                result.push(inst.id);
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    // Propagate Option tag through Upsilon/Phi pairs so downstream FieldGet is modelled.
    let mut changed: bool = true;
    while changed {
        changed = false;
        bi = 0u64;
        while bi < blocks.len() {
            let blk: IrBlock = blocks[bi];
            let insts: Vec<IrInst> = blk.insts;
            let mut ii: u64 = 0u64;
            while ii < insts.len() {
                let inst: IrInst = insts[ii];
                if inst.op == IOP_UPSILON() && inst.dk == IDATA_PHI_TARGET() {
                    let iargs: Vec<i64> = inst.args;
                    if iargs.len() > 0 {
                        let phi_id: i64 = inst.dv;
                        let src_id: i64 = iargs[0];
                        if vec_contains_i64(result, src_id) {
                            if vec_insert_i64(result, phi_id) { changed = true; }
                        }
                        if vec_contains_i64(result, phi_id) {
                            if vec_insert_i64(result, src_id) { changed = true; }
                        }
                    }
                }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
    }
    result
}

// Ids of the 128-bit-typed instructions, for resolving the type of a
// FieldSet value operand. A FieldGet carries its own width in inst.ty.
fn collect_wide_vars(f: IrFunction) -> Vec<i64> {
    let result: Vec<i64> = Vec::new();
    let blocks: Vec<IrBlock> = f.blocks;
    let mut bi: u64 = 0u64;
    while bi < blocks.len() {
        let blk: IrBlock = blocks[bi];
        let insts: Vec<IrInst> = blk.insts;
        let mut ii: u64 = 0u64;
        while ii < insts.len() {
            let inst: IrInst = insts[ii];
            if ity_is_wide(inst.ty) {
                result.push(inst.id);
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    result
}

// Ids of the Ptr-typed instructions that may hold a collection handle:
// everything except RegionAlloc, whose result is a user-struct handle the
// model already represents as an int64_t heap slot index.
fn collect_ptr_vars(f: IrFunction) -> Vec<i64> {
    let result: Vec<i64> = Vec::new();
    let blocks: Vec<IrBlock> = f.blocks;
    let mut bi: u64 = 0u64;
    while bi < blocks.len() {
        let blk: IrBlock = blocks[bi];
        let insts: Vec<IrInst> = blk.insts;
        let mut ii: u64 = 0u64;
        while ii < insts.len() {
            let inst: IrInst = insts[ii];
            if (inst.ty == ITY_PTR() || inst.ty == ITY_LPTR()) && inst.op != IOP_REGION_ALLOC() {
                result.push(inst.id);
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    result
}

// A field access that moves a 128-bit value through an 8-byte slot. The gate
// and its diagnostic both read this, so is_modelable and
// first_unsupported_opcode_name cannot drift apart on which accesses are
// refused.
fn field_access_is_wide(inst: IrInst, wide_vars: Vec<i64>) -> bool {
    let op: i64 = inst.op;
    if op == IOP_FIELD_GET() {
        return ity_is_wide(inst.ty);
    }
    let iargs: Vec<i64> = inst.args;
    op == IOP_FIELD_SET() && iargs.len() > 1 && vec_contains_i64(wide_vars, iargs[1])
}

fn emit_unmodelled(out: String, inst: IrInst) {
    let id: i64 = inst.id;
    out.push_str(str3(String::from("  /* opcode "), opcode_name(inst.op), String::from(" not modelled */\n")));
    if inst.ty != ITY_UNIT() {
        out.push_str(str4(
            String::from("  v"), i64_to_string(id),
            String::from(" = __VERIFIER_nondet_"), cemit_str2(c_nondet_suffix(inst.ty), String::from("();\n"))
        ));
    }
}

// Sentinel vow_id paired with `emit_unsupported_for_verification`.
// Mirrors `vow_verify::c_emitter::UNSUPPORTED_OP_VOW_ID = u32::MAX`. Reserved so
// the diagnostic pipeline can distinguish a verifier-limitation failure from
// a real vow violation. Single source of truth for the self-hosted side; the
// stringified form is derived from the shared value so the two cannot drift.
fn unsupported_op_vow_id() -> i64 {
    verifier_unsupported_op_vow_id()
}

fn unsupported_op_vow_id_str() -> String {
    verifier_unsupported_op_vow_id_str()
}

// Legacy sentinel vow_id reported by older verifier output when a co-emitted
// callee's `requires` is violated by its caller. New verifier labels use
// `vow:pre:<callee-func-id>:<callee-vow-id>` so diagnostics can resolve the
// exact callee clause without colliding with function-local vow ids. Single
// source of truth for the self-hosted side lives in `verifier_ids`.
fn caller_precondition_vow_id() -> i64 {
    verifier_caller_precondition_vow_id()
}

fn caller_precondition_vow_id_str() -> String {
    verifier_caller_precondition_vow_id_str()
}

// Fail-closed marker for opcodes that have side effects but no verifier model.
// The unsupported assertion text must be exactly `vow:<id>` so both compilers
// can parse the reserved numeric sentinel. Descriptive context lives in a
// separate C comment.
fn emit_unsupported_for_verification(out: String, inst: IrInst) {
    let id: i64 = inst.id;
    out.push_str(str3(
        String::from("  /* unsupported opcode in verifier model: "),
        opcode_name(inst.op), String::from(" */\n")
    ));
    out.push_str(str3(
        String::from("  __ESBMC_assert(0, \"vow:"),
        unsupported_op_vow_id_str(), String::from("\");\n")
    ));
    if inst.ty != ITY_UNIT() {
        out.push_str(str4(
            String::from("  v"), i64_to_string(id),
            String::from(" = __VERIFIER_nondet_"), cemit_str2(c_nondet_suffix(inst.ty), String::from("();\n"))
        ));
    }
}

fn emit_binop(out: String, ty: i64, id: i64, a: i64, b: i64, op: String) {
    out.push_str(str7(
        String::from("  v"),
        i64_to_string(id), String::from(" = v"), i64_to_string(a),
        cemit_str2(String::from(" "), op),
        cemit_str2(String::from(" v"), i64_to_string(b)),
        String::from(";\n")
    ));
}

fn emit_cmp(out: String, id: i64, a: i64, b: i64, op: String) {
    out.push_str(str7(
        String::from("  v"), i64_to_string(id),
        String::from(" = (v"), i64_to_string(a),
        cemit_str2(String::from(" "), op),
        cemit_str2(String::from(" v"), i64_to_string(b)),
        String::from(");\n")
    ));
}

fn emit_u8_numeric_intrinsic(out: String, inst: IrInst) {
    let name: String = inst.ds;
    let id_s: String = i64_to_string(inst.id);
    let a_s: String = i64_to_string(inst.args[0]);
    if str_ends_with(name, String::from("_try")) {
        let line: String = String::from("  v");
        line.push_str(id_s);
        line.push_str(String::from(".tag = ("));
        if str_starts_with(name, String::from("__vow_i")) {
            line.push_str(String::from("v"));
            line.push_str(a_s);
            line.push_str(String::from(" >= 0 && "));
        }
        line.push_str(String::from("v"));
        line.push_str(a_s);
        line.push_str(String::from(" <= 255); v"));
        line.push_str(id_s);
        line.push_str(String::from(".payload = v"));
        line.push_str(id_s);
        line.push_str(String::from(".tag ? (uint8_t)v"));
        line.push_str(a_s);
        line.push_str(String::from(" : 0;\n"));
        out.push_str(line);
        return;
    }
    if str_ends_with(name, String::from("_wrap")) {
        out.push_str(str6(String::from("  v"), id_s, String::from(" = (uint8_t)v"), a_s, String::from(";"), String::from("\n")));
        return;
    }
    if is_u8_narrow_intrinsic(name) {
        let line: String = String::from("  v");
        line.push_str(id_s);
        line.push_str(String::from(" = "));
        if str_starts_with(name, String::from("__vow_i")) {
            line.push_str(String::from("v")); line.push_str(a_s);
            line.push_str(String::from(" < 0 ? 0 : ("));
        }
        line.push_str(String::from("v")); line.push_str(a_s);
        line.push_str(String::from(" > 255 ? 255 : (uint8_t)v")); line.push_str(a_s);
        if str_starts_with(name, String::from("__vow_i")) { line.push_str(String::from(")")); }
        line.push_str(String::from(";\n"));
        out.push_str(line);
        return;
    }
    let b_s: String = i64_to_string(inst.args[1]);
    let line: String = String::from("  v");
    line.push_str(id_s);
    if name == String::from("__vow_sub_sat_u8") {
        line.push_str(String::from(" = v")); line.push_str(a_s);
        line.push_str(String::from(" < v")); line.push_str(b_s);
        line.push_str(String::from(" ? 0 : (uint8_t)(v")); line.push_str(a_s);
        line.push_str(String::from(" - v")); line.push_str(b_s);
        line.push_str(String::from(");\n"));
    } else {
        line.push_str(String::from(" = ((uint16_t)v")); line.push_str(a_s);
        if name == String::from("__vow_add_sat_u8") { line.push_str(String::from(" + ")); }
        else { line.push_str(String::from(" * ")); }
        line.push_str(String::from("(uint16_t)v")); line.push_str(b_s);
        line.push_str(String::from(") > 255 ? 255 : (uint8_t)((uint16_t)v")); line.push_str(a_s);
        if name == String::from("__vow_add_sat_u8") { line.push_str(String::from(" + ")); }
        else { line.push_str(String::from(" * ")); }
        line.push_str(String::from("(uint16_t)v")); line.push_str(b_s);
        line.push_str(String::from(");\n"));
    }
    out.push_str(line);
}

// A shift count must be in 0..width. The `>= 0` half rejects a negative
// signed count, which the masking shift helpers (and Cranelift) would
// otherwise silently reduce modulo the width. Keep byte-identical with the
// Rust emitter in vow-verify/src/c_emitter.rs.
fn cemit_shift_count_assert(count_id: i64, width: i64) -> String {
    let count: String = i64_to_string(count_id);
    let out: String = String::from("  __ESBMC_assert(v");
    out.push_str(count);
    out.push_str(String::from(" >= 0 && v"));
    out.push_str(count);
    out.push_str(String::from(" < "));
    out.push_str(i64_to_string(width));
    out.push_str(String::from(", \"integer shift count\");\n"));
    out
}

fn emit_i32_numeric_intrinsic(out: String, inst: IrInst) {
    let name: String = inst.ds;
    let id_s: String = i64_to_string(inst.id);
    let a_s: String = i64_to_string(inst.args[0]);
    if str_ends_with(name, String::from("_try")) {
        let line: String = String::from("  v");
        line.push_str(id_s);
        line.push_str(String::from(".tag = (v"));
        line.push_str(a_s);
        if str_starts_with(name, String::from("__vow_i")) {
            line.push_str(String::from(" >= -2147483648 && v"));
            line.push_str(a_s);
        }
        line.push_str(String::from(" <= 2147483647); v"));
        line.push_str(id_s);
        line.push_str(String::from(".payload = v"));
        line.push_str(id_s);
        line.push_str(String::from(".tag ? (int32_t)v"));
        line.push_str(a_s);
        line.push_str(String::from(" : 0;\n"));
        out.push_str(line);
        return;
    }
    if str_ends_with(name, String::from("_wrap")) {
        out.push_str(str6(String::from("  v"), id_s, String::from(" = (int32_t)v"), a_s, String::from(";"), String::from("\n")));
        return;
    }
    let line: String = String::from("  v");
    line.push_str(id_s);
    line.push_str(String::from(" = "));
    if str_starts_with(name, String::from("__vow_i")) {
        line.push_str(String::from("v")); line.push_str(a_s);
        line.push_str(String::from(" < -2147483648 ? -2147483648 : (v")); line.push_str(a_s);
        line.push_str(String::from(" > 2147483647 ? 2147483647 : (int32_t)v")); line.push_str(a_s);
        line.push_str(String::from(")"));
    } else {
        line.push_str(String::from("v")); line.push_str(a_s);
        line.push_str(String::from(" > 2147483647 ? 2147483647 : (int32_t)v")); line.push_str(a_s);
    }
    line.push_str(String::from(";\n"));
    out.push_str(line);
}

fn emit_new_narrow_intrinsic(out: String, inst: IrInst) {
    let name: String = inst.ds;
    let target: i64 = cemit_narrow_intrinsic_target(name);
    let c_ty: String = if target == ITY_I8() { String::from("int8_t") }
        else if target == ITY_I16() { String::from("int16_t") }
        else if target == ITY_U16() { String::from("uint16_t") }
        else { String::from("uint32_t") };
    let min_value: String = if target == ITY_I8() { String::from("-128") }
        else if target == ITY_I16() { String::from("-32768") }
        else { String::from("0") };
    let max_value: String = if target == ITY_I8() { String::from("127") }
        else if target == ITY_I16() { String::from("32767") }
        else if target == ITY_U16() { String::from("65535") }
        else { String::from("4294967295ULL") };
    let id_s: String = i64_to_string(inst.id);
    let a_s: String = i64_to_string(inst.args[0]);
    let source_signed: bool = str_starts_with(name, String::from("__vow_i"));

    if str_ends_with(name, String::from("_try")) {
        let line: String = String::from("  v");
        line.push_str(id_s);
        line.push_str(String::from(".tag = ("));
        if source_signed {
            line.push_str(String::from("v")); line.push_str(a_s);
            line.push_str(String::from(" >= ")); line.push_str(min_value);
            line.push_str(String::from(" && "));
        }
        line.push_str(String::from("v")); line.push_str(a_s);
        line.push_str(String::from(" <= ")); line.push_str(max_value);
        line.push_str(String::from("); v")); line.push_str(id_s);
        line.push_str(String::from(".payload = v")); line.push_str(id_s);
        line.push_str(String::from(".tag ? (")); line.push_str(c_ty);
        line.push_str(String::from(")v")); line.push_str(a_s);
        line.push_str(String::from(" : 0;\n"));
        out.push_str(line);
        return;
    }
    if str_ends_with(name, String::from("_wrap")) {
        let line: String = String::from("  v");
        line.push_str(id_s); line.push_str(String::from(" = (")); line.push_str(c_ty);
        line.push_str(String::from(")v")); line.push_str(a_s); line.push_str(String::from(";\n"));
        out.push_str(line);
        return;
    }
    let line: String = String::from("  v");
    line.push_str(id_s); line.push_str(String::from(" = "));
    if source_signed {
        line.push_str(String::from("v")); line.push_str(a_s);
        line.push_str(String::from(" < ")); line.push_str(min_value);
        line.push_str(String::from(" ? ")); line.push_str(min_value);
        line.push_str(String::from(" : ("));
    }
    line.push_str(String::from("v")); line.push_str(a_s);
    line.push_str(String::from(" > ")); line.push_str(max_value);
    line.push_str(String::from(" ? ")); line.push_str(max_value);
    line.push_str(String::from(" : (")); line.push_str(c_ty);
    line.push_str(String::from(")v")); line.push_str(a_s);
    if source_signed { line.push_str(String::from(")")); }
    line.push_str(String::from(";\n"));
    out.push_str(line);
}

fn emit_inst(out: String, inst: IrInst, f: IrFunction, inst_ty_by_id: Vec<i64>, const_value_by_id: Vec<i64>,
             vec_vars: Vec<i64>, string_vars: Vec<i64>,
             hashmap_vars: Vec<i64>, btreemap_vars: Vec<i64>, option_vars: Vec<i64>,
             const_fn_indices: Vec<i64>, modelable_fi_set: Vec<i64>, m: IrModule,
             const_str_ids: Vec<i64>, const_str_idxs: Vec<i64>,
             eq_lo: Vec<i64>, eq_hi: Vec<i64>,
             vec_max: i64, string_max: i64, hashmap_max: i64, btreemap_max: i64,
             requires_as_assert: i64) {
    let id: i64 = inst.id;
    let op: i64 = inst.op;
    let ty: i64 = inst.ty;
    let iargs: Vec<i64> = inst.args;

    if op == IOP_CONST_I32() {
        out.push_str(str3(String::from("  v"), i64_to_string(id),
            str3(String::from(" = "), cemit_i32_const_text(inst.dv, ty), String::from(";\n"))));
        return;
    }
    if op == IOP_CONST_I64() {
        out.push_str(str3(String::from("  v"), i64_to_string(id),
            str3(String::from(" = "), i64_to_string(inst.dv), String::from("LL;\n"))));
        return;
    }
    if op == IOP_CONST_F32() {
        out.push_str(str4(String::from("  v"), i64_to_string(id), String::from(" = "),
            cemit_str2(i64_to_string(inst.dv), String::from("f;\n"))));
        return;
    }
    if op == IOP_CONST_F64() {
        // IEEE-754 double: an all-ones exponent (bits 62..52) means inf/NaN.
        if ((inst.dv >> 52) & 2047) == 2047 {
            emit_unsupported_for_verification(out, inst);
            return;
        }
        out.push_str(str4(String::from("  v"), i64_to_string(id), String::from(" = "),
            cemit_str2(format_f64_bits(inst.dv as u64), String::from(";\n"))));
        return;
    }
    if op == IOP_CONST_BOOL() {
        let bval: String = if inst.dv != 0 { String::from("1") } else { String::from("0") };
        out.push_str(str4(String::from("  v"), i64_to_string(id), String::from(" = "),
            cemit_str2(bval, String::from(";\n"))));
        return;
    }
    if op == IOP_CONST_UNIT() {
        out.push_str(str3(String::from("  v"), i64_to_string(id), String::from(" = 0;\n")));
        return;
    }
    if op == IOP_CONST_U64() {
        out.push_str(str3(String::from("  v"), i64_to_string(id),
            str3(String::from(" = "), uint_to_string(inst.dv as u64), String::from("ULL;\n"))));
        return;
    }
    if op == IOP_CONST_I128() || op == IOP_CONST_U128() {
        if inst.dk != IDATA_CONST_I128() && inst.dk != IDATA_CONST_U128() {
            emit_unmodelled(out, inst);
            return;
        }
        out.push_str(str6(
            str3(String::from("  v"), i64_to_string(id), String::from(" = (")),
            ir_ty_to_c(ty),
            String::from(")((((unsigned __int128)"),
            cemit_str2(uint_to_string(inst.dv2 as u64), String::from("ULL) << 64) | (unsigned __int128)")),
            uint_to_string(inst.dv as u64),
            String::from("ULL);\n")
        ));
        return;
    }
    if op == IOP_CONST_U8() {
        out.push_str(str3(String::from("  v"), i64_to_string(id),
            str3(String::from(" = UINT8_C("), i64_to_string(inst.dv & 255), String::from(");\n"))));
        return;
    }
    if op == IOP_CONST_STR() {
        out.push_str(str3(String::from("  v"), i64_to_string(id), String::from(" = 0; /* string not modelled */\n")));
        return;
    }

    if op == IOP_GET_ARG() { return; }

    // Wrapping operators are *specified* to wrap, so a plain C operator under
    // the bit-vector encoding is already their exact model. The checked
    // operators abort instead, which `emit_checked_arith` models (#585).
    if op == IOP_WADD() {
        emit_binop(out, ty, id, iargs[0], iargs[1], String::from("+"));
        return;
    }
    if op == IOP_WSUB() {
        emit_binop(out, ty, id, iargs[0], iargs[1], String::from("-"));
        return;
    }
    if op == IOP_WMUL() {
        emit_binop(out, ty, id, iargs[0], iargs[1], String::from("*"));
        return;
    }
    if op == IOP_WDIV() {
        emit_binop(out, ty, id, iargs[0], iargs[1], String::from("/"));
        return;
    }
    if op == IOP_WREM() {
        emit_binop(out, ty, id, iargs[0], iargs[1], String::from("%"));
        return;
    }
    if is_checked_arith_op(op) {
        emit_checked_arith(out, inst, iargs, f.id);
        return;
    }

    if op == IOP_ADD_F32() || op == IOP_ADD_F64() {
        emit_binop(out, ty, id, iargs[0], iargs[1], String::from("+"));
        return;
    }
    if op == IOP_SUB_F32() || op == IOP_SUB_F64() {
        emit_binop(out, ty, id, iargs[0], iargs[1], String::from("-"));
        return;
    }
    if op == IOP_MUL_F32() || op == IOP_MUL_F64() {
        emit_binop(out, ty, id, iargs[0], iargs[1], String::from("*"));
        return;
    }
    if op == IOP_DIV_F32() || op == IOP_DIV_F64() {
        emit_binop(out, ty, id, iargs[0], iargs[1], String::from("/"));
        return;
    }
    if op == IOP_REM_F32() || op == IOP_REM_F64() {
        out.push_str(str3(String::from("  /* float rem not modelled */ v"), i64_to_string(id), String::from(" = 0;\n")));
        return;
    }

    if op == IOP_EQ() || op == IOP_EQ_F32() || op == IOP_EQ_F64() {
        emit_cmp(out, id, iargs[0], iargs[1], String::from("=="));
        return;
    }
    if op == IOP_NE() || op == IOP_NE_F32() || op == IOP_NE_F64() {
        emit_cmp(out, id, iargs[0], iargs[1], String::from("!="));
        return;
    }
    if op == IOP_LT() || op == IOP_LT_F32() || op == IOP_LT_F64() {
        emit_cmp(out, id, iargs[0], iargs[1], String::from("<"));
        return;
    }
    if op == IOP_LE() || op == IOP_LE_F32() || op == IOP_LE_F64() {
        emit_cmp(out, id, iargs[0], iargs[1], String::from("<="));
        return;
    }
    if op == IOP_GT() || op == IOP_GT_F32() || op == IOP_GT_F64() {
        emit_cmp(out, id, iargs[0], iargs[1], String::from(">"));
        return;
    }
    if op == IOP_GE() || op == IOP_GE_F32() || op == IOP_GE_F64() {
        emit_cmp(out, id, iargs[0], iargs[1], String::from(">="));
        return;
    }

    if op == IOP_NOT() {
        out.push_str(str4(String::from("  v"), i64_to_string(id), String::from(" = !v"),
            cemit_str2(i64_to_string(iargs[0]), String::from(";\n"))));
        return;
    }
    if op == IOP_AND() {
        emit_cmp(out, id, iargs[0], iargs[1], String::from("&&"));
        return;
    }
    if op == IOP_OR() {
        emit_cmp(out, id, iargs[0], iargs[1], String::from("||"));
        return;
    }
    if op == IOP_BITAND() {
        emit_cmp(out, id, iargs[0], iargs[1], String::from("&"));
        return;
    }
    if op == IOP_BITOR() {
        emit_cmp(out, id, iargs[0], iargs[1], String::from("|"));
        return;
    }
    if op == IOP_BITXOR() {
        emit_cmp(out, id, iargs[0], iargs[1], String::from("^"));
        return;
    }
    if op == IOP_SHL() || op == IOP_SHR() {
        let dynamic_shift: bool = inst.dk == IDATA_INTEGER() &&
            (inst.dv == ITY_I8() || inst.dv == ITY_U8() || inst.dv == ITY_I16() ||
             inst.dv == ITY_U16() || inst.dv == ITY_U32() ||
             inst.dv == ITY_I128() || inst.dv == ITY_U128());
        if dynamic_shift {
            let width: i64 = if inst.dv == ITY_I8() || inst.dv == ITY_U8() { 8 } else if inst.dv == ITY_I16() || inst.dv == ITY_U16() { 16 } else if inst.dv == ITY_I128() || inst.dv == ITY_U128() { 128 } else { 32 };
            out.push_str(cemit_shift_count_assert(iargs[1], width));
            let opname: String = if op == IOP_SHL() { String::from("shl") } else { String::from("shr") };
            let prefix: String = if inst.dv == ITY_I8() || inst.dv == ITY_I16() || inst.dv == ITY_I128() { String::from("i") } else { String::from("u") };
            let expr: String = String::from("  v");
            expr.push_str(i64_to_string(id));
            expr.push_str(String::from(" = __vow_"));
            expr.push_str(opname);
            expr.push_str(String::from("_"));
            expr.push_str(prefix);
            expr.push_str(i64_to_string(width));
            expr.push_str(String::from("(v"));
            expr.push_str(i64_to_string(iargs[0]));
            expr.push_str(String::from(", v"));
            expr.push_str(i64_to_string(iargs[1]));
            expr.push_str(String::from(");\n"));
            out.push_str(expr);
        } else if inst.dk == IDATA_INTEGER() && inst.dv == ITY_I64() {
            out.push_str(cemit_shift_count_assert(iargs[1], 64));
            let opname: String = if op == IOP_SHL() { String::from("shl") } else { String::from("shr") };
            out.push_str(str7(
                String::from("  v"), i64_to_string(id), cemit_str2(String::from(" = __vow_"), cemit_str2(opname, String::from("_i64(v"))),
                i64_to_string(iargs[0]), String::from(", v"), i64_to_string(iargs[1]),
                String::from(");\n")
            ));
        } else if inst.dk == IDATA_INTEGER() && inst.dv == ITY_U64() {
            out.push_str(cemit_shift_count_assert(iargs[1], 64));
            let opname: String = if op == IOP_SHL() { String::from("shl") } else { String::from("shr") };
            out.push_str(str7(
                String::from("  v"), i64_to_string(id), cemit_str2(String::from(" = __vow_"), cemit_str2(opname, String::from("_u64(v"))),
                i64_to_string(iargs[0]), String::from(", v"), i64_to_string(iargs[1]),
                String::from(");\n")
            ));
        } else if inst.dk == IDATA_INTEGER() && inst.dv == ITY_I32() {
            out.push_str(cemit_shift_count_assert(iargs[1], 32));
            let opname: String = if op == IOP_SHL() { String::from("shl") } else { String::from("shr") };
            out.push_str(str7(
                String::from("  v"), i64_to_string(id), cemit_str2(String::from(" = __vow_"), cemit_str2(opname, String::from("_i32(v"))),
                i64_to_string(iargs[0]), String::from(", v"), i64_to_string(iargs[1]),
                String::from(");\n")
            ));
        } else {
            let operator: String = if op == IOP_SHL() { String::from(" << ") } else { String::from(" >> ") };
            emit_cmp(out, id, iargs[0], iargs[1], operator);
        }
        return;
    }
    if op == IOP_INT_CAST() {
        let expr: String = String::from("  v");
        expr.push_str(i64_to_string(id));
        expr.push_str(String::from(" = ("));
        expr.push_str(ir_ty_to_c(ty));
        expr.push_str(String::from(")v"));
        expr.push_str(i64_to_string(iargs[0]));
        expr.push_str(String::from(";\n"));
        out.push_str(expr);
        return;
    }

    if op == IOP_VOW_REQ() {
        if requires_as_assert == 1 {
            // Callee precondition: assert it (Caller blame) so a caller passing a
            // violating argument fails, instead of injecting `assume(false)` and
            // vacuously verifying the caller's body. The label carries both the
            // callee function id and its function-local vow id.
            out.push_str(str7(String::from("  __ESBMC_assert(v"), i64_to_string(iargs[0]),
                String::from(", \"vow:pre:"), i64_to_string(f.id), String::from(":"),
                i64_to_string(inst.dv), String::from("\");\n")));
        } else {
            out.push_str(str3(String::from("  __ESBMC_assume(v"), i64_to_string(iargs[0]), String::from(");\n")));
        }
        return;
    }
    if op == IOP_VOW_ENS() || op == IOP_VOW_INV() {
        let vow_id: i64 = inst.dv;
        if requires_as_assert == 1 {
            // Co-emitted callee: vow ids are local to its function, so qualify
            // the label with the function id.
            out.push_str(str7(String::from("  __ESBMC_assert(v"), i64_to_string(iargs[0]),
                String::from(", \"vow:post:"), i64_to_string(f.id), String::from(":"),
                i64_to_string(vow_id), String::from("\");\n")));
            return;
        }
        out.push_str(str5(String::from("  __ESBMC_assert(v"), i64_to_string(iargs[0]),
            String::from(", \"vow:"), i64_to_string(vow_id), String::from("\");\n")));
        return;
    }

    if op == IOP_BRANCH() {
        let cond: i64 = iargs[0];
        let then_b: i64 = inst.dv;
        let else_b: i64 = inst.dv2;
        out.push_str(str6(String::from("  if (v"), i64_to_string(cond),
            String::from(") goto block"), i64_to_string(then_b),
            String::from("; else goto block"), cemit_str2(i64_to_string(else_b), String::from(";\n"))));
        return;
    }
    if op == IOP_JUMP() {
        let target: i64 = inst.dv;
        out.push_str(str3(String::from("  goto block"), i64_to_string(target), String::from(";\n")));
        return;
    }
    if op == IOP_RETURN() {
        if f.return_ty == ITY_UNIT() {
            out.push_str(String::from("  return;\n"));
            return;
        }
        if iargs.len() > 0 {
            let val_id: i64 = iargs[0];
            if vec_contains_i64(vec_vars, val_id) || vec_contains_i64(string_vars, val_id) || vec_contains_i64(hashmap_vars, val_id) || vec_contains_i64(btreemap_vars, val_id) || vec_contains_i64(option_vars, val_id) {
                out.push_str(String::from("  return 0; /* modelled type return */\n"));
            } else {
                out.push_str(str3(String::from("  return v"), i64_to_string(val_id), String::from(";\n")));
            }
        } else {
            out.push_str(String::from("  return 0;\n"));
        }
        return;
    }
    if op == IOP_UNREACHABLE() {
        out.push_str(String::from("  __ESBMC_assume(0); /* unreachable */\n"));
        return;
    }
    // `.unwrap()` on the empty variant. The lowerer guards this call with a
    // discriminant branch, so reaching it *is* the unwrap-on-None failure.
    if op == IOP_CALL() && inst.dk == IDATA_CALL_EXTERN() && inst.ds == String::from("__vow_unwrap_panic") {
        out.push_str(String::from("  __ESBMC_assert(0, \"unwrap-none\");\n"));
        return;
    }

    if op == IOP_PHI() { return; }
    if op == IOP_UPSILON() { return; }
    if op == IOP_DEBUG_CALL() { return; }
    if op == IOP_COMPLEXITY_DESCRIPTOR() { return; }

    if op == IOP_CALL() {
        if inst.dk == IDATA_CALL_EXTERN() {
            let ds: String = inst.ds;
            if is_u8_numeric_intrinsic(ds) {
                emit_u8_numeric_intrinsic(out, inst);
                return;
            }
            if is_i32_numeric_intrinsic(ds) {
                emit_i32_numeric_intrinsic(out, inst);
                return;
            }
            if cemit_narrow_intrinsic_target(ds) != -1 {
                emit_new_narrow_intrinsic(out, inst);
                return;
            }
            if str_starts_with(ds, String::from("__vow_vec_")) {
                emit_vec_op(out, inst, inst_ty_by_id, const_value_by_id, vec_max);
                return;
            }
            if str_starts_with(ds, String::from("__vow_string_")) {
                emit_string_op(out, inst, f, inst_ty_by_id, const_value_by_id, m, vec_max, string_max, const_str_ids, const_str_idxs, eq_lo, eq_hi);
                return;
            }
            if str_starts_with(ds, String::from("__vow_map_")) {
                emit_map_op(out, inst, hashmap_max);
                return;
            }
            if str_starts_with(ds, String::from("__vow_btreemap_")) {
                emit_btreemap_op(out, inst, btreemap_max);
                return;
            }
            emit_unsupported_for_verification(out, inst);
            return;
        }
        if inst.dk == IDATA_CALL_TARGET() {
            let func_idx: i64 = inst.dv;
            if vec_contains_i64(const_fn_indices, func_idx) {
                let val_s: String = const_fn_value_str(m, func_idx);
                out.push_str(str4(String::from("  v"),
                    i64_to_string(id), String::from(" = "), cemit_str2(val_s, String::from(";\n"))));
                return;
            }
            if vec_contains_i64(modelable_fi_set, func_idx) {
                let fns: Vec<IrFunction> = m.functions;
                let mut fi: u64 = 0u64;
                while fi < fns.len() {
                    let callee: IrFunction = fns[fi];
                    if callee.id == func_idx {
                        let args_str: String = String::from("");
                        let callee_params: Vec<i64> = callee.params;
                        let mut arg_count: i64 = 0;
                        let mut ai: u64 = 0u64;
                        while ai < iargs.len() {
                            if ai < callee_params.len() && callee_params[ai] != ITY_UNIT() {
                                if arg_count > 0 {
                                    args_str.push_str(String::from(", "));
                                }
                                args_str.push_str(vid(iargs[ai]));
                                arg_count = arg_count + 1;
                            }
                            ai = ai + 1;
                        }
                        if ty != ITY_UNIT() {
                            out.push_str(str6(String::from("  v"), i64_to_string(id),
                                String::from(" = "), verifier_c_func_name(callee),
                                String::from("("), cemit_str2(args_str, String::from(");\n"))));
                        } else {
                            out.push_str(str4(String::from("  "), verifier_c_func_name(callee),
                                String::from("("), cemit_str2(args_str, String::from(");\n"))));
                        }
                        fi = fns.len();
                    }
                    fi = fi + 1;
                }
                return;
            }
        }
        emit_unsupported_for_verification(out, inst);
        return;
    }

    if op == IOP_FIELD_GET() {
        let kind: i64 = typed_collection_kind(id, vec_vars, string_vars, hashmap_vars, btreemap_vars);
        if kind >= 0 {
            let lead: String = str3(String::from("  /* FieldGet -> "), model_bound_slug(kind), String::from(" */ "));
            emit_nondet_collection_len(out, id, kind, model_bound_cap(kind, vec_max, string_max, hashmap_max, btreemap_max), lead);
            return;
        }
        // Option projection: FieldGet[0] -> .tag, FieldGet[1+] -> .payload.
        // Triggered by `?`, `match Option::Some(x) => ...`, and explicit field reads
        // on Option-returning calls (parse_i64_opt, btreemap_insert, btreemap_get, map_get).
        if iargs.len() > 0 && vec_contains_i64(option_vars, iargs[0]) && inst.dk == IDATA_FIELD() {
            let ids: String = i64_to_string(id);
            let srcs: String = i64_to_string(iargs[0]);
            if inst.dv == 0 {
                out.push_str(str5(String::from("  v"), ids, String::from(" = v"), srcs, String::from(".tag;\n")));
            } else {
                out.push_str(str5(String::from("  v"), ids, String::from(" = v"), srcs, String::from(".payload;\n")));
            }
            return;
        }
        if iargs.len() > 0 && inst.dk == IDATA_FIELD() {
            // User-struct heap model: load base's field slot.
            let ids: String = i64_to_string(id);
            out.push_str(str6(String::from("  v"), ids,
                String::from(" = __vow_heap[v"), i64_to_string(iargs[0]),
                str3(String::from(" + "), i64_to_string(inst.dv), String::from("]")),
                String::from(";\n")));
            return;
        }
        emit_unmodelled(out, inst);
        return;
    }

    if op == IOP_REGION_OPEN() || op == IOP_REGION_CLOSE() {
        out.push_str(String::from("  /* verifier no-op: region scope marker */\n"));
        return;
    }

    // A consume only discharges an ownership obligation; it neither reads nor writes data.
    if op == IOP_LINEAR_CONSUME() {
        out.push_str(String::from("  /* verifier no-op: linear consume marker */\n"));
        return;
    }

    if op == IOP_REGION_ALLOC() {
        // User-struct heap model: bump-allocate `size/8` int64 slots.
        let ids: String = i64_to_string(id);
        let raw_slots: i64 = inst.dv / 8;
        let slots: i64 = { if raw_slots < 1 { 1 } else { raw_slots } };
        out.push_str(str5(String::from("  v"), ids,
            String::from(" = __vow_heap_top;\n  __vow_heap_top += "),
            i64_to_string(slots), String::from(";\n")));
        out.push_str(String::from("  __ESBMC_assume(__vow_heap_top <= "));
        out.push_str(i64_to_string(VOW_HEAP_MAX()));
        out.push_str(String::from(");"));
        out.push_str(model_bound_marker(MB_HEAP(), VOW_HEAP_MAX()));
        out.push_str(String::from("\n"));
        return;
    }

    if op == IOP_FIELD_SET() {
        // User-struct heap model: store into base's field slot.
        let base: i64 = iargs[0];
        let val: i64 = iargs[1];
        out.push_str(str6(String::from("  __vow_heap[v"), i64_to_string(base),
            String::from(" + "), i64_to_string(inst.dv),
            String::from("] = v"), cemit_str2(i64_to_string(val), String::from(";\n"))));
        return;
    }

    if op == IOP_LOAD() || op == IOP_STORE()
       || op == IOP_LINEAR_BORROW() {
        emit_unsupported_for_verification(out, inst);
        return;
    }

    emit_unsupported_for_verification(out, inst);
}

fn emit_vec_op(out: String, inst: IrInst, inst_ty_by_id: Vec<i64>, const_value_by_id: Vec<i64>, vec_max: i64) {
    let id: i64 = inst.id;
    let ds: String = inst.ds;
    let iargs: Vec<i64> = inst.args;

    if ds == String::from("__vow_vec_new")
       || ds == String::from("__vow_vec_new_val")
       || ds == String::from("__vow_vec_new_in_arena")
       || ds == String::from("__vow_vec_new_val_in_arena") {
        let ids: String = i64_to_string(id);
        out.push_str(str3(String::from("  v"), ids, String::from(".len = 0;\n")));
        return;
    }
    if ds == String::from("__vow_vec_from_raw_parts_copy_val") {
        emit_raw_parts_len(out, inst, 0, MB_VEC(), vec_max, inst_ty_by_id, const_value_by_id);
        return;
    }
    if ds == String::from("__vow_vec_pin_to_root_val") {
        let src: i64 = iargs[0];
        out.push_str(str5(String::from("  v"), i64_to_string(id),
            String::from(" = v"), i64_to_string(src), String::from(";\n")));
        return;
    }
    if ds == String::from("__vow_vec_push_val")
       || ds == String::from("__vow_vec_push_val_in_arena") {
        let vec_arg: i64 = model_arg_index(ds, CARG_RECEIVER());
        let val_arg: i64 = model_arg_index(ds, CARG_VEC_VALUE());
        let vec: i64 = iargs[vec_arg as u64];
        let val: i64 = iargs[val_arg as u64];
        let vs: String = i64_to_string(vec);
        let vas: String = i64_to_string(val);
        out.push_str(str5(String::from("  __ESBMC_assert(v"), vs,
            String::from(".len < "), i64_to_string(vec_max), String::from(", \"vec capacity\");\n")));
        out.push_str(str6(String::from("  v"), vs, String::from(".data[v"), vs,
            String::from(".len] = v"), cemit_str2(vas, String::from(";\n"))));
        out.push_str(str3(String::from("  v"), vs, String::from(".len++;\n")));
        return;
    }
    if ds == String::from("__vow_vec_push_in_arena") {
        let vec: i64 = iargs[model_arg_index(ds, CARG_RECEIVER()) as u64];
        let vs: String = i64_to_string(vec);
        out.push_str(str5(String::from("  __ESBMC_assert(v"), vs,
            String::from(".len < "), i64_to_string(vec_max), String::from(", \"vec capacity\");\n")));
        out.push_str(str5(String::from("  v"), vs, String::from(".data[v"), vs,
            String::from(".len] = __VERIFIER_nondet_long();\n")));
        out.push_str(str3(String::from("  v"), vs, String::from(".len++;\n")));
        return;
    }
    if ds == String::from("__vow_vec_reserve_in_arena") {
        return;
    }
    if ds == String::from("__vow_vec_get_val") {
        let vec: i64 = iargs[0];
        let idx: i64 = iargs[1];
        let vs: String = i64_to_string(vec);
        let is: String = i64_to_string(idx);
        emit_bounds_assert(out, idx, vec, inst_ty_of(inst_ty_by_id, idx), String::from("vec bounds"));
        out.push_str(str5(String::from("  v"), i64_to_string(id),
            String::from(" = v"), vs, str3(String::from(".data[v"),
            is, String::from("];\n"))));
        return;
    }
    if ds == String::from("__vow_vec_len") {
        let vec: i64 = iargs[0];
        out.push_str(str5(String::from("  v"), i64_to_string(id),
            String::from(" = v"), i64_to_string(vec), String::from(".len;\n")));
        return;
    }
    if ds == String::from("__vow_vec_pop") {
        let vec: i64 = iargs[0];
        let vs: String = i64_to_string(vec);
        out.push_str(str5(String::from("  if (v"), vs,
            String::from(".len > 0) { v"), i64_to_string(vec),
            String::from(".len--; }\n")));
        return;
    }
    if ds == String::from("__vow_vec_set_val") {
        let vec: i64 = iargs[0];
        let idx: i64 = iargs[1];
        let val: i64 = iargs[2];
        let vs: String = i64_to_string(vec);
        let is: String = i64_to_string(idx);
        let vas: String = i64_to_string(val);
        emit_bounds_assert(out, idx, vec, inst_ty_of(inst_ty_by_id, idx), String::from("vec bounds"));
        out.push_str(str6(String::from("  v"), vs, String::from(".data[v"),
            is, String::from("] = v"), cemit_str2(vas, String::from(";\n"))));
        return;
    }
    emit_unmodelled(out, inst);
}

// Walk every instruction in the function and append each unordered (lo, hi)
// __vow_string_eq operand pair into the parallel `eq_lo`/`eq_hi` arrays, in
// IR-traversal order with linear deduplication. Mirrors the Rust emitter's
// `compute_string_eq_pairs`.
fn compute_string_eq_pairs(blocks: Vec<IrBlock>, eq_lo: Vec<i64>, eq_hi: Vec<i64>) {
    let n_blocks: u64 = blocks.len();
    let mut bi: u64 = 0u64;
    while bi < n_blocks {
        let blk: IrBlock = blocks[bi];
        let insts: Vec<IrInst> = blk.insts;
        let mut ii: u64 = 0u64;
        while ii < insts.len() {
            let inst: IrInst = insts[ii];
            if inst.op == IOP_CALL() && inst.dk == IDATA_CALL_EXTERN()
                && inst.ds == String::from("__vow_string_eq") {
                let ea: Vec<i64> = inst.args;
                if ea.len() == 2 {
                    let a: i64 = ea[0];
                    let b: i64 = ea[1];
                    if a != b {
                        let lo: i64 = if a < b { a } else { b };
                        let hi: i64 = if a < b { b } else { a };
                        let mut found: bool = false;
                        let mut pi: u64 = 0u64;
                        while pi < eq_lo.len() {
                            if eq_lo[pi] == lo && eq_hi[pi] == hi { found = true; }
                            pi = pi + 1;
                        }
                        if !found {
                            eq_lo.push(lo);
                            eq_hi.push(hi);
                        }
                    }
                }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
}

// Re-sample every cached `__str_eq_<lo>_<hi>` whose pair touches `operand`.
// Called immediately after each modeled string mutation so the verifier
// cannot prove a stale equality across the mutation.
fn emit_string_eq_invalidate(out: String, operand: i64, eq_lo: Vec<i64>, eq_hi: Vec<i64>) {
    let n: u64 = eq_lo.len();
    let mut i: u64 = 0u64;
    while i < n {
        let lo: i64 = eq_lo[i];
        let hi: i64 = eq_hi[i];
        if lo == operand || hi == operand {
            out.push_str(str5(String::from("  __str_eq_"), i64_to_string(lo),
                String::from("_"), i64_to_string(hi),
                String::from(" = __VERIFIER_nondet_bool();\n")));
        }
        i = i + 1;
    }
}

fn emit_nondet_string_len(out: String, id: i64, string_max: i64) {
    let ids: String = i64_to_string(id);
    out.push_str(str3(String::from("  v"), ids, String::from(".len = __VERIFIER_nondet_unsigned_long();\n")));
    emit_len_assume(out, id, MB_STRING(), string_max, String::from("<"));
}

fn const_str_index_for(ids: Vec<i64>, idxs: Vec<i64>, id: i64) -> i64 {
    let mut i: u64 = 0u64;
    while i < ids.len() {
        if ids[i] == id {
            return idxs[i];
        }
        i = i + 1;
    }
    -1
}

fn emit_narrow_parse_option(out: String, id: i64, min_value: String, max_value: String) {
    let ids: String = i64_to_string(id);
    out.push_str(str3(String::from("  v"), ids, String::from(".tag = __VERIFIER_nondet_long();\n")));
    out.push_str(str3(String::from("  __ESBMC_assume(v"), ids, String::from(".tag == 0 || v")));
    out.push_str(str3(ids, String::from(".tag == 1);\n"), String::from("")));
    out.push_str(str3(String::from("  if (v"), ids, String::from(".tag == 1) { v")));
    out.push_str(str3(ids, String::from(".payload = __VERIFIER_nondet_long(); __ESBMC_assume(v"), ids));
    out.push_str(str3(String::from(".payload >= "), min_value, String::from(" && v")));
    out.push_str(str3(ids, String::from(".payload <= "), max_value));
    out.push_str(String::from("); }\n"));
}

// True when `inst` consumes a string operand without ever reading its bytes:
// the model tracks only `.len` for these (`len`, `eq` through its cached
// nondeterministic verdict, `push_str`, `push_byte`, `clear`) or discards the
// value (`Return` models every aggregate as `0`). Twin of
// `string_use_reads_only_len` in vow-verify/src/c_emitter.rs.
fn string_use_reads_only_len(inst: IrInst) -> bool {
    if inst.op == IOP_RETURN() { return true; }
    if inst.op == IOP_CALL() && inst.dk == IDATA_CALL_EXTERN() {
        let name: String = inst.ds;
        return name == String::from("__vow_string_len")
            || name == String::from("__vow_string_eq")
            || name == String::from("__vow_string_push_str")
            || name == String::from("__vow_string_push_str_in_arena")
            || name == String::from("__vow_string_push_byte")
            || name == String::from("__vow_string_push_byte_in_arena")
            || name == String::from("__vow_string_clear");
    }
    false
}

fn string_bytes_observed(f: IrFunction, id: i64) -> bool {
    let blocks: Vec<IrBlock> = f.blocks;
    let mut bi: u64 = 0u64;
    while bi < blocks.len() {
        let blk: IrBlock = blocks[bi];
        let insts: Vec<IrInst> = blk.insts;
        let mut ii: u64 = 0u64;
        while ii < insts.len() {
            let user: IrInst = insts[ii];
            let uargs: Vec<i64> = user.args;
            let mut ai: u64 = 0u64;
            while ai < uargs.len() {
                if uargs[ai] == id && !string_use_reads_only_len(user) { return true; }
                ai = ai + 1;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    false
}

// The byte-copy loop of a `substr`/`substring` result, or a marker comment when
// no instruction reads the result's bytes. The result length is already exact
// (min/clamp arithmetic); a bounded copy loop longer than the incremental-BMC
// step bound makes ESBMC answer `unknown` even for a pure length contract.
fn emit_substring_copy(out: String, f: IrFunction, id: i64, source: String, start_tmp: String, string_max: i64) {
    if !string_bytes_observed(f, id) {
        out.push_str(String::from("  /* length-only substring: bytes never read, copy loop elided */\n"));
        return;
    }
    let ids: String = i64_to_string(id);
    out.push_str(str5(String::from("  for (uint64_t __i = 0; __i < v"), ids,
        String::from(".len && __i < "), i64_to_string(string_max), String::from("; __i++) {\n")));
    out.push_str(str5(String::from("    v"), ids, String::from(".data[__i] = v"), source, String::from(".data[")));
    out.push_str(cemit_str2(start_tmp, String::from(" + __i];\n")));
    out.push_str(String::from("  }\n"));
}

fn emit_string_op(out: String, inst: IrInst, f: IrFunction, inst_ty_by_id: Vec<i64>, const_value_by_id: Vec<i64>, m: IrModule, vec_max: i64, string_max: i64,
                  const_str_ids: Vec<i64>, const_str_idxs: Vec<i64>,
                  eq_lo: Vec<i64>, eq_hi: Vec<i64>) {
    let id: i64 = inst.id;
    let ds: String = inst.ds;
    let iargs: Vec<i64> = inst.args;

    if ds == String::from("__vow_string_new") || ds == String::from("__vow_string_new_in_arena") {
        let ptr_pos: i64 = model_arg_index(ds, CARG_OPERAND(0));
        emit_raw_parts_len(out, inst, ptr_pos, MB_STRING(), string_max, inst_ty_by_id, const_value_by_id);
        return;
    }
    if ds == String::from("__vow_string_from_cstr")
        || ds == String::from("__vow_string_from_cstr_in_arena") {
        let ids: String = i64_to_string(id);
        emit_nondet_string_len(out, id, string_max);
        return;
    }
    if ds == String::from("__vow_string_literal") {
        let lit_idx: i64 = if iargs.len() > 0 { const_str_index_for(const_str_ids, const_str_idxs, iargs[0]) } else { -1 };
        let ids: String = i64_to_string(id);
        if lit_idx >= 0 {
            let strings: Vec<String> = m.strings;
            if lit_idx < strings.len() as i64 {
                let literal: String = strings[lit_idx as u64];
                let len: u64 = literal.len();
                out.push_str(str5(String::from("  v"), ids, String::from(".len = "), i64_to_string(len as i64), String::from(";\n")));
                let mut j: u64 = 0u64;
                while j < len {
                    out.push_str(str6(String::from("  v"), ids, String::from(".data["), i64_to_string(j as i64), String::from("] = (int8_t)"), cemit_str2(i64_to_string(literal.byte_at(j)), String::from(";\n"))));
                    j = j + 1;
                }
                return;
            }
        }
        emit_nondet_string_len(out, id, string_max);
        return;
    }
    if ds == String::from("__vow_string_from_raw_parts_copy") {
        emit_raw_parts_len(out, inst, 0, MB_STRING(), string_max, inst_ty_by_id, const_value_by_id);
        return;
    }
    if ds == String::from("__vow_string_clone") || ds == String::from("__vow_string_clone_in_arena") || ds == String::from("__vow_string_pin_to_root") {
        let src_idx: i64 = model_arg_index(ds, CARG_OPERAND(0));
        let src: i64 = iargs[src_idx as u64];
        out.push_str(str5(String::from("  v"), i64_to_string(id),
            String::from(" = v"), i64_to_string(src), String::from(";\n")));
        return;
    }
    if ds == String::from("__vow_string_from_i64") || ds == String::from("__vow_string_from_i64_in_arena") || ds == String::from("__vow_string_from_u64") || ds == String::from("__vow_string_from_u64_in_arena") {
        let ids: String = i64_to_string(id);
        emit_nondet_string_len(out, id, string_max);
        return;
    }
    if ds == String::from("__vow_string_parse_i64_opt")
        || ds == String::from("__vow_string_parse_i64_opt_in_arena")
        || ds == String::from("__vow_string_parse_u64_opt") {
        let ids: String = i64_to_string(id);
        out.push_str(str3(String::from("  v"), ids, String::from(".tag = __VERIFIER_nondet_long();\n")));
        out.push_str(str3(String::from("  __ESBMC_assume(v"), ids, String::from(".tag == 0 || v")));
        out.push_str(str3(ids, String::from(".tag == 1);\n"), String::from("")));
        out.push_str(str3(String::from("  if (v"), ids, String::from(".tag == 1) { v")));
        out.push_str(str3(ids, String::from(".payload = __VERIFIER_nondet_long(); }\n"), String::from("")));
        return;
    }
    if is_string_fresh_helper(ds) {
        emit_nondet_string_len(out, id, string_max);
        return;
    }
    if ds == String::from("__vow_string_len") {
        let s: i64 = iargs[0];
        out.push_str(str5(String::from("  v"), i64_to_string(id),
            String::from(" = v"), i64_to_string(s), String::from(".len;\n")));
        return;
    }
    if ds == String::from("__vow_string_push_str") || ds == String::from("__vow_string_push_str_in_arena") {
        let dest: i64 = iargs[model_arg_index(ds, CARG_RECEIVER()) as u64];
        let src: i64 = iargs[model_arg_index(ds, CARG_SECOND_STRING()) as u64];
        let dests: String = i64_to_string(dest);
        let srcs: String = i64_to_string(src);
        out.push_str(str7(String::from("  __ESBMC_assert(v"), dests,
            String::from(".len + v"), srcs,
            String::from(".len <= "), i64_to_string(string_max),
            String::from(", \"string capacity\");\n")));
        out.push_str(str5(String::from("  v"), dests,
            String::from(".len += v"), srcs, String::from(".len;\n")));
        emit_string_eq_invalidate(out, dest, eq_lo, eq_hi);
        return;
    }
    if ds == String::from("__vow_string_push_byte") || ds == String::from("__vow_string_push_byte_in_arena") {
        let s: i64 = iargs[model_arg_index(ds, CARG_OPERAND(0)) as u64];
        let byte: i64 = iargs[model_arg_index(ds, CARG_OPERAND(1)) as u64];
        let ss: String = i64_to_string(s);
        out.push_str(str5(String::from("  __ESBMC_assert(v"), ss,
            String::from(".len < "), i64_to_string(string_max), String::from(", \"string capacity\");\n")));
        out.push_str(str6(String::from("  v"), ss, String::from(".data[v"), ss,
            String::from(".len] = (int8_t)v"), cemit_str2(i64_to_string(byte), String::from(";\n"))));
        out.push_str(str3(String::from("  v"), ss, String::from(".len++;\n")));
        emit_string_eq_invalidate(out, s, eq_lo, eq_hi);
        return;
    }
    if ds == String::from("__vow_string_clear") {
        let s: i64 = iargs[0];
        out.push_str(str3(String::from("  v"), i64_to_string(s), String::from(".len = 0;\n")));
        emit_string_eq_invalidate(out, s, eq_lo, eq_hi);
        return;
    }
    if ds == String::from("__vow_string_byte_at") {
        let s: i64 = iargs[0];
        let idx: i64 = iargs[1];
        let ss: String = i64_to_string(s);
        let is: String = i64_to_string(idx);
        let ids: String = i64_to_string(id);
        emit_bounds_assert(out, idx, s, inst_ty_of(inst_ty_by_id, idx), String::from("string bounds"));
        out.push_str(str5(String::from("  v"), ids,
            String::from(" = (int64_t)(unsigned char)v"), ss,
            str3(String::from(".data[v"), is, String::from("];\n"))));
        out.push_str(str5(String::from("  __ESBMC_assume(v"), ids,
            String::from(" >= 0 && v"), ids, String::from(" <= 255);\n")));
        return;
    }
    if ds == String::from("__vow_string_eq") {
        let a: i64 = iargs[0];
        let b: i64 = iargs[1];
        let ids: String = i64_to_string(id);
        if a == b {
            out.push_str(str3(String::from("  v"), ids, String::from(" = 1;\n")));
        } else {
            let lo: i64 = if a < b { a } else { b };
            let hi: i64 = if a < b { b } else { a };
            let as_: String = i64_to_string(a);
            let bs: String = i64_to_string(b);
            let los: String = i64_to_string(lo);
            let his: String = i64_to_string(hi);
            out.push_str(str5(String::from("  v"), ids,
                String::from(" = (v"), as_, str3(String::from(".len == v"),
                bs, String::from(".len)"))));
            out.push_str(str5(String::from(" ? __str_eq_"), los,
                String::from("_"), his, String::from(" : 0;\n")));
        }
        return;
    }
    if ds == String::from("__vow_string_contains") {
        let h: i64 = iargs[0];
        let n: i64 = iargs[1];
        let hs: String = i64_to_string(h);
        let ns: String = i64_to_string(n);
        let ids: String = i64_to_string(id);
        out.push_str(str3(String::from("  v"), ids, String::from(" = 0;\n")));
        out.push_str(str3(String::from("  if (v"), ns, String::from(".len == 0) { v")));
        out.push_str(cemit_str2(ids, String::from(" = 1; }\n")));
        out.push_str(str5(String::from("  else if (v"), ns,
            String::from(".len <= v"), hs, String::from(".len) {\n")));
        out.push_str(str5(String::from("    for (uint64_t __i = 0; __i <= v"), hs,
            String::from(".len - v"), ns, String::from(".len; __i++) {\n")));
        out.push_str(String::from("      _Bool __match = 1;\n"));
        out.push_str(str3(String::from("      for (uint64_t __j = 0; __j < v"), ns, String::from(".len; __j++) {\n")));
        out.push_str(str6(String::from("        if (v"), hs,
            String::from(".data[__i + __j] != v"), ns,
            String::from(".data[__j]) { __match = 0; break; }\n"),
            String::from("")));
        out.push_str(String::from("      }\n"));
        out.push_str(str3(String::from("      if (__match) { v"), ids, String::from(" = 1; break; }\n")));
        out.push_str(String::from("    }\n"));
        out.push_str(String::from("  }\n"));
        return;
    }
    if ds == String::from("__vow_string_matches_literal_at") {
        let s: i64 = iargs[0];
        let pos: i64 = iargs[1];
        let literal_ptr: i64 = iargs[2];
        let ss: String = i64_to_string(s);
        let ps: String = i64_to_string(pos);
        let ids: String = i64_to_string(id);
        let mut found: bool = false;
        let mut literal: String = String::from("");
        let blocks: Vec<IrBlock> = f.blocks;
        let mut bi: u64 = 0u64;
        while bi < blocks.len() {
            if found { break; }
            let blk: IrBlock = blocks[bi];
            let insts: Vec<IrInst> = blk.insts;
            let mut ii: u64 = 0u64;
            while ii < insts.len() {
                let candidate: IrInst = insts[ii];
                if candidate.id == literal_ptr && candidate.op == IOP_CONST_STR() && candidate.dk == IDATA_CONST_STR() {
                    let strings: Vec<String> = m.strings;
                    if candidate.dv >= 0 && candidate.dv < strings.len() as i64 {
                        literal = strings[candidate.dv as u64];
                        found = true;
                    }
                }
                if found { break; }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
        if !found {
            emit_unmodelled(out, inst);
            return;
        }
        let len: u64 = literal.len();
        out.push_str(str3(String::from("  v"), ids, String::from(" = 0;\n")));
        out.push_str(str5(String::from("  if ((uint64_t)v"), ps, String::from(" <= (uint64_t)v"), ss, String::from(".len && ")));
        out.push_str(str5(i64_to_string(len as i64), String::from("ULL <= (uint64_t)v"), ss, String::from(".len - (uint64_t)v"), ps));
        out.push_str(String::from(") {\n"));
        if len == 0 {
            out.push_str(str3(String::from("    v"), ids, String::from(" = 1;\n")));
        } else {
            out.push_str(String::from("    _Bool __match = 1;\n"));
            let mut j: u64 = 0u64;
            while j < len {
                let byte: i64 = literal.byte_at(j);
                out.push_str(str3(String::from("    if ((unsigned char)v"), ss, String::from(".data[v")));
                out.push_str(str5(ps, String::from(" + "), i64_to_string(j as i64), String::from("] != "), i64_to_string(byte)));
                out.push_str(String::from(") { __match = 0; }\n"));
                j = j + 1;
            }
            out.push_str(str3(String::from("    v"), ids, String::from(" = __match ? 1 : 0;\n")));
        }
        out.push_str(String::from("  }\n"));
        return;
    }
    if ds == String::from("__vow_string_substr") || ds == String::from("__vow_string_substr_in_arena") {
        let s: i64 = iargs[model_arg_index(ds, CARG_OPERAND(0)) as u64];
        let start: i64 = iargs[model_arg_index(ds, CARG_OPERAND(1)) as u64];
        let len: i64 = iargs[model_arg_index(ds, CARG_OPERAND(2)) as u64];
        let ss: String = i64_to_string(s);
        let starts: String = i64_to_string(start);
        let lens: String = i64_to_string(len);
        let ids: String = i64_to_string(id);
        let start_tmp: String = cemit_str2(String::from("__substr_start_"), ids);
        let len_tmp: String = cemit_str2(String::from("__substr_len_"), ids);
        let max_tmp: String = cemit_str2(String::from("__substr_max_len_"), ids);
        out.push_str(str5(String::from("  uint64_t "), start_tmp, String::from(" = (uint64_t)v"), starts, String::from(";\n")));
        out.push_str(str7(String::from("  if ("), start_tmp, String::from(" > (uint64_t)v"), ss, String::from(".len) { "), start_tmp, String::from(" = (uint64_t)v")));
        out.push_str(cemit_str2(ss, String::from(".len; }\n")));
        out.push_str(str5(String::from("  uint64_t "), len_tmp, String::from(" = (uint64_t)v"), lens, String::from(";\n")));
        out.push_str(str5(String::from("  uint64_t "), max_tmp, String::from(" = (uint64_t)v"), ss, String::from(".len - ")));
        out.push_str(cemit_str2(start_tmp, String::from(";\n")));
        out.push_str(str5(String::from("  if ("), len_tmp, String::from(" > "), max_tmp, String::from(") { ")));
        out.push_str(str5(len_tmp, String::from(" = "), max_tmp, String::from("; }\n"), String::from("")));
        out.push_str(str5(String::from("  v"), ids, String::from(".len = "), len_tmp, String::from(";\n")));
        emit_substring_copy(out, f, id, ss, start_tmp, string_max);
        return;
    }
    if ds == String::from("__vow_string_substring") || ds == String::from("__vow_string_substring_in_arena") {
        let s2: i64 = iargs[model_arg_index(ds, CARG_OPERAND(0)) as u64];
        let start2: i64 = iargs[model_arg_index(ds, CARG_OPERAND(1)) as u64];
        let end2: i64 = iargs[model_arg_index(ds, CARG_OPERAND(2)) as u64];
        let ss2: String = i64_to_string(s2);
        let starts2: String = i64_to_string(start2);
        let ends2: String = i64_to_string(end2);
        let ids2: String = i64_to_string(id);
        let start_tmp2: String = cemit_str2(String::from("__substring_start_"), ids2);
        let end_tmp2: String = cemit_str2(String::from("__substring_end_"), ids2);
        out.push_str(str5(String::from("  uint64_t "), start_tmp2, String::from(" = (uint64_t)v"), starts2, String::from(";\n")));
        out.push_str(str7(String::from("  if ("), start_tmp2, String::from(" > (uint64_t)v"), ss2, String::from(".len) { "), start_tmp2, String::from(" = (uint64_t)v")));
        out.push_str(cemit_str2(ss2, String::from(".len; }\n")));
        out.push_str(str5(String::from("  uint64_t "), end_tmp2, String::from(" = (uint64_t)v"), ends2, String::from(";\n")));
        out.push_str(str5(String::from("  if ("), end_tmp2, String::from(" < "), start_tmp2, String::from(") { ")));
        out.push_str(str5(end_tmp2, String::from(" = "), start_tmp2, String::from("; }\n"), String::from("")));
        out.push_str(str7(String::from("  if ("), end_tmp2, String::from(" > (uint64_t)v"), ss2, String::from(".len) { "), end_tmp2, String::from(" = (uint64_t)v")));
        out.push_str(cemit_str2(ss2, String::from(".len; }\n")));
        out.push_str(str5(String::from("  v"), ids2, String::from(".len = "), end_tmp2, String::from(" - ")));
        out.push_str(cemit_str2(start_tmp2, String::from(";\n")));
        emit_substring_copy(out, f, id, ss2, start_tmp2, string_max);
        return;
    }
    if ds == String::from("__vow_string_print") {
        out.push_str(String::from("  /* string print not modelled */\n"));
        return;
    }
    if ds == String::from("__vow_string_parse_i32_opt") {
        emit_narrow_parse_option(out, id, String::from("-2147483648"), String::from("2147483647"));
        return;
    }
    if ds == String::from("__vow_string_parse_u8_opt") {
        emit_narrow_parse_option(out, id, String::from("0"), String::from("255"));
        return;
    }
    if ds == String::from("__vow_string_parse_i8_opt") {
        emit_narrow_parse_option(out, id, String::from("-128"), String::from("127"));
        return;
    }
    if ds == String::from("__vow_string_parse_i16_opt") {
        emit_narrow_parse_option(out, id, String::from("-32768"), String::from("32767"));
        return;
    }
    if ds == String::from("__vow_string_parse_u16_opt") {
        emit_narrow_parse_option(out, id, String::from("0"), String::from("65535"));
        return;
    }
    if ds == String::from("__vow_string_parse_u32_opt") {
        emit_narrow_parse_option(out, id, String::from("0"), String::from("4294967295"));
        return;
    }
    emit_unmodelled(out, inst);
}

fn emit_map_op(out: String, inst: IrInst, hashmap_max: i64) {
    let id: i64 = inst.id;
    let ds: String = inst.ds;
    let iargs: Vec<i64> = inst.args;

    // The leading arena pointer is opaque to the verifier.
    let arg_offset: u64 = model_arg_index(ds, CARG_OPERAND(0)) as u64;

    if ds == String::from("__vow_map_new") || ds == String::from("__vow_map_new_in_arena") {
        let ids: String = i64_to_string(id);
        out.push_str(str3(String::from("  v"), ids, String::from(".len = 0;\n")));
        return;
    }
    if ds == String::from("__vow_map_len") {
        let mp: i64 = iargs[0];
        out.push_str(str5(String::from("  v"), i64_to_string(id),
            String::from(" = v"), i64_to_string(mp), String::from(".len;\n")));
        return;
    }
    if ds == String::from("__vow_map_insert") || ds == String::from("__vow_map_insert_in_arena") {
        let mp: i64 = iargs[arg_offset];
        let k: i64 = iargs[arg_offset + 1];
        let v: i64 = iargs[arg_offset + 2];
        let ms: String = i64_to_string(mp);
        let ks: String = i64_to_string(k);
        let vs: String = i64_to_string(v);
        out.push_str(String::from("  {\n"));
        out.push_str(String::from("    _Bool __found = 0;\n"));
        out.push_str(str3(String::from("    for (uint64_t __i = 0; __i < v"), ms, String::from(".len; __i++) {\n")));
        out.push_str(str6(String::from("      if (v"), ms, String::from(".keys[__i] == v"),
            ks, String::from(") { v"), cemit_str2(ms, String::from(".vals[__i] = v"))));
        out.push_str(cemit_str2(vs, String::from("; __found = 1; break; }\n")));
        out.push_str(String::from("    }\n"));
        out.push_str(String::from("    if (!__found) {\n"));
        out.push_str(str5(String::from("      __ESBMC_assert(v"), ms,
            String::from(".len < "), i64_to_string(hashmap_max), String::from(", \"hashmap capacity\");\n")));
        out.push_str(str6(String::from("      v"), ms, String::from(".keys[v"), ms,
            String::from(".len] = v"), cemit_str2(ks, String::from("; v"))));
        out.push_str(str5(ms, String::from(".vals[v"), ms,
            String::from(".len] = v"), cemit_str2(vs, String::from("; v"))));
        out.push_str(str3(i64_to_string(mp), String::from(".len++;\n"), String::from("")));
        out.push_str(String::from("    }\n"));
        out.push_str(String::from("  }\n"));
        return;
    }
    if ds == String::from("__vow_map_get") || ds == String::from("__vow_map_get_in_arena") {
        let mp: i64 = iargs[arg_offset];
        let k: i64 = iargs[arg_offset + 1];
        let ms: String = i64_to_string(mp);
        let ks: String = i64_to_string(k);
        let ids: String = i64_to_string(id);
        out.push_str(str3(String::from("  v"), ids, String::from(".tag = 0; v")));
        out.push_str(str3(ids, String::from(".payload = 0;\n"), String::from("")));
        out.push_str(str3(String::from("  for (uint64_t __i = 0; __i < v"), ms, String::from(".len; __i++) {\n")));
        out.push_str(str3(String::from("    if (v"), ms, String::from(".keys[__i] == v")));
        out.push_str(str3(ks, String::from(") { v"), ids));
        out.push_str(str3(String::from(".tag = 1; v"), ids, String::from(".payload = v")));
        out.push_str(str3(ms, String::from(".vals[__i]; break; }\n"), String::from("")));
        out.push_str(String::from("  }\n"));
        return;
    }
    if ds == String::from("__vow_map_contains") {
        let mp: i64 = iargs[0];
        let k: i64 = iargs[1];
        let ms: String = i64_to_string(mp);
        let ks: String = i64_to_string(k);
        let ids: String = i64_to_string(id);
        out.push_str(str3(String::from("  v"), ids, String::from(" = 0;\n")));
        out.push_str(str3(String::from("  for (uint64_t __i = 0; __i < v"), ms, String::from(".len; __i++) {\n")));
        out.push_str(str6(String::from("    if (v"), ms, String::from(".keys[__i] == v"),
            ks, String::from(") { v"), cemit_str2(ids, String::from(" = 1; break; }\n"))));
        out.push_str(String::from("  }\n"));
        return;
    }
    if ds == String::from("__vow_map_remove") || ds == String::from("__vow_map_remove_in_arena") {
        let mp: i64 = iargs[arg_offset];
        let k: i64 = iargs[arg_offset + 1];
        let ms: String = i64_to_string(mp);
        let ks: String = i64_to_string(k);
        out.push_str(str3(String::from("  for (uint64_t __i = 0; __i < v"), ms, String::from(".len; __i++) {\n")));
        out.push_str(str4(String::from("    if (v"), ms, String::from(".keys[__i] == v"),
            cemit_str2(ks, String::from(") {\n"))));
        out.push_str(str5(String::from("      v"), ms, String::from(".keys[__i] = v"), ms,
            cemit_str2(String::from(".keys[v"), ms)));
        out.push_str(String::from(".len - 1];\n"));
        out.push_str(str5(String::from("      v"), ms, String::from(".vals[__i] = v"), ms,
            cemit_str2(String::from(".vals[v"), ms)));
        out.push_str(String::from(".len - 1];\n"));
        out.push_str(str3(String::from("      v"), ms, String::from(".len--;\n")));
        out.push_str(String::from("      break;\n"));
        out.push_str(String::from("    }\n"));
        out.push_str(String::from("  }\n"));
        return;
    }
    emit_unmodelled(out, inst);
}

fn emit_btreemap_op(out: String, inst: IrInst, btreemap_max: i64) {
    let id: i64 = inst.id;
    let ds: String = inst.ds;
    let iargs: Vec<i64> = inst.args;
    let ids: String = i64_to_string(id);

    if ds == String::from("__vow_btreemap_new") {
        out.push_str(str3(String::from("  v"), ids, String::from(".len = 0;\n")));
        return;
    }
    if ds == String::from("__vow_btreemap_len") {
        let mp: i64 = iargs[0];
        out.push_str(str5(String::from("  v"), ids,
            String::from(" = v"), i64_to_string(mp), String::from(".len;\n")));
        return;
    }
    if ds == String::from("__vow_btreemap_insert") {
        let mp: i64 = iargs[0];
        let k: i64 = iargs[1];
        let v: i64 = iargs[2];
        let ms: String = i64_to_string(mp);
        let ks: String = i64_to_string(k);
        let vs: String = i64_to_string(v);
        let bms: String = i64_to_string(btreemap_max);
        out.push_str(str3(String::from("  v"), ids, String::from(".tag = 0; v")));
        out.push_str(str3(ids, String::from(".payload = 0;\n"), String::from("")));
        out.push_str(String::from("  {\n"));
        out.push_str(String::from("    _Bool __found = 0;\n"));
        out.push_str(str3(String::from("    uint64_t __pos = v"), ms, String::from(".len;\n")));
        out.push_str(str3(String::from("    for (uint64_t __i = 0; __i < v"), ms, String::from(".len; __i++) {\n")));
        out.push_str(str3(String::from("      if (v"), ms, String::from(".keys[__i] == v")));
        out.push_str(str3(ks, String::from(") { v"), ids));
        out.push_str(str3(String::from(".tag = 1; v"), ids, String::from(".payload = v")));
        out.push_str(str3(ms, String::from(".vals[__i]; v"), ms));
        out.push_str(str3(String::from(".vals[__i] = v"), vs, String::from("; __found = 1; break; }\n")));
        out.push_str(str3(String::from("      if (v"), ms, String::from(".keys[__i] > v")));
        out.push_str(cemit_str2(ks, String::from(") { __pos = __i; break; }\n")));
        out.push_str(String::from("    }\n"));
        out.push_str(String::from("    if (!__found) {\n"));
        out.push_str(str5(String::from("      __ESBMC_assert(v"), ms,
            String::from(".len < "), bms, String::from(", \"btreemap capacity\");\n")));
        out.push_str(str3(String::from("      for (uint64_t __j = v"), ms, String::from(".len; __j > __pos; __j--) {\n")));
        out.push_str(str3(String::from("        v"), ms, String::from(".keys[__j] = v")));
        out.push_str(str3(ms, String::from(".keys[__j - 1]; v"), ms));
        out.push_str(str3(String::from(".vals[__j] = v"), ms, String::from(".vals[__j - 1];\n")));
        out.push_str(String::from("      }\n"));
        out.push_str(str3(String::from("      v"), ms, String::from(".keys[__pos] = v")));
        out.push_str(str3(ks, String::from("; v"), ms));
        out.push_str(str3(String::from(".vals[__pos] = v"), vs, String::from(";\n")));
        out.push_str(str3(String::from("      v"), ms, String::from(".len++;\n")));
        out.push_str(String::from("    }\n"));
        out.push_str(String::from("  }\n"));
        return;
    }
    if ds == String::from("__vow_btreemap_get") {
        let mp: i64 = iargs[0];
        let k: i64 = iargs[1];
        let ms: String = i64_to_string(mp);
        let ks: String = i64_to_string(k);
        out.push_str(str3(String::from("  v"), ids, String::from(".tag = 0; v")));
        out.push_str(str3(ids, String::from(".payload = 0;\n"), String::from("")));
        out.push_str(str3(String::from("  for (uint64_t __i = 0; __i < v"), ms, String::from(".len; __i++) {\n")));
        out.push_str(str3(String::from("    if (v"), ms, String::from(".keys[__i] == v")));
        out.push_str(str3(ks, String::from(") { v"), ids));
        out.push_str(str3(String::from(".tag = 1; v"), ids, String::from(".payload = v")));
        out.push_str(str3(ms, String::from(".vals[__i]; break; }\n"), String::from("")));
        out.push_str(str3(String::from("    if (v"), ms, String::from(".keys[__i] > v")));
        out.push_str(cemit_str2(ks, String::from(") { break; }\n")));
        out.push_str(String::from("  }\n"));
        return;
    }
    if ds == String::from("__vow_btreemap_contains") {
        let mp: i64 = iargs[0];
        let k: i64 = iargs[1];
        let ms: String = i64_to_string(mp);
        let ks: String = i64_to_string(k);
        out.push_str(str3(String::from("  v"), ids, String::from(" = 0;\n")));
        out.push_str(str3(String::from("  for (uint64_t __i = 0; __i < v"), ms, String::from(".len; __i++) {\n")));
        out.push_str(str3(String::from("    if (v"), ms, String::from(".keys[__i] == v")));
        out.push_str(str3(ks, String::from(") { v"), ids));
        out.push_str(String::from(" = 1; break; }\n"));
        out.push_str(str3(String::from("    if (v"), ms, String::from(".keys[__i] > v")));
        out.push_str(cemit_str2(ks, String::from(") { break; }\n")));
        out.push_str(String::from("  }\n"));
        return;
    }
    emit_unmodelled(out, inst);
}

fn emit_c_function(out: String, f: IrFunction, const_fn_indices: Vec<i64>, modelable_fi_set: Vec<i64>, m: IrModule,
                   vec_max: i64, string_max: i64, hashmap_max: i64, btreemap_max: i64,
                   reach_label: bool, body_replace: bool, requires_as_assert: i64) {
    let vec_vars: Vec<i64> = collect_vec_vars(f);
    let string_vars: Vec<i64> = collect_string_vars(f);
    let hashmap_vars: Vec<i64> = collect_hashmap_vars(f);
    let btreemap_vars: Vec<i64> = collect_btreemap_vars(f);
    let option_vars: Vec<i64> = collect_option_vars(f);

    let ret_c: String = {
        if f.return_ty == ITY_UNIT() {
            String::from("void")
        } else if f.return_ty == ITY_PTR() || f.return_ty == ITY_LPTR() {
            String::from("int64_t")
        } else {
            ir_ty_to_c(f.return_ty)
        }
    };

    let params_list: String = String::from("");
    let param_tys: Vec<i64> = f.params;
    let n_params: u64 = param_tys.len();
    let arg_map_ir: Vec<i64> = Vec::new();
    let arg_map_cl: Vec<i64> = Vec::new();
    let mut cl_idx: i64 = 0;
    let mut pi: u64 = 0u64;
    while pi < n_params {
        let pty: i64 = param_tys[pi];
        if pty != ITY_UNIT() {
            if cl_idx > 0 { params_list.push_str(String::from(", ")); }
            let p_c: String = {
                if pty == ITY_PTR() || pty == ITY_LPTR() {
                    String::from("int64_t")
                } else {
                    ir_ty_to_c(pty)
                }
            };
            params_list.push_str(p_c);
            params_list.push_str(cemit_str2(String::from(" p"), i64_to_string(cl_idx)));
            arg_map_ir.push(pi as i64);
            arg_map_cl.push(cl_idx);
            cl_idx = cl_idx + 1;
        }
        pi = pi + 1;
    }

    let param_str: String = if cl_idx == 0 { String::from("void") } else { params_list };
    out.push_str(str5(ret_c, String::from(" "), verifier_c_func_name(f), String::from("("), str3(param_str, String::from(") {\n"), String::from(""))));

    let blocks: Vec<IrBlock> = f.blocks;
    let inst_ty_by_id: Vec<i64> = build_inst_ty_by_id(f);
    let const_value_by_id: Vec<i64> = build_const_value_by_id(f, m, const_fn_indices);
    let n_blocks: u64 = blocks.len();
    let const_str_ids: Vec<i64> = Vec::new();
    let const_str_idxs: Vec<i64> = Vec::new();

    let mut bi: u64 = 0u64;
    while bi < n_blocks {
        let blk: IrBlock = blocks[bi];
        let insts: Vec<IrInst> = blk.insts;
        let mut ii: u64 = 0u64;
        while ii < insts.len() {
            let inst: IrInst = insts[ii];
            if inst.op == IOP_CONST_STR() && inst.dk == IDATA_CONST_STR() {
                const_str_ids.push(inst.id);
                const_str_idxs.push(inst.dv);
            }
            if inst.op == IOP_GET_ARG() && inst.dk == IDATA_ARG_INDEX() {
                let arg_idx: i64 = inst.dv;
                let iid: i64 = inst.id;
                let mut found_cl: i64 = -1;
                let mut ai: u64 = 0u64;
                while ai < arg_map_ir.len() {
                    if arg_map_ir[ai] == arg_idx {
                        found_cl = arg_map_cl[ai];
                    }
                    ai = ai + 1;
                }
                if found_cl >= 0 {
                    let kind: i64 = typed_collection_kind(iid, vec_vars, string_vars, hashmap_vars, btreemap_vars);
                    if kind >= 0 {
                        let lead: String = str5(String::from("  __vow_"), model_bound_slug(kind), String::from("_t v"), i64_to_string(iid), String::from(";\n  "));
                        emit_nondet_collection_len(out, iid, kind, model_bound_cap(kind, vec_max, string_max, hashmap_max, btreemap_max), lead);
                    } else {
                        let c_ty: String = {
                            if inst.ty == ITY_PTR() || inst.ty == ITY_LPTR() {
                                String::from("int64_t")
                            } else {
                                ir_ty_to_c(inst.ty)
                            }
                        };
                        out.push_str(str6(String::from("  "), c_ty, String::from(" v"),
                            i64_to_string(iid), String::from(" = p"),
                            cemit_str2(i64_to_string(found_cl), String::from(";\n"))));
                    }
                } else {
                    out.push_str(str3(String::from("  int32_t v"), i64_to_string(iid),
                        String::from(" = 0; /* unit arg */\n")));
                }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }

    bi = 0u64;
    while bi < n_blocks {
        let blk: IrBlock = blocks[bi];
        let insts: Vec<IrInst> = blk.insts;
        let mut ii: u64 = 0u64;
        while ii < insts.len() {
            let inst: IrInst = insts[ii];
            if inst.op == IOP_GET_ARG() || inst.op == IOP_UPSILON()
               || iop_is_terminal(inst.op)
               || inst.op == IOP_VOW_REQ() || inst.op == IOP_VOW_ENS() || inst.op == IOP_VOW_INV() {
                ii = ii + 1;
            } else if inst.ty == ITY_UNIT() && inst.op != IOP_CONST_UNIT() && inst.op != IOP_PHI() {
                ii = ii + 1;
            } else {
                let iid: i64 = inst.id;
                if vec_contains_i64(vec_vars, iid) {
                    out.push_str(str3(String::from("  __vow_vec_t v"), i64_to_string(iid), String::from(";\n")));
                } else if vec_contains_i64(string_vars, iid) {
                    out.push_str(str3(String::from("  __vow_string_t v"), i64_to_string(iid), String::from(";\n")));
                } else if vec_contains_i64(hashmap_vars, iid) {
                    out.push_str(str3(String::from("  __vow_hashmap_t v"), i64_to_string(iid), String::from(";\n")));
                } else if vec_contains_i64(btreemap_vars, iid) {
                    out.push_str(str3(String::from("  __vow_btreemap_t v"), i64_to_string(iid), String::from(";\n")));
                } else if vec_contains_i64(option_vars, iid) {
                    out.push_str(str3(String::from("  __vow_option_t v"), i64_to_string(iid), String::from(";\n")));
                } else {
                    let c_ty: String = {
                        if inst.ty == ITY_UNIT() {
                            String::from("int32_t")
                        } else if inst.ty == ITY_PTR() || inst.ty == ITY_LPTR() {
                            String::from("int64_t")
                        } else {
                            ir_ty_to_c(inst.ty)
                        }
                    };
                    out.push_str(str4(String::from("  "), c_ty,
                        String::from(" v"), cemit_str2(i64_to_string(iid), String::from(";\n"))));
                }
                ii = ii + 1;
            }
        }
        bi = bi + 1;
    }

    // User-struct heap model: a per-function slot array + bump pointer, emitted
    // only when the body has struct allocation/field ops. Pointers are int64
    // slot indices, so equal addresses alias the same slots (sound aliasing).
    let mut needs_heap: bool = false;
    bi = 0u64;
    while bi < n_blocks {
        let hblk: IrBlock = blocks[bi];
        let hinsts: Vec<IrInst> = hblk.insts;
        let mut hi: u64 = 0u64;
        while hi < hinsts.len() {
            let hinst: IrInst = hinsts[hi];
            let hop: i64 = hinst.op;
            if hop == IOP_REGION_ALLOC() || hop == IOP_FIELD_SET() {
                needs_heap = true;
            } else if hop == IOP_FIELD_GET() {
                let hid: i64 = hinst.id;
                let hargs: Vec<i64> = hinst.args;
                let is_coll: bool = vec_contains_i64(vec_vars, hid)
                    || vec_contains_i64(string_vars, hid)
                    || vec_contains_i64(hashmap_vars, hid)
                    || vec_contains_i64(btreemap_vars, hid)
                    || (hargs.len() > 0 && vec_contains_i64(option_vars, hargs[0]));
                if !is_coll {
                    needs_heap = true;
                }
            }
            hi = hi + 1;
        }
        bi = bi + 1;
    }
    if needs_heap {
        out.push_str(str3(String::from("  int64_t __vow_heap["),
            i64_to_string(VOW_HEAP_MAX()), String::from("];\n")));
        out.push_str(String::from("  int64_t __vow_heap_top = 0;\n"));
    }

    let ups_sources: Vec<i64> = Vec::new();
    bi = 0u64;
    while bi < n_blocks {
        let blk: IrBlock = blocks[bi];
        let insts: Vec<IrInst> = blk.insts;
        let mut ii: u64 = 0u64;
        while ii < insts.len() {
            let inst: IrInst = insts[ii];
            if inst.op == IOP_UPSILON() && inst.dk == IDATA_PHI_TARGET() {
                let u_args: Vec<i64> = inst.args;
                if u_args.len() > 0 {
                    let src_val: i64 = u_args[0];
                    if src_val >= 0 {
                        vec_insert_i64(ups_sources, src_val);
                    }
                }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    let mut ui: u64 = 0u64;
    while ui < ups_sources.len() {
        let src: i64 = ups_sources[ui];
        // Upsilon temps must share the source's struct type; struct-to-int64 assignment corrupts the payload.
        if vec_contains_i64(option_vars, src) {
            out.push_str(str3(String::from("  __vow_option_t __ups_"), i64_to_string(src), String::from(";\n")));
        } else if vec_contains_i64(vec_vars, src) {
            out.push_str(str3(String::from("  __vow_vec_t __ups_"), i64_to_string(src), String::from(";\n")));
        } else if vec_contains_i64(string_vars, src) {
            out.push_str(str3(String::from("  __vow_string_t __ups_"), i64_to_string(src), String::from(";\n")));
        } else if vec_contains_i64(hashmap_vars, src) {
            out.push_str(str3(String::from("  __vow_hashmap_t __ups_"), i64_to_string(src), String::from(";\n")));
        } else if vec_contains_i64(btreemap_vars, src) {
            out.push_str(str3(String::from("  __vow_btreemap_t __ups_"), i64_to_string(src), String::from(";\n")));
        } else {
            out.push_str(str3(String::from("  int64_t __ups_"), i64_to_string(src), String::from(";\n")));
        }
        ui = ui + 1;
    }

    // Per-pair nondet cache for abstract __vow_string_eq. Mirrors the Rust
    // emitter: one shared _Bool per unordered (a, b) pair ensures repeated
    // comparisons of the same pair agree, and emit_string_eq_invalidate
    // re-samples the entry after each modeled mutation on either operand.
    let eq_lo: Vec<i64> = Vec::new();
    let eq_hi: Vec<i64> = Vec::new();
    compute_string_eq_pairs(blocks, eq_lo, eq_hi);
    let mut ei: u64 = 0u64;
    while ei < eq_lo.len() {
        out.push_str(str5(String::from("  _Bool __str_eq_"), i64_to_string(eq_lo[ei]),
            String::from("_"), i64_to_string(eq_hi[ei]),
            String::from(" = __VERIFIER_nondet_bool();\n")));
        ei = ei + 1;
    }

    bi = 0u64;
    while bi < n_blocks {
        let blk: IrBlock = blocks[bi];
        out.push_str(str3(String::from("  int __blk_"), i64_to_string(blk.id), String::from(" = 0;\n")));
        bi = bi + 1;
    }

    let first_block_id: i64 = {
        if n_blocks > 0 {
            let fb: IrBlock = blocks[0];
            fb.id
        } else {
            -1
        }
    };

    // Weakness detection (#81 PR-C): in body-replace mode, `result_after` is the
    // id of the value the `Return` yields (which the `ensures` predicate also
    // references). After that instruction is emitted, the result is overwritten
    // with the type-default, so each `ensures` is checked against a trivial
    // `return 0` body. Callers only set `body_replace` when this value is a
    // regular scalar instruction (see verifier.vow eligibility).
    let mut result_after: i64 = -1;
    if body_replace {
        let mut rbi: u64 = 0u64;
        while rbi < n_blocks {
            let rblk: IrBlock = blocks[rbi];
            let rinsts: Vec<IrInst> = rblk.insts;
            let mut rii: u64 = 0u64;
            while rii < rinsts.len() {
                let rinst: IrInst = rinsts[rii];
                // Match Rust's `.find()` (vow-verify/src/c_emitter.rs): take the
                // FIRST `Return`, then stop. A trailing scan keeps the LAST
                // return's value, diverging from Rust for multi-return IR.
                if rinst.op == IOP_RETURN() {
                    let rargs: Vec<i64> = rinst.args;
                    if rargs.len() > 0 {
                        result_after = rargs[0];
                        rii = rinsts.len();
                        rbi = n_blocks;
                    }
                }
                rii = rii + 1;
            }
            rbi = rbi + 1;
        }
    }

    bi = 0u64;
    while bi < n_blocks {
        let blk: IrBlock = blocks[bi];
        if blk.id != first_block_id {
            out.push_str(str3(String::from("block"), i64_to_string(blk.id), String::from(":;\n")));
        }
        out.push_str(str3(String::from("  __blk_"), i64_to_string(blk.id), String::from(" = 1;\n")));

        let insts: Vec<IrInst> = blk.insts;
        let regular: Vec<i64> = Vec::new();
        let ups_phi: Vec<i64> = Vec::new();
        let ups_src: Vec<i64> = Vec::new();
        let mut terminal_idx: i64 = -1;
        let mut ii: u64 = 0u64;
        while ii < insts.len() {
            let inst: IrInst = insts[ii];
            if inst.op == IOP_GET_ARG() {
                ii = ii + 1;
            } else if inst.op == IOP_UPSILON() {
                if inst.dk == IDATA_PHI_TARGET() {
                    let u_args: Vec<i64> = inst.args;
                    if u_args[0] >= 0 {
                        ups_phi.push(inst.dv);
                        ups_src.push(u_args[0]);
                    }
                }
                ii = ii + 1;
            } else if iop_is_terminal(inst.op) {
                terminal_idx = ii as i64;
                ii = ii + 1;
            } else {
                regular.push(ii as i64);
                ii = ii + 1;
            }
        }

        // Vacuity detection (#81 PR-B): in reach mode, plant the `vow_reach`
        // label right after the last `requires` assume in the entry block. The
        // label is reachable iff the preconditions are satisfiable; ESBMC
        // `--error-label vow_reach` maps unreachable -> contradictory requires ->
        // vacuous. Placing it after the requires prefix (not the function end)
        // keeps body divergence from making the label spuriously unreachable.
        let mut reach_after_idx: i64 = -1;
        if reach_label && blk.id == first_block_id {
            let mut qi: u64 = 0u64;
            while qi < insts.len() {
                let qinst: IrInst = insts[qi];
                if qinst.op == IOP_VOW_REQ() {
                    reach_after_idx = qi as i64;
                }
                qi = qi + 1;
            }
        }

        let mut ri: u64 = 0u64;
        while ri < regular.len() {
            let inst: IrInst = insts[regular[ri] as u64];
            emit_inst(out, inst, f, inst_ty_by_id, const_value_by_id, vec_vars, string_vars, hashmap_vars, btreemap_vars, option_vars, const_fn_indices, modelable_fi_set, m, const_str_ids, const_str_idxs, eq_lo, eq_hi, vec_max, string_max, hashmap_max, btreemap_max, requires_as_assert);
            if regular[ri] == reach_after_idx {
                out.push_str(String::from("vow_reach:;\n"));
            }
            if body_replace && inst.id == result_after {
                out.push_str(str3(String::from("  v"), i64_to_string(result_after), String::from(" = 0;\n")));
            }
            ri = ri + 1;
        }

        if ups_phi.len() > 0 {
            let mut ui: u64 = 0u64;
            while ui < ups_src.len() {
                let src: i64 = ups_src[ui];
                out.push_str(str5(String::from("  __ups_"), i64_to_string(src),
                    String::from(" = v"), i64_to_string(src), String::from(";\n")));
                ui = ui + 1;
            }
            ui = 0u64;
            while ui < ups_phi.len() {
                let phi: i64 = ups_phi[ui];
                let src: i64 = ups_src[ui];
                out.push_str(str5(String::from("  v"), i64_to_string(phi),
                    String::from(" = __ups_"), i64_to_string(src), String::from(";\n")));
                ui = ui + 1;
            }
        }

        if terminal_idx >= 0 {
            let term: IrInst = insts[terminal_idx as u64];
            emit_inst(out, term, f, inst_ty_by_id, const_value_by_id, vec_vars, string_vars, hashmap_vars, btreemap_vars, option_vars, const_fn_indices, modelable_fi_set, m, const_str_ids, const_str_idxs, eq_lo, eq_hi, vec_max, string_max, hashmap_max, btreemap_max, requires_as_assert);
        }

        bi = bi + 1;
    }

    out.push_str(String::from("}\n"));
}

// ---------------------------------------------------------------------------
// Checked-arithmetic abort model (#585)
// ---------------------------------------------------------------------------
// Mirror of `vow_verify::c_emitter`'s checked-arithmetic model. Vow's checked
// operators abort with `ArithmeticOverflow` rather than wrapping, so each site
// carries a no-overflow guard emitted twice: as an `__ESBMC_assert` (a reachable
// abort is a real behaviour and must not be silently proven away) and as an
// `__ESBMC_assume` (an overflowing execution aborts, so it never returns and
// cannot witness an `ensures`). The two emitters must stay byte-identical —
// `full_test.sh` Sections 4b/4c run every `tests/verify*` through both with
// `compare_json`.

// Preprocessor macro that compiles the `arith:` asserts out, leaving the
// contract properties as the only checkable ones. Mirrors
// `ARITH_ASSERT_SUPPRESS_MACRO`; it is a wire format shared by both compilers.
fn arith_assert_suppress_macro() -> String {
    String::from("VOW_NO_ARITH_ASSERT")
}

// The three checked opcodes that need a generated guard helper. `/!` and `%!`
// guards are single comparisons, emitted inline.
fn arith_helper_op_at(index: i64) -> i64 {
    if index == 0 { return IOP_CADD(); }
    if index == 1 { return IOP_CSUB(); }
    IOP_CMUL()
}

// The integer widths the model covers. 128-bit is deliberately absent: it has no
// guard, so `is_modelable` rejects it and the function is reported `Skipped`
// rather than reverting to the wrapping model.
fn arith_helper_ty_at(index: i64) -> i64 {
    if index == 0 { return ITY_I8(); }
    if index == 1 { return ITY_U8(); }
    if index == 2 { return ITY_I16(); }
    if index == 3 { return ITY_U16(); }
    if index == 4 { return ITY_I32(); }
    if index == 5 { return ITY_U32(); }
    if index == 6 { return ITY_I64(); }
    ITY_U64()
}

fn arith_ty_is_modelled(ty: i64) -> bool {
    ty == ITY_I8() || ty == ITY_U8() || ty == ITY_I16() || ty == ITY_U16() ||
    ty == ITY_I32() || ty == ITY_U32() || ty == ITY_I64() || ty == ITY_U64()
}

fn arith_ty_is_signed(ty: i64) -> bool {
    ty == ITY_I8() || ty == ITY_I16() || ty == ITY_I32() || ty == ITY_I64()
}

fn arith_ty_bits(ty: i64) -> i64 {
    if ty == ITY_I8() || ty == ITY_U8() { return 8; }
    if ty == ITY_I16() || ty == ITY_U16() { return 16; }
    if ty == ITY_I32() || ty == ITY_U32() { return 32; }
    64
}

// The abort cause names carried in the `arith:<cause>:<start>:<len>` label.
// Parsed back by `parse_arith_label`; renaming one breaks the diagnostic.
fn arith_cause_add() -> String { String::from("add") }
fn arith_cause_sub() -> String { String::from("sub") }
fn arith_cause_mul() -> String { String::from("mul") }
fn arith_cause_div_zero() -> String { String::from("div-zero") }
fn arith_cause_div_overflow() -> String { String::from("div-overflow") }

fn arith_cause_is_known(cause: String) -> bool {
    cause == arith_cause_add() || cause == arith_cause_sub() || cause == arith_cause_mul() ||
    cause == arith_cause_div_zero() || cause == arith_cause_div_overflow()
}

fn arith_op_cause(target_op: i64) -> String {
    if target_op == IOP_CADD() { return arith_cause_add(); }
    if target_op == IOP_CSUB() { return arith_cause_sub(); }
    arith_cause_mul()
}

// Largest value of `ty` as a C expression. Written as literals rather than
// <limits.h> macros so the emitted model stays self-contained. `u64`'s maximum
// does not fit in `i64`, so the digits are spelled out per type.
fn arith_max_digits(ty: i64) -> String {
    if ty == ITY_I8() { return String::from("127"); }
    if ty == ITY_U8() { return String::from("255"); }
    if ty == ITY_I16() { return String::from("32767"); }
    if ty == ITY_U16() { return String::from("65535"); }
    if ty == ITY_I32() { return String::from("2147483647"); }
    if ty == ITY_U32() { return String::from("4294967295"); }
    if ty == ITY_I64() { return String::from("9223372036854775807"); }
    String::from("18446744073709551615")
}

fn arith_max_literal(ty: i64) -> String {
    let out: String = String::from("((");
    out.push_str(ir_ty_to_c(ty));
    out.push_str(String::from(")"));
    out.push_str(arith_max_digits(ty));
    if arith_ty_is_signed(ty) { out.push_str(String::from("LL")); }
    else { out.push_str(String::from("ULL")); }
    out.push_str(String::from(")"));
    out
}

// `MIN` is spelled `(-MAX - 1)` because the most negative literal is not a valid
// C integer literal (it parses as a negated unsigned long long).
fn arith_min_literal(ty: i64) -> String {
    if arith_ty_is_signed(ty) {
        let out: String = String::from("(-");
        out.push_str(arith_max_literal(ty));
        out.push_str(String::from(" - 1)"));
        return out;
    }
    let out: String = String::from("((");
    out.push_str(ir_ty_to_c(ty));
    out.push_str(String::from(")0)"));
    out
}

fn arith_helper_name(target_op: i64, target_ty: i64) -> String {
    let prefix: String = if arith_ty_is_signed(target_ty) { String::from("i") } else { String::from("u") };
    let out: String = String::from("__vow_ovf_");
    out.push_str(arith_op_cause(target_op));
    out.push_str(String::from("_"));
    out.push_str(prefix);
    out.push_str(i64_to_string(arith_ty_bits(target_ty)));
    out
}

// Emits one `__vow_ovf_{add,sub,mul}_{i,u}<bits>` predicate: `true` when the
// operation would overflow, i.e. when the real program would abort.
//
// Every guard is itself overflow-free in C, so the model never trips a nested
// obligation on its own arithmetic: the `MAX - b` / `MIN - b` forms are only
// evaluated for the sign of `b` that keeps them in range, and the multiply form
// special-cases 0 and -1 before dividing so it never evaluates `MIN / -1`.
fn cemit_arith_overflow_helper(target_op: i64, target_ty: i64) -> String {
    let c_ty: String = ir_ty_to_c(target_ty);
    let max: String = arith_max_literal(target_ty);
    let min: String = arith_min_literal(target_ty);
    let out: String = String::from("static inline _Bool ");
    out.push_str(arith_helper_name(target_op, target_ty));
    out.push_str(String::from("("));
    out.push_str(c_ty);
    out.push_str(String::from(" a, "));
    out.push_str(c_ty);
    out.push_str(String::from(" b) {\n"));
    if arith_ty_is_signed(target_ty) {
        if target_op == IOP_CADD() {
            out.push_str(str5(String::from("  if (b > 0) return a > "), max, String::from(" - b;\n  if (b < 0) return a < "), min, String::from(" - b;\n  return 0;\n")));
        } else if target_op == IOP_CSUB() {
            out.push_str(str5(String::from("  if (b > 0) return a < "), min, String::from(" + b;\n  if (b < 0) return a > "), max, String::from(" + b;\n  return 0;\n")));
        } else {
            out.push_str(String::from("  if (a == 0 || b == 0) return 0;\n"));
            out.push_str(str3(String::from("  if (a == -1) return b == "), min, String::from(";\n")));
            out.push_str(str3(String::from("  if (b == -1) return a == "), min, String::from(";\n")));
            out.push_str(str5(String::from("  if (a > 0) return b > 0 ? a > "), max, String::from(" / b : b < "), min, String::from(" / a;\n")));
            out.push_str(str5(String::from("  return b > 0 ? a < "), min, String::from(" / b : a < "), max, String::from(" / b;\n")));
        }
    } else if target_op == IOP_CADD() {
        out.push_str(str3(String::from("  return a > "), max, String::from(" - b;\n")));
    } else if target_op == IOP_CSUB() {
        out.push_str(String::from("  return a < b;\n"));
    } else {
        out.push_str(str3(String::from("  return b != 0 && a > "), max, String::from(" / b;\n")));
    }
    out.push_str(String::from("}\n"));
    out
}

fn func_has_checked_arith_op(f: IrFunction, target_op: i64, target_ty: i64) -> i64 {
    let blocks: Vec<IrBlock> = f.blocks;
    let mut bi: u64 = 0u64;
    while bi < blocks.len() {
        let blk: IrBlock = blocks[bi];
        let insts: Vec<IrInst> = blk.insts;
        let mut ii: u64 = 0u64;
        while ii < insts.len() {
            let inst: IrInst = insts[ii];
            if inst.op == target_op && checked_arith_ty(inst) == target_ty {
                return 1;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    0
}

// The integer type of a checked-arithmetic site. `IDATA_INTEGER` is what the
// lowerer attaches; the `inst.ty` fallback keeps a hand-built or deserialized IR
// working. Returns `ITY_UNIT()` when the site is not a modelled integer op —
// 128-bit widths included, which the `is_modelable` gate rejects so the function
// is reported `Skipped` rather than modelled with the wrong guard.
fn checked_arith_ty(inst: IrInst) -> i64 {
    let from_data: i64 = if inst.dk == IDATA_INTEGER() { inst.dv } else { inst.ty };
    if arith_ty_is_modelled(from_data) { return from_data; }
    ITY_UNIT()
}

// One `arith:<cause>:<start>:<len>` assert line.
// `owner` is the id of the function this instruction belongs to — not always
// the verify target, since a model co-emits its modelable callees. Spans are
// file-relative, so without it the diagnostic would name the target and resolve
// the span against the target's file.
fn cemit_arith_assert(out: String, guard: String, cause: String, owner: i64, ostart: i64, olen: i64) {
    let tail: String = str5(
        i64_to_string(owner), String::from(":"), i64_to_string(ostart),
        String::from(":"), i64_to_string(olen)
    );
    out.push_str(str7(
        String::from("  __ESBMC_assert("), guard, String::from(", \"arith:"),
        cause, String::from(":"), tail,
        String::from("\");\n")
    ));
}

fn cemit_arith_assume(out: String, guard: String) {
    out.push_str(str3(String::from("  __ESBMC_assume("), guard, String::from(");\n")));
}

// Emits the abort-on-overflow model for one checked-arithmetic instruction.
//
// The assert precedes the assume so ESBMC checks the property on the unpruned
// state. The asserts are compiled out under `arith_assert_suppress_macro()`,
// which is how the contract-only projection is produced from the same emitted
// text; the assumes are never suppressed, because they *are* the abort
// semantics.
fn emit_checked_arith(out: String, inst: IrInst, iargs: Vec<i64>, owner: i64) {
    let ty: i64 = checked_arith_ty(inst);
    if ty == ITY_UNIT() {
        // 128-bit and non-integer checked arithmetic is rejected by the
        // `is_modelable` gate, so the function never reaches the emitter. Fail
        // closed rather than emit a guard for the wrong width.
        emit_unsupported_for_verification(out, inst);
        return;
    }
    let op: i64 = inst.op;
    let a: i64 = iargs[0];
    let b: i64 = iargs[1];
    let va: String = cemit_str2(String::from("v"), i64_to_string(a));
    let vb: String = cemit_str2(String::from("v"), i64_to_string(b));

    // Guard expressions and their causes, in emission order.
    let is_div_form: bool = op == IOP_CDIV() || op == IOP_CREM();
    let signed_div: bool = op == IOP_CDIV() && arith_ty_is_signed(ty);
    let guard0: String = if is_div_form {
        cemit_str2(vb, String::from(" != 0"))
    } else {
        str5(String::from("!"), arith_helper_name(op, ty), String::from("("), va, cemit_str2(String::from(", "), cemit_str2(vb, String::from(")"))))
    };
    let cause0: String = if is_div_form { arith_cause_div_zero() } else { arith_op_cause(op) };
    // Cranelift's `sdiv` traps on MIN / -1 at every width, and the routed
    // 128-bit path reproduces it, so `/!` aborts there too. `%!` does not:
    // `MIN % -1` is 0 (docs/spec/grammar.md).
    let guard1: String = if signed_div {
        str5(String::from("!("), va, cemit_str2(String::from(" == "), arith_min_literal(ty)), cemit_str2(String::from(" && "), vb), String::from(" == -1)"))
    } else {
        String::from("")
    };

    out.push_str(str3(String::from("#ifndef "), arith_assert_suppress_macro(), String::from("\n")));
    cemit_arith_assert(out, guard0, cause0, owner, inst.ostart, inst.olen);
    if signed_div {
        cemit_arith_assert(out, guard1, arith_cause_div_overflow(), owner, inst.ostart, inst.olen);
    }
    out.push_str(String::from("#endif\n"));
    cemit_arith_assume(out, guard0);
    if signed_div {
        cemit_arith_assume(out, guard1);
    }

    let c_op: String = if op == IOP_CADD() { String::from("+") }
        else if op == IOP_CSUB() { String::from("-") }
        else if op == IOP_CMUL() { String::from("*") }
        else if op == IOP_CDIV() { String::from("/") }
        else { String::from("%") };
    emit_binop(out, inst.ty, inst.id, a, b, c_op);
}

// Project an emitted model onto its contract obligations alone, by defining the
// suppression macro. Mirrors `vow_verify::c_emitter::contracts_only_source`.
//
// ESBMC reports one violated property per run, so a function whose checked
// arithmetic can abort would otherwise mask its own contract verdict. Only the
// asserts are suppressed, never the assumes, so the verdict this yields is the
// verdict on returning executions — exactly what a contract constrains.
fn contracts_only_source(c_src: String) -> String {
    let out: String = String::from("#define ");
    out.push_str(arith_assert_suppress_macro());
    out.push_str(String::from(" 1\n"));
    out.push_str(c_src);
    out
}

fn func_has_integer_shift_op(f: IrFunction, target_op: i64, target_ty: i64) -> i64 {
    let blocks: Vec<IrBlock> = f.blocks;
    let mut bi: u64 = 0u64;
    while bi < blocks.len() {
        let blk: IrBlock = blocks[bi];
        let insts: Vec<IrInst> = blk.insts;
        let mut ii: u64 = 0u64;
        while ii < insts.len() {
            let inst: IrInst = insts[ii];
            if inst.op == target_op && inst.dk == IDATA_INTEGER() && inst.dv == target_ty {
                return 1;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    0
}

fn cemit_shift_helper(target_op: i64, target_ty: i64) -> String {
    let bits: i64 = if target_ty == ITY_I8() || target_ty == ITY_U8() { 8 }
        else if target_ty == ITY_I16() || target_ty == ITY_U16() { 16 }
        else if target_ty == ITY_I64() || target_ty == ITY_U64() { 64 }
        else if target_ty == ITY_I128() || target_ty == ITY_U128() { 128 }
        else { 32 };
    let mask: i64 = bits - 1;
    let signed: bool = target_ty == ITY_I8() || target_ty == ITY_I16() || target_ty == ITY_I32()
        || target_ty == ITY_I64() || target_ty == ITY_I128();
    let c_ty: String = ir_ty_to_c(target_ty);
    let u_ty: String = if bits == 8 { String::from("uint8_t") }
        else if bits == 16 { String::from("uint16_t") }
        else if bits == 64 { String::from("uint64_t") }
        else if bits == 128 { String::from("unsigned __int128") }
        else { String::from("uint32_t") };
    let opname: String = if target_op == IOP_SHL() { String::from("shl") } else { String::from("shr") };
    let prefix: String = if signed { String::from("i") } else { String::from("u") };
    let out: String = String::from("static inline ");
    out.push_str(c_ty);
    out.push_str(String::from(" __vow_"));
    out.push_str(opname);
    out.push_str(String::from("_"));
    out.push_str(prefix);
    out.push_str(i64_to_string(bits));
    out.push_str(String::from("("));
    out.push_str(c_ty);
    out.push_str(String::from(" value, "));
    out.push_str(c_ty);
    out.push_str(String::from(" count) {\n"));
    if signed {
        out.push_str(String::from("  "));
        out.push_str(u_ty);
        out.push_str(String::from(" shift = (("));
        out.push_str(u_ty);
        out.push_str(String::from(")count) & "));
        out.push_str(i64_to_string(mask));
        out.push_str(String::from(";\n"));
        if target_op == IOP_SHL() {
            out.push_str(String::from("  return ("));
            out.push_str(c_ty);
            out.push_str(String::from(")((("));
            out.push_str(u_ty);
            out.push_str(String::from(")value) << shift);\n"));
        } else {
            out.push_str(String::from("  "));
            out.push_str(u_ty);
            out.push_str(String::from(" raw_bits = ("));
            out.push_str(u_ty);
            out.push_str(String::from(")value;\n  "));
            out.push_str(u_ty);
            out.push_str(String::from(" logical = raw_bits >> shift;\n  "));
            out.push_str(u_ty);
            out.push_str(String::from(" ones = ~(("));
            out.push_str(u_ty);
            out.push_str(String::from(")0);\n  "));
            out.push_str(u_ty);
            out.push_str(String::from(" sign_fill = value < 0 ? (("));
            out.push_str(u_ty);
            out.push_str(String::from(")~(ones >> shift)) : ("));
            out.push_str(u_ty);
            out.push_str(String::from(")0;\n  return ("));
            out.push_str(c_ty);
            out.push_str(String::from(")(logical | sign_fill);\n"));
        }
    } else {
        out.push_str(String::from("  return value "));
        if target_op == IOP_SHL() { out.push_str(String::from("<<")); }
        else { out.push_str(String::from(">>")); }
        out.push_str(String::from(" (count & "));
        out.push_str(i64_to_string(mask));
        out.push_str(String::from(");\n"));
    }
    out.push_str(String::from("}\n"));
    out
}

// Integer types a shift helper exists for, in canonical emission order: width
// ascending, signed before unsigned. Mirrors the `(width, signedness, dir)` key
// of `vow_verify::c_emitter::ShiftNeeds`.
fn model_helper_ty_at(index: i64) -> i64 {
    if index == 0 { return ITY_I8(); }
    if index == 1 { return ITY_U8(); }
    if index == 2 { return ITY_I16(); }
    if index == 3 { return ITY_U16(); }
    if index == 4 { return ITY_I32(); }
    if index == 5 { return ITY_U32(); }
    if index == 6 { return ITY_I64(); }
    if index == 7 { return ITY_U64(); }
    if index == 8 { return ITY_I128(); }
    ITY_U128()
}

fn scope_has_op(scope: Vec<IrFunction>, op: i64, ty: i64, arith: bool) -> bool {
    let mut fi: u64 = 0u64;
    while fi < scope.len() {
        let f: IrFunction = scope[fi];
        if arith {
            if func_has_checked_arith_op(f, op, ty) == 1 { return true; }
        } else {
            if func_has_integer_shift_op(f, op, ty) == 1 { return true; }
        }
        fi = fi + 1;
    }
    false
}

// The width/signedness-specialised shift and checked-arithmetic helpers the
// functions in `scope` need, in one canonical order shared with the Rust
// emitter (`ModelHelpers`): shifts (`shl` then `shr`) per type, then guards
// (`add`, `sub`, `mul`) per type, followed by a single blank line.
fn append_model_helpers(out: String, scope: Vec<IrFunction>) {
    let mut emitted: bool = false;
    let mut ti: i64 = 0;
    while ti < 10 {
        let ty: i64 = model_helper_ty_at(ti);
        let mut oi: i64 = 0;
        while oi < 2 {
            let op: i64 = if oi == 0 { IOP_SHL() } else { IOP_SHR() };
            if scope_has_op(scope, op, ty, false) {
                out.push_str(cemit_shift_helper(op, ty));
                emitted = true;
            }
            oi = oi + 1;
        }
        ti = ti + 1;
    }
    ti = 0;
    while ti < 10 {
        let ty: i64 = model_helper_ty_at(ti);
        if arith_ty_is_modelled(ty) {
            let mut oi: i64 = 0;
            while oi < 3 {
                let op: i64 = arith_helper_op_at(oi);
                if scope_has_op(scope, op, ty, true) {
                    out.push_str(cemit_arith_overflow_helper(op, ty));
                    emitted = true;
                }
                oi = oi + 1;
            }
        }
        ti = ti + 1;
    }
    if emitted { out.push_byte(10); }
}

fn cemit_preamble_with_limits(vec_max: i64, string_max: i64, hashmap_max: i64, btreemap_max: i64) -> String {
    let out: String = String::from("");
    out.push_str(String::from("#include <stdint.h>\n"));
    out.push_str(String::from("#include <stdlib.h>\n"));
    out.push_str(String::from("#include <stdbool.h>\n"));
    out.push_str(String::from("extern void __ESBMC_assume(_Bool);\n"));
    out.push_str(String::from("extern void __ESBMC_assert(_Bool, const char*);\n"));
    out.push_str(String::from("extern int __VERIFIER_nondet_int(void);\n"));
    out.push_str(String::from("extern char __VERIFIER_nondet_char(void);\n"));
    out.push_str(String::from("extern unsigned char __VERIFIER_nondet_unsigned_char(void);\n"));
    out.push_str(String::from("extern short __VERIFIER_nondet_short(void);\n"));
    out.push_str(String::from("extern unsigned short __VERIFIER_nondet_unsigned_short(void);\n"));
    out.push_str(String::from("extern unsigned int __VERIFIER_nondet_unsigned_int(void);\n"));
    out.push_str(String::from("extern long __VERIFIER_nondet_long(void);\n"));
    out.push_str(String::from("extern unsigned long __VERIFIER_nondet_unsigned_long(void);\n"));
    out.push_str(String::from("extern __int128 __VERIFIER_nondet_int128(void);\n"));
    out.push_str(String::from("extern unsigned __int128 __VERIFIER_nondet_uint128(void);\n"));
    out.push_str(String::from("extern float __VERIFIER_nondet_float(void);\n"));
    out.push_str(String::from("extern double __VERIFIER_nondet_double(void);\n"));
    out.push_str(String::from("extern _Bool __VERIFIER_nondet_bool(void);\n\n"));
    out.push_str(str3(
        String::from("typedef struct { uint64_t len; int64_t data["),
        i64_to_string(vec_max),
        String::from("]; } __vow_vec_t;\n")
    ));
    out.push_str(str3(
        String::from("typedef struct { uint64_t len; int8_t data["),
        i64_to_string(string_max),
        String::from("]; } __vow_string_t;\n")
    ));
    out.push_str(str5(
        String::from("typedef struct { uint64_t len; int64_t keys["),
        i64_to_string(hashmap_max),
        String::from("]; int64_t vals["),
        i64_to_string(hashmap_max),
        String::from("]; } __vow_hashmap_t;\n")
    ));
    out.push_str(str5(
        String::from("typedef struct { uint64_t len; int64_t keys["),
        i64_to_string(btreemap_max),
        String::from("]; int64_t vals["),
        i64_to_string(btreemap_max),
        String::from("]; } __vow_btreemap_t;\n")
    ));
    out.push_str(String::from("typedef struct { int64_t tag; int64_t payload; } __vow_option_t;\n"));
    out
}

fn string_max_for_literals(m: IrModule, string_max: i64) -> i64 {
    let strings: Vec<String> = m.strings;
    let mut max_len: i64 = string_max;
    let mut i: u64 = 0u64;
    while i < strings.len() {
        let len: i64 = strings[i].len() as i64;
        if len > max_len {
            max_len = len;
        }
        i = i + 1;
    }
    max_len
}

fn emit_forward_declaration(out: String, f: IrFunction) {
    let ret_c: String = {
        if f.return_ty == ITY_UNIT() {
            String::from("void")
        } else if f.return_ty == ITY_PTR() || f.return_ty == ITY_LPTR() {
            String::from("int64_t")
        } else {
            ir_ty_to_c(f.return_ty)
        }
    };
    let params_list: String = String::from("");
    let param_tys: Vec<i64> = f.params;
    let mut cl_idx: i64 = 0;
    let mut pi: u64 = 0u64;
    while pi < param_tys.len() {
        let pty: i64 = param_tys[pi];
        if pty != ITY_UNIT() {
            if cl_idx > 0 { params_list.push_str(String::from(", ")); }
            let p_c: String = {
                if pty == ITY_PTR() || pty == ITY_LPTR() {
                    String::from("int64_t")
                } else {
                    ir_ty_to_c(pty)
                }
            };
            params_list.push_str(p_c);
            params_list.push_str(cemit_str2(String::from(" p"), i64_to_string(cl_idx)));
            cl_idx = cl_idx + 1;
        }
        pi = pi + 1;
    }
    let param_str: String = if cl_idx == 0 { String::from("void") } else { params_list };
    out.push_str(str5(ret_c, String::from(" "), verifier_c_func_name(f), String::from("("), cemit_str2(param_str, String::from(");\n"))));
}

fn emit_c_module(m: IrModule, vec_max: i64, string_max: i64, hashmap_max: i64, btreemap_max: i64) -> String {
    let fns: Vec<IrFunction> = m.functions;
    let model_string_max: i64 = string_max_for_literals(m, string_max);
    let n: u64 = fns.len();
    let out: String = cemit_preamble_with_limits(vec_max, model_string_max, hashmap_max, btreemap_max);
    append_model_helpers(out, fns);

    let const_fn_indices: Vec<i64> = detect_const_fns(m);
    let empty_modelable: Vec<i64> = Vec::new();

    let mut fi: u64 = 0u64;
    while fi < n {
        let f: IrFunction = fns[fi];
        emit_c_function(out, f, const_fn_indices, empty_modelable, m, vec_max, model_string_max, hashmap_max, btreemap_max, false, false, 0);
        out.push_byte(10);
        fi = fi + 1;
    }
    out
}

fn emit_c_module_with_callees(m: IrModule, target_fi: i64, callee_fis: Vec<i64>, modelable_fi_set: Vec<i64>,
                              vec_max: i64, string_max: i64, hashmap_max: i64, btreemap_max: i64, target_reach_label: bool, target_body_replace: bool) -> String {
    let fns: Vec<IrFunction> = m.functions;
    let model_string_max: i64 = string_max_for_literals(m, string_max);
    let scope: Vec<IrFunction> = Vec::new();
    let mut si: u64 = 0u64;
    while si < fns.len() {
        let sf: IrFunction = fns[si];
        let mut in_scope: bool = sf.id == target_fi;
        let mut sc: u64 = 0u64;
        while sc < callee_fis.len() {
            if callee_fis[sc] == sf.id { in_scope = true; }
            sc = sc + 1;
        }
        if in_scope { scope.push(sf); }
        si = si + 1;
    }
    let out: String = cemit_preamble_with_limits(vec_max, model_string_max, hashmap_max, btreemap_max);
    append_model_helpers(out, scope);
    let const_fn_indices: Vec<i64> = detect_const_fns(m);

    let mut ci: u64 = 0u64;
    while ci < callee_fis.len() {
        let cfid: i64 = callee_fis[ci];
        let mut fi: u64 = 0u64;
        while fi < fns.len() {
            let callee: IrFunction = fns[fi];
            if callee.id == cfid {
                emit_forward_declaration(out, callee);
                fi = fns.len();
            }
            fi = fi + 1;
        }
        ci = ci + 1;
    }
    if callee_fis.len() > 0 {
        out.push_byte(10);
    }

    ci = 0u64;
    while ci < callee_fis.len() {
        let cfid: i64 = callee_fis[ci];
        let mut fi: u64 = 0u64;
        while fi < fns.len() {
            let callee: IrFunction = fns[fi];
            if callee.id == cfid {
                emit_c_function(out, callee, const_fn_indices, modelable_fi_set, m, vec_max, model_string_max, hashmap_max, btreemap_max, false, false, 1);
                out.push_byte(10);
                fi = fns.len();
            }
            fi = fi + 1;
        }
        ci = ci + 1;
    }

    let mut fi: u64 = 0u64;
    while fi < fns.len() {
        let f: IrFunction = fns[fi];
        if f.id == target_fi {
            emit_c_function(out, f, const_fn_indices, modelable_fi_set, m, vec_max, model_string_max, hashmap_max, btreemap_max, target_reach_label, target_body_replace, 0);
            out.push_byte(10);
            fi = fns.len();
        }
        fi = fi + 1;
    }
    out
}
