module VcOverlay

use ir
use ir_dominance
use vc_ops
use vc_strops
use vc_term
use vc_smt
use vc_int
use vc_agg
use vc_vec
use vc_heap

// Parameters that may be the memory a handle names (`vc_heap`). A function that
// reads memory through a handle and also writes a parameter cannot read the
// handle's collection or struct from the never-written arrays alone: the handle
// may be the parameter, and the read must then see what the function wrote. So
// each parameter that is a `Vec`/`String` or a struct carries a free 64-bit
// address, and a read through the handle `h` is
//
//   ite(h == address(p1), state of p1, ite(h == address(p2), state of p2, ..., array[h]))
//
// where the state of a parameter is the object model the function already keeps
// for it (`vc_vec`: flow-sensitive array and length; `vc_agg`: field terms), read
// at the current point of the walk. The arrays are still never written, so a loop
// cut havocs a parameter's state exactly as it does without handles, and the
// frame of every other address is the array itself, with no quantifier. Every
// parameter of the class takes part, written or not, so a read through a handle
// and a direct read of one parameter agree. Two `Vec`/`String` parameters are
// distinct objects (as in `vc_vec`), a `Vec` is never a struct, and two struct
// parameters are one object exactly when their identities say so (`vc_agg`).
//
// A handle read by a `String` operation names a `String`, and one read by a `Vec`
// operation names a `Vec`, so a read consults only the parameters of its own class:
// the type checker never lets a `String` field hold a `Vec` parameter, and the
// model would otherwise let `s.len()` of a field `s` be the length of an unrelated
// `Vec` parameter the loop is pushing to. A parameter the function uses as both (which
// the type checker rules out) belongs to both classes.

fn VC_OV_STRUCT() -> i64 { 0 }
fn VC_OV_VEC() -> i64 { 1 }
fn VC_OV_STRING() -> i64 { 2 }

struct VcOverlay {
    param: Vec<i64>,
    cls: Vec<i64>,
    addr: Vec<i64>,
    names: Vec<String>,
    hdr: Vec<i64>,
}

fn vc_overlay_new() -> VcOverlay {
    VcOverlay { param: Vec::new(), cls: Vec::new(), addr: Vec::new(), names: Vec::new(), hdr: Vec::new() }
}

// Complete reads through a handle: the never-written heap overlaid with the live
// parameter state. Bind the walk's shared models once; reads allocate no request
// record and never copy the models. Address metadata stays in declaration order.
struct VcHandleMemory {
    heap: VcHeap,
    overlay: VcOverlay,
    ag: VcAgg,
    vv: VcVec,
    ar: VcArena,
    header: SmtScript,
    assumed: Vec<i64>,
}

// Aggregate alias identities must already be enabled, before overlay addresses
// are declared. Heap arrays remain lazy even when an overlay is needed.
fn vc_handle_memory_new(f: IrFunction, tys: Vec<i64>, ag: VcAgg, vv: VcVec, ar: VcArena, hdr: SmtScript, assumed: Vec<i64>) -> VcHandleMemory {
    let ov: VcOverlay = vc_overlay_new();
    if vc_heap_overlay_needed(f, tys) {
        vc_overlay_enable(ov, ag, ar, hdr, assumed, vc_overlay_params(f, tys, VC_OV_VEC()), vc_overlay_params(f, tys, VC_OV_STRING()), vc_overlay_params(f, tys, VC_OV_STRUCT()));
    }
    VcHandleMemory { heap: vc_heap_new(), overlay: ov, ag: ag, vv: vv, ar: ar, header: hdr, assumed: assumed }
}

fn vc_handle_memory_used(m: VcHandleMemory) -> bool {
    vc_heap_used(m.heap)
}

fn vc_handle_field(m: VcHandleMemory, h: i64, slot: i64, ty: i64) -> i64 {
    let base: i64 = vc_heap_field(m.heap, m.ar, m.header, h, slot, ty);
    vc_overlay_field(m.overlay, m.ag, m.ar, m.header, h, slot, ty, base)
}

// The length is observed before the caller records the bounds claim. Reading an
// element afterwards must not declare its heap array in that earlier prefix.
fn vc_handle_len(m: VcHandleMemory, b: i64, h: i64, inst: IrInst, kind: i64) -> i64 {
    let base: i64 = vc_heap_len(m.heap, m.ar, m.header, m.assumed, h);
    vc_overlay_len(m.overlay, m.ag, m.vv, m.ar, m.header, m.assumed, b, h, vc_overlay_op_class(inst, kind), base)
}

fn vc_handle_elem(m: VcHandleMemory, b: i64, h: i64, idx: i64) -> i64 {
    let base: i64 = vc_heap_elem(m.heap, m.ar, m.header, h, idx);
    vc_overlay_elem(m.overlay, m.ag, m.vv, m.ar, m.header, m.assumed, b, h, idx, VC_OV_VEC(), false, base)
}

fn vc_handle_byte(m: VcHandleMemory, b: i64, h: i64, idx: i64) -> i64 {
    let base: i64 = vc_heap_byte(m.heap, m.ar, m.header, h, idx);
    vc_overlay_elem(m.overlay, m.ag, m.vv, m.ar, m.header, m.assumed, b, h, idx, VC_OV_STRING(), true, base)
}

// Marks, in `flags`, every value that a `Vec` operation or a field access names as
// its object, then closes the marking over Phis in both directions: a Phi and the
// values it merges are one object.
fn vc_overlay_close(f: IrFunction, flags: Vec<i64>) {
    let mut changed: bool = true;
    while changed {
        changed = false;
        let mut bi: u64 = 0;
        while bi < f.blocks.len() {
            let blk: IrBlock = f.blocks[bi];
            let mut ii: u64 = 0;
            while ii < blk.insts.len() {
                let inst: IrInst = blk.insts[ii];
                if inst.op == IOP_UPSILON() && inst.args.len() == 1 && inst.dv >= 0 {
                    let phi: u64 = inst.dv as u64;
                    let val: u64 = inst.args[0] as u64;
                    if flags[phi] != flags[val] && (flags[phi] == 1 || flags[val] == 1) {
                        flags[phi] = 1;
                        flags[val] = 1;
                        changed = true;
                    }
                }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
    }
}

// The class of the object operand of a collection operation of kind `k`: a `String` for
// the `__vow_string_*` operations (`join` takes a `Vec` first) and the three text helpers
// that take a string and have no such prefix, a `Vec` for every other. Every further object
// operand is a `String`.
fn vc_overlay_op_class(inst: IrInst, k: i64) -> i64 {
    if k == VC_STR_JOIN() { return VC_OV_VEC(); }
    if string_starts_with(inst.ds, VC_STR_PREFIX()) == 1 { return VC_OV_STRING(); }
    if k == VC_STR_HASH() || k == VC_STR_PARSE_F64() || k == VC_STR_HEX_DECODE() { return VC_OV_STRING(); }
    VC_OV_VEC()
}

// The pointer parameters, ascending, that the function uses as an object of class
// `cls` (`VC_OV_VEC`, `VC_OV_STRING`) or, for `VC_OV_STRUCT`, as a struct.
fn vc_overlay_params(f: IrFunction, tys: Vec<i64>, cls: i64) -> Vec<i64> {
    let n_ids: u64 = tys.len();
    let flags: Vec<i64> = dom_fill(n_ids, 0);
    let mut bi: u64 = 0;
    while bi < f.blocks.len() {
        let blk: IrBlock = f.blocks[bi];
        let mut ii: u64 = 0;
        while ii < blk.insts.len() {
            let inst: IrInst = blk.insts[ii];
            let k: i64 = vc_inst_vec_kind(inst);
            if cls != VC_OV_STRUCT() && k != VC_VEC_NONE() && !vc_str_kind_no_object_operand(k) && inst.args.len() > 0
                && (vc_overlay_op_class(inst, k) & cls) != 0 {
                flags[inst.args[0] as u64] = 1;
            }
            if cls != VC_OV_STRUCT() && k != VC_VEC_NONE() && (VC_OV_STRING() & cls) != 0 {
                let mut j: u64 = 1;
                while j < vc_str_kind_object_operands(k) && j < inst.args.len() {
                    flags[inst.args[j] as u64] = 1;
                    j = j + 1;
                }
            }
            if cls == VC_OV_STRUCT() && (inst.op == IOP_FIELD_GET() || inst.op == IOP_FIELD_SET()) && inst.args.len() > 0
                && vc_heap_ty(tys, inst.args[0]) == ITY_PTR() {
                flags[inst.args[0] as u64] = 1;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    vc_overlay_close(f, flags);
    let marked: Vec<i64> = dom_fill(f.params.len(), 0);
    bi = 0;
    while bi < f.blocks.len() {
        let blk: IrBlock = f.blocks[bi];
        let mut ii: u64 = 0;
        while ii < blk.insts.len() {
            let inst: IrInst = blk.insts[ii];
            if inst.op == IOP_GET_ARG() && inst.ty == ITY_PTR() && inst.id >= 0 && inst.dv >= 0
                && (inst.dv as u64) < marked.len() && flags[inst.id as u64] == 1 {
                marked[inst.dv as u64] = 1;
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    let out: Vec<i64> = Vec::new();
    let mut k: u64 = 0;
    while k < marked.len() {
        if marked[k] == 1 { out.push(k as i64); }
        k = k + 1;
    }
    out
}

fn vc_overlay_add(ov: VcOverlay, ar: VcArena, hdr: SmtScript, k: i64, cls: i64) {
    let name: String = String::from("p");
    name.push_str(i64_to_string(k));
    name.push_str(String::from("_haddr"));
    ov.param.push(k);
    ov.cls.push(cls);
    ov.names.push(name);
    ov.hdr.push(hdr.kinds.len() as i64);
    ov.addr.push(vc_agg_declare(ar, hdr, name, 64));
}

// The Bool term "parameters `i` and `j` of the overlay are one object".
fn vc_overlay_same(ov: VcOverlay, ag: VcAgg, ar: VcArena, hdr: SmtScript, i: u64, j: u64) -> i64 {
    let pi: i64 = vc_agg_alias_pos(ag, ov.param[i]);
    let pj: i64 = vc_agg_alias_pos(ag, ov.param[j]);
    if ov.cls[i] == VC_OV_STRUCT() && ov.cls[j] == VC_OV_STRUCT() && pi >= 0 && pj >= 0 {
        return vc_agg_same_object(ag, ar, hdr, pi, pj);
    }
    vc_tm_bool_const(ar, false)
}

// Declares the address of every parameter in the overlay and assumes the relation
// between them: distinct unless both are structs the aggregate model lets alias, and
// then equal exactly when their identities are.
fn vc_overlay_enable(ov: VcOverlay, ag: VcAgg, ar: VcArena, hdr: SmtScript, assumed: Vec<i64>, vecs: Vec<i64>, strs: Vec<i64>, structs: Vec<i64>) {
    let mut i: u64 = 0;
    let mut j: u64 = 0;
    while i < vecs.len() || j < strs.len() {
        if j >= strs.len() || (i < vecs.len() && vecs[i] < strs[j]) {
            vc_overlay_add(ov, ar, hdr, vecs[i], VC_OV_VEC());
            i = i + 1;
        } else if i >= vecs.len() || strs[j] < vecs[i] {
            vc_overlay_add(ov, ar, hdr, strs[j], VC_OV_STRING());
            j = j + 1;
        } else {
            vc_overlay_add(ov, ar, hdr, vecs[i], VC_OV_VEC() + VC_OV_STRING());
            i = i + 1;
            j = j + 1;
        }
    }
    i = 0;
    while i < structs.len() {
        vc_overlay_add(ov, ar, hdr, structs[i], VC_OV_STRUCT());
        i = i + 1;
    }
    i = 0;
    while i < ov.addr.len() {
        let mut j: u64 = i + 1;
        while j < ov.addr.len() {
            let eq: i64 = vc_tm_app2(ar, VC_OP_EQ(), ov.addr[i], ov.addr[j]);
            let same: i64 = vc_overlay_same(ov, ag, ar, hdr, i, j);
            vc_heap_assume(ar, assumed, vc_tm_app2(ar, VC_OP_EQ(), eq, same));
            j = j + 1;
        }
        i = i + 1;
    }
}

fn vc_overlay_hit(ov: VcOverlay, ar: VcArena, i: u64, h: i64) -> i64 {
    vc_tm_app2(ar, VC_OP_EQ(), h, ov.addr[i])
}

// The length of the collection at `h`, given the array's value `base`; `rcls` is the class
// of the operation that reads it.
fn vc_overlay_len(ov: VcOverlay, ag: VcAgg, vv: VcVec, ar: VcArena, hdr: SmtScript, assumed: Vec<i64>, b: i64, h: i64, rcls: i64, base: i64) -> i64 {
    let mut acc: i64 = base;
    let mut i: u64 = 0;
    while i < ov.addr.len() {
        if (ov.cls[i] & rcls) != 0 {
            let s: i64 = vc_vec_slot(vv, ag, ar, hdr, assumed, vc_agg_param(ag, ov.param[i]));
            acc = vc_tm_app3(ar, VC_OP_ITE(), vc_overlay_hit(ov, ar, i, h), vc_vec_cur_len(vv, s, b), acc);
        }
        i = i + 1;
    }
    acc
}

// Element `idx` of the collection at `h` as its 8-byte slot, or its low byte when
// `bytes`, given the array's value `base`.
fn vc_overlay_elem(ov: VcOverlay, ag: VcAgg, vv: VcVec, ar: VcArena, hdr: SmtScript, assumed: Vec<i64>, b: i64, h: i64, idx: i64, rcls: i64, bytes: bool, base: i64) -> i64 {
    let mut acc: i64 = base;
    let mut i: u64 = 0;
    while i < ov.addr.len() {
        if (ov.cls[i] & rcls) != 0 {
            let s: i64 = vc_vec_slot(vv, ag, ar, hdr, assumed, vc_agg_param(ag, ov.param[i]));
            let mut cell: i64 = vc_tm_app2(ar, VC_OP_SELECT(), vc_vec_cur_arr(vv, s, b), idx);
            if bytes { cell = vc_tm_app2(ar, VC_OP_BVAND(), cell, vc_tm_bv(ar, 64, 255, 0)); }
            acc = vc_tm_app3(ar, VC_OP_ITE(), vc_overlay_hit(ov, ar, i, h), cell, acc);
        }
        i = i + 1;
    }
    acc
}

// Field `slot` at type `ty` of the struct at `h`, given the array's value `base`.
fn vc_overlay_field(ov: VcOverlay, ag: VcAgg, ar: VcArena, hdr: SmtScript, h: i64, slot: i64, ty: i64, base: i64) -> i64 {
    let mut acc: i64 = base;
    let mut i: u64 = 0;
    while i < ov.addr.len() {
        if ov.cls[i] == VC_OV_STRUCT() {
            let seen: u64 = ag.ps_param.len();
            let cell: i64 = vc_agg_get(ag, ar, hdr, vc_agg_param(ag, ov.param[i]), slot, vc_ty_sort(ty));
            vc_agg_type_symbols(ag, seen, ty);
            acc = vc_tm_app3(ar, VC_OP_ITE(), vc_overlay_hit(ov, ar, i, h), cell, acc);
        }
        i = i + 1;
    }
    acc
}
