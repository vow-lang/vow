module Env

use types
use diag

struct CheckEnv {
    ts: TyStore,

    var_names: Vec<String>,
    var_tids: Vec<i64>,
    var_scope_ids: Vec<i64>,
    var_muts: Vec<i64>,
    var_mutated: Vec<i64>,
    var_decl_spans: Vec<i64>,

    cur_scope_id: i64,
    next_scope_id: i64,
    parent_scope_ids: Vec<i64>,

    fn_names: Vec<String>,
    fn_param_count: Vec<i64>,
    fn_param_lids: Vec<i64>,
    fn_ret_tids: Vec<i64>,
    fn_effects: Vec<i64>,

    sdef_names: Vec<String>,
    sdef_field_count: Vec<i64>,
    sdef_field_name_lids: Vec<i64>,
    sdef_field_tid_lids: Vec<i64>,
    sdef_is_linear: Vec<i64>,

    edef_names: Vec<String>,
    edef_variant_count: Vec<i64>,
    edef_vname_lids: Vec<i64>,
    edef_vpayload_lids: Vec<i64>,

    const_names: Vec<String>,
    const_values: Vec<i64>,
    const_tids: Vec<i64>,

    alias_names: Vec<String>,
    alias_tids: Vec<i64>,

    dctx: DiagCtx,

    cur_ret_tid: i64,
    cur_effects: i64,
    cur_fn_name: String,
    cur_file: String,

    expr_str_eids: Vec<i64>,
    // Cast expressions whose value is provably non-negative in their own
    // (signed) target type, indexed directly by expression id: the entry holds
    // the original unsigned source type tag, or -1. Lets the comparison check
    // catch `(u32_value as i64) >= 0`, which unsigned_comparison_tag cannot see
    // because the cast has already moved the compared type to a signed one.
    //
    // Indexed rather than scanned. Expression ids are dense arena indices, so
    // this is an O(1) lookup with no hashing — matching the Rust checker's
    // HashMap. A linear scan would be quadratic here in a way the sibling
    // `expr_str_eids` idiom is not: the cast is recorded and then immediately
    // queried by its own parent, so every widened comparison in a file would
    // scan every cast recorded before it.
    nonneg_cast_src_tag_by_eid: Vec<i64>,
    pat_aggregate_names: Vec<String>,
    pat_vec_elem_paths: Vec<Vec<String>>,
    pat_vec_option_elem_ty_paths: Vec<Vec<i64>>,
    pat_vec_variant_payload_ty_paths: Vec<Vec<Vec<i64>>>,
    pat_option_elem_tys: Vec<i64>,
    pat_variant_payload_tys: Vec<Vec<i64>>,
    pat_aggregate_linear: Vec<i64>,
    question_aggregate_names: Vec<String>,
    question_vec_elem_paths: Vec<Vec<String>>,
    question_vec_option_elem_ty_paths: Vec<Vec<i64>>,
    question_option_elem_tys: Vec<i64>,
    question_aggregate_linear: Vec<i64>,

    loop_kind_stack: Vec<i64>,
    break_tids: Vec<i64>,
    break_counts: Vec<i64>,
}

fn env_define_narrowing_family(e: CheckEnv, source_name: String, source_ty: i64,
                               target_name: String, target_ty: i64, option_target_ty: i64) {
    let prefix: String = clone_string(source_name);
    prefix.push_str(String::from("_to_"));
    prefix.push_str(target_name);
    let try_name: String = clone_string(prefix);
    try_name.push_str(String::from("_try"));
    env_define_fn(e, try_name, vec_of_1(source_ty), option_target_ty, 0);
    let wrap_name: String = clone_string(prefix);
    wrap_name.push_str(String::from("_wrap"));
    env_define_fn(e, wrap_name, vec_of_1(source_ty), target_ty, 0);
    prefix.push_str(String::from("_sat"));
    env_define_fn(e, prefix, vec_of_1(source_ty), target_ty, 0);
}

fn has_eff_bit(val: i64, bit_val: i64) -> bool vow {
    requires: bit_val > 0
} {
    (val / bit_val) % 2 != 0
}

fn effect_covered(declared: i64, needed: i64) -> bool vow {
    requires: declared >= 0,
    requires: needed >= 0
} {
    if needed == 0 {
        return true;
    }
    let eff_io: i64 = 1;
    let eff_panic: i64 = 2;
    let eff_read: i64 = 4;
    let eff_unsafe: i64 = 8;
    let eff_write: i64 = 16;
    let io_decl: bool = has_eff_bit(declared, eff_io);
    if has_eff_bit(needed, eff_io) && !io_decl {
        return false;
    }
    if has_eff_bit(needed, eff_panic) && !has_eff_bit(declared, eff_panic) {
        return false;
    }
    if has_eff_bit(needed, eff_read) && !io_decl && !has_eff_bit(declared, eff_read) {
        return false;
    }
    if has_eff_bit(needed, eff_unsafe) && !has_eff_bit(declared, eff_unsafe) {
        return false;
    }
    if has_eff_bit(needed, eff_write) && !io_decl && !has_eff_bit(declared, eff_write) {
        return false;
    }
    true
}

fn scope_visible(e: CheckEnv, scope_id: i64) -> bool {
    let mut cur: i64 = e.cur_scope_id;
    while cur != -1 {
        if cur == scope_id {
            return true;
        }
        cur = e.parent_scope_ids[cur];
    }
    false
}

fn env_record_str_expr(e: CheckEnv, eid: i64) {
    e.expr_str_eids.push(eid);
}

fn env_is_str_expr(e: CheckEnv, eid: i64) -> bool {
    let n: i64 = e.expr_str_eids.len();
    let mut i: i64 = 0;
    while i < n {
        if e.expr_str_eids[i] == eid {
            return true;
        }
        i = i + 1;
    }
    false
}

fn env_record_nonneg_cast(e: CheckEnv, eid: i64, src_tag: i64) {
    // Total rather than contracted: `eid` reaches here as an unconstrained
    // parameter of check_expr_inner, so a `requires: eid >= 0` would be a
    // Caller-blame obligation the call site cannot discharge locally. Guarding
    // costs nothing and keeps the helper safe for any input.
    if eid < 0 || src_tag < 0 {
        return;
    }
    // Grow to cover `eid`, filling the gap with the -1 "not recorded" sentinel.
    // Total growth across a run is bounded by the highest cast eid, so this is
    // amortized O(1) per record and linear in program size overall.
    while e.nonneg_cast_src_tag_by_eid.len() <= eid {
        e.nonneg_cast_src_tag_by_eid.push(-1);
    }
    e.nonneg_cast_src_tag_by_eid[eid] = src_tag;
}

// The unsigned source type tag of a cast recorded as provably non-negative, or
// -1 for any expression that was never recorded. O(1).
fn env_nonneg_cast_src_tag(e: CheckEnv, eid: i64) -> i64 {
    if eid < 0 {
        return -1;
    }
    if eid >= e.nonneg_cast_src_tag_by_eid.len() {
        return -1;
    }
    e.nonneg_cast_src_tag_by_eid[eid]
}

fn env_new(dctx: DiagCtx, file: String) -> CheckEnv {
    let ts: TyStore = ty_store_new();
    let psids: Vec<i64> = Vec::new();
    psids.push(-1);

    let e: CheckEnv = CheckEnv {
        ts: ts,
        var_names: Vec::new(),
        var_tids: Vec::new(),
        var_scope_ids: Vec::new(),
        var_muts: Vec::new(),
        var_mutated: Vec::new(),
        var_decl_spans: Vec::new(),
        cur_scope_id: 0,
        next_scope_id: 1,
        parent_scope_ids: psids,
        fn_names: Vec::new(),
        fn_param_count: Vec::new(),
        fn_param_lids: Vec::new(),
        fn_ret_tids: Vec::new(),
        fn_effects: Vec::new(),
        sdef_names: Vec::new(),
        sdef_field_count: Vec::new(),
        sdef_field_name_lids: Vec::new(),
        sdef_field_tid_lids: Vec::new(),
        sdef_is_linear: Vec::new(),
        edef_names: Vec::new(),
        edef_variant_count: Vec::new(),
        edef_vname_lids: Vec::new(),
        edef_vpayload_lids: Vec::new(),
        const_names: Vec::new(),
        const_values: Vec::new(),
        const_tids: Vec::new(),
        alias_names: Vec::new(),
        alias_tids: Vec::new(),
        dctx: dctx,
        cur_ret_tid: 14,
        cur_effects: 0,
        cur_fn_name: String::from(""),
        cur_file: file,
        expr_str_eids: Vec::new(),
        nonneg_cast_src_tag_by_eid: Vec::new(),
        pat_aggregate_names: Vec::new(),
        pat_vec_elem_paths: Vec::new(),
        pat_vec_option_elem_ty_paths: Vec::new(),
        pat_vec_variant_payload_ty_paths: Vec::new(),
        pat_option_elem_tys: Vec::new(),
        pat_variant_payload_tys: Vec::new(),
        pat_aggregate_linear: Vec::new(),
        question_aggregate_names: Vec::new(),
        question_vec_elem_paths: Vec::new(),
        question_vec_option_elem_ty_paths: Vec::new(),
        question_option_elem_tys: Vec::new(),
        question_aggregate_linear: Vec::new(),
        loop_kind_stack: Vec::new(),
        break_tids: Vec::new(),
        break_counts: Vec::new(),
    };

    let str_tid: i64 = CTY_STR();
    let unit_tid: i64 = CTY_UNIT();
    let i64_tid: i64 = CTY_I64();
    let u64_tid: i64 = CTY_U64();
    let never_tid: i64 = CTY_NEVER();
    let eff_io: i64 = 1;
    let eff_read: i64 = 4;
    let eff_write: i64 = 16;

    let vec_base: i64 = ts_make_enum(e.ts, String::from("Vec"));
    let vec_str_args: Vec<i64> = Vec::new();
    vec_str_args.push(str_tid);
    let vec_str_tid: i64 = ts_make_applied(e.ts, vec_base, vec_str_args);
    let option_i64_base: i64 = ts_make_enum(e.ts, String::from("Option"));
    let option_i64_args: Vec<i64> = Vec::new();
    option_i64_args.push(i64_tid);
    let option_i64_tid: i64 = ts_make_applied(e.ts, option_i64_base, option_i64_args);

    env_define_fn(e, String::from("print_str"), vec_of_1(str_tid), unit_tid, eff_io);
    env_define_fn(e, String::from("print_i64"), vec_of_1(i64_tid), unit_tid, eff_io);
    env_define_fn(e, String::from("print_u64"), vec_of_1(u64_tid), unit_tid, eff_io);
    env_define_fn(e, String::from("eprintln_str"), vec_of_1(str_tid), unit_tid, eff_io);
    env_define_fn(e, String::from("debug_str"), vec_of_1(str_tid), unit_tid, 0);
    env_define_fn(e, String::from("debug_i64"), vec_of_1(i64_tid), unit_tid, 0);
    env_define_fn(e, String::from("debug_u64"), vec_of_1(u64_tid), unit_tid, 0);
    env_define_fn(e, String::from("fs_read"), vec_of_1(str_tid), str_tid, eff_read);
    env_define_fn(e, String::from("fs_open"), vec_of_1(str_tid), i64_tid, eff_read);
    env_define_fn(e, String::from("fs_read_line"), vec_of_1(i64_tid), str_tid, eff_read);
    env_define_fn(e, String::from("fs_status"), vec_of_1(i64_tid), i64_tid, eff_read);
    env_define_fn(e, String::from("fs_close"), vec_of_1(i64_tid), i64_tid, eff_read);
    let fs_write_p: Vec<i64> = Vec::new();
    fs_write_p.push(str_tid);
    fs_write_p.push(str_tid);
    env_define_fn(e, String::from("fs_write"), fs_write_p, i64_tid, eff_write);
    env_define_fn(e, String::from("fs_exists"), vec_of_1(str_tid), i64_tid, eff_read);
    env_define_fn(e, String::from("fs_mkdir"), vec_of_1(str_tid), i64_tid, eff_io);
    env_define_fn(e, String::from("fs_listdir"), vec_of_1(str_tid), vec_str_tid, eff_read);
    env_define_fn(e, String::from("fs_remove"), vec_of_1(str_tid), i64_tid, eff_io);
    env_define_fn(e, String::from("fs_remove_dir"), vec_of_1(str_tid), i64_tid, eff_io);
    env_define_fn(e, String::from("fs_is_dir"), vec_of_1(str_tid), i64_tid, eff_read);
    env_define_fn(e, String::from("fs_is_symlink"), vec_of_1(str_tid), i64_tid, eff_read);
    let fs_rename_p: Vec<i64> = Vec::new();
    fs_rename_p.push(str_tid);
    fs_rename_p.push(str_tid);
    env_define_fn(e, String::from("fs_rename"), fs_rename_p, i64_tid, eff_io);
    let str_i64_i64_p: Vec<i64> = Vec::new();
    str_i64_i64_p.push(str_tid);
    str_i64_i64_p.push(i64_tid);
    str_i64_i64_p.push(i64_tid);
    env_define_fn(e, String::from("string_substr"), str_i64_i64_p, str_tid, 0);
    let str_str_p: Vec<i64> = Vec::new();
    str_str_p.push(str_tid);
    str_str_p.push(str_tid);
    env_define_fn(e, String::from("string_split"), str_str_p, vec_str_tid, 0);
    let ssw_p: Vec<i64> = Vec::new();
    ssw_p.push(str_tid);
    ssw_p.push(str_tid);
    env_define_fn(e, String::from("string_starts_with"), ssw_p, i64_tid, 0);
    let sew_p: Vec<i64> = Vec::new();
    sew_p.push(str_tid);
    sew_p.push(str_tid);
    env_define_fn(e, String::from("string_ends_with"), sew_p, i64_tid, 0);
    let sml_p: Vec<i64> = Vec::new();
    sml_p.push(str_tid);
    sml_p.push(i64_tid);
    sml_p.push(str_tid);
    env_define_fn(e, String::from("string_matches_literal_at"), sml_p, i64_tid, 0);
    env_define_fn(e, String::from("string_trim"), vec_of_1(str_tid), str_tid, 0);
    env_define_fn(e, String::from("string_to_upper"), vec_of_1(str_tid), str_tid, 0);
    env_define_fn(e, String::from("string_to_lower"), vec_of_1(str_tid), str_tid, 0);
    let srp_p: Vec<i64> = Vec::new();
    srp_p.push(str_tid);
    srp_p.push(str_tid);
    srp_p.push(str_tid);
    env_define_fn(e, String::from("string_replace"), srp_p, str_tid, 0);
    let sj_p: Vec<i64> = Vec::new();
    sj_p.push(vec_str_tid);
    sj_p.push(str_tid);
    env_define_fn(e, String::from("string_join"), sj_p, str_tid, 0);
    env_define_fn(e, String::from("parse_i64"), vec_of_1(str_tid), option_i64_tid, 0);
    let option_u8_base: i64 = ts_make_enum(e.ts, String::from("Option"));
    let option_u8_args: Vec<i64> = Vec::new();
    option_u8_args.push(CTY_U8());
    let option_u8_tid: i64 = ts_make_applied(e.ts, option_u8_base, option_u8_args);
    env_define_fn(e, String::from("parse_u8"), vec_of_1(str_tid), option_u8_tid, 0);
    let option_i8_base: i64 = ts_make_enum(e.ts, String::from("Option"));
    let option_i8_args: Vec<i64> = Vec::new();
    option_i8_args.push(CTY_I8());
    let option_i8_tid: i64 = ts_make_applied(e.ts, option_i8_base, option_i8_args);
    env_define_fn(e, String::from("parse_i8"), vec_of_1(str_tid), option_i8_tid, 0);
    let option_i16_base: i64 = ts_make_enum(e.ts, String::from("Option"));
    let option_i16_args: Vec<i64> = Vec::new();
    option_i16_args.push(CTY_I16());
    let option_i16_tid: i64 = ts_make_applied(e.ts, option_i16_base, option_i16_args);
    env_define_fn(e, String::from("parse_i16"), vec_of_1(str_tid), option_i16_tid, 0);
    let option_u16_base: i64 = ts_make_enum(e.ts, String::from("Option"));
    let option_u16_args: Vec<i64> = Vec::new();
    option_u16_args.push(CTY_U16());
    let option_u16_tid: i64 = ts_make_applied(e.ts, option_u16_base, option_u16_args);
    env_define_fn(e, String::from("parse_u16"), vec_of_1(str_tid), option_u16_tid, 0);
    let option_u32_base: i64 = ts_make_enum(e.ts, String::from("Option"));
    let option_u32_args: Vec<i64> = Vec::new();
    option_u32_args.push(CTY_U32());
    let option_u32_tid: i64 = ts_make_applied(e.ts, option_u32_base, option_u32_args);
    env_define_fn(e, String::from("parse_u32"), vec_of_1(str_tid), option_u32_tid, 0);
    env_define_fn(e, String::from("i16_to_u8_try"), vec_of_1(CTY_I16()), option_u8_tid, 0);
    env_define_fn(e, String::from("i16_to_u8_wrap"), vec_of_1(CTY_I16()), CTY_U8(), 0);
    env_define_fn(e, String::from("i16_to_u8_sat"), vec_of_1(CTY_I16()), CTY_U8(), 0);
    env_define_fn(e, String::from("i32_to_u8_try"), vec_of_1(CTY_I32()), option_u8_tid, 0);
    env_define_fn(e, String::from("i32_to_u8_wrap"), vec_of_1(CTY_I32()), CTY_U8(), 0);
    env_define_fn(e, String::from("i32_to_u8_sat"), vec_of_1(CTY_I32()), CTY_U8(), 0);
    env_define_fn(e, String::from("i64_to_u8_try"), vec_of_1(CTY_I64()), option_u8_tid, 0);
    env_define_fn(e, String::from("i64_to_u8_wrap"), vec_of_1(CTY_I64()), CTY_U8(), 0);
    env_define_fn(e, String::from("i64_to_u8_sat"), vec_of_1(CTY_I64()), CTY_U8(), 0);
    env_define_fn(e, String::from("i128_to_u8_try"), vec_of_1(CTY_I128()), option_u8_tid, 0);
    env_define_fn(e, String::from("i128_to_u8_wrap"), vec_of_1(CTY_I128()), CTY_U8(), 0);
    env_define_fn(e, String::from("i128_to_u8_sat"), vec_of_1(CTY_I128()), CTY_U8(), 0);
    env_define_fn(e, String::from("u16_to_u8_try"), vec_of_1(CTY_U16()), option_u8_tid, 0);
    env_define_fn(e, String::from("u16_to_u8_wrap"), vec_of_1(CTY_U16()), CTY_U8(), 0);
    env_define_fn(e, String::from("u16_to_u8_sat"), vec_of_1(CTY_U16()), CTY_U8(), 0);
    env_define_fn(e, String::from("u32_to_u8_try"), vec_of_1(CTY_U32()), option_u8_tid, 0);
    env_define_fn(e, String::from("u32_to_u8_wrap"), vec_of_1(CTY_U32()), CTY_U8(), 0);
    env_define_fn(e, String::from("u32_to_u8_sat"), vec_of_1(CTY_U32()), CTY_U8(), 0);
    env_define_fn(e, String::from("u64_to_u8_try"), vec_of_1(CTY_U64()), option_u8_tid, 0);
    env_define_fn(e, String::from("u64_to_u8_wrap"), vec_of_1(CTY_U64()), CTY_U8(), 0);
    env_define_fn(e, String::from("u64_to_u8_sat"), vec_of_1(CTY_U64()), CTY_U8(), 0);
    env_define_fn(e, String::from("u128_to_u8_try"), vec_of_1(CTY_U128()), option_u8_tid, 0);
    env_define_fn(e, String::from("u128_to_u8_wrap"), vec_of_1(CTY_U128()), CTY_U8(), 0);
    env_define_fn(e, String::from("u128_to_u8_sat"), vec_of_1(CTY_U128()), CTY_U8(), 0);
    let sat_u8_args: Vec<i64> = Vec::new();
    sat_u8_args.push(CTY_U8());
    sat_u8_args.push(CTY_U8());
    env_define_fn(e, String::from("add_sat_u8"), sat_u8_args, CTY_U8(), 0);
    let sat_u8_args2: Vec<i64> = Vec::new();
    sat_u8_args2.push(CTY_U8());
    sat_u8_args2.push(CTY_U8());
    env_define_fn(e, String::from("sub_sat_u8"), sat_u8_args2, CTY_U8(), 0);
    let sat_u8_args3: Vec<i64> = Vec::new();
    sat_u8_args3.push(CTY_U8());
    sat_u8_args3.push(CTY_U8());
    env_define_fn(e, String::from("mul_sat_u8"), sat_u8_args3, CTY_U8(), 0);
    let option_i32_base: i64 = ts_make_enum(e.ts, String::from("Option"));
    let option_i32_args: Vec<i64> = Vec::new();
    option_i32_args.push(CTY_I32());
    let option_i32_tid: i64 = ts_make_applied(e.ts, option_i32_base, option_i32_args);
    env_define_fn(e, String::from("parse_i32"), vec_of_1(str_tid), option_i32_tid, 0);
    env_define_fn(e, String::from("i64_to_i32_try"), vec_of_1(CTY_I64()), option_i32_tid, 0);
    env_define_fn(e, String::from("i64_to_i32_wrap"), vec_of_1(CTY_I64()), CTY_I32(), 0);
    env_define_fn(e, String::from("i64_to_i32_sat"), vec_of_1(CTY_I64()), CTY_I32(), 0);
    env_define_fn(e, String::from("u32_to_i32_try"), vec_of_1(CTY_U32()), option_i32_tid, 0);
    env_define_fn(e, String::from("u32_to_i32_wrap"), vec_of_1(CTY_U32()), CTY_I32(), 0);
    env_define_fn(e, String::from("u32_to_i32_sat"), vec_of_1(CTY_U32()), CTY_I32(), 0);
    env_define_fn(e, String::from("u64_to_i32_try"), vec_of_1(CTY_U64()), option_i32_tid, 0);
    env_define_fn(e, String::from("u64_to_i32_wrap"), vec_of_1(CTY_U64()), CTY_I32(), 0);
    env_define_fn(e, String::from("u64_to_i32_sat"), vec_of_1(CTY_U64()), CTY_I32(), 0);
    env_define_narrowing_family(e, String::from("i16"), CTY_I16(), String::from("i8"), CTY_I8(), option_i8_tid);
    env_define_narrowing_family(e, String::from("u16"), CTY_U16(), String::from("i8"), CTY_I8(), option_i8_tid);
    env_define_narrowing_family(e, String::from("i32"), CTY_I32(), String::from("i8"), CTY_I8(), option_i8_tid);
    env_define_narrowing_family(e, String::from("u32"), CTY_U32(), String::from("i8"), CTY_I8(), option_i8_tid);
    env_define_narrowing_family(e, String::from("i64"), CTY_I64(), String::from("i8"), CTY_I8(), option_i8_tid);
    env_define_narrowing_family(e, String::from("u64"), CTY_U64(), String::from("i8"), CTY_I8(), option_i8_tid);
    env_define_narrowing_family(e, String::from("i32"), CTY_I32(), String::from("i16"), CTY_I16(), option_i16_tid);
    env_define_narrowing_family(e, String::from("u32"), CTY_U32(), String::from("i16"), CTY_I16(), option_i16_tid);
    env_define_narrowing_family(e, String::from("i64"), CTY_I64(), String::from("i16"), CTY_I16(), option_i16_tid);
    env_define_narrowing_family(e, String::from("u64"), CTY_U64(), String::from("i16"), CTY_I16(), option_i16_tid);
    env_define_narrowing_family(e, String::from("i32"), CTY_I32(), String::from("u16"), CTY_U16(), option_u16_tid);
    env_define_narrowing_family(e, String::from("u32"), CTY_U32(), String::from("u16"), CTY_U16(), option_u16_tid);
    env_define_narrowing_family(e, String::from("i64"), CTY_I64(), String::from("u16"), CTY_U16(), option_u16_tid);
    env_define_narrowing_family(e, String::from("u64"), CTY_U64(), String::from("u16"), CTY_U16(), option_u16_tid);
    env_define_narrowing_family(e, String::from("i64"), CTY_I64(), String::from("u32"), CTY_U32(), option_u32_tid);
    env_define_narrowing_family(e, String::from("u64"), CTY_U64(), String::from("u32"), CTY_U32(), option_u32_tid);
    env_define_fn(e, String::from("int_to_string"), vec_of_1(i64_tid), str_tid, 0);
    env_define_fn(e, String::from("uint_to_string"), vec_of_1(u64_tid), str_tid, 0);
    env_define_fn(e, String::from("i64_to_string"), vec_of_1(i64_tid), str_tid, 0);
    let vec_i64_base: i64 = ts_make_enum(e.ts, String::from("Vec"));
    let vec_i64_args: Vec<i64> = Vec::new();
    vec_i64_args.push(i64_tid);
    let vec_i64_tid: i64 = ts_make_applied(e.ts, vec_i64_base, vec_i64_args);
    let u8_tid: i64 = CTY_U8();
    let vec_u8_base: i64 = ts_make_enum(e.ts, String::from("Vec"));
    let vec_u8_args: Vec<i64> = Vec::new();
    vec_u8_args.push(u8_tid);
    let vec_u8_tid: i64 = ts_make_applied(e.ts, vec_u8_base, vec_u8_args);
    env_define_fn(e, String::from("vec_sort"), vec_of_1(vec_i64_tid), vec_i64_tid, 0);
    env_define_fn(e, String::from("time_unix"), Vec::new(), i64_tid, eff_io);
    env_define_fn(e, String::from("time_unix_ms"), Vec::new(), i64_tid, eff_io);
    env_define_fn(e, String::from("num_cpus"), Vec::new(), i64_tid, eff_io);
    env_define_fn(e, String::from("memory_root_arena_bytes"), Vec::new(), u64_tid, eff_io);
    env_define_fn(e, String::from("memory_peak_bytes"), Vec::new(), u64_tid, eff_io);
    env_define_fn(e, String::from("memory_alloc_count_since_start"), Vec::new(), u64_tid, eff_io);
    env_define_fn(e, String::from("time_micros"), Vec::new(), i64_tid, eff_io);
    env_define_fn(e, String::from("proc_sample"), Vec::new(), str_tid, eff_io);
    let gzip_p: Vec<i64> = Vec::new();
    gzip_p.push(str_tid);
    gzip_p.push(str_tid);
    env_define_fn(e, String::from("gzip_write_file"), gzip_p, i64_tid, eff_io);
    env_define_fn(e, String::from("hex_encode"), vec_of_1(vec_u8_tid), str_tid, 0);
    env_define_fn(e, String::from("hex_decode"), vec_of_1(str_tid), vec_u8_tid, 0);
    env_define_fn(e, String::from("args"), Vec::new(), vec_str_tid, eff_read);
    env_define_fn(e, String::from("stdin_read"), Vec::new(), str_tid, eff_read);
    env_define_fn(e, String::from("stdin_read_line"), Vec::new(), str_tid, eff_read);
    env_define_fn(e, String::from("stdin_ready"), Vec::new(), CTY_BOOL(), eff_read);
    env_define_fn(e, String::from("process_exit"), vec_of_1(i64_tid), never_tid, eff_io);

    let pr_p: Vec<i64> = Vec::new();
    pr_p.push(str_tid);
    pr_p.push(vec_str_tid);
    env_define_fn(e, String::from("process_run"), pr_p, i64_tid, eff_io);
    env_define_fn(e, String::from("process_get_stdout"), Vec::new(), str_tid, eff_io);
    env_define_fn(e, String::from("process_get_stderr"), Vec::new(), str_tid, eff_io);

    let ps_p: Vec<i64> = Vec::new();
    ps_p.push(str_tid);
    ps_p.push(vec_str_tid);
    env_define_fn(e, String::from("process_start"), ps_p, i64_tid, eff_io);
    env_define_fn(e, String::from("process_wait"), vec_of_1(i64_tid), i64_tid, eff_io);
    let pwt_p: Vec<i64> = Vec::new();
    pwt_p.push(i64_tid);
    pwt_p.push(i64_tid);
    env_define_fn(e, String::from("process_wait_timeout"), pwt_p, i64_tid, eff_io);
    let ppw_p: Vec<i64> = Vec::new();
    ppw_p.push(i64_tid);
    ppw_p.push(i64_tid);
    env_define_fn(e, String::from("process_poll_wait"), ppw_p, i64_tid, eff_io);
    env_define_fn(e, String::from("process_kill"), vec_of_1(i64_tid), i64_tid, eff_io);
    env_define_fn(e, String::from("process_stdout_for"), vec_of_1(i64_tid), str_tid, eff_io);
    env_define_fn(e, String::from("process_stderr_for"), vec_of_1(i64_tid), str_tid, eff_io);

    // Cranelift shim FFI symbols invoked directly from compiler/clif.vow.
    // Mirrors the Rust env.rs registrations so calls like `__vow_clif_create(...)`
    // resolve as known functions rather than triggering "undefined function".
    let clif_ii_p: Vec<i64> = Vec::new();
    clif_ii_p.push(i64_tid);
    clif_ii_p.push(i64_tid);
    env_define_fn(e, String::from("__vow_clif_create"), clif_ii_p, i64_tid, eff_io);

    let clif_is_p: Vec<i64> = Vec::new();
    clif_is_p.push(i64_tid);
    clif_is_p.push(str_tid);
    env_define_fn(e, String::from("__vow_clif_add_string"), clif_is_p, unit_tid, eff_io);

    let clif_is2_p: Vec<i64> = Vec::new();
    clif_is2_p.push(i64_tid);
    clif_is2_p.push(str_tid);
    env_define_fn(e, String::from("__vow_clif_declare_extern"), clif_is2_p, unit_tid, eff_io);

    let clif_decl_p: Vec<i64> = Vec::new();
    clif_decl_p.push(i64_tid);
    clif_decl_p.push(i64_tid);
    clif_decl_p.push(str_tid);
    clif_decl_p.push(vec_i64_tid);
    clif_decl_p.push(i64_tid);
    clif_decl_p.push(i64_tid);
    clif_decl_p.push(i64_tid);
    clif_decl_p.push(i64_tid);
    clif_decl_p.push(vec_i64_tid);
    env_define_fn(e, String::from("__vow_clif_declare_function"), clif_decl_p, unit_tid, eff_io);

    let clif_begin_p: Vec<i64> = Vec::new();
    clif_begin_p.push(i64_tid);
    clif_begin_p.push(i64_tid);
    clif_begin_p.push(i64_tid);
    clif_begin_p.push(vec_i64_tid);
    env_define_fn(e, String::from("__vow_clif_fn_begin"), clif_begin_p, i64_tid, eff_io);

    env_define_fn(e, String::from("__vow_clif_fn_block"), vec_of_1(i64_tid), i64_tid, eff_io);

    let clif_inst_p: Vec<i64> = Vec::new();
    clif_inst_p.push(i64_tid);
    clif_inst_p.push(i64_tid);
    clif_inst_p.push(i64_tid);
    clif_inst_p.push(i64_tid);
    clif_inst_p.push(i64_tid);
    clif_inst_p.push(i64_tid);
    clif_inst_p.push(i64_tid);
    clif_inst_p.push(str_tid);
    clif_inst_p.push(vec_i64_tid);
    clif_inst_p.push(i64_tid);
    env_define_fn(e, String::from("__vow_clif_fn_inst"), clif_inst_p, i64_tid, eff_io);

    let clif_vow_p: Vec<i64> = Vec::new();
    clif_vow_p.push(i64_tid);
    clif_vow_p.push(i64_tid);
    clif_vow_p.push(str_tid);
    clif_vow_p.push(vec_i64_tid);
    clif_vow_p.push(vec_str_tid);
    env_define_fn(e, String::from("__vow_clif_fn_vow"), clif_vow_p, i64_tid, eff_io);

    env_define_fn(e, String::from("__vow_clif_fn_end"), vec_of_1(i64_tid), i64_tid, eff_io);

    let clif_finish_p: Vec<i64> = Vec::new();
    clif_finish_p.push(i64_tid);
    clif_finish_p.push(str_tid);
    env_define_fn(e, String::from("__vow_clif_finish"), clif_finish_p, i64_tid, eff_io);

    let clif_link_p: Vec<i64> = Vec::new();
    clif_link_p.push(str_tid);
    clif_link_p.push(str_tid);
    env_define_fn(e, String::from("__vow_clif_link"), clif_link_p, i64_tid, eff_io);

    env_define_fn(e, String::from("__vow_clif_destroy"), vec_of_1(i64_tid), unit_tid, eff_io);

    e
}

fn vec_of_1(tid: i64) -> Vec<i64> {
    let v: Vec<i64> = Vec::new();
    v.push(tid);
    v
}

fn env_push_scope(e: CheckEnv) {
    let new_id: i64 = e.next_scope_id;
    e.next_scope_id = e.next_scope_id + 1;
    e.parent_scope_ids.push(e.cur_scope_id);
    e.cur_scope_id = new_id;
}

fn env_pop_scope(e: CheckEnv) {
    if e.cur_scope_id == 0 {
        return;
    }
    e.cur_scope_id = e.parent_scope_ids[e.cur_scope_id];
}

fn env_define_var(e: CheckEnv, name: String, tid: i64) {
    env_define_var_m(e, name, tid, 0, 0);
}

fn env_define_var_m(e: CheckEnv, name: String, tid: i64, is_mut: i64, span: i64) {
    e.var_names.push(name);
    e.var_tids.push(tid);
    e.var_scope_ids.push(e.cur_scope_id);
    e.var_muts.push(is_mut);
    e.var_mutated.push(0);
    e.var_decl_spans.push(span);
}

fn env_lookup_var(e: CheckEnv, name: String) -> i64 {
    let n: i64 = e.var_names.len();
    let mut i: i64 = n - 1;
    while i >= 0 {
        if e.var_names[i] == name && scope_visible(e, e.var_scope_ids[i]) {
            return e.var_tids[i];
        }
        i = i - 1;
    }
    CTY_UNIT()
}

fn env_mark_mutated(e: CheckEnv, name: String) -> i64 {
    let n: i64 = e.var_names.len();
    let mut i: i64 = n - 1;
    while i >= 0 {
        if e.var_names[i] == name && scope_visible(e, e.var_scope_ids[i]) {
            e.var_mutated[i] = 1;
            if e.var_muts[i] == 1 {
                return 1;
            }
            return 2;
        }
        i = i - 1;
    }
    0
}

fn env_define_fn(e: CheckEnv, name: String, param_tids: Vec<i64>, ret_tid: i64, eff: i64) {
    let n: i64 = param_tids.len();
    let lid: i64 = ts_add_args(e.ts, param_tids);
    e.fn_names.push(name);
    e.fn_param_count.push(n);
    e.fn_param_lids.push(lid);
    e.fn_ret_tids.push(ret_tid);
    e.fn_effects.push(eff);
}

fn env_lookup_fn(e: CheckEnv, name: String) -> i64 {
    let n: i64 = e.fn_names.len();
    let mut i: i64 = 0;
    while i < n {
        if e.fn_names[i] == name {
            return i;
        }
        i = i + 1;
    }
    -1
}

fn env_define_struct(e: CheckEnv, name: String, fnames: Vec<String>, ftids: Vec<i64>) {
    let nf: i64 = fnames.len();
    let fname_sids: Vec<i64> = Vec::new();
    let mut i: i64 = 0;
    while i < nf {
        let sid: i64 = ts_intern_name(e.ts, fnames[i]);
        fname_sids.push(sid);
        i = i + 1;
    }
    let name_lid: i64 = ts_add_args(e.ts, fname_sids);
    let tid_lid: i64 = ts_add_args(e.ts, ftids);
    e.sdef_names.push(name);
    e.sdef_field_count.push(nf);
    e.sdef_field_name_lids.push(name_lid);
    e.sdef_field_tid_lids.push(tid_lid);
    e.sdef_is_linear.push(0);
}

fn env_define_struct_name(e: CheckEnv, name: String) {
    env_define_struct(e, name, Vec::new(), Vec::new());
}

fn env_update_struct(e: CheckEnv, name: String, fnames: Vec<String>, ftids: Vec<i64>, is_linear: i64) {
    let idx: i64 = env_lookup_struct(e, name);
    if idx == -1 {
        return;
    }
    let nf: i64 = fnames.len();
    let fname_sids: Vec<i64> = Vec::new();
    let mut i: i64 = 0;
    while i < nf {
        let sid: i64 = ts_intern_name(e.ts, fnames[i]);
        fname_sids.push(sid);
        i = i + 1;
    }
    let name_lid: i64 = ts_add_args(e.ts, fname_sids);
    let tid_lid: i64 = ts_add_args(e.ts, ftids);
    e.sdef_field_count[idx] = nf;
    e.sdef_field_name_lids[idx] = name_lid;
    e.sdef_field_tid_lids[idx] = tid_lid;
    e.sdef_is_linear[idx] = is_linear;
}

fn env_lookup_struct(e: CheckEnv, name: String) -> i64 {
    let n: i64 = e.sdef_names.len();
    let mut i: i64 = 0;
    while i < n {
        if e.sdef_names[i] == name {
            return i;
        }
        i = i + 1;
    }
    -1
}

fn env_struct_is_linear(e: CheckEnv, name: String) -> i64 {
    let idx: i64 = env_lookup_struct(e, name);
    if idx == -1 {
        return 0;
    }
    e.sdef_is_linear[idx]
}

fn env_define_enum_name(e: CheckEnv, name: String) {
    env_define_enum(e, name, Vec::new(), Vec::new());
}

fn env_update_enum(e: CheckEnv, name: String, vnames: Vec<String>, vpayloads: Vec<i64>) {
    let idx: i64 = env_lookup_enum(e, name);
    if idx == -1 {
        return;
    }
    let nv: i64 = vnames.len();
    let vname_sids: Vec<i64> = Vec::new();
    let mut i: i64 = 0;
    while i < nv {
        let sid: i64 = ts_intern_name(e.ts, vnames[i]);
        vname_sids.push(sid);
        i = i + 1;
    }
    let vname_lid: i64 = ts_add_args(e.ts, vname_sids);
    let vpayload_lid: i64 = ts_add_args(e.ts, vpayloads);
    e.edef_variant_count[idx] = nv;
    e.edef_vname_lids[idx] = vname_lid;
    e.edef_vpayload_lids[idx] = vpayload_lid;
}

fn env_define_enum(e: CheckEnv, name: String, vnames: Vec<String>, vpayloads: Vec<i64>) {
    let nv: i64 = vnames.len();
    let vname_sids: Vec<i64> = Vec::new();
    let mut i: i64 = 0;
    while i < nv {
        let sid: i64 = ts_intern_name(e.ts, vnames[i]);
        vname_sids.push(sid);
        i = i + 1;
    }
    let vname_lid: i64 = ts_add_args(e.ts, vname_sids);
    let vpayload_lid: i64 = ts_add_args(e.ts, vpayloads);
    e.edef_names.push(name);
    e.edef_variant_count.push(nv);
    e.edef_vname_lids.push(vname_lid);
    e.edef_vpayload_lids.push(vpayload_lid);
}

fn env_lookup_enum(e: CheckEnv, name: String) -> i64 {
    let n: i64 = e.edef_names.len();
    let mut i: i64 = 0;
    while i < n {
        if e.edef_names[i] == name {
            return i;
        }
        i = i + 1;
    }
    -1
}

fn env_define_alias(e: CheckEnv, name: String, tid: i64) {
    e.alias_names.push(name);
    e.alias_tids.push(tid);
}

fn env_lookup_alias(e: CheckEnv, name: String) -> i64 {
    let n: i64 = e.alias_names.len();
    let mut i: i64 = 0;
    while i < n {
        if e.alias_names[i] == name {
            return e.alias_tids[i];
        }
        i = i + 1;
    }
    -1
}

fn env_emit_error(e: CheckEnv, msg: String, span: i64) {
    env_emit_error_code(e, EC_TYPE_MISMATCH(), msg, span);
}

fn env_emit_error_code(e: CheckEnv, code: i64, msg: String, span: i64) {
    let span_start: i64 = span_unpack_start(span);
    let span_len: i64 = span_unpack_len(span);
    let full_msg: String = String::from("");
    if e.cur_fn_name.len() > 0 {
        full_msg.push_str(String::from("in fn "));
        full_msg.push_str(e.cur_fn_name);
        full_msg.push_str(String::from(": "));
    }
    full_msg.push_str(msg);
    let d: Diagnostic = diag_error(code, full_msg, e.cur_file, span_start, span_len);
    let dctx: DiagCtx = e.dctx;
    diag_ctx_emit(dctx, d);
}
