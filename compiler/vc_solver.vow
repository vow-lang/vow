module VcSolver

use verifier

// Bitwuzla verdict and model parsing for the native verifier, followed by the
// child-process driver (`vc_solver_check`). The parsers are pure. Anything that
// is not a recognised verdict, or a `sat` whose model is unparsable or
// incomplete, is `VC_ANS_ERROR` -- never `unsat`.

fn VC_ANS_SAT() -> i64 { 0 }
fn VC_ANS_UNSAT() -> i64 { 1 }
fn VC_ANS_UNKNOWN() -> i64 { 2 }
fn VC_ANS_ERROR() -> i64 { 3 }
fn VC_ANS_TIMEOUT() -> i64 { 4 }
fn VC_ANS_NOT_FOUND() -> i64 { 5 }

// A parsed bit-vector literal: `value` is the low 64 bits, `high` the next 64.
struct VcParsed {
    ok: i64,
    value: i64,
    high: i64,
}

struct VcModel {
    ok: i64,
    values: Vec<i64>,
    highs: Vec<i64>,
}

fn vc_parsed_bad() -> VcParsed {
    VcParsed { ok: 0, value: 0, high: 0 }
}

fn vc_first_line(s: String) -> String {
    let n: u64 = s.len();
    let mut i: u64 = 0;
    while i < n && s.byte_at(i) != 10 {
        i = i + 1;
    }
    str_trim(s.substring(0, i))
}

// VC_ANS_SAT / UNSAT / UNKNOWN from the first stdout line; VC_ANS_ERROR for
// anything else, including empty output.
fn vc_parse_check_sat(out: String) -> i64 {
    let line: String = vc_first_line(out);
    if line == String::from("sat") { return VC_ANS_SAT(); }
    if line == String::from("unsat") { return VC_ANS_UNSAT(); }
    if line == String::from("unknown") { return VC_ANS_UNKNOWN(); }
    VC_ANS_ERROR()
}

fn vc_digit(b: i64, base: u64) -> i64 {
    let mut d: i64 = -1;
    if b >= 48 && b <= 57 {
        d = b - 48;
    } else if b >= 97 && b <= 102 {
        d = b - 87;
    } else if b >= 65 && b <= 70 {
        d = b - 55;
    }
    if d >= base as i64 { return -1; }
    d
}

fn vc_value_end_ok(out: String, i: u64) -> bool {
    if i >= out.len() { return true; }
    let b: i64 = out.byte_at(i);
    is_ws(b) || b == 41
}

// `want_digits` digits of `bits` bits each, starting at `start`, accumulated
// into a 128-bit value. The literal must end at whitespace, `)` or the end.
fn vc_parse_radix_value(out: String, start: u64, bits: u64, want_digits: u64) -> VcParsed {
    let n: u64 = out.len();
    let base: u64 = 1u64 << bits;
    let mut j: u64 = start;
    let mut lo: u64 = 0;
    let mut hi: u64 = 0;
    let mut digits: u64 = 0;
    let mut going: bool = true;
    while j < n && going {
        let d: i64 = vc_digit(out.byte_at(j), base);
        if d < 0 {
            going = false;
        } else {
            hi = (hi << bits) | (lo >> (64u64 - bits));
            lo = (lo << bits) | d as u64;
            digits = digits + 1;
            j = j + 1;
        }
    }
    if digits != want_digits || !vc_value_end_ok(out, j) {
        return vc_parsed_bad();
    }
    VcParsed { ok: 1, value: lo as i64, high: hi as i64 }
}

// `(_ bv<N> W)` starting at the opening parenthesis, for W up to 64 bits.
fn vc_parse_bv_app(out: String, start: u64, width: i64) -> VcParsed {
    let prefix: String = String::from("(_ bv");
    let n: u64 = out.len();
    let plen: u64 = prefix.len();
    if width > 64 || start + plen > n || out.substring(start, start + plen) != prefix {
        return vc_parsed_bad();
    }
    let mut j: u64 = start + plen;
    while j < n && out.byte_at(j) >= 48 && out.byte_at(j) <= 57 {
        j = j + 1;
    }
    if j == start + plen {
        return vc_parsed_bad();
    }
    let tail: String = String::from(" ");
    tail.push_str(i64_to_string(width));
    tail.push_str(String::from(")"));
    if j + tail.len() > n || out.substring(j, j + tail.len()) != tail {
        return vc_parsed_bad();
    }
    match out.substring(start + plen, j).parse_u64() {
        Option::Some(v) => VcParsed { ok: 1, value: v as i64, high: 0 },
        Option::None => vc_parsed_bad(),
    }
}

// A `width`-bit bit-vector literal at `pos` (after optional whitespace):
// `#b` with `width` digits, `#x` with `width / 4` digits, or `(_ bvN width)`
// for widths up to 64. Anything else, including a literal of another width,
// is not ok.
fn vc_parse_value_at(out: String, pos: u64, width: i64) -> VcParsed {
    let n: u64 = out.len();
    let mut i: u64 = pos;
    while i < n && is_ws(out.byte_at(i)) {
        i = i + 1;
    }
    if i + 2 < n && out.byte_at(i) == 35 {
        let kind: i64 = out.byte_at(i + 1);
        if kind == 98 { return vc_parse_radix_value(out, i + 2, 1, width as u64); }
        if kind == 120 { return vc_parse_radix_value(out, i + 2, 4, (width / 4) as u64); }
        return vc_parsed_bad();
    }
    if i < n && out.byte_at(i) == 40 {
        return vc_parse_bv_app(out, i, width);
    }
    vc_parsed_bad()
}

// Values for `names`, in order, from a `get-value` answer; `widths[k]` is the
// declared width of `names[k]`. Every name must be present with a well-formed
// value of that width; otherwise `ok` is 0.
fn vc_parse_model(out: String, names: Vec<String>, widths: Vec<i64>) -> VcModel {
    let values: Vec<i64> = Vec::new();
    let highs: Vec<i64> = Vec::new();
    let mut ok: i64 = 1;
    let mut k: u64 = 0;
    while k < names.len() {
        let key: String = String::from("(");
        key.push_str(names[k]);
        key.push_str(String::from(" "));
        let at: i64 = str_find_from(out, 0, key);
        if at < 0 {
            ok = 0;
            values.push(0);
            highs.push(0);
        } else {
            let p: VcParsed = vc_parse_value_at(out, at as u64 + key.len(), widths[k]);
            if p.ok == 0 { ok = 0; }
            values.push(p.value);
            highs.push(p.high);
        }
        k = k + 1;
    }
    VcModel { ok: ok, values: values, highs: highs }
}

// ---------------------------------------------------------------------------
// Child-process driver
// ---------------------------------------------------------------------------

struct VcSolverAnswer {
    verdict: i64,
    values: Vec<i64>,
    highs: Vec<i64>,
    raw: String,
}

fn vc_answer(verdict: i64, values: Vec<i64>, highs: Vec<i64>, raw: String) -> VcSolverAnswer {
    VcSolverAnswer { verdict: verdict, values: values, highs: highs, raw: raw }
}

fn vc_answer_plain(verdict: i64, raw: String) -> VcSolverAnswer {
    vc_answer(verdict, Vec::new(), Vec::new(), raw)
}

// Path of the `bitwuzla` executable on $PATH, or "".
fn vc_solver_locate() -> String [read] {
    path_lookup(String::from("bitwuzla"))
}

// Classify a finished solver run. `exit_code` is the child's exit status;
// -2 is the runtime's watchdog kill and -1 a spawn failure or a signal.
fn vc_classify_run(exit_code: i64, stdout: String, stderr: String, names: Vec<String>, widths: Vec<i64>) -> VcSolverAnswer {
    let raw: String = String::from(stdout);
    raw.push_str(stderr);
    if exit_code == -2 { return vc_answer_plain(VC_ANS_TIMEOUT(), raw); }
    if exit_code != 0 { return vc_answer_plain(VC_ANS_ERROR(), raw); }
    if stderr.contains(String::from("[error]")) { return vc_answer_plain(VC_ANS_ERROR(), raw); }
    let verdict: i64 = vc_parse_check_sat(stdout);
    if verdict != VC_ANS_SAT() { return vc_answer_plain(verdict, raw); }
    let model: VcModel = vc_parse_model(stdout, names, widths);
    if model.ok == 0 { return vc_answer_plain(VC_ANS_ERROR(), raw); }
    vc_answer(VC_ANS_SAT(), model.values, model.highs, raw)
}

fn vc_solver_args(file: String) -> Vec<String> {
    let args: Vec<String> = Vec::new();
    args.push(String::from("--bv-output-format"));
    args.push(String::from("2"));
    args.push(file);
    args
}

// Runs `bin` on one self-contained query and returns its classified answer.
// `budget_ms` is a hard wall-clock limit enforced by the runtime watchdog; a
// non-positive budget is a timeout without spawning. The query lives in a
// private temp directory that is removed on every path, and the child's
// process-table entry is always evicted.
fn vc_solver_check(bin: String, query: String, names: Vec<String>, widths: Vec<i64>, budget_ms: i64) -> VcSolverAnswer [io, read, write] {
    if budget_ms <= 0 {
        return vc_answer_plain(VC_ANS_TIMEOUT(), String::from("time budget exhausted"));
    }
    let dir: String = mktemp_dir(String::from("vow-native"));
    if dir.len() == 0 {
        return vc_answer_plain(VC_ANS_ERROR(), String::from("cannot create a temporary directory"));
    }
    let file: String = String::from(dir);
    file.push_str(String::from("/query.smt2"));
    if fs_write(file, query) != 0 {
        fs_remove(file);
        fs_remove_dir(dir);
        return vc_answer_plain(VC_ANS_ERROR(), String::from("cannot write the solver query"));
    }
    let handle: i64 = process_start(bin, vc_solver_args(file));
    if handle < 0 {
        fs_remove(file);
        fs_remove_dir(dir);
        return vc_answer_plain(VC_ANS_ERROR(), String::from("failed to start the solver"));
    }
    let exit_code: i64 = process_wait_timeout(handle, budget_ms);
    let stdout: String = process_stdout_for(handle);
    let stderr: String = process_stderr_for(handle);
    process_kill(handle);
    fs_remove(file);
    fs_remove_dir(dir);
    vc_classify_run(exit_code, stdout, stderr, names, widths)
}
