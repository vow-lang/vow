module VcStr

use ir
use ir_dominance
use vc_ops
use vc_strops
use vc_term
use vc_smt
use vc_agg
use vc_vec

// Terms of the native verifier's `String` model (ADR-2026-10-08-1422, rule 3 and its
// #1426 addendum). A `String` is the `(array, length)` slot of `vc_vec`, with the
// byte of index `i` being the low 8 bits of the array's element (a parameter's array
// is unconstrained, so its high bits are junk; every read masks them, and every
// equality compares the masked bytes, so the junk is never observable).
//
// Equality of byte ranges is exact. Where both ends are known constants it is a finite
// conjunction of selects; otherwise it is a `VC_T_QEQ` binder, which only ever appears
// in an assumption: `range_eq` introduces a fresh Bool `e` and a fresh index `k` and
// assumes `e => (pre and forall i < n. a[i] == b[i + off])` and
// `not e => (not pre or (k < n and a[k] != b[k + off]))`. The two halves leave `e`
// exactly the equality for every polarity (the solver picks `k` as a witness), and the
// only quantifier is in a positive position. A string built from other strings (an
// append, a substring) is a fresh array with such a defining assumption: a conservative
// extension, which cannot make a query unsatisfiable by itself.
//
// None of this is a bound: the unfolding below `VC_STR_UNFOLD` is an encoding choice,
// the quantified form is exact for every length.

fn VC_STR_UNFOLD() -> i64 { 256 }

fn vc_str_byte_mask(ar: VcArena) -> i64 {
    vc_tm_bv(ar, 64, 255, 0)
}

// Byte `idx` of the string held in array `arr`.
fn vc_str_byte(ar: VcArena, arr: i64, idx: i64) -> i64 {
    vc_tm_app2(ar, VC_OP_BVAND(), vc_tm_app2(ar, VC_OP_SELECT(), arr, idx), vc_str_byte_mask(ar))
}

fn vc_str_axiom(ar: VcArena, assumed: Vec<i64>, fact: i64) {
    if vc_tm_is_true(ar, fact) { return; }
    ar.assumed[fact as u64] = 1;
    assumed.push(fact);
}

// The constant a 64-bit term denotes, or -1 when it is not a non-negative constant.
fn vc_str_const(ar: VcArena, t: i64) -> i64 {
    if !vc_is_bv(ar, t) || ar.a[t as u64] != 64 || ar.aux[t as u64] < 0 { return -1; }
    ar.aux[t as u64]
}

// `forall i < n. low8(a[i]) == low8(b[i + k])`, as a conjunction when `n` is a small
// constant and as a `VC_T_QEQ` otherwise.
fn vc_str_all_eq(vv: VcVec, ar: VcArena, a: i64, b: i64, k: i64, n: i64) -> i64 {
    let cnt: i64 = vc_str_const(ar, n);
    if cnt == 0 { return vc_tm_bool_const(ar, true); }
    if cnt > 0 && cnt <= VC_STR_UNFOLD() {
        let mut acc: i64 = vc_tm_bool_const(ar, true);
        let mut j: i64 = 0;
        while j < cnt {
            let ji: i64 = vc_tm_bv(ar, 64, j, 0);
            let same: i64 = vc_tm_app2(ar, VC_OP_EQ(), vc_str_byte(ar, a, ji), vc_str_byte(ar, b, vc_tm_app2(ar, VC_OP_BVADD(), k, ji)));
            acc = vc_tm_and(ar, acc, same);
            j = j + 1;
        }
        return acc;
    }
    vv.quantified = true;
    vc_tm_qeq(ar, a, b, k, n)
}

// A Bool term that is exactly `pre and forall i < n. low8(a[i]) == low8(b[i + k])`
// (`pre` is the condition under which the range is meaningful, such as equal
// lengths). Quantifier-free when the range is a small constant.
fn vc_str_range_eq(vv: VcVec, ar: VcArena, hdr: SmtScript, assumed: Vec<i64>, pre: i64, a: i64, b: i64, k: i64, n: i64) -> i64 {
    let body: i64 = vc_str_all_eq(vv, ar, a, b, k, n);
    if ar.kinds[body as u64] != VC_T_QEQ() { return vc_tm_and(ar, pre, body); }
    let e: i64 = vc_agg_declare(ar, hdr, vc_vec_fresh_name(vv, String::from("se")), VC_SORT_BOOL());
    let w: i64 = vc_agg_declare(ar, hdr, vc_vec_fresh_name(vv, String::from("sk")), 64);
    vc_str_axiom(ar, assumed, vc_tm_or(ar, vc_tm_app1(ar, VC_OP_NOT(), e), vc_tm_and(ar, pre, body)));
    let differs: i64 = vc_tm_app2(ar, VC_OP_DISTINCT(), vc_str_byte(ar, a, w), vc_str_byte(ar, b, vc_tm_app2(ar, VC_OP_BVADD(), k, w)));
    let witness: i64 = vc_tm_and(ar, vc_tm_app2(ar, VC_OP_BVULT(), w, n), differs);
    vc_str_axiom(ar, assumed, vc_tm_or(ar, e, vc_tm_or(ar, vc_tm_app1(ar, VC_OP_NOT(), pre), witness)));
    e
}

fn vc_str_zero(ar: VcArena) -> i64 {
    vc_tm_bv(ar, 64, 0, 0)
}

// `a == b` as strings: equal lengths and every byte equal.
fn vc_str_eq(vv: VcVec, ar: VcArena, hdr: SmtScript, assumed: Vec<i64>, aa: i64, la: i64, ab: i64, lb: i64) -> i64 {
    if aa == ab && la == lb { return vc_tm_bool_const(ar, true); }
    let pre: i64 = vc_tm_app2(ar, VC_OP_EQ(), la, lb);
    if vc_tm_is_false(ar, pre) { return pre; }
    vc_str_range_eq(vv, ar, hdr, assumed, pre, aa, ab, vc_str_zero(ar), la)
}

// `s` starts with `p`.
fn vc_str_starts_with(vv: VcVec, ar: VcArena, hdr: SmtScript, assumed: Vec<i64>, sa: i64, sl: i64, pa: i64, pl: i64) -> i64 {
    let pre: i64 = vc_tm_app2(ar, VC_OP_BVULE(), pl, sl);
    vc_str_range_eq(vv, ar, hdr, assumed, pre, pa, sa, vc_str_zero(ar), pl)
}

// `s` ends with `p`: the bytes of `p` against those from offset `|s| - |p|`.
fn vc_str_ends_with(vv: VcVec, ar: VcArena, hdr: SmtScript, assumed: Vec<i64>, sa: i64, sl: i64, pa: i64, pl: i64) -> i64 {
    let pre: i64 = vc_tm_app2(ar, VC_OP_BVULE(), pl, sl);
    vc_str_range_eq(vv, ar, hdr, assumed, pre, pa, sa, vc_tm_app2(ar, VC_OP_BVSUB(), sl, pl), pl)
}

// `string_matches_literal_at(s, pos, text)`: `pos + |text| <= |s|` (without wrapping)
// and the bytes of `text` at `pos`. `lit` is the array of the literal's slot, used
// only for a literal too long to unfold.
fn vc_str_matches_literal(vv: VcVec, ar: VcArena, hdr: SmtScript, assumed: Vec<i64>, sa: i64, sl: i64, pos: i64, text: String, lit: i64) -> i64 {
    let n: i64 = text.len() as i64;
    let nt: i64 = vc_tm_bv(ar, 64, n, 0);
    let fits: i64 = vc_tm_and(ar, vc_tm_app2(ar, VC_OP_BVULE(), pos, sl), vc_tm_app2(ar, VC_OP_BVULE(), nt, vc_tm_app2(ar, VC_OP_BVSUB(), sl, pos)));
    if n > VC_STR_UNFOLD() {
        return vc_str_range_eq(vv, ar, hdr, assumed, fits, lit, sa, pos, nt);
    }
    let mut acc: i64 = fits;
    let mut j: i64 = 0;
    while j < n {
        let at: i64 = vc_tm_app2(ar, VC_OP_BVADD(), pos, vc_tm_bv(ar, 64, j, 0));
        acc = vc_tm_and(ar, acc, vc_tm_app2(ar, VC_OP_EQ(), vc_str_byte(ar, sa, at), vc_tm_bv(ar, 64, text.byte_at(j as u64), 0)));
        j = j + 1;
    }
    acc
}

// A fresh array with no constraint: the contents of a string nothing reads.
fn vc_str_fresh_array(vv: VcVec, ar: VcArena, hdr: SmtScript, prefix: String) -> i64 {
    let name: String = vc_vec_fresh_name(vv, prefix);
    name.push_str(String::from("_varr"));
    vc_agg_declare(ar, hdr, name, VC_SORT_ARRAY64())
}

// The array of `s` with `t` appended: `r[i] == s[i]` below `|s|` and
// `r[|s| + j] == t[j]` below `|t|`.
fn vc_str_append(vv: VcVec, ar: VcArena, hdr: SmtScript, assumed: Vec<i64>, sa: i64, sl: i64, ta: i64, tl: i64) -> i64 {
    let r: i64 = vc_str_fresh_array(vv, ar, hdr, String::from("sa"));
    if vv.content {
        vc_str_axiom(ar, assumed, vc_str_all_eq(vv, ar, r, sa, vc_str_zero(ar), sl));
        vc_str_axiom(ar, assumed, vc_str_all_eq(vv, ar, ta, r, sl, tl));
    }
    r
}

// The array of the `len` bytes of `s` from offset `start`.
fn vc_str_slice(vv: VcVec, ar: VcArena, hdr: SmtScript, assumed: Vec<i64>, sa: i64, start: i64, len: i64) -> i64 {
    let r: i64 = vc_str_fresh_array(vv, ar, hdr, String::from("ss"));
    if vv.content {
        vc_str_axiom(ar, assumed, vc_str_all_eq(vv, ar, r, sa, start, len));
    }
    r
}

fn vc_str_min(ar: VcArena, x: i64, y: i64) -> i64 {
    vc_tm_app3(ar, VC_OP_ITE(), vc_tm_app2(ar, VC_OP_BVULT(), x, y), x, y)
}

// `substring(start, end)`: `start` clamped to `|s|`, then `end` into `[start, |s|]`.
// Returns the clamped start and the length.
fn vc_str_substring_range(ar: VcArena, sl: i64, start: i64, end: i64, out: Vec<i64>) {
    let st: i64 = vc_str_min(ar, start, sl);
    let low: i64 = vc_tm_app3(ar, VC_OP_ITE(), vc_tm_app2(ar, VC_OP_BVULT(), end, st), st, end);
    let en: i64 = vc_str_min(ar, low, sl);
    out.push(st);
    out.push(vc_tm_app2(ar, VC_OP_BVSUB(), en, st));
}

// `string_substr(start, len)`: `start` clamped to `|s|`, `len` to the bytes after it.
fn vc_str_substr_range(ar: VcArena, sl: i64, start: i64, len: i64, out: Vec<i64>) {
    let st: i64 = vc_str_min(ar, start, sl);
    out.push(st);
    out.push(vc_str_min(ar, len, vc_tm_app2(ar, VC_OP_BVSUB(), sl, st)));
}

// The static bytes of a literal: a fresh array and, when some instruction reads
// bytes, one fact per byte. Returns the slot's `(array, length)` through `vv`.
fn vc_str_literal(vv: VcVec, ar: VcArena, hdr: SmtScript, assumed: Vec<i64>, obj: i64, bi: i64, text: String) {
    let arr: i64 = vc_str_fresh_array(vv, ar, hdr, String::from("sl"));
    let n: u64 = text.len();
    if vv.content {
        let mut j: u64 = 0;
        while j < n {
            let cell: i64 = vc_tm_app2(ar, VC_OP_SELECT(), arr, vc_tm_bv(ar, 64, j as i64, 0));
            vc_str_axiom(ar, assumed, vc_tm_app2(ar, VC_OP_EQ(), cell, vc_tm_bv(ar, 64, text.byte_at(j), 0)));
            j = j + 1;
        }
    }
    let s: i64 = vc_vec_create_with(vv, ar, hdr, obj, bi, arr, vc_tm_bv(ar, 64, n as i64, 0));
    vv.lit_text[s as u64] = text;
}

// True when some call of `f` reads the bytes of a string.
fn vc_str_reads_bytes(f: IrFunction) -> bool {
    let mut bi: u64 = 0;
    while bi < f.blocks.len() {
        let blk: IrBlock = f.blocks[bi];
        let mut ii: u64 = 0;
        while ii < blk.insts.len() {
            if vc_str_kind_reads_bytes(vc_inst_vec_kind(blk.insts[ii])) { return true; }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    false
}

// Gate rule for the `String` operations (`vc_vec_shape_detail` covers aliasing): the
// static bytes of a literal (`ConstStr`) are read only by `__vow_string_literal` and
// by the literal operand of `__vow_string_matches_literal_at`, `String::new` has a
// null pointer and length 0, and a string built from a literal's static bytes is
// read-only at run time (`__vow_string_clear` and the pushes trap on it), so
// mutating one is outside the model. "" when the shape is fine, else the detail of
// an `unsupported-opcode` skip.
fn vc_str_shape_detail(f: IrFunction, n_ids: u64) -> String {
    let is_cstr: Vec<i64> = dom_fill(n_ids, 0);
    let is_lit: Vec<i64> = dom_fill(n_ids, 0);
    let zero: Vec<i64> = dom_fill(n_ids, 0);
    let mut bi: u64 = 0;
    while bi < f.blocks.len() {
        let blk: IrBlock = f.blocks[bi];
        let mut ii: u64 = 0;
        while ii < blk.insts.len() {
            let inst: IrInst = blk.insts[ii];
            if inst.id >= 0 {
                if inst.op == IOP_CONST_STR() { is_cstr[inst.id as u64] = 1; }
                if inst.op == IOP_CONST_I64() && inst.dv == 0 { zero[inst.id as u64] = 1; }
                if vc_inst_vec_kind(inst) == VC_STR_LITERAL() { is_lit[inst.id as u64] = 1; }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    let mut changed: bool = true;
    while changed {
        changed = false;
        bi = 0;
        while bi < f.blocks.len() {
            let blk: IrBlock = f.blocks[bi];
            let mut ii: u64 = 0;
            while ii < blk.insts.len() {
                let inst: IrInst = blk.insts[ii];
                if inst.op == IOP_UPSILON() && inst.args.len() == 1 && is_lit[inst.args[0] as u64] == 1 && is_lit[inst.dv as u64] != 1 {
                    is_lit[inst.dv as u64] = 1;
                    changed = true;
                }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
    }
    bi = 0;
    while bi < f.blocks.len() {
        let blk: IrBlock = f.blocks[bi];
        let mut ii: u64 = 0;
        while ii < blk.insts.len() {
            let inst: IrInst = blk.insts[ii];
            let k: i64 = vc_inst_vec_kind(inst);
            let mut a: u64 = 0;
            while a < inst.args.len() {
                if is_cstr[inst.args[a] as u64] == 1 {
                    let ok: bool = (k == VC_STR_LITERAL() && a == 0) || (k == VC_STR_MATCHES_LITERAL_AT() && a == 2);
                    if !ok { return String::from("String literal bytes used outside a literal"); }
                }
                a = a + 1;
            }
            if k == VC_STR_NEW() {
                if inst.args.len() != 2 || zero[inst.args[0] as u64] != 1 || zero[inst.args[1] as u64] != 1 {
                    return String::from("String::new with a non-zero pointer or length");
                }
            }
            if vc_str_kind_mutates(k) && inst.args.len() > 0 && is_lit[inst.args[0] as u64] == 1 {
                return String::from("String literal mutated");
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    String::from("")
}
