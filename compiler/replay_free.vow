module ReplayFree

use ast
use contract_text
use replay_listed

// Objects the counterexample leaves free. A position that holds the address of a `Vec`, a
// `String` or a struct carries `<position>.contents` = `unconstrained` when the function never
// read through the address (`vc_cex_verdict`): any contents reproduce the failure, so the harness
// builds the simplest value (`replay_obj_arg`). Any other token, or none, leaves the object unbuilt.

// The simplest value of the type `tid` of an object, as a block: an empty `String` or an
// empty `Vec`; "" for any other type.
fn replay_free_elem(a: AstArena, tid: i64) -> String {
    if type_tag(a, tid) == TY_NAMED() && arena_str(a, type_a(a, tid)) == String::from("String") {
        return String::from("String::from(\"\")");
    }
    if type_tag(a, tid) == TY_GENERIC() && arena_str(a, type_a(a, tid)) == String::from("Vec") {
        let shown: String = print_type_text(a, tid);
        let out: String = String::from("{ let __replay_e: ");
        out.push_str(shown);
        out.push_str(String::from(" = Vec::new(); __replay_e }"));
        return out;
    }
    String::from("")
}
