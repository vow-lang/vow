module ReplayMain

use lexer
use ast
use diag
use mutants_patch
use contract_text
use replay_mapkeys
use replay_ints
use replay_alias
use replay_listed

// Entry-`main` handling for `--replay-cex` (#1550). A replay harness is the
// entry file's own text plus a synthesized `fn main`, so a file that already
// defines `main` must have that definition renamed out of the way first. The
// definition is located in the merged AST, never by text search, so `fn main(`
// inside a comment or string literal is not mistaken for it. Only the span
// start is used: packed spans clamp their length to 65535 bytes, so removing
// the definition by span would truncate a long `main`.

// Byte offset of the `fn` keyword of the `main` defined in `path` itself, or
// -1 when the entry file defines none. A `main` from a `use`d dependency is not
// the entry file's `main`, so only items whose originating file is `path` count.
fn replay_entry_main_start(m: Module, item_files: Vec<String>, path: String) -> i64 {
    let a: AstArena = m.arena;
    let n: u64 = m.items.len();
    let mut i: u64 = 0u64;
    while i < n {
        let it: i64 = m.items[i];
        if i < item_files.len() && item_files[i] == path && it >= 0 && item_kind(it) == ITEM_FN() {
            let fid: i64 = item_id(it);
            if !fn_is_declaration(a, fid) && arena_str(a, fn_name_sid(a, fid)) == String::from("main") {
                return span_unpack_start(fn_span(a, fid));
            }
        }
        i = i + 1u64;
    }
    -1
}

fn replay_is_space(b: i64) -> bool {
    b == 32 || b == 9 || b == 10 || b == 13
}

// `src` with the `main` whose `fn` keyword sits at byte `start` renamed to
// `__replay_orig_main`. Returns "" when `src` does not hold `fn`, whitespace and
// exactly the identifier `main` at that offset, so a stale offset can never
// corrupt a harness silently.
fn replay_rename_main(src: String, start: i64) -> String {
    let n: i64 = src.len() as i64;
    if start < 0 || start + 2 > n { return String::from(""); }
    if src.byte_at(start as u64) != 102 || src.byte_at((start + 1) as u64) != 110 {
        return String::from("");
    }
    let mut p: i64 = start + 2;
    while p < n && replay_is_space(src.byte_at(p as u64)) {
        p = p + 1;
    }
    let name: String = String::from("main");
    let nl: i64 = name.len() as i64;
    if p + nl > n { return String::from(""); }
    if src.substring(p as u64, (p + nl) as u64) != name { return String::from(""); }
    let end: i64 = p + nl;
    if end < n {
        let after: i64 = src.byte_at(end as u64);
        if after >= 0 && after <= 255 && is_ident_cont(after) { return String::from(""); }
    }
    splice(src, p as u64, nl as u64, String::from("__replay_orig_main"))
}

// Aggregate arguments for the native backend's `--replay-cex`. The native
// counterexample lists an aggregate parameter's scalar slots as `<param>.<slot>`
// (see `vc_model_symbol_name`): a struct's fields from slot 0, an enum's
// discriminant at slot 0 and the chosen variant's payload from slot 1, one slot
// per scalar. A slot the function reads at two sorts carries a `:bool` or
// `:<bits>` suffix. The IR has no field names, so the slots are mapped back to
// fields here from the declaration in the source.

struct ReplayArg {
    lit: String,
    ty_text: String,
    reason: String,
    deps: String,
}

fn replay_arg_skip(reason: String) -> ReplayArg {
    ReplayArg { lit: String::from(""), ty_text: String::from(""), reason: reason, deps: String::from("") }
}

fn replay_arg_ok(lit: String, ty_text: String) -> ReplayArg {
    ReplayArg { lit: lit, ty_text: ty_text, reason: String::from(""), deps: String::from("") }
}

// `deps` lists, each followed by a space, the harness bindings of the other parameters the
// literal names (see `ReplayObjs`), so they are declared before it.
fn replay_arg_ok_deps(lit: String, ty_text: String, deps: String) -> ReplayArg {
    ReplayArg { lit: lit, ty_text: ty_text, reason: String::from(""), deps: deps }
}

// True if `s` is a plain decimal integer literal (optional leading `-`).
fn replay_is_int_literal(s: String) -> bool {
    let n: u64 = s.len();
    if n == 0 { return false; }
    let mut i: u64 = 0;
    if s.byte_at(0) == 45 {
        if n == 1 { return false; }
        i = 1;
    }
    while i < n {
        let b: i64 = s.byte_at(i);
        if b < 48 || b > 57 { return false; }
        i = i + 1;
    }
    true
}

fn replay_cex_value(names: Vec<String>, vals: Vec<String>, key: String) -> String {
    replay_listed_value(names, vals, key)
}

// Id of item `it` when it is of `kind`, -1 otherwise (an id is never negative).
// The only code here that calls the contracted `item_kind`/`item_id`, so it is
// the only code the C verifier model sees, and that model cannot type the
// `String` `arena_str` reads out of a `Vec`. Loop-free, so both verifiers
// decide its callee `requires` outright.
fn replay_item_id_of_kind(it: i64, kind: i64) -> i64 {
    if it >= 0 && item_kind(it) == kind { item_id(it) } else { -1 }
}

// Ids of the items of `kind`, in declaration order. Calls no contracted
// function, so the verifiers have no obligation in this loop.
fn replay_item_ids(m: Module, kind: i64) -> Vec<i64> {
    let out: Vec<i64> = Vec::new();
    let items: Vec<i64> = m.items;
    let mut i: u64 = 0u64;
    while i < items.len() {
        let id: i64 = replay_item_id_of_kind(items[i], kind);
        if id >= 0 {
            out.push(id);
        }
        i = i + 1u64;
    }
    out
}

fn replay_find_fn_item(m: Module, name: String) -> i64 {
    let a: AstArena = m.arena;
    let ids: Vec<i64> = replay_item_ids(m, ITEM_FN());
    let mut i: u64 = 0u64;
    while i < ids.len() {
        let fid: i64 = ids[i];
        if !fn_is_declaration(a, fid) && arena_str(a, fn_name_sid(a, fid)) == name {
            return fid;
        }
        i = i + 1u64;
    }
    -1
}

fn replay_find_struct(m: Module, name: String) -> i64 {
    let a: AstArena = m.arena;
    let ids: Vec<i64> = replay_item_ids(m, ITEM_STRUCT());
    let mut i: u64 = 0u64;
    while i < ids.len() {
        if arena_str(a, sdef_name_sid(a, ids[i])) == name { return ids[i]; }
        i = i + 1u64;
    }
    -1
}

fn replay_find_enum(m: Module, name: String) -> i64 {
    let a: AstArena = m.arena;
    let ids: Vec<i64> = replay_item_ids(m, ITEM_ENUM());
    let mut i: u64 = 0u64;
    while i < ids.len() {
        if arena_str(a, edef_name_sid(a, ids[i])) == name { return ids[i]; }
        i = i + 1u64;
    }
    -1
}

// The identity the model gave aggregate parameter `pname` (`<param>.alias`), or
// "" when the function has no aliasable parameters. Two parameters with the same
// identity are one object, so the harness passes one value for both.
fn replay_alias_id(names: Vec<String>, vals: Vec<String>, pname: String) -> String {
    replay_cex_value(names, vals, str3r(pname, String::from(".alias"), String::from("")))
}

// Position of `id` in `seen`, or -1; an empty id is never found.
fn replay_alias_find(seen: Vec<String>, id: String) -> i64 {
    if id.len() == 0 { return -1; }
    let mut i: u64 = 0u64;
    while i < seen.len() {
        if seen[i] == id { return i as i64; }
        i = i + 1u64;
    }
    -1
}

fn replay_slot_key(pname: String, slot: i64) -> String {
    let out: String = String::from(pname);
    out.push_str(String::from("."));
    out.push_str(i64_to_string(slot));
    out
}

// The counterexample value of slot `slot` of `pname` viewed at `label`
// (`bool` or a bit width), or "" when the model never read it. The suffixed
// name is the one used when the slot has two views; the plain name is never
// emitted for such a slot, so the plain lookup goes first.
fn replay_slot_value(pname: String, slot: i64, label: String, names: Vec<String>, vals: Vec<String>) -> String {
    let key: String = replay_slot_key(pname, slot);
    let hit: String = replay_cex_value(names, vals, key);
    if hit.len() > 0 { return hit; }
    let suffixed: String = String::from(key);
    suffixed.push_str(String::from(":"));
    suffixed.push_str(label);
    replay_cex_value(names, vals, suffixed)
}

// Source text of the `bool`, integer or `f64` value `raw`, as the counterexample
// prints it, for the type named `name`; or the reason there is none. An `f32`
// has no source form: the language has no `f32` literal and no cast to or from a
// float, so a harness cannot build one.
fn replay_scalar_literal(name: String, raw: String) -> ReplayArg {
    if name == String::from("bool") {
        if raw == String::from("true") || raw == String::from("false") { return replay_arg_ok(raw, name); }
        return replay_arg_skip(str3r(String::from("value `"), raw, String::from("` is not a bool")));
    }
    if name == String::from("f64") { return replay_f64_literal(raw); }
    if name == String::from("f32") {
        return replay_arg_skip(String::from("f32 has no source literal (nor float casts), so replay cannot rebuild it"));
    }
    if name == String::from("i128") || name == String::from("u128") { return replay_wide_literal(name, raw); }
    if replay_int_bits(name) == 0 {
        return replay_arg_skip(str3r(String::from("type `"), name, String::from("` is not a scalar")));
    }
    if !replay_is_int_literal(raw) || !replay_int_fits(name, raw) {
        return replay_arg_skip(str3r(String::from("value `"), raw, str3r(String::from("` is not a `"), name, String::from("`"))));
    }
    replay_arg_ok(replay_int_literal(name, raw), name)
}

// A 128-bit integer. Its literals carry the type suffix (a magnitude past `i64`
// has no other spelling) and the most negative `i128` has no literal of its own.
fn replay_wide_literal(name: String, raw: String) -> ReplayArg {
    let signed: bool = name == String::from("i128");
    let neg: bool = raw.len() > 0 && raw.byte_at(0) == 45;
    let digits: u64 = { if neg { raw.len() - 1 } else { raw.len() } };
    if !replay_is_int_literal(raw) || digits > 39 || (neg && !signed) {
        return replay_arg_skip(str3r(String::from("value `"), raw, str3r(String::from("` is not a `"), name, String::from("`"))));
    }
    if raw == String::from("-170141183460469231731687303715884105728") {
        return replay_arg_ok(String::from("(-170141183460469231731687303715884105727i128 - 1i128)"), name);
    }
    replay_arg_ok(str3r(raw, name, String::from("")), name)
}

// An `f64` from the text `format_f64_bits` gives (the shortest round-trip
// decimal: `NaN`, `inf`, `-inf`, `-0`, `2.5`, `100`). The language has no
// negative or non-finite literal, so those are built by arithmetic that is exact
// in IEEE-754: `0.0 - x` negates a nonzero finite `x` and `0.0 * -1.0` is -0.
fn replay_f64_literal(raw: String) -> ReplayArg {
    let ty: String = String::from("f64");
    if raw == String::from("NaN") { return replay_arg_ok(String::from("(0.0 / 0.0)"), ty); }
    if raw == String::from("inf") { return replay_arg_ok(String::from("(1.0 / 0.0)"), ty); }
    if raw == String::from("-inf") { return replay_arg_ok(String::from("(0.0 - (1.0 / 0.0))"), ty); }
    if raw == String::from("-0") { return replay_arg_ok(String::from("(0.0 * (0.0 - 1.0))"), ty); }
    let neg: bool = raw.len() > 0 && raw.byte_at(0) == 45;
    let mut mag: String = String::from(raw);
    if neg { mag = raw.substring(1, raw.len()); }
    if !replay_is_float_magnitude(mag) {
        return replay_arg_skip(str3r(String::from("value `"), raw, String::from("` is not an f64")));
    }
    let lit: String = String::from(mag);
    if !mag.contains(String::from(".")) { lit.push_str(String::from(".0")); }
    if neg { return replay_arg_ok(str3r(String::from("(0.0 - "), lit, String::from(")")), ty); }
    replay_arg_ok(lit, ty)
}

// Digits with at most one interior `.`; no sign and no exponent.
fn replay_is_float_magnitude(s: String) -> bool {
    let n: u64 = s.len();
    if n == 0 { return false; }
    let mut dots: i64 = 0;
    let mut i: u64 = 0;
    while i < n {
        let b: i64 = s.byte_at(i);
        if b == 46 {
            dots = dots + 1;
            if i == 0 || i + 1 == n { return false; }
        } else if b < 48 || b > 57 {
            return false;
        }
        i = i + 1;
    }
    dots <= 1
}

// The suffix the counterexample puts on a slot of type `name` that the function
// reads at two sorts.
fn replay_slot_label(name: String) -> String {
    if name == String::from("bool") || name == String::from("f64") || name == String::from("f32") {
        return String::from(name);
    }
    if name == String::from("i128") || name == String::from("u128") { return String::from("128"); }
    i64_to_string(replay_int_bits(name))
}

fn replay_zero_text(name: String) -> String {
    if name == String::from("bool") { return String::from("false"); }
    String::from("0")
}

// A function that reads memory through a field and writes a parameter has the native
// counterexample list the address of each `Vec`, `String` and struct parameter as `<param>.addr`;
// a field holding an object lists the address it holds as its own slot (`b.0`), and equal values
// are one object. The harness binds each parameter once and such a field names the binding.
struct ReplayObjs {
    addrs: Vec<String>,
    binds: Vec<String>,
    tys: Vec<String>,
    owners: Vec<i64>,
    cur: i64,
}

// A `linear struct` is consumed once, so a harness cannot name its binding in a second place.
fn replay_holds_object(m: Module, tid: i64) -> bool {
    let a: AstArena = m.arena;
    if type_tag(a, tid) == TY_GENERIC() { return arena_str(a, type_a(a, tid)) == String::from("Vec"); }
    if type_tag(a, tid) != TY_NAMED() { return false; }
    let name: String = arena_str(a, type_a(a, tid));
    if name == String::from("String") { return true; }
    let sid: i64 = replay_find_struct(m, name);
    sid >= 0 && sdef_is_linear(a, sid) == 0
}

// Per source parameter of `fn_name`: its address ("" for none), the harness binding of its value
// (the first parameter's with the same `.alias` identity, else `__replay_a<i>`), its type text and
// the index of the first parameter it is one object with.
fn replay_param_objects(m: Module, fn_name: String, names: Vec<String>, vals: Vec<String>) -> ReplayObjs {
    let a: AstArena = m.arena;
    let addrs: Vec<String> = Vec::new();
    let binds: Vec<String> = Vec::new();
    let tys: Vec<String> = Vec::new();
    let owners: Vec<i64> = Vec::new();
    let ids: Vec<String> = Vec::new();
    let fid: i64 = replay_find_fn_item(m, fn_name);
    if fid >= 0 {
        let lid: i64 = fn_params_lid(a, fid);
        let n: i64 = list_len(a, lid) / 4;
        let mut i: i64 = 0;
        while i < n {
            let pname: String = arena_str(a, list_get(a, lid, i * 4));
            let tid: i64 = replay_resolve_type(m, list_get(a, lid, i * 4 + 1), 0);
            let aid: String = replay_alias_id(names, vals, pname);
            let first: i64 = replay_alias_find(ids, aid);
            ids.push(aid);
            tys.push(print_type_text(a, tid));
            if first >= 0 && first < binds.len() as i64 {
                owners.push(first);
                binds.push(binds[first as u64]);
            } else {
                owners.push(i);
                binds.push(str3r(String::from("__replay_a"), i64_to_string(i), String::from("")));
            }
            if replay_holds_object(m, tid) {
                addrs.push(replay_cex_value(names, vals, str3r(pname, String::from(".addr"), String::from(""))));
            } else {
                addrs.push(String::from(""));
            }
            i = i + 1;
        }
    }
    ReplayObjs { addrs: addrs, binds: binds, tys: tys, owners: owners, cur: -1 }
}

fn replay_objs_at(o: ReplayObjs, pi: i64) -> ReplayObjs {
    ReplayObjs { addrs: o.addrs, binds: o.binds, tys: o.tys, owners: o.owners, cur: pi }
}

fn replay_obj_bind(o: ReplayObjs, pi: i64) -> String {
    let binds: Vec<String> = o.binds;
    if pi >= 0 && pi < binds.len() as i64 { return binds[pi as u64]; }
    str3r(String::from("__replay_a"), i64_to_string(pi), String::from(""))
}

fn replay_obj_owner(o: ReplayObjs, pi: i64) -> i64 {
    let owners: Vec<i64> = o.owners;
    if pi >= 0 && pi < owners.len() as i64 { return owners[pi as u64]; }
    pi
}

fn replay_obj_ty(o: ReplayObjs, pi: i64) -> String {
    let tys: Vec<String> = o.tys;
    if pi >= 0 && pi < tys.len() as i64 { return tys[pi as u64]; }
    String::from("")
}

// Index of the first parameter whose address is the value of slot `key`; -1 when the slot is not
// listed or names no parameter, -2 when parameters that are not one object share that address.
fn replay_held_param(key: String, names: Vec<String>, vals: Vec<String>, objs: ReplayObjs) -> i64 {
    let raw: String = replay_cex_value(names, vals, key);
    if raw.len() == 0 { return -1; }
    let addrs: Vec<String> = objs.addrs;
    let mut first: i64 = -1;
    let mut i: u64 = 0u64;
    while i < addrs.len() {
        if addrs[i] == raw {
            if first < 0 { first = i as i64; }
            else if replay_obj_owner(objs, i as i64) != replay_obj_owner(objs, first) { return -2; }
        }
        i = i + 1u64;
    }
    first
}

// A field of type text `shown` that holds the object of parameter `held` is that parameter's
// binding. The model does not know types, so a parameter of another type is no such object. The
// parameter being built cannot hold itself: its field would need a value before it exists.
fn replay_alias_field(shown: String, held: i64, objs: ReplayObjs) -> ReplayArg {
    let theirs: String = replay_obj_ty(objs, held);
    if theirs != shown {
        return replay_field_skip(shown, str3r(String::from("` holds the object of a parameter of type `"), theirs, String::from("`")));
    }
    let bind: String = replay_obj_bind(objs, held);
    if bind == replay_obj_bind(objs, objs.cur) {
        return replay_field_skip(shown, String::from("` holds the very value that holds it, and a value must exist before a field can hold it, so replay cannot build the cycle"));
    }
    replay_arg_ok_deps(String::from(bind), shown, str3r(bind, String::from(" "), String::from("")))
}

// Indices of the items in an order that declares each binding before a value names it. `defs[i]`
// is the binding item `i` declares ("" for none) and `uses[i]` the bindings its value names, each
// followed by a space. Fewer indices than declared bindings means items need each other.
fn replay_let_order(defs: Vec<String>, uses: Vec<String>) -> Vec<i64> {
    let order: Vec<i64> = Vec::new();
    let done: Vec<bool> = Vec::new();
    let n: u64 = defs.len();
    let mut k: u64 = 0u64;
    while k < n {
        done.push(false);
        k = k + 1u64;
    }
    let mut round: u64 = 0u64;
    while round < n && uses.len() == n {
        let mut i: u64 = 0u64;
        while i < n {
            if !done[i] && defs[i].len() > 0 && replay_uses_done(defs, done, uses[i]) {
                done[i] = true;
                order.push(i as i64);
            }
            i = i + 1u64;
        }
        round = round + 1u64;
    }
    order
}

fn replay_ordered_lets(lets: Vec<String>, defs: Vec<String>, uses: Vec<String>) -> ReplayArg {
    let order: Vec<i64> = replay_let_order(defs, uses);
    if order.len() as i64 != replay_count_defs(defs) || lets.len() != defs.len() {
        return replay_arg_skip(String::from("parameters hold each other's objects, so no order declares each before it is used"));
    }
    let body: String = String::from("");
    let mut i: u64 = 0u64;
    while i < order.len() {
        let k: i64 = order[i];
        if k < 0 || k >= lets.len() as i64 { return replay_arg_skip(String::from("no order declares each parameter before it is used")); }
        body.push_str(lets[k as u64]);
        i = i + 1u64;
    }
    replay_arg_ok(body, String::from(""))
}

fn replay_count_defs(defs: Vec<String>) -> i64 {
    let mut n: i64 = 0;
    let mut i: u64 = 0u64;
    while i < defs.len() {
        if defs[i].len() > 0 { n = n + 1; }
        i = i + 1u64;
    }
    n
}

fn replay_uses_done(defs: Vec<String>, done: Vec<bool>, uses: String) -> bool {
    let n: u64 = uses.len();
    let mut start: u64 = 0u64;
    let mut i: u64 = 0u64;
    while i < n {
        if uses.byte_at(i) == 32 {
            if i > start && !replay_def_done(defs, done, uses.substring(start, i)) { return false; }
            start = i + 1u64;
        }
        i = i + 1u64;
    }
    true
}

fn replay_def_done(defs: Vec<String>, done: Vec<bool>, name: String) -> bool {
    let mut j: u64 = 0u64;
    while j < defs.len() && j < done.len() {
        if defs[j] == name { return done[j]; }
        j = j + 1u64;
    }
    false
}

// How deep an aggregate held in an aggregate is rebuilt.
fn REPLAY_MAX_DEPTH() -> i64 { 8 }

// Skip of a field of AST type text `shown`; `tail` completes "field of type `<shown>" with its closing quote.
fn replay_field_skip(shown: String, tail: String) -> ReplayArg {
    replay_arg_skip(str3r(String::from("field of type `"), shown, tail))
}

// True for the element types a held `Vec` rebuilds: `bool` and the integers (a float is a raw slot).
fn replay_held_elem_scalar(a: AstArena, tid: i64) -> bool {
    type_tag(a, tid) == TY_NAMED() && replay_held_elem_name(arena_str(a, type_a(a, tid)))
}

// The `Vec` or `String` a field of AST type `tid` holds at `slot`. A field the model never read
// holds an empty collection: nothing the function did depended on it. A field whose address
// is listed but whose length is not was read by something other than `len`, `v[i]` or
// `byte_at`, and is not rebuilt.
fn replay_held_arg(a: AstArena, tid: i64, inner: String, names: Vec<String>, vals: Vec<String>) -> ReplayArg {
    let shown: String = print_type_text(a, tid);
    let is_vec: bool = type_tag(a, tid) == TY_GENERIC();
    let entry: String = replay_cex_value(names, vals, inner);
    let len: i64 = replay_vec_len(inner, names, vals);
    if entry.len() == 0 && len != -1 {
        return replay_field_skip(shown, String::from("`: the counterexample lists its length but not its address"));
    }
    if entry.len() > 0 && len == -1 {
        return replay_field_skip(shown, String::from("`: the counterexample does not list its length"));
    }
    if !is_vec {
        return replay_string_arg(inner, names, vals);
    }
    let elem: i64 = list_get(a, type_b(a, tid), 0);
    if replay_held_elem_scalar(a, elem) { return replay_vec_arg(a, tid, inner, names, vals); }
    if len > 0 || len == -2 {
        return replay_field_skip(shown, String::from("` holds elements replay cannot rebuild"));
    }
    let lit: String = String::from("{ let __replay_v: ");
    lit.push_str(shown);
    lit.push_str(String::from(" = Vec::new(); __replay_v }"));
    replay_arg_ok(lit, shown)
}

// The struct, enum, `Option` or `Result` a field of AST type `tid` holds at `slot`: a pointer
// to an object whose slot `j` is the counterexample entry `<prefix>.<slot>.<j>` (the native
// model names a held object by the path of slots that reach it), or the `Vec` or `String` it
// holds. A field whose slot value is the address of a parameter is that parameter. Any other
// field that has an entry of its own is a pointer the function loaded and read through memory:
// the model lists its address, not its fields, so the object cannot be rebuilt.
fn replay_nested_arg(m: Module, tid: i64, pname: String, slot: i64, names: Vec<String>, vals: Vec<String>, depth: i64, avoid: Vec<i64>, objs: ReplayObjs) -> ReplayArg {
    let a: AstArena = m.arena;
    let shown: String = print_type_text(a, tid);
    let not_scalar: ReplayArg = replay_arg_skip(str3r(String::from("field of type `"), shown, String::from("` is not a scalar")));
    let inner: String = replay_slot_key(pname, slot);
    if replay_holds_object(m, tid) {
        let held: i64 = replay_held_param(inner, names, vals, objs);
        if held == -2 {
            return replay_arg_skip(str3r(String::from("field of type `"), shown, String::from("` holds an address that several parameters share without being one object")));
        }
        if held >= 0 { return replay_alias_field(shown, held, objs); }
    }
    if depth >= REPLAY_MAX_DEPTH() {
        return replay_arg_skip(str3r(String::from("field of type `"), shown, String::from("` is nested too deep to rebuild")));
    }
    let tag: i64 = type_tag(a, tid);
    if tag == TY_NAMED() {
        let name: String = arena_str(a, type_a(a, tid));
        if name == String::from("String") { return replay_held_arg(a, tid, inner, names, vals); }
        let sid: i64 = replay_find_struct(m, name);
        let eid: i64 = replay_find_enum(m, name);
        if sid < 0 && eid < 0 { return not_scalar; }
        let why: String = replay_through_memory(names, vals, inner, String::from(""));
        if why.len() > 0 { return replay_field_skip(shown, why); }
        if sid >= 0 { return replay_struct_arg(m, sid, inner, names, vals, depth + 1, avoid, objs); }
        return replay_enum_arg(m, eid, inner, names, vals, depth + 1, avoid, objs);
    }
    if tag == TY_GENERIC() {
        if arena_str(a, type_a(a, tid)) == String::from("Vec") { return replay_held_arg(a, tid, inner, names, vals); }
        let why: String = replay_through_memory(names, vals, inner, String::from(""));
        if why.len() > 0 { return replay_field_skip(shown, why); }
        return replay_builtin_enum_arg(m, tid, inner, names, vals, depth + 1, avoid, objs);
    }
    not_scalar
}

// Literal of the scalar (or `()`) a field of AST type `tid` holds at `slot`, or of the
// aggregate it points to. A slot the model never read cannot have influenced the path to the
// claim, so it takes the zero value.
fn replay_field_arg(m: Module, tid: i64, pname: String, slot: i64, names: Vec<String>, vals: Vec<String>, depth: i64, avoid: Vec<i64>, objs: ReplayObjs) -> ReplayArg {
    let a: AstArena = m.arena;
    let shown: String = print_type_text(a, tid);
    if type_tag(a, tid) == TY_UNIT() {
        return replay_arg_ok(String::from("()"), shown);
    }
    if type_tag(a, tid) != TY_NAMED() {
        return replay_nested_arg(m, tid, pname, slot, names, vals, depth, avoid, objs);
    }
    let name: String = arena_str(a, type_a(a, tid));
    if !replay_is_scalar_name(name) {
        return replay_nested_arg(m, tid, pname, slot, names, vals, depth, avoid, objs);
    }
    let mut raw: String = replay_slot_value(pname, slot, replay_slot_label(name), names, vals);
    if raw.len() == 0 { raw = replay_zero_text(name); }
    let r: ReplayArg = replay_scalar_literal(name, raw);
    if r.reason.len() > 0 {
        return replay_arg_skip(str3r(String::from("field of type `"), shown, str3r(String::from("`: "), r.reason, String::from(""))));
    }
    replay_arg_ok(r.lit, shown)
}

fn str3r(a: String, b: String, c: String) -> String {
    let out: String = String::from(a);
    out.push_str(b);
    out.push_str(c);
    out
}

// Slots a field of AST type `tid` takes in an aggregate: a 128-bit integer takes
// two (the counterexample names the first), anything else one.
fn replay_field_slots(a: AstArena, tid: i64) -> i64 {
    if type_tag(a, tid) == TY_NAMED() {
        let name: String = arena_str(a, type_a(a, tid));
        if name == String::from("i128") || name == String::from("u128") { return 2; }
    }
    1
}

// `(f0, f1, ...)` or "" for no payload, from slot `first` on.
fn replay_payload_args(m: Module, tids: Vec<i64>, pname: String, first: i64, names: Vec<String>, vals: Vec<String>, depth: i64, avoid: Vec<i64>, objs: ReplayObjs) -> ReplayArg {
    let a: AstArena = m.arena;
    let out: String = String::from("");
    let deps: String = String::from("");
    let mut slot: i64 = first;
    let mut i: u64 = 0u64;
    while i < tids.len() {
        let f: ReplayArg = replay_field_arg(m, tids[i], pname, slot, names, vals, depth, avoid, objs);
        if f.reason.len() > 0 { return f; }
        if i > 0u64 { out.push_str(String::from(", ")); }
        out.push_str(f.lit);
        deps.push_str(f.deps);
        slot = slot + replay_field_slots(a, tids[i]);
        i = i + 1u64;
    }
    replay_arg_ok_deps(out, String::from(""), deps)
}

fn replay_struct_arg(m: Module, sid: i64, pname: String, names: Vec<String>, vals: Vec<String>, depth: i64, avoid: Vec<i64>, objs: ReplayObjs) -> ReplayArg {
    let a: AstArena = m.arena;
    let sname: String = arena_str(a, sdef_name_sid(a, sid));
    let fields_lid: i64 = sdef_fields_lid(a, sid);
    let n: i64 = list_len(a, fields_lid) / 2;
    if n == 0 {
        return replay_arg_skip(str3r(String::from("struct `"), sname, String::from("` has no fields")));
    }
    let lit: String = String::from(sname);
    let deps: String = String::from("");
    lit.push_str(String::from(" { "));
    let mut slot: i64 = 0;
    let mut i: i64 = 0;
    while i < n {
        let ftid: i64 = list_get(a, fields_lid, i * 2 + 1);
        let f: ReplayArg = replay_field_arg(m, ftid, pname, slot, names, vals, depth, avoid, objs);
        slot = slot + replay_field_slots(a, ftid);
        if f.reason.len() > 0 {
            let fname: String = arena_str(a, list_get(a, fields_lid, i * 2));
            return replay_arg_skip(str3r(String::from("field `"), fname, str3r(String::from("` of `"), sname, str3r(String::from("`: "), f.reason, String::from("")))));
        }
        if i > 0 { lit.push_str(String::from(", ")); }
        lit.push_str(arena_str(a, list_get(a, fields_lid, i * 2)));
        lit.push_str(String::from(": "));
        lit.push_str(f.lit);
        deps.push_str(f.deps);
        i = i + 1;
    }
    lit.push_str(String::from(" }"));
    replay_arg_ok_deps(lit, sname, deps)
}

// The smallest discriminant below `n` that no instruction of the program compares a
// discriminant with (`avoid`), or -1. The program only ever tests a tag with `== k`, so a
// variant nothing tests behaves like a tag outside the enum: every test fails.
fn replay_untested_tag(n: i64, avoid: Vec<i64>) -> i64 {
    let mut t: i64 = 0;
    while t < n {
        let mut hit: bool = false;
        let mut i: u64 = 0;
        while i < avoid.len() {
            if avoid[i] == t { hit = true; }
            i = i + 1;
        }
        if !hit { return t; }
        t = t + 1;
    }
    -1
}

// The variant whose discriminant the model chose, built as `Enum::Variant(...)`.
// `payloads[v]` holds the AST types of variant `v`'s payload. The model puts no range on a
// tag, so it may pick one outside the enum (`-1`); that run takes the arm no test selects,
// which a variant the program never tests also takes, so replay builds that variant instead.
fn replay_variant_arg(m: Module, ename: String, variants: Vec<String>, payloads: Vec<Vec<i64>>, pname: String, names: Vec<String>, vals: Vec<String>, depth: i64, avoid: Vec<i64>, objs: ReplayObjs) -> ReplayArg {
    let mut tag: i64 = 0;
    let raw: String = replay_slot_value(pname, 0, String::from("64"), names, vals);
    if raw.len() > 0 {
        match parse_i64(raw) {
            Option::Some(v) => { tag = v; },
            Option::None => {
                return replay_arg_skip(str3r(String::from("discriminant `"), raw, String::from("` is not an integer")));
            },
        }
    }
    let shown_tag: i64 = tag;
    if tag < 0 || tag >= variants.len() as i64 {
        tag = replay_untested_tag(variants.len() as i64, avoid);
    }
    if tag < 0 {
        tag = shown_tag;
        let why: String = String::from("discriminant ");
        why.push_str(i64_to_string(tag));
        why.push_str(String::from(" outside "));
        why.push_str(ename);
        why.push_str(String::from(" ("));
        why.push_str(i64_to_string(variants.len() as i64));
        why.push_str(String::from(" variants)"));
        return replay_arg_skip(why);
    }
    let lit: String = String::from(ename);
    lit.push_str(String::from("::"));
    lit.push_str(variants[tag as u64]);
    let tids: Vec<i64> = payloads[tag as u64];
    let deps: String = String::from("");
    if tids.len() > 0 {
        let p: ReplayArg = replay_payload_args(m, tids, pname, 1, names, vals, depth, avoid, objs);
        if p.reason.len() > 0 {
            return replay_arg_skip(str3r(String::from("variant `"), variants[tag as u64], str3r(String::from("` of `"), ename, str3r(String::from("`: "), p.reason, String::from("")))));
        }
        lit.push_str(String::from("("));
        lit.push_str(p.lit);
        lit.push_str(String::from(")"));
        deps.push_str(p.deps);
    }
    replay_arg_ok_deps(lit, ename, deps)
}

fn replay_enum_arg(m: Module, eid: i64, pname: String, names: Vec<String>, vals: Vec<String>, depth: i64, avoid: Vec<i64>, objs: ReplayObjs) -> ReplayArg {
    let a: AstArena = m.arena;
    let variants_lid: i64 = edef_variants_lid(a, eid);
    let n: i64 = list_len(a, variants_lid) / 2;
    let variants: Vec<String> = Vec::new();
    let payloads: Vec<Vec<i64>> = Vec::new();
    let mut i: i64 = 0;
    while i < n {
        variants.push(arena_str(a, list_get(a, variants_lid, i * 2)));
        let plid: i64 = list_get(a, variants_lid, i * 2 + 1);
        let tids: Vec<i64> = Vec::new();
        let mut j: i64 = 0;
        while j < list_len(a, plid) {
            tids.push(list_get(a, plid, j));
            j = j + 1;
        }
        payloads.push(tids);
        i = i + 1;
    }
    replay_variant_arg(m, arena_str(a, edef_name_sid(a, eid)), variants, payloads, pname, names, vals, depth, avoid, objs)
}

// `Option<T>` (`None`, `Some`) and `Result<T, E>` (`Ok`, `Err`), in the
// lowerer's variant order.
fn replay_builtin_enum_arg(m: Module, tid: i64, pname: String, names: Vec<String>, vals: Vec<String>, depth: i64, avoid: Vec<i64>, objs: ReplayObjs) -> ReplayArg {
    let a: AstArena = m.arena;
    let name: String = arena_str(a, type_a(a, tid));
    let args_lid: i64 = type_b(a, tid);
    let variants: Vec<String> = Vec::new();
    let payloads: Vec<Vec<i64>> = Vec::new();
    if name == String::from("Option") && list_len(a, args_lid) == 1 {
        variants.push(String::from("None"));
        payloads.push(Vec::new());
        variants.push(String::from("Some"));
        let some: Vec<i64> = Vec::new();
        some.push(list_get(a, args_lid, 0));
        payloads.push(some);
    } else if name == String::from("Result") && list_len(a, args_lid) == 2 {
        variants.push(String::from("Ok"));
        let ok: Vec<i64> = Vec::new();
        ok.push(list_get(a, args_lid, 0));
        payloads.push(ok);
        variants.push(String::from("Err"));
        let err: Vec<i64> = Vec::new();
        err.push(list_get(a, args_lid, 1));
        payloads.push(err);
    } else {
        return replay_arg_skip(str3r(String::from("parameter type `"), print_type_text(a, tid), String::from("` is not rebuilt by replay")));
    }
    let r: ReplayArg = replay_variant_arg(m, name, variants, payloads, pname, names, vals, depth, avoid, objs);
    if r.reason.len() > 0 { return r; }
    replay_arg_ok_deps(r.lit, print_type_text(a, tid), r.deps)
}

// `Vec` and `String` parameters. The counterexample lists `<param>.len` and, for
// each index below it, `<param>[<i>]`: the 8-byte slot the runtime keeps, as an
// unsigned decimal (see `vc_vecmodel`). A parameter the model never read is
// empty. The harness builds the value in a block: `{ let v: Vec<i64> =
// Vec::new(); v.push(1); v }`.

// Length of the `Vec`/`String` parameter `pname`; -1 when it was never read, -2
// when the text is not a length.
fn replay_vec_len(pname: String, names: Vec<String>, vals: Vec<String>) -> i64 {
    let raw: String = replay_cex_value(names, vals, str3r(pname, String::from(".len"), String::from("")));
    if raw.len() == 0 { return -1; }
    match raw.parse_u64() {
        Option::Some(v) => { if v > 512u64 { -2 } else { v as i64 } },
        Option::None => { -2 },
    }
}

// The slot of element `i`, or the reason it is missing. The native counterexample
// prints an element in its own type (`vc_cex_elem`): a negative signed value or a
// `bool` is turned back into the slot the runtime keeps.
fn replay_vec_slot(pname: String, i: i64, names: Vec<String>, vals: Vec<String>) -> Option<u64> {
    let key: String = str3r(pname, String::from("["), str3r(i64_to_string(i), String::from("]"), String::from("")));
    let raw: String = replay_cex_value(names, vals, key);
    if raw == String::from("true") { return Option::Some(1u64); }
    if raw == String::from("false") { return Option::Some(0u64); }
    if raw.len() > 1 && raw.byte_at(0) == 45 {
        match parse_i64(raw) {
            Option::Some(v) => { return Option::Some(v as u64); },
            Option::None => { return Option::None; },
        }
    }
    raw.parse_u64()
}

// Element `i` of a `Vec<i128>`/`Vec<u128>` parameter: the counterexample lists a
// wide element as one decimal value, not as two raw slots.
fn replay_wide_element(pname: String, i: i64, name: String, names: Vec<String>, vals: Vec<String>) -> ReplayArg {
    let key: String = str3r(pname, String::from("["), str3r(i64_to_string(i), String::from("]"), String::from("")));
    let raw: String = replay_cex_value(names, vals, key);
    if raw.len() == 0 {
        return replay_arg_skip(str3r(String::from("the counterexample does not give element "), i64_to_string(i), str3r(String::from(" of `"), pname, String::from("` (length too large to list)"))));
    }
    replay_wide_literal(name, raw)
}

// Element `i` of a `Vec<f64>` parameter. The counterexample marks a `Vec` whose elements the
// function reads as floats with `<param>.elem` = `f64`, and then lists each element as the
// float's decimal text; without the mark an element is a raw slot, which a float cannot rebuild.
fn replay_float_element(pname: String, i: i64, name: String, names: Vec<String>, vals: Vec<String>) -> ReplayArg {
    let marked: String = replay_cex_value(names, vals, str3r(pname, String::from(".elem"), String::from("")));
    if marked != name {
        return replay_arg_skip(str3r(String::from("element type `"), name, String::from("` is not rebuilt by replay")));
    }
    let key: String = str3r(pname, String::from("["), str3r(i64_to_string(i), String::from("]"), String::from("")));
    let raw: String = replay_cex_value(names, vals, key);
    if raw.len() == 0 {
        return replay_arg_skip(str3r(String::from("the counterexample does not give element "), i64_to_string(i), str3r(String::from(" of `"), pname, String::from("` (length too large to list)"))));
    }
    replay_f64_literal(raw)
}

fn replay_vec_element(pname: String, i: i64, name: String, names: Vec<String>, vals: Vec<String>) -> ReplayArg {
    if name == String::from("i128") || name == String::from("u128") {
        return replay_wide_element(pname, i, name, names, vals);
    }
    if name == String::from("f64") {
        return replay_float_element(pname, i, name, names, vals);
    }
    match replay_vec_slot(pname, i, names, vals) {
        Option::Some(s) => { replay_slot_element(name, s) },
        Option::None => { replay_arg_skip(str3r(String::from("the counterexample does not give element "), i64_to_string(i), str3r(String::from(" of `"), pname, String::from("` (length too large to list)")))) },
    }
}

// The value of element type `name` that reads back from the 8-byte slot `slot`:
// a narrow integer is the slot's low bits (the verifier truncates on read), and a
// `bool` is true for any nonzero slot, which is how the lowerer reads it
// (`narrow_vec_bool_elem`), so the model never tells two nonzero slots apart.
fn replay_slot_element(name: String, slot: u64) -> ReplayArg {
    if name == String::from("bool") {
        if slot == 0u64 { return replay_arg_ok(String::from("false"), name); }
        return replay_arg_ok(String::from("true"), name);
    }
    let bits: i64 = replay_int_bits(name);
    if bits == 0 {
        return replay_arg_skip(str3r(String::from("element type `"), name, String::from("` is not rebuilt by replay")));
    }
    if !replay_int_signed(name) {
        if bits == 64 { return replay_scalar_literal(name, uint_to_string(slot)); }
        return replay_scalar_literal(name, uint_to_string(slot & ((1u64 << (bits as u64)) - 1u64)));
    }
    if bits == 64 { return replay_scalar_literal(name, i64_to_string(slot as i64)); }
    let low: i64 = (slot & ((1u64 << (bits as u64)) - 1u64)) as i64;
    if (low >> (bits - 1)) & 1 == 1 { return replay_scalar_literal(name, i64_to_string(low - (1 << bits))); }
    replay_scalar_literal(name, i64_to_string(low))
}

fn replay_vec_arg(a: AstArena, tid: i64, pname: String, names: Vec<String>, vals: Vec<String>) -> ReplayArg {
    let shown: String = print_type_text(a, tid);
    let args_lid: i64 = type_b(a, tid);
    if list_len(a, args_lid) != 1 || type_tag(a, list_get(a, args_lid, 0)) != TY_NAMED() {
        return replay_arg_skip(str3r(String::from("parameter type `"), shown, String::from("` is not rebuilt by replay")));
    }
    let ename: String = arena_str(a, type_a(a, list_get(a, args_lid, 0)));
    let len: i64 = replay_vec_len(pname, names, vals);
    if len == -2 {
        return replay_arg_skip(str3r(String::from("length of `"), pname, String::from("` is not a length replay can build")));
    }
    let lit: String = String::from("{ let __replay_v: ");
    lit.push_str(shown);
    lit.push_str(String::from(" = Vec::new();"));
    let mut i: i64 = 0;
    while i < len {
        let el: ReplayArg = replay_vec_element(pname, i, ename, names, vals);
        if el.reason.len() > 0 { return el; }
        lit.push_str(String::from(" __replay_v.push("));
        lit.push_str(el.lit);
        lit.push_str(String::from(");"));
        i = i + 1;
    }
    lit.push_str(String::from(" __replay_v }"));
    replay_arg_ok(lit, shown)
}

fn replay_string_arg(pname: String, names: Vec<String>, vals: Vec<String>) -> ReplayArg {
    let len: i64 = replay_vec_len(pname, names, vals);
    if len == -2 {
        return replay_arg_skip(str3r(String::from("length of `"), pname, String::from("` is not a length replay can build")));
    }
    let lit: String = String::from("{ let __replay_s: String = String::from(\"\");");
    let mut i: i64 = 0;
    while i < len {
        match replay_vec_slot(pname, i, names, vals) {
            Option::Some(s) => {
                lit.push_str(String::from(" __replay_s.push_byte("));
                lit.push_str(uint_to_string(s & 255u64));
                lit.push_str(String::from(");"));
            },
            Option::None => {
                return replay_arg_skip(str3r(String::from("the counterexample does not give byte "), i64_to_string(i), str3r(String::from(" of `"), pname, String::from("` (length too large to list)"))));
            },
        }
        i = i + 1;
    }
    lit.push_str(String::from(" __replay_s }"));
    replay_arg_ok(lit, String::from("String"))
}

// Key and value type names of a parameter of AST type `tid` that is a `HashMap` or `BTreeMap`
// (`()` for a unit value), or an empty list for any other type.
fn replay_map_type_names(a: AstArena, tid: i64) -> Vec<String> {
    let out: Vec<String> = Vec::new();
    if type_tag(a, tid) != TY_GENERIC() { return out; }
    let head: String = arena_str(a, type_a(a, tid));
    if head != String::from("HashMap") && head != String::from("BTreeMap") { return out; }
    let args_lid: i64 = type_b(a, tid);
    if list_len(a, args_lid) != 2 { return out; }
    let k: i64 = list_get(a, args_lid, 0);
    let v: i64 = list_get(a, args_lid, 1);
    if type_tag(a, k) != TY_NAMED() { return out; }
    let mut vname: String = String::from("");
    if type_tag(a, v) == TY_UNIT() {
        vname = String::from("()");
    } else if type_tag(a, v) == TY_NAMED() {
        vname = arena_str(a, type_a(a, v));
    }
    if vname.len() == 0 { return out; }
    out.push(arena_str(a, type_a(a, k)));
    out.push(vname);
    out
}

// Candidate `c` of the keys of type `kt`: `false` and `true`, 0, 1, 2, ... for an unsigned integer,
// and 0, -1, 1, -2, ... for a signed one. "" past the end of `bool`.
fn replay_key_candidate(kt: String, c: i64) -> String {
    if kt == String::from("bool") {
        if c == 0 { return String::from("false"); }
        if c == 1 { return String::from("true"); }
        return String::from("");
    }
    if replay_int_signed(kt) && c % 2 == 1 { return i64_to_string(0 - (c + 1) / 2); }
    if replay_int_signed(kt) { return i64_to_string(c / 2); }
    i64_to_string(c)
}

// The next key of type `kt` after `tried` candidates that `keys` does not hold, as source text,
// or "" when the key type has none left (`bool` has two, a narrow integer its range).
fn replay_fresh_key(kt: String, keys: Vec<String>, tried: i64) -> String {
    let mut c: i64 = tried;
    while c < tried + keys.len() as i64 + 2 {
        let text: String = replay_key_candidate(kt, c);
        if text.len() == 0 || (kt != String::from("bool") && !replay_int_fits(kt, text)) { return String::from(""); }
        if !replay_has_key(keys, text) { return text; }
        c = c + 1;
    }
    String::from("")
}

fn replay_map_insert(lit: String, key: String, val: String) {
    lit.push_str(String::from(" __replay_m.insert("));
    lit.push_str(key);
    lit.push_str(String::from(", "));
    lit.push_str(val);
    lit.push_str(String::from(");"));
}

// A `HashMap` or `BTreeMap` parameter, built with `new` and one `insert` per key of the listed
// state, then as many other keys as the length needs (`<param>.len`). A key the parameter does
// not have stays out, and so does every key the claim asked about.
fn replay_map_arg(a: AstArena, tid: i64, pname: String, names: Vec<String>, vals: Vec<String>) -> ReplayArg {
    let shown: String = print_type_text(a, tid);
    let tys: Vec<String> = replay_map_type_names(a, tid);
    let not_rebuilt: ReplayArg = replay_arg_skip(str3r(String::from("parameter type `"), shown, String::from("` is not rebuilt by replay")));
    if tys.len() != 2u64 { return not_rebuilt; }
    let kt: String = tys[0];
    let vt: String = tys[1];
    if !(kt == String::from("bool") || replay_int_bits(kt) > 0) { return not_rebuilt; }
    if !(vt == String::from("()") || vt == String::from("bool") || replay_int_bits(vt) > 0) { return not_rebuilt; }
    let len: i64 = replay_vec_len(pname, names, vals);
    if len == -2 {
        return replay_arg_skip(str3r(String::from("length of `"), pname, String::from("` is not a length replay can build")));
    }
    let keys: Vec<String> = Vec::new();
    let held: Vec<String> = Vec::new();
    replay_map_state_entries(pname, names, vals, keys, held);
    if replay_has_repeat(keys) {
        return replay_arg_skip(str3r(String::from("two keys of `"), pname, String::from("` are one key of the declared key type")));
    }
    let lit: String = String::from("{ let __replay_m: ");
    lit.push_str(shown);
    lit.push_str(String::from(" = "));
    lit.push_str(arena_str(a, type_a(a, tid)));
    lit.push_str(String::from("::new();"));
    let mut present: i64 = 0;
    let mut i: u64 = 0u64;
    while i < keys.len() {
        if held[i] != String::from("absent") {
            let k: ReplayArg = replay_scalar_literal(kt, keys[i]);
            if k.reason.len() > 0 { return k; }
            let mut v: ReplayArg = replay_arg_ok(String::from("()"), vt);
            if vt != String::from("()") { v = replay_scalar_literal(vt, held[i]); }
            if v.reason.len() > 0 { return v; }
            replay_map_insert(lit, k.lit, v.lit);
            present = present + 1;
        }
        i = i + 1u64;
    }
    let filler: String = { if vt == String::from("()") { String::from("()") } else { replay_zero_text(vt) } };
    let mut tried: i64 = 0;
    while present < len {
        let fresh: String = replay_fresh_key(kt, keys, tried);
        if fresh.len() == 0 {
            return replay_arg_skip(str3r(String::from("the key type `"), kt, String::from("` has too few keys for the length of the map")));
        }
        keys.push(fresh);
        replay_map_insert(lit, fresh, filler);
        present = present + 1;
        tried = tried + 1;
    }
    lit.push_str(String::from(" __replay_m }"));
    replay_arg_ok(lit, shown)
}

// The statement of the harness that calls `fn_name`. A linear result (a `linear struct`, or an
// `Option`, `Result` or enum that owns one) carries an obligation that a bare call statement leaves
// undischarged, so the harness hands it to `drop`, the language's own way to consume a value.
fn replay_call_stmt(fn_name: String, call_args: String, linear_result: bool) -> String {
    let out: String = String::from("    ");
    if linear_result { out.push_str(String::from("drop(")); }
    out.push_str(fn_name);
    out.push_str(String::from("("));
    out.push_str(call_args);
    out.push_str(String::from(")"));
    if linear_result { out.push_str(String::from(")")); }
    out.push_str(String::from(";\n"));
    out
}

// Source expression and type for argument `pi` of the function `fn_name`
// declared in `m`, rebuilt from the counterexample's `<param>.<slot>` values.
// `reason` says why it cannot be (nested aggregates, 128-bit fields, references,
// aliases, an out-of-range discriminant ...); the caller then skips the replay.
fn replay_agg_arg(m: Module, fn_name: String, pi: i64, names: Vec<String>, vals: Vec<String>, avoid: Vec<i64>, all_objs: ReplayObjs) -> ReplayArg {
    let a: AstArena = m.arena;
    let fid: i64 = replay_find_fn_item(m, fn_name);
    if fid < 0 {
        return replay_arg_skip(str3r(String::from("no source definition of function `"), fn_name, String::from("`")));
    }
    let lid: i64 = fn_params_lid(a, fid);
    if pi < 0 || pi >= list_len(a, lid) / 4 {
        return replay_arg_skip(String::from("parameter index outside the source signature"));
    }
    let pname: String = arena_str(a, list_get(a, lid, pi * 4));
    let tid: i64 = replay_resolve_type(m, list_get(a, lid, pi * 4 + 1), 0);
    let tag: i64 = type_tag(a, tid);
    let objs: ReplayObjs = replay_objs_at(all_objs, pi);
    if tag == TY_NAMED() {
        let tname: String = arena_str(a, type_a(a, tid));
        if tname == String::from("String") { return replay_string_arg(pname, names, vals); }
        let sid: i64 = replay_find_struct(m, tname);
        if sid >= 0 { return replay_struct_arg(m, sid, pname, names, vals, 0, avoid, objs); }
        let eid: i64 = replay_find_enum(m, tname);
        if eid >= 0 { return replay_enum_arg(m, eid, pname, names, vals, 0, avoid, objs); }
    }
    if tag == TY_GENERIC() {
        if arena_str(a, type_a(a, tid)) == String::from("Vec") { return replay_vec_arg(a, tid, pname, names, vals); }
        if replay_map_type_names(a, tid).len() > 0u64 { return replay_map_arg(a, tid, pname, names, vals); }
        return replay_builtin_enum_arg(m, tid, pname, names, vals, 0, avoid, objs);
    }
    replay_arg_skip(str3r(String::from("parameter type `"), print_type_text(a, tid), String::from("` is not a struct, enum, Option, Result, Vec or String declared in this program")))
}
