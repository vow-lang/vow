module VcHandle

use ir
use vc_ops
use vc_term
use vc_smt
use vc_agg
use vc_vec
use vc_heap
use vc_wide
use vc_held
use vc_overlay

// Reads through a handle (`VcHandleMemory`, `vc_overlay`): the never-written heap overlaid with the
// parameter and object entries, one `ite` arm per entry of the class the read asks for.
//
// A handle that is the result of a `get` of a `Vec` a pointer is stored into (`held`), in a function
// that reads an element back (`VcOverlay.exact`, `vc_ptr_store_resolvable`), is one of the addresses
// the function stored: such a `Vec` is one it built and holds nothing else, and an element read of
// any other `Vec` is never used as an object. An index out of bounds is a claim and assumed not to
// happen afterwards, so a read after it is of a stored slot. The `ite` chain of such a handle ends in
// its first entry instead of `array[h]`: the solver is not asked to rule out an address that is
// no entry's, which costs a case split per stored object and per read, cubic in the object count.
// A loop cut that havocs such a `Vec` keeps the free array: its elements are arbitrary there, and two
// of them would both be the one entry the loop body made.

// Records `t`, the term of the `get` of the receiver `recv`, as an element of a `Vec` the function stored
// pointers into. Terms are numbered as they are made, so a new one is above every one recorded and the
// list stays sorted; an older term is not recorded, and a chain over it keeps the array.
fn vc_overlay_note_elem(ov: VcOverlay, t: i64, recv: i64) {
    if !ov.exact || !vc_ptr_store_is_held(ov.held, recv) { return; }
    let n: u64 = ov.elem_h.len();
    if n == 0 || ov.elem_h[n - 1] < t { ov.elem_h.push(t); }
}

fn vc_overlay_sorted_has(l: Vec<i64>, t: i64) -> bool {
    let mut lo: u64 = 0;
    let mut hi: u64 = l.len();
    while lo < hi {
        let mid: u64 = lo + (hi - lo) / 2;
        if l[mid] == t { return true; }
        if l[mid] < t { lo = mid + 1; } else { hi = mid; }
    }
    false
}

fn vc_overlay_is_elem(ov: VcOverlay, ar: VcArena, h: i64) -> bool {
    if !ov.exact { return false; }
    vc_overlay_sorted_has(ov.elem_h, h) || (ar.kinds[h as u64] == VC_T_VAR() && ar.named[h as u64] >= 0 && vc_overlay_sorted_has(ov.elem_h, ar.named[h as u64]))
}

// The start of a chain over the entries: `base` (`array[h]`), or -1 for an exact chain, which has no
// arm yet and whose first arm is its end (never for a handle loaded from the memory the function was given).
fn vc_overlay_chain_start(ov: VcOverlay, ar: VcArena, h: i64, loaded: bool, base: i64) -> i64 {
    if !loaded && vc_overlay_is_elem(ov, ar, h) { return -1; }
    base
}

fn vc_overlay_chain_end(acc: i64, base: i64) -> i64 {
    if acc < 0 { base } else { acc }
}

// One arm of a chain: `h` is entry `i`'s address, then `val`.
fn vc_overlay_arm(ov: VcOverlay, ar: VcArena, acc: i64, i: u64, h: i64, val: i64) -> i64 {
    if acc < 0 { return val; }
    vc_tm_app3(ar, VC_OP_ITE(), vc_overlay_hit(ov, ar, i, h), val, acc)
}

fn vc_handle_field(m: VcHandleMemory, h: i64, slot: i64, ty: i64) -> i64 {
    let base: i64 = vc_heap_field(m.heap, m.ar, m.header, h, slot, ty);
    let t: i64 = vc_overlay_field(m.overlay, m.ag, m.ar, m.header, m.assumed, h, slot, ty, base);
    vc_handle_note_loaded(m, base, ty);
    t
}

// The length is observed before the caller records the bounds claim. Reading an
// element afterwards must not declare its heap array in that earlier prefix, so a
// collection held in a field (`vc_held`) declares its element array with the length.
fn vc_handle_len(m: VcHandleMemory, b: i64, h: i64, inst: IrInst, kind: i64) -> i64 {
    let base: i64 = vc_heap_len(m.heap, m.ar, m.header, m.assumed, h);
    vc_held_note(m.held, m.ag, m.heap, m.ar, m.header, h, vc_overlay_op_class(inst, kind) == VC_OV_STRING());
    vc_overlay_len(m.overlay, m.ag, m.vv, m.ar, m.header, m.assumed, b, h, vc_overlay_op_class(inst, kind), base)
}

fn vc_handle_elem(m: VcHandleMemory, b: i64, h: i64, idx: i64) -> i64 {
    let base: i64 = vc_heap_elem(m.heap, m.ar, m.header, h, idx);
    let t: i64 = vc_overlay_elem(m.overlay, m.ag, m.vv, m.ar, m.header, m.assumed, b, h, idx, VC_OV_VEC(), false, base);
    vc_handle_note_loaded(m, base, ITY_I64());
    t
}

// The 128-bit element `idx` of the collection at `h`: its two 8-byte slots `2 idx` and `2 idx + 1`
// (`vc_wide`), each read as a one-slot element.
fn vc_handle_wide(m: VcHandleMemory, b: i64, h: i64, idx: i64) -> i64 {
    let lo: i64 = vc_handle_elem(m, b, h, vc_wide_key(m.ar, idx, false));
    let hi: i64 = vc_handle_elem(m, b, h, vc_wide_key(m.ar, idx, true));
    vc_tm_app2(m.ar, VC_OP_CONCAT(), hi, lo)
}

fn vc_handle_byte(m: VcHandleMemory, b: i64, h: i64, idx: i64) -> i64 {
    let base: i64 = vc_heap_byte(m.heap, m.ar, m.header, h, idx);
    vc_overlay_elem(m.overlay, m.ag, m.vv, m.ar, m.header, m.assumed, b, h, idx, VC_OV_STRING(), true, base)
}

// An object the function allocated has a state only in the blocks its creation reaches: where it
// has none (`vc_vec_cur_*` is -1) no handle can be its address, so an entry adds nothing to the
// chain of the three reads below. The length of the collection at `h`, given the array's value
// `base`; `rcls` is the class of the operation that reads it.
fn vc_overlay_len(ov: VcOverlay, ag: VcAgg, vv: VcVec, ar: VcArena, hdr: SmtScript, assumed: Vec<i64>, b: i64, h: i64, rcls: i64, base: i64) -> i64 {
    let loaded: bool = vc_overlay_is_loaded(ov, ag, ar, assumed, h);
    let mut acc: i64 = vc_overlay_chain_start(ov, ar, h, loaded, base);
    let mut i: u64 = 0;
    while i < ov.addr.len() {
        if (ov.cls[i] & rcls) != 0 && !(loaded && ov.param[i] < 0) {
            let s: i64 = vc_vec_slot(vv, ag, ar, hdr, assumed, vc_overlay_entry_obj(ov, ag, i));
            let l: i64 = vc_vec_cur_len(vv, s, b);
            if l >= 0 {
                acc = vc_overlay_arm(ov, ar, acc, i, h, l);
            }
        }
        i = i + 1;
    }
    vc_overlay_chain_end(acc, base)
}

// Element `idx` of the collection at `h` as its 8-byte slot, or its low byte when
// `bytes`, given the array's value `base`.
fn vc_overlay_elem(ov: VcOverlay, ag: VcAgg, vv: VcVec, ar: VcArena, hdr: SmtScript, assumed: Vec<i64>, b: i64, h: i64, idx: i64, rcls: i64, bytes: bool, base: i64) -> i64 {
    let loaded: bool = vc_overlay_is_loaded(ov, ag, ar, assumed, h);
    let mut acc: i64 = vc_overlay_chain_start(ov, ar, h, loaded, base);
    let mut i: u64 = 0;
    while i < ov.addr.len() {
        if (ov.cls[i] & rcls) != 0 && !(loaded && ov.param[i] < 0) {
            let s: i64 = vc_vec_slot(vv, ag, ar, hdr, assumed, vc_overlay_entry_obj(ov, ag, i));
            let arr: i64 = vc_vec_cur_arr(vv, s, b);
            if arr >= 0 {
                let mut cell: i64 = vc_tm_app2(ar, VC_OP_SELECT(), arr, idx);
                if bytes { cell = vc_tm_app2(ar, VC_OP_BVAND(), cell, vc_tm_bv(ar, 64, 255, 0)); }
                acc = vc_overlay_arm(ov, ar, acc, i, h, cell);
            }
        }
        i = i + 1;
    }
    vc_overlay_chain_end(acc, base)
}

// Field `slot` at type `ty` of the struct at `h`, given the array's value `base`.
fn vc_overlay_field(ov: VcOverlay, ag: VcAgg, ar: VcArena, hdr: SmtScript, assumed: Vec<i64>, h: i64, slot: i64, ty: i64, base: i64) -> i64 {
    let loaded: bool = vc_overlay_is_loaded(ov, ag, ar, assumed, h);
    let mut acc: i64 = vc_overlay_chain_start(ov, ar, h, loaded, base);
    let mut i: u64 = 0;
    while i < ov.addr.len() {
        if (ov.cls[i] & VC_OV_STRUCT()) != 0 && !(loaded && ov.param[i] < 0) {
            let cell: i64 = vc_agg_read_field(ag, ar, hdr, vc_overlay_entry_obj(ov, ag, i), slot, ty);
            acc = vc_overlay_arm(ov, ar, acc, i, h, cell);
        }
        i = i + 1;
    }
    vc_overlay_chain_end(acc, base)
}
