module VcHandle

use ir
use vc_ops
use vc_term
use vc_smt
use vc_agg
use vc_vec
use vc_heap
use vc_wide
use vc_held
use vc_overlay
use vc_objects

// Reads through a handle (`VcHandleMemory`, `vc_overlay`): the never-written heap overlaid with the
// parameter and object entries, one `ite` arm per entry of the class the read asks for.
//
// A handle that is the result of a `get` of a `Vec` a pointer is stored into (`held`), in a function
// that reads an element back (`VcOverlay.exact`, `vc_ptr_store_resolvable`), is one of the addresses
// the function stored: such a `Vec` is one it built and holds nothing else, and an element read of
// any other `Vec` is never used as an object. An index out of bounds is a claim and assumed not to
// happen afterwards, so a read after it is of a stored slot. The `ite` chain of such a handle ends in
// its first entry instead of `array[h]`: the solver is not asked to rule out an address that is
// no entry's, which costs a case split per stored object and per read, cubic in the object count.
// A loop cut that havocs such a `Vec` keeps the free array: its elements are arbitrary there, and two
// of them would both be the one entry the loop body made.
//
// A chain through a struct-typed field's address also assumes the field edges it was
// produced by are ranked (#1779): the value a by-value struct-typed field holds ranks
// below the object holding it. No program can hold a struct whose by-value struct field
// resolves back to an object the same path already crosses: a literal is a tree, the
// language has no null, no placeholder and no uninitialised `let`, and `p.next = p`
// needs a `p` whose `next` exists, so every cycle through by-value struct-typed fields
// needs a value of a self-containing struct type, and no such value can be built. A
// cycle's edges would force the rank to decrease around it, and an acyclic state keeps
// any topological ranking of its addresses, so the assumption removes only states no
// program reaches.

// Records `t`, the term of the `get` of the receiver `recv`, as an element of a `Vec` the function stored
// pointers into. Terms are numbered as they are made, so a new one is above every one recorded and the
// list stays sorted; an older term is not recorded, and a chain over it keeps the array.
fn vc_overlay_note_elem(ov: VcOverlay, t: i64, recv: i64) {
    if !ov.exact || !vc_ptr_store_is_held(ov.held, recv) { return; }
    let n: u64 = ov.elem_h.len();
    if n == 0 || ov.elem_h[n - 1] < t { ov.elem_h.push(t); }
}

fn vc_overlay_sorted_has(l: Vec<i64>, t: i64) -> bool {
    let mut lo: u64 = 0;
    let mut hi: u64 = l.len();
    while lo < hi {
        let mid: u64 = lo + (hi - lo) / 2;
        if l[mid] == t { return true; }
        if l[mid] < t { lo = mid + 1; } else { hi = mid; }
    }
    false
}

fn vc_overlay_is_elem(ov: VcOverlay, ar: VcArena, h: i64) -> bool {
    if !ov.exact { return false; }
    vc_overlay_sorted_has(ov.elem_h, h) || (ar.kinds[h as u64] == VC_T_VAR() && ar.named[h as u64] >= 0 && vc_overlay_sorted_has(ov.elem_h, ar.named[h as u64]))
}

// The start of a chain over the entries: `base` (`array[h]`), or -1 for an exact chain, which has no
// arm yet and whose first arm is its end (never for a handle loaded from the memory the function was given).
fn vc_overlay_chain_start(ov: VcOverlay, ar: VcArena, h: i64, loaded: bool, base: i64) -> i64 {
    if !loaded && vc_overlay_is_elem(ov, ar, h) { return -1; }
    base
}

fn vc_overlay_chain_end(acc: i64, base: i64) -> i64 {
    if acc < 0 { base } else { acc }
}

// One arm of a chain: `h` is entry `i`'s address, then `val`.
fn vc_overlay_arm(ov: VcOverlay, ar: VcArena, acc: i64, i: u64, h: i64, val: i64) -> i64 {
    if acc < 0 { return val; }
    vc_tm_app3(ar, VC_OP_ITE(), vc_overlay_hit(ov, ar, i, h), val, acc)
}

fn vc_handle_field(m: VcHandleMemory, h: i64, slot: i64, ty: i64) -> i64 {
    let base: i64 = vc_heap_field(m.heap, m.ar, m.header, h, slot, ty);
    let t: i64 = vc_overlay_field(m.overlay, m.ag, m.ar, m.header, m.assumed, h, slot, ty, base, m.heap.ranked);
    vc_handle_note_loaded(m, base, ty);
    t
}

// The length is observed before the caller records the bounds claim. Reading an
// element afterwards must not declare its heap array in that earlier prefix, so a
// collection held in a field (`vc_held`) declares its element array with the length.
fn vc_handle_len(m: VcHandleMemory, b: i64, h: i64, inst: IrInst, kind: i64) -> i64 {
    let base: i64 = vc_heap_len(m.heap, m.ar, m.header, m.assumed, h);
    vc_held_note(m.held, m.ag, m.heap, m.ar, m.header, h, vc_overlay_op_class(inst, kind) == VC_OV_STRING());
    vc_overlay_len(m.overlay, m.ag, m.vv, m.ar, m.header, m.assumed, b, h, vc_overlay_op_class(inst, kind), base)
}

fn vc_handle_elem(m: VcHandleMemory, b: i64, h: i64, idx: i64) -> i64 {
    let base: i64 = vc_heap_elem(m.heap, m.ar, m.header, h, idx);
    let t: i64 = vc_overlay_elem(m.overlay, m.ag, m.vv, m.ar, m.header, m.assumed, b, h, idx, VC_OV_VEC(), false, base);
    vc_handle_note_loaded(m, base, ITY_I64());
    t
}

// The 128-bit element `idx` of the collection at `h`: its two 8-byte slots `2 idx` and `2 idx + 1`
// (`vc_wide`), each read as a one-slot element.
fn vc_handle_wide(m: VcHandleMemory, b: i64, h: i64, idx: i64) -> i64 {
    let lo: i64 = vc_handle_elem(m, b, h, vc_wide_key(m.ar, idx, false));
    let hi: i64 = vc_handle_elem(m, b, h, vc_wide_key(m.ar, idx, true));
    vc_tm_app2(m.ar, VC_OP_CONCAT(), hi, lo)
}

fn vc_handle_byte(m: VcHandleMemory, b: i64, h: i64, idx: i64) -> i64 {
    let base: i64 = vc_heap_byte(m.heap, m.ar, m.header, h, idx);
    vc_overlay_elem(m.overlay, m.ag, m.vv, m.ar, m.header, m.assumed, b, h, idx, VC_OV_STRING(), true, base)
}

// An object the function allocated has a state only in the blocks its creation reaches: where it
// has none (`vc_vec_cur_*` is -1) no handle can be its address, so an entry adds nothing to the
// chain of the three reads below. The length of the collection at `h`, given the array's value
// `base`; `rcls` is the class of the operation that reads it.
fn vc_overlay_len(ov: VcOverlay, ag: VcAgg, vv: VcVec, ar: VcArena, hdr: SmtScript, assumed: Vec<i64>, b: i64, h: i64, rcls: i64, base: i64) -> i64 {
    let loaded: bool = vc_overlay_is_loaded(ov, ag, ar, assumed, h);
    let mut acc: i64 = vc_overlay_chain_start(ov, ar, h, loaded, base);
    let mut i: u64 = 0;
    while i < ov.addr.len() {
        if (ov.cls[i] & rcls) != 0 && !(loaded && ov.param[i] < 0) {
            let s: i64 = vc_vec_slot(vv, ag, ar, hdr, assumed, vc_overlay_entry_obj(ov, ag, i));
            let l: i64 = vc_vec_cur_len(vv, s, b);
            if l >= 0 {
                acc = vc_overlay_arm(ov, ar, acc, i, h, l);
            }
        }
        i = i + 1;
    }
    vc_overlay_chain_end(acc, base)
}

// Element `idx` of the collection at `h` as its 8-byte slot, or its low byte when
// `bytes`, given the array's value `base`.
fn vc_overlay_elem(ov: VcOverlay, ag: VcAgg, vv: VcVec, ar: VcArena, hdr: SmtScript, assumed: Vec<i64>, b: i64, h: i64, idx: i64, rcls: i64, bytes: bool, base: i64) -> i64 {
    let loaded: bool = vc_overlay_is_loaded(ov, ag, ar, assumed, h);
    let mut acc: i64 = vc_overlay_chain_start(ov, ar, h, loaded, base);
    let mut i: u64 = 0;
    while i < ov.addr.len() {
        if (ov.cls[i] & rcls) != 0 && !(loaded && ov.param[i] < 0) {
            let s: i64 = vc_vec_slot(vv, ag, ar, hdr, assumed, vc_overlay_entry_obj(ov, ag, i));
            let arr: i64 = vc_vec_cur_arr(vv, s, b);
            if arr >= 0 {
                let mut cell: i64 = vc_tm_app2(ar, VC_OP_SELECT(), arr, idx);
                if bytes { cell = vc_tm_app2(ar, VC_OP_BVAND(), cell, vc_tm_bv(ar, 64, 255, 0)); }
                acc = vc_overlay_arm(ov, ar, acc, i, h, cell);
            }
        }
        i = i + 1;
    }
    vc_overlay_chain_end(acc, base)
}

// The rank of an address, for the field-cycle exclusion (#1779): one unconstrained
// 64-bit array, declared once per script. A variable is never interned and the chains
// that need the ranking are rebuilt per read, so the declared constants are scanned
// before declaring.
fn vc_cycle_rank_array(ar: VcArena, hdr: SmtScript) -> i64 {
    let name: String = String::from("hranka");
    let mut i: u64 = 0;
    while i < hdr.kinds.len() {
        if hdr.kinds[i] == VC_CMD_DECLARE_CONST() && hdr.names[i] == name {
            return vc_tm_var(ar, name);
        }
        i = i + 1;
    }
    vc_agg_declare(ar, hdr, name, VC_SORT_ARRAY64())
}

// Collects the field edges the handle `h` was produced by, when they are by-value
// struct-typed fields, as `(condition, head, tail)`: the head is the value the field
// holds, the tail the address of the object holding it, and the condition the path on
// which that edge is the one the read traverses (true for a handle with no selector).
//
//   - a 64-bit slot symbol of the aggregate model (`p0f1s64`) is the value of the field
//     of the parameter or child it was declared for, whose overlay entry carries the
//     container's address;
//   - a `select hf<k> t` is the value of field `k` of the object at `t`, so `t` is the
//     container's address;
//   - an `ite` is followed into its arms, each under its own selector: the rank edge of
//     an arm binds only on the paths that take it, never on the paths an unselected arm
//     is not traversed on.
//
// Any other handle was produced by no struct field: a `Vec` element, a word the function
// loaded and an allocation's address (`hbase + 16 n`) name no slot. The walk adds no
// symbol, so a chain that names no field edge leaves the script alone.
fn vc_cycle_edges(ar: VcArena, ov: VcOverlay, ag: VcAgg, cond: i64, h: i64, conds: Vec<i64>, heads: Vec<i64>, tails: Vec<i64>, depth: i64) {
    if depth <= 0 || h < 0 || (h as u64) >= ar.kinds.len() { return; }
    let kind: i64 = ar.kinds[h as u64];
    if kind == VC_T_VAR() {
        let si: i64 = ar.aux[h as u64];
        if si >= 0 && (si as u64) < ar.strs.len() {
            let name: String = ar.strs[si as u64];
            let mut j: u64 = 0;
            while j < ag.ps_name.len() {
                if ag.ps_sort[j] == 64 && ag.ps_name[j] == name {
                    let e: i64 = {
                        if ag.ps_obj[j] >= 0 { vc_overlay_find_obj(ov, ag.ps_obj[j]) } else { vc_overlay_find_param(ov, ag.ps_param[j]) }
                    };
                    if e >= 0 {
                        conds.push(cond);
                        heads.push(h);
                        tails.push(ov.addr[e as u64]);
                    }
                    return;
                }
                j = j + 1;
            }
        }
        let named: i64 = ar.named[h as u64];
        if named >= 0 && named != h {
            vc_cycle_edges(ar, ov, ag, cond, named, conds, heads, tails, depth - 1);
        }
        return;
    }
    if kind == VC_T_APP() && ar.aux[h as u64] == VC_OP_ITE() {
        let sel: i64 = ar.a[h as u64];
        let under: i64 = vc_tm_app1(ar, VC_OP_NOT(), sel);
        let then_c: i64 = { if vc_tm_is_true(ar, cond) { sel } else { vc_tm_and(ar, cond, sel) } };
        let else_c: i64 = { if vc_tm_is_true(ar, cond) { under } else { vc_tm_and(ar, cond, under) } };
        vc_cycle_edges(ar, ov, ag, then_c, ar.b[h as u64], conds, heads, tails, depth - 1);
        vc_cycle_edges(ar, ov, ag, else_c, ar.c[h as u64], conds, heads, tails, depth - 1);
        return;
    }
    if kind == VC_T_APP() && ar.aux[h as u64] == VC_OP_SELECT() {
        let arr: i64 = ar.a[h as u64];
        if ar.kinds[arr as u64] == VC_T_VAR() && string_starts_with(ar.strs[ar.aux[arr as u64] as u64], String::from("hf")) == 1 {
            conds.push(cond);
            heads.push(h);
            tails.push(ar.b[h as u64]);
        }
    }
}

// Assumes the ranking along every field edge the handle `h` was produced by
// (`vc_cycle_edges`), each only on the paths that traverse it: a cycle's traversed edges
// would force the rank to decrease around it, and an acyclic state keeps any topological
// ranking of its addresses, so only states no program reaches are removed. The rank of
// an address is `hranka` at it, declared only when an edge was found.
fn vc_cycle_assume(ov: VcOverlay, ag: VcAgg, ar: VcArena, hdr: SmtScript, assumed: Vec<i64>, h: i64) {
    let conds: Vec<i64> = Vec::new();
    let heads: Vec<i64> = Vec::new();
    let tails: Vec<i64> = Vec::new();
    vc_cycle_edges(ar, ov, ag, vc_tm_bool_const(ar, true), h, conds, heads, tails, 8);
    if heads.len() == 0 { return; }
    let rank: i64 = vc_cycle_rank_array(ar, hdr);
    let mut i: u64 = 0;
    while i < heads.len() {
        let rh: i64 = vc_tm_app2(ar, VC_OP_SELECT(), rank, heads[i]);
        let rt: i64 = vc_tm_app2(ar, VC_OP_SELECT(), rank, tails[i]);
        vc_heap_assume(ar, assumed, vc_tm_implies(ar, conds[i], vc_tm_app2(ar, VC_OP_BVULT(), rh, rt)));
        i = i + 1;
    }
}

// Field `slot` at type `ty` of the struct at `h`, given the array's value `base`. A chain
// through a struct-typed field's address assumes the ranking first (`vc_cycle_assume`).
fn vc_overlay_field(ov: VcOverlay, ag: VcAgg, ar: VcArena, hdr: SmtScript, assumed: Vec<i64>, h: i64, slot: i64, ty: i64, base: i64, ranked: bool) -> i64 {
    let loaded: bool = vc_overlay_is_loaded(ov, ag, ar, assumed, h);
    if ranked { vc_cycle_assume(ov, ag, ar, hdr, assumed, h); }
    let mut acc: i64 = vc_overlay_chain_start(ov, ar, h, loaded, base);
    let mut i: u64 = 0;
    while i < ov.addr.len() {
        if (ov.cls[i] & VC_OV_STRUCT()) != 0 && !(loaded && ov.param[i] < 0) {
            let cell: i64 = vc_agg_read_field(ag, ar, hdr, vc_overlay_entry_obj(ov, ag, i), slot, ty);
            acc = vc_overlay_arm(ov, ar, acc, i, h, cell);
        }
        i = i + 1;
    }
    vc_overlay_chain_end(acc, base)
}
