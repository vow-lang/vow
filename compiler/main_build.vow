module MainBuild

// Spawn-with-FIFO-drain phase of `run_build`. Mirrors `run_verify_loop` but
// leaves the final drain to `build_drain_verify_phase`. It runs only after
// codegen and linking have finished (#179), so the Cranelift working set is
// released before the first ESBMC process starts.
//
// State threading (Vow Vecs share heap backing across by-value copies, so
// pushes/removes visible to the caller — see compiler/frontend.vow:202-204):
//   - `in_flight_h`, `in_flight_fi`, `in_flight_tmp`: caller-allocated FIFO
//     queues. This phase pushes new handles and pre-drains when the pool is
//     full. Remaining entries are drained by `build_drain_verify_phase`.
//   - `ces`, `soft_meta`: counterexample + soft-fail accumulators threaded
//     through to `verify_collect_and_report`.
//   - `model_bounds`: per-function model-bound text, filled at launch and read
//     by `report_capacity_notes` once the whole run is proved.
// Returns `[all_proven, any_skipped]`.
fn build_verify_phase(
    esbmc_bin: String, fns: Vec<IrFunction>, ir_mod: IrModule, const_fn_indices: Vec<i64>, dctx: DiagCtx, path: String,
    ces: Vec<VerifyCE>, soft_meta: Vec<String>,
    in_flight_h: Vec<i64>, in_flight_fi: Vec<i64>, in_flight_tmp: Vec<String>,
    max_k_step: String, use_cache: bool, solver: String, encoding: String, timeout_secs: String,
    vec_max: i64, string_max: i64, hashmap_max: i64, btreemap_max: i64, jobs: i64,
    verify_origin: i64, t: TraceCtx, model_bounds: Vec<String>
) -> Vec<i64> [io, write] {
    let mut all_proven: i64 = 1;
    let mut any_skipped: i64 = 0;
    let mut fi: i64 = 0;
    while fi < fns.len() as i64 {
        let f: IrFunction = fns[fi as u64];
        if is_verify_target(f, ir_mod, const_fn_indices) {
            if skip_if_non_modelable(f, ir_mod, const_fn_indices, dctx) {
                // Fail closed: a non-modelable function is not statically proved.
                any_skipped = 1;
            } else if all_proven == 1 {
                // Stop launching new ESBMC jobs once any in-flight verification has failed.
                while in_flight_h.len() as i64 >= jobs {
                    let oldest_h: i64 = in_flight_h[0];
                    let oldest_fi: i64 = in_flight_fi[0];
                    let oldest_tmp: String = in_flight_tmp[0];
                    let oldest_f: IrFunction = fns[oldest_fi as u64];
                    vec_i64_remove_front(in_flight_h);
                    vec_i64_remove_front(in_flight_fi);
                    vec_string_remove_front(in_flight_tmp);
                    let proven: i64 = verify_collect_traced(esbmc_bin, t, verify_origin, oldest_h, oldest_tmp, oldest_f, oldest_fi, ir_mod, path, ces, soft_meta, max_k_step, use_cache, solver, encoding, timeout_secs, vec_max, string_max, hashmap_max, btreemap_max, model_bounds, dctx);
                    if proven == 0 {
                        all_proven = 0;
                    }
                }
                if all_proven == 1 {
                    diag_eprintln_best_effort(str3(String::from("Starting verification of "), f.name, String::from("...")));
                    let started: EsbmcStart = verify_start(esbmc_bin, f, ir_mod, max_k_step, fi, use_cache, solver, encoding, timeout_secs, vec_max, string_max, hashmap_max, btreemap_max);
                    model_bounds[fi as u64] = started.bounds;
                    in_flight_h.push(started.handle);
                    in_flight_fi.push(fi);
                    in_flight_tmp.push(started.tmp_path);
                }
            }
        }
        fi = fi + 1;
    }
    let result: Vec<i64> = Vec::new();
    result.push(all_proven);
    result.push(any_skipped);
    result
}

// FIFO drain phase of `run_build`. Collects results from every ESBMC process
// still in flight after `build_verify_phase` returned. Mutates `ces` /
// `soft_meta` via shared Vec backings.
// Returns the post-drain `all_proven` flag (0 if any in-flight job failed,
// otherwise the input value).
//
// A no-op when `in_flight_h` is empty; callers may invoke it unconditionally
// without a do_verify guard if desired.
fn build_drain_verify_phase(esbmc_bin: String, in_flight_h: Vec<i64>, in_flight_fi: Vec<i64>, in_flight_tmp: Vec<String>, fns: Vec<IrFunction>, ir_mod: IrModule, ces: Vec<VerifyCE>, soft_meta: Vec<String>, path: String, max_k_step: String, use_cache: bool, solver: String, encoding: String, timeout_secs: String, vec_max: i64, string_max: i64, hashmap_max: i64, btreemap_max: i64, all_proven_in: i64, verify_origin: i64, t: TraceCtx, model_bounds: Vec<String>, dctx: DiagCtx) -> i64 [io, write] {
    let mut all_proven: i64 = all_proven_in;
    while in_flight_h.len() > 0 {
        let oldest_h: i64 = in_flight_h[0];
        let oldest_fi: i64 = in_flight_fi[0];
        let oldest_tmp: String = in_flight_tmp[0];
        let oldest_f: IrFunction = fns[oldest_fi as u64];
        vec_i64_remove_front(in_flight_h);
        vec_i64_remove_front(in_flight_fi);
        vec_string_remove_front(in_flight_tmp);
        let proven: i64 = verify_collect_traced(esbmc_bin, t, verify_origin, oldest_h, oldest_tmp, oldest_f, oldest_fi, ir_mod, path, ces, soft_meta, max_k_step, use_cache, solver, encoding, timeout_secs, vec_max, string_max, hashmap_max, btreemap_max, model_bounds, dctx);
        if proven == 0 {
            all_proven = 0;
        }
    }
    all_proven
}

fn codegen_failure_diagnostic(result: i64, path: String, obj_path: String) -> Diagnostic {
    if result == CLIF_ERR_WIDE_AGGREGATE_FIELD() {
        diag_error(
            EC_CODEGEN_UNSUPPORTED(),
            CLIF_WIDE_AGGREGATE_FIELD_MSG(),
            path,
            0,
            0
        )
    } else if result == CLIF_ERR_UNSUPPORTED() {
        diag_error(
            EC_CODEGEN_UNSUPPORTED(),
            String::from("native backend does not support an operation used by this program"),
            path,
            0,
            0
        )
    } else if result == CLIF_ERR_LINK() {
        diag_error(EC_LINK_FAILED(), String::from("native linker failed"), path, 0, 0)
    } else if result == CLIF_ERR_IO() {
        diag_error(EC_IO_ERROR(), str2(String::from("cannot write the generated object file: "), obj_path), path, 0, 0)
    } else if result == CLIF_ERR_IO_MKDIR() {
        diag_error(EC_IO_ERROR(), str2(String::from("cannot create the output directory: "), skill_parent_dir(obj_path)), path, 0, 0)
    } else {
        diag_error(EC_CODEGEN_FAILED(), String::from("native code generation failed"), path, 0, 0)
    }
}

fn emit_codegen_failure(result: i64, path: String, obj_path: String, dctx: DiagCtx) [io] {
    let d: Diagnostic = codegen_failure_diagnostic(result, path, obj_path);
    diag_ctx_emit(dctx, d);
    diag_eprintln_best_effort(diag_to_human(d, dctx));
}

// Codegen phase: emits the native object via Cranelift FFI and links it.
// Returns 0 on success. On any non-zero `clif_emit_module` status the helper
// emits the classified diagnostic and the `CompileFailed` JSON, and returns 1;
// the orchestrator propagates that as the process exit code.
fn build_codegen_phase(ir_mod: IrModule, out: String, mode: i64, trace: i64, path: String, dctx: DiagCtx) -> i64 [io] {
    let result: i64 = clif_emit_module(ir_mod, out, mode, trace);
    if result != 0 {
        emit_codegen_failure(result, path, str2(out, String::from(".o")), dctx);
        diag_emit_build_verify_json(String::from("CompileFailed"), String::from(""), dctx, Vec::new());
        return 1;
    }
    0
}

// Shared tail of `build`: counterexample selection, replay, trace output and the
// JSON result. Returns the process exit code.
fn build_finish(argv: Vec<String>, fr: LoweredFrontend, fns: Vec<IrFunction>, path: String, out: String, dctx: DiagCtx, tctx: TraceCtx, status_str: String, ces: Vec<VerifyCE>, soft_meta: Vec<String>, failed: bool) -> i32 [io, read, write] {
    let mut ces_final: Vec<VerifyCE> = Vec::new();
    let ce_wins: bool = vf_prefers_counterexample(ces, soft_meta, fns);
    if ce_wins {
        ces_final = ces;
    }
    if has_flag(argv, "--replay-cex") && ces_final.len() > 0 {
        ces_final = replay_all(ces_final, fr.merged, fns, path, replay_main_start(argv, fr, path), argv[0], backend_is_native(argv));
    }
    let vstatus: String = { if ce_wins { String::from("") } else if soft_meta.len() >= 1 { soft_meta[0] } else { String::from("") } };
    let vmsg: String = { if ce_wins { String::from("") } else if soft_meta.len() >= 2 { soft_meta[1] } else { String::from("") } };
    let mut vf_func: String = String::from("");
    let mut vf_ce: String = String::from("");
    if status_str == String::from("VerifyFailed") {
        let legacy: Vec<String> = vf_legacy_fields(ces_final, soft_meta, fns);
        vf_func = legacy[0];
        vf_ce = legacy[1];
    }
    trace_write(tctx);
    vf_add_ce_diagnostics(dctx, ces_final);
    diag_emit_build_verify_json_full(status_str, out, dctx, ces_final, vstatus, vmsg, vf_func, vf_ce);
    if failed {
        return 1;
    }
    0
}

fn run_build(argv: Vec<String>) -> i32 [io, read, write] {
    run_build_cmd(argv, true)
}

fn run_build_cmd(argv: Vec<String>, sub: bool) -> i32 [io, read, write] {
    let path: String = frontend_path_from_argv(argv, sub, String::from("build"));
    let tctx: TraceCtx = {
        if has_flag(argv, "--perfetto") { trace_new(get_flag_arg(argv, "--perfetto")) }
        else { trace_off() }
    };
    let fr: LoweredFrontend = frontend_lower_path_traced(path, String::from(""), tctx);
    let checked: CheckedFrontend = fr.checked;
    let dctx: DiagCtx = checked.dctx;
    let n_items: i64 = checked.n_items;
    let n_errors: i64 = checked.n_errors;
    if diag_ctx_print_all(dctx) == DIAG_EMIT_FAILED() {
        diag_emit_emission_failure_json(dctx);
        return 1;
    }
    diag_eprintln_best_effort(str4(i64_to_string(n_items), String::from(" items, "), i64_to_string(n_errors), String::from(" errors")));
    if n_errors > 0 {
        diag_emit_build_verify_json(String::from("CompileFailed"), String::from(""), dctx, Vec::new());
        return 1;
    }
    let out: String = {
        if has_output_flag(argv) {
            output_flag_value(argv)
        } else {
            default_output(path)
        }
    };
    let mode_str: String = get_flag_arg(argv, "--mode");
    let mode: i64 = {
        if mode_str == String::from("debug") { 1 }
        else if mode_str == String::from("profile") { 2 }
        else if mode_str == String::from("sanitize") { 3 }
        else { 0 }
    };
    let trace_str: String = get_flag_arg(argv, "--debug-trace");
    let trace: i64 = {
        if trace_str == String::from("calls") { 1 }
        else if trace_str == String::from("full") { 2 }
        else { 0 }
    };
    let ir_mod: IrModule = fr.ir_mod;
    if has_flag(argv, "--dump-ir") {
        emit_ir_warnings(ir_mod, dctx);
        let ir_text: String = print_module(ir_mod);
        print_str(ir_text);
        return 0;
    }
    emit_ir_warnings(ir_mod, dctx);
    let do_verify: bool = !has_flag(argv, "--no-verify");
    let native: bool = backend_is_native(argv);
    let esbmc_bin: String = {
        if do_verify && !native { esbmc_path() }
        else { String::from("") }
    };
    if do_verify && !native {
        if !esbmc_exists(esbmc_bin) {
            diag_eprintln_best_effort(String::from("error: ESBMC not found; install ESBMC or use --no-verify to skip verification"));
            diag_emit_build_verify_json(String::from("VerifyFailed"), String::from(""), dctx, Vec::new());
            return 1;
        }
    }
    let use_cache: bool = !has_flag(argv, "--no-cache");
    let max_k_step_str: String = get_flag_arg(argv, "--max-k-step");
    let max_k_step: String = {
        if max_k_step_str.len() > 0 { max_k_step_str }
        else { String::from("50") }
    };
    let mut solver: String = get_flag_arg(argv, "--solver");
    let encoding: String = get_flag_arg(argv, "--encoding");
    let timeout_secs: String = get_flag_arg(argv, "--timeout");
    if encoding == String::from("ir") {
        if solver == String::from("boolector") || solver == String::from("bitwuzla") {
            diag_eprintln_best_effort(String::from("error: --encoding ir requires --solver z3"));
            return 1;
        }
        if solver.len() == 0 || solver == String::from("auto") {
            solver = String::from("z3");
        }
    }
    let vec_max: i64 = VOW_VEC_MAX();
    let string_max: i64 = VOW_STRING_MAX();
    let hashmap_max: i64 = VOW_HASHMAP_MAX();
    let btreemap_max: i64 = VOW_BTREEMAP_MAX();
    let jobs: i64 = resolve_verify_jobs(argv);
    let fns: Vec<IrFunction> = ir_mod.functions;
    let ces: Vec<VerifyCE> = Vec::new();
    let soft_meta: Vec<String> = Vec::new();
    let mut all_proven: i64 = 1;
    let mut any_skipped: i64 = 0;
    // Bounded pool: ≤ jobs ESBMC processes in flight, FIFO drain. See #175.
    let in_flight_h: Vec<i64> = Vec::new();
    let in_flight_fi: Vec<i64> = Vec::new();
    let in_flight_tmp: Vec<String> = Vec::new();
    let const_fn_indices: Vec<i64> = detect_const_fns(ir_mod);
    let model_bounds: Vec<String> = model_bounds_table(fns.len() as i64);
    let t_codegen: i64 = trace_now(tctx);
    let codegen_status: i64 = build_codegen_phase(ir_mod, out, mode, trace, path, dctx);
    trace_span(tctx, String::from("codegen"), PID_COMPILER(), TID_MAIN(), t_codegen, trace_now(tctx) - t_codegen, String::from(""));
    trace_sample(tctx, trace_now(tctx));
    if codegen_status != 0 { return 1; }
    if !do_verify {
        trace_write(tctx);
        diag_emit_build_verify_json(String::from("Unverified"), out, dctx, Vec::new());
        return 0;
    }
    if native {
        return run_verify_native(argv, fr, path, tctx, true, out);
    }
    // Verification starts only after codegen and linking so ESBMC children
    // never overlap the Cranelift working set; the pool bounds what remains (#179).
    let verify_origin: i64 = trace_now(tctx);
    let phase_result: Vec<i64> = build_verify_phase(esbmc_bin, fns, ir_mod, const_fn_indices, dctx, path, ces, soft_meta, in_flight_h, in_flight_fi, in_flight_tmp, max_k_step, use_cache, solver, encoding, timeout_secs, vec_max, string_max, hashmap_max, btreemap_max, jobs, verify_origin, tctx, model_bounds);
    if phase_result[0] == 0 { all_proven = 0; }
    if phase_result[1] == 1 { any_skipped = 1; }
    all_proven = build_drain_verify_phase(esbmc_bin, in_flight_h, in_flight_fi, in_flight_tmp, fns, ir_mod, ces, soft_meta, path, max_k_step, use_cache, solver, encoding, timeout_secs, vec_max, string_max, hashmap_max, btreemap_max, all_proven, verify_origin, tctx, model_bounds, dctx);
    trace_span(tctx, String::from("verification"), PID_COMPILER(), TID_VERIFY_DRIVER(), verify_origin, trace_now(tctx) - verify_origin, String::from(""));
    if all_proven == 1 && any_skipped == 0 {
        report_capacity_notes(fns, model_bounds, dctx);
    }
    report_unchecked_calls(fns, ir_mod, const_fn_indices, dctx);
    let status_str: String = {
        if all_proven == 0 { String::from("VerifyFailed") }
        else if any_skipped == 1 { String::from("Skipped") }
        else { String::from("Verified") }
    };
    build_finish(argv, fr, fns, path, out, dctx, tctx, status_str, ces, soft_meta, all_proven == 0 || any_skipped == 1)
}
