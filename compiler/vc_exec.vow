module VcExec

use ir
use vc_term
use vc_smt
use vc_gate
use vc_flow
use ir_dominance

// Symbolic execution of an acyclic i64/Bool function (one that
// `vc_skip_reason` accepts) into proof obligations. Blocks are walked in
// reverse postorder (`vc_flow` holds the path conditions and merges). Each IR
// value becomes a `define-fun`; each `requires` is an assumption for the claims
// that follow it; each `ensures` and each division/remainder abort condition is
// a claim, in walk order. A claim is only asked on the paths that reach it: its
// query asserts the block's path condition next to the negated goal, and an
// assumption made in a block is the implication `path condition => assumption`.
// SMT division is total, so the aborts the language specifies (zero divisor;
// signed MIN / -1 for `/`) are separate claims, and a later claim always
// assumes the guards of earlier ones on its path: an aborting run never
// reaches it.

fn VC_CLAIM_ENSURES() -> i64 { 0 }
fn VC_CLAIM_DIV_ZERO() -> i64 { 1 }
fn VC_CLAIM_DIV_OVERFLOW() -> i64 { 2 }

fn VC_LABEL_DIV_ZERO() -> String { String::from("division by zero") }
fn VC_LABEL_DIV_OVERFLOW() -> String { String::from("division overflow") }

// One shared command list (`header`) and one append-only assumption list serve
// every claim: claim `k` is the first `header_lens[k]` header commands, the
// first `assumed_lens[k]` assumptions and its negated goal. Queries are built
// on demand by `vc_claim_script`, so memory stays linear in the function size.
struct VcClaims {
    arena: VcArena,
    header: SmtScript,
    assumed: Vec<i64>,
    kinds: Vec<i64>,
    vow_ids: Vec<i64>,
    labels: Vec<String>,
    negated_goals: Vec<i64>,
    header_lens: Vec<i64>,
    assumed_lens: Vec<i64>,
    model_names: Vec<String>,
    model_params: Vec<i64>,
}

fn vc_value_name(id: i64) -> String {
    let out: String = String::from("v");
    out.push_str(i64_to_string(id));
    out
}

fn vc_param_name(k: i64) -> String {
    let out: String = String::from("p");
    out.push_str(i64_to_string(k));
    out
}

fn vc_smt_op(op: i64) -> i64 {
    if op == IOP_WADD() { return VC_OP_BVADD(); }
    if op == IOP_WSUB() { return VC_OP_BVSUB(); }
    if op == IOP_WMUL() { return VC_OP_BVMUL(); }
    if op == IOP_WDIV() { return VC_OP_BVSDIV(); }
    if op == IOP_WREM() { return VC_OP_BVSREM(); }
    if op == IOP_BITAND() { return VC_OP_BVAND(); }
    if op == IOP_BITOR() { return VC_OP_BVOR(); }
    if op == IOP_BITXOR() { return VC_OP_BVXOR(); }
    if op == IOP_EQ() { return VC_OP_EQ(); }
    if op == IOP_NE() { return VC_OP_DISTINCT(); }
    if op == IOP_LT() { return VC_OP_BVSLT(); }
    if op == IOP_LE() { return VC_OP_BVSLE(); }
    if op == IOP_GT() { return VC_OP_BVSGT(); }
    if op == IOP_GE() { return VC_OP_BVSGE(); }
    if op == IOP_AND() { return VC_OP_AND(); }
    if op == IOP_OR() { return VC_OP_OR(); }
    -1
}

fn vc_sort_of(ty: i64) -> i64 {
    if ty == ITY_BOOL() { return VC_SORT_BOOL(); }
    VC_SORT_BV64()
}

fn vc_add_claim(cs: VcClaims, kind: i64, vow_id: i64, label: String, pc: i64, goal: i64) {
    let hdr: SmtScript = cs.header;
    cs.kinds.push(kind);
    cs.vow_ids.push(vow_id);
    cs.labels.push(label);
    let ar: VcArena = cs.arena;
    let negated: i64 = vc_tm_app1(ar, VC_OP_NOT(), goal);
    if vc_tm_is_true(ar, pc) {
        cs.negated_goals.push(negated);
    } else {
        cs.negated_goals.push(vc_tm_app2(ar, VC_OP_AND(), pc, negated));
    }
    cs.header_lens.push(hdr.kinds.len() as i64);
    cs.assumed_lens.push(cs.assumed.len() as i64);
}

fn vc_assume(cs: VcClaims, pc: i64, t: i64) {
    let ar: VcArena = cs.arena;
    if vc_tm_is_true(ar, pc) {
        cs.assumed.push(t);
    } else {
        cs.assumed.push(vc_tm_app2(ar, VC_OP_OR(), vc_tm_app1(ar, VC_OP_NOT(), pc), t));
    }
}

// The self-contained query that decides claim `k`.
fn vc_claim_script(cs: VcClaims, k: u64) -> SmtScript {
    let hdr: SmtScript = cs.header;
    let s: SmtScript = vc_script_prefix(hdr, cs.header_lens[k] as u64);
    let na: u64 = cs.assumed_lens[k] as u64;
    let mut i: u64 = 0;
    while i < na {
        vc_script_assert(s, cs.assumed[i]);
        i = i + 1;
    }
    vc_script_assert(s, cs.negated_goals[k]);
    vc_script_check_sat(s);
    vc_script_get_value(s, cs.model_names);
    s
}

// Symbolic state shared by the block walk.
struct VcWalk {
    cs: VcClaims,
    fl: VcFlow,
    var_of: Vec<i64>,
    def_of: Vec<i64>,
    tys: Vec<i64>,
}

fn vc_define(w: VcWalk, inst: IrInst, t: i64) {
    let cs: VcClaims = w.cs;
    let ar: VcArena = cs.arena;
    vc_script_define_fun(cs.header, vc_value_name(inst.id), vc_sort_of(inst.ty), t);
    w.def_of[inst.id as u64] = t;
    w.var_of[inst.id as u64] = vc_tm_var(ar, vc_value_name(inst.id));
}

fn vc_arith_claims(w: VcWalk, inst: IrInst, pc: i64) {
    let cs: VcClaims = w.cs;
    let ar: VcArena = cs.arena;
    let lhs: i64 = w.var_of[inst.args[0] as u64];
    let rhs: i64 = w.var_of[inst.args[1] as u64];
    let zero: i64 = vc_tm_bv_const(ar, 0);
    let nonzero: i64 = vc_tm_app2(ar, VC_OP_DISTINCT(), rhs, zero);
    vc_add_claim(cs, VC_CLAIM_DIV_ZERO(), -1, VC_LABEL_DIV_ZERO(), pc, nonzero);
    vc_assume(cs, pc, nonzero);
    if inst.op == IOP_WDIV() {
        let min: i64 = vc_tm_bv_const(ar, -9223372036854775807 - 1);
        let minus_one: i64 = vc_tm_bv_const(ar, -1);
        let hits_min: i64 = vc_tm_app2(ar, VC_OP_EQ(), lhs, min);
        let by_minus_one: i64 = vc_tm_app2(ar, VC_OP_EQ(), rhs, minus_one);
        let overflow: i64 = vc_tm_app2(ar, VC_OP_AND(), hits_min, by_minus_one);
        let no_overflow: i64 = vc_tm_app1(ar, VC_OP_NOT(), overflow);
        vc_add_claim(cs, VC_CLAIM_DIV_OVERFLOW(), -1, VC_LABEL_DIV_OVERFLOW(), pc, no_overflow);
        vc_assume(cs, pc, no_overflow);
    }
}

// Outcome of branching on `cond_id` at a block with path condition `pc` and
// known outcomes `foff`/`flen`: 1 taken, 0 not taken, -1 undecided.
fn vc_branch_outcome(w: VcWalk, cond_id: i64, foff: i64, flen: i64) -> i64 {
    let cs: VcClaims = w.cs;
    let ar: VcArena = cs.arena;
    let fl: VcFlow = w.fl;
    let def: i64 = w.def_of[cond_id as u64];
    if vc_tm_is_true(ar, def) { return 1; }
    if vc_tm_is_false(ar, def) { return 0; }
    if vc_flow_has_fact(fl, foff, flen, vc_flow_fact_lit(cond_id, true)) { return 1; }
    if vc_flow_has_fact(fl, foff, flen, vc_flow_fact_lit(cond_id, false)) { return 0; }
    -1
}

// Registers the edge of `branch` to block `dst` taken when the condition
// evaluates to `polarity`, unless the path already decided the other outcome.
fn vc_branch_edge(w: VcWalk, bi: u64, pc: i64, foff: i64, flen: i64, cond_id: i64, outcome: i64, dst: i64, polarity: bool) {
    let want: i64 = { if polarity { 1 } else { 0 } };
    if outcome >= 0 && outcome != want {
        return;
    }
    let cs: VcClaims = w.cs;
    let ar: VcArena = cs.arena;
    let fl: VcFlow = w.fl;
    let hdr: SmtScript = cs.header;
    let c: i64 = w.var_of[cond_id as u64];
    let mut ec: i64 = pc;
    let mut off: i64 = foff;
    let mut len: i64 = flen;
    if outcome < 0 {
        if polarity {
            ec = vc_flow_and(fl, ar, hdr, pc, c);
        } else {
            ec = vc_flow_and_not(fl, ar, hdr, pc, c);
        }
        off = vc_flow_extend_facts(fl, foff, flen, vc_flow_fact_lit(cond_id, polarity));
        len = vc_flow_extended_len(flen);
    }
    vc_flow_add_edge(fl, dst as u64, bi as i64, ec, off, len);
}

fn vc_walk_branch(w: VcWalk, inst: IrInst, bi: u64, pc: i64, foff: i64, flen: i64, then_idx: i64, else_idx: i64) {
    let cond_id: i64 = inst.args[0];
    let outcome: i64 = vc_branch_outcome(w, cond_id, foff, flen);
    vc_branch_edge(w, bi, pc, foff, flen, cond_id, outcome, then_idx, true);
    vc_branch_edge(w, bi, pc, foff, flen, cond_id, outcome, else_idx, false);
}

fn vc_walk_inst(w: VcWalk, bi: u64, inst: IrInst, succ: Vec<i64>) {
    let cs: VcClaims = w.cs;
    let ar: VcArena = cs.arena;
    let fl: VcFlow = w.fl;
    let pc: i64 = fl.block_pc[bi];
    let op: i64 = inst.op;
    // Unit carries no value: a Unit constant, Phi or Upsilon defines nothing.
    if op == IOP_CONST_UNIT() || (op == IOP_PHI() && inst.ty == ITY_UNIT()) {
        return;
    }
    if op == IOP_UPSILON() && w.tys[inst.args[0] as u64] == ITY_UNIT() {
        return;
    }
    if op == IOP_CONST_I64() {
        vc_define(w, inst, vc_tm_bv_const(ar, inst.dv));
    } else if op == IOP_CONST_BOOL() {
        vc_define(w, inst, vc_tm_bool_const(ar, inst.dv != 0));
    } else if op == IOP_GET_ARG() {
        vc_define(w, inst, vc_tm_var(ar, vc_param_name(inst.dv)));
    } else if op == IOP_NOT() {
        vc_define(w, inst, vc_tm_app1(ar, VC_OP_NOT(), w.var_of[inst.args[0] as u64]));
    } else if op == IOP_PHI() {
        vc_define(w, inst, vc_flow_phi_value(fl, ar, bi, inst.id));
    } else if op == IOP_UPSILON() {
        vc_flow_add_upsilon(fl, inst.dv, bi as i64, w.var_of[inst.args[0] as u64]);
    } else if op == IOP_VOW_REQ() {
        vc_assume(cs, pc, w.var_of[inst.args[0] as u64]);
    } else if op == IOP_VOW_ENS() {
        vc_add_claim(cs, VC_CLAIM_ENSURES(), inst.dv, String::from(""), pc, w.var_of[inst.args[0] as u64]);
    } else if op == IOP_JUMP() {
        vc_flow_add_edge(fl, succ[bi * 2] as u64, bi as i64, pc, fl.block_foff[bi], fl.block_flen[bi]);
    } else if op == IOP_BRANCH() {
        vc_walk_branch(w, inst, bi, pc, fl.block_foff[bi], fl.block_flen[bi], succ[bi * 2], succ[bi * 2 + 1]);
    } else if op != IOP_RETURN() {
        let lhs: i64 = w.var_of[inst.args[0] as u64];
        let rhs: i64 = w.var_of[inst.args[1] as u64];
        if op == IOP_WDIV() || op == IOP_WREM() {
            vc_arith_claims(w, inst, pc);
        }
        vc_define(w, inst, vc_tm_app2(ar, vc_smt_op(op), lhs, rhs));
    }
}

// Obligations for a function inside the native subset, in walk order.
fn vc_claims(f: IrFunction) -> VcClaims {
    let ar: VcArena = vc_arena_new();
    let hdr: SmtScript = vc_script_new();
    let assumed: Vec<i64> = Vec::new();
    let cs: VcClaims = VcClaims {
        arena: ar,
        header: hdr,
        assumed: assumed,
        kinds: Vec::new(),
        vow_ids: Vec::new(),
        labels: Vec::new(),
        negated_goals: Vec::new(),
        header_lens: Vec::new(),
        assumed_lens: Vec::new(),
        model_names: Vec::new(),
        model_params: Vec::new(),
    };
    vc_script_set_logic(hdr, String::from("QF_BV"));
    vc_script_set_option(hdr, String::from(":produce-models"), String::from("true"));
    let mut pi: u64 = 0;
    while pi < f.params.len() {
        if f.params[pi] == ITY_I64() {
            vc_script_declare_const(hdr, vc_param_name(pi as i64), VC_SORT_BV64());
            cs.model_names.push(vc_param_name(pi as i64));
            cs.model_params.push(pi as i64);
        }
        pi = pi + 1;
    }

    let tys: Vec<i64> = vc_ty_table(f);
    let nb: u64 = f.blocks.len();
    let w: VcWalk = VcWalk {
        cs: cs,
        fl: vc_flow_new(nb, tys.len()),
        var_of: dom_fill(tys.len(), -1),
        def_of: dom_fill(tys.len(), -1),
        tys: tys,
    };
    let id_to_idx: Vec<i64> = dom_block_id_table(f);
    let succ: Vec<i64> = dom_successors(f, id_to_idx);
    let order: Vec<i64> = dom_rpo_order(dom_rpo_numbers(nb, succ));
    let fl: VcFlow = w.fl;

    let mut oi: u64 = 0;
    while oi < order.len() {
        let bi: u64 = order[oi] as u64;
        let mut live: bool = true;
        if bi == 0 {
            fl.block_pc[0] = vc_tm_bool_const(ar, true);
        } else {
            live = vc_flow_enter(fl, ar, hdr, bi);
        }
        if live {
            let blk: IrBlock = f.blocks[bi];
            let mut ii: u64 = 0;
            while ii < blk.insts.len() {
                let inst: IrInst = blk.insts[ii];
                vc_walk_inst(w, bi, inst, succ);
                ii = ii + 1;
            }
        }
        oi = oi + 1;
    }
    cs
}
