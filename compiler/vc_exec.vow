// Symbolic execution of an acyclic integer/Bool function (one that
// `vc_skip_reason` accepts, after `vc_unroll` removed its loops), with its
// aggregates scalarised by `vc_agg`, into proof obligations. Blocks are walked in
// reverse postorder (`vc_flow` holds the path conditions and merges). A value
// that is a variable or a constant is used as it is; a composite one becomes a
// `define-fun` the first time its term is built, and every later value with the
// same term shares that name. Each `requires` is an assumption for the claims
// that follow it. A claim is only asked on the paths that reach it: its query
// asserts the block's path condition next to the negated goal, and an
// assumption made in a block is the implication `path condition => assumption`.
// SMT division and shifts are total, so the aborts the language specifies are
// separate claims, and a later claim always assumes the guards of earlier ones
// on its path: an aborting run never reaches it. Two kinds of abort:
//
//   hard  wrapping `/`, `%` (zero divisor, signed MIN / -1) and a shift count
//         outside `0 <= count < width`: a counterexample fails the function.
//   hard  the abort of `.unwrap()` on `None`/`Err`: the lowerer branches on the
//         discriminant and calls the abort on the empty variant, so that call is
//         a claim that its path is infeasible.
//   hard  a `Vec` index at or past the length (`vc_vec`), on `get` and `set`.
//   soft  checked `+! -! *! /! %!`: the language aborts on overflow, so the
//         contract is judged on returning runs only. A counterexample to a soft
//         claim is not a failure; it means the abort is reachable and the
//         driver reports it as an `ArithOverflowReachable` warning.
//
// A loop reaches the executor already unrolled (`vc_unroll`): a back edge past
// the bound ends in a sink block, and a path that reaches it is the unwinding
// claim "no run needs more iterations than the bound". It is a claim only and
// assumes nothing afterwards: a counterexample means the bound was too small,
// not that the function is wrong. A loop `invariant` is checked like an
// `ensures` at every iteration copy of its header, and assumed nowhere in an
// unrolled function. In the inductive attempt (`vc_induct`) the loop is cut
// instead: a header Phi is a havoc marker, a fresh unconstrained constant, and
// the invariant of the havoc copy is a plain `requires`, an assumption.
//
// The step function of k-induction (`vc_unroll_step`) is the same acyclic walk
// with a per-block hypothesis marking: in a hypothesis block no claim is asked
// but every goal is still assumed (a guard, a callee clause, the target's own
// `invariant`), and the invariant of the block that is not a hypothesis is
// assumed once asked, so the exit continues under it.
//
// A call has been spliced into its caller before this point (`vc_inline`), and
// the clauses of the copy carry the frame they came from (`vc_frame_of`). In a
// frame a `requires` is a claim blamed on the caller and an `ensures` or loop
// `invariant` one blamed on the callee, and both are assumed afterwards: the
// first failing claim on a path is the one reported. A function without a `vow`
// block is verified only for its callees' preconditions (`pre_only`): every
// other claim is assumed instead, as the ESBMC pipeline demotes it.

fn VC_CLAIM_ENSURES() -> i64 { 0 }
fn VC_CLAIM_DIV_ZERO() -> i64 { 1 }
fn VC_CLAIM_DIV_OVERFLOW() -> i64 { 2 }
fn VC_CLAIM_SHIFT_COUNT() -> i64 { 3 }
fn VC_CLAIM_ARITH() -> i64 { 4 }
fn VC_CLAIM_UNWRAP_NONE() -> i64 { 5 }
fn VC_CLAIM_UNWIND() -> i64 { 6 }
fn VC_CLAIM_CALLER_PRE() -> i64 { 7 }
fn VC_CLAIM_CALLEE_POST() -> i64 { 8 }
fn VC_CLAIM_VEC_BOUNDS() -> i64 { 9 }

fn VC_LABEL_DIV_ZERO() -> String { String::from("division by zero") }
fn VC_LABEL_DIV_OVERFLOW() -> String { String::from("division overflow") }
fn VC_LABEL_SHIFT_COUNT() -> String { String::from("integer shift count") }
fn VC_LABEL_UNWRAP_NONE() -> String { String::from("unwrap-none") }
fn VC_LABEL_UNWIND() -> String { String::from("unwinding assertion") }
fn VC_LABEL_VEC_BOUNDS() -> String { String::from("vec bounds") }
fn VC_LABEL_STRING_BOUNDS() -> String { String::from("string bounds") }

fn vc_value_name(id: i64) -> String {
    let out: String = String::from("v");
    out.push_str(i64_to_string(id));
    out
}

fn vc_param_name(k: i64) -> String {
    let out: String = String::from("p");
    out.push_str(i64_to_string(k));
    out
}

// Records the claim that `goal` holds on the paths satisfying `pc`, unless the
// simplifier already decided it: the negated query is the constant `false`, or
// `pc => goal` is itself an earlier assumption (the terms are hash-consed, so
// equal formulas are one id). Both are `unsat` under any assumptions, so the
// solver would only confirm what the claim list already says.
fn vc_add_claim(cs: VcClaims, kind: i64, vow_id: i64, label: String, pc: i64, goal: i64, ostart: i64, olen: i64, frame: i64) {
    if cs.hyp_now {
        return;
    }
    if cs.pre_only && kind != VC_CLAIM_CALLER_PRE() && kind != VC_CLAIM_UNWIND() {
        return;
    }
    let ar: VcArena = cs.arena;
    let negated: i64 = vc_tm_and(ar, pc, vc_tm_app1(ar, VC_OP_NOT(), goal));
    if vc_tm_is_false(ar, negated) {
        return;
    }
    if cs.assumed.len() > 0 {
        if ar.assumed[vc_tm_implies(ar, pc, goal) as u64] == 1 {
            return;
        }
    }
    let hdr: SmtScript = cs.header;
    cs.kinds.push(kind);
    cs.frames.push(frame);
    cs.vow_ids.push(vow_id);
    cs.labels.push(label);
    cs.ostarts.push(ostart);
    cs.olens.push(olen);
    cs.negated_goals.push(negated);
    cs.header_lens.push(hdr.kinds.len() as i64);
    cs.assumed_lens.push(cs.assumed.len() as i64);
}

fn vc_assume(cs: VcClaims, pc: i64, t: i64) {
    let ar: VcArena = cs.arena;
    let fact: i64 = vc_tm_implies(ar, pc, t);
    if vc_tm_is_true(ar, fact) {
        return;
    }
    ar.assumed[fact as u64] = 1;
    cs.assumed.push(fact);
}

// A claim that `goal` holds on the paths reaching `inst`, then the assumption
// that it does.
fn vc_guard(cs: VcClaims, kind: i64, label: String, pc: i64, goal: i64, inst: IrInst) {
    vc_add_claim(cs, kind, -1, label, pc, goal, inst.ostart, inst.olen, vc_frame_of(inst));
    vc_assume(cs, pc, goal);
}

// Appends the scalar fields of aggregate parameters the walk read (declared
// lazily, so only now are they all known) after the scalar parameters, with the
// slot each came from (a symbol's width is its sort: 0 for Bool). A slot read
// at two sorts is `ambig` in every entry so reporting and replay can tell the
// symbols apart.
fn vc_claims_harvest_fields(cs: VcClaims, ag: VcAgg, vv: VcVec, ov: VcOverlay) {
    let none: i64 = 9223372036854775807;
    let mut i: u64 = 0;
    let mut v: u64 = 0;
    let mut a: u64 = 0;
    while i < ag.ps_param.len() || v < vv.pv_param.len() || a < ov.param.len() {
        let hi: i64 = { if i < ag.ps_param.len() { ag.ps_hdr[i] } else { none } };
        let hv: i64 = { if v < vv.pv_param.len() { vv.pv_hdr[v] } else { none } };
        let ha: i64 = { if a < ov.param.len() { ov.hdr[a] } else { none } };
        if hv < hi && hv < ha {
            cs.model_names.push(vv.pv_len[v]);
            cs.model_paths.push(String::from(""));
            cs.model_params.push(vv.pv_param[v]);
            cs.model_tys.push(ITY_U64());
            cs.model_widths.push(64);
            cs.model_slots.push(VC_SLOT_VEC_LEN());
            cs.model_hdr.push(hv);
            v = v + 1;
        } else if ha < hi {
            cs.model_names.push(ov.names[a]);
            cs.model_paths.push(String::from(""));
            cs.model_params.push(ov.param[a]);
            cs.model_tys.push(ITY_I64());
            cs.model_widths.push(64);
            cs.model_slots.push(VC_SLOT_ADDR());
            cs.model_hdr.push(ha);
            a = a + 1;
        } else {
            cs.model_names.push(ag.ps_name[i]);
            cs.model_paths.push(ag.ps_path[i]);
            cs.model_params.push(ag.ps_param[i]);
            cs.model_tys.push(ag.ps_ty[i]);
            cs.model_widths.push(ag.ps_sort[i]);
            cs.model_slots.push(ag.ps_slot[i]);
            cs.model_hdr.push(hi);
            i = i + 1;
        }
    }
    cs.vec_param = vv.pv_param;
    cs.vec_arr = vv.pv_arr;
    cs.vec_len = vv.pv_len;
    cs.vec_hdr = vv.pv_hdr;
    cs.vec_wide = vv.pv_wide;
    let mut j: u64 = 0;
    while j < cs.model_slots.len() {
        let mut amb: i64 = 0;
        if cs.model_slots[j] >= 0 {
            let mut o: u64 = 0;
            while o < cs.model_slots.len() {
                if o != j && cs.model_params[o] == cs.model_params[j] && cs.model_paths[o] == cs.model_paths[j] && cs.model_slots[o] == cs.model_slots[j] && cs.model_widths[o] != cs.model_widths[j] {
                    amb = 1;
                }
                o = o + 1;
            }
        }
        cs.model_ambig.push(amb);
        j = j + 1;
    }
}

// Symbolic state shared by the block walk.
struct VcWalk {
    cs: VcClaims,
    fl: VcFlow,
    ag: VcAgg,
    vv: VcVec,
    hp: VcHeap,
    mp: VcMap,
    ov: VcOverlay,
    var_of: Vec<i64>,
    obj_of: Vec<i64>,
    // The element address a wide `Vec` call defined (`vc_wide`): the `Vec`'s slot,
    // its object and the index term of the element; -1 for every other value.
    wslot: Vec<i64>,
    wobj: Vec<i64>,
    widx: Vec<i64>,
    // The object of the `Vec` a one-slot `get` read, for every value that read is,
    // and the float type of every value a float was stored into a slot as (`vc_fp`);
    // -1 for every other value. They tell a counterexample which parameters hold floats.
    elem_obj: Vec<i64>,
    bits_ty: Vec<i64>,
    tys: Vec<i64>,
    lits: Vec<i64>,
    dvs: Vec<i64>,
}

// Binds the value of `inst` to `t`: a leaf is used as it is, a composite gets
// a `define-fun` once, so a second instruction computing the same term shares
// the first one's name.
fn vc_define(w: VcWalk, inst: IrInst, t: i64) {
    let cs: VcClaims = w.cs;
    let ar: VcArena = cs.arena;
    let known: i64 = vc_tm_shared(ar, t);
    if known >= 0 {
        w.var_of[inst.id as u64] = known;
        return;
    }
    let name: String = vc_value_name(inst.id);
    vc_script_define_fun(cs.header, name, vc_ty_sort(inst.ty), t);
    w.var_of[inst.id as u64] = vc_tm_bind(ar, t, name);
}

// The term for an operand read at type `at`: an `i64` literal against another
// integer type is rebuilt at that type, sign-extended into the high limb only
// for a signed `at` (the checker has range-checked it, so an unsigned type never
// sees a negative literal).
fn vc_operand_at(w: VcWalk, at: i64, id: i64) -> i64 {
    let term: i64 = w.var_of[id as u64];
    if w.tys[id as u64] == at || w.lits[id as u64] != 1 { return term; }
    let mut hi: i64 = 0;
    if vc_ty_signed(at) { hi = w.dvs[id as u64] >> 63; }
    vc_int_const(w.cs.arena, at, w.dvs[id as u64], hi)
}

// Value of an arithmetic/bitwise instruction, plus its abort guards.
fn vc_exec_arith(w: VcWalk, inst: IrInst, pc: i64) -> i64 {
    let cs: VcClaims = w.cs;
    let ar: VcArena = cs.arena;
    let op: i64 = inst.op;
    let ty: i64 = inst.ty;
    let signed: bool = vc_ty_signed(ty);
    let a: i64 = vc_operand_at(w, ty, inst.args[0]);
    let b: i64 = vc_operand_at(w, ty, inst.args[1]);
    let value: i64 = vc_tm_app2(ar, vc_arith_smt_op(op, signed), a, b);
    if op == IOP_WDIV() || op == IOP_WREM() || op == IOP_CDIV() || op == IOP_CREM() {
        let soft: bool = op == IOP_CDIV() || op == IOP_CREM();
        let zero_kind: i64 = { if soft { VC_CLAIM_ARITH() } else { VC_CLAIM_DIV_ZERO() } };
        let zero_label: String = { if soft { VC_CAUSE_DIV_ZERO() } else { VC_LABEL_DIV_ZERO() } };
        vc_guard(cs, zero_kind, zero_label, pc, vc_div_nonzero(ar, ty, b), inst);
        if (op == IOP_WDIV() || op == IOP_CDIV()) && signed {
            let ovf_kind: i64 = { if soft { VC_CLAIM_ARITH() } else { VC_CLAIM_DIV_OVERFLOW() } };
            let ovf_label: String = { if soft { VC_CAUSE_DIV_OVERFLOW() } else { VC_LABEL_DIV_OVERFLOW() } };
            vc_guard(cs, ovf_kind, ovf_label, pc, vc_div_no_overflow(ar, ty, a, b), inst);
        }
    } else if vc_is_checked_addsubmul(op) {
        vc_guard(cs, VC_CLAIM_ARITH(), vc_checked_cause(op), pc, vc_no_overflow(ar, op, signed, a, b), inst);
    }
    value
}

// A float entering or leaving the 8-byte slot of a `Vec` element (`vc_fp`). A read is
// `to_fp` of the slot. A write is the constant's own bits, else a fresh bit pattern
// assumed to be one of the float, so a write and a read of the same float agree
// (`to_fp(b) = x`) and the slot itself stays a plain 64-bit element for the array.
fn vc_exec_float_bits(w: VcWalk, inst: IrInst, pc: i64) -> i64 {
    let cs: VcClaims = w.cs;
    let ar: VcArena = cs.arena;
    let x: i64 = w.var_of[inst.args[0] as u64];
    let ft: i64 = vc_fp_op_ty(inst.op);
    if vc_fp_is_from_bits(inst.op) {
        let obj: i64 = w.elem_obj[inst.args[0] as u64];
        if obj >= 0 { vc_vec_mark_elem(w.vv, w.ag, obj, ft); }
        return vc_fp_from_slot(ar, ft, x);
    }
    w.bits_ty[inst.id as u64] = ft;
    let konst: i64 = vc_fp_const_slot(ar, ft, x);
    if konst >= 0 { return konst; }
    let width: i64 = { if ft == ITY_F32() { 32 } else { 64 } };
    let fresh: i64 = vc_agg_junk(w.ag, ar, cs.header, width);
    vc_assume(cs, pc, vc_fp_slot_fact(ar, ft, fresh, x));
    vc_fp_slot_value(ar, ft, fresh)
}

// Value of a defined, non-control instruction.
fn vc_exec_value(w: VcWalk, inst: IrInst, pc: i64) -> i64 {
    let cs: VcClaims = w.cs;
    let ar: VcArena = cs.arena;
    let op: i64 = inst.op;
    if vc_is_const_int_op(op) {
        let mut hi: i64 = 0;
        if inst.ty == ITY_I128() || inst.ty == ITY_U128() { hi = inst.dv2; }
        return vc_int_const(ar, inst.ty, inst.dv, hi);
    }
    if op == IOP_CONST_BOOL() { return vc_tm_bool_const(ar, inst.dv != 0); }
    if vc_fp_is_const(op) { return vc_fp_const(ar, inst.ty, inst.dv); }
    if op == IOP_GET_ARG() { return vc_tm_var(ar, vc_param_name(inst.dv)); }
    if op == IOP_NOT() { return vc_tm_app1(ar, VC_OP_NOT(), w.var_of[inst.args[0] as u64]); }
    if op == IOP_INT_CAST() { return vc_cast(ar, inst.dv, inst.ty, w.var_of[inst.args[0] as u64]); }
    if vc_fp_is_neg(op) { return vc_tm_app1(ar, VC_OP_FPNEG(), w.var_of[inst.args[0] as u64]); }
    if vc_fp_is_to_bits(op) || vc_fp_is_from_bits(op) { return vc_exec_float_bits(w, inst, pc); }
    let lhs: i64 = w.var_of[inst.args[0] as u64];
    let rhs: i64 = w.var_of[inst.args[1] as u64];
    if op == IOP_SHL() || op == IOP_SHR() {
        let count_ty: i64 = w.tys[inst.args[1] as u64];
        vc_guard(cs, VC_CLAIM_SHIFT_COUNT(), VC_LABEL_SHIFT_COUNT(), pc, vc_shift_count_ok(ar, inst.ty, count_ty, rhs), inst);
        return vc_shift(ar, op, inst.ty, count_ty, lhs, rhs);
    }
    if vc_fp_is_arith(op) { return vc_tm_app2(ar, vc_fp_arith_smt(op), lhs, rhs); }
    if vc_fp_is_cmp(op) { return vc_fp_cmp(ar, op, lhs, rhs); }
    if op == IOP_AND() { return vc_tm_app2(ar, VC_OP_AND(), lhs, rhs); }
    if op == IOP_OR() { return vc_tm_app2(ar, VC_OP_OR(), lhs, rhs); }
    if vc_is_cmp_op(op) {
        let at: i64 = vc_cmp_operand_ty(inst, w.tys, w.lits);
        let a: i64 = vc_operand_at(w, at, inst.args[0]);
        let b: i64 = vc_operand_at(w, at, inst.args[1]);
        return vc_tm_app2(ar, vc_cmp_smt_op(op, vc_ty_signed(at)), a, b);
    }
    vc_exec_arith(w, inst, pc)
}

// A wide `Vec` call (`vc_wide`): the element address it defines is remembered, not
// a term. `push` extends the length by one and leaves the element unconstrained
// until the write that follows; `get` and `set` are bounds claims like their
// one-slot twins.
fn vc_walk_wide_call(w: VcWalk, bi: u64, inst: IrInst, pc: i64, kind: i64, s: i64) {
    let cs: VcClaims = w.cs;
    let ar: VcArena = cs.arena;
    let vv: VcVec = w.vv;
    let b: i64 = bi as i64;
    let len: i64 = vc_vec_cur_len(vv, s, b);
    let mut idx: i64 = len;
    if kind == VC_VEC_PUSH_WIDE() {
        vc_assume(cs, pc, vc_vec_push_guard(ar, len));
        vc_vec_write(vv, ar, cs.header, s, b, vc_vec_cur_arr(vv, s, b), vc_tm_app2(ar, VC_OP_BVADD(), len, vc_tm_bv(ar, 64, 1, 0)));
    } else {
        idx = w.var_of[inst.args[1] as u64];
        vc_guard(cs, VC_CLAIM_VEC_BOUNDS(), VC_LABEL_VEC_BOUNDS(), pc, vc_vec_in_bounds(ar, idx, len), inst);
    }
    w.wslot[inst.id as u64] = s;
    w.wobj[inst.id as u64] = w.obj_of[inst.args[0] as u64];
    w.widx[inst.id as u64] = idx;
}

// A `WideSlot` read or write through an element address: the two limbs of the
// element in the array of the `Vec`, as the current block sees it.
fn vc_walk_wide_access(w: VcWalk, bi: u64, inst: IrInst) {
    let cs: VcClaims = w.cs;
    let ar: VcArena = cs.arena;
    let vv: VcVec = w.vv;
    let b: i64 = bi as i64;
    let r: u64 = inst.args[0] as u64;
    let s: i64 = w.wslot[r];
    let arr: i64 = vc_vec_cur_arr(vv, s, b);
    if inst.op == IOP_FIELD_GET() {
        vc_vec_mark_elem(vv, w.ag, w.wobj[r], inst.ty);
        vc_define(w, inst, vc_wide_read(ar, arr, w.widx[r]));
    } else {
        let val: i64 = inst.args[1];
        vc_vec_mark_elem(vv, w.ag, w.wobj[r], w.tys[val as u64]);
        vc_vec_write(vv, ar, cs.header, s, b, vc_wide_write(ar, arr, w.widx[r], w.var_of[val as u64]), vc_vec_cur_len(vv, s, b));
    }
}

// Aggregate instructions: pointers are objects (`obj_of`), never terms; a field
// read defines a scalar value.
fn vc_walk_agg(w: VcWalk, bi: u64, inst: IrInst) -> bool {
    let cs: VcClaims = w.cs;
    let ag: VcAgg = w.ag;
    let op: i64 = inst.op;
    if (op == IOP_FIELD_GET() || op == IOP_FIELD_SET()) && w.wslot[inst.args[0] as u64] >= 0 {
        vc_walk_wide_access(w, bi, inst);
        return true;
    }
    if op == IOP_GET_ARG() && inst.ty == ITY_PTR() {
        w.obj_of[inst.id as u64] = vc_agg_param(ag, inst.dv);
        return true;
    }
    if op == IOP_REGION_ALLOC() {
        let obj: i64 = vc_agg_alloc(ag, w.fl.block_pc[bi]);
        w.obj_of[inst.id as u64] = obj;
        return true;
    }
    if op == IOP_FIELD_SET() {
        let val: i64 = inst.args[1];
        // A pointer written into a field is never read back (`vc_heap_store_detail`).
        if w.tys[val as u64] == ITY_PTR() { return true; }
        let seen: u64 = ag.ps_param.len();
        vc_agg_write(ag, cs.arena, cs.header, w.obj_of[inst.args[0] as u64], inst.dv, vc_ty_sort(w.tys[val as u64]), w.var_of[val as u64], w.fl.block_pc[bi]);
        vc_agg_type_symbols(ag, seen, w.tys[val as u64]);
        return true;
    }
    if op == IOP_FIELD_GET() && inst.ty == ITY_PTR() {
        w.obj_of[inst.id as u64] = vc_agg_child(ag, w.obj_of[inst.args[0] as u64], inst.dv);
        return true;
    }
    if op == IOP_FIELD_GET() && w.tys[inst.args[0] as u64] == ITY_I64() {
        let h: i64 = w.var_of[inst.args[0] as u64];
        let base: i64 = vc_heap_field(w.hp, cs.arena, cs.header, h, inst.dv, inst.ty);
        vc_define(w, inst, vc_overlay_field(w.ov, ag, cs.arena, cs.header, h, inst.dv, inst.ty, base));
        return true;
    }
    if op == IOP_FIELD_GET() {
        let seen: u64 = ag.ps_param.len();
        let t: i64 = vc_agg_get(ag, cs.arena, cs.header, w.obj_of[inst.args[0] as u64], inst.dv, vc_ty_sort(inst.ty));
        vc_agg_type_symbols(ag, seen, inst.ty);
        vc_define(w, inst, t);
        return true;
    }
    if op == IOP_PHI() && inst.ty == ITY_PTR() {
        w.obj_of[inst.id as u64] = vc_agg_phi(ag, bi, inst.id);
        return true;
    }
    if op == IOP_UPSILON() && w.tys[inst.args[0] as u64] == ITY_PTR() {
        vc_flow_add_upsilon(w.fl, inst.dv, bi as i64, w.obj_of[inst.args[0] as u64]);
        return true;
    }
    false
}

// A fresh aggregate object for the result of `inst`, allocated at the block's path condition.
fn vc_walk_new_obj(w: VcWalk, bi: u64, inst: IrInst) -> i64 {
    let obj: i64 = vc_agg_alloc(w.ag, w.fl.block_pc[bi]);
    w.obj_of[inst.id as u64] = obj;
    obj
}

// The result term of a `String` predicate: the 64-bit `1`/`0` of an `i64` result,
// the Bool itself for a `Bool` one.
fn vc_str_flag(ar: VcArena, inst: IrInst, t: i64) -> i64 {
    if inst.ty == ITY_BOOL() { return t; }
    vc_tm_app3(ar, VC_OP_ITE(), t, vc_tm_bv(ar, 64, 1, 0), vc_tm_bv(ar, 64, 0, 0))
}

// A `String` call (`vc_str`) on the string of slot `s`. A new string (a clone, a
// substring) is a new object with its own state; a mutation replaces the state of
// the receiver in this block. A byte read at or past the length is a hard claim,
// like a `Vec` index, assumed afterwards.
fn vc_walk_str(w: VcWalk, bi: u64, inst: IrInst, pc: i64, kind: i64, s: i64) {
    let cs: VcClaims = w.cs;
    let ar: VcArena = cs.arena;
    let hdr: SmtScript = cs.header;
    let vv: VcVec = w.vv;
    let b: i64 = bi as i64;
    let arr: i64 = vc_vec_cur_arr(vv, s, b);
    let len: i64 = vc_vec_cur_len(vv, s, b);
    if kind == VC_STR_PARSE_F64() {
        vc_define(w, inst, vc_hook_parse(vv, ar, hdr, cs.assumed, arr, len));
    } else if kind == VC_STR_HASH() {
        vc_define(w, inst, vc_str_hash(vv, ar, hdr, cs.assumed, arr, len));
    } else if kind == VC_STR_PARSE_INT() {
        let obj: i64 = vc_walk_new_obj(w, bi, inst);
        let bits: i64 = vc_str_parse_bits(inst.ds);
        let res: Vec<i64> = Vec::new();
        vc_hook_parse_opt(vv, ar, hdr, cs.assumed, vc_str_parse_key(inst.ds), bits, arr, len, res);
        vc_agg_set(w.ag, obj, 0, 64, vc_tm_app3(ar, VC_OP_ITE(), res[0], vc_tm_bv(ar, 64, 1, 0), vc_tm_bv(ar, 64, 0, 0)));
        vc_agg_set(w.ag, obj, 1, bits, res[1]);
    } else if kind == VC_STR_BYTE_AT() {
        let idx: i64 = w.var_of[inst.args[1] as u64];
        vc_guard(cs, VC_CLAIM_VEC_BOUNDS(), VC_LABEL_STRING_BOUNDS(), pc, vc_vec_in_bounds(ar, idx, len), inst);
        vc_define(w, inst, vc_str_byte(ar, arr, idx));
    } else if kind == VC_STR_PUSH_BYTE() {
        let elem: i64 = vc_str_pushed_byte(ar, w.tys[inst.args[1] as u64], w.var_of[inst.args[1] as u64]);
        vc_assume(cs, pc, vc_vec_push_guard(ar, len));
        vc_vec_push(vv, ar, hdr, s, b, elem);
    } else if kind == VC_STR_CLEAR() {
        vc_vec_write(vv, ar, hdr, s, b, arr, vc_str_zero(ar));
    } else if kind == VC_STR_PUSH_STR() {
        let t: i64 = vc_vec_slot(vv, w.ag, ar, hdr, cs.assumed, w.obj_of[inst.args[1] as u64]);
        let ta: i64 = vc_vec_cur_arr(vv, t, b);
        let tl: i64 = vc_vec_cur_len(vv, t, b);
        let total: i64 = vc_tm_app2(ar, VC_OP_BVADD(), len, tl);
        vc_assume(cs, pc, vc_tm_app2(ar, VC_OP_BVULT(), total, vc_vec_len_mask(ar)));
        vc_vec_write(vv, ar, hdr, s, b, vc_str_append(vv, ar, hdr, cs.assumed, arr, len, ta, tl), total);
    } else if kind == VC_STR_EQ() || kind == VC_STR_STARTS_WITH() || kind == VC_STR_ENDS_WITH() || kind == VC_STR_CONTAINS() {
        let t: i64 = vc_vec_slot(vv, w.ag, ar, hdr, cs.assumed, w.obj_of[inst.args[1] as u64]);
        let ta: i64 = vc_vec_cur_arr(vv, t, b);
        let tl: i64 = vc_vec_cur_len(vv, t, b);
        let mut r: i64 = 0;
        if kind == VC_STR_STARTS_WITH() { r = vc_str_starts_with(vv, ar, hdr, cs.assumed, arr, len, ta, tl); }
        else if kind == VC_STR_ENDS_WITH() { r = vc_str_ends_with(vv, ar, hdr, cs.assumed, arr, len, ta, tl); }
        else if kind == VC_STR_CONTAINS() { r = vc_str_contains(vv, ar, hdr, cs.assumed, arr, len, ta, tl); }
        else { r = vc_str_eq(vv, ar, hdr, cs.assumed, arr, len, ta, tl); }
        vc_define(w, inst, vc_str_flag(ar, inst, r));
    } else if kind == VC_STR_MATCHES_LITERAL_AT() {
        let lit: i64 = vc_vec_slot(vv, w.ag, ar, hdr, cs.assumed, w.obj_of[inst.args[2] as u64]);
        let m: i64 = vc_str_matches_literal(vv, ar, hdr, cs.assumed, arr, len, w.var_of[inst.args[1] as u64], vv.lit_text[lit as u64], vc_vec_cur_arr(vv, lit, b));
        vc_define(w, inst, vc_str_flag(ar, inst, m));
    } else {
        let obj: i64 = vc_walk_new_obj(w, bi, inst);
        if kind == VC_STR_CLONE() { vc_vec_set_src(vv, obj, w.obj_of[inst.args[0] as u64]); }
        let mut narr: i64 = arr;
        let mut nlen: i64 = len;
        if kind == VC_STR_SUBSTRING() || kind == VC_STR_SUBSTR() {
            let range: Vec<i64> = Vec::new();
            let x: i64 = w.var_of[inst.args[1] as u64];
            let y: i64 = w.var_of[inst.args[2] as u64];
            if kind == VC_STR_SUBSTRING() { vc_str_substring_range(ar, len, x, y, range); }
            else { vc_str_substr_range(ar, len, x, y, range); }
            nlen = range[1];
            narr = vc_str_slice(vv, ar, hdr, cs.assumed, arr, range[0], range[1]);
        }
        if vc_str_kind_text_hook(kind) {
            let out: Vec<i64> = Vec::new();
            vc_hook_text_fn(vv, ar, hdr, cs.assumed, kind, arr, len, out);
            narr = out[0];
            nlen = out[1];
        }
        if kind == VC_STR_HEX_ENCODE() || kind == VC_STR_HEX_DECODE() {
            let out: Vec<i64> = Vec::new();
            if kind == VC_STR_HEX_DECODE() {
                vc_str_hex_decode(vv, ar, hdr, cs.assumed, arr, len, out);
            } else {
                vc_assume(cs, pc, vc_tm_app2(ar, VC_OP_BVULT(), vc_tm_app2(ar, VC_OP_BVMUL(), len, vc_tm_bv(ar, 64, 2, 0)), vc_vec_len_mask(ar)));
                vc_str_hex_encode(vv, ar, hdr, cs.assumed, arr, len, out);
            }
            narr = out[0];
            nlen = out[1];
        }
        vc_vec_create_with(vv, ar, hdr, obj, b, narr, nlen);
    }
}

// `len` or `v[i]` of a collection at a handle (`vc_heap`): a read of the memory the
// function loaded, with the same bounds claim as an object's `get`.
fn vc_walk_handle_vec(w: VcWalk, bi: u64, inst: IrInst, pc: i64, kind: i64) {
    let cs: VcClaims = w.cs;
    let ar: VcArena = cs.arena;
    let hdr: SmtScript = cs.header;
    let b: i64 = bi as i64;
    let h: i64 = w.var_of[inst.args[0] as u64];
    let base_len: i64 = vc_heap_len(w.hp, ar, hdr, cs.assumed, h);
    let rcls: i64 = vc_overlay_op_class(inst, kind);
    let len: i64 = vc_overlay_len(w.ov, w.ag, w.vv, ar, hdr, cs.assumed, b, h, rcls, base_len);
    if kind == VC_VEC_LEN() {
        vc_define(w, inst, len);
        return;
    }
    let idx: i64 = w.var_of[inst.args[1] as u64];
    if kind == VC_STR_BYTE_AT() {
        vc_guard(cs, VC_CLAIM_VEC_BOUNDS(), VC_LABEL_STRING_BOUNDS(), pc, vc_vec_in_bounds(ar, idx, len), inst);
        let base: i64 = vc_heap_byte(w.hp, ar, hdr, h, idx);
        vc_define(w, inst, vc_overlay_elem(w.ov, w.ag, w.vv, ar, hdr, cs.assumed, b, h, idx, rcls, true, base));
        return;
    }
    vc_guard(cs, VC_CLAIM_VEC_BOUNDS(), VC_LABEL_VEC_BOUNDS(), pc, vc_vec_in_bounds(ar, idx, len), inst);
    let base: i64 = vc_heap_elem(w.hp, ar, hdr, h, idx);
    vc_define(w, inst, vc_overlay_elem(w.ov, w.ag, w.vv, ar, hdr, cs.assumed, b, h, idx, rcls, false, base));
}

// `vec_sort(v)`: a new `Vec` of `v`'s length whose slots are the sorted permutation of
// `v`'s (`VC_T_QSORT`, assumed on the paths that reach the call). The result array and the
// witness array of the permutation are fresh; the source array is the term `v` has now, so a
// later write to `v` does not move the result.
fn vc_walk_sort(w: VcWalk, bi: u64, inst: IrInst, pc: i64) {
    let cs: VcClaims = w.cs;
    let ar: VcArena = cs.arena;
    let hdr: SmtScript = cs.header;
    let vv: VcVec = w.vv;
    let b: i64 = bi as i64;
    let s: i64 = vc_vec_slot(vv, w.ag, ar, hdr, cs.assumed, w.obj_of[inst.args[0] as u64]);
    let src: i64 = vc_vec_cur_arr(vv, s, b);
    let len: i64 = vc_vec_cur_len(vv, s, b);
    let obj: i64 = vc_walk_new_obj(w, bi, inst);
    let out: i64 = vc_str_fresh_array(vv, ar, hdr, String::from("so"));
    let pq: i64 = vc_str_fresh_array(vv, ar, hdr, String::from("sp"));
    vc_vec_create_with(vv, ar, hdr, obj, b, out, len);
    vc_assume(cs, pc, vc_tm_qsort(ar, out, src, pq, len));
    vv.quantified = true;
}

// A `Vec` that a float was pushed or written into holds floats: a counterexample lists
// the elements of such a parameter as floats, not as raw slots.
fn vc_mark_stored_float(w: VcWalk, obj: i64, val: i64) {
    let ft: i64 = w.bits_ty[val as u64];
    if ft >= 0 { vc_vec_mark_elem(w.vv, w.ag, obj, ft); }
}

// A `Vec` call (`vc_vec`). `get` and `len` define a value, the rest change the
// object's state in this block; an index out of bounds is a hard claim, assumed
// afterwards like the other aborts.
fn vc_walk_vec(w: VcWalk, bi: u64, inst: IrInst, pc: i64) -> bool {
    let kind: i64 = vc_inst_vec_kind(inst);
    let cs: VcClaims = w.cs;
    let ar: VcArena = cs.arena;
    let hdr: SmtScript = cs.header;
    let vv: VcVec = w.vv;
    let b: i64 = bi as i64;
    if inst.op == IOP_CONST_STR() {
        let obj: i64 = vc_walk_new_obj(w, bi, inst);
        vc_str_literal(vv, ar, hdr, cs.assumed, obj, b, inst.ds);
        return true;
    }
    if kind == VC_VEC_NONE() { return false; }
    if kind == VC_VEC_NEW() || kind == VC_STR_NEW() {
        let obj: i64 = vc_walk_new_obj(w, bi, inst);
        vc_vec_create(vv, w.ag, ar, hdr, obj, b);
        return true;
    }
    if kind == VC_STR_FORMAT_F64() {
        let obj: i64 = vc_walk_new_obj(w, bi, inst);
        let j: u64 = vc_hook_format(vv, ar, hdr, cs.assumed, w.var_of[inst.args[0] as u64]);
        vc_vec_create_with(vv, ar, hdr, obj, b, vv.fk_arr[j], vv.fk_len[j]);
        return true;
    }
    if vc_str_kind_formats_int(kind) {
        let obj: i64 = vc_walk_new_obj(w, bi, inst);
        let text: Vec<i64> = Vec::new();
        vc_num_decimal(vv, ar, hdr, cs.assumed, w.var_of[inst.args[0] as u64], vc_str_kind_int_bits(kind), vc_str_kind_int_signed(kind), text);
        vc_vec_create_with(vv, ar, hdr, obj, b, text[0], text[1]);
        return true;
    }
    if kind == VC_STR_FROM_RAW_PARTS() {
        let obj: i64 = vc_walk_new_obj(w, bi, inst);
        // The runtime copies nothing for a null source or a zero length; otherwise
        // the result is `n` bytes of unknown contents, and a length at the
        // capacity mask traps (`set_vow_vec_capacity`), which never returns.
        let src: i64 = w.var_of[inst.args[0] as u64];
        let n: i64 = w.var_of[inst.args[1] as u64];
        let empty: i64 = vc_tm_or(ar, vc_tm_app2(ar, VC_OP_EQ(), src, vc_str_zero(ar)), vc_tm_app2(ar, VC_OP_EQ(), n, vc_str_zero(ar)));
        vc_assume(cs, pc, vc_tm_or(ar, empty, vc_tm_app2(ar, VC_OP_BVULT(), n, vc_vec_len_mask(ar))));
        let nlen: i64 = vc_tm_app3(ar, VC_OP_ITE(), empty, vc_str_zero(ar), n);
        vc_vec_create_with(vv, ar, hdr, obj, b, vc_str_fresh_array(vv, ar, hdr, String::from("sr")), nlen);
        return true;
    }
    if w.tys[inst.args[0] as u64] == ITY_I64() {
        vc_walk_handle_vec(w, bi, inst, pc, kind);
        return true;
    }
    if kind == VC_VEC_SORT() {
        vc_walk_sort(w, bi, inst, pc);
        return true;
    }
    let s: i64 = vc_vec_slot(vv, w.ag, ar, hdr, cs.assumed, w.obj_of[inst.args[0] as u64]);
    if vc_str_kind_is_string_op(kind) {
        vc_walk_str(w, bi, inst, pc, kind, s);
    } else if kind == VC_VEC_LEN() {
        vc_define(w, inst, vc_vec_cur_len(vv, s, b));
    } else if kind == VC_VEC_POP() {
        vc_vec_pop(vv, ar, hdr, s, b);
    } else if vc_vec_kind_is_wide(kind) {
        vc_walk_wide_call(w, bi, inst, pc, kind, s);
    } else if kind == VC_VEC_PUSH() {
        vc_mark_stored_float(w, w.obj_of[inst.args[0] as u64], inst.args[1]);
        let elem: i64 = vc_vec_elem64(ar, w.tys[inst.args[1] as u64], w.var_of[inst.args[1] as u64]);
        vc_assume(cs, pc, vc_vec_push_guard(ar, vc_vec_cur_len(vv, s, b)));
        vc_vec_push(vv, ar, hdr, s, b, elem);
    } else {
        let idx: i64 = w.var_of[inst.args[1] as u64];
        vc_guard(cs, VC_CLAIM_VEC_BOUNDS(), VC_LABEL_VEC_BOUNDS(), pc, vc_vec_in_bounds(ar, idx, vc_vec_cur_len(vv, s, b)), inst);
        if kind == VC_VEC_GET() {
            vc_define(w, inst, vc_tm_app2(ar, VC_OP_SELECT(), vc_vec_cur_arr(vv, s, b), idx));
            w.elem_obj[inst.id as u64] = w.obj_of[inst.args[0] as u64];
        } else {
            vc_mark_stored_float(w, w.obj_of[inst.args[0] as u64], inst.args[2]);
            let elem: i64 = vc_vec_elem64(ar, w.tys[inst.args[2] as u64], w.var_of[inst.args[2] as u64]);
            vc_vec_set(vv, ar, hdr, s, b, idx, elem);
        }
    }
    true
}

// The width of the key operand of a map call, or -1 when it says nothing about the
// map's key type: an `i64` literal (a contract clause lowers a bare literal to
// `i64` whatever the key type is), or any operand that folds to a constant (a
// negative literal reaches the IR as `0 - 1` at type `i64`). A `BTreeMap`'s key is
// always `i64`.
fn vc_map_key_bits(w: VcWalk, inst: IrInst) -> i64 {
    if vc_inst_is_btree_op(inst) { return 64; }
    let id: u64 = inst.args[1] as u64;
    if w.lits[id] == 1 || vc_is_bv(w.cs.arena, w.var_of[id]) { return -1; }
    if w.tys[id] == ITY_BOOL() { return 1; }
    vc_ty_bits(w.tys[id])
}

// A map call (`vc_map`). `len` and `contains` define a value, `get` and a
// `BTreeMap` `insert` build an `Option` object, `insert` and `remove` replace the
// state of the map in this block.
fn vc_walk_map(w: VcWalk, bi: u64, inst: IrInst, pc: i64) -> bool {
    let kind: i64 = vc_inst_map_kind(inst);
    if kind == VC_MAP_NONE() { return false; }
    let cs: VcClaims = w.cs;
    let ar: VcArena = cs.arena;
    let hdr: SmtScript = cs.header;
    let mp: VcMap = w.mp;
    let b: i64 = bi as i64;
    if kind == VC_MAP_NEW() {
        vc_map_create(mp, ar, hdr, vc_walk_new_obj(w, bi, inst), b);
        return true;
    }
    let s: i64 = vc_map_slot(mp, w.ag, ar, hdr, cs.assumed, w.obj_of[inst.args[0] as u64]);
    if kind == VC_MAP_LEN() {
        if vc_inst_is_btree_op(inst) { vc_map_note_width(mp, s, 64); }
        vc_define(w, inst, vc_map_cur_len(mp, s, b));
        return true;
    }
    let key: i64 = vc_map_slot_word(ar, w.tys[inst.args[1] as u64], w.var_of[inst.args[1] as u64]);
    vc_map_note_key(mp, ar, hdr, cs.assumed, s, key, vc_map_key_bits(w, inst));
    let present: i64 = vc_map_present(ar, vc_map_cur_pres(mp, s, b), key);
    if kind == VC_MAP_CONTAINS() {
        vc_define(w, inst, present);
    } else if kind == VC_MAP_REMOVE() {
        vc_map_remove(mp, ar, hdr, s, b, present, key);
    } else {
        let old: i64 = vc_tm_app2(ar, VC_OP_SELECT(), vc_map_cur_vals(mp, s, b), key);
        if kind == VC_MAP_GET() || kind == VC_MAP_INSERT_OLD() {
            vc_map_fill_option(mp, w.ag, ar, hdr, vc_walk_new_obj(w, bi, inst), present, old);
        }
        if kind != VC_MAP_GET() {
            let val: i64 = vc_map_slot_word(ar, w.tys[inst.args[2] as u64], w.var_of[inst.args[2] as u64]);
            vc_assume(cs, pc, vc_map_insert_guard(ar, present, vc_map_cur_len(mp, s, b)));
            vc_map_insert(mp, ar, hdr, s, b, present, key, val);
        }
    }
    true
}

// A contract clause. The target's own `requires` is an assumption and its
// `ensures`/`invariant` a claim; a spliced callee's clauses are claims blamed on
// the caller and the callee, assumed once asked.
fn vc_walk_clause(w: VcWalk, inst: IrInst, pc: i64) {
    let cs: VcClaims = w.cs;
    let goal: i64 = w.var_of[inst.args[0] as u64];
    let frame: i64 = vc_frame_of(inst);
    if frame < 0 {
        if inst.op == IOP_VOW_REQ() {
            vc_assume(cs, pc, goal);
        } else {
            vc_add_claim(cs, VC_CLAIM_ENSURES(), inst.dv, String::from(""), pc, goal, inst.ostart, inst.olen, -1);
            if cs.step {
                vc_assume(cs, pc, goal);
            }
        }
        return;
    }
    let mut kind: i64 = VC_CLAIM_CALLEE_POST();
    if inst.op == IOP_VOW_REQ() { kind = VC_CLAIM_CALLER_PRE(); }
    vc_add_claim(cs, kind, inst.dv, String::from(""), pc, goal, inst.ostart, inst.olen, frame);
    vc_assume(cs, pc, goal);
}

// A narrowing intrinsic (`vc_narrow`): a `wrap` or `sat` call defines a closed term
// of its operand; a `try` call creates the `Option` it returns, tag and payload
// slots both functions of the operand, so a `match` on it reads exact values.
fn vc_walk_narrow(w: VcWalk, bi: u64, inst: IrInst) -> bool {
    let nar: VcNarrow = vc_narrow_of(inst);
    if nar.kind == VC_NAR_NONE() { return false; }
    let ar: VcArena = w.cs.arena;
    let x: i64 = w.var_of[inst.args[0] as u64];
    if nar.kind != VC_NAR_TRY() {
        vc_define(w, inst, vc_narrow_value(ar, nar, x));
        return true;
    }
    let obj: i64 = vc_walk_new_obj(w, bi, inst);
    vc_agg_set(w.ag, obj, 0, 64, vc_narrow_try_tag(ar, nar, x));
    vc_agg_set(w.ag, obj, 1, vc_ty_bits(nar.dst), vc_cast(ar, nar.src, nar.dst, x));
    true
}

fn vc_walk_inst(w: VcWalk, bi: u64, inst: IrInst, succ: Vec<i64>) {
    let cs: VcClaims = w.cs;
    let fl: VcFlow = w.fl;
    let pc: i64 = fl.block_pc[bi];
    let op: i64 = inst.op;
    if inst.id >= 0 { w.dvs[inst.id as u64] = inst.dv; }
    // Unit carries no value: a Unit constant, Phi or Upsilon defines nothing.
    if op == IOP_CONST_UNIT() || (op == IOP_PHI() && inst.ty == ITY_UNIT()) {
        return;
    }
    if op == IOP_UPSILON() && w.tys[inst.args[0] as u64] == ITY_UNIT() {
        return;
    }
    // Region markers only scope an allocation's lifetime; they change no value.
    if op == IOP_REGION_OPEN() || op == IOP_REGION_CLOSE() {
        return;
    }
    // A consume discharges an ownership obligation the type checker enforced; the
    // value it names is read as any other aggregate and stays readable.
    if op == IOP_LINEAR_CONSUME() {
        return;
    }
    if vc_inst_scalar_kind(inst) == VC_SCALAR_HASH_U64() {
        vc_define(w, inst, vc_num_hash_mix(cs.arena, w.var_of[inst.args[0] as u64]));
        return;
    }
    if vc_walk_narrow(w, bi, inst) || vc_walk_agg(w, bi, inst) || vc_walk_vec(w, bi, inst, pc) || vc_walk_map(w, bi, inst, pc) {
        return;
    }
    if op == IOP_PHI() {
        vc_define(w, inst, vc_flow_phi_value(fl, cs.arena, bi, inst.id));
    } else if op == IOP_UPSILON() {
        vc_flow_add_upsilon(fl, inst.dv, bi as i64, w.var_of[inst.args[0] as u64]);
    } else if op == IOP_VOW_REQ() || op == IOP_VOW_ENS() || op == IOP_VOW_INV() {
        vc_walk_clause(w, inst, pc);
    } else if op == IOP_JUMP() {
        vc_flow_jump(fl, bi, succ[bi * 2] as u64);
    } else if op == IOP_BRANCH() {
        let cond: i64 = w.var_of[inst.args[0] as u64];
        vc_flow_branch(fl, cs.arena, cs.header, bi, cond, succ[bi * 2] as u64, succ[bi * 2 + 1] as u64);
    } else if vc_is_havoc(inst) {
        let name: String = String::from("h");
        name.push_str(i64_to_string(inst.id));
        vc_define(w, inst, vc_agg_declare(cs.arena, cs.header, name, vc_ty_sort(inst.ty)));
    } else if vc_is_havoc_vec(inst) {
        let obj: i64 = w.obj_of[inst.args[0] as u64];
        let slot: i64 = vc_vec_slot(w.vv, w.ag, cs.arena, cs.header, cs.assumed, obj);
        let entry_len: i64 = vc_vec_cur_len(w.vv, slot, bi as i64);
        vc_vec_havoc(w.vv, w.ag, cs.arena, cs.header, cs.assumed, obj, bi as i64);
        if inst.dv == 1 {
            let grown: i64 = vc_vec_cur_len(w.vv, slot, bi as i64);
            vc_assume(cs, pc, vc_tm_app2(cs.arena, VC_OP_BVULE(), entry_len, grown));
        }
    } else if vc_is_havoc_map(inst) {
        vc_map_havoc(w.mp, w.ag, cs.arena, cs.header, cs.assumed, w.obj_of[inst.args[0] as u64], bi as i64);
    } else if vc_is_unwrap_abort(inst) {
        vc_guard(cs, VC_CLAIM_UNWRAP_NONE(), VC_LABEL_UNWRAP_NONE(), pc, vc_tm_bool_const(cs.arena, false), inst);
    } else if vc_is_unwind_sink(inst) {
        vc_add_claim(cs, VC_CLAIM_UNWIND(), -1, VC_LABEL_UNWIND(), pc, vc_tm_bool_const(cs.arena, false), inst.ostart, inst.olen, -1);
    } else if op != IOP_RETURN() && op != IOP_UNREACHABLE() {
        vc_define(w, inst, vc_exec_value(w, inst, pc));
    }
}

// True when a parameter or a value of the function is a float: its query needs
// the floating-point theory.
fn vc_function_has_float(f: IrFunction, tys: Vec<i64>) -> bool {
    let mut i: u64 = 0;
    while i < f.params.len() {
        if vc_ty_is_float(f.params[i]) { return true; }
        i = i + 1;
    }
    let mut k: u64 = 0;
    while k < tys.len() {
        if vc_ty_is_float(tys[k]) { return true; }
        k = k + 1;
    }
    false
}

// The SMT-LIB logic of a query: bit-vectors, plus arrays when a `Vec` is
// modelled, plus floating point when a float is.
fn vc_logic_name(has_array: bool, has_float: bool, quantified: bool) -> String {
    if quantified && has_float { return String::from("ABVFP"); }
    if quantified { return String::from("ABV"); }
    if has_array && has_float { return String::from("QF_ABVFP"); }
    if has_array { return String::from("QF_ABV"); }
    if has_float { return String::from("QF_BVFP"); }
    String::from("QF_BV")
}

// Obligations for a function inside the native subset, in walk order.
fn vc_claims(f: IrFunction) -> VcClaims {
    vc_claims_mode(f, vc_frames_new(), false)
}

// `vc_claims_step` with no hypothesis marking.
fn vc_claims_mode(f: IrFunction, fr: VcFrames, pre_only: bool) -> VcClaims {
    vc_claims_step(f, fr, pre_only, Vec::new())
}

// The same for the flattened function of a call tree: `fr` names the frames its
// markers refer to, `pre_only` demotes every claim but the callees'
// preconditions and the unwinding claim. `hyp` is the hypothesis marking of a
// step function (`vc_unroll_step`), one 0/1 per block: the claims of a block
// marked 1 are not asked, only assumed, and the function's own `invariant`s are
// assumed once asked. Empty for every other function.
fn vc_claims_step(f: IrFunction, fr: VcFrames, pre_only: bool, hyp: Vec<i64>) -> VcClaims {
    let ar: VcArena = vc_arena_new();
    let hdr: SmtScript = vc_script_new();
    let assumed: Vec<i64> = Vec::new();
    let cs: VcClaims = VcClaims {
        arena: ar,
        header: hdr,
        assumed: assumed,
        kinds: Vec::new(),
        frames: Vec::new(),
        fr: fr,
        pre_only: pre_only,
        step: hyp.len() > 0,
        hyp_now: false,
        vow_ids: Vec::new(),
        labels: Vec::new(),
        ostarts: Vec::new(),
        olens: Vec::new(),
        negated_goals: Vec::new(),
        header_lens: Vec::new(),
        assumed_lens: Vec::new(),
        model_names: Vec::new(),
        model_params: Vec::new(),
        model_paths: Vec::new(),
        model_tys: Vec::new(),
        model_widths: Vec::new(),
        model_slots: Vec::new(),
        model_hdr: Vec::new(),
        model_ambig: Vec::new(),
        hook_vars: Vec::new(),
        vec_param: Vec::new(),
        vec_arr: Vec::new(),
        vec_len: Vec::new(),
        vec_hdr: Vec::new(),
        map_vars: Vec::new(),
        vec_wide: Vec::new(),
    };
    vc_script_set_logic(hdr, String::from("QF_BV"));
    vc_script_set_option(hdr, String::from(":produce-models"), String::from("true"));
    let mut pi: u64 = 0;
    while pi < f.params.len() {
        if f.params[pi] == ITY_BOOL() || vc_ty_is_int(f.params[pi]) || vc_ty_is_float(f.params[pi]) {
            cs.model_hdr.push(hdr.kinds.len() as i64);
            cs.model_slots.push(-1);
            vc_script_declare_const(hdr, vc_param_name(pi as i64), vc_ty_sort(f.params[pi]));
            cs.model_names.push(vc_param_name(pi as i64));
            cs.model_paths.push(String::from(""));
            cs.model_params.push(pi as i64);
            cs.model_tys.push(f.params[pi]);
            cs.model_widths.push(vc_ty_sort(f.params[pi]));
        }
        pi = pi + 1;
    }

    let tys: Vec<i64> = vc_ty_table(f);
    let nb: u64 = f.blocks.len();
    let fl: VcFlow = vc_flow_new(nb, tys.len());
    let w: VcWalk = VcWalk {
        cs: cs,
        fl: fl,
        ag: vc_agg_new(fl),
        vv: vc_vec_new_state(fl, nb),
        hp: vc_heap_new(),
        mp: vc_map_new_state(fl, nb),
        ov: vc_overlay_new(),
        var_of: dom_fill(tys.len(), -1),
        obj_of: dom_fill(tys.len(), -1),
        wslot: dom_fill(tys.len(), -1),
        wobj: dom_fill(tys.len(), -1),
        widx: dom_fill(tys.len(), -1),
        elem_obj: dom_fill(tys.len(), -1),
        bits_ty: dom_fill(tys.len(), -1),
        tys: tys,
        lits: vc_literal_table(f, tys),
        dvs: dom_fill(tys.len(), 0),
    };
    w.vv.content = vc_str_reads_bytes(f);
    vc_agg_enable_alias(w.ag, ar, hdr, vc_agg_alias_params(f, tys.len()));
    if vc_heap_overlay_needed(f, tys) {
        vc_overlay_enable(w.ov, w.ag, ar, hdr, cs.assumed, vc_overlay_params(f, tys, VC_OV_VEC()), vc_overlay_params(f, tys, VC_OV_STRING()), vc_overlay_params(f, tys, VC_OV_STRUCT()));
    }
    let id_to_idx: Vec<i64> = dom_block_id_table(f);
    let succ: Vec<i64> = dom_successors(f, id_to_idx);
    let order: Vec<i64> = dom_rpo_order(dom_rpo_numbers(nb, succ));

    let mut oi: u64 = 0;
    while oi < order.len() {
        let bi: u64 = order[oi] as u64;
        let mut live: bool = true;
        if bi == 0 {
            fl.block_pc[0] = vc_tm_bool_const(ar, true);
        } else {
            live = vc_flow_enter(fl, ar, hdr, bi);
            if live {
                vc_vec_enter(w.vv, ar, hdr, bi);
                vc_map_enter(w.mp, ar, hdr, bi);
            }
        }
        if live {
            cs.hyp_now = bi < hyp.len() && hyp[bi] == 1;
            let blk: IrBlock = f.blocks[bi];
            let mut ii: u64 = 0;
            while ii < blk.insts.len() {
                let inst: IrInst = blk.insts[ii];
                vc_walk_inst(w, bi, inst, succ);
                ii = ii + 1;
            }
        }
        oi = oi + 1;
    }
    vc_claims_harvest_fields(cs, w.ag, w.vv, w.ov);
    cs.hook_vars = w.vv.hk_vars;
    cs.map_vars = vc_map_inexact_vars(w.mp);
    vc_script_replace_logic(hdr, vc_logic_name(vc_vec_count(w.vv) > 0 || vc_heap_used(w.hp) || vc_map_count(w.mp) > 0, vc_function_has_float(f, tys), w.vv.quantified));
    cs
}
