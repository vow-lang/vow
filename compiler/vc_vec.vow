module VcVec

use ir
use ir_dominance
use vc_ops
use vc_strops
use vc_term
use vc_smt
use vc_int
use vc_flow
use vc_agg

// Model of `Vec<T>` (T = Bool or an integer of at most 64 bits) for the native
// verifier: an SMT array from 64-bit indices to 64-bit elements plus a 64-bit
// symbolic length. There is no capacity limit of the verifier's making. The
// only length fact is the runtime's own representation invariant: a Vec's
// capacity word keeps its value in 63 bits and `set_vow_vec_capacity` traps for
// a capacity of `VOW_CAP_VALUE_MASK` (2^63 - 1) or more, and the length never
// exceeds the capacity, so every length is below that mask. A parameter's length
// is an unconstrained constant under this invariant, and `push` assumes the
// new length stays within it, which is the path on which the runtime itself
// traps (`Vec::reserve`) and never returns. An element is stored as the 8-byte
// slot the runtime keeps: sign-extended for a signed type, zero-extended for an
// unsigned one or Bool.
//
// A Vec value is a `vc_agg` object, so pointers stay out of the term language;
// this module keeps the `(array, length)` pair of every such object per block.
// Unlike a struct, a Vec is mutated in many blocks, so the state is
// flow-sensitive: entering a block merges the exit states of its live in-edges
// with the same `ite` chain a Phi uses (`vc_flow`), and every write replaces
// the state of the block being walked. The state is never inherited from the
// block walked before, only from edges. A block that is not reached is never
// entered, so it contributes nothing.

struct VcVec {
    fl: VcFlow,
    n_blocks: u64,
    slot_of: Vec<i64>,
    kinds: Vec<i64>,
    base_arr: Vec<i64>,
    base_len: Vec<i64>,
    arr: Vec<i64>,
    len: Vec<i64>,
    names: i64,
    // `String` model (`vc_str`): `content` is set when some instruction reads the
    // bytes of a string, `quantified` when a `VC_T_QEQ` was built (the query then
    // leaves the quantifier-free logic), `lit_text[s]` is the text of slot `s` when
    // it is a string literal's static bytes, "" otherwise. `memo_*` map the four
    // operand terms of a built array (an append or a substring) to the array
    // already built from them: one function never builds the same contents twice.
    content: bool,
    quantified: bool,
    lit_text: Vec<String>,
    memo_key: Vec<i64>,
    memo_arr: Vec<i64>,
    // Float-text hooks (`vc_hooks`): the earlier `parse_f64_bits` calls (operand
    // `(array, length)` terms and result) and `format_f64_bits` calls (operand bits
    // and result `(array, length)`), and every constant a hook declared.
    pk_arr: Vec<i64>,
    pk_len: Vec<i64>,
    pk_res: Vec<i64>,
    fk_bits: Vec<i64>,
    fk_arr: Vec<i64>,
    fk_len: Vec<i64>,
    hk_vars: Vec<i64>,
    // `app_at[r]` is the offset in `app_ops` of the `(sa, sl, ta, tl)` operands of the
    // append that built array term `r`, -1 when it was not built by one (`vc_strdeep`).
    app_at: Vec<i64>,
    app_ops: Vec<i64>,
    // `contains` calls already encoded (`vc_strsearch`): the four operand terms and the Bool
    // term that is the result.
    cn_key: Vec<i64>,
    cn_res: Vec<i64>,
    // Decimal formatter calls already encoded (`vc_numeric`): the operand term and its
    // signedness (two words per call) and the `(array, length)` terms of the result.
    dc_key: Vec<i64>,
    dc_arr: Vec<i64>,
    dc_len: Vec<i64>,
    // `hash_str`, `hex_encode` and `hex_decode` calls already encoded (`vc_strfold`): the kind and
    // the two operand terms (three words per call) and the result, an `(array, length)` pair
    // (the hash term and -1 for `hash_str`).
    fm_key: Vec<i64>,
    fm_arr: Vec<i64>,
    fm_len: Vec<i64>,
    // Opaque total functions (`vc_hooks`): per call the function key, the operand `(array, length)`
    // terms and the two result terms (the Some flag and payload of a `parse_*`, or the `(array,
    // length)` of a text).
    ox_fn: Vec<i64>,
    ox_arr: Vec<i64>,
    ox_len: Vec<i64>,
    ox_r0: Vec<i64>,
    ox_r1: Vec<i64>,
    // The `Vec` and `String` parameters, in the order the walk first read them:
    // the parameter index, the names of the array and length constants, and the
    // header position of the length declaration. A counterexample reads them back
    // (`vc_vecmodel`).
    pv_param: Vec<i64>,
    pv_arr: Vec<String>,
    pv_len: Vec<String>,
    pv_hdr: Vec<i64>,
    // The element type of each of those parameters whose elements the function reads
    // or writes as something other than a raw 64-bit slot: `ITY_I128`/`ITY_U128`
    // (`vc_wide`) or `ITY_F32`/`ITY_F64` (`vc_fp`), else -1.
    pv_wide: Vec<i64>,
}

fn vc_vec_new_state(fl: VcFlow, n_blocks: u64) -> VcVec {
    VcVec {
        fl: fl,
        n_blocks: n_blocks,
        slot_of: Vec::new(),
        kinds: Vec::new(),
        base_arr: Vec::new(),
        base_len: Vec::new(),
        arr: Vec::new(),
        len: Vec::new(),
        names: 0,
        content: false,
        quantified: false,
        lit_text: Vec::new(),
        memo_key: Vec::new(),
        memo_arr: Vec::new(),
        pk_arr: Vec::new(),
        pk_len: Vec::new(),
        pk_res: Vec::new(),
        fk_bits: Vec::new(),
        fk_arr: Vec::new(),
        fk_len: Vec::new(),
        hk_vars: Vec::new(),
        app_at: Vec::new(),
        app_ops: Vec::new(),
        cn_key: Vec::new(),
        cn_res: Vec::new(),
        dc_key: Vec::new(),
        dc_arr: Vec::new(),
        dc_len: Vec::new(),
        fm_key: Vec::new(),
        fm_arr: Vec::new(),
        fm_len: Vec::new(),
        ox_fn: Vec::new(),
        ox_arr: Vec::new(),
        ox_len: Vec::new(),
        ox_r0: Vec::new(),
        ox_r1: Vec::new(),
        pv_param: Vec::new(),
        pv_arr: Vec::new(),
        pv_len: Vec::new(),
        pv_hdr: Vec::new(),
        pv_wide: Vec::new(),
    }
}

// Number of Vec objects the function created or read; 0 keeps the query in the
// plain bit-vector logic.
fn vc_vec_count(vv: VcVec) -> u64 {
    vv.kinds.len()
}

fn vc_vec_fresh_name(vv: VcVec, prefix: String) -> String {
    let name: String = String::from(prefix);
    name.push_str(i64_to_string(vv.names));
    vv.names = vv.names + 1;
    name
}

// A new slot for object `obj`; its states are absent in every block.
fn vc_vec_push_slot(vv: VcVec, obj: i64, kind: i64) -> i64 {
    while vv.slot_of.len() as i64 <= obj {
        vv.slot_of.push(-1);
    }
    let s: i64 = vv.kinds.len() as i64;
    vv.slot_of[obj as u64] = s;
    vv.kinds.push(kind);
    vv.base_arr.push(-1);
    vv.base_len.push(-1);
    vv.lit_text.push(String::from(""));
    let mut k: u64 = 0;
    while k < vv.n_blocks {
        vv.arr.push(-1);
        vv.len.push(-1);
        k = k + 1;
    }
    s
}

fn vc_vec_pos(vv: VcVec, s: i64, bi: i64) -> u64 {
    s as u64 * vv.n_blocks + bi as u64
}

// The slot of `obj`, created on first use. A parameter starts as an
// unconstrained array and length, valid in every block; an object nothing
// created (the gate does not let one through) is treated the same way, which
// only loses precision. A new slot's length fact (a runtime Vec's length is
// below the capacity mask) is appended to `assumed`, to hold on every path.
fn vc_vec_slot(vv: VcVec, ag: VcAgg, ar: VcArena, hdr: SmtScript, assumed: Vec<i64>, obj: i64) -> i64 {
    if (obj as u64) < vv.slot_of.len() && vv.slot_of[obj as u64] >= 0 {
        return vv.slot_of[obj as u64];
    }
    let kind: i64 = ag.kinds[obj as u64];
    let s: i64 = vc_vec_push_slot(vv, obj, kind);
    let prefix: String = {
        if kind == VC_OBJ_PARAM() {
            let p: String = String::from("p");
            p.push_str(i64_to_string(ag.owners[obj as u64]));
            p
        } else {
            vc_vec_fresh_name(vv, String::from("vo"))
        }
    };
    let a_name: String = String::from(prefix);
    a_name.push_str(String::from("_varr"));
    let l_name: String = String::from(prefix);
    l_name.push_str(String::from("_vlen"));
    vv.base_arr[s as u64] = vc_agg_declare(ar, hdr, a_name, VC_SORT_ARRAY64());
    let len_hdr: i64 = hdr.kinds.len() as i64;
    let len: i64 = vc_agg_declare(ar, hdr, l_name, 64);
    vv.base_len[s as u64] = len;
    if kind == VC_OBJ_PARAM() {
        vv.pv_param.push(ag.owners[obj as u64]);
        vv.pv_arr.push(a_name);
        vv.pv_len.push(l_name);
        vv.pv_hdr.push(len_hdr);
        vv.pv_wide.push(-1);
    }
    assumed.push(vc_tm_app2(ar, VC_OP_BVULT(), len, vc_vec_len_mask(ar)));
    s
}

// Records that the function reads or writes the elements of `obj` as `ty` (a 128-bit
// integer or a float): a counterexample then lists them as values of that type. Only
// a parameter's contents are ever listed.
fn vc_vec_mark_elem(vv: VcVec, ag: VcAgg, obj: i64, ty: i64) {
    if ag.kinds[obj as u64] != VC_OBJ_PARAM() { return; }
    let mut j: u64 = 0;
    while j < vv.pv_param.len() {
        if vv.pv_param[j] == ag.owners[obj as u64] { vv.pv_wide[j] = ty; }
        j = j + 1;
    }
}

// A `Vec::new()` result: length 0, contents unconstrained (readable only behind
// the bounds claim, which fails for any index at length 0).
fn vc_vec_create(vv: VcVec, ag: VcAgg, ar: VcArena, hdr: SmtScript, obj: i64, bi: i64) {
    let s: i64 = vc_vec_push_slot(vv, obj, VC_OBJ_ALLOC());
    let name: String = vc_vec_fresh_name(vv, String::from("vc"));
    name.push_str(String::from("_varr"));
    let p: u64 = vc_vec_pos(vv, s, bi);
    vv.arr[p] = vc_agg_declare(ar, hdr, name, VC_SORT_ARRAY64());
    vv.len[p] = vc_tm_bv(ar, 64, 0, 0);
}

// Forgets the state of `obj` in block `bi`: an arbitrary array and an arbitrary
// length below the capacity mask. The loop cut puts this at the top of a header
// proper for a Vec the loop writes.
fn vc_vec_havoc(vv: VcVec, ag: VcAgg, ar: VcArena, hdr: SmtScript, assumed: Vec<i64>, obj: i64, bi: i64) {
    let s: i64 = vc_vec_slot(vv, ag, ar, hdr, assumed, obj);
    let prefix: String = vc_vec_fresh_name(vv, String::from("vh"));
    let a_name: String = String::from(prefix);
    a_name.push_str(String::from("_varr"));
    let l_name: String = String::from(prefix);
    l_name.push_str(String::from("_vlen"));
    let arr: i64 = vc_agg_declare(ar, hdr, a_name, VC_SORT_ARRAY64());
    let len: i64 = vc_agg_declare(ar, hdr, l_name, 64);
    assumed.push(vc_tm_app2(ar, VC_OP_BVULT(), len, vc_vec_len_mask(ar)));
    vc_vec_write(vv, ar, hdr, s, bi, arr, len);
}

// A new object holding the given `(array, length)`: a string clone, a
// substring, a literal.
fn vc_vec_create_with(vv: VcVec, ar: VcArena, hdr: SmtScript, obj: i64, bi: i64, arr: i64, len: i64) -> i64 {
    let s: i64 = vc_vec_push_slot(vv, obj, VC_OBJ_ALLOC());
    vc_vec_write(vv, ar, hdr, s, bi, arr, len);
    s
}

// Current array and length of slot `s` in block `bi`. A parameter that no
// block of the path wrote is its initial state; an allocation absent here was
// never created on this path, which dominance rules out (the gate validates
// it), so its unconstrained base is a safe answer.
fn vc_vec_cur_arr(vv: VcVec, s: i64, bi: i64) -> i64 {
    let a: i64 = vv.arr[vc_vec_pos(vv, s, bi)];
    if a >= 0 { return a; }
    vv.base_arr[s as u64]
}

fn vc_vec_cur_len(vv: VcVec, s: i64, bi: i64) -> i64 {
    let l: i64 = vv.len[vc_vec_pos(vv, s, bi)];
    if l >= 0 { return l; }
    vv.base_len[s as u64]
}

fn vc_vec_write(vv: VcVec, ar: VcArena, hdr: SmtScript, s: i64, bi: i64, arr: i64, len: i64) {
    let p: u64 = vc_vec_pos(vv, s, bi);
    vv.arr[p] = vc_flow_name(vv.fl, ar, hdr, VC_SORT_ARRAY64(), arr);
    vv.len[p] = vc_flow_name(vv.fl, ar, hdr, 64, len);
}

// Entry state of every slot in block `bi`, from its live in-edges: the same
// `ite` chain as `vc_flow_phi_value` (first edge is the base, later edges wrap
// it). An edge that carries no state for a parameter slot carries its initial
// state; for an allocation it carries nothing and is skipped.
fn vc_vec_enter(vv: VcVec, ar: VcArena, hdr: SmtScript, bi: u64) {
    let fl: VcFlow = vv.fl;
    let n: u64 = vv.kinds.len();
    let mut s: u64 = 0;
    while s < n {
        let mut acc_a: i64 = -1;
        let mut acc_l: i64 = -1;
        let mut e: i64 = fl.in_head[bi];
        while e >= 0 {
            let src: i64 = fl.e_src[e as u64];
            let p: u64 = vc_vec_pos(vv, s as i64, src);
            let mut a: i64 = vv.arr[p];
            let mut l: i64 = vv.len[p];
            if a < 0 && vv.kinds[s] == VC_OBJ_PARAM() {
                a = vv.base_arr[s];
                l = vv.base_len[s];
            }
            if a >= 0 {
                if acc_a < 0 {
                    acc_a = a;
                    acc_l = l;
                } else {
                    let c: i64 = fl.e_cond[e as u64];
                    if a != acc_a { acc_a = vc_tm_app3(ar, VC_OP_ITE(), c, a, acc_a); }
                    if l != acc_l { acc_l = vc_tm_app3(ar, VC_OP_ITE(), c, l, acc_l); }
                }
            }
            e = fl.e_next[e as u64];
        }
        if acc_a >= 0 {
            vc_vec_write(vv, ar, hdr, s as i64, bi as i64, acc_a, acc_l);
        }
        s = s + 1;
    }
}

// A pushed or stored value as the 64-bit slot the runtime keeps.
fn vc_vec_elem64(ar: VcArena, ty: i64, t: i64) -> i64 {
    if ty == ITY_BOOL() {
        return vc_tm_app3(ar, VC_OP_ITE(), t, vc_tm_bv(ar, 64, 1, 0), vc_tm_bv(ar, 64, 0, 0));
    }
    vc_cast(ar, ty, ITY_I64(), t)
}

// `VOW_CAP_VALUE_MASK`: every length of a runtime Vec is below it.
fn vc_vec_len_mask(ar: VcArena) -> i64 {
    vc_tm_bv(ar, 64, 9223372036854775807, 0)
}

// `idx < len` as unsigned 64-bit values: a negative `i64` index is a huge
// unsigned one, so one comparison covers both.
fn vc_vec_in_bounds(ar: VcArena, idx: i64, len: i64) -> i64 {
    vc_tm_app2(ar, VC_OP_BVULT(), idx, len)
}

// A returning `push` leaves the length below the mask: a push that would
// reach it is the runtime's capacity trap, which never returns.
fn vc_vec_push_guard(ar: VcArena, len: i64) -> i64 {
    vc_tm_app2(ar, VC_OP_BVULT(), len, vc_tm_bv(ar, 64, 9223372036854775806, 0))
}

fn vc_vec_push(vv: VcVec, ar: VcArena, hdr: SmtScript, s: i64, bi: i64, elem: i64) {
    let arr: i64 = vc_vec_cur_arr(vv, s, bi);
    let len: i64 = vc_vec_cur_len(vv, s, bi);
    let stored: i64 = vc_tm_app3(ar, VC_OP_STORE(), arr, len, elem);
    let next: i64 = vc_tm_app2(ar, VC_OP_BVADD(), len, vc_tm_bv(ar, 64, 1, 0));
    vc_vec_write(vv, ar, hdr, s, bi, stored, next);
}

fn vc_vec_set(vv: VcVec, ar: VcArena, hdr: SmtScript, s: i64, bi: i64, idx: i64, elem: i64) {
    let arr: i64 = vc_vec_cur_arr(vv, s, bi);
    let len: i64 = vc_vec_cur_len(vv, s, bi);
    vc_vec_write(vv, ar, hdr, s, bi, vc_tm_app3(ar, VC_OP_STORE(), arr, idx, elem), len);
}

// `pop` drops the last element when there is one, like the runtime.
fn vc_vec_pop(vv: VcVec, ar: VcArena, hdr: SmtScript, s: i64, bi: i64) {
    let arr: i64 = vc_vec_cur_arr(vv, s, bi);
    let len: i64 = vc_vec_cur_len(vv, s, bi);
    let zero: i64 = vc_tm_bv(ar, 64, 0, 0);
    let dec: i64 = vc_tm_app2(ar, VC_OP_BVSUB(), len, vc_tm_bv(ar, 64, 1, 0));
    let next: i64 = vc_tm_app3(ar, VC_OP_ITE(), vc_tm_app2(ar, VC_OP_EQ(), len, zero), zero, dec);
    vc_vec_write(vv, ar, hdr, s, bi, arr, next);
}

// True when a Phi that an object pointer (`is_obj[id] == 1`) feeds, or that reads
// one, is supplied two different values: a differing merge would be two model
// objects for one runtime object. `sup` is the one value a Phi gets (-1 none
// yet). Marks every Phi and value it links as an object, iterated since a Phi
// can feed another Phi. Shared by the `Vec` and map gates.
fn vc_phi_merges_objects(f: IrFunction, is_obj: Vec<i64>, n_ids: u64) -> bool {
    let sup: Vec<i64> = dom_fill(n_ids, -1);
    let mut changed: bool = true;
    while changed {
        changed = false;
        let mut bi: u64 = 0;
        while bi < f.blocks.len() {
            let blk: IrBlock = f.blocks[bi];
            let mut ii: u64 = 0;
            while ii < blk.insts.len() {
                let inst: IrInst = blk.insts[ii];
                if inst.op == IOP_UPSILON() && inst.args.len() == 1 {
                    let phi: u64 = inst.dv as u64;
                    let val: u64 = inst.args[0] as u64;
                    if is_obj[phi] == 1 || is_obj[val] == 1 {
                        if sup[phi] == -1 {
                            sup[phi] = inst.args[0];
                        } else if sup[phi] != inst.args[0] {
                            return true;
                        }
                        if is_obj[phi] != 1 || is_obj[val] != 1 {
                            is_obj[phi] = 1;
                            is_obj[val] = 1;
                            changed = true;
                        }
                    }
                }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
    }
    false
}

fn vc_vec_any_arg(inst: IrInst, is_vec: Vec<i64>) -> bool {
    let mut k: u64 = 0;
    while k < inst.args.len() {
        if is_vec[inst.args[k] as u64] == 1 { return true; }
        k = k + 1;
    }
    false
}

// Gate rule: a Vec lives only in its own function, as an object no other
// instruction can alias. A pointer used by a Vec operation must not also be a
// struct (`FieldGet`/`FieldSet`) or be passed to a user call, and a Phi may
// merge Vec pointers only when every `Upsilon` feeding it supplies the same
// value; a differing merge would be two model objects for one runtime Vec. ""
// when the shape is fine, else the detail of an `unsupported-opcode` skip.
fn vc_vec_shape_detail(f: IrFunction, n_ids: u64, calls: bool) -> String {
    let is_vec: Vec<i64> = dom_fill(n_ids, 0);
    let mut any: bool = false;
    let mut bi: u64 = 0;
    while bi < f.blocks.len() {
        let blk: IrBlock = f.blocks[bi];
        let mut ii: u64 = 0;
        while ii < blk.insts.len() {
            let inst: IrInst = blk.insts[ii];
            let k: i64 = vc_inst_vec_kind(inst);
            if k != VC_VEC_NONE() {
                any = true;
                if k == VC_VEC_NEW() || k == VC_VEC_SORT() || vc_str_kind_creates(k) {
                    if inst.id >= 0 { is_vec[inst.id as u64] = 1; }
                }
                // The operands of a creating call are integers (`new`) or the
                // static bytes of a literal, which is not an object.
                if k != VC_VEC_NEW() && !vc_str_kind_no_object_operand(k) && inst.args.len() > 0 {
                    is_vec[inst.args[0] as u64] = 1;
                    if vc_str_kind_two_strings(k) && inst.args.len() > 1 { is_vec[inst.args[1] as u64] = 1; }
                }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    if !any { return String::from(""); }
    if vc_phi_merges_objects(f, is_vec, n_ids) { return String::from("Vec merged by a Phi"); }
    bi = 0;
    while bi < f.blocks.len() {
        let blk: IrBlock = f.blocks[bi];
        let mut ii: u64 = 0;
        while ii < blk.insts.len() {
            let inst: IrInst = blk.insts[ii];
            if inst.op == IOP_FIELD_GET() || inst.op == IOP_FIELD_SET() {
                if is_vec[inst.args[0] as u64] == 1 {
                    return String::from("Vec used as a struct");
                }
            }
            if inst.op == IOP_CALL() && vc_vec_any_arg(inst, is_vec) {
                if inst.dk == IDATA_CALL_TARGET() && !calls { return String::from("Vec passed to a call"); }
                if inst.dk == IDATA_CALL_EXTERN() && vc_inst_vec_kind(inst) == VC_VEC_NONE() {
                    return String::from("Vec passed to an unmodelled builtin");
                }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    String::from("")
}
