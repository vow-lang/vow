module ConstFold

use ir

// Constant folding of integer instructions for the verifier model. Mirrors
// vow-verify/src/const_fold.rs; both emitters must fold identically.

fn fold_is_unsigned(ty: i64) -> bool {
    ty == ITY_U8() || ty == ITY_U16() || ty == ITY_U32() || ty == ITY_U64()
}

// Width in bits of an integer IR type the constant folder understands; 0 for
// anything else (128-bit, floats, pointers), which is never folded.
fn fold_width(ty: i64) -> i64 {
    if ty == ITY_I8() || ty == ITY_U8() { return 8; }
    if ty == ITY_I16() || ty == ITY_U16() { return 16; }
    if ty == ITY_I32() || ty == ITY_U32() { return 32; }
    if ty == ITY_I64() || ty == ITY_U64() { return 64; }
    0
}

// Wrap a 64-bit pattern into the value range of `ty` (sign-extended when
// signed, zero-extended when unsigned). Mirrors `normalize_const_bits` in
// vow-verify/src/c_emitter.rs.
fn fold_normalize(bits: i64, ty: i64) -> i64 {
    let w: i64 = fold_width(ty);
    if w == 0 || w >= 64 { return bits; }
    let p: i64 = { if w == 8 { 256 } else { if w == 16 { 65536 } else { 4294967296 } } };
    let r: i64 = ((bits % p) + p) % p;
    if fold_is_unsigned(ty) { return r; }
    if r >= p / 2 { return r - p; }
    r
}

fn fold_is_leaf(inst: IrInst) -> bool {
    if fold_width(inst.ty) == 0 { return false; }
    inst.op == IOP_CONST_I32() || inst.op == IOP_CONST_I64() || inst.op == IOP_CONST_U64() || inst.op == IOP_CONST_U8()
}

// 0 add, 1 sub, 2 mul; -1 for any other opcode.
fn fold_arith_kind(op: i64) -> i64 {
    if op == IOP_WADD() || op == IOP_CADD() { return 0; }
    if op == IOP_WSUB() || op == IOP_CSUB() { return 1; }
    if op == IOP_WMUL() || op == IOP_CMUL() { return 2; }
    0 - 1
}

fn fold_wrap(kind: i64, a: i64, b: i64) -> i64 {
    if kind == 0 { return a + b; }
    if kind == 1 { return a - b; }
    a * b
}

// True when the checked operator `kind` on `a`, `b` (type-normalized patterns)
// does not overflow `ty`; an overflowing execution aborts, so no value flows on.
fn fold_checked_ok(kind: i64, a: i64, b: i64, ty: i64) -> bool {
    let r: i64 = fold_wrap(kind, a, b);
    let mut exact: bool = true;
    if fold_is_unsigned(ty) {
        let ua: u64 = a as u64;
        let ub: u64 = b as u64;
        let ur: u64 = r as u64;
        if kind == 0 {
            exact = ur >= ua;
        } else if kind == 1 {
            exact = ua >= ub;
        } else if ua != 0u64 && ub != 0u64 {
            exact = ur / ua == ub;
        }
    } else {
        let max: i64 = 9223372036854775807;
        let min: i64 = 0 - 9223372036854775807 - 1;
        if kind == 0 {
            exact = !((b > 0 && a > max - b) || (b < 0 && a < min - b));
        } else if kind == 1 {
            exact = !((b < 0 && a > max + b) || (b > 0 && a < min + b));
        } else if a != 0 && b != 0 {
            if (a == 0 - 1 && b == min) || (b == 0 - 1 && a == min) {
                exact = false;
            } else {
                exact = r / b == a;
            }
        }
    }
    exact && fold_normalize(r, ty) == r
}

fn fold_known(known: Vec<i64>, id: i64) -> bool {
    id >= 0 && id < known.len() as i64 && known[id as u64] == 1
}

// Constant integer value (as a 64-bit pattern normalized to the instruction's
// type) of every instruction that provably always computes one: literals,
// wrapping and checked + - * over constants, integer casts of constants, and a
// Phi whose every Upsilon carries the same constant. Facts only grow from known
// operands, so the fixpoint is sound and cyclic phis stay unknown. Mirrors
// `fold_const_bits` in vow-verify/src/c_emitter.rs.
//
// Result is indexed by instruction id. A pattern >= 2^63 saturates to i64::MAX
// so every entry that is not -1 compares correctly against a model capacity.
// -1 marks an instruction that is not a provable integer constant.
fn build_const_len_by_id(f: IrFunction) -> Vec<i64> {
    let blocks: Vec<IrBlock> = f.blocks;
    let known: Vec<i64> = Vec::new();
    let bits: Vec<i64> = Vec::new();
    let ups_phi: Vec<i64> = Vec::new();
    let ups_src: Vec<i64> = Vec::new();
    let mut bi: u64 = 0u64;
    while bi < blocks.len() {
        let blk: IrBlock = blocks[bi];
        let insts: Vec<IrInst> = blk.insts;
        let mut ii: u64 = 0u64;
        while ii < insts.len() {
            let inst: IrInst = insts[ii];
            if inst.id >= 0 {
                while known.len() as i64 <= inst.id {
                    known.push(0);
                    bits.push(0);
                }
            }
            if inst.op == IOP_UPSILON() && inst.dk == IDATA_PHI_TARGET() {
                let uargs: Vec<i64> = inst.args;
                if uargs.len() > 0 {
                    ups_phi.push(inst.dv);
                    ups_src.push(uargs[0]);
                }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    let n: i64 = known.len() as i64;
    let mut changed: bool = true;
    while changed {
        changed = false;
        bi = 0u64;
        while bi < blocks.len() {
            let blk: IrBlock = blocks[bi];
            let insts: Vec<IrInst> = blk.insts;
            let mut ii: u64 = 0u64;
            while ii < insts.len() {
                let inst: IrInst = insts[ii];
                if inst.id >= 0 && known[inst.id as u64] == 0 {
                    let iargs: Vec<i64> = inst.args;
                    let kind: i64 = fold_arith_kind(inst.op);
                    let mut value: i64 = 0;
                    let mut folded: bool = false;
                    if fold_is_leaf(inst) {
                        value = fold_normalize(inst.dv, inst.ty);
                        folded = true;
                    } else if kind >= 0 && fold_width(inst.ty) != 0 && iargs.len() >= 2 {
                        if fold_known(known, iargs[0]) && fold_known(known, iargs[1]) {
                            let a: i64 = bits[iargs[0] as u64];
                            let b: i64 = bits[iargs[1] as u64];
                            let checked: bool = inst.op == IOP_CADD() || inst.op == IOP_CSUB() || inst.op == IOP_CMUL();
                            if !checked || fold_checked_ok(kind, a, b, inst.ty) {
                                value = fold_normalize(fold_wrap(kind, a, b), inst.ty);
                                folded = true;
                            }
                        }
                    } else if inst.op == IOP_INT_CAST() && fold_width(inst.ty) != 0 && iargs.len() >= 1 {
                        if fold_known(known, iargs[0]) {
                            value = fold_normalize(bits[iargs[0] as u64], inst.ty);
                            folded = true;
                        }
                    }
                    if folded {
                        known[inst.id as u64] = 1;
                        bits[inst.id as u64] = value;
                        changed = true;
                    }
                }
                ii = ii + 1;
            }
            bi = bi + 1;
        }
        let seen: Vec<i64> = Vec::new();
        let first: Vec<i64> = Vec::new();
        let bad: Vec<i64> = Vec::new();
        let mut k: i64 = 0;
        while k < n {
            seen.push(0);
            first.push(0);
            bad.push(0);
            k = k + 1;
        }
        let mut ui: u64 = 0u64;
        while ui < ups_phi.len() {
            let p: i64 = ups_phi[ui];
            let s: i64 = ups_src[ui];
            if p >= 0 && p < n {
                if !fold_known(known, s) {
                    bad[p as u64] = 1;
                } else if seen[p as u64] == 0 {
                    seen[p as u64] = 1;
                    first[p as u64] = bits[s as u64];
                } else if first[p as u64] != bits[s as u64] {
                    bad[p as u64] = 1;
                }
            }
            ui = ui + 1;
        }
        k = 0;
        while k < n {
            if seen[k as u64] == 1 && bad[k as u64] == 0 && known[k as u64] == 0 {
                known[k as u64] = 1;
                bits[k as u64] = first[k as u64];
                changed = true;
            }
            k = k + 1;
        }
    }
    let const_len_by_id: Vec<i64> = Vec::new();
    let mut ri: i64 = 0;
    while ri < n {
        if known[ri as u64] == 1 {
            const_len_by_id.push({ if bits[ri as u64] < 0 { 9223372036854775807 } else { bits[ri as u64] } });
        } else {
            const_len_by_id.push(0 - 1);
        }
        ri = ri + 1;
    }
    const_len_by_id
}

// A constant length >= max (or a negative / >= 2^63 one) is outside the model
// capacity.
fn raw_parts_const_len_exceeds_model(const_len_by_id: Vec<i64>, len_arg: i64, max: i64) -> bool {
    if len_arg < 0 || len_arg >= const_len_by_id.len() as i64 {
        return false;
    }
    let v: i64 = const_len_by_id[len_arg as u64];
    v >= 0 && v >= max
}

fn len_is_const(const_len_by_id: Vec<i64>, len_arg: i64) -> bool {
    if len_arg < 0 || len_arg >= const_len_by_id.len() as i64 {
        return false;
    }
    const_len_by_id[len_arg as u64] >= 0
}

// True when the source pointer is provably the null constant, so the model's
// capacity assumption restricts nothing.
fn raw_parts_null_source(const_len_by_id: Vec<i64>, ptr_arg: i64) -> bool {
    if ptr_arg < 0 || ptr_arg >= const_len_by_id.len() as i64 {
        return false;
    }
    const_len_by_id[ptr_arg as u64] == 0
}
