module VcPayload

use ir
use ir_dominance
use vc_ops
use vc_gate
use vc_loops
use vc_heap
use vc_agg_shape
use vc_handle_phis

// An `Option`, `Result` or enum payload that is an object (`FieldGet[ptr]`) is a child of its
// parameter when the function only reads parameters (`vc_agg_child`): one object per slot, whose
// own fields are symbols. That model has no answer for two shapes, which the gate skips:
//
//   - the base is not a parameter or a payload (an `Option` the function built, or a merge of
//     parameters): there is no single parameter object to take a child of;
//   - the function writes a parameter beside the read: the payload may be the very object the
//     parameter names, and the child is a symbol of its own.
//
// The IR types a pointer loaded out of a struct field `i64`, a handle: an address, the object at
// it a function of it (`vc_heap`), the parameters and the objects the function stored laid over
// it (`vc_overlay`), which is exact for all three shapes and already decides them for a struct
// that holds a struct. `vc_retype_payload_reads` makes the payload read of such a function that
// same handle read: every `FieldGet[ptr]` becomes an `i64` read of the same slot, marked, and the
// Phis that merge only handles become handles (`vc_retype_handle_phis`). A function the child
// model accepts is left alone, so its model, counterexamples and cost do not change.
//
// The rewrite applies when
//   - every pointer read has a pointer base (a parameter, an allocation, a merge, a call result
//     or another payload), never a handle: the object at a handle is not a payload's;
//   - every use of a read is one the aggregate model understands (`vc_agg_read_use_ok`): a
//     payload that is a `Vec`, a `String` or a value stays skipped;
//   - the child gate rejects the function, for the base or for the aliasing of its parameters.
// A function that is rewritten then goes through the ordinary gate: a write through a payload,
// a payload stored in a field it is not the address of, or a returned payload the signature
// does not take is still skipped there.

// True when `f` has pointer reads and `vc_retype_payload_reads` retypes them.
fn vc_payload_applicable(f: IrFunction, n_ids: u64, tys: Vec<i64>) -> bool {
    let mut bi: u64 = 0;
    while bi < f.blocks.len() {
        let blk: IrBlock = f.blocks[bi];
        let mut ii: u64 = 0;
        while ii < blk.insts.len() {
            let inst: IrInst = blk.insts[ii];
            if vc_agg_is_ptr_read(inst) {
                if inst.args.len() != 1 || inst.args[0] < 0 || (inst.args[0] as u64) >= tys.len() || tys[inst.args[0] as u64] != ITY_PTR() {
                    return false;
                }
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    if !vc_agg_ptr_reads_used_ok(f, n_ids) { return false; }
    vc_agg_child_detail(f, n_ids).len() > 0
}

// `f` with its payload reads retyped to handle reads, or `f` itself when it has none to retype.
fn vc_retype_payload_reads(f: IrFunction) -> IrFunction {
    let mut reads: bool = false;
    let mut bi: u64 = 0;
    while bi < f.blocks.len() {
        let blk: IrBlock = f.blocks[bi];
        let mut ii: u64 = 0;
        while ii < blk.insts.len() {
            if vc_agg_is_ptr_read(blk.insts[ii]) { reads = true; }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    if !reads { return f; }
    let tys: Vec<i64> = vc_ty_table(f);
    if !vc_payload_applicable(f, tys.len(), tys) { return f; }
    let g: IrFunction = vc_function_shell(f);
    bi = 0;
    while bi < f.blocks.len() {
        let blk: IrBlock = f.blocks[bi];
        let out: IrBlock = ir_block_new(blk.id);
        let mut ii: u64 = 0;
        while ii < blk.insts.len() {
            let inst: IrInst = blk.insts[ii];
            if vc_agg_is_ptr_read(inst) {
                let handle: IrInst = vc_clone_inst(inst, inst.id, inst.args, inst.dv, inst.dv2);
                handle.ty = ITY_I64();
                handle.ds = vc_heap_payload_marker();
                out.insts.push(handle);
            } else {
                out.insts.push(inst);
            }
            ii = ii + 1;
        }
        g.blocks.push(out);
        bi = bi + 1;
    }
    vc_retype_handle_phis(g);
    g
}
