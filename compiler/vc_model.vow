module VcModel

use ir
use vc_int
use vc_smt
use vc_query
use vc_agg
use vc_vec
use vc_map
use vc_overlay
use vc_held
use vc_heap

// Parameter-model publication for native counterexamples. Scalar declarations register here
// before the walk; finish publishes lazily declared memory entries once the walk is complete.
// Query, counterexample and replay readers keep the VcClaims representation. This module owns
// its aligned rows, declaration-order merge, and cross-field ambiguity policy.

// One complete row; ambiguity is computed over the completed model by vc_model_finish.
fn vc_model_append(cs: VcClaims, name: String, param: i64, path: String, ty: i64, width: i64, slot: i64, hdr: i64) {
    cs.model_names.push(name);
    cs.model_params.push(param);
    cs.model_paths.push(path);
    cs.model_tys.push(ty);
    cs.model_widths.push(width);
    cs.model_slots.push(slot);
    cs.model_hdr.push(hdr);
}

// The SMT symbol of parameter `k`, shared by its declaration and by every read of the argument.
fn vc_param_name(k: i64) -> String {
    let out: String = String::from("p");
    out.push_str(i64_to_string(k));
    out
}

// Declares one scalar parameter (Bool, integer or float) in the same order as the function's
// parameters. The header position is recorded before declaration for strict claim-prefix reads.
fn vc_model_declare_scalar(cs: VcClaims, param: i64, ty: i64) {
    let name: String = vc_param_name(param);
    let hdr: SmtScript = cs.header;
    let width: i64 = vc_ty_sort(ty);
    vc_model_append(cs, name, param, String::from(""), ty, width, -1, hdr.kinds.len() as i64);
    vc_script_declare_const(hdr, name, width);
}

// Publishes the five lazy memory sources after the scalar prefix, once per walk. Each
// source is in declaration order; ties prefer aggregate, overlay, vector, held, then map.
// A field read at different sorts is ambiguous in every entry for that parameter/path/slot.
// Collection lists retain their own order and sharing: direct collections first, then copies
// with listed held collections appended by vc_held_append_vecs.
fn vc_model_finish(cs: VcClaims, memory: VcHandleMemory, mp: VcMap) {
    let ag: VcAgg = memory.ag;
    let vv: VcVec = memory.vv;
    let ov: VcOverlay = memory.overlay;
    let held: VcHeld = memory.held;
    let ls: VcHeapListed = memory.heap.listed;
    cs.listed = ls;
    let rows: u64 = { if ls.bad { 0 } else { ls.names.len() } };
    let none: i64 = 9223372036854775807;
    let mut r: u64 = 0;
    let mut i: u64 = 0;
    let mut v: u64 = 0;
    let mut a: u64 = 0;
    let mut d: u64 = 0;
    let mut e: u64 = 0;
    while i < ag.ps_param.len() || v < vv.pv_param.len() || vc_overlay_next_listed(ov, a) < ov.param.len() || vc_held_next_listed(held, d) < held.hdr.len() || e < mp.ent_hdr.len() || r < rows {
        a = vc_overlay_next_listed(ov, a);
        d = vc_held_next_listed(held, d);
        let hi: i64 = { if i < ag.ps_param.len() { ag.ps_hdr[i] } else { none } };
        let hv: i64 = { if v < vv.pv_param.len() { vv.pv_hdr[v] } else { none } };
        let ha: i64 = { if a < ov.param.len() { ov.hdr[a] } else { none } };
        let hh: i64 = { if d < held.hdr.len() { held.hdr[d] } else { none } };
        let he: i64 = { if e < mp.ent_hdr.len() { mp.ent_hdr[e] } else { none } };
        let hr: i64 = { if r < rows { ls.hdr[r] } else { none } };
        if hr < hi && hr < hv && hr < ha && hr < hh && hr < he {
            vc_model_append(cs, ls.names[r], ls.param[r], ls.path[r], ls.ty[r], vc_ty_sort(ls.ty[r]), ls.slot[r], hr);
            r = r + 1;
        } else if he < hi && he < hv && he < ha && he < hh {
            vc_model_append(cs, mp.ent_name[e], mp.ent_param[e], String::from(""), ITY_U64(), 64, mp.ent_slot[e], he);
            if mp.ent_slot[e] == VC_SLOT_VEC_LEN() {
                cs.map_len.push(mp.ent_name[e]);
                cs.map_len_hdr.push(he);
            }
            e = e + 1;
        } else if hh < hi && hh < hv && hh < ha {
            vc_model_append(cs, held.len_name[d], held.param[d], held.path[d], ITY_U64(), 64, VC_SLOT_VEC_LEN(), hh);
            d = d + 1;
        } else if hv < hi && hv < ha {
            vc_model_append(cs, vv.pv_len[v], vv.pv_param[v], String::from(""), ITY_U64(), 64, VC_SLOT_VEC_LEN(), hv);
            v = v + 1;
        } else if ha < hi {
            vc_model_append(cs, ov.names[a], ov.param[a], String::from(""), ITY_I64(), 64, VC_SLOT_ADDR(), ha);
            a = a + 1;
        } else {
            vc_model_append(cs, ag.ps_name[i], ag.ps_param[i], ag.ps_path[i], ag.ps_ty[i], ag.ps_sort[i], ag.ps_slot[i], hi);
            i = i + 1;
        }
    }
    cs.vec_param = vv.pv_param;
    cs.vec_arr = vv.pv_arr;
    cs.vec_len = vv.pv_len;
    cs.vec_hdr = vv.pv_hdr;
    cs.vec_wide = vv.pv_wide;
    vc_held_append_vecs(cs, held);
    let mut j: u64 = 0;
    while j < cs.model_slots.len() {
        let mut amb: i64 = 0;
        if cs.model_slots[j] >= 0 {
            let mut o: u64 = 0;
            while o < cs.model_slots.len() {
                if o != j && cs.model_params[o] == cs.model_params[j] && cs.model_paths[o] == cs.model_paths[j] && cs.model_slots[o] == cs.model_slots[j] && cs.model_widths[o] != cs.model_widths[j] {
                    amb = 1;
                }
                o = o + 1;
            }
        }
        cs.model_ambig.push(amb);
        j = j + 1;
    }
}
